Subject: [PATCH 2/6] c14n: Fix Type confusion in xmlC14NProcessAttrsAxis

Fix https://gitlab.gnome.org/GNOME/libxml2/-/issues/1096

Thanks to Nick Wellnhofer for the report.

(cherry picked from commit 495c9451c541da25829ce321d2273da9fca72d25)
---
 c14n.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/c14n.c b/c14n.c
index 18d95a9e..976eece0 100644
--- a/c14n.c
+++ b/c14n.c
@@ -1198,7 +1198,7 @@ xmlC14NProcessAttrsAxis(xmlC14NCtxPtr ctx, xmlNodePtr cur, int parent_visible)
              * visible!
              */
             tmp = cur->parent;
-            while (tmp != NULL) {
+            while (tmp != NULL && tmp->type == XML_ELEMENT_NODE) {
                 attr = tmp->properties;
                 while (attr != NULL) {
                     if (xmlC14NIsXmlAttr(attr) != 0) {
