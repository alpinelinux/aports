testsuite: do not dereference a misaligned block in cls_struct_overaligned

On i386 the ABI passes the 128-byte aligned struct at 4-byte alignment,
so args[9] is not aligned for the block type and GCC may use an aligned
SSE load (movdqa) to copy it, crashing. Copy the arguments out with
memcpy instead.

--- a/testsuite/libffi.closures/cls_struct_overaligned.c
+++ b/testsuite/libffi.closures/cls_struct_overaligned.c
@@ -60,13 +60,19 @@
 	  void *userdata __UNUSED__)
 {
   unsigned long *w[9];
+  block b;
+  trio t;
   int i;
 
   for (i = 0; i < 9; i++)
     w[i] = (unsigned long *) args[i];
+  /* The ABI may pass the block with less than its type's alignment (i386
+     uses 4 bytes), so args[9] need not be suitably aligned for a block.  */
+  memcpy (&b, args[9], sizeof (b));
+  memcpy (&t, args[10], sizeof (t));
   *(ffi_arg *) resp = weigh (*w[0], *w[1], *w[2], *w[3], *w[4], *w[5],
-			     *w[6], *w[7], *w[8], *(block *) args[9],
-			     *(trio *) args[10], *(unsigned long *) args[11]);
+			     *w[6], *w[7], *w[8], b, t,
+			     *(unsigned long *) args[11]);
 }
 
 static block in;
