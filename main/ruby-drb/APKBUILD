# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-drb
_gemname=drb
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=2.2.3
pkgrel=0
pkgdesc="Distributed object system for Ruby"
url="https://github.com/ruby/drb"
arch="noarch"
license="BSD-2-Clause AND Ruby"
depends="ruby"
makedepends="ruby-rdoc"
checkdepends="
	ruby-test-unit
	ruby-test-unit-ruby-core
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/drb/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"
options="!check"  # FIXME: tests get stuck

build() {
	gem build $_gemname.gemspec
}

check() {
	GEM_PATH="dist" ruby -I lib -I test/lib -r helper \
		-e "Dir.glob('./test/**/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files.
	cd "$gemdir"
	rm -r build_info cache extensions
	rmdir plugins || true
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
b75edaf9a20f6e4b8cc144bbad5e939fcc88d8c18f249906624e5295a0f686a96644a192b37768673adf41ed2c7fa19d4cc04ea78f2aa8c5499bb2a1558be6d6  drb-2.2.3.tar.gz
"
