From cfff6cbf89050e29b70ded1f107f376f179f07be Mon Sep 17 00:00:00 2001
From: Natanael Copa <ncopa@alpinelinux.org>
Date: Mon, 2 Nov 2026 14:50:56 +0100
Subject: [PATCH] destroy the client after publishing

Each publish created a new mosquitto client that was only freed when
the garbage collector got to it. Every client holds a socketpair that
is not close-on-exec, so long running processes like buildrepo
accumulated sockets that leaked into all child processes.
---
 mqtt/publish.lua | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/mqtt/publish.lua b/mqtt/publish.lua
index ae37071..f6f4aa0 100644
--- a/mqtt/publish.lua
+++ b/mqtt/publish.lua
@@ -57,10 +57,13 @@ function publish.multiple(msgs, hostname, port, client_id, keepalive)
 
 	local status, err, errmsg =
 		client:connect(hostname or publish.hostname, port or publish.port, keepalive or publish.keepalive)
-	if not status then
-		return status, err, errmsg
+	if status then
+		status, err, errmsg = client:loop_forever()
 	end
-	return client:loop_forever()
+	-- free the client now instead of waiting for the garbage collector. It
+	-- holds sockets that would otherwise leak into child processes.
+	client:destroy()
+	return status, err, errmsg
 end
 
 function publish.single(topic, payload, qos, retain, hostname, port, client_id, keepalive)
-- 
2.56.0

