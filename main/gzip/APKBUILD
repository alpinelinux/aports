13affefadbf680b0846483ce66e335f1c19a7b1b72517fb62ab7d23d8a52b38e3a0aa99d672df4e858d8d2b7caee0f8df0fad33b6a4e66f1aee7fe4c8a4a20bf  0001-build-avoid-failure-to-build-on-linux-aarch64.patch
"
