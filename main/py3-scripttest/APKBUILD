# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer:
pkgname=py3-scripttest
pkgver=3.0
pkgrel=0
pkgdesc="Helper to test command-line scripts"
url="https://pypi.org/project/scripttest/"
arch="noarch"
license="MIT"
depends="python3"
makedepends="py3-flit-core py3-gpep517"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://github.com/pypa/scripttest/archive/$pkgver/scripttest-$pkgver.tar.gz"
builddir="$srcdir/scripttest-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
99cad1e29d74595290dad3fe621d316502c53f520fa9540be0a1897ed425fd28a762fad2576ee2796a3a77211e22da362af4e68df412f8f68aa288ec793f072f  scripttest-3.0.tar.gz
"
