pkgname=rsync
pkgver=3.5.2
pkgrel=1
pkgdesc="A file transfer program to keep remote files in sync"
url="https://rsync.samba.org/"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	acl-dev
	attr-dev
	libidn2-dev
	linux-headers
	lz4-dev
	perl
	popt-dev
	xxhash-dev
	zlib-dev
	zstd-dev
	"
checkdepends="bash python3"
subpackages="$pkgname-doc $pkgname-openrc rrsync::noarch"
source="https://download.samba.org/pub/rsync/rsync-$pkgver.tar.gz
	dont-use-nobody.patch
	test-misc-coverage-no-glibc.patch
	test-output-control-chars-no-locale.patch
	rsyncd.initd
	rsyncd.confd
	rsyncd.conf
	rsyncd.logrotate
	syscall-skip-unsupported-symlink-chmod.patch
	"
provider_priority=900

