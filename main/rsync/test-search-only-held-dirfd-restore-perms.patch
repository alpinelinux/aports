Restore the permissions of unreadable-dest, which rsync -a creates with
mode 0111 copied from the source. Otherwise the test leaves an
unreadable directory behind and "rm -rf" of the build dir fails.

--- a/testsuite/search-only-held-dirfd_test.py	2026-11-07 13:35:28.365302076 +0100
+++ b/testsuite/search-only-held-dirfd_test.py	2026-11-07 13:35:28.378189184 +0100
@@ -204,6 +204,8 @@
     xonly.chmod(0o755)
     write_only_dest.chmod(0o755)
     nested_parent.chmod(0o755)
+    if unreadable_dest.is_dir():
+        unreadable_dest.chmod(0o755)
     for dest in (exact_dest, tree_dest):
         copied_xonly = dest / 'xonly'
         if copied_xonly.is_dir():
