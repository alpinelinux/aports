From: Jakub Jirutka <jakub@jirutka.cz>
Date: Sat, 21 Nov 2026 23:19:23 +0100
Subject: [PATCH] Don't rebuild on install

diff --git a/Makefile b/Makefile
index 15de440..ebd2ace 100644
--- a/Makefile
+++ b/Makefile
@@ -198,7 +198,7 @@ config.gypi: configure configure.py src/node_version.h
 	fi
 
 .PHONY: install
-install: all ## Install node into $PREFIX (default=/usr/local).
+install: ## Install node into $PREFIX (default=/usr/local).
 	$(PYTHON) tools/install.py $@ --dest-dir '$(DESTDIR)' --prefix '$(PREFIX)'
 
 .PHONY: uninstall
