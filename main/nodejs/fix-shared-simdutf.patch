Patch-Source: https://github.com/nodejs/node/pull/67410
--
From b99a89f606d548c048fed5bf39565d8d47e0cb2a Mon Sep 17 00:00:00 2001
From: Yao Zi <me@ziyao.cc>
Date: Wed, 11 Nov 2026 12:23:08 +0000
Subject: [PATCH] build: do not include vendored simdutf with
 `--shared-simdutf`

Do not include the vendored simdutf when compiling merve if shared
simdutf is used to ensure the headers match the linked library.

Signed-off-by: Yao Zi <me@ziyao.cc>
---
 deps/merve/merve.gyp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/deps/merve/merve.gyp b/deps/merve/merve.gyp
index 7712fa9d20dc..1b0ac18f6ccd 100644
--- a/deps/merve/merve.gyp
+++ b/deps/merve/merve.gyp
@@ -8,7 +8,6 @@
       'type': 'static_library',
       'include_dirs': [
         '.',
-        '../v8/third_party/simdutf',
       ],
       'direct_dependent_settings': {
         'include_dirs': ['.'],
@@ -29,6 +28,11 @@
             'CLANG_CXX_LANGUAGE_STANDARD': 'c++20',
           },
         }],
+        ['node_shared_simdutf=="false"', {
+          'include_dirs': [
+            '../v8/third_party/simdutf',
+          ],
+        }],
       ],
     },
   ]
