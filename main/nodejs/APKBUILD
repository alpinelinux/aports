export CARGO_NET_OFFLINE=true

prepare() {
	default_prepare

	# Remove bundled dependencies that we're not using.
	#
	# NOTE: nghttp3 and ngtcp2 are only used when building with OpenSSL
	#  that supports QUIC. After the QUIC support is added to openssl, add
	#  options --shared-nghttp3 and --shared-ngtcp2.
	#
	# NOTE: All bundled dependencies are described in
	#  doc/contributing/maintaining/maintaining-dependencies.md.
	rm -r deps/ada \
		deps/LIEF \
		deps/brotli \
		deps/cares \
		deps/googletest \
		deps/histogram \
		deps/icu-small \
		deps/libffi \
		deps/llhttp \
		deps/nghttp2 \
		deps/ngtcp2 \
		deps/npm \
		deps/openssl \
		deps/simdjson \
		deps/sqlite \
		deps/v8/third_party/highway \
		deps/v8/third_party/jinja2 \
		deps/v8/third_party/markupsafe \
		deps/v8/third_party/simdutf \
		deps/v8/third_party/zlib \
		deps/zlib \
		deps/zstd \
		tools/gyp \
		tools/inspector_protocol/jinja2 \
		tools/inspector_protocol/markupsafe

	# Remove prebuilt .o files (deps/v8/third_party/ittapi).
	find deps -name '*.o' -exec rm -v {} \;
}

build() {
	# Add defines recommended in libuv readme.
	local common_flags="-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64"
	# Disable use of OpenSSL ENGINE API - it's deprecated since OpenSSL 3.0
	#   (https://issues.redhat.com/browse/RHEL-33743).
	common_flags="$common_flags -DOPENSSL_NO_ENGINE"

	# -Os overwrites the optimizations enabled by BUILDTYPE=Release.
	# Compiling with O2 instead of Os increases binary size by ~10%
	# (53.1 MiB -> 58.6 MiB), but also increases performance by ~20%
	# according to v8/web-tooling-benchmark. Node.js is quite huge anyway;
	# there are better options for size constrained environments.
	export CFLAGS="${CFLAGS/-Os} $common_flags"
	export CXXFLAGS="${CXXFLAGS/-Os} $common_flags"
	export CPPFLAGS="${CPPFLAGS/-Os} $common_flags"

	# avoid error "CAN_USE_ARMV7_INSTRUCTIONS should match CAN_USE_VFP3_INSTRUCTIONS"
	if [ "$CARCH" = "armhf" ]; then
		export CXXFLAGS="$CXXFLAGS -DCAN_USE_ARMV7_INSTRUCTIONS=1 -DCAN_USE_VFP3_INSTRUCTIONS=1"
	fi

	# When building shared libnode.so, the resulting package size is +15 %
	# (~8 MiB), so we rather build it twice to keep the node binary smaller
	# (there are currently no packages using libnode.so).
	if ! [ -x out/node ]; then
		msg 'Building node binary'
		_build
		cp out/Release/node out/
	fi

	msg 'Building libnode.so'
	# Without node code cache to avoid illegal instruction
	# was implicit before https://github.com/nodejs/node/commit/87e0675f51
	_build --shared --without-node-code-cache
	cp out/Release/lib/libnode.so* out/Release/

	sed "s/@VERSION@/$pkgver/" "$srcdir"/$pkgname.pc.in > out/Release/$pkgname.pc
}

_build() {
	# avoid lto1: fatal error: target specific builtin not available
	local lto_flag="--enable-lto"
	if [ "$CARCH" = "riscv64" ]; then
		lto_flag=""
	fi

	# NOTE: We use bundled libuv because they don't care much about backward
	# compatibility and it has happened several times in past that we
	# couldn't upgrade nodejs package in stable branches to fix CVEs due to
	# libuv incompatibility.
	#
	# NOTE: We don't package the bundled npm - it's a separate project with
	# its own release cycle and version numbering, so it's better to keep
	# it in a standalone aport.
	#
	# NOTE: LIEF is only needed for the built-in --build-sea command. It
	# adds ~5 MB of bundled code, including Mbed TLS and other dependencies.
	# SEA remains usable via the external postject tool.
	#
	# NOTE: node code cache costs +4.3 MiB in the node binary size; this can
	# be disabled with --without-node-code-cache.
	#
	# TODO: Create aport for amaro and use --shared-builtin-amaro (amaro
	#   contains pre-built wasm binary).
	python3 configure.py \
		--prefix=/usr \
		--use-prefix-to-find-headers \
		--ninja \
		$lto_flag \
		--shared-ada \
		--shared-brotli \
		--shared-zlib \
		--shared-openssl \
		--shared-cares \
		--shared-ffi \
		--shared-gtest \
		--shared-hdr-histogram \
		--shared-http-parser \
		--shared-highway \
		--shared-nghttp2 \
		--shared-simdjson \
		--shared-simdutf \
		--shared-sqlite \
		--shared-zstd \
		--openssl-use-def-ca-store \
		--with-icu-default-data-dir="$(icu-config --icudatadir)" \
		--with-intl=system-icu \
		--without-npm \
		--without-lief \
		"$@"

	# V8 built with -O3 and fat LTO objects needs up to ~1.8 GiB per
	# cc1plus, ~1 GiB on average. Cap the number of jobs by available
	# memory (1.25 GiB per job) to avoid getting OOM killed when multiple
	# builders share the same host.
	local jobs="${JOBS:-$(nproc)}"
	local memjobs=$(awk '/^MemAvailable:/ {n = int($2 / 1310720); print (n > 0 ? n : 1)}' /proc/meminfo)
	if [ -n "$memjobs" ] && [ "$memjobs" -lt "$jobs" ]; then
		jobs=$memjobs
	fi
	msg "Building with $jobs jobs"

	make BUILDTYPE=Release JOBS="$jobs"
}

# TODO Run provided test suite.
check() {
	# out/node is the binary we ship in the package, out/Release/node is
	# built against libnode.so.
	local node
	for node in ./out/node ./out/Release/node; do
		msg "Testing $node"

		"$node" -e 'console.log("Hello, world!")'
		"$node" -e "require('assert').equal(process.versions.node, '$pkgver')"
		"$node" -e 'require("assert").equal(
			Buffer.from(Buffer.from("foo").toString("base64"), "base64").toString("ascii"),
			"foo")'
		"$node" -e 'console.log(Temporal.Now.zonedDateTimeISO("Europe/Amsterdam").toString())'
	done
}

package() {
	make DESTDIR="$pkgdir" install

	# node binary built without libnode.so.
	install -D -m755 out/node -t "$pkgdir"/usr/bin/

	install -D -m644 out/Release/$pkgname.pc -t "$pkgdir"/usr/lib/pkgconfig/

	(cd "$pkgdir"/usr/lib; ln -sf libnode.so.* libnode.so)
}

dev() {
	provides="nodejs-lts-dev=$pkgver"  # for backward compatibility
	default_dev
}

