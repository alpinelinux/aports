pkgname=nodejs
# Note: Update only to LTS versions! Other versions are supported only for
#  9 months by upstream.
pkgver=26.13.1
pkgrel=0
pkgdesc="JavaScript runtime built on V8 engine - LTS version"
url="https://nodejs.org/"
arch="all"
license="MIT"
depends="ca-certificates"
makedepends="
	ada-dev
	brotli-dev
	c-ares-dev
	cargo-auditable
	gtest-dev
	gyp
	hdrhistogram-c-dev
	highway-dev
	icu-dev
	libffi-dev
	linux-headers
	llhttp-dev
	nghttp2-dev
	openssl-dev
	py3-jinja2
	python3
	samurai
	simdjson-dev
	simdutf-dev
	sqlite-dev
	zlib-dev
	zstd-dev
	"
install="$pkgname.post-upgrade"
subpackages="
	$pkgname-dev
	$pkgname-libs
	$pkgname-doc
	"
provider_priority=100  # highest priority (other provider is nodejs-current)
provides="nodejs-lts=$pkgver-r$pkgrel"  # for backward compatibility
replaces="nodejs-current nodejs-lts"  # nodejs-lts for backward compatibility
source="https://nodejs.org/dist/v$pkgver/node-v$pkgver.tar.gz
	remove-unused-openssl-config.patch
	fix-shared-simdutf.patch
	ppc64le-adjust-gcc-toc-flags.patch
	crates-auditable.patch
	install-no-build.patch
	v8-riscv-trap-handler.patch
	v8-no-static-zlib.patch
	v8-disable-trap-handler-on-riscv-sv39.patch
	v8-ppc_vsx-inl.patch
	v8-x86_mm_cvtsi128_si64.patch
	v8-yield-processor.patch
	v8-armhf_fixedtag.patch
	v8-s390x_mmap.patch
	v8-maglev-ir-riscv.patch
	v8-temporal-zoneinfo64-length.patch
	$pkgname.pc.in
	"
builddir="$srcdir/node-v$pkgver"

