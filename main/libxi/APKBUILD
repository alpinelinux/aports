# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=libxi
pkgver=1.8.4
pkgrel=0
pkgdesc="X11 Input extension library"
url="https://www.x.org"
arch="all"
license="MIT AND X11"
options="!check"  # No test suite.
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
makedepends="
	xorgproto
	libx11-dev
	libxext-dev
	libxfixes-dev
	util-macros
	xmlto
	"
source="https://www.x.org/releases/individual/lib/libXi-$pkgver.tar.xz"
builddir="$srcdir/libXi-$pkgver"

# secfixes:
#   1.8.4-r0:
#     - CVE-2026-93541
#     - CVE-2026-93542
#     - CVE-2026-93543
#     - CVE-2026-93544
#     - CVE-2026-93545
#     - CVE-2026-94281
#     - CVE-2026-94282
#     - CVE-2026-109089
#     - CVE-2026-109090

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--with-xmlto \
		--without-fop \
		--enable-static
	make
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
