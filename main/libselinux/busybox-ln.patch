From 28c8f6ff4abfc14a0a5e8a3b6229a4e175ae33dd Mon Sep 17 00:00:00 2001
From: Aelin <aelin@postmarketos.org>
Date: Thu, 10 Sep 2026 21:11:18 +0200
Subject: [PATCH] Make the Makefile compatible with busybox ln

---
 src/Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Makefile b/src/Makefile
index 9ecdbd4d..2163926a 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -192,13 +192,13 @@ install: all
 ifneq ($(DISABLE_SHARED),y)
 	test -d $(DESTDIR)$(SHLIBDIR) || install -m 755 -d $(DESTDIR)$(SHLIBDIR)
 	install -m 755 $(LIBSO) $(DESTDIR)$(SHLIBDIR)
-	ln -sf --relative $(DESTDIR)$(SHLIBDIR)/$(LIBSO) $(DESTDIR)$(LIBDIR)/$(TARGET)
+	ln -sf $(LIBSO) $(DESTDIR)$(LIBDIR)/$(TARGET)
 endif
 
 install-pywrap: pywrap
 	$(PYTHON) -m pip install --no-build-isolation --force-reinstall --prefix=$(PREFIX) `test -n "$(DESTDIR)" && echo --root $(DESTDIR) --ignore-installed --no-deps` dist/*.whl
 	install -m 644 $(SWIGPYOUT) $(DESTDIR)$(PYTHONLIBDIR)/selinux/__init__.py
-	ln -sf --relative $(DESTDIR)$(PYTHONLIBDIR)/selinux/_selinux$(PYCEXT) $(DESTDIR)$(PYTHONLIBDIR)/_selinux$(PYCEXT)
+	ln -sf selinux/_selinux$(PYCEXT) $(DESTDIR)$(PYTHONLIBDIR)/_selinux$(PYCEXT)
 
 install-rubywrap: rubywrap
 	test -d $(DESTDIR)$(RUBYINSTALL) || install -m 755 -d $(DESTDIR)$(RUBYINSTALL) 
-- 
2.55.0

