# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=sysklogd
pkgver=2.7.2
pkgrel=0
pkgdesc="BSD syslog daemon with RFC3164 and RFC5424 support"
url="https://github.com/troglobit/sysklogd"
arch="all"
license="BSD-3-Clause"
checkdepends="iproute2"
subpackages="$pkgname-doc $pkgname-dev $pkgname-libs $pkgname-logger
	$pkgname-openrc"
source="https://github.com/troglobit/sysklogd/releases/download/v$pkgver/sysklogd-$pkgver.tar.gz
	sysklogd.initd
	sysklogd.confd
	syslog.conf
	"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sbindir=/usr/sbin \
		--sysconfdir=/etc \
		--runstatedir=/run \
		--with-systemd=no
	make
}

check() {
	# the other tests require user and network namespaces
	make -j1 check TESTS_ENVIRONMENT= TESTS="opts.sh"
}

package() {
	make DESTDIR="$pkgdir" install

	install -D -m755 "$srcdir"/sysklogd.initd \
		"$pkgdir"/etc/init.d/sysklogd
	install -D -m644 "$srcdir"/sysklogd.confd \
		"$pkgdir"/etc/conf.d/sysklogd
	install -D -m644 "$srcdir"/syslog.conf \
		"$pkgdir"/etc/syslog.conf
}

libs() {
	pkgdesc="Extended syslog API library"
	amove usr/lib/libsyslog.so.*
}

logger() {
	pkgdesc="BSD-style logger utility with RFC5424 support"
	amove usr/bin/logger
}

