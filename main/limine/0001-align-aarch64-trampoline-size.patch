From c9bc53e31093a2b21ec22bd25468b0472404ab66 Mon Sep 17 00:00:00 2001
From: Mintsuki <mintsuki@protonmail.com>
Date: Sat, 21 Nov 2026 11:58:02 +0100
Subject: [PATCH] sys/smp: Align the aarch64 trampoline's size to 8 bytes

Signed-off-by: Mintsuki <mintsuki@protonmail.com>
---
 common/sys/smp_trampoline.asm_aarch64 | 1 +
 1 file changed, 1 insertion(+)

diff --git a/common/sys/smp_trampoline.asm_aarch64 b/common/sys/smp_trampoline.asm_aarch64
index b0d69bf62..d8d4f92b2 100644
--- a/common/sys/smp_trampoline.asm_aarch64
+++ b/common/sys/smp_trampoline.asm_aarch64
@@ -197,6 +197,7 @@ smp_trampoline_end:
 
 .section .rodata
 
+.balign 8
 .global smp_trampoline_size
 smp_trampoline_size:
     .quad smp_trampoline_end - smp_trampoline_start
-- 
2.56.1

