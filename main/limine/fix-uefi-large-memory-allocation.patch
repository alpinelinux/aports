 static struct memmap_entry *recl;
 
 extern symbol __slide, __image_base, __image_end;
+
+// Keep individual firmware allocations bounded. Some UEFI implementations
+// reject or take an impractical amount of time to process requests spanning a
+// large fraction of physical memory. Start at 1GiB and, if firmware rejects a
+// full-sized request, use progressively smaller requests down to 64MiB.
+#define UEFI_ALLOC_MAX_PAGES (0x40000000 / PAGE_SIZE)
+#define UEFI_ALLOC_MIN_PAGES (0x04000000 / PAGE_SIZE)
+
+static UINTN uefi_alloc_chunk_pages = UEFI_ALLOC_MAX_PAGES;
+
+static void pmm_claim_uefi_pages(EFI_PHYSICAL_ADDRESS base, UINTN page_count) {
+    while (page_count != 0) {
+        UINTN chunk_pages = page_count > uefi_alloc_chunk_pages
+                          ? uefi_alloc_chunk_pages : page_count;
+        EFI_PHYSICAL_ADDRESS alloc_base = base;
+        EFI_STATUS status = gBS->AllocatePages(AllocateAddress,
+                                               EfiLoaderCode,
+                                               chunk_pages,
+                                               &alloc_base);
+
+        if (status && chunk_pages == uefi_alloc_chunk_pages
+         && uefi_alloc_chunk_pages > UEFI_ALLOC_MIN_PAGES) {
+            uefi_alloc_chunk_pages /= 2;
+            continue;
+        }
+
+        if (status) {
+            memmap_alloc_range(base, (uint64_t)chunk_pages * PAGE_SIZE,
+                               MEMMAP_EFI_RECLAIMABLE, MEMMAP_USABLE,
+                               true, false, false);
+        }
+
+        base += (uint64_t)chunk_pages * PAGE_SIZE;
+        page_count -= chunk_pages;
+    }
+}
 
