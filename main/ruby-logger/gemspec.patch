The gemspec uses `git ls-files` to list files, but the source tarball is not
a git repository, so the resulting gem would be empty.

--- a/logger.gemspec
+++ b/logger.gemspec
@@ -20,6 +20 @@
-  pattern = %W[
-    :(glob,top)* :/exe :/ext :/lib
-    :^/.git* :^/Gemfile* :^/Rakefile*
-    :(literal,top,exclude)#{File.basename(__FILE__)}
-  ]
-  spec.files = IO.popen(%w[git ls-files -z] + pattern, chdir: __dir__, &:read).split("\0")
+  spec.files = Dir["lib/**/*.rb"]
