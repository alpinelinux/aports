pkgname=valkey
pkgver=9.1.3
pkgrel=0
pkgdesc="Open source high-performance key/value datastore (fork of Redis)"
url="https://valkey.io/"
arch="all"
license="BSD-3-Clause AND BSD-2-Clause AND MIT"
pkgusers="valkey"
pkggroups="valkey"
# Bundled libraries (mostly from deps/README.md):
#
# Name             | Version  | Customized | License
# -----------------|----------|------------|-------------
# jemalloc         | 5.3.0    | yes        | BSD-2-Clause
# libvalkey        | 0.4.0    | no         | BSD-3-Clause
# linenoise        | 1.0      | no         | BSD-2-Clause
# lua              | 5.1      | yes        | MIT
# hdrhistogram-c   | e4448cf  | yes        | (CC0-1.0 OR BSD-2-Clause)
# fast_float/ffc.h | 26.03.02 | ?          | (MIT OR Apache-2.0 OR BSL-1.0)
# gtest-parallel   | cd488bd  | no         | Apache-2.0
# fpconv           | unknown  | ?          | BSL-1.0
makedepends="linux-headers openssl-dev"
checkdepends="tcl procps"
install="
	$pkgname.pre-install
	$pkgname.post-install
	$pkgname-compat.pre-install
	"
subpackages="
	$pkgname-lua
	$pkgname-tls
	$pkgname-benchmark
	$pkgname-cli
	$pkgname-compat::noarch
	$pkgname-openrc
	"
source="https://github.com/valkey-io/valkey/archive/$pkgver/valkey-$pkgver.tar.gz
	valkey-loadmod.patch
	no-lua-rpath.patch
	valkey.conf.patch
	sentinel.conf.patch
	$pkgname.initd
	$pkgname.confd
	$pkgname-sentinel.initd
	$pkgname-sentinel.confd
	"

# secfixes:
#   9.1.3-r0:
#     - CVE-2026-56684
#     - CVE-2026-63639
#   9.0.4-r0:
#     - CVE-2026-23479
#     - CVE-2026-25243
#     - CVE-2026-23631
#   9.0.3-r0:
#     - CVE-2025-67733
#     - CVE-2026-21863
#     - CVE-2026-27623
#   8.1.4-r0:
#     - CVE-2025-49844
#     - CVE-2025-46817
#     - CVE-2025-46818
#     - CVE-2025-46819
#   8.1.1-r2:
#     - CVE-2025-32023
#     - CVE-2025-48367
#   8.1.1-r1:
#     - CVE-2025-27151
#   7.2.9-r0:
#     - CVE-2025-21605
#   7.2.8-r0:
#     - CVE-2024-46981
#     - CVE-2024-51741
#   7.2.7-r0:
#     - CVE-2024-31227
#     - CVE-2024-31228
#     - CVE-2024-31449

case "$CARCH" in
	# Tests are flaky.
	loongarch64) options="!check";;
esac

export CFLAGS="$CFLAGS -DUSE_MALLOC_USABLE_SIZE -O2 -flto=auto"
_make_flags="
	DEBUG=
	OPTIMIZATION=
	V=echo
	USE_JEMALLOC=no
	MALLOC=libc
	BUILD_TLS=module
	BUILD_RDMA=no
	BUILD_LUA=module
	USE_LIBBACKTRACE=no
	USE_REDIS_SYMLINKS=yes
	PREFIX=/usr
	"
_modules_dir="usr/lib/$pkgname/modules"
_modules_cfgdir="etc/$pkgname/modules"

build() {
	make all $_make_flags
}

check() {
	local test_opts=
	case "$CARCH" in
		# memory overhead tracking test fails on 32-bit architectures
		armv7 | armhf | x86) rm tests/unit/tracking.tcl ;;
		# MPTCP is not supported on riscv64 CI runner.
		riscv64) test_opts="--skipunit unit/mptcp" ;;
	esac

	# Skip flaky tests and benchmarks.
	./runtest \
		--config loadmodule "$builddir/src/modules/lua/libvalkeylua.so" \
		--skiptest 'slave buffer are counted correctly' \
		--skiptest '/(?i)benchmark' \
		--no-latency \
		$test_opts
}

package() {
	make install $_make_flags \
		INSTALL_BIN="$pkgdir/usr/bin" \
		INSTALL_LIB="$pkgdir/$_modules_dir"

	install -D -m755 src/valkey-tls.so "$pkgdir/$_modules_dir/tls.so"

	cd "$pkgdir"

	# Use consistent naming.
	mv "$_modules_dir"/libvalkeylua.so "$_modules_dir"/lua.so

	# NOTE: /etc/valkey and /etc/valkey/sentinel.conf must be writable for valkey,
	# otherwise Sentinel fails to start.
	install -d -m 750 -o valkey -g valkey \
		etc/valkey \
		etc/valkey/valkey.d \
		"$_modules_cfgdir" \
		var/lib/valkey \
		var/lib/valkey/sentinel

	install -D -m 640 -o root -g valkey "$builddir"/valkey.conf etc/valkey/valkey.conf
	install -D -m 640 -o valkey -g valkey "$builddir"/sentinel.conf etc/valkey/sentinel.conf

	echo "loadmodule /$_modules_dir/lua.so" > "$_modules_cfgdir"/lua.conf
	echo "loadmodule /$_modules_dir/tls.so" > "$_modules_cfgdir"/tls.conf

	install -D -m 755 "$srcdir"/valkey.initd etc/init.d/valkey
	install -D -m 755 "$srcdir"/valkey-sentinel.initd etc/init.d/valkey-sentinel
	install -D -m 644 "$srcdir"/valkey.confd etc/conf.d/valkey
	install -D -m 644 "$srcdir"/valkey-sentinel.confd etc/conf.d/valkey-sentinel

	install -d -m 750 -o valkey -g valkey \
		var/lib/valkey \
		var/lib/valkey/sentinel
}

benchmark() {
	pkgdesc="Valkey benchmarking tool"

	amove usr/bin/valkey-benchmark
}

cli() {
	pkgdesc="Valkey CLI client"

	amove usr/bin/valkey-cli
}

lua() {
	pkgdesc="Lua module for Valkey"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove "$_modules_dir"/lua.so
	amove "$_modules_cfgdir"/lua.conf
}

tls() {
	pkgdesc="TLS module for Valkey"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove "$_modules_dir"/tls.so
	amove "$_modules_cfgdir"/tls.conf
}

compat() {
	pkgdesc="Valkey command symlinks and system group for compatibility with redis"
	depends="!redis !redict-compat"

	amove usr/bin/redis-*
	rm "$subpkgdir"/usr/bin/redis-benchmark
}

