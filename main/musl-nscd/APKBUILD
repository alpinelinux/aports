# Contributor: Michael Aldridge <maldridge@voidlinux.org>
# Maintainer: Miguel da Silva <midas@contauro.com>
pkgname=musl-nscd
pkgver=1.2.1
pkgrel=0
pkgdesc="Implementation of nscd for nsswitch modules for musl"
url="https://github.com/pikhq/musl-nscd"
arch="all"
options="!check" # no test suite
license="MIT"
depends_dev="bison flex"
makedepends="$depends_dev"
install="$pkgname.pre-install"
subpackages="$pkgname-dev $pkgname-doc $pkgname-openrc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pikhq/musl-nscd/archive/v$pkgver.tar.gz
	musl-nscd.initd
	musl-nscd.confd
	"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

package() {
	make DESTDIR="$pkgdir" install

	install -Dm644 COPYRIGHT \
		"$pkgdir"/usr/share/licenses/$pkgname/COPYRIGHT

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/nscd
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/nscd
}

