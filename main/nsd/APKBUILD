pkgname=nsd
pkgver=4.14.3
pkgrel=1
pkgdesc="Authoritative only, high performance and simple DNS server"
url="https://www.nlnetlabs.nl/projects/nsd"
arch="all"
license="BSD-3-Clause"
makedepends="openssl-dev>3 libevent-dev"
install="$pkgname.pre-install $pkgname.pre-upgrade"
subpackages="$pkgname-doc $pkgname-dbg $pkgname-openrc $pkgname-bash-completion"
pkgusers="nsd"
pkggroups="nsd"
source="https://www.nlnetlabs.nl/downloads/nsd/nsd-$pkgver.tar.gz
	nsd.initd
	config.patch
	CVE-2026-101337.patch::https://nlnetlabs.nl/downloads/nsd/patch_CVE-2026-101337.diff
	CVE-2026-101338.patch::https://nlnetlabs.nl/downloads/nsd/patch_CVE-2026-101338.diff
	CVE-2026-101339.patch::https://nlnetlabs.nl/downloads/nsd/patch_CVE-2026-101339.diff
	CVE-2026-101341.patch::https://nlnetlabs.nl/downloads/nsd/patch_CVE-2026-101341.diff
	"
options="!check"

# secfixes:
#   4.14.3-r1:
#     - CVE-2026-101337
#     - CVE-2026-101338
#     - CVE-2026-101339
#     - CVE-2026-101341
#   4.14.3-r0:
#     - CVE-2026-12244
#     - CVE-2026-12245
#     - CVE-2026-12246
#     - CVE-2026-12490
#   4.3.4-r0:
#     - CVE-2020-28935

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--target=$CTARGET \
		--sbindir=/usr/sbin \
		--mandir=/usr/share/man \
		--with-user=nsd \
		--with-pidfile='' \
		--with-xfrdir=/var/db/nsd \
		--disable-dnstap
	make
}

package() {
	make DESTDIR="$pkgdir" install

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname

	install -d "$pkgdir"/usr/share/doc/$pkgname
	cp -a "$builddir"/doc/* "$builddir"/contrib \
		"$pkgdir"/usr/share/doc/$pkgname/
	rm "$pkgdir"/usr/share/doc/nsd/contrib/nsd.service

	mkdir -p "$pkgdir"/usr/share/bash-completion/completions
	mv "$pkgdir"/usr/share/doc/nsd/contrib/autocomplete_nsd-control.bash \
		"$pkgdir"/usr/share/bash-completion/completions/nsd-control

	install -d -m 755 -o nsd -g nsd "$pkgdir"/var/db/nsd
	rm -fr "$pkgdir"/run
}

