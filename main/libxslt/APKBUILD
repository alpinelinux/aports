prepare() {
	default_prepare
	# fails for some reason
	rm -fv tests/REC/test-10-3.xsl
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--with-python=no \
		--enable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -D -m644 Copyright -t "$pkgdir"/usr/share/licenses/$pkgname/
}

dev() {
	default_dev

	amove usr/lib/xsltConf.sh
}

