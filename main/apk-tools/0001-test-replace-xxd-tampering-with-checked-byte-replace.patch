From cf059e3d452b43ec60105c6b9108b027272f35ff Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Timo=20Ter=C3=A4s?= <timo.teras@iki.fi>
Date: Fri, 20 Nov 2026 07:05:26 +0000
Subject: [PATCH 1/1] test: replace xxd tampering with checked byte replacement

The negative test packages were crafted by piping the package through
xxd hexdump and back, replacing an ASCII pattern with sed. This assumes
xxd dumps and reverts byte-exactly, which does not hold for all xxd
implementations (e.g. vim's xxd in accumulated build chroots): the
reconstructed package silently corrupts and the tamper does not happen
as intended.

Replace the xxd|sed|xxd pipeline with a replace_bytes testlib helper
doing a same-length, occurrence-checked binary replacement via python3.
The helper skips the test if python3 is unavailable, and asserts the
pattern count so any layout change in the adb string storage fails
loudly instead of altering unrelated fields.

(cherry picked from commit b5020d72c631cfe8bee2442ee8ad4400b75d99cf)
---
 test/testlib.sh               | 17 +++++++++++++++++
 test/user/extract-hardlink.sh |  4 +---
 test/user/malicious.sh        |  6 ++----
 3 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/test/testlib.sh b/test/testlib.sh
index 972f86da..50a8cef1 100644
--- a/test/testlib.sh
+++ b/test/testlib.sh
@@ -19,6 +19,23 @@ require_programs() {
 	done
 }
 
+# replace_bytes IN OUT OLD_HEX NEW_HEX [EXPECTED_COUNT]
+# Same-length, occurrence-checked binary byte replacement.
+replace_bytes() {
+	require_programs python3
+	python3 - "$@" <<-'EOF'
+import sys
+src, dst, old, new = sys.argv[1:5]
+want = int(sys.argv[5]) if len(sys.argv) > 5 else 1
+data = open(src, "rb").read()
+old = bytes.fromhex(old)
+new = bytes.fromhex(new)
+assert len(old) == len(new), "replacement must be same length"
+assert data.count(old) == want, "pattern occurs %d times, expected %d" % (data.count(old), want)
+open(dst, "wb").write(data.replace(old, new))
+EOF
+}
+
 glob_one() {
 	# shellcheck disable=SC2048 # argument is wildcard needing expansion
 	for a in $*; do
diff --git a/test/user/extract-hardlink.sh b/test/user/extract-hardlink.sh
index d641ba13..c32b56bb 100755
--- a/test/user/extract-hardlink.sh
+++ b/test/user/extract-hardlink.sh
@@ -3,8 +3,6 @@
 TESTDIR=$(realpath "${TESTDIR:-"$(dirname "$0")"/..}")
 . "$TESTDIR"/testlib.sh
 
-require_programs xxd
-
 if ! stat -c "%D:%i" /dev/null > /dev/null 2>&1; then
 	dev_inode() {
 		stat -f "%Xd:%i" "$@"
@@ -41,7 +39,7 @@ INODE="$(dev_inode dest/a/aaa)"
 # a hardlink target that is not an extracted regular file must be
 # rejected while the rest of the package is still extracted: retarget
 # all links at a same-length path ("a/xyz") not present in the package
-xxd -p -c100000 extract-hardlink-1.0.apk | sed -e 's,612f616161,612f78797a,g' | xxd -rp > ehlneg.apk
+replace_bytes extract-hardlink-1.0.apk ehlneg.apk 612f616161 612f78797a 1
 
 mkdir dest2
 $APK extract ehlneg.apk --destination dest2 2>ehlneg.log && assert "dangling hardlink target not rejected"
diff --git a/test/user/malicious.sh b/test/user/malicious.sh
index 62e75833..83803392 100755
--- a/test/user/malicious.sh
+++ b/test/user/malicious.sh
@@ -3,8 +3,6 @@
 TESTDIR=$(realpath "${TESTDIR:-"$(dirname "$0")"/..}")
 . "$TESTDIR"/testlib.sh
 
-require_programs xxd
-
 setup_apkroot
 APK="$APK --allow-untrusted --no-interactive"
 
@@ -19,10 +17,10 @@ $APK mkpkg --compression=none -I name:malicious -I version:1.0 -F files -o malic
 mkdir dest dest-a dest-b
 $APK extract malicious-1.0.apk --destination dest || assert "failed to extract"
 
-xxd -p -c100000 malicious-1.0.apk | sed -e 's,6469723d3d3d646972,6469722f2e2f646972,' | xxd -rp > malicious-1.0-a.apk
+replace_bytes malicious-1.0.apk malicious-1.0-a.apk 6469723d3d3d646972 6469722f2e2f646972 1
 $APK extract malicious-1.0-a.apk --destination dest-a && assert "malicious check 1 failed"
 
-xxd -p -c100000 malicious-1.0.apk | sed -e 's,66696c653d66696c65,66696c652f66696c65,' | xxd -rp > malicious-1.0-b.apk
+replace_bytes malicious-1.0.apk malicious-1.0-b.apk 66696c653d66696c65 66696c652f66696c65 1
 $APK extract malicious-1.0-b.apk --destination dest-b && assert "malicious check 2 failed"
 
 exit 0
