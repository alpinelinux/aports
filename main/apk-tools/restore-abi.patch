From a31fc7e88464fae56aa2b3854290f6c76bbe415f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Timo=20Ter=C3=A4s?= <timo.teras@iki.fi>
Date: Wed, 4 Nov 2026 08:43:19 +0000
Subject: [PATCH 1/1] build: restore ABI compatibility with apk-tools 2.14.6

Keep the libapk.so soname at 2.14.0 and preserve the exact struct
layouts of apk_name.

All other struct changes are deemed not visible outside or not
affecting depending software:
 - the solver state is not ABI changing, it is used only internally
   and it is cleared after its use
 - applet definitions are not exposed outside the main binary
 - libfetch affects ABI, but is not known to be used outside apk
 - apk_ipkg_add_script affects ABI, but is not used outside apk
---
 Makefile           | 2 +-
 src/apk_database.h | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 5a23cda0..83844b4c 100644
--- a/Makefile
+++ b/Makefile
@@ -5,7 +5,7 @@
 
 PACKAGE := apk-tools
 VERSION := 2.14.13
-SO_VERSION := 2.14.10
+SO_VERSION := 2.14.0
 
 export VERSION SO_VERSION
 
diff --git a/src/apk_database.h b/src/apk_database.h
index a5fd3898..75d35a9e 100644
--- a/src/apk_database.h
+++ b/src/apk_database.h
@@ -106,6 +106,7 @@ struct apk_name {
 	struct apk_name_array *rinstall_if;
 	unsigned is_dependency : 1;
 	unsigned auto_select_virtual: 1;
+	unsigned _unused : 2;		/* kept for ABI */
 	unsigned solver_flags_set : 1;
 	unsigned providers_sorted : 1;
 	unsigned int foreach_genid;
-- 
2.56.0

