The gemspec uses `git ls-files` to list files, but the source tarball is not
a git repository, so the resulting gem would be empty.

--- a/pstore.gemspec
+++ b/pstore.gemspec
@@ -26,3 +26 @@
-  spec.files         = Dir.chdir(File.expand_path('..', __FILE__)) do
-    `git ls-files -z 2>#{IO::NULL}`.split("\x0").reject { |f| f.match(%r{^(test|spec|features)/}) }
-  end
+  spec.files         = Dir["lib/**/*.rb"]
