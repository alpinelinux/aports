commit 45e0a472516f54ee25f2a5e893fbbc8232d5acc4
Author: Sertonix <sertonix@posteo.net>
Date:   2026-10-20T13:36:08+02:00

    zkey: replace canonicalize_file_name with realpath
    
    canonicalize_file_name is a glibc extension that is equivalent to
    realpath(path, NULL) and only the latter may available on non-glibc
    systems like musl.
    
    Signed-off-by: Sertonix <sertonix@posteo.net>

diff --git a/zkey/kms.c b/zkey/kms.c
index 3f2e8d64..f5a59b98 100644
--- a/zkey/kms.c
+++ b/zkey/kms.c
@@ -490,8 +490,8 @@ static bool is_path_within_base_path(const char *base_path, const char *path)
 	size_t base_len;
 	bool ret = false;
 
-	real_base_path = canonicalize_file_name(base_path);
-	real_path = canonicalize_file_name(path);
+	real_base_path = realpath(base_path, NULL);
+	real_path = realpath(path, NULL);
 
 	if (real_base_path == NULL || real_path == NULL) {
 		warnx("Failed to resolve path for safety check: %s",
