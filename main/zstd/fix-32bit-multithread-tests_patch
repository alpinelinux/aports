cap number of workers on builders with 80 cores

--- a/tests/playTests.sh
+++ b/tests/playTests.sh
@@ -67,11 +67,18 @@ fileRoundTripTest() {
         local_d="$local_c"
     fi
 
+		if [ $(nproc) -gt 48 ]; then
+        local_nproc=48
+		else
+        local_nproc=0 # -T0 will attempt to autodetect
+		fi
+
+
     rm -f tmp.zst tmp.md5.1 tmp.md5.2
     println "fileRoundTripTest: datagen $1 $local_p > tmp && zstd -v$local_c -c tmp | zstd -d$local_d"
     datagen $1 $local_p > tmp
     < tmp $MD5SUM > tmp.md5.1
-    zstd -T0 --ultra -v$local_c -c tmp | zstd -d$local_d | $MD5SUM > tmp.md5.2
+    zstd -T$local_nproc --ultra -v$local_c -c tmp | zstd -d$local_d | $MD5SUM > tmp.md5.2
     $DIFF -q tmp.md5.1 tmp.md5.2
 }
 
