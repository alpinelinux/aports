cap number of workers on builders with 80 cores

--- a/tests/playTests.sh
+++ b/tests/playTests.sh
@@ -46,10 +46,16 @@ roundTripTest() {
         dLevel="$cLevel"
     fi
 
+		if [ $(nproc) -gt 48 ]; then
+        local_nproc=48
+		else
+        local_nproc=0 # -T0 will attempt to autodetect
+		fi
+
     rm -f tmp1 tmp2
     println "roundTripTest: datagen $1 $proba | zstd -v$cLevel | zstd -d$dLevel"
     datagen $1 $proba | $MD5SUM > tmp1
-    datagen $1 $proba | zstd -T0 --ultra -v$cLevel | zstd -d$dLevel  | $MD5SUM > tmp2
+    datagen $1 $proba | zstd -T$local_nproc --ultra -v$cLevel | zstd -d$dLevel  | $MD5SUM > tmp2
     $DIFF -q tmp1 tmp2
 }
 
