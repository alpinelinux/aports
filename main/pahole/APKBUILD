# Maintainer: Dominique Martinet <dominique.martinet@atmark-techno.com>
pkgname=pahole
pkgver=1.32_git20261003
pkgrel=0
pkgdesc="dwarf manipulation utilities"
url="https://git.kernel.org/pub/scm/devel/pahole/pahole.git"
arch="all"
license="GPL-2.0-only"
makedepends="cmake elfutils-dev libdwarf-dev zlib-dev libbpf-dev
	linux-headers musl-obstack-dev argp-standalone samurai"
checkdepends="bash bpftool"
subpackages="$pkgname-doc"
_commit=1e342ac44979748bcf5bb37f84ea055e7f4d7184
source="https://git.kernel.org/pub/scm/devel/pahole/pahole.git/snapshot/pahole-$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

prepare() {
	default_prepare

	# bpftool in linux-tools is too old for this
	rm -v tests/btf_inline.sh
}

build() {
	# use libbpf installed uapi headers as we need something
	# newer than linux-headers provides
	export CFLAGS="$CFLAGS -I/usr/include/bpf/uapi"

	cmake -B build -G Ninja . \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=None \
		-D__LIB=lib \
		-DCMAKE_MODULE_PATH=/usr/lib/cmake \
		-DLIBBPF_EMBEDDED=OFF
	cmake --build build
}

check() {
	VERBOSE=1 cmake --build build --target check
}

package() {
	DESTDIR="$pkgdir" cmake --build build --target install
}

sha512sums="
8c60947afb447a73cdf6a41f5d8339c0e34439cfec784ff845783d7c967453f0a9be777e033329a4033f7131e90e54e72a34e01c878c6626c7cbdb7bfd6cbf82  pahole-1e342ac44979748bcf5bb37f84ea055e7f4d7184.tar.gz
"
