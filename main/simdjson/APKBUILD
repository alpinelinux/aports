# Contributor: Grigory Kirillov <txgk@bk.ru>
# Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
pkgname=simdjson
pkgver=5.0.4
pkgrel=0
pkgdesc="Parsing gigabytes of JSON per second"
url="https://simdjson.org/"
arch="all"
_llvmver=21
license="Apache-2.0 OR MIT"
# tests take a very long time to compile and require downloading other JSON parsers
options="!check"
makedepends="cmake samurai"
subpackages="$pkgname-static $pkgname-dev"
source="https://github.com/simdjson/simdjson/archive/v$pkgver/simdjson-$pkgver.tar.gz"

case "$CARCH" in
	loongarch64)
		# lasx impl fails on gcc with https://gcc.gnu.org/bugzilla/show_bug.cgi?id=65873
		makedepends="$makedepends clang$_llvmver"
		export CC="clang-$_llvmver"
		export CXX="clang++-$_llvmver"
		export CXXFLAGS="$CXXFLAGS -mlasx -mlsx"
		;;
	*) ;;
esac

build() {
	cmake -B builddir -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	cmake -B builddir-static -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release
	cmake --build builddir
	cmake --build builddir-static
}

package() {
	DESTDIR="$pkgdir" cmake --install builddir-static
	# We must install shared build after static build to use
	# simdjsonTargets.cmake for shared build.
	DESTDIR="$pkgdir" cmake --install builddir
}

sha512sums="
