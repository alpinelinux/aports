# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=venus-protocol
pkgver=1.1.3
pkgrel=0
pkgdesc="virtio-GPU protocol for vulkan command serialization"
url="https://gitlab.freedesktop.org/virgl/venus-protocol"
arch="all"
license="MIT"
makedepends="meson py3-mako"
source="https://gitlab.freedesktop.org/virgl/venus-protocol/-/archive/v1.1.3/venus-protocol-v1.1.3.tar.gz"
builddir="$srcdir/"$pkgname-v$pkgver

build() {
	abuild-meson \
		output .
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
