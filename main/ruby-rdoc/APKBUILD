# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-rdoc
_gemname=rdoc
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=7.0.4
pkgrel=0
pkgdesc="Ruby documentation tool (rdoc and ri)"
url="https://ruby.github.io/rdoc"
arch="noarch"
license="Ruby"
depends="ruby"
subpackages="$pkgname-doc"
source="https://github.com/ruby/rdoc/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"
# Tests are not run to avoid circular dependencies, ruby-rdoc is needed to
# build almost every other gem.
options="!check"

build() {
	gem build $_gemname.gemspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	# Can't generate ri docs here, we're the ones providing rdoc.
	gem install \
		--local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	mkdir -p "$pkgdir"/usr/share/man/man1
	mv "$geminstdir"/man/ri.1 "$pkgdir"/usr/share/man/man1/

	# Remove unnessecary files. Keep plugins/; RubyGems 4 loads the rdoc's
	# rubygems_plugin.rb from there and without it `gem install` doesn't
	# generate ri docs.
	cd "$gemdir"
	rm -rf build_info cache doc extensions

	cd "$geminstdir"
	rm -rf man ./*.md ./*.rdoc
}

sha512sums="
8d19ec8541771986ed5d03ebae1e58f092d0ce15e9c520ec127c2714e8295effff9aae00ff668f8762731fd6c692a46e598c8a784e13afbe740bbad6798cce09  rdoc-7.0.4.tar.gz
"
