pkgname=gnutls
pkgver=3.8.14
pkgrel=0
pkgdesc="TLS protocol implementation"
url="https://www.gnutls.org/"
arch="all"
license="LGPL-2.1-or-later"
checkdepends="diffutils datefudge"
makedepends="
	brotli-dev
	libidn2-dev
	libkcapi-dev
	libtasn1-dev
	libunistring-dev
	linux-headers
	nettle-dev
	p11-kit-dev
	texinfo
	zlib-dev
	zstd-dev
	"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-dev $pkgname-utils $pkgname-c++:xx"
_v=${pkgver%.*}
case $pkgver in
*.*.*.*) _v=${_v%.*};;
esac
source="https://www.gnupg.org/ftp/gcrypt/gnutls/v$_v/gnutls-$pkgver.tar.xz
	tests-certtool.patch
	gnutls-3.8.8-tests-ktls-skip-tls12-chachapoly.patch
	skip-meaningless-pthread-rwlock-test.patch
	skip-test-thread-optim2_patch
	test-ktls_keyupdate.sh_patch
	"

