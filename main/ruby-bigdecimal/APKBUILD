# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-bigdecimal
_gemname=bigdecimal
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=4.0.1
pkgrel=0
pkgdesc="Arbitrary-precision decimal floating-point number library for Ruby"
url="https://github.com/ruby/bigdecimal"
arch="all"
license="BSD-2-Clause AND Ruby"
depends="ruby"
makedepends="ruby-dev"
checkdepends="
	ruby-test-unit
	ruby-test-unit-ruby-core
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/bigdecimal/archive/v$pkgver/$_gemname-$pkgver.tar.gz
	skip-tests-exceeding-32bit-exponent-range.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec

	gem install \
		--local \
		--build-root dist \
		--document ri \
		--verbose \
		$_gemname
}

check() {
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir')" \
	ruby -I lib -I test/lib -r helper \
		-e "Dir.glob('./test/**/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/

	# Remove unnecessary files.
	cd "$gemdir"
	rm -r build_info cache
	rmdir plugins || true
	find extensions/ -name mkmf.log -delete

	cd gems/$_gemname-$pkgver
	rm -r ext/ sample/
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

