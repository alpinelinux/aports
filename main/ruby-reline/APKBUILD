# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-reline
_gemname=reline
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=0.6.3
pkgrel=0
pkgdesc="Alternative GNU Readline or Editline implementation in pure Ruby"
url="https://github.com/ruby/reline"
arch="noarch"
license="Ruby"
depends="ruby"
makedepends="ruby-rdoc"
checkdepends="ruby-test-unit"
subpackages="$pkgname-doc"
source="https://github.com/ruby/reline/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	ruby -I lib -I test \
		-e "Dir.glob('./test/reline/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files.
	cd "$gemdir"
	rm -rf build_info cache extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm README.md
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
e6e85100efbf8a4c6c2decd3d89091ce756f6e27604e9068de308a79dd2a3f4a0419679b4c442c88e5d7b635fd103a2f6c0f950a808bdcdd8c63c97aa0b49436  reline-0.6.3.tar.gz
"
