maintainer="Michał Polański <michal@polanski.me>"
pkgname=py3-poetry-core
_pkgname=poetry-core
pkgver=2.5.0
pkgrel=0
pkgdesc="PEP 517 build backend implementation for Poetry"
url="https://github.com/python-poetry/poetry-core"
license="MIT"
arch="noarch"
depends="
	py3-fastjsonschema
	py3-lark-parser
	py3-packaging
	"
makedepends="py3-gpep517"
checkdepends="
	git
	py3-build
	py3-pip
	py3-pytest
	py3-pytest-mock
	py3-setuptools
	py3-tomli-w
	py3-trove-classifiers
	py3-virtualenv
	python3-dev
	"
subpackages="$pkgname-pyc"
source="https://github.com/python-poetry/poetry-core/archive/$pkgver/py3-poetry-core-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

prepare() {
	default_prepare
	# Remove vendored dependencies early so we don't test against them
	# and so we don't have to locate them later.
	rm -r src/poetry/core/_vendor
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# Many tests fail if we are not in a git repository. An empty one works.
	git init 2>/dev/null
	export CFLAGS="$CFLAGS -Wno-error=int-conversion"
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/poetry_core-$pkgver-py3-none-any.whl
}

sha512sums="
1e1fbf24df2011c3713568686eda26c90d3c5c5d96744e30787d7072762477a3a6e5a4a75efc04f45599461a8872b86a4c71249bdfd2e75bbd9e90de96444f34  py3-poetry-core-2.5.0.tar.gz
"
