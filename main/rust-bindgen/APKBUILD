4607fb1d6976a08624ab7b855bd4c7316165188e5f672668792705372463baefef5e53feb729f339e0e160c60b51609ff7ffd3a2b8d248a2ca99313be227903f  arm-test_wrap_static_fns.patch
af84fbe27811207feb31d87a3fa3b0c1226d5920125b2866638d26c2b7f2e8ed661e73986c155503abdf2e63500f2662c16696bff66518941ffe5d3f8a0712e5  fix_tests_that_fail_when_run_concurrently.patch
"
