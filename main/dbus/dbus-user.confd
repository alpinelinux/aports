# This file should export DBUS_SESSION_BUS_ADDRESS. This allows
# us to (a) reexport it within the depend, making it available to
# services which need this env; and (b) the user's shell configuration
# files can use rc-environ -U to have access to it.

export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
