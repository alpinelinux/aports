# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-benchmark
_gemname=benchmark
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=0.5.0
pkgrel=0
pkgdesc="Performance benchmarking library for Ruby"
url="https://github.com/ruby/benchmark"
arch="noarch"
license="BSD-2-Clause OR Ruby"
depends="ruby"
makedepends="ruby-rdoc"
checkdepends="ruby-test-unit"
subpackages="$pkgname-doc"
source="https://github.com/ruby/benchmark/archive/v$pkgver/$_gemname-$pkgver.tar.gz
	gemspec.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	ruby -I lib -e "Dir.glob('./test/**/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files.
	cd "$gemdir"
	rm -rf build_info cache extensions
	rmdir plugins || true
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
