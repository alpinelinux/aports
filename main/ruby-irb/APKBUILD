# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-irb
_gemname=irb
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=1.16.0
pkgrel=0
pkgdesc="Interactive Ruby command-line tool for REPL (Read Eval Print Loop)"
url="https://github.com/ruby/irb"
arch="noarch"
license="BSD-2-Clause OR Ruby"
depends="
	ruby
	ruby-rdoc
	ruby-reline
	"
checkdepends="
	ruby-test-unit
	ruby-test-unit-ruby-core
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/irb/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	# DebuggerIntegrationTest, *_debug*: require ruby-debug, which depends
	#  on ruby-irb (circular dependency).
	# ruby_box: Ruby::Box is experimental, ruby crashes with [BUG].
	# use_tracer: requires tracer gem, which is not packaged.
	ruby -I lib -I test -I test/lib -r helper \
		-e "Dir.glob('./test/irb/**/test_*.rb', &method(:require))" -- --verbose \
		--ignore-testcase='/^TestIRB::DebuggerIntegrationTest$/' \
		--ignore-name='/^test_(context_mode_ruby_box|use_tracer_enabled_when_gem_is_available|direct_debug_session_loads_history|history_saving_with_debug.*)$/'
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	mkdir -p "$pkgdir"/usr/share/man/man1
	mv "$geminstdir"/man/irb.1 "$pkgdir"/usr/share/man/man1/

	# Remove unnessecary files.
	cd "$gemdir"
	rm -rf build_info cache extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm -r doc man Gemfile ./*.md
}

doc() {
	# Man page and ri docs.
	default_doc
	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
4a1a367d3ffa6e99810041ef9b1c21666176691abd40d6d8be73692541822acb5c32068a072d4b7511252fe572b282338c9732c5ef6cbefdcd42ed4e9ec56d0f  irb-1.16.0.tar.gz
"
