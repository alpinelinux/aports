#     - CVE-2022-36227
#   3.6.1-r0:
#     - CVE-2022-26280
#   3.6.0-r0:
#     - CVE-2021-36976
#   3.4.2-r0:
#     - CVE-2019-19221
#     - CVE-2020-9308
#   3.4.0-r0:
#     - CVE-2019-18408
#   3.3.2-r1:
#     - CVE-2017-14166

build() {
	CFLAGS="$CFLAGS -ffat-lto-objects -flto=auto" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--without-xml2
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

tools() {
	pkgdesc="libarchive tools bsdtar and bsdcpio"

	amove usr/bin
}

