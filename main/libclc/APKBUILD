# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=libclc
pkgver=23.1.1
_pkgver=${pkgver/_/-}
pkgrel=0
# NOTE: Upgrade together with the whole LLVM suite.
_llvmver=${pkgver%%.*}
pkgdesc="Open source implementation of the library requirements of the OpenCL C programming language"
url="https://libclc.llvm.org/"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
	clang$_llvmver
	cmake
	llvm$_llvmver-dev
	llvm$_llvmver-static
	llvm$_llvmver-gtest
	python3
	samurai
	spirv-llvm-translator-dev
	"
checkdepends="llvm$_llvmver-test-utils"
subpackages="$pkgname-dev"
# We use upstream libclc and cherry-pick mesa's libclc fixes that is requires to work from
# https://gitlab.freedesktop.org/karolherbst/mesa-libclc
source="https://github.com/llvm/llvm-project/releases/download/llvmorg-$_pkgver/llvm-project-$_pkgver.src.tar.xz
	0001-libclc-disable-use-of-SPV_KHR_fma-extension.patch
	0002-libclc-restore-old-fma-behavior.patch
	0003-libclc-add-__clc_mesa_libclc_version.patch
	0004-libclc-disable-fp16-version-of-atan2-and-atan2pi.patch
	0005-libclc-Revert-libclc-Update-remquo-187998.patch
	0006-libclc-Revert-libclc-Update-hypot-implementation-185.patch
	0007-libclc-Partly-revert-libclc-Update-trigpi-functions-.patch
	0008-libclc-fix-tgamma-precision-issues-due-to-lack-of-fm.patch
	pkgconfig.patch
	"
_basedir="$srcdir/llvm-project-$_pkgver.src"
builddir="$_basedir/libclc"

_targets="spirv32-unknown-unknown spirv64-unknown-unknown spirv32-unknown-vulkan spirv64-unknown-vulkan"

build() {
	for target in $_targets; do
		CC=clang-$_llvmver \
		CXX=clang++-$_llvmver \
		cmake -B "build-$target" -G Ninja \
			-DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_INSTALL_PREFIX=/usr \
			-DLLVM_DEFAULT_TARGET_TRIPLE="$target" \
			-DLLVM_CONFIG="llvm-config-$_llvmver" \
			-DLLVM_SPIRV=/usr/bin/llvm-spirv \
			-DLLVM_INCLUDE_TESTS="$(want_check && echo ON || echo OFF)"
		cmake --build "build-$target"
	done
}

check() {
	for target in $_targets; do
		cmake --build "build-$target" --target check-libclc
	done
}

package() {
	for target in $_targets; do
		DESTDIR="$pkgdir" cmake --install "build-$target"
	done
}

