From: LN Liberda <lauren@selfisekai.rocks>
Date: Fri, 23 Oct 2026 16:51:24 +0200
Subject: [PATCH] Hardcode system path

---
 lib/Mozilla/CA.pm | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/lib/Mozilla/CA.pm b/lib/Mozilla/CA.pm
index 68ec1f2..88f7b47 100644
--- a/lib/Mozilla/CA.pm
+++ b/lib/Mozilla/CA.pm
@@ -8,8 +8,7 @@ use File::Spec ();
 use File::Basename qw(dirname);
 
 sub SSL_ca_file {
-    my $file = File::Spec->catfile(dirname(__FILE__), "CA", "cacert.pem");
-    return File::Spec->rel2abs($file);
+    return "/etc/ssl/cert.pem";
 }
 
 1;
