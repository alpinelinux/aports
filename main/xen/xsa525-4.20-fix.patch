From 6809cf832df0d449b313eea9788f1c5f8badf83b Mon Sep 17 00:00:00 2001
From: Andrew Cooper <andrew.cooper3@citrix.com>
Date: Tue, 10 Nov 2026 19:53:44 +0000
Subject: [PATCH] x86/spec-ctrl: Fix build following XSA-525

Fixes: 3a5c9726b2bf ("x86/spec-ctrl: Mitigate the new TSA-Fill variant")
Signed-off-by: Andrew Cooper <andrew.cooper3@citrix.com>
---
 xen/arch/x86/spec_ctrl.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xen/arch/x86/spec_ctrl.c b/xen/arch/x86/spec_ctrl.c
index 42455386387f..0fb1508fa626 100644
--- a/xen/arch/x86/spec_ctrl.c
+++ b/xen/arch/x86/spec_ctrl.c
@@ -1611,7 +1611,7 @@ static void __init tsa_sq_l1_calculations(void)
 static void __init tsa_fill_calculations(void)
 {
     /* TSA is only known to affect AMD processors at this time. */
-    if ( boot_cpu_data.vendor != X86_VENDOR_AMD )
+    if ( boot_cpu_data.x86_vendor != X86_VENDOR_AMD )
         return;
 
     /* If we're virtualised, don't attempt to synthesise anything. */
