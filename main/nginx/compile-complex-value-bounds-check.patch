From e67a4a22c72be5ae4621d0d4d91100feba50e6e9 Mon Sep 17 00:00:00 2001
From: Feng Wu <wufengwufengwufeng@gmail.com>
Date: Wed, 24 Jun 2026 07:22:43 +0800
Subject: [PATCH] Add missing bounds check in
 ngx_{http,stream}_compile_complex_value()

Complex value compilation scans strings for $1..$9 capture references.
Check that a byte after '$' is present before testing it, matching
ngx_str_t length semantics and avoiding reliance on NUL termination.

Apply the same check to both HTTP and stream implementations.

(cherry picked from commit 37362244dc0da7368b60e36f5b1acbb728f7471a)
---
 src/http/ngx_http_script.c     | 4 +++-
 src/stream/ngx_stream_script.c | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/http/ngx_http_script.c b/src/http/ngx_http_script.c
index 9c97a5b08..6abd8e398 100644
--- a/src/http/ngx_http_script.c
+++ b/src/http/ngx_http_script.c
@@ -156,7 +156,9 @@ ngx_http_compile_complex_value(ngx_http_compile_complex_value_t *ccv)
 
     for (i = 0; i < v->len; i++) {
         if (v->data[i] == '$') {
-            if (v->data[i + 1] >= '1' && v->data[i + 1] <= '9') {
+            if (i + 1 < v->len
+                && v->data[i + 1] >= '1' && v->data[i + 1] <= '9')
+            {
                 nc++;
 
             } else {
diff --git a/src/stream/ngx_stream_script.c b/src/stream/ngx_stream_script.c
index 559b8b9fb..54e5dd559 100644
--- a/src/stream/ngx_stream_script.c
+++ b/src/stream/ngx_stream_script.c
@@ -157,7 +157,9 @@ ngx_stream_compile_complex_value(ngx_stream_compile_complex_value_t *ccv)
 
     for (i = 0; i < v->len; i++) {
         if (v->data[i] == '$') {
-            if (v->data[i + 1] >= '1' && v->data[i + 1] <= '9') {
+            if (i + 1 < v->len
+                && v->data[i + 1] >= '1' && v->data[i + 1] <= '9')
+            {
                 nc++;
 
             } else {
