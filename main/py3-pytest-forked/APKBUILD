# Contributor: Dmitry Romanenko <dmitry@romanenko.in>
# Maintainer: Dmitry Romanenko <dmitry@romanenko.in>
pkgname=py3-pytest-forked
_pyname=pytest_forked
pkgver=1.7.5
pkgrel=0
pkgdesc="extracted --boxed from pytest-xdist to ensure backward compat"
url="https://github.com/pytest-dev/pytest-forked"
arch="noarch"
license="MIT"
depends="py3-pytest"
makedepends="py3-gpep517 py3-setuptools py3-setuptools_scm py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/p/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir"/$_pyname-$pkgver

replaces="pytest-forked" # Backwards compatibility
provides="pytest-forked=$pkgver-r$pkgrel" # Backwards compatibility

# Handled by py3-setuptools_scm
export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver

prepare() {
	default_prepare
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# test_xfail expects truncated summary lines, which pytest does not
	# do when CI is set
	CI= .testenv/bin/python3 -m pytest -v -x --tb=long
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
0aa6748a24e7e2fb6e4d217e4a0fb8b0a2c9f680a8c7db1dfd168a646ca15c5f303db9be4aa459d02d5686b7cf580b20f73a4ce8911bb9ae2d45ca0450ed63a5  pytest_forked-1.7.5.tar.gz
"
