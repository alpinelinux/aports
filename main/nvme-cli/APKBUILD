# Contributor: Florian Heigl <florian.heigl@gmail.com>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=nvme-cli
pkgver=3.2
pkgrel=0
pkgdesc="NVM-Express user space tooling for Linux"
arch="all"
url="https://github.com/linux-nvme/nvme-cli"
license="GPL-2.0-or-later"
makedepends="
	bash
	json-c-dev
	keyutils-dev
	kmod-dev
	linux-headers
	meson
	openssl-dev
	util-linux-dev
	uuidgen
	zlib-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-udev
	$pkgname-libs
	$pkgname-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/linux-nvme/nvme-cli/archive/v$pkgver.tar.gz
	"
options="!check" # needs pci nvme stuff

build() {
	abuild-meson \
		-Db_lto=true \
		-Ddocs=man \
		-Dudevrulesdir=/usr/lib/udev/rules.d/ \
		-Djson-c=enabled \
		-Dkeyutils=enabled \
		-Dlibarchive=disabled \
		-Dlibkmod=enabled \
		-Dnvme-discoverd=disabled \
		-Dopenssl=enabled \
		-Dpython=disabled \
		-Dtests=false \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	rm -rf "$pkgdir"/usr/lib/systemd
}

sha512sums="
7d7b28c73c7ad9cf3652ce96775930fb44e85917fc1eda2b0ff219e18b7508bccd29092a333baacb68bf1c8aa7ba564fb99419d11e48d88d7a47d08b144fa69c  nvme-cli-3.2.tar.gz
"
