# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=quickjs-ng
# May contain ABI changes in minor versions, e.g. 0.y.z where y is incremented.
# Please verify dependent(s) can rebuild for new version when upgrading.
pkgver=0.17.0
pkgrel=0
_test262=b363f29d3c43c626dc852744ad64a0b48a003693
pkgdesc="Embeddable JavaScript engine in C (NG fork)"
url="https://quickjs-ng.github.io/quickjs/"
arch="all"
license="MIT"
makedepends="muon"
subpackages="
	$pkgname-doc
	$pkgname-libs
	$pkgname-libs-static
	$pkgname-dev
	"
source="https://github.com/quickjs-ng/quickjs/archive/refs/tags/v$pkgver/quickjs-ng-$pkgver.tar.gz
	https://github.com/tc39/test262/archive/$_test262/test262-$_test262.tar.gz
	fix-tests.patch
	"
builddir="$srcdir/quickjs-$pkgver"

# secfixes:
#   0.16.1-r0:
#     - CVE-2026-0821
#     - CVE-2026-0822
#     - CVE-2026-1144
#     - CVE-2026-1145
#   0.10.0-r0:
#     - CVE-2025-46687
#     - CVE-2025-46688

prepare() {
	default_prepare

	rmdir -v test262
	mv -v "$srcdir"/test262-$_test262 test262
}

build() {
	abuild-muon \
		-Ddefault_library=both \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		output .
	ninja -C output
}

check() {
	# Allow fail: tests pass in loongarch64 CI, but fail on the builder
	# s390x: function_source, array-fromasync-enumerable.js:9
	# SyntaxError: checksum error
	muon -C output test -j "${JOBS:-0}" -R -d dots \
		|| [ "$CARCH" = "loongarch64" ] \
		|| [ "$CARCH" = "s390x" ]

	case "$CARCH" in
	*64*)
		local i; for i in $(seq 0 3); do
			[ $i -eq 0 ] || msg "Retrying ($i/3)..."
			./output/run-test262 -c test262.conf && return 0
			sleep 1
		done
		return 1
		;;
	esac
}

package() {
	DESTDIR="$pkgdir" muon -C output install

	cd "$pkgdir"
	mkdir -p usr/share/licenses/$pkgname/
	mv -v usr/share/doc/$pkgname/LICENSE usr/share/licenses/$pkgname/
}

