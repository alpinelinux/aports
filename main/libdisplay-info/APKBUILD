maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=libdisplay-info
pkgver=0.4.0
pkgrel=0
pkgdesc="EDID and DisplayID library"
url="https://gitlab.freedesktop.org/emersion/libdisplay-info"
arch="all"
license="MIT"
makedepends="
	hwdata-dev
	meson
	"
subpackages="
	$pkgname-dev
	$pkgname-tools
	"
source="https://gitlab.freedesktop.org/emersion/libdisplay-info/-/archive/$pkgver/libdisplay-info-$pkgver.tar.gz"
options="!check" # edid-decode

build() {
	abuild-meson -Db_lto=true . output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

tools() {
	pkgdesc="$pkgdesc (tools)"
	amove usr/bin
}

sha512sums="
e1fd3ebc4e68500df31539e65168e5bc8b26b1315ef0796c1e073e58fa5e177d13338ba3caaf4e8edff89634ad73134062013400439c18cf8c522df85681e862  libdisplay-info-0.4.0.tar.gz
"
