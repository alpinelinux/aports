29a84c25329c671e1a96dde0df02701f9c175ca3e137676803514abda523e59328ef727059f5e83b6f3756cbbb6281ef5a547b2c41525c9df78fc88a1ed90b0f  skip-s390x.patch
b0bc72c1aef8009111928ad20a13eeaa6b701e65ebfbf74e8783033aaa6e021237b0376f5d1fe1061cb26d4ba916a180c9b15daa7a5b7acecd6e1dc9b86818c5  limits-include.patch
