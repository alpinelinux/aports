build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-ipv6

	# seems to be problem with timestamps
	sleep 1
	./config.status

	make all shared
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install install-shared
}

