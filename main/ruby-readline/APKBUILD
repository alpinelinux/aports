# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-readline
_gemname=readline
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=0.0.4
pkgrel=0
pkgdesc="Loader for readline (provided by reline) for Ruby"
url="https://github.com/ruby/readline"
arch="noarch"
license="Ruby"
depends="ruby ruby-reline"
makedepends="ruby-rdoc"
subpackages="$pkgname-doc"
source="https://github.com/ruby/readline/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"
options="!check"  # no test suite

build() {
	gem build $_gemname.gemspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files.
	cd "$gemdir"
	rm -rf build_info cache extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm README.md
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
85d8ea9dffc06812cbcb0925f6da5ddbafc4b5d923031f9c7d7ab0145f7538ab943a8f1f4ee8dcdd4b08fc45bda02258d5475ff29a7332efe5f81a4fecfb2423  readline-0.0.4.tar.gz
"
