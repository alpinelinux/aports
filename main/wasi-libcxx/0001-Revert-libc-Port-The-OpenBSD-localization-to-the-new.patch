From 75a39fb23bc62e44fc86fdc68cc6c6d39510d450 Mon Sep 17 00:00:00 2001
From: Aelin <aelin@postmarketos.org>
Date: Fri, 4 Sep 2026 18:50:51 +0200
Subject: [PATCH] Revert "[libc++] Port The OpenBSD localization to the new
 locale API (#194317)"

This reverts commit 182ae96a82fc355eca89d12c179d6a0961c653d8.
---
 libcxx/include/CMakeLists.txt                 |   3 +-
 libcxx/include/__locale_dir/locale_base_api.h |   8 +-
 .../__locale_dir/locale_base_api/openbsd.h    |  19 ++
 libcxx/include/__locale_dir/support/openbsd.h | 229 ------------------
 .../__support/xlocale/__strtonum_fallback.h   |  37 +++
 libcxx/include/module.modulemap.in            |   2 +-
 6 files changed, 64 insertions(+), 234 deletions(-)
 create mode 100644 libcxx/include/__locale_dir/locale_base_api/openbsd.h
 delete mode 100644 libcxx/include/__locale_dir/support/openbsd.h
 create mode 100644 libcxx/include/__support/xlocale/__strtonum_fallback.h

