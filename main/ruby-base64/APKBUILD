# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-base64
_gemname=base64
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=0.3.0
pkgrel=0
pkgdesc="Support for encoding and decoding binary data using a Base64"
url="https://github.com/ruby/base64"
arch="noarch"
license="BSD-2-Clause AND Ruby"
depends="ruby"
makedepends="ruby-rdoc"
checkdepends="ruby-test-unit"
subpackages="$pkgname-doc"
source="https://github.com/ruby/base64/archive/v$pkgver/$_gemname-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"

prepare() {
	default_prepare
	sed -i '/require .bundler/d' Rakefile
}

build() {
	gem build $_gemname.gemspec
}

check() {
	ruby -I lib -e "Dir.glob('./test/**/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files
	cd "$gemdir"
	rm -r build_info cache extensions
	rmdir plugins || true

	cd "$gemdir"/gems/$_gemname-$pkgver
	rm -f README*
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
7b3e29c59c4b2f4ef9b6498e5781f416efcb58ac39c33189f2b44611f564925795260a8eb5a245126e966dd1daf6f4586f985ab17dc84b9d0f2536502751960e  base64-0.3.0.tar.gz
"
