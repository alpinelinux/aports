#!/bin/sh

ver_new="$1"
ver_old="$2"

if [ "$(apk version -t "$ver_old" "2.5.0-r0")" = "<" ]; then
	cat >&2 <<-EOF
	*
	* In Ruby 2.5 more parts of the stdlib has been splitted into standalone
	* gems, yet still installed with Ruby by default. We have moved some of
	* them into separate subpackages. If you don't know which subpackages you
	* need, you may install meta-package "ruby-full".
	* 
	EOF
fi

if [ "$(apk version -t "$ver_old" "4.0.0-r0")" = "<" ]; then
	cat >&2 <<-EOF
	*
	* In Ruby 4.0 more default gems (benchmark, irb, logger, ostruct, pstore,
	* rdoc, readline, reline) have been promoted to "bundled" gems and moved
	* into separate packages (e.g. ruby-logger). If you don't know which
	* packages you need, you may install meta-package "ruby-full".
	*
	EOF
fi

exit 0
