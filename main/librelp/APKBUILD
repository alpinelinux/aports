# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=librelp
pkgver=1.13.0
pkgrel=0
pkgdesc="The Reliable Event Logging Protocol library"
url="https://www.rsyslog.com"
arch="all"
license="GPL-3.0-or-later"
makedepends="openssl-dev"
checkdepends="
	bash
	coreutils
	grep
	"
subpackages="$pkgname-static $pkgname-dev"
source="https://download.rsyslog.com/librelp/librelp-$pkgver.tar.gz"
options="!check" # XXX: some fail in CI, don't know why

build() {
	# --disable-tls disables just GnuTLS
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--enable-valgrind=no \
		--disable-tls \
		--enable-tls-openssl
	make
}

check() {
	make -j1 check || {
		cat tests/test-suite.log
		return 1
	}
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
1b93a232521f9135054939ccd80078b4932c6efb17624cfb29b48c5de02db76e5e900f2e6ef7267e524a34a995ef3d27574c79fc4c3bcbd45e6f8f895f1d9a46  librelp-1.13.0.tar.gz
"
