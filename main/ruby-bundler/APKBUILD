# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-bundler
_gemname=bundler
pkgver=4.0.24
pkgrel=0
pkgdesc="Manage an application's gem dependencies"
url="https://bundler.io/"
arch="noarch"
license="MIT"
depends="ruby"
makedepends="
	ruby-rake
	ruby-rdoc
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/rubygems/archive/v$pkgver/rubygems-$pkgver.tar.gz
	manpages.patch
	"
builddir="$srcdir/rubygems-$pkgver/bundler"
options="!check"  # tests require deps not available in main repo

build() {
	gem build $_gemname.gemspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	local n; for n in 1 5; do
		mkdir -p "$pkgdir"/usr/share/man/man$n
		mv "$gemdir"/gems/$_gemname-$pkgver/lib/bundler/man/*.$n "$pkgdir"/usr/share/man/man$n/
	done

	rm -r "$gemdir"/cache \
		"$gemdir"/build_info \
		"$gemdir"/doc \
		"$gemdir"/extensions \
		"$gemdir"/gems/$_gemname-$pkgver/*.md
	rmdir "$gemdir"/plugins || true
}

sha512sums="
