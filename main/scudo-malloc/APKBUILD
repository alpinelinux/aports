# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=scudo-malloc
pkgver=23.1.1
pkgrel=0
_pkgver=${pkgver/_/-}
# NOTE: Upgrade together with the whole LLVM suite.
_llvmver=${pkgver%%.*}
pkgdesc="Standalone scudo malloc from compiler-rt"
url="https://llvm.org"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
provider_priority=100  # highest
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
	clang$_llvmver
	cmake
	linux-headers
	llvm$_llvmver-dev
	llvm$_llvmver-gtest
	llvm$_llvmver-static
	llvm$_llvmver-test-utils
	python3
	samurai
	"
checkdepends="gtest-dev"
subpackages="$pkgname-static $pkgname-dev"
source="https://github.com/llvm/llvm-project/releases/download/llvmorg-$_pkgver/llvm-project-$_pkgver.src.tar.xz
	0001-Fix-musl-build-errors.patch
	"
_basedir="$srcdir/llvm-project-$_pkgver.src"
builddir="$_basedir/compiler-rt"

case "$CARCH" in
ppc64le)
	# tests/common_test.cpp:33: Failure
	# Expected: (OnStart) > (0UL), actual: 0 vs 0
	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/16235
	options="!check"
	;;
esac

build() {
	CC=clang-$_llvmver \
	CXX=clang++-$_llvmver \
	cmake -B build -G Ninja -Wno-dev \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCOMPILER_RT_BUILD_SANITIZERS=ON \
		-DCOMPILER_RT_HAS_SCUDO_STANDALONE=ON \
		-DCOMPILER_RT_SANITIZERS_TO_BUILD="scudo_standalone" \
		-DCOMPILER_RT_ENABLE_TEST_SUITES="scudo_standalone" \
		-DCOMPILER_RT_BUILD_BUILTINS=OFF \
		-DCOMPILER_RT_INCLUDE_TESTS="$(want_check && echo ON || echo OFF)" \
		-DLLVM_EXTERNAL_LIT=/usr/lib/llvm$_llvmver/bin/lit \
		-DCMAKE_VERBOSE_MAKEFILE=ON
	cmake --build build --target scudo_standalone
}

check() {
	cmake --build build --target check-scudo_standalone
}

package() {
	local suffix
	case "$CARCH" in
	x86)		suffix="-i386"		;;
	armv7)		suffix="-armhf"		;;
	ppc64le)	suffix="-powerpc64le"	;;
	*)		suffix="-$CARCH"	;;
	esac

	install -Dm755 build/lib/linux/libclang_rt.scudo_standalone$suffix.so "$pkgdir"/usr/lib/libscudo.so
	install -Dm644 build/lib/linux/libclang_rt.scudo_standalone$suffix.a "$pkgdir"/usr/lib/libscudo.a
	install -Dm644 lib/scudo/standalone/include/scudo/interface.h -t "$pkgdir"/usr/include/scudo/
}

sha512sums="
e51c45f01e95272771bfee8382b213a2e21d3c62e273ff58967cfe40b87f45d2b37a4797b8b83fab025ed7a0ad32adef48406ade2d049da3d7f1799b30edea39  llvm-project-23.1.1.src.tar.xz
db00a29c9d8c50f69842c19f89dd29290db0b10393cba99a6592678dc90eaab9c46cfcc78810371868339cd0f7b246790674544bd4c1c8f9bcfb42799c046af9  0001-Fix-musl-build-errors.patch
"
