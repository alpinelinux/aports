# Contributor: Cameron Banta <cbanta@gmail.com>
# Maintainer: qaqland <qaq@qaq.land>
maintainer="qaqland <qaq@qaq.land>"
pkgname=less
pkgver=710
pkgrel=0
pkgdesc="File pager"
url="https://www.greenwoodsoftware.com/less/"
arch="all"
license="GPL-3.0-or-later OR BSD-2-Clause"
makedepends="ncurses-dev"
checkdepends="perl"
subpackages="$pkgname-doc"
source="https://www.greenwoodsoftware.com/less/less-${pkgver/_beta/-beta}.tar.gz"
builddir="$srcdir/less-${pkgver%_beta}"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
