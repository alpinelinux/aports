# Maintainer: Peter Shkenev <santurysim@gmail.com>
pkgname=py3-cffi
_pkgname=cffi
pkgver=2.1.1
pkgrel=0
pkgdesc="Foreign function interface for calling C code from Python3"
url="https://cffi.readthedocs.io/"
arch="all"
license="MIT"
depends="py3-cparser"
makedepends="
	libffi-dev
	python3-dev
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz
	"
builddir="$srcdir/$_pkgname-$pkgver"

replaces="py-cffi" # Backwards compatibility
provides="py-cffi=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	PYTHONPATH="$(echo "$builddir"/build/lib.linux-*)" \
	.testenv/bin/python3 -m pytest -v \
		--disable-pytest-warnings testing/
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
60299646ae72e54155a3ca220f00a2b2fee079276a01ff13e30fb6af0d19b07fb4ae539af55e4704ce2081d34c4a3079ef43c0dcb2fe854f835f8441b348f7c5  cffi-2.1.1.tar.gz
"
