pkgname=bats-core
pkgver=1.14.0
pkgrel=0
pkgdesc="Bash Automated Testing System"
url="https://github.com/bats-core/bats-core"
arch="noarch"
license="MIT"
depends="bash"
checkdepends="coreutils-env"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.zip::https://github.com/bats-core/bats-core/archive/v$pkgver.zip"

replaces="bats" # for backward compatibility

check() {
	# CI runners (k8s attach) run scripts as background jobs, so SIGINT/SIGQUIT
	# are inherited as SIG_IGN; the CTRL-C tests need the default disposition
	env --default-signal=INT,QUIT bash -c 'bin/bats --tap test'
}

package() {
	./install.sh "$pkgdir"/usr
}

sha512sums="
