From 86b4ee3296ede77edb685f8c75bb32ca29e2ffe7 Mon Sep 17 00:00:00 2001
From: Sertonix <sertonix@posteo.net>
Date: Sat, 10 Oct 2026 17:20:09 +0200
Subject: [PATCH] abuild: fix infinity loop on awk getline error

---
 abuild.in | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/abuild.in b/abuild.in
index 6032479dabd..a4ed0403391 100644
--- a/abuild.in
+++ b/abuild.in
@@ -1601,7 +1601,7 @@ scan_shared_objects() {
 		for (i in skip_)
 			skip[skip_[i]] = "";
 		l = length("so:" ARGV[2]) + 1
-		while (getline < ARGV[3])
+		while ((getline < ARGV[3]) > 0)
 			skip[substr($0, l, index($0, "=")-l)] = "";
 		ARGC=1
 	} {
@@ -1688,7 +1688,7 @@ scan_pkgconfig_depends() {
 		set -o pipefail
 		pkg-config --print-requires --print-requires-private "$@" |
 		awk 'BEGIN {
-			while (getline < ARGV[1])
+			while ((getline < ARGV[1]) > 0)
 				skip[substr($0, 4, index($0, "=")-4)] = "";
 			ARGC=1
 		} {
@@ -2593,7 +2593,7 @@ rootbld() {
 		groups["user"] = "user:x:1000:user"
 		for (i in arr)
 			groups[arr[i]] = arr[i] ":x:" gid++ ":";
-		while (getline < (root "/etc/group"))
+		while ((getline < (root "/etc/group")) > 0)
 			groups[$1] = $0
 
 		uid = 100;
@@ -2603,7 +2603,7 @@ rootbld() {
 			$0 = groups[arr[i] in groups ? arr[i] : "nobody"]
 			users[arr[i]] = arr[i] ":x:" uid++ ":" $3 ":" arr[i] ":/dev/null:/sbin/nologin";
 		}
-		while (getline < (root "/etc/passwd"))
+		while ((getline < (root "/etc/passwd")) > 0)
 			users[$1] = $0
 
 		for (i in groups)
-- 
2.56.0

