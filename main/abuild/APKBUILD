347ad2e0515141593e3d011f41ed17cca4420c8023ffb683b184ac1837b7223abfda0c5607177b71cf21a275629589cb61cfe8c81434dc256a27f73e36c3bc37  0001-abuild-exclude-cmd-providers-with-invalid-characters.patch
"
