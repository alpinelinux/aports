From 2770c8ec05ca2a5bbdaf74e340b9dba0257c1fd5 Mon Sep 17 00:00:00 2001
From: Sertonix <sertonix@posteo.net>
Date: Sun, 23 Aug 2026 12:47:08 +0200
Subject: [PATCH] abuild: exclude cmd: providers with invalid characters

Allowed character list from apk-package(5)

Fixes 645c3c07a7d6 abuild: exclude provides for commans with @
---
 abuild.in | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/abuild.in b/abuild.in
index fe54580..d5d18a2 100644
--- a/abuild.in
+++ b/abuild.in
@@ -1318,12 +1318,8 @@ prepare_command_provides() {
 				continue
 			fi
 		fi
-		# exclude any provides: lines for commands that has '@' because '@'
-		# is used as seperator between command name and repository. This
-		# avoids potential conflicts
-		# ref: https://gitlab.alpinelinux.org/alpine/abuild/-/issues/10074
 		case "$i" in
-			*@*) continue;;
+			*[!]a-zA-Z0-9._+,:/[-]*) continue ;;
 		esac
 		local f=${i##*/}
 		echo cmd:$f=$pkgver-r$pkgrel >> "$controldir"/.provides-command
-- 
2.55.0

