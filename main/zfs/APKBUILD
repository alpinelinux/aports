a101124ea2a5e80869984d9a17acad29da947ab925c9a960fb702cf9d8a888d301e878a7ac7bd00a9eda838f68a6a4f24260b98b00c9b46f66c60f8e210a479a  alpine-bash-completion-dir.patch
"
