# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-rss
_gemname=rss
pkgver=0.3.3
pkgrel=0
pkgdesc="RSS reading and writing for Ruby"
url="https://github.com/ruby/rss"
arch="noarch"
license="BSD-2-Clause"
depends="ruby ruby-rexml"
checkdepends="ruby-test-unit"
makedepends="ruby-rdoc"
subpackages="$pkgname-doc"
source="https://github.com/ruby/rss/archive/$pkgver/ruby-rss-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"

prepare() {
	default_prepare
	sed -i '/require .bundler/d' Rakefile
}

build() {
	gem build $_gemname.gemspec
}

check() {
	ruby test/run-test.rb
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files
	cd "$gemdir"
	rm -r build_info cache extensions
	rmdir plugins || true

	cd "$gemdir"/gems/$_gemname-$pkgver
	rm README.* NEWS.*
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
e1065d41ca41b41a6abc2ef3c52d39ef729e5285520d847bd0b0790418c87a4d7ef538114510c283183f36ce9794993a7fcf7fd7e19bfc955e98c4e190993694  ruby-rss-0.3.3.tar.gz
"
