pkgname=cups
pkgver=2.4.20
pkgrel=1
pkgdesc="The CUPS Printing System"
url="https://github.com/OpenPrinting/cups/"
arch="all"
license="Apache-2.0"
depends_dev="libgcrypt-dev gnutls-dev zlib-dev"
makedepends="
	$depends_dev
	avahi-dev
	dbus-dev
	libjpeg-turbo-dev
	libpaper-dev
	libusb-dev
	linux-headers
	"
depends="cups-client poppler-utils openssl dbus"
install="cups.pre-install"
pkggroups="lp lpadmin"
pkgusers="lp"
subpackages="
	$pkgname-dbg
	$pkgname-desktop::noarch
	$pkgname-dev
	$pkgname-doc
	$pkgname-libs
	ipptool
	$pkgname-client
	$pkgname-lang
	$pkgname-openrc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/OpenPrinting/cups/archive/v$pkgver.tar.gz
	$pkgname.logrotate
	cupsd.initd
	cups-no-export-ssllibs.patch
	cups-nostrip.patch
	default-config-no-gssapi.patch
	cups-fix-http-upgrade-options.patch
	"
options="!check"

