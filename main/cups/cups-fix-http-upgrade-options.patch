 		  NULL,
 		  NULL
 		};
@@ -4467,7 +4485,9 @@ http_send(http_t       *http,		/* I - HTTP connection */
   }
 #endif /* HAVE_TLS */
 
-  if (httpPrintf(http, "%s %s HTTP/1.1\r\n", codes[request], buf) < 1)
