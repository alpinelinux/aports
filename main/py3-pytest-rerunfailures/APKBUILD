# Contributor: Philipp Glaum <p@pglaum.de>
# Maintainer: Philipp Glaum <p@pglaum.de>
pkgname=py3-pytest-rerunfailures
pkgver=16.6
pkgrel=0
pkgdesc="Pytest plugin to re-run tests to eliminate flaky failures"
url="https://pypi.org/project/pytest-rerunfailures/"
arch="noarch"
license="MPL-2.0"
depends="
	python3
	py3-pytest
	"
makedepends="
	py3-gpep517
	py3-installer
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-mock"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/p/pytest_rerunfailures/pytest_rerunfailures-$pkgver.tar.gz"
builddir="$srcdir/pytest_rerunfailures-$pkgver"
options="!check"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
13e89a18d70054eeb023836666a0246db268b3361fe943137a05890c8d57035d6e3dda7bc758f6c101df5ea14a14c0be944c18c1c94924e685511e1061291b9d  pytest_rerunfailures-16.6.tar.gz
"
