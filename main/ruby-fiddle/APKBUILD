# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-fiddle
_gemname=fiddle
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=1.1.8
pkgrel=0
pkgdesc="Libffi wrapper for Ruby"
url="https://github.com/ruby/fiddle"
arch="all"
license="BSD-2-Clause OR Ruby"
depends="ruby"
makedepends="
	libffi-dev
	ruby-dev
	"
checkdepends="
	ruby-test-unit
	ruby-test-unit-ruby-core
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/fiddle/archive/v$pkgver/$_gemname-$pkgver.tar.gz
	skip-test_gettimeofday-on-32bit.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec

	gem install \
		--local \
		--build-root dist \
		--document ri \
		--verbose \
		$_gemname
}

check() {
	# test_NEXT, test_static_sym: require -test-/dln/empty, which is built
	#  only in the ruby's own test suite.
	# test_dlopen_linker_script_group_linux: expects glibc.
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir')" \
	ruby test/run.rb \
		--verbose \
		--ignore-name='/^test_(NEXT|static_sym|dlopen_linker_script_group_linux)$/'
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/

	# Remove unnecessary files.
	cd "$gemdir"
	rm -rf build_info cache
	rmdir plugins || true
	find extensions/ -name mkmf.log -delete

	cd "$geminstdir"
	rm -r ext/ README.md Rakefile
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

