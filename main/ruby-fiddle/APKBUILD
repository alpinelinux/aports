ed224a100f2580bc50ac893ddd9dab9ffea55fb699014ee47ebd0ca3d1c9fa6046832a1ca6763e92f5e1ae246d8ddae6a36235e6e0e163aa0d4276e174a53b24  skip-test_gettimeofday-on-32bit.patch
"
