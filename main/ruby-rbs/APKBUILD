# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-rbs
_gemname=rbs
# Keep version in sync with "Bundled gems" (https://stdgems.org) for the
# packaged Ruby version.
pkgver=3.10.4
pkgrel=0
pkgdesc="Type Signature for Ruby"
url="https://github.com/ruby/rbs"
arch="all"
license="BSD-2-Clause AND Ruby"
depends="
	ruby
	ruby-bundler
	ruby-logger
	ruby-rdoc
	"
makedepends="ruby-dev"
checkdepends="
	git
	ruby-bigdecimal
	ruby-rake
	ruby-test-unit
	"
subpackages="$pkgname-doc"
source="https://github.com/ruby/rbs/archive/v$pkgver/$_gemname-$pkgver.tar.gz
	gemspec.patch
	"
# test_loading_from_rbs_collection connects to github.com
options="net"
builddir="$srcdir/$_gemname-$pkgver"

prepare() {
	default_prepare

	# Requires ruby-json-schema which is not in main.
	rm test/rbs/schema_test.rb

	# FIXME: Tries to install gems to / via bundler.
	rm test/rbs/cli_test.rb
}

build() {
	gem build $_gemname.gemspec

	gem install \
		--local \
		--build-root dist \
		--document ri \
		--verbose \
		$_gemname
}

check() {
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir')" \
	SKIP_RBS_VALIDATION=1 \
	ruby -I lib -I test \
		-e "Dir.glob(['./test/*_test.rb', './test/rbs/*_test.rb'], &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r build_info cache
	rmdir plugins || true
	find extensions/ -name mkmf.log -delete

	cd gems/$_gemname-$pkgver
	rm -r ext/
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

sha512sums="
d57114ae70f6b44096543a6a1e5e7790fe2529b2fee63e5224183ab116a985e2faac6b8d517aca1e23978f48e7c79a4b91103b00a774f4c414279e54692c5d41  rbs-3.10.4.tar.gz
93940e85c469e9d6d010bcaee1fd06eeed2aa0a2476ffac1b60d06c6809fb09b7a9a2c1bc981f366c5da88686652687f063ab5b9e81b68eb552ff3289123837f  gemspec.patch
"
