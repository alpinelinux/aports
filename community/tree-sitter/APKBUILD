# Contributor: TBK <alpine@jjtc.eu>
# Contributor: Jakub Jirutka <jakub@jirutka.cz>
maintainer="Matthias Ahouansou <matthias@ahouansou.cz>"
pkgname=tree-sitter
pkgver=0.27.1
pkgrel=0
pkgdesc="Incremental parsing system for programming tools"
url="https://tree-sitter.github.io/"
license="MIT"
arch="all"
depends_dev="jq" # needed for abuild-tree-sitter
makedepends="
	bash
	cargo
	cargo-auditable
	clang-dev
	git
	"
checkdepends="
	nodejs
	openssl-dev
	"
subpackages="
	$pkgname-cli
	$pkgname-static
	$pkgname-dev
	$pkgname-grammars::noarch
	"
source="
	tree-sitter-$pkgver.tar.gz::https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v$pkgver.tar.gz
	abuild-tree-sitter
	use-system-clang.patch
	"
# tests require git cloning remote fixtures
# also for cli/wasm only
# added net for rootbld and 'cargo fetch'
options="net"

if [ "$CARCH" = "armhf" ]; then
	# rquickjs uses 64bit atomics which on armv7, need libatomic to work.
	# without this, __atomic_fetch_sub_8 and friends are undefined.
	export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-latomic"
fi

prepare() {
	default_prepare

	cargo fetch --locked
	cargo xtask fetch-fixtures
}

build() {
	# static & shared lib
	make

	# build the cli
	cargo auditable build -p tree-sitter-cli --frozen --release

	# TODO - build wasm bindings
	# wasm bindings (needs wasmtime-dev, still in testing; possibly more)
}

check() {
	cargo test -p tree-sitter-cli --frozen -- --test-threads=1
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install

	# Prepare directory for grammars provided by other aports.
	mkdir -p "$pkgdir"/usr/lib/tree-sitter
}

cli() {
	pkgdesc="$pkgdesc (CLI)"

	# nodejs: needed for 'tree-sitter generate'
	# wasi-sdk: needed for 'tree-sitter build --wasm'
	depends="nodejs wasi-sdk"

	install -Dm755 "$builddir"/target/release/tree-sitter -t "$subpkgdir"/usr/bin/
}

dev() {
	default_dev

	install -Dm755 "$srcdir"/abuild-tree-sitter -t "$subpkgdir"/usr/bin/
}

grammars() {
	pkgdesc="Meta package for pulling in all tree-sitter grammars"
	depends=""

	mkdir -p "$subpkgdir"
}

sha512sums="
e88861271bcd504f79636811c43c0de94483071f1c6f0f57cc590a2e10f921ca24b87ec631bee4d94d1f124a03a4b74f93c4e5fb8653f62bf484517753882cef  tree-sitter-0.27.1.tar.gz
38e4dd95d68197bb8009f8c71d043881cb9bca2c1e2a8d2b7c12e13981b530285e8823bc63530c6c55e81551571255b63a6c6df2210e315f7138c5e3f68a0d1b  abuild-tree-sitter
ee832211218568ada94f24f016f73bd04378f0e02cda33a501511f0bc4a8bfe27c7e6b9223a0185af6d58508fddeab7c69cefc7a46a747381a6b5969de20edbc  use-system-clang.patch
"
