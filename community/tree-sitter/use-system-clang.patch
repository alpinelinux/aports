+        for exe in &possible_executables {
+            if Command::new(exe)
+                .arg("--version")
+                .stdout(std::process::Stdio::null())
+                .stderr(std::process::Stdio::null())
+                .status()
+                .is_ok()
+            {
+                return Ok(PathBuf::from(exe));
