# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=tlottie
pkgver=1.0.6
pkgrel=0
pkgdesc="rust library for drawing lottie animations"
url="https://github.com/dkaraush/tlottie"
arch="all"
license="MIT"
options="!check" # one test fail
makedepends="cargo cargo-auditable"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/dkaraush/tlottie/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release --features c-api --lib
}

check() {
	cargo test --frozen
}

package() {
	install -vDm755 -t "$pkgdir/usr/lib" target/release/libtlottie.so
	install -vDm644 -t "$pkgdir/usr/include" include/tlottie.h
}

dev() {
	pkgdesc="headers file for $pkgname"
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
}

sha512sums="
101116a4739bd4526985ff844ee159236b0d93d3abfa54ee75ac70477bbeefa111ad152cef51fbf3fb57d41ac4602cb61a5ac0277810040fe8a59286acf163f9  tlottie-1.0.6.tar.gz
"
