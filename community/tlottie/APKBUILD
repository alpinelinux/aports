# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=tlottie
pkgver=0.1.0_git20260911
pkgrel=0
_commit=31f1b542f88e7b4be9a01e749920d857535fc715
pkgdesc="rust library for drawing lottie animations"
url="https://github.com/dkaraush/tlottie"
arch="all"
license="MIT"
options="!check !strip" # one test fail
makedepends="cargo cargo-auditable"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/dkaraush/tlottie/archive/$_commit.tar.gz"
builddir="$srcdir/"$pkgname-$_commit

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release --features c-api --lib
}

check() {
	cargo test --frozen
}

package() {
	install -vDm755 -t "$pkgdir/usr/lib" target/release/libtlottie.so
	install -vDm644 -t "$pkgdir/usr/include" include/tlottie.h
}

dev() {
	pkgdesc="headers file for $pkgname"
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
}

sha512sums="
b1563398ab776b625e2567040fd1a66b7ce3c7b56223b1c7a9d236e0933970a8a6daed014185e2606bd4ade10b28510dd9b54a1d8db7af73159b0c390fe6ca87  tlottie-0.1.0_git20260911.tar.gz
"
