# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: DWwanghao <wanghao03@loongson.cn>
maintainer="DWwanghao <wanghao03@loongson.cn>"
pkgname=arif
pkgver=0.3.0
pkgrel=1
pkgdesc="Tab completion-based Readline input framework"
url="https://www.nongnu.org/arif/"
arch="all"
license="GPL-3.0-or-later"
depends_dev="
	librime-dev
	readline-dev
	"
makedepends="
	$depends_dev
	autoconf
	automake
	slibtool
	"
checkdepends="dejagnu"
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/cismonx/arif/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare

	slibtoolize -cf
	aclocal --force -I m4
	autoconf -f
	autoheader -f
	automake -acf
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-arify \
		--enable-arif-readline \
		--enable-arif-rime \
		--enable-rlexec
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

dev() {
	default_dev

	# preload library for /usr/bin/arify
	mv -v "$subpkgdir"/usr/lib/libarify.so usr/lib/
}

sha512sums="
281c2121f90712ca69a69baca77e6c2e26aa3204653e3e8773300fc426805091552a3bbfc481aaa3ead700f146da8689754933c00b1dff0141f1ed892ac19a2c  arif-0.3.0-1.tar.gz
"
