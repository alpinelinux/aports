# Maintainer: Danila Vershinin <ciapnz@gmail.com>
pkgname=gixy
_pyname=gixy_ng
pkgver=0.2.52
pkgrel=0
pkgdesc="NGINX configuration static analyzer focused on security"
url="https://gixy.getpagespeed.com/"
arch="noarch"
license="MPL-2.0"
depends="python3 py3-ngxparse py3-jinja2 py3-configargparse"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-installer"
source="$_pyname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/g/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m installer -d "$PWD"/.testenv .dist/*.whl
	local _py_ver=$(python3 -c 'import sys;print(f"{sys.version_info.major}.{sys.version_info.minor}")')
	PYTHONPATH="$PWD/.testenv/usr/lib/python$_py_ver/site-packages" \
		"$PWD"/.testenv/usr/bin/gixy --version
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
5e087a978e3975b85dc014deadd78c2693b1d206988e0a2fe668df1e8591866f5645b868df865517e4d6d6084aea64a48344135456ecd8ba321e9a8bc78ff8b4  gixy_ng-0.2.52.tar.gz
"
