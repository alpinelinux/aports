#!/bin/sh

ver_new="$1"
ver_old="$2"

if [ "$(apk version -t "$ver_old" "5.0.0-r0")" = "<" ]; then
	cat <<-EOF
	*
	* WARNING: bluez-alsa version 5.0.0 carries some
	*  important changes including incompatible renames:
	*  bluealsad (from bluealsa), bluealsactl (from bluealsa-cli)
	*  and org.bluealsa.conf (from bluealsa.conf). More info at:
	*  https://github.com/arkq/bluez-alsa/blob/v5.0.0/NEWS.md
	*
	EOF
fi

exit 0
