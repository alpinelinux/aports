# Contributor: Thomas Böhler <witcher@wiredspace.de>
# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=meli
pkgver=0.9.0
pkgrel=0
pkgdesc="terminal e-mail client"
arch="all"
url="https://meli-email.org/"
license="GPL-3.0-or-later"
makedepends="cargo
	cargo-auditable
	capnproto-dev
	clang-dev
	curl-dev
	nettle-dev
	openssl-dev
	zlib-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://git.meli-email.org/meli/meli/archive/v$pkgver.tar.gz
	0002-allow-tests-without-cli-docs-feature.patch
	nix-s390x.patch
	"
builddir="$srcdir/$pkgname"
options="net" # cargo fetch

_features=sqlite3,notmuch,smtp,http,gpgme,sequoia,jmap

export OPENSSL_NO_VENDOR=1

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen \
		--no-default-features --features "$_features"

	for shellcomp in bash fish zsh; do
		./target/release/"$pkgname" completions \
			"$shellcomp" > "$pkgname"."$shellcomp"
	done
}

check() {
	cargo test --frozen \
		--no-default-features --features "$_features"
}

package() {
	install -Dm0755 -t "$pkgdir"/usr/bin/ target/release/"$pkgname"

	install -Dm0644 -t "$pkgdir"/usr/share/man/man1/ meli/docs/*.1
	install -Dm0644 -t "$pkgdir"/usr/share/man/man5/ meli/docs/*.5
	install -Dm0644 -t "$pkgdir"/usr/share/man/man7/ meli/docs/*.7
	install -Dm0644 -t "$pkgdir"/usr/share/doc/"$pkgname"/ \
		meli/docs/external-tools.md \
		meli/docs/samples/sample-config.toml
	install -Dm0644 -t "$pkgdir"/usr/share/doc/"$pkgname"/themes/ \
		meli/docs/samples/themes/*

	install -Dm0644 "$pkgname".bash "$pkgdir"/usr/share/bash-completion/completions/"$pkgname"
	install -Dm0644 "$pkgname".fish "$pkgdir"/usr/share/fish/vendor_completions.d/"$pkgname".fish
	install -Dm0644 "$pkgname".zsh "$pkgdir"/usr/share/zsh/site-functions/_"$pkgname"
}

