From: Aelin <aelin@postmarketos.org>
Date: Thu, 10 Sep 2026 21:47:47 +0200
Subject: [PATCH] Don't build libselinux for python wrapper

---
 src/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Makefile b/src/Makefile
index 2163926a..88feb1ab 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -150,7 +150,7 @@ ifneq ($(DISABLE_SHARED),y)
 all: $(LIBSO)
 endif
 
-pywrap: all selinuxswig_python_exception.i
+pywrap: selinuxswig_python_exception.i
 	CFLAGS="$(CPPFLAGS) $(CFLAGS) $(SWIG_CFLAGS)" $(PYTHON) -m build --no-isolation --wheel .
 
 rubywrap: all $(SWIGRUBYSO)
