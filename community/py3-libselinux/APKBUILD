maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=py3-libselinux
pkgver=3.11
pkgrel=2
pkgdesc="SELinux library and simple utilities (python library)"
url="https://github.com/SELinuxProject/selinux/wiki"
arch="all"
license="Public-Domain"
makedepends="
	coreutils
	libselinux-dev
	linux-headers
	py3-build
	py3-pip
	py3-setuptools
	python3-dev
	swig
	"
source="https://github.com/SELinuxProject/selinux/releases/download/$pkgver/libselinux-$pkgver.tar.gz
	0001-Don-t-build-libselinux-for-python-wrapper.patch
	swig.patch
	"
builddir="$srcdir/libselinux-$pkgver"

build() {
	make SHLIBDIR="/usr/lib" FTS_LDLIBS="-lfts" pywrap
}

package() {
	make SHLIBDIR="/usr/lib" DESTDIR="$pkgdir" install-pywrap
}

