# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=libgedit-gtksourceview
pkgver=299.8.0
pkgrel=0
pkgdesc="Gedit Technology — source code editing widget"
url="https://gitlab.gnome.org/World/gedit/libgedit-gtksourceview"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	docbook-xsl-nons
	gobject-introspection-dev
	gtk-doc
	gtk+3.0-dev
	libgedit-amtk-dev
	libgedit-gfls-dev
	meson
	"
checkdepends="xvfb-run"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang"
source="https://gitlab.gnome.org/World/gedit/libgedit-gtksourceview/-/archive/$pkgver/libgedit-gtksourceview-$pkgver.tar.gz"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgobject_introspection=true \
		-Dgtk_doc=true \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test -v -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
af76a9ab9e352d3dd056fc470cb4063d33ac98a37075a4d9d785188d361f29929cb577b839ac2a281d2e64d36f6ee30a3fc295ccbfc1f880b9157b04fa010d8c  libgedit-gtksourceview-299.8.0.tar.gz
"
