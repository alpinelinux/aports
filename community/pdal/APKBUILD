maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=pdal
pkgver=2.10.2
pkgrel=0
pkgdesc="PDAL is a C++ BSD library for translating and manipulating point cloud data."
url="https://pdal.io/"
arch="all"
license="BSD-2-Clause"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
	apache-arrow-dev
	cmake
	cpd-dev
	curl-dev
	eigen-dev
	fgt-dev
	gdal-dev
	hdf5-dev
	libgeotiff-dev
	libpq-dev
	libxml2-dev
	linux-headers
	openscenegraph-dev
	openssl-dev>3
	proj-dev
	py3-numpy-dev
	python3-dev
	samurai
	sqlite-dev
	xerces-c-dev
	zstd-dev
	"
checkdepends="gdal-tools gdal-driver-png gdal-driver-jpeg gtest"
subpackages="
	$pkgname-dev
	libpdal-plugins
	"
source="https://github.com/PDAL/PDAL/releases/download/$pkgver/PDAL-$pkgver-src.tar.bz2
	10-zstd.patch
	0001-filters-fix-UB-in-DimRange-sort-comparator.patch
	0002-arrow-auto-detect-primary-geometry-column-for-GeoParquet-files.patch
	0003-arrow-Require-libarrow-21.0.patch
	"
builddir="$srcdir/PDAL-$pkgver-src"

case "$CARCH" in
	s390x)
		# 85% tests passed, 22 tests failed out of 142
		options="!check"
		;;
esac
# Optional dependency tiledb-dev is not available on s390x and 32-bit platforms
_with_tiledb="OFF"
case "$CARCH" in
armhf|armv7|x86|s390x) ;;
*)
	makedepends="$makedepends tiledb-dev"
	_with_tiledb="ON"
	;;
esac

build() {
	CFLAGS="$CFLAGS -O2" \
	CXXFLAGS="$CXXFLAGS -O2" \
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=None \
		-DBUILD_PLUGIN_ARROW=ON \
		-DBUILD_PLUGIN_CPD=ON \
		-DBUILD_PLUGIN_E57=ON \
		-DBUILD_PLUGIN_FBX=ON \
		-DBUILD_PLUGIN_HDF=ON \
		-DBUILD_PLUGIN_ICEBRIDGE=ON \
		-DBUILD_PLUGIN_MBIO=ON \
		-DBUILD_PLUGIN_NITF=OFF \
		-DBUILD_PLUGIN_OPENSCENEGRAPH=ON \
		-DBUILD_PLUGIN_PGPOINTCLOUD=ON \
		-DBUILD_PLUGIN_RDBLIB=OFF \
		-DBUILD_PLUGIN_RIVLIB=OFF \
		-DBUILD_PLUGIN_TEASER=OFF \
		-DBUILD_PLUGIN_TILEDB=$_with_tiledb \ \
		-DBUILD_PLUGIN_TRAJECTORY=OFF \
		-DBUILD_PGPOINTCLOUD_TESTS=OFF \
		-DWITH_ZSTD=ON \
		-DWITH_TESTS="$(want_check && echo ON || echo OFF)"
	cmake --build build
}

check() {
	# skipped tests are failing
	# ref: https://github.com/PDAL/PDAL/issues/4983
	local skipped_tests="pdal_("
	local tests="
		filters_assign
		filters_overlay
		info
		io_arrow_reader
		io_bpf_base
		io_bpf_zlib
		io_las_writer
		io_spz_writer
		io_tiledb_bit_fields
		io_tiledb_time_reader
		io_tiledb_time_writer
		merge
		"
	case "$CARCH" in
		x86_64) tests="$tests
			io_tiledb_bit_fields
			io_las_writer
			io_pcd_reader
			" ;;
		arm*) tests="$tests
			file_utils
			" ;;
		ppc64le) tests="$tests
			io_arrow_reader
			io_tiledb_reader
			" ;;
		x86) tests="$tests
			io_arrow_reader
			file_utils
			io_pcd_reader
			filters_overlay
			" ;;
	esac

	for test in $tests; do
		skipped_tests="$skipped_tests|$test"
	done
	skipped_tests="$skipped_tests)_test|random_test"
	msg "$skipped_tests"
	ctest --test-dir build -E "$skipped_tests"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	cd $pkgdir/usr/lib
	rm libpdalcpp.so
	ln -s libpdalcpp.so.?? libpdalcpp.so
}

plugins() {
	amove usr/lib/libpdal_plugin_*.so.*
}

