From 73940ce08b952a83161a71d2ee8ace0c0458eccc Mon Sep 17 00:00:00 2001
From: Martin Dobias <wonder.sk@gmail.com>
Date: Thu, 6 Aug 2026 17:05:31 +0200
Subject: [PATCH] readers.arrow: auto-detect primary geometry column from
 GeoParquet files (#5096)

---
 plugins/arrow/io/ArrowReader.cpp           |   5 ++++-
 plugins/arrow/test/ArrowReaderTest.cpp     |   7 +++++++
 test/data/arrow/1.2-with-color_wkb.parquet | Bin 0 -> 51695 bytes
 3 files changed, 11 insertions(+), 1 deletion(-)
 create mode 100644 test/data/arrow/1.2-with-color_wkb.parquet

diff --git a/plugins/arrow/io/ArrowReader.cpp b/plugins/arrow/io/ArrowReader.cpp
index 3ae6a68728..b82be73a8d 100644
--- a/plugins/arrow/io/ArrowReader.cpp
+++ b/plugins/arrow/io/ArrowReader.cpp
@@ -88,7 +88,8 @@ ArrowReader::ArrowReader()
 void ArrowReader::addArgs(ProgramArgs& args)
 {
     args.add("metadata", "", m_readMetadata, false);
-    args.add("geoarrow_dimension_name", "", m_geoArrowDimName, "xyz");
+    args.add("geoarrow_dimension_name", "Name of the packed XYZ struct dimension for "
+        "GeoArrow (Feather) input.", m_geoArrowDimName, "xyz");
     args.add("format", "", m_formatTypeString, "");
 }
 
@@ -192,6 +193,8 @@ void ArrowReader::loadParquetGeoMetadata(const std::shared_ptr<const arrow::KeyV
 
             log()->get(LogLevel::Info) << "primary column is " << primary_column << std::endl;
 
+            m_geoArrowDimName = primary_column;
+
             if (!column.contains("crs"))
             {
                 log()->get(LogLevel::Warning) << "no 'crs' key available to fetch spatial reference information, setting to 4326" << std::endl;
diff --git a/plugins/arrow/test/ArrowReaderTest.cpp b/plugins/arrow/test/ArrowReaderTest.cpp
index 3327db6983..60238e92af 100644
--- a/plugins/arrow/test/ArrowReaderTest.cpp
+++ b/plugins/arrow/test/ArrowReaderTest.cpp
@@ -121,6 +121,13 @@ TEST(ArrowParquetReaderTest, ReadingPoints_RowGroups)
                              Support::datapath("las/1.2-with-color.las"));
 }
 
+TEST(ArrowParquetReaderTest, ReadingPoints_GeoParquetPrimaryColumn)
+{
+    // input file that only has a 'wkb' geometry column (no 'xyz' struct)
+    compareArrowLasStreaming(Support::datapath("arrow/1.2-with-color_wkb.parquet"),
+                             Support::datapath("las/1.2-with-color.las"));
+}
+
 TEST(ArrowFeatherReaderTest, ReadingPoints)
 {
     compareArrowLasStreaming(Support::datapath("arrow/1.2-with-color.feather"),

