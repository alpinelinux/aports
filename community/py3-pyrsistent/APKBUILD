# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer: Wen Heping <wenhepingalpine@sohu.com>
pkgname=py3-pyrsistent
pkgver=0.21.0
pkgrel=0
pkgdesc="Persistent/Functional/Immutable data structures"
url="https://github.com/tobgu/pyrsistent"
arch="all"
license="MIT"
depends="python3"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-hypothesis py3-pytest py3-pytest-runner py3-typing-extensions"
subpackages="$pkgname-pyc"
source="pyrsistent-$pkgver.tar.gz::https://github.com/tobgu/pyrsistent/archive/v$pkgver.tar.gz"
builddir="$srcdir/pyrsistent-$pkgver"
provides="py-pyrsistent=$pkgver-r$pkgrel"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
441e3980f730c60c54aeea076ac8d6c7f85e27f3bb7778c68aa8d066418f827b69dff42ca7a7c85687743ea6df89905c829945907fbc973f457d8755aa5300e1  pyrsistent-0.21.0.tar.gz
"
