# Contributor: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Bart Ribbers <bribbers@disroot.org>
pkgname=py3-threadpoolctl
pkgver=3.8.0
pkgrel=0
pkgdesc="Python helpers to limit the number of threads used in native libraries"
url="https://github.com/joblib/threadpoolctl"
arch="noarch"
license="BSD-3-Clause"
depends="python3"
makedepends="py3-flit-core py3-gpep517"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://github.com/joblib/threadpoolctl/archive/$pkgver/threadpoolctl-$pkgver.tar.gz
	increase-test-timeout.patch
	"
builddir="$srcdir/threadpoolctl-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# test_register_after_libraries_were_listed requires glibc
	pytest -k "not test_register_after_libraries_were_listed"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/threadpoolctl*.whl
}

sha512sums="
