maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=picard
pkgver=3.0.4
pkgrel=0
# armhf blocked by qt6-qtdeclarative -> py3-qt6
arch="all !armhf"
url="https://picard.musicbrainz.org/"
pkgdesc="Official MusicBrainz tagger"
license="GPL-2.0-or-later"
depends="
	chromaprint
	py3-dateutil
	py3-fasteners
	py3-mutagen
	py3-qt6
	py3-yaml
	qt6-qtimageformats
	"
makedepends="
	gettext
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-pytest"
subpackages="
	$pkgname-lang
	$pkgname-pyc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/metabrainz/picard/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/picard-release-$pkgver"
langdir="usr/lib/python*/site-packages/picard/locale"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
da104483664755b8cf9ff656029f363a368f3728f47eb2e0a063bad75046d69f65d80e88c387bc22b53bb429a55049b36aedd99a4b5bd8348a1a875c83ff69fa  picard-3.0.4.tar.gz
"
