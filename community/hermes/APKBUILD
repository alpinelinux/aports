# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=hermes
pkgver=1.9
pkgrel=11
pkgdesc="Hermes is an anti-spam transparent SMTP proxy"
url="https://github.com/jjguti/hermes"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	automake
	doxygen
	gettext-dev
	libspf2-dev
	openssl-dev>3
	perl
	sqlite-dev
	"
subpackages="$pkgname-doc"
options="!check" # No tests
source="$pkgname-$pkgver-1.tar.gz::https://github.com/jjguti/hermes/archive/refs/tags/hermes-$pkgver.tar.gz
	Utils.cpp.patch
	openssl-1.1.patch
	fix-string-declares-ppc64le.patch
	"
builddir="$srcdir/hermes-hermes-$pkgver"

# secfixes:
#   0:
#     - CVE-2020-1914
#     - CVE-2020-1915

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--enable-spf \
		--enable-openssl
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

