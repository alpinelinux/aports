From 4bd9f6901f7db78d4b16aa038f84215f2afc42ac Mon Sep 17 00:00:00 2001
From: Achill Gilgenast <achill@achill.org>
Date: Mon, 9 Nov 2026 20:43:41 +0100
Subject: [PATCH] build: Disable bluetooth panel on s390x

It's not built in g-c-c (lol bluetooth on a mainframe) so let's also not
include it here.

Signed-off-by: Achill Gilgenast <achill@achill.org>
---
 meson.build        | 2 ++
 src/meson.build    | 4 +++-
 src/ms-cc-panels.c | 4 ++++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index c56054b8..11159371 100644
--- a/meson.build
+++ b/meson.build
@@ -190,6 +190,8 @@ config_h.set_quoted(
   datadir / 'phosh-osk-stevia' / 'completers',
 )
 config_h.set('MOBILE_SETTINGS_HAVE_GCC_PANELS', get_option('gcc-panels'))
+gcc_bluetooth_panel = get_option('gcc-panels') and not host_machine.cpu().contains('s390')
+config_h.set('MOBILE_SETTINGS_HAVE_GCC_BLUETOOTH_PANEL', gcc_bluetooth_panel)
 config_h.set('_PMS_EXTERN', '__attribute__((visibility("default"))) extern')
 
 configure_file(output: 'mobile-settings-config.h', configuration: config_h)
diff --git a/src/meson.build b/src/meson.build
index 085a0b97..4576a160 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -190,11 +190,13 @@ if get_option('gcc-panels')
 
   # …other panels have only libs
   cc_panels = [
-    gcc.get_variable('bluetooth_panel_lib'),
     gcc.get_variable('sound_panel_lib'),
     gcc.get_variable('online_accounts_panel_lib'),
     gcc.get_variable('wwan_panel_lib'),
   ]
+  if gcc_bluetooth_panel
+    cc_panels += gcc.get_variable('bluetooth_panel_lib')
+  endif
 
 else
   gcc_panel_generated_sources = []
diff --git a/src/ms-cc-panels.c b/src/ms-cc-panels.c
index 2df15a42..d11a89c5 100644
--- a/src/ms-cc-panels.c
+++ b/src/ms-cc-panels.c
@@ -63,7 +63,9 @@ void         cc_object_storage_add_object (const char *key, gpointer object);
 
 /* See CcPanelLoader */
 
+#ifdef MOBILE_SETTINGS_HAVE_GCC_BLUETOOTH_PANEL
 extern GType cc_bluetooth_panel_get_type (void);
+#endif
 extern GType cc_network_panel_get_type (void);
 extern GType cc_online_accounts_panel_get_type (void);
 extern GType cc_sound_panel_get_type (void);
@@ -77,11 +79,13 @@ void         cc_wifi_panel_static_init_func (void);
  * to different object initialization order */
 
 static const MsCcPanelData panel_data[] = {
+#ifdef MOBILE_SETTINGS_HAVE_GCC_BLUETOOTH_PANEL
   {
     "bluetooth",
     cc_bluetooth_panel_get_type,
     NULL,
   },
+#endif
   {
     "sound",
     cc_sound_panel_get_type,
-- 
