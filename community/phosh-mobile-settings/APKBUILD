# Contributor: Newbyte <newbie13xd@gmail.com>
maintainer="team/phosh <newbie13xd@gmail.com>"
pkgname=phosh-mobile-settings
pkgver=0.58.0
pkgrel=1
_gccver=50.4
pkgdesc="Settings app for mobile specific things"
url="https://gitlab.gnome.org/World/Phosh/phosh-mobile-settings"
# riscv64: stevia
arch="all !armhf !riscv64"
license="GPL-3.0-or-later"
depends="
	phoc-schemas
	phosh-schemas
	stevia-schemas
	"
_gccdeps="
	blueprint-compiler
	colord-dev
	colord-gtk-dev
	gcr4-dev
	gnome-bluetooth-dev
	gnome-online-accounts-dev
	gnome-settings-daemon-dev
	krb5-dev
	libgtop-dev
	libnma-dev
	libpwquality-dev
	libsecret-dev
	py3-polib
	samba-dev
	tecla-dev
	udisks2-dev
	"
makedepends="
	$_gccdeps
	accountsservice-dev
	cellbroadcastd-dev
	desktop-file-utils
	feedbackd-dev
	glib-dev
	gmobile-dev
	gnome-desktop-dev
	gsound-dev
	gtk4.0-dev
	json-glib-dev
	libadwaita-dev
	libportal-dev
	lm-sensors-dev
	meson
	networkmanager-dev
	phosh-dev
	pulseaudio-dev
	yaml-dev
	"
checkdepends="xvfb-run gsettings-desktop-schemas phosh"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-lang
	$pkgname-libs
	"
source="https://sources.phosh.mobi/releases/phosh-mobile-settings/phosh-mobile-settings-${pkgver/_/.}.tar.xz
	https://download.gnome.org/sources/gnome-control-center/${_gccver%%.*}/gnome-control-center-$_gccver.tar.xz
	libpms-dep-enum-sources.patch
	s390x.patch
	"
builddir="$srcdir/$pkgname-${pkgver/_/.}"

prepare() {
	default_prepare
	mv "$srcdir"/gnome-control-center-$_gccver subprojects/g-c-c

	for i in subprojects/packagefiles/g-c-c/*.patch; do
		patch -p1 -d subprojects/g-c-c < "$i"
	done
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dtweaks-data-dir=/usr/share/postmarketos-tweaks \
		-Dpolkit-group=wheel \
		-Dgcc-panels=true \
		-Dgcc-po=true \
		. output
	meson compile -C output
}

check() {
	xvfb-run meson test --print-errorlogs --suite unit -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild --skip-subprojects -C output
}

