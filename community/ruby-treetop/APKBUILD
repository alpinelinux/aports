# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-treetop
_gemname=treetop
pkgver=1.6.18
pkgrel=0
# Upstream does not tag releases after 1.6.14.
_commit=367d37e0d0b4b7a9a6ad14c54758745ced1b28ad
pkgdesc="A Parsing Expression Grammar (PEG) Parser generator DSL for Ruby"
url="https://github.com/cjheath/treetop"
arch="noarch"
license="MIT"
depends="
	ruby
	ruby-polyglot
	"
checkdepends="
	ruby-benchmark
	ruby-logger
	ruby-rr
	ruby-rspec
	"
source="https://github.com/cjheath/treetop/archive/$_commit/ruby-treetop-$_commit.tar.gz
	gemspec.patch
	"
builddir="$srcdir/$_gemname-$_commit"

build() {
	gem build $_gemname.gemspec
}

check() {
	rspec .
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r cache build_info doc extensions
	rmdir plugins || true
}

