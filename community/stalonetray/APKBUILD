# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=stalonetray
pkgver=1.5.0
pkgrel=0
pkgdesc="Stalonetray is a stand-alone freedesktop.org and KDE system tray"
url="https://github.com/d3adb5/stalonetray"
arch="all"
license="GPL-2.0-only"
makedepends="
	docbook-xsl
	libx11-dev
	libxinerama-dev
	libxpm-dev
	libxrandr-dev
	libxslt
	meson
	"
checkdepends="cmocka-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/d3adb5/stalonetray/archive/refs/tags/$pkgver.tar.gz"

build() {
	abuild-meson \
		-Dnative_kde=enabled \
		-Dxpm=enabled \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
6781fbb36959609d444dbe890b7116afa4c77e7c60709ff9110f8a7c6352bc6021f82cbe9ce595e556846edbf99a7b5f9edfb2962480ed3feedb678afd67b5b5  stalonetray-1.5.0.tar.gz
"
