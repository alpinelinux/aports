maintainer="John Vogel <jvogel@stygian.me>"
pkgname=dvisvgm
pkgver=3.6.1
pkgrel=0
pkgdesc="A fast DVI, EPS, and PDF to SVG converter"
url="https://github.com/mgieseki/dvisvgm"
# s390x: limited by texlive
arch="all !s390x"
license="GPL-3.0-or-later"
makedepends="
	brotli-dev
	freetype-dev
	ghostscript-dev
	potrace-dev
	python3
	texlive-dev
	woff2-dev
	xxhash-dev
	zlib-dev
	"
subpackages="$pkgname-doc"
source="https://github.com/mgieseki/dvisvgm/releases/download/$pkgver/dvisvgm-$pkgver.tar.gz"

build() {
	./configure --prefix=/usr
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

