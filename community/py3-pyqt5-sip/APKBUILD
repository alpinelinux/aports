maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-pyqt5-sip
pkgver=12.19.0
pkgrel=0
pkgdesc="The sip module support for PyQt5"
url="https://riverbankcomputing.com/software/sip"
arch="all"
license="custom:sip"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
source="https://pypi.python.org/packages/source/p/pyqt5-sip/pyqt5_sip-$pkgver.tar.gz"
options="!check" # No tests
builddir="$srcdir/pyqt5_sip-$pkgver"

build() {
	export CFLAGS="$CFLAGS -O2 -flto=auto"
	export CXXFLAGS="$CXXFLAGS -O2 -flto=auto"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
5fd96015102e3dce569371eb62a1fc689d325fca149a3173016e8dd3590cbd3b389e074b1472e5d7bbd9503032c7ae186bfd22d0c6df9eca1febc1dca4daccf3  pyqt5_sip-12.19.0.tar.gz
"
