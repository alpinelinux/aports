maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-pyqt5-sip
pkgver=12.20.1
pkgrel=0
pkgdesc="The sip module support for PyQt5"
url="https://riverbankcomputing.com/software/sip"
arch="all"
license="custom:sip"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
source="https://pypi.python.org/packages/source/p/pyqt5-sip/pyqt5_sip-$pkgver.tar.gz"
options="!check" # No tests
builddir="$srcdir/pyqt5_sip-$pkgver"

build() {
	export CFLAGS="$CFLAGS -O2 -flto=auto"
	export CXXFLAGS="$CXXFLAGS -O2 -flto=auto"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
68986d54b301725a9b9e539204e02130a635a82c93bc5d09ed64e4438d114dc6ae68899355ada47cb1940a866881ac371ba5d56564a0d2a45d26bda86634cf29  pyqt5_sip-12.20.1.tar.gz
"
