Patch-Source: https://github.com/curl/trurl/pull/441
Backported for 0.16.1.
---
From 3156745120f3be1286bb3f3c1543230dcd0f7553 Mon Sep 17 00:00:00 2001
From: Carlos Henrique Lima Melara <charlesmelara@riseup.net>
Date: Fri, 1 May 2026 18:19:06 -0300
Subject: [PATCH] tests: mark some additional tests uppercase-hex sensitive

Since 8.20.0, three more tests started to fail because of the case used
to represent hex digits.

Fixes: #440
---
 tests.json | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/tests.json b/tests.json
index 891271c..f46ba2a 100644
--- a/tests.json
+++ b/tests.json
@@ -473,6 +473,9 @@
                 "https://example.com/#%2e%61%13%Fa"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "https://example.com/#.a%13%fa\n",
             "stderr": "",
@@ -749,6 +752,9 @@
                 "query=user=me"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "https://curl.se/hello?user%3dme\n",
             "stderr": "",
@@ -2132,6 +2138,9 @@
                 "query:=a&b&a%26b"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "http://localhost/ABC%5c%5c?a&b&a%26b\n",
             "returncode": 0,
@@ -2811,6 +2820,9 @@
                 "https://example.com/one/t%61o/%2F%42/"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "https://example.com/one/tao/%2fB/\n",
             "stderr": "",
@@ -2826,7 +2838,7 @@
             ]
         },
         "expected": {
-            "stdout": "https://example.com/one/tao/%2fB/%2561\n",
+            "stdout": "https://example.com/one/tao/%2FB/%2561\n",
             "stderr": "",
             "returncode": 0
         }
@@ -2991,6 +3003,9 @@
                 "http://example.com/?a=%5D"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "http://example.com/?a=%5d\n",
             "stderr": "",
@@ -3003,6 +3018,9 @@
                 "http://example.com/?a=%5D&b=%5D"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "http://example.com/?a=%5d&b=%5d\n",
             "stderr": "",
@@ -3015,6 +3033,9 @@
                 "sftp://us%65r:pwd;giraffe@odd"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "sftp://user:pwd%3bgiraffe@odd/\n",
             "stderr": "",
@@ -3041,6 +3062,9 @@
                 "[password]"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "pwd;giraffe\n",
             "stderr": "",
@@ -3055,6 +3079,9 @@
                 "[:password]"
             ]
         },
+        "excludes": [
+          "uppercase-hex"
+        ],
         "expected": {
             "stdout": "pwd%3bgiraffe\n",
             "stderr": "",
-- 
2.56.0

