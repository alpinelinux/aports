pkgname=dunst
pkgver=1.13.2
pkgrel=0
pkgdesc="Customizable and lightweight notification-daemon"
url="https://dunst-project.org/"
license="BSD-3-Clause"
arch="all"
depends="dunstify"
makedepends="libxscrnsaver-dev libxinerama-dev libxrandr-dev
	libnotify-dev dbus-dev wayland-dev perl pango-dev wayland-protocols"
checkdepends="dbus librsvg bash ttf-dejavu"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	$pkgname-openrc
	$pkgname-systemd
	dunstify
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/dunst-project/dunst/archive/v$pkgver.tar.gz
	dunst.initd
	"

build() {
	make SYSTEMD=1 all dunstify
}

check() {
	make test
}

package() {
	make DESTDIR="$pkgdir" SYSCONFDIR=/etc PREFIX=/usr SYSTEMD=1 install
	install -Dm755 "$srcdir"/dunst.initd "$pkgdir"/etc/user/init.d/dunst
}

dunstify() {
	pkgdesc="notify-send compatible command with additional features"
	amove usr/bin/dunstify
}

sha512sums="
