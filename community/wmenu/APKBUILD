# Contributor: Dmitry Zakharchenko <dmitz@disroot.org>
# Maintainer: qaqland <qaq@qaq.land>
pkgname=wmenu
pkgver=0.2.0
pkgrel=0
pkgdesc="Efficient dynamic menu for Wayland"
url="https://codeberg.org/adnano/wmenu"
arch="all"
license="MIT"
makedepends="meson
	libxkbcommon-dev
	pango-dev
	scdoc
	wayland-dev
	wayland-protocols
	"
options="!check" # no test suite
subpackages="$pkgname-doc"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/adnano/wmenu/archive/$pkgver.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
f3b2314c0cad03b6aeaa21c0aeb4f7444e9ee812f8784aa9b6773649ec0a84488761a32f4f606cd7966295223164c37dceaa5416b5d87bd1c441b3b4f8bce2db  wmenu-0.2.0-1.tar.gz
"
