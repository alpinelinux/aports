maintainer="John Vogel <jvogel@stygian.me>"
pkgname=tcpreplay
pkgver=4.6.2
pkgrel=0
pkgdesc="Replay captured network traffic"
url="https://tcpreplay.appneta.com/"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	autoconf
	automake
	libdnet-dev
	libpcap-dev
	libtool
	linux-headers
	tcpdump
	"
subpackages="$pkgname-doc"
source="https://downloads.sourceforge.net/tcpreplay/tcpreplay-$pkgver.tar.gz
	remove-tx_ring-checks.patch
	"

case "$CARCH" in
arm*)
	options="$options !check" # bus error
	;;
esac

# secfixes:
#   4.6.1-r0:
#     - GHSA-p3f2-88rg-9mch
#     - GHSA-pmmx-m8p5-969j
#     - GHSA-4hqm-8v2c-9pwj
#   4.4.1-r0:
#     - CVE-2021-45386
#     - CVE-2021-45387
#   4.3.2-r0:
#     - CVE-2019-8381
#     - CVE-2019-8376
#     - CVE-2019-8377
#   4.3.4-r0:
#     - CVE-2020-24265
#     - CVE-2020-24266

prepare() {
	default_prepare

	autoreconf -fvi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--enable-dynamic-link \
		--enable-local-libopts \
		--disable-libopts-install
	make
}

check() {
	make -C test tcpprep
}

package() {
	make DESTDIR="$pkgdir" install
}

