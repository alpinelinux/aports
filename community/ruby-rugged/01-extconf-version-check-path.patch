Read the libgit2 version from the system headers; the bundled libgit2 in
vendor/ is not available when building with system libraries.

--- a/ext/rugged/extconf.rb
+++ b/ext/rugged/extconf.rb
@@ -70,7 +70,7 @@
 
   major = minor = nil
 
-  File.readlines(File.join(LIBGIT2_DIR, "include", "git2", "version.h")).each do |line|
+  File.readlines(File.join("/usr", "include", "git2", "version.h")).each do |line|
     if !major && (matches = line.match(/^#define LIBGIT2_VERSION_MAJOR\s+([0-9]+)$/))
       major = matches[1]
       next
