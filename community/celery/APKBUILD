pkgname=celery
pkgver=5.7.0
pkgrel=0
pkgdesc="An asynchronous task queue/job queue based on distributed message passing"
url="http://www.celeryproject.org/"
arch="noarch"
license="Apache-2.0"
depends="
	py3-billiard
	py3-click
	py3-click-didyoumean
	py3-click-plugins
	py3-click-repl
	py3-dateutil
	py3-kombu
	py3-tzlocal
	py3-vine
	python3
	"
makedepends="python3-dev py3-setuptools py3-gpep517 py3-wheel"
checkdepends="
	pre-commit
	py3-pytest
	py3-greenlet
	py3-dnspython
	py3-mongo
	py3-pytest-celery
	py3-pytest-timeout
	py3-pytest-click
	py3-pydantic
	py3-boto3
	py3-moto
	py3-pyaml
	py3-msgpack
	py3-freezegun
"
install="$pkgname.pre-install"
source="https://files.pythonhosted.org/packages/source/c/celery/celery-$pkgver.tar.gz
	celery.confd
	celery.initd
	"
pkgusers="celery"
pkggroups="celery"
subpackages="$pkgname-openrc $pkgname-pyc"
provides="py3-celery=$pkgver-r$pkgrel"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer "$builddir"/.dist/*.whl
	# t/unit/backends/test_azureblockblob.py: requires py3-azure
	# t/unit/backends/test_gcs.py: requires py3-google-cloud-storage
	# t/unit/worker/test_worker.py::test_WorkController::test_with_file_descriptor_safety: no file descriptors available
	# t/unit/worker/test_worker.py::test_WorkController::test_with_autoscaler_file_descriptor_safety: no file descriptors available
	# t/unit/concurrency/test_prefork.py::test_AsynPool: no file descriptors available
	# t/unit/app/test_app.py::test_App::test_uses_utc_timezone: runners dont always use UTC
	case $CARCH in
		ppc64le|riscv64)
			.testenv/bin/python3 -m pytest -v \
				--ignore=t/unit/backends/test_gcs.py \
				--ignore=t/unit/backends/test_azureblockblob.py \
				--deselect t/unit/worker/test_worker.py::test_WorkController::test_with_autoscaler_file_descriptor_safety \
				--deselect t/unit/worker/test_worker.py::test_WorkController::test_with_file_descriptor_safety \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_register_with_event_loop__no_on_tick_dupes \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_schedule_writes_hub_remove_fd_only_from_writers_when_write_job_is_done \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_untrack_child_process_without_sentinel_poll \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_untrack_child_process_with_sentinel_poll \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_no_synack_discards_unaccepted_jobs \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_synack_cancels_unaccepted_jobs \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_outqueue_completes_partial_message_instead_of_recv \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_outqueue_waits_for_a_live_child_still_writing \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_outqueue_drops_fd_when_process_dies_mid_message \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_flush_outqueue_drops_fd_when_a_live_child_stalls \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_help_stuff_finish_skips_exited_processes \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_help_stuff_finish_survives_truncated_message_from_live_process \
				--deselect t/unit/app/test_app.py::test_App::test_uses_utc_timezone
			;;
		*)
			.testenv/bin/python3 -m pytest -v \
				--ignore=t/unit/backends/test_gcs.py \
				--ignore=t/unit/backends/test_azureblockblob.py \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_register_with_event_loop__no_on_tick_dupes \
				--deselect t/unit/concurrency/test_prefork.py::test_AsynPool::test_schedule_writes_hub_remove_fd_only_from_writers_when_write_job_is_done \
				--deselect t/unit/app/test_app.py::test_App::test_uses_utc_timezone
		;;
esac

}

package() {
	# install scripts
	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname

	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

