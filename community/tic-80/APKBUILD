# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=tic-80
pkgver=1.3.1
pkgrel=1
# Commit is used to insert the correct version hash during build
_commit="62c24e5c9271f1445f61120b7d204805ff9db912"
pkgdesc="Fantasy computer for making, playing and sharing tiny games"
url="https://tic80.com/"
license="MIT"
arch="all"
# Please check in upstream repo _luaver is updated before switching.
# 1.3.0: 5.3 pin https://github.com/nesbox/TIC-80/commit/f6e5bf7
_luaver=5.3
depends="jack"
makedepends="
	cmake
	curl-dev
	freeglut-dev
	giflib-dev
	glu-dev
	janet-dev
	libpng-dev
	lua$_luaver-dev
	pulseaudio-dev
	ruby-dev
	ruby-rake
	samurai
	sdl2-dev
	zlib-dev
	"
builddir="$srcdir"/TIC-80-$pkgver
options="!check" # No tests
subpackages="
	$pkgname-doc
	$pkgname-editor
	$pkgname-tools
	"
source="tic-80-$pkgver.tar.gz::https://github.com/nesbox/TIC-80/archive/v$pkgver/tic80-v$pkgver.tar.gz
	system-lua.patch
	wasm3-no-musttail-ppc64le.patch.noauto
	"

# Submodules list: https://github.com/nesbox/TIC-80/tree/v$pkgver/vendor
# jsmn: repo jsmn stable version in testing/ is old
# lpeg: repo lpeg stable version is old
# moonscript: upstream fork contains a required header file
# mruby: errors with system mruby when building api/mruby.c
# quickjs: upstream fork, system quickjs errors linking lib/tic80_libretro.so
# zip: minizip fork not directly replaceable by system zip
# s7: no gitrev in vendor/, using latest from s7 upstream
# Excluded: dlfcn (windows only), sokol (not enabled by default)
_submodules="
	argparse,https://github.com/cofyc/argparse,0d5f5d0745df14a3f373f7eed85bf524714f4524
	blip-buf,https://github.com/nesbox/blip-buf,330226d9b55ecbeea644e17b5e0f096a165ca07e
	clay,https://github.com/nicbarker/clay,e6cc36941ab2af5d81107617039d6f527a1c660b
	dirent,https://github.com/tronkko/dirent,c885633e126a3a949ec0497273ec13e2c03e862c
	jsmn,https://github.com/zserge/jsmn,25647e692c7906b96ffd2b05ca54c097948e879c
	lpeg,https://github.com/roberto-ieru/LPeg,80ec9f932aa01d445e86c699523265359055e1bd
	miniscript2,https://github.com/JoeStrout/miniscript2,05ed47bdf146ffb371a80b66c9c4e65e104d7941
	moonscript,https://github.com/nesbox/moonscript,17179283012b392bff972ad66231d73bfeec6e90
	mruby,https://github.com/mruby/mruby,7fe6f3976eca19a86fe533deb4c60b31cd80a236
	naett,https://github.com/erkkah/naett,10a9624456829e5f2b4c264e14760301125d12eb
	pforth,https://github.com/philburk/pforth,3e637b5ac6ad665f851f31e33ad4c44caf4e25ab
	pocketpy,https://github.com/blueloveTH/pocketpy,979addecf9cb180c59c16ac605ba75441ece5af6
	quickjs,https://github.com/nesbox/quickjs,eca9cd879999e3b5700faf7054e4268e10e7edcc
	s7,https://cm-gitlab.stanford.edu/bil/s7/-,9a86356dc834cd95d4d5e56a94e83491dcbc86de
	squirrel,https://github.com/albertodemichelis/squirrel,c02bf2dfd599a0b99b814d486512a3ee934667f1
	wasm3,https://github.com/wasm3/wasm3,139076a98b8321b67f850a844f558b5e91b5ac83
	wren,https://github.com/wren-lang/wren,4a18fc489f9ea3d253b20dd40f4cdad0d6bb40eb
	yuescript,https://github.com/IppClub/YueScript,aca747dffa1c185c6fc66af4834284e32225751f
	zip,https://github.com/kuba--/zip,d7df626f3aa457e01669f65e61bf8f484e352941
	"
for _mod in $_submodules; do
	_mname="${_mod/,*/}"
	_mcommit="${_mod/*,/}"
	_murl="${_mod/$_mname,/}"
	_murl="${_murl/,*/}"
	source="$source $_mname-$_mcommit.tar.gz::$_murl/archive/$_mcommit.tar.gz"
done

prepare() {
	default_prepare

	# Copy extracted submodules into the main package source
	local vendor_dir="$srcdir"/TIC-80-"$pkgver"/vendor
	local msrc= mdest=
	for mod in $_submodules; do
		msrc="$(basename "$(echo $mod | cut -d',' -f2)")"
		mdest="${mod/,*/}"
		[ "$msrc" = "-" ] && msrc=$mdest
		rm -r "${vendor_dir:?}"/$mdest
		mv "$srcdir"/$msrc-${mod/*,/} "$vendor_dir"/$mdest
	done

	# 1.3.0: wasm3 error on ppc64le, disable musttail on the arch.
	# m3_exec_defs.h:58:38: error: cannot tail-call: target is not able to
	# optimize the call into a sibling call
	patch -p1 -i "$srcdir"/wasm3-no-musttail-ppc64le.patch.noauto

	# Set version revision for executable to display the correct version
	local version_rev=${pkgver##*\.}
	sed -i "s/VERSION_REVISION 0/VERSION_REVISION $version_rev/" \
		"$builddir"/CMakeLists.txt
}

build() {
	# 1.3.0: -DBUILD_STATIC=ON is required for tool scripts, errors without
	# all languages enabled (or -DBUILD_WITH_ALL=ON) and will silently export
	# code-only carts for missing languages.
	# Set -DCMAKE_POLICY_VERSION_MINIMUM for zip
	cmake -B build-tic -G Ninja \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_PLAYER=ON \
		-DBUILD_STATIC=ON \
		-DBUILD_TOOLS=ON \
		-DBUILD_WITH_FENNEL=ON \
		-DBUILD_WITH_FORTH=ON \
		-DBUILD_WITH_JANET=ON \
		-DBUILD_WITH_JS=ON \
		-DBUILD_WITH_MINISCRIPT=ON \
		-DBUILD_WITH_MOON=ON \
		-DBUILD_WITH_PYTHON=ON \
		-DBUILD_WITH_RUBY=ON \
		-DBUILD_WITH_SCHEME=ON \
		-DBUILD_WITH_SQUIRREL=ON \
		-DBUILD_WITH_WASM=ON \
		-DBUILD_WITH_WREN=ON \
		-DBUILD_WITH_YUE=ON \
		-DPREFER_SYSTEM_LIBRARIES=ON \
		-DVERSION_HASH=${_commit:0:7}
	cmake --build build-tic
}

package() {
	depends="
		$pkgname-editor=$pkgver-r$pkgrel
		$pkgname-tools=$pkgver-r$pkgrel
		"

	DESTDIR="$pkgdir" cmake --install build-tic

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/tic-80
}

editor() {
	pkgdesc="Game editor for tic-80"

	amove usr/bin/tic80
	amove usr/share
}

tools() {
	pkgdesc="Extra tools for tic-80"

	local tools="bin2txt cart2prj player-sdl prj2cart wasmp2cart xplode"
	for tool in $tools; do
		install -Dm755 "$builddir"/build-tic/bin/$tool -t "$subpkgdir"/usr/bin
	done
}

