maintainer="Michał Polański <michal@polanski.me>"
pkgname=uvicorn
pkgver=0.54.0
pkgrel=1
pkgdesc="Lightning-fast ASGI server"
url="https://www.uvicorn.dev/"
license="BSD-3-Clause"
arch="noarch"
depends="py3-click py3-h11"
makedepends="py3-gpep517 py3-hatchling"
checkdepends="
	py3-a2wsgi
	py3-dotenv
	py3-httptools
	py3-pytest
	py3-pytest-codspeed
	py3-pytest-mock
	py3-pytest-xdist
	py3-trustme
	py3-typing-extensions
	py3-watchfiles
	py3-websockets
	py3-wsproto
	py3-yaml
	"
subpackages="$pkgname-pyc"
source="https://github.com/Kludex/uvicorn/archive/$pkgver/uvicorn-$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# Exclude integration tests requiring httpx2 which depends on uvicorn.
	.testenv/bin/python3 -m pytest -vv \
		--ignore tests/middleware/test_logging.py \
		--ignore tests/middleware/test_message_logger.py \
		--ignore tests/middleware/test_proxy_headers.py \
		--ignore tests/middleware/test_wsgi.py \
		--ignore tests/protocols/test_http2.py \
		--ignore tests/protocols/test_websocket.py \
		--ignore tests/supervisors/test_signal.py \
		--ignore tests/test_default_headers.py \
		--ignore tests/test_main.py \
		--ignore tests/test_server.py \
		--ignore tests/test_ssl.py \
		tests/
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/uvicorn-$pkgver-py3-none-any.whl
}

sha512sums="
ca56be81e6049383c685f04aae4e6c8375d9b738e1b2096dfe01d08d86312108a16bdbe6f0d40dd26b30bdcb16071eabd5851c63b009b3faba94e947d786fee9  uvicorn-0.54.0.tar.gz
"
