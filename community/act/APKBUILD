# Maintainer: Meng Zhuo <mengzhuo@iscas.ac.cn>
pkgname=act
pkgver=0.2.89
pkgrel=0
pkgdesc="Run your GitHub Actions locally"
url="https://github.com/nektos/act"
arch="all"
license="MIT"
depends="npm docker"
makedepends="go"
options="net" # go build requires
subpackages="$pkgname-doc"

source="$pkgname-$pkgver.tar.gz::https://github.com/nektos/act/archive/refs/tags/v$pkgver.tar.gz"

build() {
	go build -ldflags "-X main.version=$pkgver" -o act main.go
}

check() {
	./act --version
}

package() {
	install -Dm755 ./act -t "$pkgdir"/usr/bin/
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
17ced80b2ef3f19abb3a938a56966863b73c5ab191c8f73e5a6b863b1cffff617d11a53947eac4126f0cdc2e9100fc40ede27b05bfbc87e4098891682ac30d64  act-0.2.89.tar.gz
"
