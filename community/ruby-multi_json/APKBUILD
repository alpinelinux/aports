# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-multi_json
_gemname=${pkgname#ruby-}
pkgver=1.21.2
pkgrel=0
pkgdesc="A gem to provide easy switching between different JSON backends"
url="https://rubygems.org/gems/multi_json"
arch="noarch"
license="MIT"
depends="ruby"
source="$pkgname-$pkgver.tar.gz::https://github.com/sferik/$_gemname/archive/v$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"
options="!check" # several test dependencies are missing

prepare() {
	default_prepare

	sed -i '/spec.signing_key/d' $_gemname.gemspec
}

build() {
	gem build $_gemname.gemspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	rm -r "$gemdir"/cache \
		"$gemdir"/build_info \
		"$gemdir"/doc \
		"$gemdir"/extensions \
		"$geminstdir"/*.md
	rmdir "$gemdir"/plugins || true
}

sha512sums="
eff13d90c9e2e2a21a3d9e5431c91e35f2caaf1c45d4f9f8b8b4b572499bbfc551baaf68d2e4ea2b58c843581fb0642aa39dd8cbf4cc04ba905a578b2a0e4a8d  ruby-multi_json-1.21.2.tar.gz
"
