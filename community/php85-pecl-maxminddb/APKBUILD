# Contributor: TBK <alpine@jjtc.eu>
# Maintainer: Andy Postnikov <apostnikov@gmail.com>
pkgname=php85-pecl-maxminddb
_extname=maxminddb
pkgver=1.15.0
pkgrel=0
pkgdesc="PHP 8.5 MaxMind DB Reader extension - PECL"
url="https://pecl.php.net/package/maxminddb"
arch="all"
license="Apache-2.0"
_phpv=85
_php=php$_phpv
depends="$_php-bcmath"
makedepends="$_php-dev libmaxminddb-dev"
source="php-pecl-$_extname-$pkgver.tar.gz::https://pecl.php.net/get/$_extname-$pkgver.tgz"
builddir="$srcdir/$_extname-$pkgver/ext"

build() {
	phpize$_phpv
	./configure --prefix=/usr --with-php-config=/usr/bin/php-config$_phpv
	make
}

check() {
	make test NO_INTERACTION=1 REPORT_EXIT_STATUS=1
}

package() {
	make INSTALL_ROOT="$pkgdir" install

	local confdir="$pkgdir"/etc/$_php/conf.d
	install -d $confdir
	echo "extension=maxminddb" > $confdir/maxminddb.ini
}

sha512sums="
