# Contributor: Matthias Ahouansou <matthias@ahouansou.cz>
# Maintainer: Matthias Ahouansou <matthias@ahouansou.cz>
pkgname=cargo-deny
pkgver=0.20.2
pkgrel=0
pkgdesc="Cargo plugin for linting your dependencies"
url="https://github.com/EmbarkStudios/cargo-deny"
arch="all"
license="MIT OR Apache-2.0"
makedepends="
	cargo
	cargo-auditable
	"
checkdepends="git"
source="$pkgname-$pkgver.tar.gz::https://github.com/EmbarkStudios/cargo-deny/archive/refs/tags/$pkgver.tar.gz"
options="net !check" # tests fetch all sorts of resources

prepare() {
	default_prepare
	# remove upstream's compile flags for musl target
	rm -r .cargo/
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	# tests require access to a bunch of network resources, becoming flaky
	cargo test --frozen
}

package() {
	install -Dm 755 target/release/cargo-deny "$pkgdir"/usr/bin/cargo-deny

	for l in APACHE MIT
	do
		install -Dm 644 LICENSE-"$l" "$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE-"$l"
	done
}

sha512sums="
7744214ec3580fdf13418be2fa303baa808b5dab2960d698c93bbbc3dd5d9e5e3946a548a1f519fcbe66eb23a06b825c9df8f12055ed892dd4f7687e2ddf5101  cargo-deny-0.20.2.tar.gz
"
