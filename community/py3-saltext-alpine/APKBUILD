# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-saltext-alpine
_pkgname=saltext_alpine
pkgver=1.0.2
pkgrel=0
pkgdesc="Salt Extension that adds first class support for Alpine Linux"
url="https://github.com/salt-extensions/saltext-alpine"
arch="noarch"
license="Apache-2.0"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-pytest-instafail
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/${_pkgname//./_}-$pkgver"
options="!check" # missing pytest-salt-factories

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest tests/unit/ -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
3bf167ef76dee9d6ddbe45714ef0cbcdf51fd06f841812f1c4597653e4fdb0b669464e1131dcfd743639c302363c84fe30d6040163a058c8f268fee7ec34ddf1  saltext_alpine-1.0.2.tar.gz
"
