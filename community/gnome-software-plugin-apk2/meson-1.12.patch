Fix build with meson 1.12

meson 1.12 requires string sources passed to gnome.generate_vapi() to
exist at configure time, so the generated .gir files can no longer be
passed via full_path(). Run vapigen from a custom_target instead.

--- a/src/vapi/meson.build	2026-11-24 10:16:23.636091781 +0100
+++ b/src/vapi/meson.build	2026-11-24 10:16:23.659072403 +0100
@@ -100,14 +100,21 @@
   output: 'Gs-49.gir',
 )
 
-gnome_software_vapi = gnome.generate_vapi(
-  'gnome-software',
-  sources: gnome_software_gir_fixed.full_path(),
-  metadata_dirs: meson.current_source_dir(),
-  packages: [
-    appstream_dep.name(),
-    gtk_dep.name(),
+gnome_software_vapi = custom_target(
+  'gnome-software-vapi',
+  input: gnome_software_gir_fixed,
+  output: 'gnome-software.vapi',
+  command: [
+    find_program('vapigen'),
+    '--quiet',
+    '--library=gnome-software',
+    '--directory=@OUTDIR@',
+    '--metadatadir=@CURRENT_SOURCE_DIR@',
+    '--pkg=' + appstream_dep.name(),
+    '--pkg=' + gtk_dep.name(),
+    '@INPUT@',
   ],
+  build_by_default: true,
 )
 
 apk_gir = custom_target(
@@ -132,11 +139,18 @@
   install_dir: get_option('datadir') / 'gir-1.0',
 )
 
-apk_vapi = gnome.generate_vapi(
-  'apk-polkit-client-2',
-  sources: apk_gir.full_path(),
-  metadata_dirs: meson.current_source_dir(),
-  packages: [
-    gtk_dep.name(),
+apk_vapi = custom_target(
+  'apk-polkit-client-2-vapi',
+  input: apk_gir,
+  output: 'apk-polkit-client-2.vapi',
+  command: [
+    find_program('vapigen'),
+    '--quiet',
+    '--library=apk-polkit-client-2',
+    '--directory=@OUTDIR@',
+    '--metadatadir=@CURRENT_SOURCE_DIR@',
+    '--pkg=' + gtk_dep.name(),
+    '@INPUT@',
   ],
+  build_by_default: true,
 )
