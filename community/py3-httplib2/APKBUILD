# Contributor: Peter Bui <pnutzh4x0r@gmail.com>
# Maintainer: Fabian Affolter <fabian@affolter-engineering.ch>
pkgname=py3-httplib2
pkgver=0.32.0
pkgrel=0
pkgdesc="HTTP client library"
url="https://github.com/httplib2/httplib2"
arch="noarch"
license="MIT"
depends="
	py3-parsing
	python3
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-cryptography
	py3-pysocks
	py3-pytest
	py3-pytest-cov
	py3-pytest-forked
	py3-pytest-randomly
	py3-pytest-timeout
	py3-pytest-xdist
	"
subpackages="$pkgname-pyc"
source="httplib2-$pkgver.tar.gz::https://github.com/httplib2/httplib2/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/httplib2-$pkgver"

replaces="py-httplib2" # Backwards compatibility
provides="py-httplib2=$pkgver-r$pkgrel" # Backwards compatibility

# secfixes:
#   0.32.0-r0:
#     - CVE-2026-59939
#   0.19.0-r0:
#     - CVE-2021-21240

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
c63e4c1ed24df3bcc353a554b08298eb9d25a908d3f03caca8372169cd22ad17e731a228c2d4c1d66914bccd4713da9f0e5899df177a6ea06e287fd6b7b2f8d6  httplib2-0.32.0.tar.gz
"
