# Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=py3-psycopg2
pkgver=2.9.13
pkgrel=0
pkgdesc="PostgreSQL adapter for python"
url="http://initd.org/psycopg"
arch="all"
license="LGPL-2.0-or-later"
makedepends="
	libpq-dev
	python3-dev
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/p/psycopg2/psycopg2-$pkgver.tar.gz"
builddir="$srcdir/psycopg2-$pkgver"
options="!check" # Requires running database

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	make check
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7aebcf55161b1ad60af4b64fef64f676cdf68ee1597c8c1107350c367f1eafafe37b736716d191e3a3ba4d4ea6d436d22cb606f44655b4aebc8613d4314dbc15  psycopg2-2.9.13.tar.gz
"
