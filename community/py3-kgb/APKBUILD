# Maintainer:
pkgname=py3-kgb
pkgver=7.3
pkgrel=0
pkgdesc="Python function spy support for unit tests "
url="https://github.com/beanbaginc/kgb"
arch="noarch"
license="MIT"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://pypi.io/packages/source/k/kgb/kgb-$pkgver.tar.gz"
builddir="$srcdir/kgb-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
	rm -r "$pkgdir"/usr/lib/python3*/site-packages/kgb/tests
}

sha512sums="
1ed08fbafbf8b3880e01fbd37f12cca6d5ec4f1b1d6f429df1d1bd553683f3b294a3cf8a62df1857c5af51d6be37861893a00e6af89fe0d2af72796bb355fcc4  kgb-7.3.tar.gz
"
