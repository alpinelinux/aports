@@ -1140,39 +1140,43 @@ def test_scheduler_schedules_equality_on_change(self, monkeypatch):
             self.s.schedule, self.s.schedule
         )
 
-    def test_heap_always_return_the_first_item(self):
-        interval = 10
-
-        s1 = schedule(timedelta(seconds=interval))
