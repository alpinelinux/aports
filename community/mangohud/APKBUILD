# Maintainer: Marian Buschsieweke <marian.buschsieweke@posteo.net>
pkgname=mangohud
pkgver=0.8.4
_pkgver=$pkgver-1
pkgrel=1
pkgdesc="Vulkan and OpenGL overlay for monitoring FPS, temperatures, CPU/GPU load and more"
url="https://github.com/flightlessmango/MangoHud"
# s390x: See https://github.com/flightlessmango/MangoHud/issues/1330
arch="all !s390x"
license="MIT"
subpackages="$pkgname-doc"
makedepends="
	appstream
	dbus-dev
	glew-dev
	glfw-dev
	glslang-dev
	libx11-dev
	libxkbcommon-dev
	libxrandr-dev
	mesa-dev
	meson
	ninja
	nlohmann-json
	py3-mako
	sdl2-dev
	spdlog-dev
	vulkan-headers
	vulkan-loader-dev
	wayland-dev
	"
checkdepends="
	cmocka-dev
	"
source="
	$pkgname-$pkgver.tar.xz::https://github.com/flightlessmango/MangoHud/releases/download/v$pkgver/MangoHud-v$pkgver-Source.tar.xz
	"
builddir="$srcdir/MangoHud-v$pkgver"

prepare() {
	default_prepare

	# make sure libMangoHud_opengl.so is found. This fixes:
	# > shim: Failed to load from ${ORIGIN}/libMangoHud_opengl.so:
	# > Error loading shared library ${ORIGIN}/libMangoHud_opengl.so:
	# > No such file or directory

	# shellcheck disable=SC2016 # Intentinally treating ${ORIGIN} as literal here
	sed -i src/gl/shim.c \
		-e 's|\${ORIGIN}/libMangoHud_opengl\.so|/usr/lib/libMangoHud_opengl.so|g'
}

build() {
	abuild-meson \
		-Dappend_libdir_mangohud=false \
		-Dimgui:glfw=enabled \
		-Dimgui:opengl=enabled \
		-Dimgui:sdl2=enabled \
		-Dimgui:vulkan=enabled \
		-Dmangoapp=true \
		-Dmangohudctl=true \
		-Dtests=enabled \
		-Dwith_dbus=enabled \
		-Dwith_wayland=enabled \
		-Dwith_xnvctrl=disabled \
		-Ddynamic_string_tokens=false \
		. output
	meson compile -C output
}

check() {
	meson test -v -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
bff221b0eb994bfd89b2000872725bcbaf4defe04d214de4033e21a5f9439d73802c5095730dc060924eb4f5fdacf003a1b5262bc93172516af00c0997493178  mangohud-0.8.4.tar.xz
"
