# Maintainer:
pkgname=emacs-keymap-popup
pkgver=0.4.5
pkgrel=0
_pkgreal=${pkgname/emacs-/}
pkgdesc="Described keymaps with popup help"
url="https://git.thanosapollo.org/emacs-keymap-popup/"
arch="noarch"
license="GPL-3.0-or-later"
depends="cmd:emacs"
makedepends="emacs-nox"
options="!check" # No tests
source="$pkgname-$pkgver.tar::https://elpa.gnu.org/packages/keymap-popup-$pkgver.tar"
builddir="$srcdir/$_pkgreal-$pkgver"

build() {
	emacs -batch -q -no-site-file -L . \
		-f batch-byte-compile \
		./*.el
}

package() {
	install -Dvm644 ./*.el ./*.elc \
		-t "$pkgdir"/usr/share/emacs/site-lisp/$_pkgreal/

	cd "$pkgdir"/usr/share/emacs/site-lisp/$_pkgreal
	emacs -batch -q -no-site-file \
		-eval "(loaddefs-generate \".\" \"$_pkgreal-loaddefs.el\")"
}

sha512sums="
948432cd103d3920322a23e0081acae4ff54e8a1c72e8e41d2bcf468b90deba9726f86c9868c9917cbe17291220a97c1465cea0df9bf3e4dd22c43132250c304  emacs-keymap-popup-0.4.5.tar
"
