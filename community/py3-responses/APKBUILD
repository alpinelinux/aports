# Maintainer: Keith Maxwell <keith.maxwell@gmail.com>
pkgname=py3-responses
pkgver=0.26.3
pkgrel=0
pkgdesc="Utility library for mocking out the requests Python library"
url="https://pypi.org/project/responses/"
arch="noarch"
license="Apache-2.0"
depends="
	py3-requests
	py3-toml
	py3-urllib3
	py3-yaml
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-flake8
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-httpserver
	py3-pytest-tornasync
	py3-tomli-w
	py3-werkzeug
	"
subpackages="$pkgname-pyc"
source="https://github.com/getsentry/responses/archive/$pkgver/responses-$pkgver.tar.gz"
builddir="$srcdir/responses-$pkgver"

replaces=py-responses # Backwards compatibility
provides=py-responses=$pkgver-r$pkgrel # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
2e5c3b141e9a08bdfea115b1d6be1ea03a80802489ff86a3f87e502bd1c3aa58dbbbc6788a64f56d16e142a402678cd02305c263e616aa69e529d11970bca6f8  responses-0.26.3.tar.gz
"
