# Contributor: Frederic Laing <dev@fredfunk.tech>
# Maintainer: Frederic Laing <dev@fredfunk.tech>
pkgname=cosmic-ext-camera
pkgver=1.11.0
pkgrel=0
pkgdesc="Modern camera app for Linux desktops and phones"
url="https://github.com/cosmic-utils/cosmic-ext-camera"
# armhf, armv7, x86: 32-bit is problematic for libcosmic apps
arch="all !armhf !armv7 !x86"
license="GPL-3.0-only"
depends="
	cosmic-icons
	gst-libav
	gst-plugin-pipewire
	gst-plugins-bad
	gst-plugins-base
	gst-plugins-good
	libcamera>=0.8.0
	libdav1d
"
makedepends="
	cargo-auditable
	clang-libclang
	cmake
	dav1d-dev
	eudev-dev
	glib-dev
	gst-plugins-base-dev
	gstreamer-dev
	just
	libcamera-dev>=0.8.0
	libjpeg-turbo-dev
	libxkbcommon-dev
	nasm
	pkgconf
	samurai
	wayland-dev
"
checkdepends="
	dbus
	ffmpeg
	gst-plugins-ugly
"
options="net"  # fetch dependencies
source="$pkgname-$pkgver.tar.gz::https://github.com/cosmic-utils/cosmic-ext-camera/archive/refs/tags/v$pkgver.tar.gz"

# Bundled static TurboJPEG exports libjpeg ABI 62 symbols, which interpose on
# Alpine's ABI 80 GStreamer JPEG plugins under musl. Use the shared system library
# for both build() and check(), without changing vendoring on other platforms.
export TURBOJPEG_SOURCE=explicit
export TURBOJPEG_DYNAMIC=1
export TURBOJPEG_LIB_DIR=/usr/lib

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	# the release tarball has no git checkout for build.rs to describe
	export CAMERA_VERSION=$pkgver

	cargo auditable build --release --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
eeac95fe2599a140c45180e2a29da034864761195466c377233280b3a4836e6d74f7c0aa74c562a482e56159c8e310e96ab80aeb3b0efe2c2442abd37df0467d  cosmic-ext-camera-1.11.0.tar.gz
"
