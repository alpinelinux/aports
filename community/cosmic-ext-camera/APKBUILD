# Contributor: Frederic Laing <dev@fredfunk.tech>
# Maintainer: Frederic Laing <dev@fredfunk.tech>
pkgname=cosmic-ext-camera
pkgver=1.3.7
pkgrel=0
pkgdesc="Modern camera app for Linux desktops and phones"
url="https://github.com/cosmic-utils/cosmic-ext-camera"
# armhf, armv7, x86: 32-bit is problematic for libcosmic apps
arch="all !armhf !armv7 !x86"
license="GPL-3.0-only"
depends="
	cosmic-icons
	gst-libav
	gst-plugin-pipewire
	gst-plugins-bad
	gst-plugins-base
	gst-plugins-good
"
makedepends="
	cargo-auditable
	clang-libclang
	cmake
	glib-dev
	gst-plugins-base-dev
	gstreamer-dev
	just
	libcamera-dev
	libxkbcommon-dev
	nasm
	pkgconf
	samurai
	wayland-dev
"
options="net"  # fetch dependencies
source="$pkgname-$pkgver.tar.gz::https://github.com/cosmic-utils/cosmic-ext-camera/archive/refs/tags/v$pkgver.tar.gz
	rustix-1.1.5.patch
	"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	# the release tarball has no git checkout for build.rs to describe
	export CAMERA_VERSION=$pkgver

	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
a2d4da5d57282505dcb5957fe58980eb89ff10f12aa960ba5c65ac2e3b5d27b26b9170358d7a5b7c3c8c1891942e82bc46da2b27148d51ba8136871ff5c1ec7a  cosmic-ext-camera-1.3.7.tar.gz
d98b092e99a45540b2e71c3ea926ddbe2e89482fa0a0d9d4e8fa12f619e11ffc2a950a102e77111773d9ca9e1288ecef1efeba7d63d17525d565d460fdf028eb  rustix-1.1.5.patch
"
