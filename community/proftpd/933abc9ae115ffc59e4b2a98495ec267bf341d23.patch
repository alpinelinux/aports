From 933abc9ae115ffc59e4b2a98495ec267bf341d23 Mon Sep 17 00:00:00 2001
From: TJ Saunders <tj@castaglia.org>
Date: Tue, 27 Oct 2026 12:56:31 -0700
Subject: [PATCH] Issue #2411: Fix regression in the handling of private keys
 formatted using the OpenSSH-specific private key format, and which are not
 passphrase-protected.

---
 contrib/mod_sftp/keys.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/contrib/mod_sftp/keys.c b/contrib/mod_sftp/keys.c
index 5e848a84d..af842926b 100644
--- a/contrib/mod_sftp/keys.c
+++ b/contrib/mod_sftp/keys.c
@@ -3093,8 +3093,10 @@ static int decrypt_openssh_data(pool *p, const char *path,
   uint32_t buflen, key_len, rounds, salt_len;
   size_t passphrase_len;
 
-  if (encrypted_data == NULL ||
-      kdf_data == NULL) {
+  /* Note: kdf_data CAN legitimately be NULL here, as for keys which
+   * are not passphrase-encrypted (Issue #2411).
+   */
+  if (encrypted_data == NULL) {
     pr_trace_msg(trace_channel, 3,
       "'%s' key is missing required data", path);
     errno = EINVAL;
