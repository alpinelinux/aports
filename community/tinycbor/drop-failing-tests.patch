     QTest::newRow("emptytextstring") << raw("\x60") << QString();
     QTest::newRow("textstring1") << raw("\x61 ") << QString();
     QTest::newRow("0.5") << raw("\xfb\x3f\xe0\0\0\0\0\0\0") << QString();
-    QTest::newRow("2.^64") << raw("\xfb\x43\xf0\0\0\0\0\0\0") << QString();
