# Contributor: Henrik Riomar <henrik.riomar@gmail.com>
# Maintainer: Henrik Riomar <henrik.riomar@gmail.com>
pkgname=py3-nats
_pkgname=nats.py
pkgver=2.17.0
pkgrel=0
pkgdesc="Python3 client for NATS"
url="https://github.com/nats-io/nats.py"
arch="noarch"
license="Apache-2.0"
checkdepends="
	nats-server
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-cov
	"
makedepends="
	py3-gpep517
	py3-uv-build
	"
depends="
	py3-aiohttp
	python3
	"
subpackages="$pkgname-pyc"
source="https://github.com/nats-io/nats.py/archive/v$pkgver/nats.py-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver/nats"

case "$CARCH" in
x86|armv7|armhf|s390x|ppc64le|riscv64|loongarch64)
	options="!check" ;; # no nats-server package or unstable tests
*) ;;
esac

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# test_client: intermittently fails
	# test_js: failed since 2.7.2 rebuild, 2.9.0
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# test configs reference certs relative to the monorepo root
	# test_connect_does_not_retry_permission_error: needs nkeys
	cd "$builddir"/..
	"$builddir"/.testenv/bin/python3 -m pytest \
		--deselect nats/tests/test_client.py::test_connect_does_not_retry_permission_error
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
6bb6b22eafda227af20ca2896ddf3b801dfd14a7510c173b6ab0609a2a055623439f0ba07246115017167a990700c5750a5e93f37bd94c4937ac6da8a7d868ac  nats.py-2.17.0.tar.gz
"
