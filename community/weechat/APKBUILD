pkgname=weechat
pkgver=4.10.4
pkgrel=0
pkgdesc="Fast, light, extensible ncurses-based chat client"
url="https://weechat.org"
_lua="5.3"
arch="all"
options="!check" # test suite runs "sudo make install"
license="GPL-3.0-or-later"
depends_dev="
	aspell-dev
	cjson-dev
	curl-dev
	gettext-dev
	gnutls-dev
	libgcrypt-dev
	lua$_lua-dev
	ncurses-dev
	perl-dev
	python3-dev
	zlib-dev
	zstd-dev
	"
makedepends="
	$depends_dev
	asciidoctor
	cmake
	samurai
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-spell:_plugin
	$pkgname-lua:_plugin
	$pkgname-perl
	$pkgname-python:_plugin
	"
source="https://www.weechat.org/files/src/weechat-$pkgver.tar.xz"

