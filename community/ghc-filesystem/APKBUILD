# Maintainer: Holger Jaekel <holger.jaekel@gmx.de>
pkgname=ghc-filesystem
pkgver=1.5.16
pkgrel=0
pkgdesc="An implementation of C++17 std::filesystem for C++11 /C++14/C++17/C++20"
url="https://github.com/gulrak/filesystem"
arch="noarch"
license="MIT"
makedepends="cmake samurai"
checkdepends="catch2"
source="filesystem-$pkgver.tar.gz::https://github.com/gulrak/filesystem/archive/refs/tags/v$pkgver.tar.gz"
builddir=$srcdir/filesystem-$pkgver

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		$crossopts
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
f3b798e3c1cf339c822af3c58a9b3692bd75b95d236e9a441ce61178257103f7903dbca8b94de595cb7a4e60539e1f7ec55ad424c76f9016f5329947d05df45a  filesystem-1.5.16.tar.gz
"
