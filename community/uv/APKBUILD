# Maintainer: Andy Postnikov <apostnikov@gmail.com>
pkgname=uv
pkgver=0.12.17
pkgrel=0
pkgdesc="Extremely fast Python package installer and resolver, written in Rust"
url="https://github.com/astral-sh/uv"
arch="all"
license="Apache-2.0 OR MIT"
makedepends="
	bzip2-dev
	cargo
	cmake
	py3-gpep517
	py3-setuptools
	py3-wheel
	py3-maturin
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	py3-$pkgname-pyc
	py3-$pkgname:py3:noarch
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/astral-sh/uv/archive/refs/tags/$pkgver.tar.gz
	rustix-linux-procfs-s390x.patchsrc
	linux-raw-sys-loongarch64-fiemap.patchsrc
	"
options="net"

case "$CARCH" in
	arm*)
		# Disable LTO on ARM to avoid OOM
		export RUSTFLAGS="${RUSTFLAGS:-} -C codegen-units=1 -C debuginfo=0"
		export CARGO_PROFILE_RELEASE_LTO="false"
	;;
esac

prepare() {
	default_prepare

	# rustix < 1.1.5 polyfills the STATX_* constants via a glob import, which
	# collides with libc's own once main/rust sets libc_unstable_musl_v1_2_3
	# (E0659). Only bites where rustix uses its libc backend: s390x, ppc64le.
	# Drop once uv's Cargo.lock reaches rustix 1.1.5 — the pinned spec below
	# then stops matching and this fails loudly instead of downgrading it.
	# https://github.com/bytecodealliance/rustix/issues/1496
	cargo update --package rustix@1.1.4 --precise 1.1.5

	cargo fetch --target="$CTARGET" --locked

	# Patch vendored crates lacking support for some architectures. Applied on
	# every arch, not just the affected one, so that a stale patch fails here
	# instead of only in s390x/loongarch64 CI. They are inert elsewhere.
	# These are .patchsrc so default_prepare does not apply them to $builddir.
	local d
	for d in "$CARGO_HOME"/registry/src/*/rustix-linux-procfs-*; do
		[ -f "$d"/src/lib.rs ] || continue
		grep -q 'if f_type != FsWord::from' "$d"/src/lib.rs || continue
		patch -Np1 -i "$srcdir"/rustix-linux-procfs-s390x.patchsrc -d "$d"
	done
	for d in "$CARGO_HOME"/registry/src/*/linux-raw-sys-*; do
		[ -f "$d"/src/loongarch64/ioctl.rs ] || continue
		grep -q FIEMAP_EXTENT_LAST "$d"/src/loongarch64/ioctl.rs && continue
		patch -Np1 -i "$srcdir"/linux-raw-sys-loongarch64-fiemap.patchsrc -d "$d"
	done
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--config-json '{"build-args": "--locked", "build-option": "--release"}' \
		--output-fd 3 3>&1 >&2

	mkdir -p completions
	local _uv="target/release/uv --generate-shell-completion"
	$_uv bash > completions/$pkgname
	$_uv fish > completions/$pkgname.fish
	$_uv zsh > completions/_$pkgname
}

check() {
	cargo test --frozen --release --bin uv
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	install -Dm 644 "completions/$pkgname" -t "$pkgdir/usr/share/bash-completion/completions/"
	install -Dm 644 "completions/$pkgname.fish" -t "$pkgdir/usr/share/fish/vendor_completions.d/"
	install -Dm 644 "completions/_$pkgname" -t "$pkgdir/usr/share/zsh/site-functions/"

	install -Dm0644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
	install -Dm0644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}

py3() {
	pkgdesc="$pkgdesc (python module)"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/python3*
}

