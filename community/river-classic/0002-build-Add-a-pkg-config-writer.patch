From 304040865738d6c0d39013c0043560a118b4281d Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Wed, 4 Nov 2026 20:29:04 +0100
Subject: [PATCH] build: Add a pkg-config writer

---
 build.zig            | 21 +++++++++++----------
 build/pkg_config.zig | 26 ++++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 10 deletions(-)
 create mode 100644 build/pkg_config.zig

diff --git a/build.zig b/build.zig
index 785b30d..88d62ad 100644
--- a/build.zig
+++ b/build.zig
@@ -253,16 +253,17 @@ pub fn build(b: *Build) !void {
 
     {
         const wf = Build.Step.WriteFile.create(b);
-        const pc_file = wf.add("river-protocols.pc", b.fmt(
-            \\prefix={s}
-            \\datadir=${{prefix}}/share
-            \\pkgdatadir=${{datadir}}/river-protocols
-            \\
-            \\Name: river-protocols
-            \\URL: https://codeberg.org/river/river
-            \\Description: protocol files for the river wayland compositor
-            \\Version: {s}
-        , .{ @compileError("todo"), full_version }));
+        const pc_writer = b.addExecutable(.{
+            .name = "pkg_config_writer",
+            .root_module = b.createModule(.{
+                .root_source_file = b.path("build/pkg_config.zig"),
+                .target = b.graph.host,
+            }),
+        });
+        const pc_writer_run = b.addRunArtifact(pc_writer);
+        pc_writer_run.addDirectoryArg2(.{.relative = .{ .base = .deployed_prefix }}, .{});
+        pc_writer_run.addArg(version);
+        const pc_file = wf.addCopyFile(pc_writer_run.captureStdOut(.{}), "river-protocols.pc");
 
         b.installFile("protocol/river-layout-v3.xml", "share/river-protocols/river-layout-v3.xml");
         b.getInstallStep().dependOn(&b.addInstallFile(pc_file, "share/pkgconfig/river-protocols.pc").step);
diff --git a/build/pkg_config.zig b/build/pkg_config.zig
new file mode 100644
index 0000000..b02a8b3
--- /dev/null
+++ b/build/pkg_config.zig
@@ -0,0 +1,26 @@
+const std = @import("std");
+
+pub fn main(init: std.process.Init) !void {
+    var args = try init.minimal.args.iterateAllocator(init.gpa);
+    defer args.deinit();
+    if (!args.skip()) @panic("no argv0");
+    const prefix = args.next() orelse @panic("no prefix");
+    const version = args.next() orelse @panic("no version");
+    if (args.skip()) @panic("too many arguments");
+
+    const stdout = std.Io.File.stdout();
+    defer stdout.close(init.io);
+    var out_buf: [1024]u8 = undefined;
+    var out = stdout.writer(init.io, &out_buf);
+    try out.interface.print(
+        \\prefix={s}
+        \\datadir=${{prefix}}/share
+        \\pkgdatadir=${{datadir}}/river-protocols
+        \\
+        \\Name: river-protocols
+        \\URL: https://codeberg.org/river/river
+        \\Description: protocol files for the river wayland compositor
+        \\Version: {s}
+        , .{prefix, version});
+    try out.flush();
+}
