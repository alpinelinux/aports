From a5d8254510fdebcb36400201bb3022d92e94018d Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Wed, 4 Nov 2026 20:38:11 +0100
Subject: [PATCH] feat: Handle keypad slide state

Added in newer zig-wlroots
---
 river/Switch.zig      | 14 ++++++++++++++
 river/command/map.zig | 14 ++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/river/Switch.zig b/river/Switch.zig
index 470511c..fcf4bda 100644
--- a/river/Switch.zig
+++ b/river/Switch.zig
@@ -31,11 +31,13 @@ const log = std.log.scoped(.switch_device);
 pub const Type = enum {
     lid,
     tablet,
+    keypad_slide,
 };
 
 pub const State = union(Type) {
     lid: LidState,
     tablet: TabletState,
+    keypad_slide: KeypadSlideState,
 };
 
 pub const LidState = enum {
@@ -48,6 +50,11 @@ pub const TabletState = enum {
     on,
 };
 
+pub const KeypadSlideState = enum {
+    out,
+    in,
+};
+
 device: InputDevice,
 
 toggle: wl.Listener(*wlr.Switch.event.Toggle) = wl.Listener(*wlr.Switch.event.Toggle).init(handleToggle),
@@ -92,6 +99,13 @@ fn handleToggle(listener: *wl.Listener(*wlr.Switch.event.Toggle), event: *wlr.Sw
                 .on => .{ .tablet = .on },
             };
         },
+        .keypad_slide => {
+            switch_type = .keypad_slide;
+            switch_state = switch (event.switch_state) {
+                .off => .{ .keypad_slide = .in },
+                .on => .{ .keypad_slide = .out },
+            };
+        },
     }
 
     switch_device.device.seat.handleSwitchMapping(switch_type, switch_state);
diff --git a/river/command/map.zig b/river/command/map.zig
index c0d34c1..b4e623c 100644
--- a/river/command/map.zig
+++ b/river/command/map.zig
@@ -358,6 +358,20 @@ fn parseSwitchState(
             };
             return Switch.State{ .tablet = tablet_state };
         },
+        .keypad_slide => {
+            const keypad_state = meta.stringToEnum(
+                Switch.KeypadSlideState,
+                switch_state_str,
+            ) orelse {
+                out.* = try std.fmt.allocPrint(
+                    util.gpa,
+                    "invalid keypad slide state '{s}', must be 'in' or 'out'",
+                    .{switch_state_str},
+                );
+                return Error.Other;
+            };
+            return Switch.State{ .keypad_slide = keypad_state };
+        }
     }
 }
 
