# Contributor: Leon White <badfunkstripe@gmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=py3-pytest-relaxed
pkgver=2.0.2
pkgrel=0
pkgdesc="pytest plugin for relaxed test discovery"
url="https://github.com/bitprophet/pytest-relaxed"
arch="noarch"
license="BSD-2-Clause"
depends="py3-pytest py3-decorator"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-doc $pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/bitprophet/pytest-relaxed/archive/refs/tags/$pkgver.tar.gz
	fix-fixture-detection-pytest-8.4.patch
	"
builddir="$srcdir/pytest-relaxed-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
