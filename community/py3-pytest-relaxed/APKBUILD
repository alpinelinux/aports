606d6116fddbddf817bb84c712840fbb1917799ffc2935ddf55facc3d00c530d557cfc93d6c93eeb93e275ca58d3c9c1a1a5105553a3f9dd0af4d7a285f9433a  fix-fixture-detection-pytest-8.4.patch
"
