a051a641abb000f9c3c3b547ac1d11f58f6277c9a3b74f222f4a1e10fc20f0f76a87be513fdacb44f3bf7b1176dd73d9e2120410d41d6834a1bbd3cd37b8e717  drop-libstdcxx-dependency.patch
"
