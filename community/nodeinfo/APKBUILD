pkgname=nodeinfo
pkgver=1.0.0
pkgrel=13
pkgdesc="A command line tool to query nodeinfo based on a given domain"
url="https://codeberg.org/thefederationinfo/nodeinfo-go"
license="MIT"
arch="all"
makedepends="go"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/thefederationinfo/nodeinfo-go/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname"
options="chmod-clean net !check" # go
builddir="$srcdir"/nodeinfo-go/cli

build() {
	go build -tags extension -o $pkgname .
}

package() {
	install -Dm755 $pkgname "$pkgdir"/usr/bin/$pkgname
}

