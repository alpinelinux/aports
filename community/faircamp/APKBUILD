pkgname=faircamp
pkgver=2.0.0
pkgrel=0
_commit=62e5916
pkgdesc="Static site generator for audio producers"
url="https://faircamp.org/"
arch="all !armhf !armv7 !x86" # build fails
license="AGPL-3.0-or-later"
depends="ffmpeg rsync"
makedepends="cargo cargo-auditable fontconfig-dev opus-dev"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/simonrepp/faircamp/archive/$pkgver.tar.gz
	external-revision.patch
	rustix-1.1.5.patch
	"
builddir="$srcdir/faircamp"
options="!check net" # no test suite; downloading crates

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	FAIRCAMP_REVISION=$_commit cargo auditable build --frozen --release
}

package() {
	install -Dm755 target/release/faircamp "$pkgdir"/usr/bin/faircamp
}

