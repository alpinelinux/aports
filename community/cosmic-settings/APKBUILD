# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=cosmic-settings
pkgver=1.9.0
_upstreamver="${pkgver/_beta/-beta.}"
_upstreamver="${_upstreamver/_p/.}"
pkgrel=0
pkgdesc="Settings application for the COSMIC Desktop Environment"
url="https://github.com/pop-os/cosmic-settings"
# armv7, armhf: std::bad_alloc <- deadly signal
# armv7, armhf, x86: DO NOT RE-ENABLE! 32-bit is problematic, often requires carrying patches to fix
# riscv64: too slow to build
# ppc64le, s390x: rustix statx failure
arch="aarch64 loongarch64 x86_64"
license="GPL-3.0-only"
depends="
	cosmic-icons
"
makedepends="
	cargo-auditable
	clang-libclang
	cosmic-icons
	cosmic-randr
	dav1d-dev
	findutils
	fontconfig-dev
	iso-codes-dev
	just
	libinput-dev
	libxkbcommon-dev
	pulseaudio-dev
	pipewire-dev
	wayland-dev
"
options="net"  # fetch dependencies
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pop-os/cosmic-settings/archive/refs/tags/epoch-$_upstreamver.tar.gz
"
builddir="$srcdir/$pkgname-epoch-$_upstreamver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
63acd8f48afd2dffd95860a5dceaee016ad091dea5f77179396e69b5f96d1d69559cca53b1fcbd4e7d12c01388a5b16831ed9d900fabc1aa47ece98ccea8dca8  cosmic-settings-1.9.0.tar.gz
"
