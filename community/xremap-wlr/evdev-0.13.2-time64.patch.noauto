             pub fn destructure(&self) -> ($kind, i32) {
diff -ru a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs	2026-11-26 08:41:24.144590072 +0100
+++ b/src/lib.rs	2026-11-26 08:41:34.454263090 +0100
@@ -373,7 +373,7 @@
     /// Returns the timestamp associated with the event.
     #[inline]
     pub fn timestamp(&self) -> SystemTime {
-        timeval_to_systime(&self.0.time)
+        timeval_to_systime(&raw_event_time(&self.0))
     }
 
     /// Returns the type of event this describes, e.g. Key, Switch, etc.
@@ -414,15 +414,7 @@
 
     /// Create a new InputEvent. Only really useful for emitting events on virtual devices.
     pub fn new(type_: u16, code: u16, value: i32) -> Self {
-        let raw = input_event {
-            time: libc::timeval {
-                tv_sec: 0,
-                tv_usec: 0,
-            },
-            type_,
-            code,
-            value,
-        };
+        let raw = crate::new_raw_event(libc::timeval { tv_sec: 0, tv_usec: 0 }, type_, code, value);
         Self(raw)
     }
 
@@ -433,12 +425,7 @@
     /// the kernel will update `input_event.time` when it emits the events to any programs reading
     /// the event "file".
     pub fn new_now(type_: u16, code: u16, value: i32) -> Self {
-        let raw = input_event {
-            time: systime_to_timeval(&SystemTime::now()),
-            type_,
-            code,
-            value,
-        };
+        let raw = crate::new_raw_event(systime_to_timeval(&SystemTime::now()), type_, code, value);
         Self(raw)
     }
 }
@@ -607,3 +594,34 @@
     /// The duration, in milliseconds, between auto-repetitions of a held-down key.
     pub period: u32,
 }
+
+// With RUST_LIBC_UNSTABLE_MUSL_V1_2_3, 32-bit musl uses the time64 layout of
+// struct input_event, which has input_event_sec/input_event_usec instead of time.
+#[cfg(not(all(target_env = "musl", target_pointer_width = "32")))]
+fn new_raw_event(time: libc::timeval, type_: u16, code: u16, value: i32) -> input_event {
+    input_event { time, type_, code, value }
+}
+
+#[cfg(all(target_env = "musl", target_pointer_width = "32"))]
+fn new_raw_event(time: libc::timeval, type_: u16, code: u16, value: i32) -> input_event {
+    input_event {
+        input_event_sec: time.tv_sec as _,
+        input_event_usec: time.tv_usec as _,
+        type_,
+        code,
+        value,
+    }
+}
+
+#[cfg(not(all(target_env = "musl", target_pointer_width = "32")))]
+fn raw_event_time(ev: &input_event) -> libc::timeval {
+    ev.time
+}
+
+#[cfg(all(target_env = "musl", target_pointer_width = "32"))]
+fn raw_event_time(ev: &input_event) -> libc::timeval {
+    libc::timeval {
+        tv_sec: ev.input_event_sec as _,
+        tv_usec: ev.input_event_usec as _,
+    }
+}
