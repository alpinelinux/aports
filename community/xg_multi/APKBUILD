# Contributor: macmpi <spam@ipik.org>
# Maintainer: macmpi <spam@ipik.org>
pkgname=xg_multi
pkgver=2.0
pkgrel=0
pkgdesc="Extended Multifunction USB-gadget"
url="https://github.com/macmpi/xg_multi"
arch="noarch"
license="MIT"
source="$pkgname-$pkgver.tar.gz::https://github.com/macmpi/xg_multi/archive/refs/tags/v$pkgver.tar.gz"
# does not have any tests
options="!check"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd:systemd:noarch"

package() {
	install -D -m755 "$builddir"/$pkgname "$pkgdir"/usr/bin/$pkgname
	install -D -m755 "$builddir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -D -m644 "$builddir"/$pkgname.conf "$pkgdir"/etc/conf.d/$pkgname
	install -D -m644 "$builddir"/$pkgname.service "$pkgdir"/usr/lib/systemd/system/$pkgname.service
	install -D -m644 "$builddir"/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

systemd() {
	default_systemd
	install -D -m644 "$builddir"/$pkgname.conf "$subpkgdir"/etc/default/$pkgname
}

sha512sums="
f986a9a1eaad0d06e486e4faca7000774fe1f8eef609ab8aa699f0375dd97c284f25604257a073a3c24d165b53b11bb9f755efc3b42688c22e275d3f4683d20e  xg_multi-2.0.tar.gz
"

