From 34422de3a7d10906ae7619f5ba255ea8e583fb6a Mon Sep 17 00:00:00 2001
From: mio <miyopan@e.email>
Date: Fri, 16 Oct 2026 06:01:39 +0000
Subject: [PATCH] Update project metadata to fix build with flit >=4.0.0

---
 pyproject.toml | 23 +++++++++++++----------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index b60b4d8..404c4b0 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,21 +1,24 @@
 [build-system]
-requires = ["flit_core >=2,<4"]
+requires = ["flit_core >=4,<5"]
 build-backend = "flit_core.buildapi"
 
-[tool.flit.metadata]
-module = "nashpy"
-author = "Vince Knight, James Campbell"
-author-email = "vince@vknight.org"
-requires = [
+[project]
+name = "nashpy"
+dynamic = ["version", "description"]
+authors = [
+  { name = "Vince Knight", email = "vince@vknight.org" },
+  { name = "James Campbell", email = "james.campbell@tanti.org.uk" },
+]
+dependencies = [
     "numpy >=1.21.0",
     "scipy >=0.19.0",
     "networkx >= 3.0.0",
     "deprecated >= 1.2.14"
 ]
-home-page = "https://github.com/drvinceknight/Nashpy"
+urls.Homepage = "https://github.com/drvinceknight/Nashpy"
 requires-python= ">=3.10"
-description-file = "README.md"
-classifiers = [ "License :: OSI Approved :: MIT License",]
+readme = "README.md"
+license = "MIT"
 
-[tool.flit.metadata.requires-extra]
+[project.optional-dependencies]
 doc = ["sphinx==6.2.1", "sphinx-rtd-theme", "sphinx-togglebutton", "matplotlib", "sphinxcontrib.mermaid"]
-- 
2.56.0

