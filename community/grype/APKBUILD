ba6bf89ade82b3f31dc0f39346ba1ce18fc9096464d8173b1eec2c03aead327fac9f65dd91d4fff1b35b02042e32b8d47a79ee9f5da94a38468135aa345d77e3  disable-update-check.patch
fc0949410dbd15972af5dbf2e018156db9df71f4317f3dd97ca07f5570e506001c47bdbbf74124723e6aec0b2a5c538927999d8bbd20749a76b337f6c4e0c7ab  x-sys-ppc64le-pie-fix.patch
"
