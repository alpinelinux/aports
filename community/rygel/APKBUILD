maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=rygel
pkgver=46.0
pkgrel=0
pkgdesc="UPnP AV MediaServer and MediaRenderer"
url="https://gnome.pages.gitlab.gnome.org/rygel/"
arch="all"
license="LGPL-2.1-or-later"
depends="py3-yaml"
makedepends="
	gst-editing-services-dev
	gtk4.0-dev
	gupnp-av-dev
	gupnp-dev
	gupnp-dlna-dev
	libgee-dev
	libmediaart-dev
	meson
	py3-docutils
	vala
	"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang $pkgname-systemd"
source="https://download.gnome.org/sources/rygel/${pkgver%.*}/rygel-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Dsystemd-user-units-dir=/usr/lib/systemd/user \
		-Dtests="$(want_check && echo true || echo false)" \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
