sandbox: allow tkill in isolated renderer PID namespaces

musl uses tkill for pthread_kill, which V8 calls during CPU profiling.
The sandbox rejects it, causing renderer crashes on profiling-enabled pages.

Allow tkill for renderers running as PID 1 with both user and PID namespace
sandboxing enabled. Their private PID namespace confines signal targets
to the renderer's own threads.

ref: https://gitlab.alpinelinux.org/alpine/aports/-/work_items/18482

--- a/sandbox/policy/linux/bpf_renderer_policy_linux.h
+++ b/sandbox/policy/linux/bpf_renderer_policy_linux.h
@@ -19,7 +19,8 @@
 class SANDBOX_POLICY_EXPORT RendererProcessPolicy : public BPFBasePolicy {
  public:
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
-  RendererProcessPolicy();
+  // Only enable when the process owns a private PID namespace and cannot fork.
+  explicit RendererProcessPolicy(bool allow_tkill = false);
 #elif BUILDFLAG(IS_ANDROID)
   explicit RendererProcessPolicy(
       const BaselinePolicyAndroid::RuntimeOptions& options);
@@ -31,6 +32,9 @@
   ~RendererProcessPolicy() override;
 
   bpf_dsl::ResultExpr EvaluateSyscall(int system_call_number) const override;
+
+ private:
+  const bool allow_tkill_ = false;
 };
 
 }  // namespace sandbox::policy
