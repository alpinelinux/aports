# Maintainer: Lauri Tirkkonen <lauri@hacktheplanet.fi>
pkgname=netbird
pkgver=0.83.0
pkgrel=0
pkgdesc="WireGuard-based overlay network and mesh VPN"
url="https://netbird.io/"
arch="all"
license="BSD-3-Clause"
options="net !check" # tests require root
depends="openresolv"
# nodejs 24.18.0 segfaults in pnpm install on riscv64, but -current works
makedepends="go go-task nodejs-current pnpm webkit2gtk-6.0-dev jq envsubst esbuild rollup node-lightningcss node-tailwindcss-oxide"
subpackages="
$pkgname-doc
$pkgname-openrc
$pkgname-bash-completion
$pkgname-fish-completion
$pkgname-zsh-completion
$pkgname-mgmt
$pkgname-signal
$pkgname-relay
$pkgname-mgmt-openrc
$pkgname-signal-openrc
$pkgname-relay-openrc
$pkgname-ui
"
install="
$pkgname.pre-install
$pkgname-mgmt.pre-install
$pkgname-relay.pre-install
$pkgname-signal.pre-install
"
source="
https://github.com/netbirdio/netbird/archive/refs/tags/v$pkgver/netbird-$pkgver.tar.gz
pnpm-workspace.yaml
netbird.initd
netbird-mgmt.initd
netbird-relay.initd
netbird-signal.initd
netbird.confd
netbird-mgmt.confd
netbird-relay.confd
netbird-signal.confd
"

_build_frontend() {
	local esbuild_ver=$(esbuild --version)
	# override pnpm settings and regenerate lockfile to avoid
	# native binary downloads and to force use of system esbuild
	ESBUILD_VER=$esbuild_ver \
		envsubst '$ESBUILD_VER' <"$srcdir"/pnpm-workspace.yaml >client/ui/frontend/pnpm-workspace.yaml
	export ESBUILD_BINARY_PATH=/usr/lib/node_modules/esbuild/bin/esbuild
	pnpm -C client/ui/frontend install --lockfile-only

	# XXX: packaging wails3 is probably a good idea at some point,
	# instead of this
	go build -mod=mod -o bin/wails3 github.com/wailsapp/wails/v3/cmd/wails3
	# client/ui/build install:frontend:deps has a "pnpm --version"
	# precondition, which fails on armv7, armhf, loongarch64,
	# ppc64le, and riscv64 with
	# 	[ERROR] Cannot verify the identity of the @pnpm/exe.linux-arm native binary: it is missing from pnpm-lock.yaml.
	# this is https://github.com/pnpm/pnpm/issues/13622 and it
	# happens because package.json sets packageManager to a
	# specific version of pnpm. so, remove packageManager from
	# package.json before trying to build the ui, so that it will
	# use the system-installed pnpm.
	jq 'del(.packageManager)' client/ui/frontend/package.json >tmp.json
	mv tmp.json client/ui/frontend/package.json
	# downloads from "pnpm install" while go-task is doing other
	# stuff often hit ERR_PNPM_ERR_OUT_OF_RANGE or
	# ERR_PNPM_ERR_BUFFER_OUT_OF_BOUNDS on riscv64 CI; predownload
	# to work around that
	pnpm -C client/ui/frontend fetch
	PATH=$PWD/bin:$PATH go-task -d client/ui common:build:frontend
}

build() {
	mkdir -p build bin

	_build_frontend

	go build -v -o build \
		-tags wayland \
		-ldflags "-X github.com/netbirdio/netbird/version.version=$pkgver -extldflags \"$LDFLAGS\"" \
		./client ./client/ui ./management ./signal ./relay
}

_install_completions() {
	local bashdir="$pkgdir"/usr/share/bash-completion/completions
	local fishdir="$pkgdir"/usr/share/fish/vendor_completions.d
	local zshdir="$pkgdir"/usr/share/zsh/site-functions

	local prog="$1"

	mkdir -p "$bashdir" "$fishdir" "$zshdir"
	"$pkgdir"/usr/bin/$prog completion bash >"$bashdir"/$prog
	"$pkgdir"/usr/bin/$prog completion fish >"$fishdir"/$prog.fish
	"$pkgdir"/usr/bin/$prog completion zsh >"$zshdir"/_$prog
}

package() {
	install -Dm0755 build/client "$pkgdir"/usr/bin/netbird
	install -Dm0644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

	if [ -x build/ui ]; then
		install -Dm0755 build/ui "$pkgdir"/usr/bin/netbird-ui
		install -Dm0644 client/ui/build/linux/netbird.desktop "$pkgdir"/usr/share/applications/netbird.desktop
		install -Dm0644 client/ui/assets/netbird.png "$pkgdir"/usr/share/pixmaps/netbird.png
	fi

	install -Dm0755 build/management "$pkgdir"/usr/bin/netbird-mgmt
	install -Dm0755 build/signal "$pkgdir"/usr/bin/netbird-signal
	install -Dm0755 build/relay "$pkgdir"/usr/bin/netbird-relay

	install -Dm0755 $srcdir/netbird.initd "$pkgdir"/etc/init.d/netbird
	install -Dm0755 $srcdir/netbird-signal.initd "$pkgdir"/etc/init.d/netbird-signal
	install -Dm0755 $srcdir/netbird-mgmt.initd "$pkgdir"/etc/init.d/netbird-mgmt
	install -Dm0755 $srcdir/netbird-relay.initd "$pkgdir"/etc/init.d/netbird-relay
	install -Dm0644 $srcdir/netbird.confd "$pkgdir"/etc/conf.d/netbird
	install -Dm0644 $srcdir/netbird-signal.confd "$pkgdir"/etc/conf.d/netbird-signal
	install -Dm0600 $srcdir/netbird-mgmt.confd "$pkgdir"/etc/conf.d/netbird-mgmt
	install -Dm0600 $srcdir/netbird-relay.confd "$pkgdir"/etc/conf.d/netbird-relay

	_install_completions netbird
	_install_completions netbird-mgmt
	_install_completions netbird-signal
}

ui() {
	pkgdesc="Graphical user interface for NetBird"
	amove usr/bin/netbird-ui usr/share
}

mgmt() {
	license="AGPL-3.0-only"
	depends=""

	amove usr/bin/netbird-mgmt
}

signal() {
	license="AGPL-3.0-only"
	depends=""

	amove usr/bin/netbird-signal
}

relay() {
	license="AGPL-3.0-only"
	depends=""

	amove usr/bin/netbird-relay
}

openrc() {
	local subpkg="${subpkgname%-openrc}"
	depends="$depends_openrc"
	install_if="openrc $subpkg=$pkgver-r$pkgrel"

	amove etc/init.d/$subpkg etc/conf.d/$subpkg
}

