the unix socket allows unprivileged users to control the netbird daemon, so
restrict its permissions.

Link: https://github.com/netbirdio/netbird/issues/1541

diff --git a/client/cmd/service_socket.go b/client/cmd/service_socket.go
index f825a40620..13e1ed61b0 100644
--- a/client/cmd/service_socket.go
+++ b/client/cmd/service_socket.go
@@ -104,7 +104,7 @@
 		return nil
 	}
 
-	if err := os.Chmod(l.address, 0666); err != nil {
+	if err := os.Chmod(l.address, 0660); err != nil {
 		return fmt.Errorf("failed setting %s permissions for %s: %w", description, l.address, err)
 	}
 	return nil
