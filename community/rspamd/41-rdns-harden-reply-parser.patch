-		}
-		else {
-			l2 = ++c;
-			c += len2;
-		}
-		if (len1 != len2) {
+
+		if (r1 != r2) {
+			/* One of the names is longer than another one */
 			return NULL;
 		}
-		if (len1 == 0) {
+
+		if (r1 == 0) {
