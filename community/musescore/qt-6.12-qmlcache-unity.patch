Fix build with Qt 6.12

Exclude qmlcachegen output from unity builds. Qt 6.12 generated code
uses unqualified names like Type that clash with "using namespace" in
sources merged into the same unity file.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -261,3 +261,25 @@
     file(COPY ${CMAKE_CURRENT_SOURCE_DIR}/build/compile_commands/compile_commands.json
         DESTINATION ${CMAKE_CURRENT_SOURCE_DIR})
 endif()
+
+# Qt 6.12 qmlcachegen output uses unqualified names such as 'Type' that
+# clash with 'using namespace' in MuseScore sources merged into the same
+# unity build file. Build the generated qmlcache sources separately.
+function(muse_skip_qmlcache_unity dir)
+    get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
+    foreach(subdir IN LISTS subdirs)
+        muse_skip_qmlcache_unity(${subdir})
+    endforeach()
+    get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
+    foreach(target IN LISTS targets)
+        get_target_property(sources ${target} SOURCES)
+        foreach(source IN LISTS sources)
+            if(source MATCHES "/\\.rcc/qmlcache/.*\\.cpp$")
+                set_property(SOURCE ${source} TARGET_DIRECTORY ${target}
+                    PROPERTY SKIP_UNITY_BUILD_INCLUSION ON)
+            endif()
+        endforeach()
+    endforeach()
+endfunction()
+cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR}
+    CALL muse_skip_qmlcache_unity ${CMAKE_SOURCE_DIR})
