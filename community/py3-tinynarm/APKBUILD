# Maintainer: Iztok Fister, Jr. <iztok@iztok-jr-fister.eu>
pkgname=py3-tinynarm
pkgver=0.3.3
pkgrel=0
pkgdesc="Simplify numerical association rule mining"
url="https://github.com/firefly-cpp/tinynarm"
arch="noarch"
license="MIT"
depends="python3 py3-niaarm"
makedepends="py3-poetry-core py3-gpep517"
checkdepends="py3-defusedxml py3-pytest-xdist"
subpackages="$pkgname-doc $pkgname-pyc"
source="https://github.com/firefly-cpp/tinynarm/archive/$pkgver/tinynarm-$pkgver.tar.gz"
builddir="$srcdir/tinynarm-$pkgver"


build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -n auto
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/tinynarm-$pkgver-py3-none-any.whl

	install -Dm644 CITATION.cff -t "$pkgdir"/usr/share/doc/$pkgname
	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname
}

sha512sums="
4a70634a39ae238c53f9a474338e34bc6840dc5bef5f676e9e0004b413223a28574e2ee011489ce0eb94e6a91673f20e63e8cfb50361e845ecbbdcef633fb56d  tinynarm-0.3.3.tar.gz
"
