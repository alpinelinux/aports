# Contributor: Noel Kuntze <noel.kuntze@thermi.consulting>
# Maintainer: Noel Kuntze <noel.kuntze@thermi.consulting>
pkgname=py3-requests-gssapi
pkgver=1.4.0
pkgrel=0
pkgdesc="GSSAPI (HTTP negotiate) authentication handler for Python Requests"
url="https://github.com/pythongssapi/requests-gssapi"
arch="noarch"
license="ISC"
depends="
	python3
	py3-python-gssapi
	py3-requests
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver-2.tar.gz::https://github.com/pythongssapi/requests-gssapi/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/requests-gssapi-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7ac3f467de888fd75e9dbc1533ab75ff2690ed236425999a1bdee82ee799b256f14ecb0dd661d8d655b10bbdac4a68f0faeffc5468dcef758fa5220694c59080  py3-requests-gssapi-1.4.0-2.tar.gz
"
