maintainer="Michał Polański <michal@polanski.me>"
pkgname=llhttp
pkgver=9.4.3
pkgrel=0
pkgdesc="Port of http_parser to llparse"
url="https://llhttp.org/"
license="MIT"
arch="all"
makedepends="cmake samurai"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/nodejs/llhttp/archive/refs/tags/release/v$pkgver/llhttp-$pkgver.tar.gz"
builddir="$srcdir/llhttp-release-v$pkgver"
options="!check" # no tests

# secfixes:
#   9.2.1-r0:
#     - CVE-2024-27982

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLLHTTP_BUILD_SHARED_LIBS=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/doc/$pkgname
}

sha512sums="
c34570cdda6c184648f9f8982bd5c11e4dcff585c481259509402997f7c2341f423e25034b8420498d0858d35f6ce2328cd850dd000e219dffba1c18f1c38801  llhttp-9.4.3.tar.gz
"
