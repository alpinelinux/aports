maintainer="Michał Polański <michal@polanski.me>"
pkgname=llhttp
pkgver=9.4.4
_nodejs_commit="e9c277643b0249c50f6e6de5413be8a88ea11b6a"
pkgrel=0
pkgdesc="Port of http_parser to llparse"
url="https://llhttp.org/"
license="MIT"
arch="all"
makedepends="cmake samurai"
subpackages="$pkgname-dev $pkgname-doc"
source="nodejs-$_nodejs_commit.tar.gz::https://github.com/nodejs/node/archive/$_nodejs_commit.tar.gz"
builddir="$srcdir/node-$_nodejs_commit/deps/llhttp"
options="!check" # no tests

# secfixes:
#   9.4.4-r0:
#     - CVE-2026-123864
#   9.2.1-r0:
#     - CVE-2024-27982

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLLHTTP_BUILD_SHARED_LIBS=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/doc/$pkgname
}

sha512sums="
