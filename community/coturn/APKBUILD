build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share \
		--localstatedir=/var \
		--disable-rpath \
		--sysconfdir=/etc/$pkgname \
		--turndbdir=/var/lib/$pkgname
	make
}

check() {
	make test
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm755 "$srcdir"/turnserver.initd \
		"$pkgdir"/etc/init.d/turnserver
}

