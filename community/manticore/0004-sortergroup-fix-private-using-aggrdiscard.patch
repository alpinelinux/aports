From 6f7ef8221983275728cc79c16fd8cee2c4abaaa7 Mon Sep 17 00:00:00 2001
From: Raphael Fakhri <153192858+RaphaelFakhri@users.noreply.github.com>
Date: Sat, 24 Oct 2026 16:46:40 +0000
Subject: [PATCH] fix: build with GCC 14 fails in sortergroup.cpp

KBufferGroupSorter_T redeclared BaseGroupSorter_c::AggrDiscard in its private section. CSphKBufferGroupSorter re-exports the same member with its own using-declaration, and GCC 14 rejects that because it finds the private redeclaration first. Move the using-declaration into the protected section, where the only caller (OnMatchFree) already lives.
---
 src/sortergroup.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/sortergroup.cpp b/src/sortergroup.cpp
index 6258369351..4c4609f111 100755
--- a/src/sortergroup.cpp
+++ b/src/sortergroup.cpp
@@ -81,7 +81,6 @@ class KBufferGroupSorter_T : public CSphMatchQueueTraits, protected BaseGroupSor
 {
 	using MYTYPE = KBufferGroupSorter_T<COMPGROUP,UNIQ,DISTINCT,NOTIFICATIONS>;
 	using BASE = CSphMatchQueueTraits;
-	using BaseGroupSorter_c::AggrDiscard;
 
 public:
 	KBufferGroupSorter_T ( const ISphMatchComparator * pComp, const CSphQuery * pQuery, const CSphGroupSorterSettings & tSettings )
@@ -181,6 +180,8 @@ class KBufferGroupSorter_T : public CSphMatchQueueTraits, protected BaseGroupSor
 	bool CanBeCloned() const final { return !DISTINCT && BASE::CanBeCloned(); }
 
 protected:
+	using BaseGroupSorter_c::AggrDiscard;
+
 	ESphGroupBy 				m_eGroupBy;     ///< group-by function
 	void OnMatchFree ( CSphMatch & tMatch ) override
 	{
