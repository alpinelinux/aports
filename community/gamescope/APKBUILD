_bump() {
	msg "Updating dependency pins in $APKBUILD..."

	local _tree="$(curl -sfL \
		"https://api.github.com/repos/Plagman/gamescope/git/trees/$pkgver?recursive=1")"

	local _libliftoff=$(echo "$_tree" | jq -r '.tree[] | select(.path == "subprojects/libliftoff") | .sha')
	local _openvr=$(echo "$_tree" | jq -r '.tree[] | select(.path == "subprojects/openvr") | .sha')
	local _reshade=$(echo "$_tree" | jq -r '.tree[] | select(.path == "src/reshade") | .sha')
	local _stb=$(curl -sfL \
		"https://raw.githubusercontent.com/Plagman/gamescope/$pkgver/subprojects/stb.wrap" |
		sed -n 's/^revision = //p')
	local _vkroots=$(echo "$_tree" | jq -r '.tree[] | select(.path == "subprojects/vkroots") | .sha')
	local _wlroots=$(echo "$_tree" | jq -r '.tree[] | select(.path == "subprojects/wlroots") | .sha')

	msg "  libliftoff=$_libliftoff"
	msg "  openvr=$_openvr"
	msg "  reshade=$_reshade"
	msg "  stb=$_stb"
	msg "  vkroots=$_vkroots"
	msg "  wlroots=$_wlroots"

	sed -i \
		-e "s|^_libliftoff=.*|_libliftoff=$_libliftoff|" \
		-e "s|^_openvr=.*|_openvr=$_openvr|" \
		-e "s|^_reshade=.*|_reshade=$_reshade|" \
		-e "s|^_stb=.*|_stb=$_stb|" \
		-e "s|^_vkroots=.*|_vkroots=$_vkroots|" \
		-e "s|^_wlroots=.*|_wlroots=$_wlroots|" \
		"$APKBUILD"
}

prepare() {
	default_prepare

	rmdir subprojects/libliftoff
	rmdir subprojects/openvr
	rmdir src/reshade
	rmdir subprojects/vkroots
	rmdir subprojects/wlroots

	ln -sfv "$srcdir"/libliftoff-$_libliftoff subprojects/libliftoff
	ln -sfv "$srcdir"/openvr-$_openvr subprojects/openvr
	ln -sfv "$srcdir"/reshade-$_reshade src/reshade
	ln -sfv "$srcdir"/vkroots-$_vkroots subprojects/vkroots
	ln -sfv "$srcdir"/wlroots-$_wlroots subprojects/wlroots

	cp "$srcdir"/stb_image_resize.h src/

	sed -i -e "s|@VCS_TAG@|$pkgver|" \
		src/GamescopeVersion.h.in
}

build() {
	CXXFLAGS="$CXXFLAGS -DRTLD_DEEPBIND=0" \
	CMAKE_POLICY_VERSION_MINIMUM=3.5 \
	abuild-meson \
		-Ddefault_library=static \
		-Davif_screenshots=enabled \
		-Ddrm_backend=enabled \
		-Dinput_emulation=enabled \
		-Dpipewire=enabled \
		-Drt_cap=enabled \
		-Dsdl2_backend=enabled \
		-Dsystem_spirv_headers=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install \
		--no-rebuild \
		--skip-subprojects \
		-C output
}
