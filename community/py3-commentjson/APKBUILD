ad11c29339276741d53d4b0b8db8a6a932fcaaf0bf086ce8b346f5688deec4b9eaaf16929a0729d16387b395f2014d63ff85379a6dc6b2dedc3c84b449263cf4  py3.14.patch
f64092ee6415d55375b8b264732efc8ce9fd422494d43151ff09e662ce1d7650c7336da1d87059d20ff1cde50ff60f9c0b4d0b3dc0bddfc5ff890238741c19f0  update-test-skips.patch
"
