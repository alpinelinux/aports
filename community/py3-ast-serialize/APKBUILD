maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-ast-serialize
pkgver=0.13.1
pkgrel=0
pkgdesc="Python bindings for mypy AST serialization"
url="https://pypi.org/project/ast-serialize/"
license="MIT"
arch="all" # includes shared objects.
depends="python3"
makedepends="cargo py3-maturin py3-setuptools py3-gpep517"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/a/ast_serialize/ast_serialize-$pkgver.tar.gz"
builddir="$srcdir/ast_serialize-$pkgver"
options="net !check" # cargo fetch, no tests

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
