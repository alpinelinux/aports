# Contributor: macmpi <spam@ipik.org>
# Maintainer: macmpi <spam@ipik.org>
maintainer="macmpi <spam@ipik.org>"
pkgname=raspberrypi-sys-mods
pkgver=1.20260907
# set _commit hash in reference to related release
pkgrel=0
_commit="2097cbe978d64254340b94a53655cf112cb6a797"
pkgdesc="A collection of Raspberry Pi-sourced system configuration files and associated scripts"
url="https://github.com/RPi-Distro/raspberrypi-sys-mods"
arch="armhf armv7 aarch64"
license="BSD-3-Clause"
source="raspberrypi-sys-mods-$_commit.tar.gz::https://github.com/RPi-Distro/raspberrypi-sys-mods/archive/$_commit.tar.gz"
subpackages="raspberrypi-sys-mods-udev:udev:noarch"
_dir="$srcdir/raspberrypi-sys-mods-$_commit"

# does not have any tests
options="!check"

package() {
	mkdir -p "$pkgdir"
}

udev() {
	pkgdesc="$pkgdesc (udev rules)"
	provides="raspberrypi-userland-udev=$pkgver-r$pkgrel"  # for backward compatibility
	install_if="udev $pkgname=$pkgver-r$pkgrel"

	# before adding new rules, check constistency with mdev.conf (eventually enhance it)
	# https://gitlab.alpinelinux.org/alpine/mdev-conf/-/blob/master/mdev.conf.in
	for i in 10-vc \
		60-dma-heap \
		60-gpiochip4 \
		; do
		install -Dm644 "$_dir/usr/lib/udev/rules.d/$i.rules" "$subpkgdir/usr/lib/udev/rules.d/${i%%-*}-rpi-${i#*-}.rules"
	done
}

sha512sums="
a31ff7bf93cc31d30b8efff62c6dca799d8201733be7e765698c6ec2b7ee14b7dc4763e7478793fa82d16ed2d5fb12bcd6f6903e31e62f2f257972d6282bad25  raspberrypi-sys-mods-2097cbe978d64254340b94a53655cf112cb6a797.tar.gz
"
