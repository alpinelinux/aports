# Contributor: macmpi <spam@ipik.org>
# Maintainer: macmpi <spam@ipik.org>
maintainer="macmpi <spam@ipik.org>"
pkgname=raspberrypi-sys-mods
pkgver=1.20260612
# set _sys commit hash in reference to related release
pkgrel=0
_sys="f492faebfbc4b2c4ae41e26fe850e63bf9c09531"
pkgdesc="A collection of Raspberry Pi-sourced system configuration files and associated scripts"
url="https://github.com/RPi-Distro/raspberrypi-sys-mods"
arch="armhf armv7 aarch64"
license="BSD-3-Clause"
source="raspberrypi-sys-mods-$_sys.tar.gz::https://github.com/RPi-Distro/raspberrypi-sys-mods/archive/$_sys.tar.gz"
subpackages="raspberrypi-sys-mods-udev:udev:noarch"
_sysdir="$srcdir/raspberrypi-sys-mods-$_sys"

# does not have any tests
options="!check"

package() {
	mkdir -p "$pkgdir"
}

udev() {
	pkgdesc="$pkgdesc (udev rules)"
	provides="raspberrypi-userland-udev=$pkgver-r$pkgrel"  # for backward compatibility
	install_if="udev $pkgname=$pkgver-r$pkgrel"

	# before adding new rules, check constistency with mdev.conf (eventually enhance it)
	# https://gitlab.alpinelinux.org/alpine/mdev-conf/-/blob/master/mdev.conf.in
	for i in 10-vc 60-dma-heap; do
		install -Dm644 "$_sysdir/usr/lib/udev/rules.d/$i.rules" "$subpkgdir/usr/lib/udev/rules.d/${i%%-*}-rpi-${i#*-}.rules"
	done
}

sha512sums="
70eee6f5b3e7b537f86f42b8caccb6c4d5d66d3ea87d11c0b1e1eb7d86d5ec38517685ef04fd6ffc70845f63627633a70f9403891ce3320f845f76f2ac3381c0  raspberrypi-sys-mods-f492faebfbc4b2c4ae41e26fe850e63bf9c09531.tar.gz
"
