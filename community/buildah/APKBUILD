build() {
	GIT_COMMIT="$pkgver" make buildah
	GIT_COMMIT="$pkgver" make -C docs GOMD2MAN="$(which go-md2man)"
}

package() {
	GIT_COMMIT="$pkgver" make install PREFIX=/usr DESTDIR="$pkgdir"
}

