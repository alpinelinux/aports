pkgname=buildah
pkgver=1.46.0
pkgrel=0
pkgdesc="tool that facilitates building OCI container images"
url="https://github.com/podman-container-tools/buildah"
license="Apache-2.0"
arch="all"
depends="oci-runtime shadow-subids passt container-libs"
makedepends="go go-md2man lvm2-dev gpgme-dev libseccomp-dev btrfs-progs-dev bash"
subpackages="$pkgname-doc"
options="!check" # tests require root privileges
source="https://github.com/podman-container-tools/buildah/archive/v$pkgver/buildah-$pkgver.tar.gz"

