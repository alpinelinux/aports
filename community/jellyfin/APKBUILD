# Contributor: Fabricio Silva <hi@fabricio.dev>
# Contributor: Martin Kjær Jørgensen <me@lagy.org>
# Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
pkgname=jellyfin
pkgver=12.3
pkgrel=0
pkgdesc="The Free Software Media System"
install="$pkgname.pre-install"
url="https://jellyfin.org/"
arch="x86_64 armv7 aarch64"
license="GPL-2.0-only"
makedepends="dotnet10-sdk gawk"
depends="aspnetcore10-runtime jellyfin-ffmpeg skiasharp"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/jellyfin/jellyfin/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	remove-prebuilt-library.patch
	"
options="net" # api.nuget.org

if [ "$CARCH" = armv7 ]; then
	depends="$depends gcompat"
	makedepends="$makedepends patchelf"
fi

prepare() {
	default_prepare

	# set SkiaSharp and SkiaSharp.Harfbuzz version based on packaged library
	local _skia_packagedver=$(apk version skiasharp | tail -n 1 | cut -d '=' -f 2  | tr -d ' ')
	local _skia_packagedver=${_skia_packagedver/-*}
	msg "Building against skiasharp $_skia_packagedver"
	gawk -i inplace -v skia_version="Version=\"$_skia_packagedver\"" '{if($2 == "Include=\"SkiaSharp\""){ $3 = skia_version}{print}}' Directory.Packages.props
	gawk -i inplace -v skia_version="Version=\"$_skia_packagedver\"" '{if($2 == "Include=\"SkiaSharp.HarfBuzz\""){ $3 = skia_version}{print}}' Directory.Packages.props
}

build() {
	dotnet publish Jellyfin.Server \
		--configuration Release \
		--no-self-contained \
		--use-current-runtime \
		--output publish

	if [ "$CARCH" = armv7 ]; then
		# The bundled PDFium library only provides a glibc build for armv7.
		# TODO: remove this workaround once Jellyfin uses PDFtoImage that pulls in
		# PDFium newer than
		# 157.0.8086 with musl arm support and/or PDFium packaged natively by Alpine.
		# https://github.com/bblanchon/pdfium-binaries/issues/134
		# https://github.com/bblanchon/pdfium-binaries/pull/246
		patchelf --add-needed libgcompat.so.0 publish/libpdfium.so
	fi
}

check() {
	dotnet test --configuration Release --os linux-musl
}

package() {
	mkdir -p "$pkgdir"/usr/lib "$pkgdir"/usr/bin

	cp -a publish "$pkgdir"/usr/lib/jellyfin
	ln -s ../lib/jellyfin/jellyfin "$pkgdir"/usr/bin/jellyfin

	# PDFtoImage pulls in SkiaSharp.NativeAssets.Linux.NoDependencies, which
	# publishes libSkiaSharp.so. Remove it before linking Alpine's native library.
	rm "$pkgdir"/usr/lib/jellyfin/libSkiaSharp.so
	ln -s ../libSkiaSharp.so "$pkgdir"/usr/lib/jellyfin/libSkiaSharp.so

	# as reported in https://gitlab.alpinelinux.org/alpine/aports/-/merge_requests/104531#note_629707
	# and https://github.com/mono/SkiaSharp/issues/3038
	# using libHarfbuzzSharp with system libHarfbuzz is broken
	# using system libHarfbuzz directly as workaround for now
	# TODO: get back to using system libHarfBuzzSharp.so
	ln -s ../libharfbuzz.so.0 "$pkgdir"/usr/lib/jellyfin/libHarfBuzzSharp.so

	install -Dm755 "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

