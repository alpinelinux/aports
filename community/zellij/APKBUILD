# Contributor: guddaff <guddaff@protonmail.com>
# Maintainer: guddaff <guddaff@protonmail.com>
pkgname=zellij
pkgver=0.45.1
pkgrel=1
pkgdesc="Terminal multiplexer"
url="https://zellij.dev/"
license="MIT"
# s390x, loongarch64 : corosensei-0.1.3 unsupported target
arch="all !s390x !loongarch64"
makedepends="
	cargo
	cargo-auditable
	openssl-dev>3
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/zellij-org/zellij/archive/v$pkgver/zellij-$pkgver.tar.gz
	interprocess-2.3.1-time64.patch.noauto
	"
options="!check" # troublesome

# use system openssl
export OPENSSL_NO_VENDOR=1

prepare() {
	default_prepare

	# rustix < 1.1.5 fails with ambiguous STATX_* imports on the libc backend
	cargo update -p rustix@1.1.2 --precise 1.1.6
	# polling 2.2.0 fails with the time64 timespec on 32-bit musl
	cargo update -p polling@2.2.0 --precise 2.8.0
	cargo fetch --target="$CTARGET" --locked

	patch -p1 -d "$CARGO_HOME"/registry/src/*/interprocess-2.3.1 \
		< "$srcdir"/interprocess-2.3.1-time64.patch.noauto
}

build() {
	cargo auditable build --frozen --release

	mkdir -p target/completions
	for sh in bash fish zsh; do
		target/release/$pkgname setup --generate-completion $sh \
			> target/completions/$pkgname.$sh
	done
}

package() {
	install -D -m755 target/release/$pkgname -t "$pkgdir"/usr/bin/

	install -D -m644 target/completions/$pkgname.bash \
		"$pkgdir"/usr/share/bash-completion/completions/$pkgname

	install -D -m644 target/completions/$pkgname.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish

	install -D -m644 target/completions/$pkgname.zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

sha512sums="
1fa550fe243d8b18a87ff1983631a9a76eb9dde9d1d2c59f0aa6e1bb8b1a677168c469e143de7cc4fcc9ff3a0799c1dc566553ed74bcadab345282b81c105fc8  zellij-0.45.1.tar.gz
9f6f3d35d6926047c4ec2e0312e7d717ad4eb46e38a102465ad599d92dfb794137180f26efa7dc2a901f76c482b9415779af4863419e6fa8a0c1f73da0b6f64f  interprocess-2.3.1-time64.patch.noauto
"
