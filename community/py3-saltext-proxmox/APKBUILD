# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-saltext-proxmox
_pkgname=saltext_proxmox
pkgver=2.0.1
pkgrel=0
pkgdesc="Salt Extension for interacting with Proxmox PVE"
url="https://pypi.org/project/saltext.proxmox/"
arch="noarch"
license="Apache-2.0"
depends="py3-requests"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # checks require a saltstack environment

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7e29184be0b0f5ff3c1e74ba035ff5214c595a6d38ae7a37f36e19017f9cefa1cf2a0438c2d1a5aace680c95f9eeb85495dfecc8bb32fa3280541f95a9ff396d  saltext_proxmox-2.0.1.tar.gz
"
