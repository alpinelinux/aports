pkgname=libp11
pkgver=0.4.21
pkgrel=0
pkgdesc="PKCS#11 wrapper library"
url="https://github.com/OpenSC/libp11/wiki"
arch="all"
license="LGPL-2.1-or-later"
makedepends="openssl-dev autoconf automake"
checkdepends="bash opensc softhsm"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/OpenSC/libp11/releases/download/libp11-$pkgver/libp11-$pkgver.tar.gz
	"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-static
	make
}

check() {
	make VERBOSE=1 check
}

package() {
	make DESTDIR="$pkgdir" install
}
sha512sums="
