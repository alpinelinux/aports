maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=ariadne-codegen
_pkgname=ariadne_codegen
pkgver=0.19.0
pkgrel=0
pkgdesc="Generate fully typed Python GraphQL clients from schema, queries and mutations"
url="https://ariadnegraphql.org/"
arch="noarch"
license="MIT"
depends="
	black
	py3-autoflake
	py3-click
	py3-graphql-core
	py3-httpx
	py3-isort
	py3-pydantic
	py3-toml
"
makedepends="
	py3-gpep517
	py3-hatchling
"
checkdepends="
	py3-ariadne
	py3-freezegun
	py3-opentelemetry-api
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-httpx
	py3-requests-toolbelt
	py3-websockets
	"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
subpackages="$pkgname-pyc"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # missing checkdepends

build() {
	gpep517 build-wheel --wheel-dir .dist  --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

