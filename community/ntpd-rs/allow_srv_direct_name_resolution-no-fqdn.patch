From 41689ae92e66d7c4e89076cbee1b833a6e173318 Mon Sep 17 00:00:00 2001
From: Stefan van Ieperen <stefan@tweedegolf.com>
Date: Wed, 1 Jul 2026 10:20:24 +0200
Subject: [PATCH] Fix: don't use FQDN in allow_srv_direct_name_resolution

---
 ntpd/src/daemon/spawn/nts.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ntpd/src/daemon/spawn/nts.rs b/ntpd/src/daemon/spawn/nts.rs
index dfee52226..ddc15ce31 100644
--- a/ntpd/src/daemon/spawn/nts.rs
+++ b/ntpd/src/daemon/spawn/nts.rs
@@ -252,7 +252,7 @@ mod tests {
 
         let mut spawner = NtsSpawner::new(
             NtsSourceConfig {
-                address: NtsKeAddress(NormalizedAddress::new_from_parts("localhost.", addr.port())),
+                address: NtsKeAddress(NormalizedAddress::new_from_parts("localhost", addr.port())),
                 enable_srv_resolution: true,
                 certificate_authorities: Arc::default(),
                 ntp_version: ntp_proto::ProtocolVersion::V4,
