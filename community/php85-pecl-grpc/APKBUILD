# Maintainer: Andy Postnikov <apostnikov@gmail.com>
pkgname=php85-pecl-grpc
_extname=grpc
pkgver=1.83.1
pkgrel=0
pkgdesc="PHP 8.5 extension provide a concrete implementation of the gRPC protocol, layered over HTTP/2."
url="https://pecl.php.net/package/grpc"
arch="all !s390x !ppc64le" # build failures
license="Apache-2.0"
_phpv=85
_php=php$_phpv
depends="$_php-common"
makedepends="$_php-dev grpc-dev"
source="
	php-pecl-$_extname-$pkgver.tgz::https://pecl.php.net/get/$_extname-$pkgver.tgz
	config-system.m4
	"
builddir="$srcdir"/$_extname-$pkgver

prepare() {
	default_prepare
	# Build only the PHP glue against the system libgrpc (community/grpc)
	# instead of the bundled gRPC core + boringssl + abseil + upb + re2.
	cp "$srcdir"/config-system.m4 config.m4
	# make sure nothing bundled can be picked up
	rm -r include third_party src/core
}

build() {
	phpize$_phpv
	./configure --prefix=/usr --with-php-config=php-config$_phpv
	make
}

check() {
	# Test suite is not a part of pecl release.
	$_php -d extension=modules/$_extname.so --ri $_extname
}

package() {
	make INSTALL_ROOT="$pkgdir" install
	local _confdir="$pkgdir"/etc/$_php/conf.d
	install -d $_confdir
	echo "extension=$_extname" > $_confdir/50_$_extname.ini
}

sha512sums="
e45b2497ac0db7482e7debe4ae0b255caf2a3df209b283f044e8a28927d43df40b08b0e53f6be40e4380fc12df7d1e87fb97a888f447038d0cf22869121dbcd1  php-pecl-grpc-1.83.1.tgz
7116422ba616c1baa77cc7eed722ad8bd750bf6b997778a7d37ee2782ec011eada8621bd7f5e1148b39a7b15ecabde22ea00590b053897b1c8abe0ecdb9ac2ed  config-system.m4
"
