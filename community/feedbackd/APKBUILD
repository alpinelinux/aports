# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/phosh <newbyte@postmarketos.org>"
pkgname=feedbackd
pkgver=0.8.10
pkgrel=0
pkgdesc="Daemon to provide haptic, LED, and audio feedback triggered by application events"
url="https://gitlab.freedesktop.org/feedbackd/feedbackd"
arch="all"
license="GPL-3.0-or-later"
depends="dbus feedbackd-device-themes"
makedepends="
	gi-docgen
	glib-dev
	gmobile-dev
	gobject-introspection-dev
	gsound-dev
	gtk-doc
	json-glib-dev
	libgudev-dev
	meson
	vala
	umockdev-dev
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-systemd
	$pkgname-udev
	$pkgname-media-roles:_media_roles
	"
source="https://sources.phosh.mobi/releases/feedbackd/feedbackd-$pkgver.tar.xz"
install="$pkgname.pre-install $pkgname.pre-upgrade"
options="!check" # fails because of the environment

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgtk_doc=true \
		-Dudev=true \
		-Dmedia-roles=true \
		. output
	meson compile -C output
}

check() {
	dbus-run-session meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

_media_roles() {
	pkgdesc="$pkgdesc (Wireplumber media role linking policy)"
	amove usr/share/wireplumber/wireplumber.conf.d/media-role-nodes.conf
}

sha512sums="
8c11b13ea5b92ec2558e3689cb2ff75efbd9be8db93f9f635b18303e87ac2b60a782111f3341dd4bd2a8c67df7c2732ec8347397fedb8c729a004a01d7f20bf6  feedbackd-0.8.10.tar.xz
"
