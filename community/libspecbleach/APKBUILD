# Maintainer: Magnus Sandin <magnus.sandin@valitron.se>
pkgname=libspecbleach
pkgver=0.4.0
pkgrel=0
pkgdesc="Standalone library based on the algorithms used in noise-repellent."
url="https://github.com/lucianodato/libspecbleach"
arch="all"
license="LGPL-2.1-or-later AND BSD-3-Clause"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends="
	cmake
	samurai
	"
subpackages="$pkgname-dev $pkgname-extras"
source="
	libspecbleach-$pkgver.tar.gz::https://github.com/lucianodato/libspecbleach/archive/refs/tags/v$pkgver.tar.gz
	x86_avx.patch
	"

build() {
	# The vendored pffft's AltiVec path is incomplete: pffft_priv_impl.h
	# uses VLOAD_ALIGNED, VREV_S and VREV_C, which pf_altivec_float.h
	# never defines. Fall back to the scalar implementation there.
	case "$CARCH" in
	ppc64le)
		export CFLAGS="$CFLAGS -DPFFFT_SIMD_DISABLE"
		;;
	esac

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DSPECBLEACH_BUILD_EXTRAS=ON \
		-DENABLE_EXAMPLES=OFF \
		-DENABLE_TESTS="$(want_check && echo ON || echo OFF)"

	cmake --build build --config Release --parallel
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

extras() {
	depends=""
	pkgdesc="$pkgdesc (extras)"

	amove usr/lib/libspecbleach_extras.so.*
}

sha512sums="
