From a31df76c141838b2a407e862821cd3549927dfc7 Mon Sep 17 00:00:00 2001
From: Aliaksei Chapyzhenka <alex.drom@gmail.com>
Date: Tue, 10 Nov 2026 12:54:58 -0800
Subject: [PATCH 1/2] Fix VNUser upper bits uninitialized on 32-bit hosts

Since user1-4 storage changed to uint64_t (#8317), VNUser is a union of
void* and uint64_t. VNUser(void*) wrote only m_u.up, so on hosts where
void* is 32 bits (e.g. wasm32-wasip1) the upper half of m_u.uq kept
stale stack bytes. user*u() returns VNUser{nullptr} for slots not set
in the current generation, so toUQuad() read garbage and user*() looked
set on untouched nodes. E.g. V3LinkDot then reports every module, even
an empty top, as "Unsupported: Identically recursive module".

Zero the full union before storing the pointer. No functional change on
64-bit hosts.
---
 src/V3Ast.h | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/V3Ast.h b/src/V3Ast.h
index f39004ea5e8..6966db80c7b 100644
--- a/src/V3Ast.h
+++ b/src/V3Ast.h
@@ -197,7 +197,12 @@ class VNUser final {
         m_u.up = nullptr;
         m_u.uq = i;
     }
-    explicit VNUser(void* p) { m_u.up = p; }
+    explicit VNUser(void* p) {
+        // Zero the full slot first: on 32-bit targets (e.g. wasm32) void* is
+        // narrower than uint64_t, and toUQuad() would read stale upper bytes.
+        m_u.uq = 0;
+        m_u.up = p;
+    }
     ~VNUser() = default;
     // Casters
     template <typename T>

