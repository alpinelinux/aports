# Maintainer: Antoine Martin (ayakael) <dev@ayakael.net>
pkgname=py3-webauthn
_pyname=webauthn
pkgver=3.0.1
pkgrel=0
arch="noarch"
pkgdesc="A Python3 implementation of the WebAuthn API focused on making it easy to leverage the power of WebAuthn."
url="https://pypi.python.org/project/webauthn"
license="BSD-3-Clause"
depends="
	py3-asn1
	py3-asn1-modules
	py3-cbor2
	py3-openssl
	py3-cryptography
	"
makedepends="
	py3-setuptools
	py3-gpep517
	py3-wheel
	"
checkdepends="
	py3-pytest
"
source="$pkgname-$pkgver.tar.gz::https://github.com/duo-labs/py_webauthn/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir"/py_webauthn-$pkgver
subpackages="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}
sha512sums="
2a46a73ca2a65484f50573611d4feb562f5e2fbb4f29dff741da935fa4d66ca98b2de8bf80643bda190f5002bbd92a5ad4b0538f15f5554ffb73c2f5177d2bf2  py3-webauthn-3.0.1.tar.gz
"
