maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-cyclopts
pkgver=4.25.2
pkgrel=0
pkgdesc="Intuitive, easy CLIs based on type hints"
url="https://github.com/BrianPugh/cyclopts"
arch="noarch"
license="Apache-2.0"
depends="
	mkdocs
	py3-attrs
	py3-docstring-parser
	py3-yaml
	"
makedepends="
	py3-gpep517
	py3-hatch-vcs
	py3-hatchling
	py3-rich
	py3-rich-rst
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	py3-docutils
	py3-pydantic
	py3-pytest
	py3-pytest-mock
	py3-sniffio
	py3-sphinx
	py3-syrupy
	py3-trio
	"
subpackages="$pkgname-pyc"
#source="$pkgname-$pkgver.tar.gz::https://pypi.python.org/packages/source/c/cyclopts/cyclopts-$pkgver.tar.gz"
source="$pkgname-$pkgver.tar.gz::https://github.com/BrianPugh/cyclopts/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/cyclopts-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
