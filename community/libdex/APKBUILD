maintainer="team/gnome <kboykinov@teamcentrixx.com>"
pkgname=libdex
pkgver=1.2.0
pkgrel=0
pkgdesc="Future-based programming for GLib-based applications"
url="https://gitlab.gnome.org/GNOME/libdex"
arch="all"
license="LGPL-2.1-or-later AND BSD-3-Clause"
makedepends="
	dbus-dev
	glib-dev
	gobject-introspection-dev
	libucontext-dev
	meson
	vala
	"
subpackages="$pkgname-dev $pkgname-dbg $pkgname-pyc"
source="https://download.gnome.org/sources/libdex/${pkgver%.*}/libdex-$pkgver.tar.xz
	ucontext.patch
	0001-tests-skip-dbus-tests-which-fails-with-missing-machi.patch
	"
options="!check" # gdbus tests

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgdbus=enabled \
		-Dtests="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

