From: Willow Barraco <contact@willowbarraco.fr>
Date: Tue, 23 Jun 2026 14:21:51 +0200
Subject: [PATCH] tests: skip dbus tests which fails with missing machine-id

Signed-off-by: Willow Barraco <contact@willowbarraco.fr>
---
 testsuite/meson.build | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/testsuite/meson.build b/testsuite/meson.build
index 46b91ce63604..a3ee830cdd59 100644
--- a/testsuite/meson.build
+++ b/testsuite/meson.build
@@ -31,7 +31,7 @@ testsuite = {
   'test-aio': {},
   'test-async-result': {},
   'test-channel': {},
-  'test-dbus': {'extra-sources': dbus_foo, 'disable': not have_gdbus_codegen, 'is_parallel': false},
+  'test-dbus': {'extra-sources': dbus_foo, 'disable': not have_gdbus_codegen or not have_machine_id, 'is_parallel': false},
   'test-coroutine': {},
   'test-object': {},
   'test-fiber': {},
