# Maintainer: Orhun Parmaksız <orhunparmaksiz@gmail.com>
pkgname=release-plz
pkgver=0.4.3
pkgrel=0
pkgdesc="Release Rust packages without using the command line"
url="https://github.com/release-plz/release-plz"
license="MIT OR Apache-2.0"
# loongarch64: gix-index 0.47.0 uses st_mtim; musl libc uses st_mtime
arch="all !loongarch64"
depends="git"
makedepends="
	cargo
	cargo-auditable
	libgit2-dev
	openssl-dev
	"
checkdepends="cargo-semver-checks"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/release-plz/release-plz/archive/release-plz-v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgname-v$pkgver"
options="net" # cargo fetch

export LIBGIT2_NO_VENDOR=1 # use system libgit2

prepare() {
	default_prepare
	cargo fetch --locked
}

check() {
	local _skip_tests="
		--skip project \
		--skip input_generates_correct_release_request"

	case "$CARCH" in
	s390x)
		_skip_tests="$_skip_tests \
		--skip tests::git_error_is_reported_after_invalid_utf8_output"
		# keeps failing on the package builder
		;;
	esac

	git init -q
	RUST_MIN_STACK=8388608 cargo test --frozen --no-default-features -- \
		"$_skip_tests"
}

build() {
	OPENSSL_NO_VENDOR=1 cargo auditable build -p "$pkgname" --release --frozen
	mkdir -p completions/
	local compgen="target/release/$pkgname generate-completions"
	$compgen bash >"completions/$pkgname"
	$compgen fish >"completions/$pkgname.fish"
	$compgen zsh >"completions/_$pkgname"
}

package() {
	install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
	install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
	install -Dm 644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm 644 "completions/$pkgname" -t "$pkgdir/usr/share/bash-completion/completions/"
	install -Dm 644 "completions/$pkgname.fish" -t "$pkgdir/usr/share/fish/vendor_completions.d/"
	install -Dm 644 "completions/_$pkgname" -t "$pkgdir/usr/share/zsh/site-functions/"
}

sha512sums="
05a07ce1b86c9cb128c839ab9448adcd841faccadc5a1119bf2e601593d6395b67d9e7ca2d7d8cba7fa40ca62c1e60ede5f9a6ddc12d86a9ad39493927ca1e39  release-plz-v0.4.3.tar.gz
"
