# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-pg
_gemname=pg
pkgver=1.7.0
pkgrel=0
pkgdesc="A PostgreSQL client library for Ruby"
url="https://github.com/ged/ruby-pg"
arch="all"
license="BSD-2-Clause PostgreSQL"
depends="ruby-bigdecimal"
checkdepends="postgresql ruby-rspec"
makedepends="libpq-dev ruby-dev"
source="https://github.com/ged/ruby-pg/archive/v$pkgver/ruby-pg-$pkgver.tar.gz
	gemspec.patch
	"
options="!check"  # FIXME: tests seem to be broken

build() {
	gem build $_gemname.gemspec
	gem install \
		--local \
		--build-root dist \
		--no-document \
		--verbose \
		$_gemname
}

check() {
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir'):.gem" \
	rspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r build_info cache doc
	rmdir plugins || true
	find extensions/ -name mkmf.log -delete

	cd gems/$_gemname-$pkgver
	rm -r ext/ lib/*.so
}

sha512sums="
