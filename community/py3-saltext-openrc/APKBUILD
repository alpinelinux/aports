# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-saltext-openrc
_pkgname=saltext_openrc
pkgver=0.2.1
pkgrel=0
pkgdesc="Salt Extension that adds support for openrc"
url="https://github.com/salt-extensions/saltext-openrc"
arch="noarch"
license="Apache-2.0"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-pytest-instafail
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/${_pkgname//./_}-$pkgver"
options="!check" # missing pytest-salt-factories

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest tests/unit/ -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
ef8d73b08f71bc4ddc360c6de9f1fe8354fc06c9d88b2646c965406421c439ff0a453ddc9b9f1cdcc160b02aea194d29fd327dff212745db076a447bc4e72fdc  saltext_openrc-0.2.1.tar.gz
"
