# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=postgresql-pg_graphql
_projname=pg_graphql
pkgver=1.6.3
_pgrxver=0.19.2 # must match pgrx version in Cargo.toml
pkgrel=0
pkgdesc="GraphQL support for PostgreSQL"
url="https://supabase.github.io/pg_graphql/"
# riscv64,s390x: fails to build due to ring crate (https://github.com/pgcentralfoundation/pgrx/pull/1442)
arch="all !riscv64 !s390x"
license="Apache-2.0"
makedepends="
	cargo
	chrpath
	clang22-libclang
	openssl-dev
	postgresql
	postgresql-dev
	rustfmt
	"
source="https://github.com/supabase/pg_graphql/archive/v$pkgver/$_projname-v$pkgver.tar.gz
	cargo-pgrx-$_pgrxver.tar.gz::https://static.crates.io/crates/cargo-pgrx/cargo-pgrx-$_pgrxver.crate
	"
builddir="$srcdir/$_projname-$pkgver"
# check: tests tries to write to /usr/lib/...
# net: fetches crates in build phase
options="!check net"

export PGRX_HOME="$srcdir/.pgrx"

prepare() {
	default_prepare

	# rustix < 1.1.5 fails with ambiguous STATX_* imports on the libc backend
	cargo update -p rustix@1.1.4 --precise 1.1.6
	cargo fetch --target="$CTARGET" --locked

	cd "$srcdir"/cargo-pgrx-$_pgrxver
	cargo update -p rustix@1.1.4 --precise 1.1.6
}

build() {
	local pgver="$(pg_config --major-version)"

	# We must install it this way because cargo-pgrx and pgrx dependency
	# versions in the project must be identical. :(
	# Use dev profile to speed-up compilation.
	cargo install --locked --profile dev --bins --root target/tools \
		--path "$srcdir"/cargo-pgrx-$_pgrxver

	export PATH="$PWD/target/tools/bin:$PATH"

	cargo pgrx init --pg$pgver="$(command -v pg_config)"

	# TODO: Remove after https://github.com/pgcentralfoundation/pgrx/issues/1455 is resolved.
	if [ -n "$RUSTFLAGS" ]; then
		export RUSTFLAGS="$RUSTFLAGS"
	else
		unset RUSTFLAGS
	fi
	cargo pgrx package --verbose --out-dir="target/release/dist"

	# Remove RPATH.
	# NOTE: CARGO_PROFILE_RELEASE_RPATH=false doesn't work here.
	chrpath -d target/release/dist/usr/lib/postgresql*/*.so
}

package() {
	depends="postgresql$(pg_config --major-version)"

	mkdir -p "$pkgdir"
	cp -r target/release/dist/* "$pkgdir"/
}

