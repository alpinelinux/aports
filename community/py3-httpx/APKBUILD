cd6107db2fb6123ad952537cef8b45c7896cf370807ad79c1ca355aee8e0fb32718db5de4c12075da2126d9e47d915ed30c40a9fe6aebe5aa04d33c9e99c1d9c  remove-fancy-pypi-readme.patch
"
