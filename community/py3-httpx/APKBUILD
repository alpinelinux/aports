maintainer="Michał Polański <michal@polanski.me>"
pkgname=py3-httpx
pkgver=0.29.0
pkgrel=0
pkgdesc="Next generation HTTP client for Python"
url="https://www.python-httpx.org/"
license="BSD-3-Clause"
arch="noarch"
depends="
	py3-anyio
	py3-certifi
	py3-httpcore
	py3-idna
	"
makedepends="
	py3-gpep517
	py3-hatchling
	"
checkdepends="
	py3-brotli
	py3-chardet
	py3-h2
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-trio
	py3-rich
	py3-socksio
	py3-trustme
	py3-zstandard
	uvicorn
	"
subpackages="$pkgname-pyc"
source="https://github.com/encode/httpx/archive/$pkgver/py3-httpx-$pkgver.tar.gz
	remove-fancy-pypi-readme.patch
	"
builddir="$srcdir/httpx-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# pytest >= 9.1.0 captures non-propagating uvicorn.access logs in caplog,
	# which breaks log assertions
	.testenv/bin/python3 -m pytest -vv \
		-k "not test_logging_request and not test_logging_redirect_chain"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/httpx-$pkgver-py3-none-any.whl
}

sha512sums="
