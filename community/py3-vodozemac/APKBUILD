maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-vodozemac
pkgver=0.10.0
pkgrel=0
pkgdesc="Python bindings for vodozemac"
url="https://github.com/matrix-nio/vodozemac-python"
arch="all"
license="MIT"
makedepends="
	cargo
	py3-gpep517
	py3-maturin
	"
checkdepends="
	py3-hypothesis
	py3-pytest
	"
subpackages="$pkgname-pyc"
source="https://github.com/matrix-nio/vodozemac-python/archive/$pkgver/vodozemac-python-$pkgver.tar.gz"
options="net" # cargo fetch
builddir="$srcdir/vodozemac-python-$pkgver"

prepare() {
	default_prepare

	cargo fetch --locked
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--config-json '{"build-args": "--frozen"}' \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# Prevent vodozemac dir from shadowing the installed package
	cd tests
	../.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
964b262d4c0373fd31a52c613de5cc509a8c8ab0ae0456abc7f529ae5d8da395e5ef9e005fd50281145ac9b7c3448ce7fcb2ea29ee8972e3bb8669afceff8910  vodozemac-python-0.10.0.tar.gz
"
