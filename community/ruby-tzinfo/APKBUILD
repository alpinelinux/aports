# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-tzinfo
_gemname=tzinfo
pkgver=2.0.6
pkgrel=3
pkgdesc="Ruby Timezone Library"
url="https://github.com/tzinfo/tzinfo"
arch="noarch"
license="MIT"
depends="
	ruby
	ruby-concurrent-ruby
	tzdata
	"
checkdepends="
	ruby-bundler
	ruby-minitest
	ruby-minitest-mock
	ruby-rake
	"
source="https://github.com/tzinfo/tzinfo/archive/v$pkgver/ruby-tzinfo-$pkgver.tar.gz
	no-coverage.patch
	rakefile-ruby-3.3-compat.patch
	gemfile-test-deps.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	RUBYOPT=-rminitest/mock bundle exec rake test
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r cache build_info doc extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm LICENSE ./*.md
}

