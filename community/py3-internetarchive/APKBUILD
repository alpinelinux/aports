# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-internetarchive
pkgver=5.11.0
pkgrel=0
pkgdesc="Python interface to archive.org"
url="https://github.com/jjjake/internetarchive"
arch="noarch"
license="AGPL-3.0-only"
depends="
	py3-jsonpatch
	py3-requests
	py3-tqdm
	py3-urllib3
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-responses
	"
subpackages="$pkgname-pyc ia"
_pyname=internetarchive
source="$_pyname-$pkgver.tar.gz::https://github.com/jjjake/$_pyname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m pytest -v \
		--ignore=tests/cli/test_ia_download.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

ia() {
	pkgdesc="Command-line tool for archive.org"
	depends="$pkgname"
	amove usr/bin/ia
}

sha512sums="
47dd53cc1b3525f2a8b76b2b15f9f37704da1bb6e158e6b58be6ed888e7b43c2b5e90719e87c8cf4ca099c923eb9c596bd04a4d8111c8b5db1ddcac05dbdcf41  internetarchive-5.11.0.tar.gz
"
