# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-internetarchive
pkgver=5.11.1
pkgrel=0
pkgdesc="Python interface to archive.org"
url="https://github.com/jjjake/internetarchive"
arch="noarch"
license="AGPL-3.0-only"
depends="
	py3-jsonpatch
	py3-requests
	py3-tqdm
	py3-urllib3
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-responses
	"
subpackages="$pkgname-pyc ia"
_pyname=internetarchive
source="$_pyname-$pkgver.tar.gz::https://github.com/jjjake/$_pyname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m pytest -v \
		--ignore=tests/cli/test_ia_download.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

ia() {
	pkgdesc="Command-line tool for archive.org"
	depends="$pkgname"
	amove usr/bin/ia
}

sha512sums="
adac99f46bb18d522015932d29d26d0304adb83ec2600b26e8470a4aa8ceb8dfa64ef3a05c3f6bb61060847b3e42f7fa23794fbf826794be9f424e27e9ef5173  internetarchive-5.11.1.tar.gz
"
