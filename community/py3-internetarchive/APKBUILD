# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-internetarchive
pkgver=5.12.1
pkgrel=0
pkgdesc="Python interface to archive.org"
url="https://github.com/jjjake/internetarchive"
arch="noarch"
license="AGPL-3.0-only"
depends="
	py3-jsonpatch
	py3-requests
	py3-tqdm
	py3-urllib3
	"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-hatch-vcs
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-responses
	"
subpackages="$pkgname-pyc ia"
_pyname=internetarchive
source="$_pyname-$pkgver.tar.gz::https://github.com/jjjake/$_pyname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m pytest -v \
		--ignore=tests/cli/test_ia_download.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

ia() {
	pkgdesc="Command-line tool for archive.org"
	depends="$pkgname"
	amove usr/bin/ia
}

sha512sums="
e01314e041ef54cf353aff1beb5fe65fcaf3c87cdb1e3670e913053f0ed3b921db97b1224cd97f532459b628327cf674c7bade188ce84b375fbfb1eb7094676c  internetarchive-5.12.1.tar.gz
"
