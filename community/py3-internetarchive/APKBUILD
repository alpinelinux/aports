# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-internetarchive
pkgver=5.12.0
pkgrel=0
pkgdesc="Python interface to archive.org"
url="https://github.com/jjjake/internetarchive"
arch="noarch"
license="AGPL-3.0-only"
depends="
	py3-jsonpatch
	py3-requests
	py3-tqdm
	py3-urllib3
	"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-hatch-vcs
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-responses
	"
subpackages="$pkgname-pyc ia"
_pyname=internetarchive
source="$_pyname-$pkgver.tar.gz::https://github.com/jjjake/$_pyname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m pytest -v \
		--ignore=tests/cli/test_ia_download.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

ia() {
	pkgdesc="Command-line tool for archive.org"
	depends="$pkgname"
	amove usr/bin/ia
}

sha512sums="
7126dcd1ed4ec93e317c0b2c14e44209507fc2b6d7ab2d83c815f1bb15f50003a0fb7d6063879e064b369a5e9e79d61dd3c77528b4c183ece618939ce7e75308  internetarchive-5.12.0.tar.gz
"
