#     - CVE-2026-108978

build() {
	meson --prefix /usr build

	ninja -C build
}

check() {
	ninja -C build test
}

package() {
	DESTDIR="$pkgdir" ninja -C build install

	install -Dm 644 "COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	for f in licenses/*
	do
		install -Dm 644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
	done
}

