# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=ruby-simplecov-cobertura
_gemname=${pkgname#ruby-}
pkgver=4.0.0
pkgrel=0
pkgdesc="produces covertura xml formatted output from simplecov"
url="https://rubygems.org/gems/simplecov-cobertura"
arch="noarch"
license="Apache-2.0"
checkdepends="
	ruby-bundler
	ruby-nokogiri
	ruby-rake
	ruby-rspec
	ruby-test-unit
	"
depends="
	ruby
	ruby-rexml
	ruby-simplecov
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/jessebs/simplecov-cobertura/archive/refs/tags/v$pkgver.tar.gz
	gemspec.patch
	skip-tests-long-path.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	RUBYLIB="./lib" rake test
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	rm -r "$gemdir"/cache \
		"$gemdir"/build_info \
		"$gemdir"/doc \
		"$gemdir"/extensions
	rmdir "$gemdir"/plugins || true
}

