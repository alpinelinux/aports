# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=py3-pytest-asyncio
pkgver=1.4.0
pkgrel=0
pkgdesc="Pytest support for asyncio"
url="https://github.com/pytest-dev/pytest-asyncio"
arch="noarch"
license="Apache-2.0"
# typing-extensions: needed with python <3.13
depends="py3-pytest py3-typing-extensions"
makedepends="py3-setuptools py3-setuptools_scm py3-gpep517 py3-installer py3-wheel"
checkdepends="py3-async_generator py3-coverage py3-hypothesis py3-flaky py3-pytest-trio"
subpackages="$pkgname-pyc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pytest-dev/pytest-asyncio/archive/v$pkgver.tar.gz
	fix-test.patch"
builddir="$srcdir/pytest-asyncio-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/pytest_asyncio-*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/pytest_asyncio-*.whl
}

sha512sums="
13fda75ac4fdbd5f866e7bbc20d84a00058cb6c3a89d2d4fda4678b60ed45afa6b4b83aa4907ad64344780ea23896889a3ecea248bf148dff1d38306b6c69f4b  py3-pytest-asyncio-1.4.0.tar.gz
2a165e94294a84f79a178b9f40a1e0ba8c04d82bbb86b70c895ec2b6fa1db28084d9951b5723a95325f02632e7b0ece6bae6262e96ba607d4c763dde29659a9f  fix-test.patch
"
