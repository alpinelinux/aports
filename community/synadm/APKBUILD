pkgname=synadm
pkgver=0.49.2
pkgrel=1
pkgdesc="Command line admin tool for Synapse"
url="https://synadm.readthedocs.io/"
arch="noarch"
license="GPL-3.0-or-later"
depends="py3-tabulate py3-click py3-requests py3-yaml py3-click-option-group py3-dnspython"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/synadm/synadm/archive/v$pkgver.tar.gz"
options="!check" #no check provided
subpackages="$pkgname-pyc"
builddir="$srcdir"/"$pkgname"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
