# Maintainer: Thomas Liske <thomas@fiasko-nw.net>
pkgname=ifstate
pkgver=2.5.1
pkgrel=0
pkgdesc="Manage host interface settings in a declarative manner"
url="https://ifstate.net/"
arch="noarch"
license="GPL-3.0-or-later"
depends="iproute2
	python3
	py3-jsonschema
	py3-libifstate_rs
	py3-pyroute2
	py3-setproctitle
	py3-yaml"
makedepends="py3-gpep517 py3-setuptools py3-uv-build py3-wheel"
options="!check" # no tests available
source="https://files.pythonhosted.org/packages/source/i/ifstate/ifstate-$pkgver.tar.gz
	ifstate.conf
	ifstate.initd
	"
install="$pkgname.post-upgrade"
subpackages="$pkgname-openrc $pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
	install -Dm755 "$srcdir"/ifstate.conf "$pkgdir"/etc/modprobe.d/ifstate.conf
	install -Dm755 "$srcdir"/ifstate.initd "$pkgdir"/etc/init.d/ifstate
}

sha512sums="
