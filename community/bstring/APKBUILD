# Maintainer: Daniel Markstedt <daniel@mindani.net>
pkgname=bstring
pkgver=1.1.1
pkgrel=0
pkgdesc="The Better String Library for C"
url="https://mike.steinert.ca/bstring/"
arch="all"
license="BSD-3-Clause"
makedepends="check check-dev meson ninja"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/msteinert/bstring/archive/refs/tags/v$pkgver.tar.gz"

build() {
	abuild-meson \
		-Denable-fuzzing=false \
		-Denable-old-api=false \
		-Denable-tests=true \
		-Denable-utf8=true \
		. build
	meson compile -C build
}

check() {
	meson test -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
}

sha512sums="
ad4d6f08b36e9e431a42a465659d09783abefd20bd377c6bcb1fd19cc29c8960bfdee363865f769c80fd72c586347e7b842b115fa2101baa030cb86b001f21db  bstring-1.1.1.tar.gz
"
