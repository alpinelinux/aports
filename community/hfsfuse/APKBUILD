# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=hfsfuse
pkgver=0.469
pkgrel=0
pkgdesc="FUSE driver for HFS+ filesystems"
url="https://github.com/0x09/hfsfuse"
arch="all !s390x" # blocked by lzfse
license="MIT BSD-2-Clause"
makedepends="
	fuse3-dev
	linux-headers
	lzfse
	lzfse-dev
	utf8proc-dev
	zlib-dev
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/0x09/hfsfuse/archive/refs/tags/$pkgver.tar.gz
	use-standard-u16-type.patch
	"
options="!check"  # no tests provided

prepare() {
	default_prepare

	rm -rf lib/utf8proc
}

build() {
	make WITH_LZFSE=system WITH_UBILIO=local WITH_UTF8PROC=system
}

package() {
	mkdir -p "$pkgdir"/usr/bin
	make install PREFIX="$pkgdir/usr" WITH_LZFSE=system WITH_UBILIO=local WITH_UTF8PROC=system
}

