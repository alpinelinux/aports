# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=bombadillo
pkgver=2.4.0
pkgrel=39
pkgdesc="Non-web (gopher, gemini, finger) browser for the terminal"
url="https://bombadillo.colorfield.space/"
license="GPL-3.0-or-later"
arch="all"
makedepends="go"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver-1.tar.gz::https://tildegit.org/sloum/bombadillo/archive/$pkgver.tar.gz"
options="net" # go mods
builddir="$srcdir/bombadillo"

export GOFLAGS="$GOFLAGS -trimpath -modcacherw"

build() {
	make build
}

check() {
	go test ./...
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/bombadillo/LICENSE
}

