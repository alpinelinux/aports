maintainer="Michał Polański <michal@polanski.me>"
pkgname=dua
pkgver=3.0.0
pkgrel=0
pkgdesc="Tool to conveniently learn about the usage of disk space"
url="https://github.com/Byron/dua-cli"
license="MIT"
arch="all"
makedepends="cargo cargo-auditable"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/Byron/dua-cli/archive/v$pkgver/dua-$pkgver.tar.gz
	rustix-1.1.5.patch
	"
builddir="$srcdir/dua-cli-$pkgver"
options="net" # fetch dependencies

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release

	target/release/dua completions bash >$pkgname.bash
	target/release/dua completions fish >$pkgname.fish
	target/release/dua completions zsh >$pkgname.zsh
}

check() {
	cargo test --frozen -- --skip "interactive"
}

package() {
	install -Dm755 target/release/$pkgname -t "$pkgdir"/usr/bin/

	install -Dm644 $pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 $pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 $pkgname.zsh "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

sha512sums="
880a6fc92248214d32120a33f8edfe180e8cd5c25cbf16288f44b402a0a099c5775021ae0359e9c47ae633c48a0cbda2d11440cff1ecddaf79fc945dce673676  dua-3.0.0.tar.gz
93c1dc9acf9cc09cd0c5678455cbce15a097b3b3d10c9985a0e0df0c894f6da9c4dba16451d13bf0eb6775a35bbc20f57e80d20a8499f1f21cb072bc3f9e7adc  rustix-1.1.5.patch
"
