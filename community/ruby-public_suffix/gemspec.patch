Fix gemspec for building from a source tarball: git is not available,
so do not use `git ls-files`.

--- a/public_suffix.gemspec
+++ b/public_suffix.gemspec
@@ -23,22 +23,7 @@
     "funding_uri" => "https://github.com/sponsors/weppos",
   }
 
-  s.files = Dir.chdir(__dir__) do
-    `git ls-files -z`.split("\x0").reject do |f|
-      (File.expand_path(f) == __FILE__) ||
-        f.start_with?(*%w[
-          bin/
-          test/
-          .git
-          .rubocop
-          Rakefile
-          AGENTS.md
-          CLAUDE.md
-          RELEASING.md
-          CONTRIBUTING.md
-      ])
-    end
-  end
+  s.files         = Dir["data/**/*", "lib/**/*"]
   s.require_paths = ["lib"]
   s.extra_rdoc_files = %w( LICENSE.txt )
 end
