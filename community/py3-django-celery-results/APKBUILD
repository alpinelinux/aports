0b53fde4370efe09c32e99a955755ea3c5421bcec7852263b0068ca03381b24ce0dffc4c0da7b39786495657f40941d780e751010d45894cb00a4fe8a944fec6  067dfc9-fix-testdatabase-attribute-error-on-ignore-result-with-celery-5x.patch
"
