From 6c7ea9e1c08999ab7e8072b5584a0e087c213bc1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jan-Otto=20Kr=C3=B6pke?= <mail@jkroepke.de>
Date: Fri, 23 Oct 2026 19:03:15 +0200
Subject: [PATCH] OLE2: fix reading empty streams.

Since fbe366e an empty stream stored in small blocks fails to open
with "Insufficient memory" because g_try_new returns NULL for a
zero-size buffer.  A file whose only small streams are empty has no
small block file at all, so opening those failed with "Failed to
access child".  An empty stream has nothing to read, so return it
right away.
---
 NEWS                   |  3 ++
 gsf/gsf-infile-msole.c |  6 ++++
 tests/test-ole.c       | 73 ++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 82 insertions(+)

diff --git a/NEWS b/NEWS
index a4e458c..b17c9d2 100644
--- a/NEWS
+++ b/NEWS
@@ -3,6 +3,9 @@ libgsf 1.14.61
 Morten:
 	* Deal with newer compiler warnings.
 
+Jan-Otto:
+	* Fix reading empty OLE2 streams.
+
 --------------------------------------------------------------------------
 libgsf 1.14.60
 
diff --git a/gsf/gsf-infile-msole.c b/gsf/gsf-infile-msole.c
index c9df5c0..5a175ce 100644
--- a/gsf/gsf-infile-msole.c
+++ b/gsf/gsf-infile-msole.c
@@ -902,6 +902,12 @@ gsf_infile_msole_new_child (GsfInfileMSOle *parent,
 			gsf_input_set_size (GSF_INPUT (child), 0);
 			return GSF_INPUT (child);
 		}
+
+		/* An empty stream has nothing to read, and the file may
+		 * not even have a small block file if all its small
+		 * streams are empty.  */
+		if (dirent->size == 0)
+			return GSF_INPUT (child);
 	}
 
 	info = parent->info;
diff --git a/tests/test-ole.c b/tests/test-ole.c
index fdf6745..e0ddae9 100644
--- a/tests/test-ole.c
+++ b/tests/test-ole.c
@@ -45,6 +45,11 @@ test_write_streams (GsfOutfile *outfile)
 	gsf_output_close (child);
 	g_object_unref (child);
 
+	child = gsf_outfile_new_child (outfile, "Empty", FALSE);
+	if (!child) return FALSE;
+	gsf_output_close (child);
+	g_object_unref (child);
+
 	/* Summary Information */
 	child = gsf_outfile_new_child (outfile, "\005SummaryInformation", FALSE);
 	if (!child) return FALSE;
@@ -138,6 +143,14 @@ test_read_streams (GsfInfile *infile)
 	if (memcmp (buf, data2, size) != 0) return FALSE;
 	g_object_unref (child);
 
+	child = gsf_infile_child_by_name (infile, "Empty");
+	if (!child) {
+		g_printerr ("Empty not found\n");
+		return FALSE;
+	}
+	if (gsf_input_size (child) != 0) return FALSE;
+	g_object_unref (child);
+
 	/* Summary Information */
 	child = gsf_infile_child_by_name (infile, "\005SummaryInformation");
 	if (!child) {
@@ -269,6 +282,61 @@ test_read_by_index (GsfInfile *infile, int num_extra)
 	return TRUE;
 }
 
+/* An archive whose only stream is empty has no small block file.  */
+static gboolean
+test_empty_only (const char *filename)
+{
+	GsfOutput  *output;
+	GsfOutfile *outfile;
+	GsfOutput  *child;
+	GsfInput   *input;
+	GsfInfile  *infile;
+	GsfInput   *empty;
+	GError     *err = NULL;
+	gboolean    ok;
+
+	g_print ("Testing archive with only an empty stream\n");
+
+	output = gsf_output_stdio_new (filename, &err);
+	if (!output) {
+		g_printerr ("Failed to create output: %s\n", err->message);
+		g_error_free (err);
+		return FALSE;
+	}
+	outfile = gsf_outfile_msole_new (output);
+	g_object_unref (output);
+	child = gsf_outfile_new_child (outfile, "Empty", FALSE);
+	if (!child) return FALSE;
+	gsf_output_close (child);
+	g_object_unref (child);
+	if (!gsf_output_close (GSF_OUTPUT (outfile))) return FALSE;
+	g_object_unref (outfile);
+
+	input = gsf_input_stdio_new (filename, &err);
+	if (!input) {
+		g_printerr ("Failed to open input: %s\n", err->message);
+		g_error_free (err);
+		return FALSE;
+	}
+	infile = gsf_infile_msole_new (input, &err);
+	g_object_unref (input);
+	if (!infile) {
+		g_printerr ("Failed to open OLE infile: %s\n", err ? err->message : "unknown error");
+		if (err) g_error_free (err);
+		return FALSE;
+	}
+
+	empty = gsf_infile_child_by_index (infile, 0);
+	ok = empty != NULL && gsf_input_size (empty) == 0;
+	if (!ok)
+		g_printerr ("Empty stream did not open\n");
+	if (empty)
+		g_object_unref (empty);
+	g_object_unref (infile);
+
+	return ok;
+}
+
 static int
 test (int argc, char *argv[])
 {
@@ -346,6 +414,11 @@ test (int argc, char *argv[])
 	g_object_unref (infile);
 	g_object_unref (input);
 
+	if (!test_empty_only (filename)) {
+		g_printerr ("Failed to read archive with only an empty stream\n");
+		return 1;
+	}
+
 	g_print ("OLE read/write test passed\n");
 	return 0;
 }
