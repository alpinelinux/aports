# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=ckermit
pkgver=11.0.506
pkgrel=0
pkgdesc="Portable scriptable network and serial communication software"
url="https://www.openkermit.org/"
arch="all"
license="BSD-3-Clause"
makedepends="ncurses-dev openssl-dev zlib-dev linux-headers linux-pam-dev"
checkdepends="check-dev py3-pytest py3-pytest-xdist py3-pytest-timeout py3-pyftpdlib"
case "$CARCH" in
# riscv64: test timeout
# aarch64, arm*: network timeout issue on builders
aarch64|arm*|riscv64) options="!check" ;;
esac
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/OpenKermit/ckermit/archive/refs/tags/v$pkgver.tar.gz"

build() {
	make linux+ssl
}

check() {
	make check
	pytest
}

package() {
	install -Dm644 COPYING.TXT "$pkgdir"/usr/share/licenses/$pkgname/COPYING.TXT
	install -Dm644 ckuker.nr "$pkgdir"/usr/share/man/man1/ckermit.1

	install -Dm755 wermit "$pkgdir"/usr/bin/ckermit
	echo "#!/usr/bin/ckermit" > _tmp.ini
	cat ckermit.ini >> _tmp.ini
	install -m755 _tmp.ini "$pkgdir"/usr/bin/ckermit.ini
}
sha512sums="
f8e98b2e753db291cd4c914edca392db1ee951dd37201c4123df8e6ac0229a30e29a62eedc15e39f9a07c015aab87507fb84cd588f541bea0a64b940c939c9c5  ckermit-11.0.506.tar.gz
"
