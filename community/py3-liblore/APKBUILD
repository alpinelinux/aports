maintainer="Artur Weber <alpine@uart.sh>"
pkgname=py3-liblore
pkgver=0.8.2
pkgrel=0
pkgdesc="Python library for working with public-inbox servers"
url="https://git.kernel.org/pub/scm/utils/liblore/liblore.git"
arch="noarch"
license="GPL-2.0-or-later"
depends="py3-requests"
makedepends="py3-gpep517 py3-setuptools"
checkdepends="py3-authheaders py3-pytest py3-pytest-asyncio py3-responses"
subpackages="$pkgname-pyc"
source="https://git.kernel.org/pub/scm/utils/liblore/liblore.git/snapshot/liblore-$pkgver.tar.gz"
builddir="$srcdir/liblore-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
