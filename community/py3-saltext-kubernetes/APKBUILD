# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-saltext-kubernetes
_pkgname=saltext_kubernetes
pkgver=3.0.0
pkgrel=0
pkgdesc="Salt Extension for interacting with Kubernetes"
url="https://pypi.org/project/saltext.kubernetes/"
arch="noarch"
license="Apache-2.0"
depends="py3-kubernetes"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # checks require a saltstack environment

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
e8913f8eb93458330b452f9db615128d7a3c276b465986b11816169e5afeda77ee410dff5c0108526ea948819953e72996e52715994984978b7a30c581ed6db6  saltext_kubernetes-3.0.0.tar.gz
"
