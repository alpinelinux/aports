pkgname=ginac
pkgver=1.8.10
pkgrel=0
pkgdesc="C++ library for symbolic computations"
url="https://www.ginac.de/"
arch="all"
license="GPL-2.0-or-later"
makedepends="cmake cln-dev flex bison readline-dev python3 texinfo samurai"
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/ginac/ginac/archive/release_${pkgver//./-}.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	CXXFLAGS="${CXXFLAGS//-Os/-O2} -flto=auto" \
	CFLAGS="${CFLAGS//-Os/-O2} -flto=auto" \
	cmake3.5 -B build -G Ninja -Wno-dev \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_PREFIX_PATH=/usr \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build --target all test_suite
}

check() {
	ctest --test-dir build \
		-E "exam_Gt|time_Gt"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
41a1bbfc48f607a187cf9a36587b13ec4c98e774e8826f4664a0bbf38248eab6f2a593c06cf3b87a2873a51dfc5f4b727eb04f75e079bf0e9fd065cdb740a110  ginac-1.8.10-1.tar.gz
"
