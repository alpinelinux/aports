# Maintainer: François Chavant <alpine@mail.chavant.info>
pkgname=keychain
pkgver=3.0.8
pkgrel=0
pkgdesc="Lean manager for long-running ssh-agent and gpg-agent sessions"
url="https://kernel-seeds.org/projects/keychain/"
arch="noarch"
license="GPL-2.0-only"
depends="procps-ng python3"
makedepends="perl python3-dev"
checkdepends="openssh-client-common py3-build py3-pytest py3-setuptools py3-wheel"
source="$pkgname-$pkgver.tar.gz::https://github.com/danielrobbins/keychain/archive/refs/tags/$pkgver.tar.gz"

build() {
	make
}

check() {
	python3 -m venv --clear --system-site-packages testenv
	testenv/bin/python3 -m pip install -e .
	testenv/bin/python3 -m pytest
}

package() {
	install -Dm755 keychain.pyz "$pkgdir/usr/bin/keychain"
}

sha512sums="
2c7841b1a615fc61e9fb03957c0ed0b14f63d142062eec630712ea8e1a89d83f8519412eb860df8c439d477e273a9868fed829192c99d89271f69fbf904fbad0  keychain-3.0.8.tar.gz
"
