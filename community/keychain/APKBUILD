# Maintainer: François Chavant <alpine@mail.chavant.info>
pkgname=keychain
pkgver=3.0.4
pkgrel=0
pkgdesc="Lean manager for long-running ssh-agent and gpg-agent sessions"
url="https://kernel-seeds.org/projects/keychain/"
arch="noarch"
license="GPL-2.0-only"
depends="procps-ng python3"
makedepends="perl python3-dev"
checkdepends="py3-pytest openssh-client-common"
source="$pkgname-$pkgver.tar.gz::https://github.com/danielrobbins/keychain/archive/refs/tags/$pkgver.tar.gz"

build() {
	make
}

check() {
	case "$CARCH" in
	aarch64|loongarch64|riscv64|x86_64)
		_deselect_test='not test_reboot_stale_socket_is_replaced_when_pid_was_reused'
		;;
	esac

	python3 -m venv --clear --system-site-packages testenv
	testenv/bin/python3 -m pip install -e .
	testenv/bin/python3 -m pytest -k "$_deselect_test"
}

package() {
	install -Dm755 keychain.pyz "$pkgdir/usr/bin/keychain"
}

sha512sums="
dc1449f071b220897ea0b04ab44f7d1cc9616b8788ca2b1b6627d26d70d4a29373e45eb910dc9030b3176bff1bcd71fe9e9d3e881dab26e1ce8d1c201f3bf3ca  keychain-3.0.4.tar.gz
"
