8fd42193ee5e1ec6d315867ed3dd5f8083a504ef4a434fa701343686793a7d9c3aaa834b9a679edf3cf24c82d5dfb0826c92318edb0fce9c669b645867d9f0a8  rustix-1.1.5.patch
