maintainer="Michał Polański <michal@polanski.me>"
pkgname=hcloud
pkgver=1.70.2
pkgrel=0
pkgdesc="Command-line interface for Hetzner Cloud"
url="https://github.com/hetznercloud/cli"
license="MIT"
arch="all"
makedepends="go"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/hetznercloud/cli/archive/v$pkgver/hcloud-$pkgver.tar.gz
	x-sys-ppc64le-pie-fix.patch
	"
builddir="$srcdir/cli-$pkgver"
options="net" # Go modules

build() {
	go build \
		-trimpath \
		-ldflags "\
			-X github.com/hetznercloud/cli/internal/version.Version=$pkgver \
			-X github.com/hetznercloud/cli/internal/version.versionPrerelease= \
			" \
		-v \
		./cmd/hcloud

	./hcloud completion bash >$pkgname.bash
	./hcloud completion fish >$pkgname.fish
	./hcloud completion zsh >$pkgname.zsh
}

check() {
	go test ./...
}

package() {
	install -Dm755 hcloud -t "$pkgdir"/usr/bin/

	install -Dm644 $pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 $pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 $pkgname.zsh "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

sha512sums="
68b55a533c1e97818c9f4f1ed3cf20f9e531b6af8e7cbf928846f5737e39bec81ca9333bf2c3b3a82bd057e06b1fc4c6fdfae5c98c2b419eb5c5b52f537d1b9d  hcloud-1.70.2.tar.gz
ae79948e48f7736be932165fbb0090421cab55ebbeb42cb809e0ffb994f75b1a163444f201d83c2e621dc248ce86f8dd599817ed6535e8c9213c37f30ea8bdfa  x-sys-ppc64le-pie-fix.patch
"
