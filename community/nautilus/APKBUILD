# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/gnome <achill@achill.org>"
pkgname=nautilus
pkgver=51.0.1
pkgrel=0
pkgdesc="GNOME file manager"
url="https://apps.gnome.org/Nautilus"
arch="all"
license="GPL-2.0-or-later"
depends="
	desktop-file-utils
	gsettings-desktop-schemas
	localsearch
	"
depends_dev="
	gnome-autoar-dev
	gnome-desktop-dev
	"
makedepends="
	$depends_dev
	libselinux-dev
	blueprint-compiler
	docbook-xml
	docbook-xsl
	gexiv2-0.16-dev
	gst-plugins-base-dev
	itstool
	jpeg-dev
	libadwaita-dev
	libcloudproviders-dev
	libexif-dev
	libglycin-gtk4-dev
	libportal-dev
	librsvg-dev
	libseccomp-dev
	libxml2-dev
	libxml2-utils
	libxslt
	meson
	tiff-dev
	tinysparql-dev
	"
checkdepends="bash dbus appstream-glib py3-gobject3 xwayland-run"
subpackages="$pkgname-dev $pkgname-lang"
source="https://download.gnome.org/sources/nautilus/${pkgver%%.*}/nautilus-$pkgver.tar.xz"
options="!check" # fails in rootbld

if [ "$CARCH" = "armhf" ]; then
	options="!check" # one test fails on armhf
fi

# secfixes:
#   3.32.1-r0:
#     - CVE-2019-11461

build() {
	abuild-meson \
		-Db_lto=true \
		-Dtests=headless \
		-Dselinux=enabled \
		. output
	meson compile -C output
}

check() {
	XDG_RUNTIME_DIR="$(mktemp -d -p "$builddir")" \
	wlheadless-run -- \
	dbus-run-session -- \
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
d6b6d2a39f60caf9d786ac9bc30acf6ec7647ddb12be712776656255d24172850f8fd0e81915cda91a719e4f7a80168e08bbf45855a2d606009961d35917b4d1  nautilus-51.0.1.tar.xz
"
