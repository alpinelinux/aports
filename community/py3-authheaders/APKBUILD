maintainer="Artur Weber <alpine@uart.sh>"
pkgname=py3-authheaders
pkgver=0.16.3
pkgrel=0
pkgdesc="A library wrapping email authentication header verification and generation"
url="https://github.com/ValiMail/authentication-headers"
arch="noarch"
license="MPL-2.0"
depends="py3-authres py3-dkimpy py3-dnspython py3-publicsuffix2"
makedepends="py3-gpep517 py3-setuptools"
subpackages="$pkgname-pyc"
source="https://github.com/ValiMail/authentication-headers/releases/download/$pkgver/authheaders-$pkgver.tar.gz"
builddir="$srcdir/authheaders-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 authheaders/test/test_authentication.py
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
94741ec6127aa20b128958ba5b386b63d00f27ae68fe6b5ede3a0308bd6a75a9b940fb40b6066b65fefb07e40e85cb412bd59fde6c76f60099d6bf6872ae9a68  authheaders-0.16.3.tar.gz
"
