# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=mangowm
pkgver=0.18.5
pkgrel=0
pkgdesc="Lightweight, high-performance Wayland compositor built on dwl"
arch="all"
url="https://mangowm.github.io/"
license="GPL-3.0-or-later"
makedepends="muon
	cjson-dev
	pango-dev
	pcre2-dev
	scenefx-dev
	wlroots0.20-dev
	wayland-protocols
	"
install="$pkgname.post-upgrade"
subpackages="$pkgname-doc $pkgname-systemd"
source="$pkgname-$pkgver.tar.gz::https://github.com/mangowm/mango/archive/refs/tags/$pkgver.tar.gz
	$pkgname-mck-$pkgver.sh::https://github.com/user-attachments/files/33058895/migrate-config-keys.sh
	"
builddir="$srcdir/mango-$pkgver"

build() {
	abuild-muon output .
	ninja -C output
}

check() {
	./output/mango -v
}

package() {
	DESTDIR="$pkgdir" muon -C output install
	provides="mangowc=$pkgver-r$pkgrel" # renamed with the 0.14.0 upgrade

	# 0.18 config migration helper script
	install -Dm755 "$srcdir/$pkgname-mck-$pkgver.sh" \
		"$pkgdir"/usr/share/"$pkgname"/migrate-config-keys.bash

	install -dm755 "$pkgdir"/usr/share/doc/"$pkgname"/
	mv docs/* "$pkgdir"/usr/share/doc/"$pkgname"/
}

sha512sums="
9831b4c27be18a8db75330703e089b577d1753b8b68ca4bc9b327310011d5bbb7e8d3fa696d4ce3004f5a1104f8608b64e191e01dbb7ada5aba48f88ecd47ad8  mangowm-0.18.5.tar.gz
0631b1f1aba138220e79e007f7e17c9339057bd27354ab7488086d38f30a6d6fd4e19131f531526d4681ab3a60b202c07c1da09f1a4d5efca3094ff65f38e930  mangowm-mck-0.18.5.sh
"
