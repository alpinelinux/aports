# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=mangowm
pkgver=0.17.4
pkgrel=0
pkgdesc="Lightweight, high-performance Wayland compositor built on dwl"
arch="all"
url="https://mangowm.github.io/"
license="GPL-3.0-or-later"
makedepends="muon
	cjson-dev
	pango-dev
	pcre2-dev
	scenefx-dev
	wlroots0.20-dev
	wayland-protocols
	"
subpackages="$pkgname-doc $pkgname-systemd"
source="$pkgname-$pkgver.tar.gz::https://github.com/mangowm/mango/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/mango-$pkgver"

build() {
	abuild-muon output .
	ninja -C output
}

check() {
	./output/mango -v
}

package() {
	DESTDIR="$pkgdir" muon -C output install
	provides="mangowc=$pkgver-r$pkgrel"

	install -dm755 "$pkgdir"/usr/share/doc/"$pkgname"/
	mv docs/* "$pkgdir"/usr/share/doc/"$pkgname"/
}

sha512sums="
be12e50da06d8b6c3313689b1ee7bd15ae0dc1f870cbea61a6736950ffa14fda6c25ad3b2aec7aaf0d6d8271954cb8524701587a4f55f3dddaf5a29ed22d0326  mangowm-0.17.4.tar.gz
"
