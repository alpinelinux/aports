#!/bin/sh

ver_old="$2"

if [ "$(apk version -t "$ver_old" '0.18.1-r0')" = '<' ]; then
	cat >&2 <<-EOF
	*
	* Breaking config change upgrading from older than 0.18.x releases
	*
	* "To make the configuration format appear more regular, some configuration
	* keys have now been renamed/duplicated. Please use the following script to
	* migrate them globally."
	*
	*   cd ~/.config/mango
	*   /usr/share/mangowm/migrate-config-keys.bash
	*
	EOF
fi
