# Maintainer: Rabindra Dhakal <contact@qaidvoid.dev>
pkgname=zls
pkgver=0.17.0
pkgrel=0
_knownfolders=6da0d0c41b78b9ed2d34fa364fcb81b5ebece6c4
_diffz=aac8aa99c436ab8277b0711922aad062c0167b12
_lspkit=3e1058db66079911fdde82f833fdce6856e0a706
_tracy=0.14.1
pkgdesc="Zig Language Server"
url="https://github.com/zigtools/zls"
arch="aarch64 x86_64" # Limited by zig
license="MIT"
depends="zig"
if [ -z "$_commit" ]; then
	source="https://github.com/zigtools/zls/archive/refs/tags/$pkgver/zls-$pkgver.tar.gz"
else
	source="https://github.com/zigtools/zls/archive/$_commit/zls-$_commit.tar.gz"
	builddir="$srcdir/zls-$_commit"
fi
source="$source
	https://github.com/ziglibs/known-folders/archive/$_knownfolders/known-folders-$_knownfolders.tar.gz
	https://github.com/ziglibs/diffz/archive/$_diffz/diffz-$_diffz.tar.gz
	https://github.com/zigtools/lsp-kit/archive/$_lspkit/lsp-kit-$_lspkit.tar.gz
	https://github.com/wolfpld/tracy/archive/refs/tags/v$_tracy/tracy-$_tracy.tar.gz
	"

_pkgver="$pkgver"
case "$pkgver" in
	*_pre*|*_rc*|*_alpha*|*_beta*) _pkgver="${_pkgver/_/-}" ;;
	*_git*|*_p*) _pkgver="${_pkgver/_/+}" ;;
esac

export ZIG_GLOBAL_CACHE_DIR="$srcdir"/cache

prepare() {
	default_prepare

	mkdir -p "$srcdir"/cache/p
	mv "$srcdir"/known-folders-$_knownfolders "$srcdir"/cache/p/known_folders-0.0.0-Fy-PJiDLAAB98m3uYUzatrTb2mO2fpvwx2zpSroEtfbO
	mv "$srcdir"/diffz-$_diffz "$srcdir"/cache/p/diffz-0.0.1-G2tlISvOAQDORzPTSxDgiKwlHuADKeJMdJrw4kRfLufj
	mv "$srcdir"/lsp-kit-$_lspkit "$srcdir"/cache/p/lsp_kit-0.1.0-bi_PL9o2DADHS1PDra3MGz1MXnsboN_ewNvrc419z7Fb
	mv "$srcdir"/tracy-$_tracy "$srcdir"/cache/p/N-V-__8AAAZPdAGoNF3-tqKYHjTOa5QQ02rEWNvkDr-Vpl0C
}

build() {
	zig build \
		-Dcpu=baseline \
		-Doptimize=ReleaseSafe \
		-Dversion-string="$_pkgver" \
		-Duse-llvm=true \
		-Dpie=true
}

check() {
	zig build test \
		-Dcpu=baseline \
		-Dversion-string="$_pkgver" \
		-Duse-llvm=true \
		-Dpie=true
}

package() {
	install -Dm755 zig-out/bin/zls -t "$pkgdir"/usr/bin/
}

