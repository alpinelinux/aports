pkgname=py3-feedparser
pkgver=6.0.14
pkgrel=0
_pkgname=feedparser
pkgdesc="Python3 feed parser for RSS and Atom"
options="!check" # Tests are py2 only
url="https://github.com/kurtmckee/feedparser"
arch="noarch"
license="BSD-2-Clause"
depends="py3-sgmllib3k"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir"/$_pkgname-$pkgver

replaces="py-feedparser" # Backwards compatibility
provides="py-feedparser=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
2c19ce5aaae41090f452f6edadae9beac1b627b8ac47080f014f7efd6fa02b3fa944ff7a5ee999f1da76bab59ace742b0d2343036a44ce8f0b6eaa2ded2961b2  feedparser-6.0.14.tar.gz
"
