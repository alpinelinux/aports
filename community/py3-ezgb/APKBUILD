maintainer="Artur Weber <alpine@uart.sh>"
pkgname=py3-ezgb
pkgver=0.2.0
pkgrel=0
pkgdesc="Standalone Python library for working with git-bug repositories"
url="https://git.kernel.org/pub/scm/utils/ezgb/ezgb.git/"
arch="noarch"
license="GPL-2.0-or-later"
depends="py3-pygit2"
makedepends="py3-gpep517 py3-setuptools"
# TODO: add git-bug to checkdepends once it gets moved to community
checkdepends="git py3-pytest"
subpackages="$pkgname-pyc"
source="https://git.kernel.org/pub/scm/utils/ezgb/ezgb.git/snapshot/ezgb-$pkgver.tar.gz"
builddir="$srcdir/ezgb-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
a0076abc1ec65d51db9b1252d0ff74810637e06f76449d55db256b33ccd80e95d6087065da7893a4c3ac9f7cabab56942aa29796b4df6a41fe70d0bd9ec5ce52  ezgb-0.2.0.tar.gz
"
