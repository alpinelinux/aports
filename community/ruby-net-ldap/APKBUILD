# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-net-ldap
_gemname=net-ldap
pkgver=0.21.0
pkgrel=0
pkgdesc="Pure Ruby LDAP library"
url="https://github.com/ruby-ldap/ruby-net-ldap"
arch="noarch"
license="MIT"
depends="
	ruby
	ruby-base64
	ruby-ostruct
	"
checkdepends="
	ruby-bundler
	ruby-dev
	"
source="https://github.com/ruby-ldap/$pkgname/archive/v$pkgver/$pkgname-$pkgver.tar.gz
	gemspec.patch
	"
options="net"  # fetching dependencies in check()

build() {
	gem build $_gemname.gemspec
}

check() {
	local gemhome="$(pwd)/.gems"

	# TODO: Install from aports after we create aport for flexmock.
	# Don't export GEM_HOME, gem install --build-root in package() would use it.
	GEM_HOME="$gemhome" bundle install

	# XXX: This test is probably broken.
	GEM_HOME="$gemhome" TESTOPTS="--ignore-testcase=/^TestSSLBER$/" \
		"$gemhome"/bin/rake test
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files and empty directories.
	cd "$gemdir"
	rm -r cache build_info doc extensions
	rmdir plugins || true
}

