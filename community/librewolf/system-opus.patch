From 8404eca600f6aa5ce38af76cbce7eb65257fe86b Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Wed, 11 Nov 2026 23:38:42 +0100
Subject: [PATCH] Implement --with-system-opus

Downstream distributions prefer using system libraries instead of
compiling and linking a second copy for each application.

Add a --with-system-opus flag to enable compiling with the system Opus.
---
 config/external/gkcodecs/gkcodecs.symbols |  2 ++
 config/external/gkcodecs/moz.build        |  2 ++
 config/external/moz.build                 |  4 ++-
 media/ffvpx/libavcodec/moz.build          |  8 +++++-
 toolkit/library/moz.build                 |  3 ++
 toolkit/moz.configure                     | 35 +++++++++++++++++++++++
 6 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/config/external/gkcodecs/gkcodecs.symbols b/config/external/gkcodecs/gkcodecs.symbols
index df93d763dd35..04a084ef6e38 100644
--- a/config/external/gkcodecs/gkcodecs.symbols
+++ b/config/external/gkcodecs/gkcodecs.symbols
@@ -79,6 +79,7 @@ ogg_sync_pageseek
 ogg_sync_reset
 ogg_sync_wrote
 # libopus symbols
+#ifndef MOZ_SYSTEM_OPUS
 opus_decode
 opus_decoder_create
 opus_decoder_ctl
@@ -106,6 +107,7 @@ opus_packet_parse
 opus_strerror
 opus_multistream_encode_float
 opus_multistream_surround_encoder_create
+#endif
 vorbis_block_clear
 vorbis_block_init
 vorbis_comment_clear
diff --git a/config/external/gkcodecs/moz.build b/config/external/gkcodecs/moz.build
index 34019e81cebb..7e60fa4a24eb 100644
--- a/config/external/gkcodecs/moz.build
+++ b/config/external/gkcodecs/moz.build
@@ -16,3 +16,5 @@ if CONFIG["MOZ_SYSTEM_AV1"]:
     DEFINES["MOZ_SYSTEM_AV1"] = True
 if CONFIG["MOZ_SYSTEM_LIBVPX"]:
     DEFINES["MOZ_SYSTEM_LIBVPX"] = True
+if CONFIG["MOZ_SYSTEM_OPUS"]:
+    DEFINES["MOZ_SYSTEM_OPUS"] = True
diff --git a/config/external/moz.build b/config/external/moz.build
index 961353353255..5bde984103cd 100644
--- a/config/external/moz.build
+++ b/config/external/moz.build
@@ -41,6 +41,9 @@ if CONFIG["MOZ_VORBIS"]:
 if not CONFIG["MOZ_SYSTEM_LIBVPX"]:
     external_dirs += ["media/libvpx"]
 
+if not CONFIG["MOZ_SYSTEM_OPUS"]:
+    external_dirs += ["media/libopus"]
+
 if not CONFIG["MOZ_SYSTEM_AV1"]:
     external_dirs += ["media/libaom"]
     external_dirs += ["media/libdav1d"]
@@ -58,7 +61,6 @@ external_dirs += [
     "media/libmkv",
     "media/libnestegg",
     "media/libogg",
-    "media/libopus",
     "media/libspeex_resampler",
     "media/libsoundtouch",
     "media/mp4parse-rust",
diff --git a/media/ffvpx/libavcodec/moz.build b/media/ffvpx/libavcodec/moz.build
index 9153f6a16c6f..a311462d3a26 100644
--- a/media/ffvpx/libavcodec/moz.build
+++ b/media/ffvpx/libavcodec/moz.build
@@ -185,10 +185,16 @@ if CONFIG["MOZ_WIDGET_TOOLKIT"] == "android":
     ]
 
 LOCAL_INCLUDES += [
-    '/media/libopus/include',
     '/media/libvorbis',
 ]
 
+if CONFIG["MOZ_SYSTEM_OPUS"]:
+    CFLAGS += CONFIG["MOZ_OPUS_CFLAGS"]
+    CXXFLAGS += CONFIG["MOZ_OPUS_CFLAGS"]
+    OS_LIBS += CONFIG["MOZ_OPUS_LIBS"]
+else:
+    LOCAL_INCLUDES += ['/media/libopus/include']
+
 if not CONFIG["MOZ_SYSTEM_LIBVPX"]:
   LOCAL_INCLUDES += ['/media/libvpx']
 else:
diff --git a/toolkit/library/moz.build b/toolkit/library/moz.build
index 671c32b2d8e2..a5465f7bf03e 100644
--- a/toolkit/library/moz.build
+++ b/toolkit/library/moz.build
@@ -300,6 +300,9 @@ if CONFIG["MOZ_SYSTEM_LIBEVENT"]:
 if CONFIG["MOZ_SYSTEM_LIBVPX"]:
     OS_LIBS += CONFIG["MOZ_LIBVPX_LIBS"]
 
+if CONFIG["MOZ_SYSTEM_OPUS"]:
+    OS_LIBS += CONFIG["MOZ_OPUS_LIBS"]
+
 if CONFIG["MOZ_SYSTEM_AV1"]:
     OS_LIBS += CONFIG["MOZ_SYSTEM_LIBAOM_LIBS"]
     OS_LIBS += CONFIG["MOZ_SYSTEM_LIBDAV1D_LIBS"]
diff --git a/toolkit/moz.configure b/toolkit/moz.configure
index bc3cdce65cd5..e11a2ccfd814 100644
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -2356,6 +2356,41 @@ with only_when(compile_environment):
     set_config("VPX_ASFLAGS", vpx_as_flags)
 
 
+# Opus
+# ====
+
+with only_when(compile_environment):
+    system_lib_option(
+        "--with-system-opus",
+        help="Use system libopus (located with pkg-config)",
+        when=use_pkg_config,
+    )
+
+    with only_when("--with-system-opus"):
+        opus = pkg_check_modules("MOZ_OPUS", "opus >= 1.6.1")
+
+        check_header(
+            "opus/opus.h",
+            flags=opus.cflags,
+            onerror=lambda: die(
+                "Couldn't find opus/opus.h, which is required to build "
+                "with system libopus. Use --without-system-opus to build "
+                "with in-tree libopus."
+            ),
+        )
+
+        check_symbol(
+            "opus_multistream_surround_encoder_create",
+            flags=opus.libs,
+            onerror=lambda: die(
+                "--with-system-opus requested but symbol "
+                "opus_multistream_surround_encoder_create not found"
+            ),
+        )
+
+        set_config("MOZ_SYSTEM_OPUS", True)
+
+
 # JPEG
 # ====
 
-- 
2.56.0

