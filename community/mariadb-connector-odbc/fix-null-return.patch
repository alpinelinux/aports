Fix NULL returns from my_bool callbacks.
musl defines NULL as nullptr in C++11+, which cannot be converted to
the integral my_bool type. Return 0 explicitly from these callbacks.
--- a/driver/cppmini/class/ServerSidePreparedStatement.cpp
+++ b/driver/cppmini/class/ServerSidePreparedStatement.cpp
@@ -334,7 +334,7 @@
   {
     // Assuming paramset skip is set in the indicator of 1st column
     if (bind->u.indicator && *bind->u.indicator == STMT_INDICATOR_IGNORE_ROW) {
-      return NULL;
+      return 0;
     }
     // We can't let the callback to throw - we have to intercept, as otherwise we are guaranteed to have
     // the protocol broken
@@ -366,7 +366,7 @@
     {
       return (my_bool)error;
     }
-    return NULL;
+    return 0;
   }
 
 
@@ -388,7 +388,7 @@
     {
       return (my_bool)error;
     }
-    return NULL;
+    return 0;
   }
 
 
