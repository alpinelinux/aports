# Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=py3-zeroconf
pkgver=0.153.0
pkgrel=0
pkgdesc="Python implementation of multicast DNS service discovery"
url="https://github.com/jstasiak/python-zeroconf"
arch="all"
license="LGPL-2.0-or-later"
replaces="py-zeroconf" # for backwards compatibility
provides="py-zeroconf=$pkgver-r$pkgrel" # for backwards compatibility
depends="python3 py3-ifaddr"
makedepends="
	cython
	py3-gpep517
	py3-poetry-core
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-pytest py3-pytest-cov py3-pytest-asyncio py3-pytest-codspeed"
subpackages="$pkgname-pyc"
source="python-zeroconf-$pkgver.tar.gz::https://github.com/jstasiak/python-zeroconf/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir"/python-zeroconf-$pkgver

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# needs network, doesnt work in rootbld
	.testenv/bin/python3 -m pytest \
		--deselect tests/services/test_types.py::test_integration_with_listener_ipv6 \
		--deselect "tests/test_core.py::test_open_and_close_cleanly[InterfaceChoice.Default-False]" \
		--deselect "tests/test_core.py::test_context_manager_marks_done[InterfaceChoice.Default]" \
		--deselect tests/test_core.py::test_close_multiple_times \
		--deselect "tests/test_core.py::test_default_interface_warns_when_ipv6_requested[IPVersion.All]"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
771e98b535998c0668ead8923558f0db7b65bc754f7892453346c811ece30927eb20938d828e46d3cf385cad6e9a9c5f572bf9f8a1d64a56ba18bb583c3dcc46  python-zeroconf-0.153.0.tar.gz
"
