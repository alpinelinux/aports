# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer:
pkgname=libcerf
pkgver=3.9
pkgrel=0
pkgdesc="Self-contained complex error function library"
url="https://jugit.fz-juelich.de/mlz/lib/cerf"
arch="all"
license="MIT"
makedepends="cmake perl samurai"
subpackages="
	$pkgname-dev
	$pkgname-doc
	libcerfcpp
	"
source="https://jugit.fz-juelich.de/mlz/lib/cerf/-/archive/v$pkgver/cerf-v$pkgver.tar.gz"
builddir="$srcdir/cerf-v$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

libcerfcpp() {
	pkgdesc="$pkgdesc (C++ interface)"

	amove usr/lib/libcerfcpp.so.*
}

sha512sums="
8011213f33983844f60344e556850515ac73c078b88d00cd2b6ecf82dd454cde2d425b9260914d5370ad2c3d6bac82a7d60f2bbb49ddbd5eb0748dc150d0db14  cerf-v3.9.tar.gz
"
