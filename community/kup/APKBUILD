# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kup
pkgver=6.8.3
pkgrel=0
pkgdesc="KDE bup backup software for helping people to keep up-to-date backups"
# armhf blocked by qt6-qtdeclarative -> ki18n
arch="all !armhf"
url="https://apps.kde.org/kbackup/"
license="GPL-2.0-only"
depends="rsync"
makedepends="
	extra-cmake-modules
	kconfig-dev
	kcoreaddons-dev
	kdbusaddons-dev
	ki18n-dev
	kidletime-dev
	kio-dev
	kjobwidgets-dev
	knotifications-dev
	kwidgetsaddons-dev
	libgit2-dev
	libplasma-dev
	plasma5support-dev
	qt6-qtbase-dev
	samurai
	solid-dev
	"
case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac

# strip fourth version component for source URL
case "$pkgver" in
	*.*.*.*) _pkgver="${pkgver%.*}" ;;
	*) _pkgver="$pkgver" ;;
esac

_repo_url="https://invent.kde.org/system/kup.git"
source="https://download.kde.org/$_rel/plasma/$_pkgver/kup-$pkgver.tar.xz"
options="!check" # No tests
subpackages="$pkgname-lang"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
6ce646e37f42c7bd1f0ac9e8a6355484351ec003e8cabee962f1b507fcdfa3c1ffd3865a82636b69bc7d7a8385255089f4e7850b8019f88ce3a752ffea07c5ae  kup-6.8.3.tar.xz
"
