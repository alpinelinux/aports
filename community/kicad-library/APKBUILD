b59896fa4ca1d08395658de4663db8405436e2cd9e34552629568a1556ec82d83c73f0b8471131ebdea7ae38545c3b0a932657dd521d8eadf600b351c84ba6f9  kicad-footprints-10.0.8.tar.gz
0f8f0557eab713e61e50392e3019a61ced4c0fc4f4e15679cb6c5620236dc4186065520299da8dc826c8cc7b19b709a30a238277107fc0ab779af6764d5efd3d  kicad-packages3D-10.0.8.tar.gz
"
