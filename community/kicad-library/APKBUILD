1ab7ccbdfc0d99ec68e90b8587400b5444f5cdd1a13dd379dfe260d6563f217dea5f1d1358cf1f529350d3de55f72d3641cc3b243e5e214f56599e1fb4ed4612  kicad-footprints-10.0.7.tar.gz
