# Contributor: Valery Kartel <valery.kartel@gmail.com>
# Maintainer: Fabian Affolter <fabian@affolter-engineering.ch>
pkgname=py3-pyzmq
_pkgname=pyzmq
pkgver=27.2.0
pkgrel=0
pkgdesc="Python bindings for ZeroMQ"
url="https://pypi.org/project/pyzmq"
arch="all"
license="LGPL-3.0-or-later AND BSD-3-Clause"
depends="python3 py3-tornado"
makedepends="python3-dev py3-gpep517 py3-setuptools zeromq-dev py3-scikit-build-core cython"
checkdepends="py3-pytest py3-pytest-asyncio"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/p/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

replaces=py-zmq # Backwards compatibility
provides=py-zmq=$pkgver-r$pkgrel # Backwards compatibility

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# TestPubLog random failures on ppc64le/s390x/aarch64
	PYTHONSAFEPATH=1 \
	.testenv/bin/python3 -m pytest --import-mode=importlib -v -k 'not TestPubLog' \
		--deselect tests/test_asyncio.py::test_process_teardown \
		--deselect tests/test_context.py::TestContext::test_shadow
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
ce1d817b36058bb7f9cc248ac6318a3cf186aa78f915717e7d97ae59eed52dcb412d860c555fb052b4255ba037a9b16d79d428d45b85fed727691b7600ff30ee  pyzmq-27.2.0.tar.gz
"
