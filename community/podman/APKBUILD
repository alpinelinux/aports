# https://github.com/mattn/go-sqlite3/issues/1164
export CGO_CFLAGS="$CFLAGS -D_LARGEFILE64_SOURCE"

export BUILDTAGS="exclude_graphdriver_devicemapper seccomp apparmor libsqlite3"

build() {
	make -j1 podman podman-remote quadlet rootlessport docs \
		PREFIX=/usr \
		GOMD2MAN="$(which go-md2man)"
}

check() {
	make -j1 .install.ginkgo test/goecho/goecho test/version/version

	local skip_packages="test/e2e,pkg/bindings,hack,pkg/machine/e2e,pkg/machine/wsl,pkg/machine/hyperv"

	# TestUnitDirs execs /proc/self/exe, which fails on non-x86_64 builders.
	[ "$CARCH" = x86_64 ] || skip_packages="$skip_packages,pkg/systemd/quadlet"

	# podman machine and its tests only build on amd64/arm64.
	case "$CARCH" in
		x86_64|aarch64) ;;
		*) skip_packages="$skip_packages,pkg/machine,internal/localapi" ;;
	esac

	UNIT=1 ./bin/ginkgo -r \
		--skip-package "$skip_packages" \
		--tags "$BUILDTAGS" \
		--succinct
}

package() {
	make install.bin install.remote install.man install.completions install.systemd \
		PREFIX=/usr DESTDIR="$pkgdir"

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

remote() {
	pkgdesc="Remote CLI for Podman"
	amove usr/bin/podman-remote
}

docker() {
	pkgdesc="Emulate Docker CLI using Podman"
	depends="podman"
	provides="docker docker-cli"

	cd "$builddir"

	install -d "$subpkgdir"/usr/bin
	make PREFIX=/usr DESTDIR="$subpkgdir" install.docker

	# Remove man pages
	rm -rf "${subpkgdir:?}"/usr/share

	# Remove systemd-related stuff (will be handled in docker_systemd func later)
	rm -rf "$subpkgdir"/usr/lib
	rm -rf "$subpkgdir"/usr/share/user-tmpfiles.d
}

docker_doc() {
	pkgdesc="Emulate Docker CLI using Podman (documentation)"
	depends="$pkgname-doc"
	install_if="docs $pkgname-docker=$pkgver-r$pkgrel"

	# make target install.docker nor docker-docs are of any use,
	# so lets create the symlinks manually:
	cd "$builddir"/docs/build/man

	install -dm755 "$subpkgdir"/usr/share/man/man1
	for i in podman*.1; do
		ln -s $i.gz "$subpkgdir"/usr/share/man/man1/${i/podman/docker}.gz
	done
}

systemd() {
	default_systemd

	amove usr/libexec/podman/quadlet
	amove usr/lib/tmpfiles.d/podman.conf
}

docker_systemd() {
	pkgdesc="Emulate Docker CLI using Podman (systemd files)"
	install_if="$pkgname-docker=$pkgver-r$pkgrel systemd"

	install -Dm644 "$builddir"/contrib/systemd/system/podman-docker.conf \
		"$subpkgdir"/usr/lib/tmpfiles.d/podman-docker.conf
	install -Dm644 "$builddir"/contrib/systemd/system/podman-docker.conf \
		"$subpkgdir"/usr/share/user-tmpfiles.d/podman-docker.conf
}

