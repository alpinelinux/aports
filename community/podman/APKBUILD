# Contributor: Michał Polański <michal@polanski.me>
maintainer="omni <omni+alpine@hack.org>"
pkgname=podman
pkgver=6.1.2
pkgrel=0
pkgdesc="Simple management tool for pods, containers and images"
url="https://podman.io/"
license="Apache-2.0"
arch="all"
depends="
	conmon
	oci-runtime
	passt
	cmd:newgidmap
	cmd:newuidmap
	container-libs
	netavark
	aardvark-dns
	catatonit
	"
makedepends="
	bash
	btrfs-progs-dev
	coreutils
	gettext-envsubst
	go
	go-md2man
	gpgme-dev
	grep
	libassuan-dev
	libseccomp-dev
	mandoc
	python3
	sqlite-dev
	"

case "$CARCH" in
x86_64) checkdepends="qemu-system-x86_64" ;;
aarch64) checkdepends="qemu-system-aarch64" ;;
esac

install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="
	$pkgname-doc
	$pkgname-openrc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	$pkgname-remote:remote
	$pkgname-systemd::all
	$pkgname-docker:docker:noarch
	$pkgname-docker-doc:docker_doc:noarch
	$pkgname-docker-systemd:docker_systemd:noarch
	"
source="https://github.com/podman-container-tools/podman/archive/v$pkgver/podman-$pkgver.tar.gz
	kill-all-only-rootful.patch
	systemd-units-always.patch
	test-synchronize-SHM-lock-test.patch

	podman.initd
	podman.confd
	"

