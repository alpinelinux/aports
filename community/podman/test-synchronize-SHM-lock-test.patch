From a34c978984a54d0372b2cf804b85297bd87d4189 Mon Sep 17 00:00:00 2001
From: Srinidhi <srinidhisadhanala@gmail.com>
Date: Tue, 18 Aug 2026 16:57:53 +0530
Subject: [PATCH] test: synchronize SHM lock test

Signed-off-by: Srinidhi <srinidhisadhanala@gmail.com>
---
 libpod/lock/shm/shm_lock_test.go | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/libpod/lock/shm/shm_lock_test.go b/libpod/lock/shm/shm_lock_test.go
index 3e35f1898d..08c1425d36 100644
--- a/libpod/lock/shm/shm_lock_test.go
+++ b/libpod/lock/shm/shm_lock_test.go
@@ -245,11 +245,14 @@ func TestLockSemaphoreActuallyLocks(t *testing.T) {
 		// Get the current time
 		startTime := time.Now()
 
+		lockAcquired := make(chan struct{})
+
 		// Start a goroutine to take the lock and then release it after
 		// a second.
 		go func() {
 			err := locks.LockSemaphore(0)
 			assert.NoError(t, err)
+			close(lockAcquired)
 
 			time.Sleep(1 * time.Second)
 
@@ -257,9 +260,8 @@ func TestLockSemaphoreActuallyLocks(t *testing.T) {
 			assert.NoError(t, err)
 		}()
 
-		// Sleep for a quarter of a second to give the goroutine time
-		// to kick off and grab the lock
-		time.Sleep(250 * time.Millisecond)
+		// Wait until the goroutine has acquired the lock.
+		<-lockAcquired
 
 		// Take the lock
 		err := locks.LockSemaphore(0)
-- 
2.55.0

