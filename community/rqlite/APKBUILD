# Maintainer: DWwanghao <wanghao03@loongson.cn>
maintainer="DWwanghao <wanghao03@loongson.cn>"
pkgname=rqlite
pkgver=10.2.7
pkgrel=0
pkgdesc="Lightweight, distributed relational database built on SQLite"
url="https://github.com/rqlite/rqlite"
arch="all"
license="MIT"
makedepends="go sqlite-dev"
checkdepends="python3 py3-requests"
options="chmod-clean net"
subpackages="
	$pkgname-doc
	$pkgname-bench
	$pkgname-client
	"
source="https://github.com/rqlite/rqlite/archive/refs/tags/v$pkgver/rqlite-$pkgver.tar.gz"

export GOFLAGS="$GOFLAGS -tags=libsqlite3"

build() {
	go build ./cmd/rqbench &
	go build ./cmd/rqlite &
	go build ./cmd/rqlited &
	wait
}

# limited by unaligned 64-bit atomic operation
case "$CARCH" in
x86|armhf|armv7) options="$options !check" ;;
esac

check() {
	# system_test/e2e/shell.py requires environment variables to be set
	export RQLITE_PATH="$PWD/rqlite"
	export RQLITED_PATH="$PWD/rqlited"

	RQLITED_PATH="$builddir"/rqlited python3 system_test/e2e/shell.py
}

package() {
	install -Dm755 rqbench rqlite rqlited \
		-t "$pkgdir"/usr/bin/

	install -Dm644 DOC/*.md \
		-t "$pkgdir"/usr/share/doc/$pkgname/

	install -Dm644 LICENSE \
		-t "$pkgdir"/usr/share/licenses/$pkgname/
}

bench() {
	pkgdesc="$pkgdesc (benchmark utility)"

	amove usr/bin/rqbench
}

client() {
	pkgdesc="$pkgdesc (client)"

	amove usr/bin/rqlite
}

sha512sums="
259d75cf8af956447e03aebeb1252c5bc15701cf8b252b2c740225bcff29a9310f8a6876f80ade120b35421ca2b79d5b71d8ee6b17f82a85a66bd6e96daa6f9c  rqlite-10.2.7.tar.gz
"
