# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=plasma-setup
pkgver=6.8.3
pkgrel=0
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/plasma/plasma-setup"
pkgdesc="Plasma first-run setup tool"
license="(GPL-2.0-only OR GPL-3.0-only) AND (LGPL-2.1-only OR LGPL-3.0-only)"
# Requires plasma-desktop for the keyboard KCM
depends="
	plasma-desktop
	plasma-keyboard
	"
makedepends="
	extra-cmake-modules
	kauth-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kpackage-dev
	libkscreen-dev
	plasma-workspace-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtsvg-dev
	samurai
	"
subpackages="
	$pkgname-lang
	$pkgname-systemd
	"

case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac

# strip fourth version component for source URL
case "$pkgver" in
	*.*.*.*) _pkgver="${pkgver%.*}" ;;
	*) _pkgver="$pkgver" ;;
esac

_repo_url="https://invent.kde.org/plasma/plasma-setup.git"
source="https://download.kde.org/$_rel/plasma/$_pkgver/plasma-setup-$pkgver.tar.xz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
87fa93e3472c15bc32e72612299659dfa72ac8a1b5a8c99ed8391f1299f8339c467448df622df5ed93a78ad4f59a00c71299fd21502650057f45bc819766a7a3  plasma-setup-6.8.3.tar.xz
"
