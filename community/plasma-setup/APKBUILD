# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=plasma-setup
pkgver=6.7.5
pkgrel=0
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/plasma/plasma-setup"
pkgdesc="Plasma first-run setup tool"
license="(GPL-2.0-only OR GPL-3.0-only) AND (LGPL-2.1-only OR LGPL-3.0-only)"
# Requires plasma-desktop for the keyboard KCM
depends="
	plasma-desktop
	plasma-keyboard
	"
makedepends="
	extra-cmake-modules
	kauth-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kpackage-dev
	libkscreen-dev
	plasma-workspace-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtsvg-dev
	samurai
	"
subpackages="
	$pkgname-lang
	$pkgname-systemd
	"

case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac

# strip fourth version component for source URL
case "$pkgver" in
	*.*.*.*) _pkgver="${pkgver%.*}" ;;
	*) _pkgver="$pkgver" ;;
esac

_repo_url="https://invent.kde.org/plasma/plasma-setup.git"
source="https://download.kde.org/$_rel/plasma/$_pkgver/plasma-setup-$pkgver.tar.xz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
39700d9bbb33b9340a60ef02b058fb0d9ecd8f2a7c19cd02e3c7dd8db0a900a9ebbaf2ffee8137d31016dd238ce657e19bc995cf7fb02609ab89279e5fae85bf  plasma-setup-6.7.5.tar.xz
"
