# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=kaidan
pkgver=0.16.0
pkgrel=0
pkgdesc="Kaidan, a simple and user-friendly Jabber/XMPP client for every device and platform"
# armhf blocked by qt6-qtdeclarative
# riscv64 blocked by kquickimageeditor5
# s390x blocked by kquickimageeditor
arch="all !armhf !riscv64 !s390x"
url="https://invent.kde.org/network/kaidan"
license="GPL-3.0-or-later-with-openssl-exception AND GPL-3.0-or-later AND MIT AND AND Apache-2.0 AND CC-BY-SA-4.0 AND CC-BY-SA-3.0"
depends="
	kirigami
	kirigami-addons
	kquickimageeditor
	qt6-qtbase-sqlite
	qt6-qtlocation
	"
makedepends="
	extra-cmake-modules
	kdsingleapplication-dev
	kio-dev
	kirigami-addons-dev
	kirigami-dev
	kitemmodels-dev
	knotifications-dev
	kquickimageeditor-dev
	prison-dev
	qqc2-desktop-style-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtlocation-dev
	qt6-qtmultimedia-dev
	qt6-qtsvg-dev
	qt6-qttools-dev
	qtkeychain-dev
	qxmpp-dev
	samurai
	zxing-cpp-dev
	"
subpackages="$pkgname-lang"
_repo_url="https://invent.kde.org/network/kaidan.git"
source="https://download.kde.org/unstable/kaidan/$pkgver/kaidan-$pkgver.tar.xz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
