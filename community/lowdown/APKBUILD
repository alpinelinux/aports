470959d42b41eff432af76ce78ae00ed1f403d4fc71c5d3a08be4eeb0e25b0e13e3ca7218a0eb6193c99de8024f426b1966921d9c2e0c76ea24acc0e0aba2933  0001-Update-oconfigure.patch
"
