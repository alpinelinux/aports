maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-url-normalize
pkgver=3.0.1
pkgrel=0
pkgdesc="URL normalization for Python"
url="https://github.com/niksite/url-normalize"
arch="noarch"
license="MIT"
depends="py3-idna"
makedepends="
	py3-setuptools
	py3-gpep517
	"
checkdepends="
	py3-pytest
	py3-pytest-cov
	py3-pytest-socket
	py3-sortedcontainers
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/niksite/url-normalize/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/url-normalize-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
851aadd2ca22f9b41565b91020078da7c421ddb461036bdcfeb7a170fd597c5f63aab4cea2bf059a0e11ebe54e6a8b5eeb9d2b4d457839ef81fb4eb2bcac459c  py3-url-normalize-3.0.1.tar.gz
"
