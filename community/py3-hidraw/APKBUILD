source="$pkgname-$pkgver.tar.gz::https://github.com/C0rn3j/python-hidraw/archive/modernize/$_commit.tar.gz"
builddir="$srcdir/python-hidraw-modernize"
options="!check" # no tests

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

