# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-rstr
pkgver=4.0.0
pkgrel=0
pkgdesc="Random string generator"
url="https://github.com/leapfrogonline/rstr"
arch="noarch"
license="BSD-3-Clause"
makedepends="py3-gpep517 py3-setuptools py3-setuptools_scm py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/r/rstr/rstr-$pkgver.tar.gz"
builddir="$srcdir/rstr-$pkgver"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
f01611753dc4e2123542473fd527f9e72b5678d08a5c28d60c40a7e9f3d73c8206914b6800d0b5ea67176c856f770d5909e8413afd7c71d3dfe0fe8eb7143387  rstr-4.0.0.tar.gz
"
