# Maintainer: Antoine Martin (ayakael) <dev@ayakael.net>
pkgname=py3-rpy2
_pyname="rpy2"
pkgver=3.7.0
_gittag=69594ce80cb623b70b70a7fa4e0eaecc4832b484
pkgrel=0
pkgdesc="A very simple, yet robust, Python interface to the R Programming Language"
url="https://pypi.python.org/project/rpy2"
# riscv64: R missing
arch="all !riscv64 !ppc64le"
license="GPL-2.0-only"
depends="
	py3-cffi
	py3-numpy
	py3-tz
	py3-tzlocal
	py3-jinja2
	R
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	R-dev
	libdeflate-dev
	"
checkdepends="
	py3-pytest
	ipython
	py3-pandas
	"
source="$pkgname-$_gittag.tar.gz::https://github.com/rpy2/rpy2/archive/$_gittag.tar.gz"
builddir="$srcdir"/$_pyname-$_gittag
subpackages="$pkgname-pyc"
# version 3.6.0 split the package in two
provides="py3-rpy2-rinterface=$pkgver-r$pkgrel py3-rpy2-robjects=$pkgver-r$pkgrel"

build() {
	for i in ./ rpy2-rinterface rpy2-robjects; do
		cd "$builddir"/$i
		gpep517 build-wheel \
			--wheel-dir "$builddir"/.dist \
			--output-fd 3 3>&1 >&2
	done
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	for i in rpy2-rinterface rpy2-robjects; do
		cd "$builddir"/$i
		../.testenv/bin/python3 -m installer "$builddir"/.dist/${i/-/_}*.whl
		# test_find_onlyfromloadedlibrary:  Error in detach("package:survival") : invalid 'name' argument
		../.testenv/bin/python3 -m pytest -v \
			--deselect src/rpy2/rinterface/tests/test_environment.py::test_find_onlyfromloadedlibrary


	done
}

package() {
	for i in .dist/*; do
		python3 -m installer --destdir="$pkgdir" $i
	done
	for i in rinterface/tests robjects/tests ipython/tests; do
		rm -R "$pkgdir"/usr/lib/python*/site-packages/rpy2/$i
	done
}

sha512sums="
e68f8013f5c1f258ecbca4b605e376c3a94cc5642f66ed189cf120731b671b9450cf41f8e66316cc0377554a1fb11ae34d9965767e6e3ae37ef560cfbef29199  py3-rpy2-69594ce80cb623b70b70a7fa4e0eaecc4832b484.tar.gz
"
