From 2e6a34ed024cd5ced8be2690740ea38318e8a138 Mon Sep 17 00:00:00 2001
From: mio <miyopan@e.email>
Date: Wed, 14 Oct 2026 05:39:41 +0000
Subject: [PATCH] Replace when-let with when-let*

Fixes `plz.el:919:6: Error: ‘when-let’ is an obsolete macro (as of
31.1); use ‘when-let*’ or ‘and-let*’ instead.`
---
 plz.el | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/plz.el b/plz.el
index 6da2251..1571418 100644
--- a/plz.el
+++ b/plz.el
@@ -916,7 +916,7 @@ argument passed to `plz--sentinel', which see."
            (pcase-exhaustive (process-get process :plz-else)
              (`nil (process-put process :plz-result err))
              ((and (pred functionp) fn) (funcall fn err))))))
-    (when-let ((finally (process-get process :plz-finally)))
+    (when-let* ((finally (process-get process :plz-finally)))
       (funcall finally))
     (unless (or (process-get process :plz-sync)
                 (eq 'buffer (process-get process :plz-as)))
-- 
2.56.0

