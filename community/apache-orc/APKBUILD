# Contributor: Duncan Bellamy <dunk@denkimushi.com>
# Maintainer: Duncan Bellamy <dunk@denkimushi.com>
# based on arch linux PKGBUILD
pkgname=apache-orc
pkgver=2.3.1
pkgrel=0
pkgdesc="the smallest, fastest columnar storage for Hadoop workloads"
url="https://orc.apache.org/"
arch="all"
license="Apache-2.0"
# tests require /etc/localtime, downloads orc-format
options="!check net"
makedepends="
	abseil-cpp-dev
	cmake
	lz4-dev
	protobuf-dev
	samurai
	snappy-dev
	zlib-dev
	zlib-static
	zstd-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="https://archive.apache.org/dist/orc/orc-$pkgver/orc-$pkgver.tar.gz
	fix-cmake-find-modules.patch
	32bit-fix.patch
	"
builddir="$srcdir/orc-$pkgver"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		CMAKE_CROSSOPTS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_CXX_STANDARD=17 \
		-DSNAPPY_HOME=/usr \
		-DZLIB_HOME=/usr \
		-DLZ4_HOME=/usr \
		-DZSTD_HOME=/usr \
		-DPROTOBUF_HOME=/usr \
		-DBUILD_LIBHDFSPP=OFF \
		-DBUILD_JAVA=OFF \
		-DINSTALL_VENDORED_LIBS=OFF \
		-DBUILD_POSITION_INDEPENDENT_LIB=ON \
		-DSTOP_BUILD_ON_WARNING=OFF \
		-DBUILD_CPP_TESTS=OFF \
		-DBUILD_TOOLS=OFF \
		$CMAKE_CROSSOPTS
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

