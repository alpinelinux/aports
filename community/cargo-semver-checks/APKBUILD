# Contributor: Leon White <badfunkstripe@gmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=cargo-semver-checks
pkgver=0.51.0
pkgrel=0
pkgdesc="Lint your crate API changes for semver violations"
url="https://github.com/obi1kenobi/cargo-semver-checks"
arch="all"
license="MIT OR Apache-2.0"
makedepends="cargo-auditable"
checkdepends="bash git"
depends="cargo"
subpackages="$pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/obi1kenobi/cargo-semver-checks/archive/refs/tags/v$pkgver.tar.gz
	snapshot-without-git-hash.patch
"
options="net"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	git init -q
	./scripts/regenerate_test_rustdocs.sh

	local skips=
	case "$CARCH" in
		# specified_target tests hardcode the glibc target, which has no std here
		x86_64|riscv64) skips="--skip with_env_var --skip with_flag"
		;;
	esac
	# shellcheck disable=SC2086
	cargo test --frozen -- $skips
}

package() {
	install -Dm 755 target/release/cargo-semver-checks "$pkgdir"/usr/bin/cargo-semver-checks

	for l in APACHE MIT
	do
		install -Dm 644 LICENSE-"$l" "$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE-"$l"
	done
}

sha512sums="
