b2cd0d50ffadd2c7204649a0034b3e06db39737c3ebe505ddc15622b28cb8522ca6ba9782a71b33ce79caef4c05139dca68820db5e3fc3fc06b58a73b72fa8d4  snapshot-without-git-hash.patch"
