From fd81b5b05df3a6f58a7b20f8fdac67cd22c86c00 Mon Sep 17 00:00:00 2001
From: psykose <alice@ayaya.dev>
Date: Mon, 19 Dec 2022 06:10:20 +0000
Subject: [PATCH] rust-lto-thin.patch

set rust crate lto to thin to not use fatlto for gkrust which fails sometimes

additionally, disable lto on riscv64 altogether
---
 config/makefiles/rust.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/config/makefiles/rust.mk b/config/makefiles/rust.mk
index 06893db33c7e1..3428ceaabe730 100644
--- a/config/makefiles/rust.mk
+++ b/config/makefiles/rust.mk
@@ -117,8 +117,9 @@ ifndef MOZ_LTO_RUST_CROSS
 ifndef rustflags_sancov
 # Never enable when coverage is enabled to work around https://github.com/rust-lang/rust/issues/90045.
 ifndef MOZ_CODE_COVERAGE
+ifeq (,$(findstring riscv64,$(RUST_TARGET)))
 ifeq (,$(findstring gkrust_gtest,$(RUST_LIBRARY_FILE)))
-cargo_rustc_flags += -Clto$(if $(filter full,$(MOZ_LTO_RUST_CROSS)),=fat)
+cargo_rustc_flags += -Clto=thin
 endif
 # We need -Cembed-bitcode=yes for all crates when using -Clto.
 RUSTFLAGS += -Cembed-bitcode=yes
@@ -127,6 +128,7 @@ endif
 endif
 endif
 endif
+endif
 
 ifdef CARGO_INCREMENTAL
 export CARGO_INCREMENTAL
-- 
2.56.0

