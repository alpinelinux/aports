From 7489a72016dbc0b266ccad2eaa59fb18fb9f81ce Mon Sep 17 00:00:00 2001
From: Celeste <20312-Celeste@users.gitlab.alpinelinux.org>
Date: Sat, 21 Sep 2024 04:37:30 +0000
Subject: [PATCH] loong0003-Define-HWCAP_LOONGARCH_LSX_and_LASX.patch

Reference: https://github.com/torvalds/linux/blob/v6.11/lib/raid6/loongarch.h

Co-Authored-By: ptrcnull <git@ptrcnull.me>
---
 gfx/skia/skia/src/core/SkCpu.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/gfx/skia/skia/src/core/SkCpu.cpp b/gfx/skia/skia/src/core/SkCpu.cpp
index 2382922a2eb94..3a01daea67f15 100644
--- a/gfx/skia/skia/src/core/SkCpu.cpp
+++ b/gfx/skia/skia/src/core/SkCpu.cpp
@@ -212,6 +212,14 @@ namespace {
         return features;
     }
 #elif defined(SK_CPU_LOONGARCH)
+    /* have to supply these defines for glibc 2.37- and musl */
+    #ifndef HWCAP_LOONGARCH_LSX
+    #define HWCAP_LOONGARCH_LSX	(1 << 4)
+    #endif
+    #ifndef HWCAP_LOONGARCH_LASX
+    #define HWCAP_LOONGARCH_LASX	(1 << 5)
+    #endif
+
     uint32_t read_cpu_features() {
         uint32_t features = 0;
         uint64_t hwcap = getauxval(AT_HWCAP);
-- 
