# s390x: blocked by lld
# armhf: mismatched NEON flags; no `vmulq_f32` in `core_arch::arch::arm`
arch="all !s390x !armhf"
license="GPL-3.0-only AND LGPL-2.1-only AND LGPL-3.0-only AND MPL-2.0"
install="$pkgname.post-upgrade"
depends="
