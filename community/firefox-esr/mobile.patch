From 9fca1eba9a8030903d60665a93a8dfd8d5e60fbd Mon Sep 17 00:00:00 2001
From: ptrcnull <git@ptrcnull.me>
Date: Sun, 16 Aug 2026 15:11:09 +0200
Subject: [PATCH] mobile.patch

Add a mobile-friendly "About" button, as well as
style fixes for smaller width screens on built-in pages
---
 browser/base/content/aboutDialog.css          | 21 +++++++++++++++++++
 .../base/content/appmenu-viewcache.inc.xhtml  |  4 ++++
 .../customizableui/content/panelUI.js         |  3 +++
 3 files changed, 28 insertions(+)

diff --git a/browser/base/content/aboutDialog.css b/browser/base/content/aboutDialog.css
index 017125bc2510e..f76d382363645 100644
--- a/browser/base/content/aboutDialog.css
+++ b/browser/base/content/aboutDialog.css
@@ -178,3 +178,24 @@
     content: url("chrome://global/skin/icons/loading.svg");
   }
 }
+
+@media (max-width: 600px) {
+  #clientBox {
+    flex-direction: column;
+  }
+  #leftBox {
+    margin-inline-start: 0;
+  }
+  vbox#rightBox {
+    width: auto;
+  }
+  label.bottom-link {
+    margin: 0;
+    flex: 1;
+    align-content: center;
+  }
+}
+
+#aboutDialogContainer {
+  overflow: scroll;
+}
diff --git a/browser/base/content/appmenu-viewcache.inc.xhtml b/browser/base/content/appmenu-viewcache.inc.xhtml
index 4f1a7223d257d..1c2dd03137202 100644
--- a/browser/base/content/appmenu-viewcache.inc.xhtml
+++ b/browser/base/content/appmenu-viewcache.inc.xhtml
@@ -78,6 +78,10 @@
                      data-l10n-id="appmenuitem-history"
                      closemenu="none"
                      />
+      <toolbarbutton id="appMenu-about-button"
+                     class="subviewbutton"
+                     data-l10n-id="menu-about"
+                     />
       <toolbarbutton id="appMenu-tab-groups-button"
                      class="subviewbutton subviewbutton-nav"
                      data-l10n-id="appmenuitem-tab-groups"
diff --git a/browser/components/customizableui/content/panelUI.js b/browser/components/customizableui/content/panelUI.js
index 4bf7f4fedf135..46cb1f939b8ed 100644
--- a/browser/components/customizableui/content/panelUI.js
+++ b/browser/components/customizableui/content/panelUI.js
@@ -444,6 +444,9 @@ const PanelUI = {
       case "appMenu-help-button2":
         this.showSubView("PanelUI-helpView", target);
         break;
+      case "appMenu-about-button":
+        openTrustedLinkIn("chrome://browser/content/aboutDialog.xhtml", "tab");
+        break;
     }
   },
 
-- 
2.56.0

