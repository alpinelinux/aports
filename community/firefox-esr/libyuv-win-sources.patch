From 9c82373fc2a44541edad332a0b0bec39cc56a37f Mon Sep 17 00:00:00 2001
From: Timothy Nikkel <tnikkel@gmail.com>
Date: Tue, 27 Oct 2026 20:35:37 +0000
Subject: [PATCH] libyuv-win-sources.patch

Fix libyuv link failure on 32-bit x86 non-Windows builds.

Patch-Source: https://phabricator.services.mozilla.com/D335939
---
 media/libyuv/libyuv/libyuv.gyp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/media/libyuv/libyuv/libyuv.gyp b/media/libyuv/libyuv/libyuv.gyp
index 2ae75fefd8a01..8563e93b4a32c 100644
--- a/media/libyuv/libyuv/libyuv.gyp
+++ b/media/libyuv/libyuv/libyuv.gyp
@@ -158,6 +158,16 @@
       'sources': [
         '<@(libyuv_sources)',
       ],
+      # Undo filename_rules.gypi's exclusion of *_win.cc on non-Windows. The
+      # files are guarded by #if, and rotate_win.cc is used for 32-bit x86 on
+      # any OS.
+      'target_conditions': [
+        ['OS != "win"', {
+          'sources/': [
+            ['include', '_win\\.cc$'],
+          ],
+        }],
+      ],
     },
     {
       'target_name': 'libyuv_neon',
-- 
2.56.0

