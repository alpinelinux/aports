# Contributor: Grigory Kirillov <txgk@bk.ru>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=gumbo-parser
pkgver=0.14.0
pkgrel=0
pkgdesc="HTML5 parsing library in pure C99"
url="https://codeberg.org/gumbo-parser/gumbo-parser"
arch="all"
license="Apache-2.0"
makedepends="gtest-dev muon samurai"
checkdepends="gtest"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/gumbo-parser/gumbo-parser/archive/$pkgver.tar.gz"
builddir="$srcdir/gumbo-parser"

build() {
	abuild-muon build . \
		-Ddefault_library=both
	ninja -C build
}

check() {
	muon -C build test
}

package() {
	DESTDIR="$pkgdir" muon -C build install

	install -Dm 644 doc/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname
	install -Dm 644 README.md -t "$pkgdir"/usr/share/doc/$pkgname
}

sha512sums="
612b570bfa4029272bc4b8d4ff43f6023e03a2a2ac6ba299fa6d0818dc112df84ef98908ef9102801dbf847e93cc6e1f8c976e2f9f782199d6785cb28db8dbb5  gumbo-parser-0.14.0.tar.gz
"
