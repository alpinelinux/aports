# Contributor: Jake Buchholz Göktürk <tomalok@gmail.com>
# Maintainer: Jake Buchholz Göktürk <tomalok@gmail.com>
pkgname=efs-utils
pkgver=3.3.0
pkgrel=0
pkgdesc="Utilities for Amazon Elastic File System (EFS)"
url="https://github.com/aws/efs-utils"
license="MIT"
depends="nfs-utils openssl py3-botocore python3 stunnel"
makedepends="
	cargo
	clang
	cmake
	git
	go
	linux-headers
	ninja
	openssl-dev
	perl
	"
# AWS validates current amazon-efs-utils packages on x86_64 and arm64 only.
arch="aarch64 x86_64"
options="!check net"
source="$pkgname-$pkgver.tar.gz::https://github.com/aws/efs-utils/archive/refs/tags/v$pkgver.tar.gz
	efs-utils_openrc.patch
	amazon-efs-mount-watchdog.initd
	"

subpackages="
	$pkgname-doc
	$pkgname-openrc
	$pkgname-systemd
	"

build() {
	# aws-lc-fips-sys 0.14.1's delocate tool is incompatible with GCC 15.
	export CC=clang
	export CXX=clang++
	# delocate cannot rewrite Clang's GOTPCREL calls generated by -fno-plt.
	export CFLAGS="${CFLAGS/-fno-plt}"
	export CXXFLAGS="${CXXFLAGS/-fno-plt}"
	cargo build --locked --release -p efs-proxy --manifest-path src/Cargo.toml
}

package() {
	mkdir -p "$pkgdir"/var/log/amazon/efs
	install -Dm644 -t "$pkgdir"/etc/amazon/efs \
		dist/efs-utils.conf \
		dist/s3files-utils.conf
	install -Dm444 -t "$pkgdir"/etc/amazon/efs dist/efs-utils.crt
	install -Dm755 src/watchdog/__init__.py \
		"$pkgdir"/usr/bin/amazon-efs-mount-watchdog
	install -Dm755 src/mount_efs/__init__.py "$pkgdir"/usr/sbin/mount.efs
	install -Dm755 src/mount_s3files/__init__.py \
		"$pkgdir"/usr/sbin/mount.s3files
	install -Dm755 src/target/release/efs-proxy "$pkgdir"/usr/bin/efs-proxy
	install -Dm644 -t "$pkgdir"/usr/share/man/man8 \
		man/mount.efs.8 \
		man/mount.s3files.8

	local python_libpath
	python_libpath=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))")
	mkdir -p "$pkgdir$python_libpath"/efs_utils_common \
		"$pkgdir$python_libpath"/mount_efs \
		"$pkgdir$python_libpath"/mount_s3files
	install -m644 -t "$pkgdir$python_libpath"/efs_utils_common src/efs_utils_common/*.py
	install -m644 -t "$pkgdir$python_libpath"/mount_efs src/mount_efs/*.py
	install -m644 -t "$pkgdir$python_libpath"/mount_s3files src/mount_s3files/*.py

	install -Dm755 "$srcdir"/amazon-efs-mount-watchdog.initd \
		"$pkgdir"/etc/init.d/amazon-efs-mount-watchdog
	install -Dm644 dist/amazon-efs-mount-watchdog.service \
		"$pkgdir"/usr/lib/systemd/system/amazon-efs-mount-watchdog.service
}

