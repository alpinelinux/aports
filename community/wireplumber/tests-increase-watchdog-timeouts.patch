Increase test watchdog timeouts

The hardcoded 8s fixture watchdog and the 5s suspend test watchdog are
too short on slow or heavily loaded builders (e.g. riscv64), where the
node/suspend-fast-start-slow-resume-only test aborts with
"test timed out" while still making progress.

diff -ru a/tests/common/base-test-fixture.h b/tests/common/base-test-fixture.h
--- a/tests/common/base-test-fixture.h	2026-11-05 20:54:21.614345279 +0100
+++ b/tests/common/base-test-fixture.h	2026-11-05 20:54:21.624164813 +0100
@@ -83,7 +83,7 @@
   g_main_context_push_thread_default (self->context);
 
   /* watchdog */
-  self->timeout_source = g_timeout_source_new_seconds (8);
+  self->timeout_source = g_timeout_source_new_seconds (30);
   g_source_set_callback (self->timeout_source, (GSourceFunc) timeout_callback,
       self, NULL);
   g_source_attach (self->timeout_source, self->context);
diff -ru a/tests/scripts/scripts/lib/suspend-test-utils.lua b/tests/scripts/scripts/lib/suspend-test-utils.lua
--- a/tests/scripts/scripts/lib/suspend-test-utils.lua	2026-11-05 20:54:21.617441402 +0100
+++ b/tests/scripts/scripts/lib/suspend-test-utils.lua	2026-11-05 20:54:21.656524110 +0100
@@ -84,6 +84,8 @@
 
 -- fail instead of waiting for the meson timeout
 function s.watchdog (ms)
+  -- give slow and heavily loaded builders more time
+  ms = ms * 6
   s.after (ms, function ()
     assert (false, "test did not finish within " .. ms .. " ms")
   end)
