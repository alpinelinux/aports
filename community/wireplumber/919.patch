From ade3b3effa90f6e83515ceaa37a373c240838edd Mon Sep 17 00:00:00 2001
From: Julian Bouzas <julian.bouzas@collabora.com>
Date: Thu, 1 Oct 2026 14:41:51 -0400
Subject: [PATCH 1/2] linking: don't link role loopback streams to other
 role-based targets

- In lutils.canLink, reject targets with policy.role-based.target if the
  stream's own link-group contains a role-based target.
- When no other sink was available (e.g. during a card profile switch),
  the output streams of the role loopbacks were linked to each other's
  sinks. Such a link is treated as a role policy link, so it could become
  the priority media role link and cork all the other streams.

Fixes #1030

Assisted-by: Claude:claude-opus-5-5
---
 src/scripts/lib/linking-utils.lua | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/scripts/lib/linking-utils.lua b/src/scripts/lib/linking-utils.lua
index e1b4f3215..dcb6525f5 100644
--- a/src/scripts/lib/linking-utils.lua
+++ b/src/scripts/lib/linking-utils.lua
@@ -268,6 +268,18 @@ function lutils.canLink (properties, si_target)
     return false
   end
 
+  -- the stream of a role loopback must not link to another role-based target
+  local link_group = properties ["node.link-group"]
+  if link_group and
+      cutils.parseBool (target_props ["policy.role-based.target"]) and
+      cutils.get_object_manager ("session-item"):lookup {
+        type = "SiLinkable",
+        Constraint { "node.link-group", "=", link_group },
+        Constraint { "policy.role-based.target", "=", true },
+      } then
+    return false
+  end
+
   -- check link group
   local function canLinkGroupCheck(link_group, si_target, hops)
     local target_props = si_target.properties
@@ -318,7 +330,6 @@ function lutils.canLink (properties, si_target)
     return true
   end
 
-  local link_group = properties ["node.link-group"]
   if link_group then
     return canLinkGroupCheck (link_group, si_target, 0)
   end
