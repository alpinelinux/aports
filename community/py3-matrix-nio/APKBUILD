pkgname=py3-matrix-nio
pkgver=0.26.0
pkgrel=0
pkgdesc="Python Matrix client library"
url="https://github.com/matrix-nio/matrix-nio"
arch="noarch"
license="ISC"
depends="
	py3-aiofiles
	py3-aiohttp
	py3-aiohttp-socks
	py3-h11
	py3-h2
	py3-jsonschema
	py3-pycryptodome
	py3-unpaddedbase64
	"
checkdepends="
	py3-aioresponses
	py3-atomicwrites
	py3-cachetools
	py3-faker
	py3-hpack
	py3-hyperframe
	py3-hypothesis
	py3-mypy
	py3-olm
	py3-peewee
	py3-pytest
	py3-pytest-aiohttp
	py3-pytest-asyncio
	py3-pytest-benchmark
	py3-pytest-cov
	py3-pytest-isort
	py3-vodozemac
	"
makedepends="
	py3-gpep517
	py3-setuptools
	"
subpackages="
	$pkgname-pyc
	$pkgname-e2e:e2e:noarch
	"
source="https://github.com/matrix-nio/matrix-nio/archive/$pkgver/matrix-nio-$pkgver.tar.gz"
builddir="$srcdir/matrix-nio-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# test_connect_wrapper requires a network connection
	.testenv/bin/python3 -m pytest -k 'not test_connect_wrapper'

}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

e2e() {
	pkgdesc="Python Matrix client library (e2e extras)"
	depends="
		$pkgname=$pkgver-r$pkgrel
		py3-atomicwrites
		py3-cachetools
		py3-peewee
		py3-olm
		py3-vodozemac
		"
	install -d "$subpkgdir"
}

sha512sums="
