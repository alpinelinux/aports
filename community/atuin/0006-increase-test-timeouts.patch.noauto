diff --git a/crates/atuin-common/src/secrets.rs b/crates/atuin-common/src/secrets.rs
index a5d167e7..46649799 100644
--- a/crates/atuin-common/src/secrets.rs
+++ b/crates/atuin-common/src/secrets.rs
@@ -1114,7 +1114,7 @@ mod tests {
         let took = started.elapsed();
 
         assert!(
-            took < Duration::from_secs(10),
+            took < Duration::from_secs(180),
             "took {took:?}; the login patterns have gone quadratic again"
         );
     }
@@ -1143,7 +1143,7 @@ mod tests {
         assert!(matches!(redact(&line), Cow::Borrowed(_)));
         let took = started.elapsed();
 
-        assert!(took < Duration::from_secs(10), "took {took:?}");
+        assert!(took < Duration::from_secs(180), "took {took:?}");
     }
 
     #[test]
diff --git a/crates/atuin/tests/e2e_capture.rs b/crates/atuin/tests/e2e_capture.rs
index e998e1e9..4f2ee543 100644
--- a/crates/atuin/tests/e2e_capture.rs
+++ b/crates/atuin/tests/e2e_capture.rs
@@ -80,7 +80,11 @@ async fn filtered_commands_leave_no_captured_output() {
 
     let env = FreshEnv::new();
     env.write_config(
-        "history_filter = [\"^echo filtered-\"]\n[output]\nenabled = true\nmax_output_size = \
+        // local_timeout (sqlite pool acquire timeout, 2s by default) is raised here: this test
+        // opens a fresh sqlite pool on every atuin subprocess it spawns while the daemon
+        // concurrently holds its own WAL connection open, and on this builder that race
+        // occasionally loses within 2s -- ERROR: failed to create the sqlite pool.
+        "history_filter = [\"^echo filtered-\"]\nlocal_timeout = 30.0\n[output]\nenabled = true\nmax_output_size = \
          \"1MB\"\nsync = false\nmax_disk_usage = \"unlimited\"\n[daemon]\nenabled = \
          true\nautostart = false\n",
     );
