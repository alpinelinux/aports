     use rustix::io::ioctl_fionbio;
+    use rustix::pipe::fcntl_setpipe_size;
 
     use super::*;
 
@@ -89,6 +90,11 @@ mod tests {
     fn times_out_when_the_fd_never_drains() {
         // Nobody reads `_reader`, so a non-blocking write fills the pipe and stalls.
         let (_reader, writer) = pipe().unwrap();
+        // The kernel's default pipe capacity is 16 pages, which is well below BIG on a 4 KiB
+        // page size but not on a 64 KiB one (common on ppc64le) -- there it's 1 MiB, so the
+        // "fills the pipe" assumption above silently fails and the write just succeeds. Pin the
+        // capacity down explicitly so this doesn't depend on the host's page size.
+        fcntl_setpipe_size(&writer, 4096).unwrap();
         ioctl_fionbio(&writer, true).unwrap();
         let err =
             writer.write_all_retrying(&vec![0u8; BIG], Duration::from_millis(50)).unwrap_err();
