maintainer="Michał Polański <michal@polanski.me>"
pkgname=wpaperd
pkgver=1.3.0
pkgrel=0
pkgdesc="Wallpaper daemon for Wayland"
url="https://github.com/danyspin97/wpaperd"
license="GPL-3.0-or-later"
arch="all"
makedepends="
	cargo
	cargo-auditable
	dav1d-dev
	mesa-dev
	libxkbcommon-dev
	wayland-dev
	scdoc
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/danyspin97/wpaperd/archive/$pkgver/wpaperd-$pkgver.tar.gz
	rustix.patch
	"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release --features avif

	scdoc <man/wpaperd-output.5.scd >man/wpaperd-output.5
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/$pkgname -t "$pkgdir"/usr/bin/
	install -Dm755 target/release/wpaperctl -t "$pkgdir"/usr/bin/

	install -Dm644 target/release/build/man/*.1 -t "$pkgdir"/usr/share/man/man1/
	install -Dm644 man/*.5 -t "$pkgdir"/usr/share/man/man5/

	install -Dm644 target/release/build/completions/$pkgname.bash \
		"$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 target/release/build/completions/$pkgname.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 target/release/build/completions/_$pkgname \
		"$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

sha512sums="
b43b3d04ddcb181ba35fadfc2938f6392c72693c0641d2f9d55f1c4206983057c1400dd2e5d3abe36c5d1ad58bed4f49efc0e1e7ade200b9ca3c40a753d7872d  wpaperd-1.3.0.tar.gz
794a1de0deb14208816c4bdd2a87068abd575210fae756ffaf9e5e50000e522d3056d324e383f55d797cf73f21fac898e75413d46b12c971d0b291bcb658ab07  rustix.patch
"
