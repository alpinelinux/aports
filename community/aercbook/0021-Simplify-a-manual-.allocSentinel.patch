From dc30170e929779d4774824766763a40a09a5f5f5 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 05:02:52 +0200
Subject: [PATCH] Simplify a manual .allocSentinel

---
 src/args.zig | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/src/args.zig b/src/args.zig
index d5bdc8e..50b1c05 100644
--- a/src/args.zig
+++ b/src/args.zig
@@ -472,12 +472,9 @@ fn convertArgumentValue(comptime T: type, allocator: std.mem.Allocator, textInpu
                 }
 
                 // If the type contains a sentinel dupe the text input to a new buffer.
-                // This is equivalent to allocator.dupeZ but works with any sentinel.
                 if (comptime std.meta.sentinel(T)) |sentinel| {
-                    const data = try allocator.alloc(u8, textInput.len + 1);
+                    const data = try allocator.allocSentinel(u8, textInput.len, sentinel);
                     std.mem.copy(u8, data, textInput);
-                    data[textInput.len] = sentinel;
-
                     return data[0..textInput.len :sentinel];
                 }
 
