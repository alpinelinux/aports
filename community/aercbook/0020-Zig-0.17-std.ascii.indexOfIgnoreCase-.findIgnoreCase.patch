From e7186db806bbca5f581ece3d46ad95f7c089516c Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:59:30 +0200
Subject: [PATCH] Zig 0.17: std.ascii.indexOfIgnoreCase -> .findIgnoreCase

---
 src/main.zig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/main.zig b/src/main.zig
index ebf4a4b..1bae60b 100644
--- a/src/main.zig
+++ b/src/main.zig
@@ -111,7 +111,7 @@ fn readAddressBook(
 fn decodeUtf8(str: []const u8, buffer: []u8) []const u8 {
     const trimmed = std.mem.trim(u8, str, " \t");
     const utf8_needle = "=?UTF-8?B?";
-    if (std.ascii.indexOfIgnoreCase(trimmed, utf8_needle)) |start| {
+    if (std.ascii.findIgnoreCase(trimmed, utf8_needle)) |start| {
         const end = "?=";
         if (!std.mem.endsWith(u8, trimmed[start..], end)) return str;
         const b64 = trimmed[start + utf8_needle.len .. trimmed.len - end.len];
@@ -131,7 +131,7 @@ fn replaceUtf8(str: []const u8, out_buffer: []u8) []const u8 {
     var buffer: [512]u8 = undefined;
     const trimmed = std.mem.trim(u8, str, " \t");
     const utf8_needle = "=?UTF-8?B?";
-    if (std.ascii.indexOfIgnoreCase(trimmed, utf8_needle)) |start| {
+    if (std.ascii.findIgnoreCase(trimmed, utf8_needle)) |start| {
         const end = "?=";
         const endpos = std.mem.indexOf(u8, trimmed, end) orelse 0;
         if (endpos == 0) return str;
