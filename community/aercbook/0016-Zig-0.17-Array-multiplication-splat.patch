From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:49:23 +0200
Subject: [PATCH] Zig 0.17: Array multiplication -> @splat()

---
 src/levenshtein.zig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/levenshtein.zig b/src/levenshtein.zig
index 2036844..9e39db9 100644
--- a/src/levenshtein.zig
+++ b/src/levenshtein.zig
@@ -6,7 +6,7 @@ pub fn edit_distance(start: []const u8, end: []const u8) u8 {
     // Figure out why x and y are switched here.
     const x_dim = start.len + 1;
     const y_dim = end.len + 1;
-    var matrix: [maxsize][maxsize]u8 = .{.{0} ** maxsize} ** maxsize;
+    var matrix: [maxsize][maxsize]u8 = @splat(@splat(0));
 
     var n: u8 = 0;
     while (n < x_dim) : (n += 1) {
