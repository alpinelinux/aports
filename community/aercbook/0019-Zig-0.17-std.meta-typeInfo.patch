From a78ae6db0e26b632ffb524052e574e375348d015 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:58:06 +0200
Subject: [PATCH] Zig 0.17: std.meta -> @typeInfo

---
 src/args.zig | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/args.zig b/src/args.zig
index b950791..d5bdc8e 100644
--- a/src/args.zig
+++ b/src/args.zig
@@ -177,11 +177,11 @@ fn parseInternal(comptime Generic: type, comptime MaybeVerb: ?type, args_iterato
                     var found = false;
                     if (@hasDecl(Generic, "shorthands")) {
                         any_shorthands = true;
-                        inline for (std.meta.fields(@TypeOf(Generic.shorthands))) |fld| {
-                            if (fld.name.len != 1)
+                        inline for (@typeInfo(@TypeOf(Generic.shorthands)).@"struct".field_names) |fld_name| {
+                            if (fld_name.len != 1)
                                 @compileError("All shorthand fields must be exactly one character long!");
-                            if (fld.name[0] == char) {
-                                const real_name = @field(Generic.shorthands, fld.name);
+                            if (fld_name[0] == char) {
+                                const real_name = @field(Generic.shorthands, fld_name);
                                 const real_fld_type = @TypeOf(@field(result.options, real_name));
 
                                 // -2 because we stripped of the "-" at the beginning
