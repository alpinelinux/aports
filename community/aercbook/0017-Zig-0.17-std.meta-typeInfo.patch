From d47a8146e11f8552330c8fd384facd42fc14d25f Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:54:06 +0200
Subject: [PATCH] Zig 0.17: std.meta -> @typeInfo

---
 src/args.zig | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/args.zig b/src/args.zig
index b6d3de6..3df198c 100644
--- a/src/args.zig
+++ b/src/args.zig
@@ -123,9 +123,9 @@ fn parseInternal(comptime Generic: type, comptime MaybeVerb: ?type, args_iterato
                 };
 
             var found = false;
-            inline for (std.meta.fields(Generic)) |fld| {
-                if (std.mem.eql(u8, pair.name, fld.name)) {
-                    try parseOption(Generic, result_arena_allocator, &result.options, args_iterator, error_handling, &last_error, fld.name, pair.value);
+            inline for (@typeInfo(Generic).@"struct".field_names) |fld_name| {
+                if (std.mem.eql(u8, pair.name, fld_name)) {
+                    try parseOption(Generic, result_arena_allocator, &result.options, args_iterator, error_handling, &last_error, fld_name, pair.value);
                     found = true;
                 }
             }
