From b0af9ae89cb7dc7e2b7c82ca600c756f93262928 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:49:04 +0200
Subject: [PATCH] Zig 0.17: Update build.zig

---
 build.zig | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/build.zig b/build.zig
index 876fa9d..93c79ec 100644
--- a/build.zig
+++ b/build.zig
@@ -56,9 +56,7 @@ pub fn build(b: *std.Build) void {
 
     const run_cmd = b.addRunArtifact(exe);
     run_cmd.step.dependOn(b.getInstallStep());
-    if (b.args) |args| {
-        run_cmd.addArgs(args);
-    }
+    run_cmd.addPassthruArgs();
 
     const run_step = b.step("run", "Run the app");
     run_step.dependOn(&run_cmd.step);
