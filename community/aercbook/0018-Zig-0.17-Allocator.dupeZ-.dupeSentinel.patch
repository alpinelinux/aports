From 9ecfe79c285036bb7591e4856dc516be2fe78380 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 4 Oct 2026 04:56:25 +0200
Subject: [PATCH] Zig 0.17: Allocator.dupeZ -> .dupeSentinel

---
 src/args.zig | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/args.zig b/src/args.zig
index 3df198c..b950791 100644
--- a/src/args.zig
+++ b/src/args.zig
@@ -23,7 +23,7 @@ pub fn parseForCurrentProcess(comptime Spec: type, allocator: std.mem.Allocator,
 
     var result = try parseInternal(Spec, null, &args, allocator, error_handling);
 
-    result.executable_name = try allocator.dupeZ(u8, executable_name);
+    result.executable_name = try allocator.dupeSentinel(u8, executable_name, 0);
 
     return result;
 }
@@ -51,7 +51,7 @@ pub fn parseWithVerbForCurrentProcess(comptime Spec: type, comptime Verb: type,
 
     var result = try parseInternal(Spec, Verb, &args, allocator, error_handling);
 
-    result.executable_name = try allocator.dupeZ(u8, executable_name);
+    result.executable_name = try allocator.dupeSentinel(u8, executable_name, 0);
 
     return result;
 }
@@ -169,7 +169,7 @@ fn parseInternal(comptime Generic: type, comptime MaybeVerb: ?type, args_iterato
         } else if (std.mem.startsWith(u8, item, "-")) {
             if (std.mem.eql(u8, item, "-")) {
                 // single hyphen is considered a positional argument
-                try arglist.append(allocator, try result_arena_allocator.dupeZ(u8, item));
+                try arglist.append(allocator, try result_arena_allocator.dupeSentinel(u8, item, 0));
             } else {
                 var any_shorthands = false;
                 for (item[1..], 0..) |char, index| {
@@ -275,7 +275,7 @@ fn parseInternal(comptime Generic: type, comptime MaybeVerb: ?type, args_iterato
                 }
             }
 
-            try arglist.append(allocator, try result_arena_allocator.dupeZ(u8, item));
+            try arglist.append(allocator, try result_arena_allocator.dupeSentinel(u8, item, 0));
         }
     }
 
@@ -285,7 +285,7 @@ fn parseInternal(comptime Generic: type, comptime MaybeVerb: ?type, args_iterato
     // This will consume the rest of the arguments as positional ones.
     // Only executes when the above loop is broken.
     while (args_iterator.next()) |item| {
-        try arglist.append(allocator, try result_arena_allocator.dupeZ(u8, item));
+        try arglist.append(allocator, try result_arena_allocator.dupeSentinel(u8, item, 0));
     }
 
     result.positionals = try arglist.toOwnedSlice(allocator);
@@ -507,7 +507,7 @@ fn parseOption(
 
     const final_value = if (value) |val| blk: {
         // use the literal value
-        const res = try arena.dupeZ(u8, val);
+        const res = try arena.dupeSentinel(u8, val, 0);
         break :blk res;
     } else if (requiresArg(field_type)) blk: {
         // fetch from parser
@@ -521,7 +521,7 @@ fn parseOption(
             return;
         }
 
-        const res = try arena.dupeZ(u8, val.?);
+        const res = try arena.dupeSentinel(u8, val.?, 0);
         break :blk res;
     } else blk: {
         // argument is "empty"
