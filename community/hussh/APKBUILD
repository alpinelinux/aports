# Contributor: kpcyrd <git@rxv.cc>
# Maintainer: kpcyrd <git@rxv.cc>
pkgname=hussh
pkgver=0.2.4
pkgrel=0
pkgdesc="Memory-safe SSH daemon for restricted TCP forwarding"
url="https://github.com/kpcyrd/hussh"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	cargo
	cargo-auditable
	scdoc
	"
pkgusers="$pkgname"
pkggroups="$pkgname"
install="$pkgname.pre-install"
subpackages="
	$pkgname-doc
	$pkgname-openrc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/kpcyrd/hussh/archive/v$pkgver.tar.gz"
options="net"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
	make docs
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 "$builddir/target/release/hussh" -t "$pkgdir/usr/bin"

	# config directory
	install -vDm644 contrib/hussh.conf -t "$pkgdir/etc"

	# man page
	install -vDm644 contrib/hussh.1 -t "$pkgdir/usr/share/man/man1"

	# openrc
	install -vDm755 "$builddir/contrib/$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
	install -vDm644 "$builddir/contrib/$pkgname.confd" "$pkgdir/etc/conf.d/$pkgname"
}

sha512sums="
edc936abe84c6d5b920cc3413db014498fc5927e927db39d3951a17b0ac837891f4f20636232177f052b14d2c91c8622dc05bc3205c3ac2e5890d523e307fa12  hussh-0.2.4.tar.gz
"
