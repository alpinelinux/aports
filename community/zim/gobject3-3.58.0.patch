---
From e0768cee3faaa881596615bacc8950b4095cfc16 Mon Sep 17 00:00:00 2001
From: Wahaj18 <48466561+Wahaj18@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:57:24 +0500
Subject: [PATCH] Do not register a serialize format for the parsetree

Gtk frees the data returned by a serialize callback, but the callback
annotation is transfer none, so PyGObject can not hand over data that
Gtk is allowed to free. With PyGObject 3.58 any return value, str or
bytes, leads to an invalid free and an abort. Because the format is
added to the PRIMARY selection targets, a clipboard manager that syncs
the selection crashes zim as soon as text is selected. With older
PyGObject the callback silently produced empty data.

Copy and paste of the parsetree go through the custom clipboard
handlers, so only the deserialize format is kept.

Fixes #3072
---
 tests/pageview.py    | 17 +++++------------
 zim/gui/clipboard.py |  9 +++------
 2 files changed, 8 insertions(+), 18 deletions(-)

diff --git a/tests/pageview.py b/tests/pageview.py
index 4f4224272..a5d3601c6 100644
--- a/tests/pageview.py
+++ b/tests/pageview.py
@@ -3946,19 +3946,12 @@ def testInsertLinkDialogUpdateTextShortLinkName(self):
 
 class TestDragAndDropFunctions(tests.TestCase):
 
-	@tests.expectedFailure
-	def testSerializeParseTree(self):
-		tree = tests.new_parsetree()
+	def testNoSerializeParseTree(self):
+		# Offering this format crashes zim, see issue #3072
 		notebook = self.setUpNotebook()
-		page = notebook.get_page(Path('Test'))
-		buffer = TextBuffer(notebook, page)
-		with FilterNoSuchImageWarning():
-			buffer.insert_parsetree_at_cursor(tree)
-
-		start, end = buffer.get_bounds()
-		xml = buffer.serialize(buffer, Gdk.Atom.intern('text/x-zim-parsetree', False), start, end)
-		tree._etree.getroot().attrib['partial'] = True # HACK
-		self.assertEqual(xml, tree.tostring())
+		buffer = TextBuffer(notebook, notebook.get_page(Path('Test')))
+		formats = [atom.name() for atom in buffer.get_serialize_formats()]
+		self.assertNotIn('text/x-zim-parsetree', formats)
 
 	@tests.expectedFailure
 	def testDeserializeParseTree(self):
diff --git a/zim/gui/clipboard.py b/zim/gui/clipboard.py
index d95b91dbf..be2e3740d 100644
--- a/zim/gui/clipboard.py
+++ b/zim/gui/clipboard.py
@@ -134,18 +134,15 @@ def unpack_urilist(text):
 
 
 def textbuffer_register_serialize_formats(buffer, notebook, page):
-	buffer.register_serialize_format('text/x-zim-parsetree', serialize_parse_tree)
+	# No serialize format for the parsetree: Gtk frees the data returned by
+	# the callback, which python can not hand over, so offering it as a
+	# selection target crashes zim when another client requests it
 	buffer.register_deserialize_format('text/x-zim-parsetree', deserialize_parse_tree, (notebook, page))
 	for name in (PAGELIST_TARGET_NAME,) + URI_TARGET_NAMES:
 		buffer.register_deserialize_format(name, deserialize_urilist, (notebook, page))
 	for name in IMAGE_TARGET_NAMES: # FIXME, should we limit the list ?
 		buffer.register_deserialize_format(name, deserialize_image, (name, notebook, page))
 
-def serialize_parse_tree(register_buf, content_buf, start, end, user_data=None):
-	tree = content_buf.get_parsetree((start, end))
-	xml = tree.tostring()
-	return xml
-
 def deserialize_parse_tree(register_buf, content_buf, iter, data, length, create_tags, user_data):
 	notebook, path = user_data
 	tree = ParseTree().fromstring(data)
