maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-nitrokey
pkgver=0.5.0
pkgrel=0
pkgdesc="Nitrokey Python SDK"
url="https://github.com/Nitrokey/nitrokey-sdk-py"
arch="noarch"
license="Apache-2.0 AND MIT"
depends="
	py3-crcmod
	py3-cryptography
	py3-fido2
	py3-hidapi
	py3-hidapi
	py3-protobuf
	py3-requests
	py3-semver
	py3-pyserial
	py3-tlv8
	"
makedepends="
	poetry
	py3-gpep517
	py3-installer
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/Nitrokey/nitrokey-sdk-py/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/nitrokey-sdk-py-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -k 'not test_equality and not test_list_equality'
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
e002c5a71853a38a82f77d840d7658d7b06687214b4b5eef91a336c6e03fe2082c547a48e64343d4b306ff138a675294e3aea7fcb562935bd85a43dc73db11a7  py3-nitrokey-0.5.0.tar.gz
"
