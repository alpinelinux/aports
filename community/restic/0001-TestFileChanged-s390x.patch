--- a/internal/archiver/archiver_test.go
+++ b/internal/archiver/archiver_test.go
@@ -568,6 +568,13 @@
 
 // sleep sleeps long enough to ensure a timestamp change.
 func sleep() {
+	// inode timestamps advance once per kernel ticks.
+	// s390x kernels' CONFIG_HZ_100=y set a jiffy as 10ms.
+	// so waiting 5ms won't be enough. we wait a double jiffy.
+	if runtime.GOARCH == "s390x" {
+		time.Sleep(20 * time.Millisecond)
+		return
+	}
 	time.Sleep(5 * time.Millisecond)
 }
 
