maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=node-tailwindcss-oxide
pkgver=4.1.11
pkgrel=0
_detectlibc=2.1.2
pkgdesc="Tailwind CSS scanner and extractor"
url="https://tailwindcss.com/"
arch="all !armv7 !armhf !ppc64le !riscv64 !x86"
license="MIT AND Apache-2.0"
depends="nodejs"
makedepends="cargo"
# Use .npmtgz to avoid unpack(); all these would unpack overlapping files.
source="tailwindcss-$pkgver.tar.gz::https://github.com/tailwindlabs/tailwindcss/archive/refs/tags/v$pkgver.tar.gz
	oxide-npm-$pkgver.npmtgz::https://registry.npmjs.org/@tailwindcss/oxide/-/oxide-$pkgver.tgz
	detect-libc-$_detectlibc.npmtgz::https://registry.npmjs.org/detect-libc/-/detect-libc-$_detectlibc.tgz
	musl-targets.patch.noauto
	"
builddir="$srcdir/tailwindcss-$pkgver"
options="net" # cargo fetch

case "$CARCH" in
aarch64) _target=linux-arm64-musl ;;
loongarch64) _target=linux-loong64-musl ;;
s390x) _target=linux-s390x-musl ;;
x86_64) _target=linux-x64-musl ;;
esac

prepare() {
	default_prepare

	cargo fetch --locked --target="$CTARGET"
}

build() {
	cargo build --release --frozen --package tailwind-oxide
}

_install() {
	mkdir -p "$1/node_modules/detect-libc"
	mkdir -p "$1/node_modules/@tailwindcss/oxide"
	tar -xzf "$SRCDEST/oxide-npm-$pkgver.npmtgz" -C "$1/node_modules/@tailwindcss/oxide" --strip-components=1
	tar -xzf "$SRCDEST/detect-libc-$_detectlibc.npmtgz" -C "$1/node_modules/detect-libc" --strip-components=1
	patch -p1 -d "$1/node_modules/@tailwindcss/oxide" -i "$srcdir"/musl-targets.patch.noauto
	rm -r "$1/node_modules/@tailwindcss/oxide/scripts"
	install -Dm755 "$builddir"/target/release/libtailwind_oxide.so \
		"$1/node_modules/@tailwindcss/oxide/tailwindcss-oxide.$_target.node"
}

check() {
	_install "$srcdir/check"
	cd "$srcdir/check"
	node -e '
		const { Scanner } = require("@tailwindcss/oxide");
		const found = new Scanner({}).scanFiles([
			{ content: `<div class="flex underline">x</div>`, extension: "html" }
		]);
		console.log("candidates:", found);
		for (const c of ["flex", "underline"])
			if (!found.includes(c)) throw new Error("missing candidate: " + c);
	'
}

package() {
	_install "$pkgdir/usr/share"
	install -Dm644 "$pkgdir"/usr/share/node_modules/@tailwindcss/oxide/LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

