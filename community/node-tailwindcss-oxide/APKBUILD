92b5e302292268548f68afc5900413e544f1dd5a2b9906a2679841165259f54150181febc20d4c648847006f6c98c4114ddc89c4fe90b7933032d772539156ac  oxide-npm-4.3.3.npmtgz
0bd584731a833db9a257004b4f8b66bdfb358bdf27ad9ce9a58db55ed6f47ceb4bff37ec70a2289c85d3d845ff8d38037dff2189f8746134f850d3edd4d527bc  musl-targets.patch.noauto
"
