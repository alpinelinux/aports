diff --git a/index.js b/index.js
index 6fcf962a3f..6e09cc0621 100644
--- a/index.js
+++ b/index.js
@@ -311,7 +311,20 @@ function requireNative() {
 
       }
     } else if (process.arch === 'ppc64') {
+      if (isMusl()) {
+        try {
+        return require('./tailwindcss-oxide.linux-ppc64-musl.node')
+      } catch (e) {
+        loadErrors.push(e)
+      }
       try {
+        return require('@tailwindcss/oxide-linux-ppc64-musl')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+
+      } else {
+        try {
         return require('./tailwindcss-oxide.linux-ppc64-gnu.node')
       } catch (e) {
         loadErrors.push(e)
@@ -322,8 +335,22 @@ function requireNative() {
         loadErrors.push(e)
       }
 
+      }
     } else if (process.arch === 's390x') {
+      if (isMusl()) {
+        try {
+        return require('./tailwindcss-oxide.linux-s390x-musl.node')
+      } catch (e) {
+        loadErrors.push(e)
+      }
       try {
+        return require('@tailwindcss/oxide-linux-s390x-musl')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+
+      } else {
+        try {
         return require('./tailwindcss-oxide.linux-s390x-gnu.node')
       } catch (e) {
         loadErrors.push(e)
@@ -334,6 +361,39 @@ function requireNative() {
         loadErrors.push(e)
       }
 
+      }
+    } else if (process.arch === 'loong64') {
+      if (isMusl()) {
+        try {
+        return require('./tailwindcss-oxide.linux-loong64-musl.node')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+      try {
+        return require('@tailwindcss/oxide-linux-loong64-musl')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+
+      } else {
+        loadErrors.push(new Error(`Unsupported architecture on Linux: ${process.arch} (glibc)`))
+      }
+    } else if (process.arch === 'ia32') {
+      if (isMusl()) {
+        try {
+        return require('./tailwindcss-oxide.linux-i586-musl.node')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+      try {
+        return require('@tailwindcss/oxide-linux-i586-musl')
+      } catch (e) {
+        loadErrors.push(e)
+      }
+
+      } else {
+        loadErrors.push(new Error(`Unsupported architecture on Linux: ${process.arch} (glibc)`))
+      }
     } else {
       loadErrors.push(new Error(`Unsupported architecture on Linux: ${process.arch}`))
     }
