# Contributor: Justin Berthault <justin.berthault@zaclys.net>
# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: Runxi Yu <me@runxiyu.org>
maintainer="Runxi Yu <me@runxiyu.org>"
pkgname=stagit
pkgver=1.3
pkgrel=0
pkgdesc="Static git page generator"
url="https://www.codemadness.org/stagit.html"
arch="all"
license="MIT"
makedepends="libgit2-dev"
subpackages="$pkgname-doc"
source="https://codemadness.org/releases/stagit/stagit-$pkgver.tar.gz"
options="!check" # No tests exist

build() {
	make
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" MANPREFIX=/usr/share/man install
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

doc() {
	default_doc

	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/17605
	mkdir -p usr/share/doc/stagit
	cd "$subpkgdir"/usr/share/doc/stagit
	mv -v style.css logo.png favicon.png \
		"$pkgdir"/usr/share/doc/stagit/
}

sha512sums="
c2008409b093b4e62575237aa518b761dde06f815a9a612558157527c8b48310c481a44d679343adb1a36a3b52c028798c091b6f69647fa4157d4b0e504ed8cb  stagit-1.3.tar.gz
"
