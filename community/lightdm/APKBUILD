# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=lightdm
pkgver=1.33.0
pkgrel=0
pkgdesc="cross-desktop display manager"
url="https://www.freedesktop.org/wiki/Software/LightDM"
arch="all"
license="GPL-3.0-or-later"
depends="
	accountsservice
	adwaita-icon-theme
	dbus
	xinit
	"
makedepends="
	autoconf
	automake
	gobject-introspection-dev
	gtk+3.0-dev
	gtk-doc
	intltool
	itstool
	libgcrypt-dev
	libtool
	libxext-dev
	libxklavier-dev
	libxml2-utils
	linux-pam-dev
	vala
	yelp-tools
	"
install="$pkgname.pre-install"
pkgusers="lightdm"
pkggroups="lightdm"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-openrc
	$pkgname-bash-completion
	$pkgname-systemd
	"
source="lightdm-$pkgver.tar.gz::https://github.com/ubuntu/lightdm/archive/refs/tags/$pkgver.tar.gz
	https://github.com/ubuntu/lightdm/raw/refs/tags/$pkgver/debian/lightdm.service
	musl-language.patch
	musl-is-linux.patch
	musl-updwtmpx.patch
	disallow-guest.patch
	pam-rules.patch
	systemd-service-un-debianize.patch
	lightdm.initd
	"

prepare() {
	cp "$srcdir"/lightdm.service "$builddir"
	default_prepare
}

build() {
	export CFLAGS="$CFLAGS -D_GNU_SOURCE"
	./autogen.sh
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sbindir=/usr/bin \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-tests \
		--enable-vala \
		--with-greeter-session=lightdm-gtk-greeter

	make
}

package() {
	make DESTDIR="$pkgdir" install
	ln -s /etc/X11/xinit/Xsession "$pkgdir"/usr/bin/lightdm-session
	install -Dm755 "$srcdir"/lightdm.initd "$pkgdir"/etc/init.d/lightdm
	install -Dm750 -o lightdm -g lightdm -d "$pkgdir"/var/lib/lightdm
	install -o lightdm -g lightdm -d "$pkgdir"/var/lib/lightdm-data
	rm -rf "$pkgdir"/etc/apparmor.d
	install -Dm644 lightdm.service -t "$pkgdir"/usr/lib/systemd/system/
}

