# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=py3-invoke
pkgver=3.0.3
pkgrel=0
pkgdesc="Pythonic task execution"
url="https://www.pyinvoke.org/"
arch="noarch"
license="BSD-2-Clause"
depends="py3-yaml"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-icecream
	py3-pytest-relaxed
	util-linux-misc
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/pyinvoke/invoke/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/invoke-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# Use script command to work around OSError: [Errno 25] Not a tty
	SHELL=/bin/sh script --return --quiet /dev/null \
		-c ".testenv/bin/python3 -m pytest --capture=no"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7c6703b9494e9baae12110cf006eab8897b61a7e00fee5aaedc54d4227fe1fc44707246fdf7dc5b37fb3025b25401476c0f9aa84f013b32872ee409f6e5fab84  py3-invoke-3.0.3.tar.gz
"
