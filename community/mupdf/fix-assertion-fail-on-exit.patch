From 890cab188505499b25656b8ed3368b30269d4413 Mon Sep 17 00:00:00 2001
From: Tor Andersson <tor.andersson@artifex.com>
Date: Wed, 19 Aug 2026 13:41:54 +0200
Subject: [PATCH] Fix assert crash when exiting x11 viewer.

Don't drop the context inside the try/catch block!
---
 platform/x11/x11_main.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/platform/x11/x11_main.c b/platform/x11/x11_main.c
index eb6fc09c2b..4f06372bf7 100644
--- a/platform/x11/x11_main.c
+++ b/platform/x11/x11_main.c
@@ -376,8 +376,6 @@ void wincopyfile(pdfapp_t *app, char *source, char *target)
 
 static void cleanup(pdfapp_t *app)
 {
-	fz_context *ctx = app->ctx;
-
 	pdfapp_close(app);
 
 	XDestroyWindow(xdpy, xwin);
@@ -392,8 +390,6 @@ static void cleanup(pdfapp_t *app)
 	XFreeGC(xdpy, xgc);
 
 	XCloseDisplay(xdpy);
-
-	fz_drop_context(ctx);
 }
 
 static int winresolution(void)
@@ -1213,13 +1209,14 @@ int main(int argc, char **argv)
 		}
 
 		cleanup(&gapp);
-
 	}
 	fz_catch(ctx)
 	{
 		fz_report_error(ctx);
+		fz_drop_context(ctx);
 		return 1;
 	}
 
+	fz_drop_context(ctx);
 	return 0;
 }
