# Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
# Maintainer: Fabian Affolter <fabian@affolter-engineering.ch>
pkgname=py3-paramiko
pkgver=5.0.0
pkgrel=0
pkgdesc="SSH2 protocol library for Python3"
url="https://www.paramiko.org/"
arch="noarch"
license="LGPL-2.0-or-later"
depends="
	py3-bcrypt
	py3-cryptography
	py3-invoke
	py3-pynacl
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-icecream
	py3-pytest-relaxed
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/paramiko/paramiko/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/paramiko-$pkgver"

# the doc subpackage is gone: demos/ was its only content and 5.0.0 drops it
replaces="py-paramiko $pkgname-doc" # Backwards compatibility
provides="py-paramiko=$pkgver-r$pkgrel
	$pkgname-doc=$pkgver-r$pkgrel
	" # Backwards compatibility

# secfixes:
#   3.4.0-r0:
#     - CVE-2023-48795
#   2.4.2-r0:
#     - CVE-2018-1000805
#   2.4.1-r0:
#     - CVE-2018-7750

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -W ignore::DeprecationWarning
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
8130c0341e6ab39e8eb0f5ad187ecda2fb14db44995ccffbc3db0bb3cd568daca750224c3cbf4724b7ac503624b2fa72e78ad57e2218e69d471a43cfa8b4e63e  py3-paramiko-5.0.0.tar.gz
"
