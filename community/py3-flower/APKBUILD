_pyname=flower
pkgname="py3-$_pyname"
pkgver=2.1.0
pkgrel=0
arch="noarch"
pkgdesc="Real-time monitor and web admin for Celery distributed task queue"
url="https://flower.readthedocs.io/"
license="BSD-3-Clause"
depends="
	py3-redis
	py3-humanize
	py3-prometheus-client
	py3-click
	py3-tz
	"
makedepends="
	py3-setuptools
	py3-gpep517
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-tornado
	py3-celery
	"
source="$pkgname-$pkgver.tar.gz::https://pypi.io/packages/source/f/flower/flower-$pkgver.tar.gz"
builddir="$srcdir"/$_pyname-$pkgver
subpackages="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	pytest -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
a49fe53333d90884c2882c6b6d489c6a6850f83792fa31b1eea761dcd64744a1cf18d6b37364b3c1abd10add23039b9a4f37d4162f7f356a4babccc83c9b25eb  py3-flower-2.1.0.tar.gz
"
