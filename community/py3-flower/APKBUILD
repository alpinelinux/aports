_pyname=flower
pkgname="py3-$_pyname"
pkgver=2.2.0
pkgrel=0
arch="noarch"
pkgdesc="Real-time monitor and web admin for Celery distributed task queue"
url="https://flower.readthedocs.io/"
license="BSD-3-Clause"
depends="
	py3-redis
	py3-humanize
	py3-prometheus-client
	py3-click
	py3-tz
	"
makedepends="
	py3-setuptools
	py3-gpep517
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-tornado
	py3-celery
	"
source="$pkgname-$pkgver.tar.gz::https://pypi.io/packages/source/f/flower/flower-$pkgver.tar.gz"
builddir="$srcdir"/$_pyname-$pkgver
subpackages="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	pytest -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
918cb0634687a469cd64be0aed430d2119bf9e913d36090626afc61b2ad04d392a16e8273d4b9b60319039a3ba6078d5e1c971f24aa764497518e600c5ca4f0c  py3-flower-2.2.0.tar.gz
"
