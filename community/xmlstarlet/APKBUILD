pkgname=xmlstarlet
pkgver=1.7.0
pkgrel=0
pkgdesc="A set of tools to transform, query, validate, and edit XML documents"
url="https://xmlstarlet.github.io/"
arch="all"
license="MIT"
makedepends="ghostscript libxml2-dev libxslt-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/xmlstarlet/xmlstarlet/releases/download/$pkgver/xmlstarlet-$pkgver.tar.gz"

build() {
	LIBXSLT_PREFIX=/usr \
	LIBXML_PREFIX=/usr \
	./configure \
		--prefix=/usr \
		--enable-build-docs
	make
}

check() {
	make qcheck
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	ln -s xml $pkgdir/usr/bin/xmlstarlet
	install -Dm0644 Copyright $pkgdir/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
