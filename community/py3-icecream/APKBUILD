# Contributor: Leon White <badfunkstripe@gmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=py3-icecream
pkgver=2.2.0
pkgrel=0
pkgdesc="Never use print() to debug again"
url="https://github.com/gruns/icecream"
arch="noarch"
license="MIT"
depends="
	py3-asttokens
	py3-colorama
	py3-executing
	py3-pygments
	"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/gruns/icecream/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/icecream-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
98850b5c674527f762ab1bf8b290870e9d66d2872756c17cd60eedf74fec0a942c9256b9a4acd552455fd99ca2a1095f3d330b0cbad0b317066676ab234675e2  py3-icecream-2.2.0.tar.gz
"
