# Contributor: mio <miyopan@e.email>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=nomacs
pkgver=3.23.4
pkgrel=0
pkgdesc="Cross platform image viewer"
url="https://nomacs.org/"
license="GPL-3.0-or-later"
# s390x: blocked by opencv
arch="all !s390x"
makedepends="
	cmake
	exiv2-dev
	libraw-dev
	libjxl-dev
	libwebp-dev
	libzip-dev
	opencv-dev
	qt6-qt5compat-dev
	qt6-qtbase-dev
	qt6-qtsvg-dev
	qt6-qttools-dev
	quazip-dev
	samurai
	tiff-dev
	"
subpackages="$pkgname-doc $pkgname-lang"
source="nomacs-$pkgver.tar.gz::https://github.com/nomacs/nomacs/archive/$pkgver.tar.gz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja -S ImageLounge \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_INCREMENTER=OFF \
		-DENABLE_JXL=ON \
		-DENABLE_QUAZIP=ON \
		-DENABLE_TRANSLATIONS=TRUE \
		-DQT_VERSION_MAJOR=6 \
		-DUSE_SYSTEM_QUAZIP=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

lang() {
	pkgdesc="translations for $pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel lang"

	mkdir -p "$subpkgdir/usr/share/nomacs/Image Lounge/"
	mv "$pkgdir/usr/share/nomacs/Image Lounge/translations/" \
		"$subpkgdir/usr/share/nomacs/Image Lounge/"
}

sha512sums="
0f9190120e0126af0176d3c0edfc8362d07f273ba5460daf4a375cd56d44813bc539c846a4ec99522153a0044c2d6d01983862226c5fe9d70b5113f2a94044a9  nomacs-3.23.4.tar.gz
"
