# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-pkg-config
_gemname=pkg-config
pkgver=1.6.8
pkgrel=0
pkgdesc="pkg-config implemented by pure Ruby"
url="https://github.com/ruby-gnome/pkg-config"
arch="noarch"
license="LGPL-2.0-or-later"
depends="ruby"
checkdepends="
	cairo-dev
	ruby-dev
	ruby-test-unit
	"
source="https://github.com/ruby-gnome/pkg-config/archive/$pkgver/ruby-pkg-config-$pkgver.tar.gz"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
}

check() {
	# test_cflags*: pkg-config returns -I flags in a different order.
	ruby test/run.rb \
		--ignore-name test_cflags \
		--ignore-name test_cflags_only_I \
		--verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r cache build_info doc extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm -r Gemfile LGPL* NEWS.* README.* Rakefile test/
}

sha512sums="
eb41a022b29c22f7bc22b93a74c7f4f86359d6936b6a370bbf8a7cf3f014fcfd1ec2887f91114b4ba9886cbcc99c5ce366e1bfd528af0f0a180a32e7b53f7290  ruby-pkg-config-1.6.8.tar.gz
"
