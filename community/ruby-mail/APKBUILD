# Maintainer: Iztok Fister, Jr. <iztok@iztok-jr-fister.eu>
pkgname=ruby-mail
_gemname=${pkgname#ruby-}
pkgver=2.9.1
pkgrel=0
pkgdesc="A Really Ruby Mail Library"
url="https://github.com/mikel/mail"
arch="noarch"
license="MIT"
depends="
	ruby
	ruby-logger
	ruby-mini_mime
	ruby-net-imap
	ruby-net-pop
	ruby-net-smtp
	"
checkdepends="ruby-rspec"
source="$pkgname-$pkgver.tar.gz::https://github.com/mikel/$_gemname/archive/$pkgver/$_gemname-$pkgver.tar.gz
	fix-version.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

# secfixes:
#   2.9.1-r0:
#     - CVE-2026-63435

build() {
	gem build $_gemname.gemspec
}

check() {

	sed -i -e '/require..rspec.benchmark/ s/^/#/' \
		-e '/include.RSpec..Benchmark/ s/^/#/' \
	spec/spec_helper.rb
	rspec spec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files.
	cd "$gemdir"
	rm -r cache/ build_info/ doc/ extensions/
	rmdir plugins || true
}

