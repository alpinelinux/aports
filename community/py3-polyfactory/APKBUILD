maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-polyfactory
pkgver=3.3.0
pkgrel=0
pkgdesc="Mock data generation factories"
url="https://github.com/litestar-org/polyfactory"
arch="noarch"
license="MIT"
depends="
	py3-faker
	py3-typing-extensions
	"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-aiosqlite
	py3-annotated-types
	py3-hypothesis
	py3-mongo
	py3-pydantic
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-cov
	py3-sqlalchemy
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://pypi.python.org/packages/source/p/polyfactory/polyfactory-$pkgver.tar.gz"
options="!check" # Pytest refuses to deselect tests
builddir="$srcdir/polyfactory-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest \
		# requires unpackaged msgspec \
		--deselect tests/test_msgspec_factory.py \
		--deselect tests/test_optional_model_field_inference.py \
		# requires unpackaged beanie \
		--deselect tests/test_beanie_factory.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
acea2fd2221024710ce0e6683b10d6af36214d87672b6f0293298de4a4abdf6d9cd2905132d8a42012bdc949cd591522719499924f18b8ce200fc077df9e7dc5  py3-polyfactory-3.3.0.tar.gz
"
