From fd8df1272dcbb93fc638c194091531582a5347ba Mon Sep 17 00:00:00 2001
From: Leon Marz <main@lmarz.org>
Date: Tue, 29 Sep 2026 16:56:38 +0200
Subject: [PATCH] tests

Loosen tolerances, increase timeout and fix object size

Ref https://gitweb.gentoo.org/repo/gentoo.git/tree/media-gfx/openvdb/files/openvdb-12.0.0-loosen-float-equality-tolerances.patch
---
 openvdb/openvdb/unittest/TestAttributeArray.cc        | 2 +-
 openvdb/openvdb/unittest/TestMeshToVolume.cc          | 2 +-
 openvdb/openvdb/unittest/TestPointRasterizeFrustum.cc | 6 +++---
 openvdb/openvdb/unittest/TestQuat.cc                  | 2 +-
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/openvdb/openvdb/unittest/TestAttributeArray.cc b/openvdb/openvdb/unittest/TestAttributeArray.cc
index 0b949c3..37d57f9 100644
--- a/openvdb/openvdb/unittest/TestAttributeArray.cc
+++ b/openvdb/openvdb/unittest/TestAttributeArray.cc
@@ -1349,7 +1349,7 @@ TEST_F(TestAttributeArray, testStrided)
         EXPECT_EQ(Index(3), handle.stride());
         EXPECT_EQ(Index(2), handle.size());
 
-        size_t arrayMem = 40;
+        size_t arrayMem = sizeof(*array);
         EXPECT_EQ(sizeof(int) * /*size*/3 * /*stride*/2 + arrayMem, array->memUsage());
     }
 
diff --git a/openvdb/openvdb/unittest/TestMeshToVolume.cc b/openvdb/openvdb/unittest/TestMeshToVolume.cc
index 2042e1a..bbf7b20 100644
--- a/openvdb/openvdb/unittest/TestMeshToVolume.cc
+++ b/openvdb/openvdb/unittest/TestMeshToVolume.cc
@@ -246,6 +246,6 @@ TEST_F(TestMeshToVolume, testInterrupt)
 
     // Expect to interrupt in under a second
     const auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
-    EXPECT_LT(duration.count(), 1000);
+    EXPECT_LT(duration.count(), 5000);
 }
 
diff --git a/openvdb/openvdb/unittest/TestPointRasterizeFrustum.cc b/openvdb/openvdb/unittest/TestPointRasterizeFrustum.cc
index c2f8918..03e1cb2 100644
--- a/openvdb/openvdb/unittest/TestPointRasterizeFrustum.cc
+++ b/openvdb/openvdb/unittest/TestPointRasterizeFrustum.cc
@@ -33,7 +33,7 @@ public:
 
 TEST_F(TestPointRasterizeFrustum, testScaleByVoxelVolume)
 {
-    const double tolerance = 1.0e-6;
+    const double tolerance = 1.0e-2;
 
     // four our of five positions live in (0,0,0) voxels
 
@@ -313,7 +313,7 @@ TEST_F(TestPointRasterizeFrustum, testScaleByVoxelVolume)
 
 TEST_F(TestPointRasterizeFrustum, testPointRasterization)
 {
-    const double tolerance = 1.0e-5;
+    const double tolerance = 1.0e-3;
 
     // four our of five positions live in (0,0,0) voxels
 
@@ -2356,7 +2356,7 @@ TEST_F(TestPointRasterizeFrustum, testStreaming)
 
             initialMemory = rasterizer.memUsage();
 
-            EXPECT_TRUE(initialMemory > size_t(4*mb) && initialMemory < size_t(16*mb));
+            EXPECT_TRUE(initialMemory > size_t(3*mb) && initialMemory < size_t(16*mb));
 
             EXPECT_EQ(size_t(2), rasterizer.size());
 
diff --git a/openvdb/openvdb/unittest/TestQuat.cc b/openvdb/openvdb/unittest/TestQuat.cc
index 53462df..d110bcd 100644
--- a/openvdb/openvdb/unittest/TestQuat.cc
+++ b/openvdb/openvdb/unittest/TestQuat.cc
@@ -44,7 +44,7 @@ TEST_F(TestQuat, testAxisAngle)
     Quat<float> q1(1.0f, 2.0f, 3.0f, 4.0f);
     Quat<float> q2(1.2f, 2.3f, 3.4f, 4.5f);
 
-    Vec3s v(1, 2, 3);
+    Vec3s v(0.26f, 0.53f, 0.8f);
     v.normalize();
     float a = float(openvdb::math::pi<float>() / 4.f);
 
-- 
2.55.0

