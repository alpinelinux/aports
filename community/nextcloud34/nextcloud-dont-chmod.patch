From e8756f3b621dbe3abc9fa7091369ad931ea090c5 Mon Sep 17 00:00:00 2001
From: Leonardo Arena <rnalrd@alpinelinux.org>
Date: Fri, 12 Jun 2026 18:06:12 +0000
Subject: [PATCH] don't chmod

---
 lib/private/Log/File.php       | 3 ---
 lib/private/legacy/OC_Util.php | 1 -
 2 files changed, 4 deletions(-)

diff --git a/lib/private/Log/File.php b/lib/private/Log/File.php
index 014c0d07..85165508 100644
--- a/lib/private/Log/File.php
+++ b/lib/private/Log/File.php
@@ -49,9 +49,6 @@ class File extends LogDetails implements IWriter, IFileBased {
 	public function write(string $app, $message, int $level): void {
 		$entry = $this->logDetailsAsJSON($app, $message, $level);
 		$handle = @fopen($this->logFile, 'a');
-		if ($this->logFileMode > 0 && is_file($this->logFile) && (fileperms($this->logFile) & 0777) !== $this->logFileMode) {
-			@chmod($this->logFile, $this->logFileMode);
-		}
 		if ($handle) {
 			fwrite($handle, $entry . "\n");
 			fclose($handle);
diff --git a/lib/private/legacy/OC_Util.php b/lib/private/legacy/OC_Util.php
index b9c91a83..5c2c55f8 100644
--- a/lib/private/legacy/OC_Util.php
+++ b/lib/private/legacy/OC_Util.php
@@ -459,7 +459,6 @@ class OC_Util {
 
 		$perms = substr(decoct(@fileperms($dataDirectory)), -3);
 		if (substr($perms, -1) !== '0') {
-			chmod($dataDirectory, 0770);
 			clearstatcache();
 			$perms = substr(decoct(@fileperms($dataDirectory)), -3);
 			if ($perms[2] !== '0') {
-- 
