6c44a8979801dc8fd6c8fe9b3c8f4bc83d19d5f4267a7bc62faea3df4e15d048de26d7299cdbf7988cb96a2a65d980169a2e5350fddba7a58d0835661dea213f  do-not-invoke-git.patch
