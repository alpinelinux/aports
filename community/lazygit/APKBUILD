26d3e48cabde3256ec8ae88e9b575683027db3480fb43f470009fe29925dcb13af95a474194aa32a27cfe46fb8cc01674a8a4a9e1dfdd1b810ab797eeec142b4  x-sys-ppc64le-pie-fix.patch
"
