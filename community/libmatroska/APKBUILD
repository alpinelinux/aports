# Maintainer: Timo Teräs <timo.teras@iki.fi>
pkgname=libmatroska
pkgver=1.7.2
pkgrel=0
pkgdesc="Extensible multimedia container format based on EBML"
url="https://www.matroska.org/"
arch="all"
options="!check"  # Tests don't build; 'make check' target disabled by upstream
license="LGPL-2.1-or-later"
makedepends="cmake libebml-dev>=1.4.3 samurai"
subpackages="$pkgname-dev"
source="https://dl.matroska.org/downloads/libmatroska/libmatroska-$pkgver.tar.xz"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		CMAKE_CROSSOPTS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	CXXFLAGS="$CXXFLAGS -flto=auto" \
	cmake3.5 -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=None \
		$CMAKE_CROSSOPTS
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
86b21a0ff3e5149a2824a9f21f9460179d02aecf477f2b9f1f92ce2f991033bd0cb209d81a4aeee2c0c5ffc193dac57a84dd4f529939b12c900f2cfb881618fb  libmatroska-1.7.2.tar.xz
"
