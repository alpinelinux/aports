diff --git a/Cargo.toml b/Cargo.toml
index 5621c940c5..37a0997002 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -376,9 +376,6 @@ datadog-agent-metrics-v3 = { workspace = true, optional = true }
