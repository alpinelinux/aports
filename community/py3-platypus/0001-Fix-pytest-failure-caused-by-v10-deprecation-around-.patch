Patch-Source: https://github.com/Project-Platypus/Platypus/commit/b4be3e1508136720c9208e89c0d406ff5dc22101
From b4be3e1508136720c9208e89c0d406ff5dc22101 Mon Sep 17 00:00:00 2001
From: David Hadka <dhadka@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:55:47 -0600
Subject: [PATCH] Fix pytest failure caused by v10 deprecation around generator
 input (#270)

* Fix pytest failure caused by v10 deprecation around generator input

* Add keys=True to jsonpickle
---
 platypus/io.py                    |  4 ++--
 platypus/tests/test_algorithms.py | 10 +++++++---
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/platypus/io.py b/platypus/io.py
index f30c00e..ae0c2b8 100644
--- a/platypus/io.py
+++ b/platypus/io.py
@@ -244,7 +244,7 @@ def save_state(file, algorithm, json=False, indent=None):
     if json:
         import jsonpickle
         with open(os.fspath(file), "w") as f:
-            f.write(jsonpickle.dumps(state, indent=indent))
+            f.write(jsonpickle.dumps(state, indent=indent, keys=True))
     else:
         with open(os.fspath(file), "wb") as f:
             f.write(pickle.dumps(state))
@@ -269,7 +269,7 @@ def load_state(file, update_rng=True):
                 content = f.read()
 
             import jsonpickle
-            state = jsonpickle.loads(content)
+            state = jsonpickle.loads(content, keys=True)
         except UnicodeDecodeError:
             # Fall back to using the binary format (this error likely indicates
             # the file is missing the UTF-8 byte order mark)
diff --git a/platypus/tests/test_algorithms.py b/platypus/tests/test_algorithms.py
index 0eafda9..751ac05 100644
--- a/platypus/tests/test_algorithms.py
+++ b/platypus/tests/test_algorithms.py
@@ -52,6 +52,8 @@ algorithms = {
 constraints_not_supported = {IBEA}
 
 def create_instances():
+    instances = []
+
     for problem in problems:
         for algorithm in algorithms.keys():
             for i, kwargs in enumerate(algorithms[algorithm]):
@@ -61,7 +63,9 @@ def create_instances():
                 if algorithm in constraints_not_supported and p.nconstrs > 0:
                     continue
 
-                yield pytest.param(algorithm(p, **kwargs), id=id)
+                instances.append(pytest.param(algorithm(p, **kwargs), id=id))
+
+    return instances
 
 @pytest.mark.parametrize("algorithm", create_instances())
 def test_pickle(algorithm):
@@ -71,8 +75,8 @@ def test_pickle(algorithm):
 
 @pytest.mark.parametrize("algorithm", create_instances())
 def test_jsonpickle(algorithm):
-    s = jsonpickle.dumps(algorithm)
-    copy = jsonpickle.loads(s)
+    s = jsonpickle.dumps(algorithm, keys=True)
+    copy = jsonpickle.loads(s, keys=True)
     similar(algorithm, copy)
 
 @pytest.mark.parametrize("algorithm", create_instances())
-- 
