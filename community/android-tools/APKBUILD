# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Maintainer: Sören Tempel <soeren+alpine@soeren-tempel.net>
pkgname=android-tools
pkgver=37.0.0_p1
_realver=${pkgver/_/}
pkgrel=0
pkgdesc="Android platform tools"
url="https://sites.google.com/a/android.com/tools/"
# s390x: Unsupported by vendored BoringSSL
arch="all !s390x"
license="Apache-2.0 MIT"
options="!check" # upstream doesn't have a test suite
depends="
	$pkgname-adb
	$pkgname-append2simg
	$pkgname-avbtool
	$pkgname-e2fsdroid
	$pkgname-ext2simg
	$pkgname-fastboot
	$pkgname-img2simg
	$pkgname-lpadd
	$pkgname-lpdump
	$pkgname-lpflash
	$pkgname-lpmake
	$pkgname-lpunpack
	$pkgname-make_f2fs
	$pkgname-mkbootimg
	$pkgname-mkdtboimg
	$pkgname-mke2fs.android
	$pkgname-repack_bootimg
	$pkgname-simg2img
	$pkgname-sload_f2fs
	$pkgname-unpack_bootimg
	"
makedepends="corrosion pcre2-dev linux-headers libusb-dev gtest-dev cmake
	protobuf-dev brotli-dev zstd-dev lz4-dev samurai abseil-cpp-dev fmt-dev"
subpackages="
	$pkgname-adb:_command
	$pkgname-append2simg:_command
	$pkgname-avbtool:_command
	$pkgname-bash-completion:bashcomp:noarch
	$pkgname-doc
	$pkgname-e2fsdroid:_command
	$pkgname-ext2simg:_command
	$pkgname-fastboot:_command
	$pkgname-img2simg:_command
	$pkgname-lpadd:_command
	$pkgname-lpdump:_command
	$pkgname-lpflash:_command
	$pkgname-lpmake:_command
	$pkgname-lpunpack:_command
	$pkgname-make_f2fs:_command
	$pkgname-mkbootimg
	$pkgname-mkdtboimg:_command
	$pkgname-mke2fs.android:_command
	$pkgname-repack_bootimg:_command
	$pkgname-simg2img:_command
	$pkgname-sload_f2fs:_command
	$pkgname-unpack_bootimg:_command
	$pkgname-zsh-completion
	"
source="https://github.com/nmeum/android-tools/releases/download/$_realver/android-tools-$_realver.tar.xz"
builddir="$srcdir/android-tools-$_realver"
options="net" # net required to download Rust dependencies

build() {
	LDFLAGS="$LDFLAGS -Wl,--copy-dt-needed-entries" \
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=None \
		-DANDROID_TOOLS_ADB_ENABLE_MDNS=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

bashcomp() {
	default_bashcomp
	amove usr/share/android-tools/completions
}

_command() {
	local binary_name=${subpkgname##*-}
	pkgdesc="$pkgdesc ($binary_name)"
	# Some need it
	depends="python3"

	amove usr/bin/"$binary_name"
}

mkbootimg() {
	pkgdesc="$pkgdesc (mkbootimg)"
	depends="python3"

	amove usr/bin/mkbootimg
	amove usr/share/android-tools
}

sha512sums="
f2943637cb399ea7a4c11ede8a25b002f8b8ae20833434944c0e32a61f77357de1e7bd71c70f9c25ea6abc8002be3d81fd199620e1a013bec6bdeb82580ba239  android-tools-37.0.0p1.tar.xz
"
