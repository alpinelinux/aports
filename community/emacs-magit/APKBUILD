# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer:
pkgname=emacs-magit
pkgver=4.7.2
pkgrel=0
_pkgreal=magit
pkgdesc="Emacs interface for Git"
url="https://magit.vc/"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	cmd:emacs
	cmd:git
	emacs-cond-let
	emacs-dash
	emacs-git-commit
	emacs-llama
	emacs-magit-section
	emacs-with-editor
	"
makedepends="emacs-nox"
subpackages="
	emacs-git-commit
	emacs-magit-section
	"
source="https://github.com/magit/magit/archive/v$pkgver/magit-v$pkgver.tar.gz"
builddir="$srcdir/$_pkgreal-$pkgver/lisp"

build() {
	emacs -batch -q -no-site-file -L . \
		-f batch-byte-compile \
		./*.el
}

check() {
	# Export a UTF-8 value for LANG to avoid magit-status:file-sections test
	# failing on filenames with accented characters
	LANG="C.UTF-8" emacs -batch -q -no-site-file -L . -L ../lisp \
		-l ../test/magit-tests -f ert-run-tests-batch-and-exit
}

package() {
	install -Dvm644 ./*.el ./*.elc \
		-t "$pkgdir"/usr/share/emacs/site-lisp/magit/

	cd "$pkgdir"/usr/share/emacs/site-lisp/magit
	emacs -batch -q -no-site-file \
		-eval "(loaddefs-generate \".\" \"$_pkgreal-loaddefs.el\")"
}

commit() {
	pkgdesc="Major mode for editing Git commit messages"
	depends="cmd:emacs emacs-dash emacs-with-editor"

	amove usr/share/emacs/site-lisp/magit/git-commit.el*
}

section() {
	pkgdesc="Collapsible sections like in Magit"
	depends="cmd:emacs emacs-dash"

	amove usr/share/emacs/site-lisp/magit/magit-section.el*
}

sha512sums="
1139831b69299e824d8649217485cd8af6ffae690b994aa038a5fd3b95bbb33f34b09423fd2c9ebe9667d42882da4b42075dfbacb88bbed3d613645a3371e71a  magit-v4.7.2.tar.gz
"
