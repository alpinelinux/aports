Don't use git to list files in the gemspec, the source tarball is not
a git repository (and git is not available at build time).

Package only lib/ and the executable bin/httparty.

--- a/httparty.gemspec
+++ b/httparty.gemspec
@@ -23,13 +23,7 @@
   # If this line is removed, all hard partying will cease.
   s.post_install_message = "When you HTTParty, you must party hard!"
 
-  all_files = `git ls-files`.split("\n")
-  # Separate pathspecs, not {test,spec,features}/*: backticks run /bin/sh,
-  # and dash (the /bin/sh on Debian and Ubuntu) doesn't expand braces.
-  test_files = `git ls-files -- test spec features`.split("\n")
-  dev_files = `git ls-files -- .github Gemfile Guardfile '.rubocop*' script`.split("\n")
-
-  s.files         = all_files - test_files - dev_files
-  s.executables   = `git ls-files -- bin/*`.split("\n").map { |f| File.basename(f) }
+  s.files         = Dir["lib/**/*", "bin/*"]
+  s.executables   = ["httparty"]
   s.require_paths = ["lib"]
 end
