Patch-Source: https://github.com/rime/librime/commit/1e3ac195f8dce10dd33a8e305f414a1c11b68d44
---
From 1e3ac195f8dce10dd33a8e305f414a1c11b68d44 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E5=B1=85=E6=88=8E=E6=B0=8F?= <chen.sst@gmail.com>
Date: Wed, 25 Nov 2026 22:03:37 +0800
Subject: [PATCH] fix(build): add no_logging build target

---
 Makefile             | 13 ++++++++++++-
 src/rime/candidate.h |  1 +
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index b88895daa8..f6ac740b2b 100644
--- a/Makefile
+++ b/Makefile
@@ -36,12 +36,13 @@ ifndef NOPARALLEL
 endif
 
 debug install-debug uninstall-debug test-debug: build ?= debug
+no_logging: build ?= no_logging
 build ?= build
 
 .PHONY: all deps clean \
 librime librime-static \
 release debug test install uninstall \
-install-debug uninstall-debug
+install-debug uninstall-debug no_logging
 
 all: release
 
@@ -91,6 +92,16 @@ merged-plugins:
 	$(CMAKE_BOOST_OPTIONS)
 	cmake --build $(build)
 
+no_logging:
+	cmake . -B$(build) \
+	-DCMAKE_INSTALL_PREFIX=$(prefix) \
+	-DCMAKE_BUILD_TYPE=Release \
+	-DENABLE_LOGGING=OFF \
+	-DBUILD_MERGED_PLUGINS=OFF \
+	-DENABLE_EXTERNAL_PLUGINS=ON \
+	$(CMAKE_BOOST_OPTIONS)
+	cmake --build $(build)
+
 debug:
 	cmake . -B$(build) \
 	-DCMAKE_INSTALL_PREFIX=$(prefix) \
diff --git a/src/rime/candidate.h b/src/rime/candidate.h
index 4fbd5f34a4..c8f750c458 100644
--- a/src/rime/candidate.h
+++ b/src/rime/candidate.h
@@ -8,6 +8,7 @@
 #define RIME_CANDIDATE_H_
 
 #include <rime/common.h>
+#include <rime_api.h>
 
 namespace rime {
 
