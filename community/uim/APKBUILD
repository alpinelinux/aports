maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=uim
pkgver=1.9.9
pkgrel=0
pkgdesc="Multilingual input method framework"
url="https://github.com/uim/uim"
arch="all"
license="BSD-3-Clause"
makedepends="
	anthy-dev
	gettext-dev
	gtk+3.0-dev
	gtk4.0-dev
	intltool
	ncurses-dev
	qt6-qtbase-dev
	ibus-dev
	"
subpackages="
	$pkgname-anthy
	$pkgname-dev
	$pkgname-doc
	$pkgname-emacs::noarch
	$pkgname-pref
	$pkgname-gtk3
	$pkgname-gtk4
	$pkgname-lang
	"
source="https://github.com/uim/uim/releases/download/$pkgver/uim-$pkgver.tar.gz"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--with-anthy-utf8=yes
	make
}

check() {
	make check
}

package() {
	# -j1 because of dependency errors
	make DESTDIR="$pkgdir" install -j1
}

anthy() {
	pkgdesc="$pkgdesc (anthy integration)"
	depends=
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/uim/plugin/libuim-anthy*.so
	amove usr/share/uim/anthy*.scm
}

gtk3() {
	pkgdesc="$pkgdesc (gtk3 plugin)"
	depends=
	install_if="$pkgname=$pkgver-r$pkgrel gtk+3.0"

	amove usr/bin/uim-*-gtk3*
	amove usr/lib/gtk-3.0
	amove usr/libexec/uim-*-gtk3
}

gtk4() {
	pkgdesc="$pkgdesc (gtk4 plugin)"
	depends=
	install_if="$pkgname=$pkgver-r$pkgrel gtk4.0"

	amove usr/lib/gtk-4.0
}

pref() {
	pkgdesc="$pkgdesc (preferences window)"
	depends=

	amove usr/share/applications
	amove usr/bin/uim-pref-gtk3
}

emacs() {
	pkgdesc="$pkgdesc (emacs plugin)"
	depends=
	install_if="$pkgname=$pkgver-r$pkgrel emacs"

	amove usr/share/emacs
}

sha512sums="
1c179d8b5fdc14f5652f290af2c8c83509e805f0e241c12b607d2dc9bcf17775c7beced57beff80e4bb53050a50fbce373495fe2dcbfde8a78863d56556a06c6  uim-1.9.9.tar.gz
"
