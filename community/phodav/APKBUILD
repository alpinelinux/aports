maintainer="team/gnome <achill@achill.org>"
pkgname=phodav
pkgver=3.2
pkgrel=0
pkgdesc="WebDAV server using libsoup"
url="https://gitlab.gnome.org/GNOME/phodav"
arch="all"
license="LGPL-2.0-or-later"
options="!check" # No test suite
depends="avahi"
makedepends="
	attr-dev
	avahi-dev
	eudev-dev
	gi-docgen
	gobject-introspection-dev
	libsoup3-dev
	libxml2-dev
	meson
	scdoc
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	chezdav
	chezdav-doc:chezdav_doc
	spice-webdavd:spice
	spice-webdavd-openrc:spice_openrc
	spice-webdavd-systemd
	"
source="https://download.gnome.org/sources/phodav/$pkgver/phodav-$pkgver.tar.xz
	spice-webdavd.initd
	"

# secfixes:
#   3.2-r0:
#     - CVE-2026-114417
#     - CVE-2026-114418
#     - CVE-2026-114419

build() {
	abuild-meson \
		-Davahi=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Dsysusersdir=/usr/lib/sysusers.d \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

chezdav() {
	pkgdesc="A simple WebDAV server program"
	amove usr/bin
}

chezdav_doc() {
	pkgdesc="A simple WebDAV server program (documentation)"
	mkdir -p "$subpkgdir"/usr/share
	mv "$pkgdir"/../phodav-doc/usr/share/man "$subpkgdir"/usr/share/
}

spice() {
	pkgdesc="Spice daemon for the DAV channel"
	amove \
		usr/sbin \
		usr/lib/udev
}

spice_openrc() {
	pkgdesc="Spice daemon for the DAV channel (OpenRC init scripts)"
	install_if="spice-webdavd=$pkgver-r$pkgrel openrc"
	mkdir -p "$subpkgdir"/etc/init.d
	install "$srcdir"/spice-webdavd.initd "$subpkgdir"/etc/init.d/spice-webdavd
}

