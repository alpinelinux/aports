# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=py3-solo1
_pkgname=solo1-cli
pkgver=0.1.1
pkgrel=6
pkgdesc="Python3 tool and library for SoloKeys"
url="https://github.com/solokeys/solo1-cli"
arch="noarch"
license="MIT"
depends="
	py3-click
	py3-cryptography
	py3-ecdsa
	py3-fido2
	py3-intelhex
	py3-pyserial
	py3-requests
	py3-usb
	"
makedepends="py3-gpep517 py3-flit-core"
subpackages="$pkgname-pyc $pkgname-udev"
source="
	https://github.com/solokeys/solo1-cli/archive/$pkgver/solo1-cli-$pkgver.tar.gz
	70-solokey.rules
	fido2-1.0-compat.patch
	flit-core_patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # only lint/style tests

prepare() {
	default_prepare

	# Other than setting the version in the pyproject.toml, flit_core only
	# supports a dynamic version to be set in __init__.py via a
	# '__version__ = "VERSION_STRING"' statement. solo-cli does it via
	# reading the VERSION file in __init__.py ... which is not supported.
	local _ver="$(cat solo/VERSION)"
	sed -e "s/@@VERSION@@/\"$_ver\"/" \
		"$srcdir"/flit-core_patch > "$srcdir"/flit-core.patch
	patch -Np1 -i "$srcdir"/flit-core.patch
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	install -Dm644 "$srcdir"/70-solokey.rules \
		"$pkgdir"/usr/lib/udev/rules.d/70-solokey.rules
}

