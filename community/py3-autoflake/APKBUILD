maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-autoflake
_pkgname="${pkgname/py3-/}"
pkgver=2.4.0
pkgrel=0
pkgdesc="Removes unused imports and unused variables from Python code"
url="https://github.com/PyCQA/autoflake"
arch="noarch"
license="MIT"
depends="py3-pyflakes"
makedepends="py3-gpep517 py3-hatchling py3-setuptools"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
subpackages="$pkgname-pyc"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # No tests.

build() {
	gpep517 build-wheel --wheel-dir .dist  --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
