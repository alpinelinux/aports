# Contributor: Leonardo Arena <rnalrd@alpinelinux.org>
# Contributor: Justin Berthault <justin.berthault@zaclys.net>
# Maintainer: Kaarle Ritvanen <kunkku@alpinelinux.org>
pkgname=py3-django-filter
pkgver=26.1
pkgrel=0
pkgdesc="Generic system for filtering Django QuerySets based on user selections"
url="https://github.com/carltongibson/django-filter"
arch="noarch"
license="BSD-3-Clause"
depends="py3-django"
makedepends="py3-gpep517 py3-installer py3-flit-core"
checkdepends="
	py3-markdown
	py3-coverage
	py3-tz
	py3-django-crispy-forms
	py3-django-rest-framework
	py3-mock
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/d/django-filter/django_filter-$pkgver.tar.gz"
builddir="$srcdir"/django_filter-$pkgver

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 runtests.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
e6cf9372aa9f1fba68ece077997cc3f3d64ca5f8d718fd30265de4a7126d04fe2017872ff440c6e7b1519a3953b9c14b928d481f0e1c35b0c5fadd3ae0b9faf7  django_filter-26.1.tar.gz
"
