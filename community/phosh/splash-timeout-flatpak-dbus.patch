   struct {
-    guint              id;
-    guint              waited;
-    guint              interval;
+    guint id;
+    guint waited;
+    guint interval;
   } timeout;
 } PhoshAppState;
 
@@ -160,11 +160,11 @@ on_startup_timeout (gpointer data)
 
 
 static PhoshAppState *
-phosh_app_state_new (GDesktopAppInfo    *info,
-                     const char         *startup_id,
