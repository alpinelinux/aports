From 64fc667d3c9fc43f077c6ab32cb1ce93b5d7c2f5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Guido=20G=C3=BCnther?= <agx@sigxcpu.org>
Date: Mon, 17 Aug 2026 18:00:40 +0200
Subject: [PATCH 3/7] app-tracker: Really give forks one more iteration
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

If we don't continue we'll fall through to the error right away.

Signed-off-by: Guido Günther <agx@sigxcpu.org>
Part-of: <https://gitlab.gnome.org/World/Phosh/phosh/-/merge_requests/1955>
---
 src/app-tracker.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/app-tracker.c b/src/app-tracker.c
index 87303042f..e3fe31f3b 100644
--- a/src/app-tracker.c
+++ b/src/app-tracker.c
@@ -143,7 +143,8 @@ on_startup_timeout (gpointer data)
     } else {
       /* PID is gone. As this might be a fork give it one more
        * iteration to bring up a toplevel */
-      state->timeout.waited  = STARTUP_TRACKED_TIMEOUT;
+      state->timeout.waited = STARTUP_TRACKED_TIMEOUT;
+      return G_SOURCE_CONTINUE;
     }
   }
 
-- 
