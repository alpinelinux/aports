diff --git a/src/app-tracker.c b/src/app-tracker.c
index c36bd6cad..9fd2dfd3c 100644
--- a/src/app-tracker.c
+++ b/src/app-tracker.c
@@ -83,16 +83,16 @@ typedef enum {
 } PhoshAppStateFlags;
 
 typedef struct  {
-  gint64             pid;
+  gint64 pid;
   PhoshAppStateFlags state;
 
-  char              *startup_id;  /* (owned) */
