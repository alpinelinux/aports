# Contributor: Matt Smith <mcs@darkregion.net>
# Maintainer: Matt Smith <mcs@darkregion.net>
pkgname=py3-urwid
_pyname=urwid
pkgver=4.0.8
pkgrel=0
pkgdesc="A console user interface library for Python3"
url="https://urwid.org/"
arch="noarch"
license="LGPL-2.1-only"
depends="
	py3-wcwidth
	"
makedepends="
	python3-dev
	py3-gpep517
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	py3-gobject3
	py3-pytest-cov
	py3-pyzmq
	py3-tornado
	py3-trio
	py3-twisted
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/u/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir"/$_pyname-$pkgver

replaces="py-urwid" # Backwards compatibility
provides="py-urwid=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# Tries to run windows test, wtf?
	skip="$skip --ignore=urwid/display/_win32.py"
	skip="$skip --ignore urwid/display/_win32_raw_display.py"

	.testenv/bin/python3 -m pytest -vvvv --doctest-modules -s $skip
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
4cea0cb07a65b4b8ef274e5407f37de432130ac2c3963e21e3545a09b2566d0c552e281a706f59106f369cadf7139013aeaa81c54748e1c3df13647b45008293  urwid-4.0.8.tar.gz
"
