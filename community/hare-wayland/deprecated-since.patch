From 358b93b2db07f28dc339f661df3e55adf944b16b Mon Sep 17 00:00:00 2001
From: alcn <alcn@posteo.com>
Date: Sat, 8 Aug 2026 13:02:31 +0000
Subject: [PATCH] Implement parsing "deprecated-since" attribute in entries.

According to the Wayland documentation, entry elements can have the
attribute "deprecated-since". It is for instance the case in the 1.26.0
wayland release in wl_shm::error. This causes the current hare-wlscanner
to abort when parsing wayland.xml.
---
 wayland/scanner/scan.ha | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/wayland/scanner/scan.ha b/wayland/scanner/scan.ha
index 5065984..254bf47 100644
--- a/wayland/scanner/scan.ha
+++ b/wayland/scanner/scan.ha
@@ -344,6 +344,13 @@ fn scan_entry(par: *xml::parser) (enum_entry | error) = {
 				case =>
 					return formaterr;
 				};
+			case "deprecated-since" =>
+				match (strconv::stou(at.1)) {
+				case let u: uint =>
+					ent.deprecated_since = u;
+				case =>
+					return formaterr;
+				};
 			case "summary" =>
 				ent.summary = strings::dup(at.1)?;
 			case =>
