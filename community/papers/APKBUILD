252e8f8bdffa6c745c6cf51926d6bb465a4aec4831dc78e21a302d00e47095314a47c9c06775cb00d629de1762ebd854d31ebb95d9180a28a95669c5116c3d9d  fix-pc-ver.patch
3036543682d38fdeedcacddbedb6650edb74308ab3b8b5bf44f0479d64f2dc0d5434dd78b0ee3938779c73bd953df369a68d9ed5a65f3c4a3d13c1d6c8c0cd70  upgrade-rustix-for-ppc64le.patch
"
