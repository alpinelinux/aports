From 2bf586f045d20d63b31ed576f2a53844cddd0665 Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Sat, 31 Oct 2026 14:12:25 -0300
Subject: [PATCH] Only use malloc_trim if available
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

malloc_trim is used if malloc.h is available, but non-glibc
implementations don't define this function, so builds fail due to usage
of an undefined function.

Use malloc_trim conditionally — only if it is actually defined.
---
 config.h.meson.in                   | 2 ++
 libnemo-private/nemo-malloc-utils.c | 4 ++--
 meson.build                         | 1 +
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/config.h.meson.in b/config.h.meson.in
index f63cb42d..1d3b3267 100644
--- a/config.h.meson.in
+++ b/config.h.meson.in
@@ -46,6 +46,8 @@
 // Define to 1 if you have the `mallopt' function.
 #mesondefine HAVE_MALLOPT
 
+// Define to 1 if you have the `malloc_trim' function.
+#mesondefine HAVE_MALLOC_TRIM
 
 // Define to 1 if you have the <sys/mount.h> header file.
 #mesondefine HAVE_SYS_MOUNT_H
diff --git a/libnemo-private/nemo-malloc-utils.c b/libnemo-private/nemo-malloc-utils.c
index 2934f31b..8cb72f57 100644
--- a/libnemo-private/nemo-malloc-utils.c
+++ b/libnemo-private/nemo-malloc-utils.c
@@ -58,7 +58,7 @@ heap_trim_timeout_cb (gpointer user_data)
 {
     heap_trim_timeout_id = 0;
 
-#if HAVE_MALLOC_H
+#if HAVE_MALLOC_TRIM
     malloc_trim (0);
 #endif
 
@@ -68,7 +68,7 @@ heap_trim_timeout_cb (gpointer user_data)
 void
 nemo_schedule_heap_trim (void)
 {
-#if HAVE_MALLOC_H
+#if HAVE_MALLOC_TRIM
     if (heap_trim_timeout_id != 0) {
         return;
     }
diff --git a/meson.build b/meson.build
index ea5818b7..8f8d8416 100644
--- a/meson.build
+++ b/meson.build
@@ -41,6 +41,7 @@ foreach h : check_headers
 endforeach
 
 conf.set10('HAVE_MALLOPT', cc.has_function('mallopt', prefix: '#include <malloc.h>'))
+conf.set10('HAVE_MALLOC_TRIM', cc.has_function('malloc_trim', prefix: '#include <malloc.h>'))
 
 
 add_global_arguments([
-- 
2.56.0

