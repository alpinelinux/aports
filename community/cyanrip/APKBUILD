# Maintainer: John Vogel <jvogel@stygian.me>
maintainer="John Vogel <jvogel@stygian.me>"
pkgname=cyanrip
pkgver=0.9.3.1_git20260325
pkgrel=1
_commit=65afeabc372985050063a7ef4f2c88dd4b011dad
pkgdesc="Bule-ish CD ripper"
url="https://github.com/cyanreg/cyanrip"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	curl-dev
	ffmpeg-dev
	libcdio-dev
	libcdio-paranoia-dev
	libmusicbrainz-dev
	meson
	"
source="https://github.com/cyanreg/cyanrip/archive/$_commit/cyanrip-$_commit.tar.gz
	ffmpeg9.patch
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

