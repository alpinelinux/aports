maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=node-sharp
pkgver=0.35.3
pkgrel=0
_colour=1.1.0
_detectlibc=2.1.2
_nodeaddonapi=7.1.1
_semver=7.8.5
pkgdesc="High performance Node.js image processing"
url="https://sharp.pixelplumbing.com/"
arch="all"
license="Apache-2.0 AND MIT AND ISC"
depends="nodejs"
makedepends="nodejs-dev npm pkgconf python3 vips-dev"
# Use .npmtgz to avoid unpack(); all these would unpack overlapping files.
source="sharp-$pkgver.npmtgz::https://registry.npmjs.org/sharp/-/sharp-$pkgver.tgz
	colour-$_colour.npmtgz::https://registry.npmjs.org/@img/colour/-/colour-$_colour.tgz
	detect-libc-$_detectlibc.npmtgz::https://registry.npmjs.org/detect-libc/-/detect-libc-$_detectlibc.tgz
	node-addon-api-$_nodeaddonapi.npmtgz::https://registry.npmjs.org/node-addon-api/-/node-addon-api-$_nodeaddonapi.tgz
	semver-$_semver.npmtgz::https://registry.npmjs.org/semver/-/semver-$_semver.tgz
	"

# TODO: bump() to quickly update pinned deps.

prepare() {
	mkdir -p "$builddir"
	tar -xzf "$SRCDEST/sharp-$pkgver.npmtgz" -C "$builddir" --strip-components=1

	mkdir -p "$builddir/node_modules/@img/colour" \
		"$builddir/node_modules/detect-libc" \
		"$builddir/node_modules/node-addon-api" \
		"$builddir/node_modules/semver"
	tar -xzf "$SRCDEST/colour-$_colour.npmtgz" -C "$builddir/node_modules/@img/colour" --strip-components=1
	tar -xzf "$SRCDEST/detect-libc-$_detectlibc.npmtgz" -C "$builddir/node_modules/detect-libc" --strip-components=1
	tar -xzf "$SRCDEST/node-addon-api-$_nodeaddonapi.npmtgz" -C "$builddir/node_modules/node-addon-api" --strip-components=1
	tar -xzf "$SRCDEST/semver-$_semver.npmtgz" -C "$builddir/node_modules/semver" --strip-components=1

	default_prepare
}

build() {
	# node-gyp inherits -flto, which fails with fortify-headers.
	export npm_config_enable_lto=false
	node-gyp rebuild --directory=src --nodedir=/usr
}

check() {
	node -e '
		const sharp = require("./");
		console.log("libvips:", sharp.versions.vips);
		const svg = Buffer.from(`<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect width="64" height="64" fill="red"/></svg>`);
		sharp(svg).resize(32, 32).png().toBuffer().then((buf) => {
			if (buf.length < 100) throw new Error("suspiciously small PNG");
			console.log("SVG -> PNG OK:", buf.length, "bytes");
		}).catch((err) => { console.error(err); process.exit(1); });
	'

	# resolve the package the way consumers do after linking it into node_modules
	mkdir -p "$srcdir/check/node_modules"
	ln -s "$builddir" "$srcdir/check/node_modules/sharp"
	cd "$srcdir/check"
	node --input-type=module -e '
		import sharp from "sharp";
		console.log("esm import OK, sharp", sharp.versions.sharp);
	'
}

package() {
	local dest="$pkgdir/usr/lib/node_modules/sharp"
	install -dm755 "$dest"
	cp -a package.json dist install lib src LICENSE "$dest/"
	cp -a node_modules "$dest/"

	# node-addon-api is only needed to compile; src/node_modules is gyp build junk
	rm -rf "$dest/node_modules/node-addon-api" "$dest/src/node_modules"
	# keep only the compiled addon from the gyp build tree
	find "$dest/src/build" -mindepth 1 -maxdepth 1 ! -name Release -exec rm -rf {} +
	find "$dest/src/build/Release" -mindepth 1 -maxdepth 1 ! -name "sharp-*.node" -exec rm -rf {} +

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

