19c4e04f9e7fb13e5a1daa2dabcd371f8a79b18a06a002181c933ed8a135ee29d5ee6bf12f51fe2fdeea9db897ce3c580a9afadbdc0bcd3e716da999a2309c1f  001-system-sqlite.patch
"
