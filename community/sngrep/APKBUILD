# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=sngrep
pkgver=1.9.0
pkgrel=0
pkgdesc="display SIP call message flows from a terminal"
url="https://github.com/irontec/sngrep"
arch="all"
license="GPL-3.0-or-later"
depends="sed"
makedepends="autoconf automake ncurses-dev libpcap-dev
	pcre2-dev libgcrypt-dev openssl-dev>3"
subpackages="$pkgname-dbg $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/irontec/sngrep/archive/v$pkgver.tar.gz"

prepare() {
	default_prepare
	./bootstrap.sh
}

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--with-openssl \
		--with-pcre2 \
		--disable-logo \
		--enable-unicode \
		--enable-eep \
		--enable-ipv6
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir/" install
}

sha512sums="
1f58c670c62bdcdccfd06486a513b101031fd1d180013535a383654c6b514cf8b6e598c54e1a323c448a39a475d0243cdf8e559d18489ba83370fcc9ae71cee0  sngrep-1.9.0.tar.gz
"
