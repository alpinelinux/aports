From ea013a1dcd416cd661476985ce59a92a4a127fd7 Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Sat, 14 Nov 2026 05:50:54 +0100
Subject: [PATCH 6/6] Use pre-fetch llama-brand

The build system fetches a tarball during builds, which npm prohibits by
default. Use a pre-fetched file instead.
---
 tools/ui/package-lock.json | 4 ++--
 tools/ui/package.json      | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/tools/ui/package-lock.json b/tools/ui/package-lock.json
index fb2b68eaa..d4ebff751 100644
--- a/tools/ui/package-lock.json
+++ b/tools/ui/package-lock.json
@@ -53,7 +53,7 @@
 				"globals": "16.5.0",
 				"highlight.js": "11.11.1",
 				"http-server": "14.1.1",
-				"llama-brand": "https://codeload.github.com/ggml-org/llama-brand/tar.gz/f05540643c1ca2a18d732ed6491c839686da9a3a",
+				"llama-brand": "file:./llama-brand-f05540643c1ca2a18d732ed6491c839686da9a3a.tar.gz",
 				"mdast": "3.0.0",
 				"mdsvex": "0.12.7",
 				"mermaid": "11.17.2",
@@ -12329,7 +12329,7 @@
 		},
 		"node_modules/llama-brand": {
 			"version": "0.1.0",
-			"resolved": "https://codeload.github.com/ggml-org/llama-brand/tar.gz/f05540643c1ca2a18d732ed6491c839686da9a3a",
+			"resolved": "file:llama-brand-f05540643c1ca2a18d732ed6491c839686da9a3a.tar.gz",
 			"integrity": "sha512-kRDXUIUdfcDt7w4hh3JrFTpqxf2i7R0PHVLGnwUdr4L8EMqE32mEECoXUz1uoUlFaQ+h6QaVHvJWS5y98AoaYA==",
 			"dev": true,
 			"license": "CC-BY-NC-4.0"
diff --git a/tools/ui/package.json b/tools/ui/package.json
index cc3785727..a48a3d37d 100644
--- a/tools/ui/package.json
+++ b/tools/ui/package.json
@@ -78,7 +78,7 @@
 		"globals": "16.5.0",
 		"highlight.js": "11.11.1",
 		"http-server": "14.1.1",
-		"llama-brand": "https://codeload.github.com/ggml-org/llama-brand/tar.gz/f05540643c1ca2a18d732ed6491c839686da9a3a",
+		"llama-brand": "file:./llama-brand-f05540643c1ca2a18d732ed6491c839686da9a3a.tar.gz",
 		"mdast": "3.0.0",
 		"mdsvex": "0.12.7",
 		"mermaid": "11.17.2",
-- 
2.56.0

