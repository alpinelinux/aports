From d9830cb6dc4a5acb7835bfe938451e757a5220fb Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Sat, 3 Oct 2026 21:16:09 +0200
Subject: [PATCH 4/5] Don't import test dependencies during build

Test dependencies are imported during build. These transitively depend
on oxc-resolver, which only publishes binaries for a few architectures,
and the whole build then fails.

Lazy-import test dependencies, so a regular build doesn't import them.
---
 tools/ui/vite.config.ts | 50 ++++++++++++++++++++++++-----------------
 1 file changed, 30 insertions(+), 20 deletions(-)

diff --git a/tools/ui/vite.config.ts b/tools/ui/vite.config.ts
index b213ec8ab..fce85758f 100644
--- a/tools/ui/vite.config.ts
+++ b/tools/ui/vite.config.ts
@@ -3,33 +3,47 @@ import { nerdamerPlugin } from './scripts/vite-plugin-nerdamer';
 import { relativizeBasePlugin } from './scripts/vite-plugin-relativize-base';
 import { splashScreenPlugin } from './scripts/vite-plugin-splash-screen';
 import { SVELTEKIT_PWA_OPTIONS } from './src/lib/constants/pwa.constants';
-import { storybookTest } from '@storybook/addon-vitest/vitest-plugin';
 import { sveltekit } from '@sveltejs/kit/vite';
 import tailwindcss from '@tailwindcss/vite';
 import { SvelteKitPWA } from '@vite-pwa/sveltekit';
-import { playwright } from '@vitest/browser-playwright';
 import { dirname, resolve } from 'path';
 import { fileURLToPath } from 'url';
 import { defineConfig, loadEnv, searchForWorkspaceRoot } from 'vite';
 
 const __dirname = dirname(fileURLToPath(import.meta.url));
-// eslint-disable-next-line @typescript-eslint/no-explicit-any
-const browserBaseConfig: any = {
-	enabled: true,
-	instances: [{ browser: 'chromium' }],
-	// CI runs the bundled Chromium without its sandbox, which the runners can't start;
-	// locally, the installed (auto-updated) Chrome with its sandbox on, see playwright.config.ts
-	provider: playwright({
-		launchOptions: process.env.CI
-			? { args: ['--no-sandbox'] }
-			: { channel: 'chrome', chromiumSandbox: true }
-	})
-};
 
-export default defineConfig(({ mode }) => {
+export default defineConfig(async ({ mode }) => {
 	const env = loadEnv(mode, process.cwd(), 'VITE_PUBLIC_');
 	const SERVER_ORIGIN = env.VITE_PUBLIC_SERVER_ORIGIN || 'http://localhost:9931';
 
+	// Load test-only plugins lazily. Avoids issues import oxc-resolver,
+        // which is only available for a few architectures.
+	const isVitest = !!process.env.VITEST;
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any
+	const storybookTestPlugins: any[] = [];
+	// eslint-disable-next-line @typescript-eslint/no-explicit-any
+	const browserBaseConfig: any = {
+		enabled: true,
+		instances: [{ browser: 'chromium' }]
+	};
+
+	if (isVitest) {
+		const { storybookTest } = await import('@storybook/addon-vitest/vitest-plugin');
+		const { playwright } = await import('@vitest/browser-playwright');
+		storybookTestPlugins.push(
+			storybookTest({
+				storybookScript: 'pnpm run storybook --no-open'
+			})
+		);
+		browserBaseConfig.provider = playwright({
+			// CI runs the bundled Chromium without its sandbox, which the runners can't start;
+			// locally, the installed (auto-updated) Chrome with its sandbox on, see playwright.config.ts
+			launchOptions: process.env.CI
+				? { args: ['--no-sandbox'] }
+				: { channel: 'chrome', chromiumSandbox: true }
+		});
+	}
+
 	return {
 		build: {
 			assetsInlineLimit: 32000,
@@ -94,11 +108,7 @@ export default defineConfig(({ mode }) => {
 
 				{
 					extends: './vite.config.ts',
-					plugins: [
-						storybookTest({
-							storybookScript: 'pnpm run storybook --no-open'
-						})
-					],
+					plugins: storybookTestPlugins,
 					test: {
 						browser: { ...browserBaseConfig, instances: [{ browser: 'chromium', headless: true }] },
 						name: 'ui'
-- 
