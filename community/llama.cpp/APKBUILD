# Contributor: Marian Buschsieweke <marian.buschsieweke@posteo.net>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=llama.cpp
pkgver=0.4.0
pkgrel=0
pkgdesc="LLM inference in C/C++ (with Vulkan GPU acceleration)"
# armhf armv7, riscv64, x86: build fails
# ppc64le: internal compiler error
arch="all !armv7 !armhf !ppc64le !riscv64 !x86"
url="https://github.com/ggml-org/llama.cpp"
license="MIT"
pkgusers="llama-server"
pkggroups="llama-server"
makedepends="
	cmake
	glslang-dev
	jq
	libggml-dev
	linux-headers
	npm
	openblas-dev
	openssl-dev
	samurai
	shaderc
	spirv-headers
	vulkan-loader-dev
	"
checkdepends="bash py3-jinja2"
install="$pkgname.pre-install"
# convert_hf_to_gguf: requires pytorch
subpackages="
	$pkgname-dev
	$pkgname-libs
	llama-batched-bench:_extras
	llama-batched:_extras
	llama-completion:_extras
	llama-debug:_extras
	llama-diffusion-cli:_extras
	llama-embedding:_extras
	llama-eval-callback:_extras
	llama-finetune:_extras
	llama-fit-params:_extras
	llama-gen-docs:_extras
	llama-gguf-hash:_extras
	llama-gguf-split:_extras
	llama-gguf:_extras
	llama-idle:_extras
	llama-imatrix:_extras
	llama-lookahead:_extras
	llama-lookup-create:_extras
	llama-lookup-merge:_extras
	llama-lookup-stats:_extras
	llama-lookup:_extras
	llama-mtmd-cli:_extras
	llama-parallel:_extras
	llama-passkey:_extras
	llama-perplexity:_extras
	llama-quantize:_extras
	llama-retrieval:_extras
	llama-server:_extras
	llama-simple:_extras
	llama-speculative-simple:_extras
	llama-speculative:_extras
	llama-tokenize:_extras
	llama-server-openrc:server_openrc
	"
source="$pkgname-v$pkgver.tar.gz::https://github.com/ggml-org/llama.cpp/archive/refs/tags/v$pkgver.tar.gz
	$pkgname-v$pkgver.json::https://api.github.com/repos/ggml-org/llama.cpp/git/ref/tags/v$pkgver
	llama-server.initd
	llama-server.confd
	0001-Install-libraries-into-LLAMA_LIB_INSTALL_DIR.patch
	0002-cmake-add-flag-to-use-system-httplib.patch
	0003-Bail-if-building-the-web-UI-fails.patch
	"
ldpath="/usr/lib/$pkgname"
sonameprefix="$pkgname:"
options="net" # net: npm install for web ui

case "$CARCH" in
riscv64) _lto=OFF ;;
*) _lto=ON ;;
esac

build() {
	_commit=$(jq -r '.object.sha' <$srcdir/$pkgname-v$pkgver.json)

	cmake -B build -G Ninja -Wno-dev \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLLAMA_BUILD_COMMIT="$_commit" \
		-DLLAMA_BUILD_IS_DEV=OFF \
		-DLLAMA_LIB_INSTALL_DIR=/usr/lib/llama.cpp \
		-DLLAMA_USE_PREBUILT_UI=OFF \
		-DLLAMA_USE_SYSTEM_GGML=ON
	cmake --build build
}

check() {
	local skip="test-arg-parser"                   # test fails
	skip="$skip|test-backend-ops"                  # segfaults
	skip=$skip"|test-download-model"               # requires network
	skip=$skip"|test-eval-callback-download-model" # requires network
	skip=$skip"|test-eval-callback"                # requires network
	skip=$skip"|test-state-restore-fragmented"     # requires network
	skip=$skip"|test-thread-safety"                # requires network
	skip=$skip"|test-recurrent-state-rollback"     # requires network-fetched model
	skip=$skip"|test-save-load-state"              # requires network-fetched model
	skip=$skip"|test-tokenizers-ggml-vocabs"       # fails on CI (only when network is available)
	skip=$skip"|test-llama-archs"                  # https://github.com/ggml-org/llama.cpp/issues/20611
	skip=$skip"|test-opt"                          # hangs, needs research
	skip=$skip"|test-quant-type-selection"         # fails when network is available
	skip=$skip"|test-generate-models"              # fails with split backends

	case "$CARCH" in
	ppc64le) skip="$skip|test-opt" ;; # only rpc backend available
	s390x) return ;;                  # requires big-endian models
	esac

	ctest --test-dir build -E "$skip"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm 755 "$srcdir/llama-server.initd" "$pkgdir/etc/init.d/llama-server"
	install -Dm 644 "$srcdir/llama-server.confd" "$pkgdir/etc/conf.d/llama-server"
	install -dm 755 -o llama-server -g llama-server "$pkgdir/var/lib/llama-server"

	# Don't install tests.
	find "$pkgdir/usr/bin/" -name "test-*" -exec rm {} \;
}

libs() {
	pkgdesc="$pkgdesc (shared libraries)"
	amove usr/lib/llama.cpp
	amove usr/lib/libllama-common.so.*
}

_extras() {
	local binname=${subpkgname#llama-}
	pkgdesc="llama-$binname tool from $pkgname"
	amove usr/bin/llama-$binname
}

server_openrc() {
	pkgdesc="llama.cpp server (OpenRC init scripts)"
	depends="llama-server=$pkgver-r$pkgrel openrc"
	install_if="llama-server=$pkgver-r$pkgrel openrc"
	amove etc/init.d/llama-server
	amove etc/conf.d/llama-server
}

convert_hf_to_gguf() {
	# FIXME: all except py3-numpy are missing.
	#        py3-pytorch is a huge effort to package.
	depends="
		py3-gguf
		py3-numpy
		py3-pytorch
		py3-safetensors
		py3-sentencepiece
		py3-transformers
	"

	amove usr/bin/convert_hf_to_gguf.py
}

