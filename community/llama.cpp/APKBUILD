	llama-lookup-create:_extras
	llama-lookup-merge:_extras
	llama-lookup-stats:_extras
	llama-lookup:_extras
	llama-mtmd-cli:_extras
	llama-parallel:_extras
	llama-passkey:_extras
	llama-perplexity:_extras
	llama-quantize:_extras
	llama-results:_extras
	llama-retrieval:_extras
	llama-server-openrc:server_openrc
	llama-server:_extras
	llama-simple-chat:_extras
	llama-simple:_extras
	llama-speculative-simple:_extras
	llama-speculative:_extras
	llama-tokenize:_extras
	llama-tts:_extras
