	spirv-headers
	vulkan-loader-dev
	"
checkdepends="bash py3-jinja2"
install="$pkgname.pre-install"
# convert_hf_to_gguf: requires pytorch
subpackages="
	$pkgname-dev
	$pkgname-libs
	llama-batched-bench:_extras
