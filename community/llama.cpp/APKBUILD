	"
source="$pkgname-v$pkgver.tar.gz::https://github.com/ggml-org/llama.cpp/archive/refs/tags/v$pkgver.tar.gz
	$pkgname-v$pkgver.json::https://api.github.com/repos/ggml-org/llama.cpp/git/ref/tags/v$pkgver
	llama-server.initd
	llama-server.confd
	0001-Install-libraries-into-LLAMA_LIB_INSTALL_DIR.patch
	0002-cmake-add-flag-to-use-system-httplib.patch
