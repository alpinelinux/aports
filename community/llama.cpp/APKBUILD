	llama-tts:_extras
	llama
	"
_llama_brand_commit=f05540643c1ca2a18d732ed6491c839686da9a3a
source="$pkgname-v$pkgver.tar.gz::https://github.com/ggml-org/llama.cpp/archive/refs/tags/v$pkgver.tar.gz
	$pkgname-v$pkgver.json::https://api.github.com/repos/ggml-org/llama.cpp/git/ref/tags/v$pkgver
	llama-brand-$_llama_brand_commit.tar.gz::https://codeload.github.com/ggml-org/llama-brand/tar.gz/$_llama_brand_commit
	llama-server.initd
