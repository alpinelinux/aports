d7f371d49bcfed3eba8de35b4d37813acd8ef63b126f8855aac63364f2300105496cf72d8160892cea5a383387f77c0ac5c6a2f52781cf54a88ec3fa5734a500  raspberrypi-usbboot-eeprom-20260603.tar.gz
08e0c39ef73f27cecb3e0e79a44024e48f7c0afcd08e96828d0f527639be1eb17fc8224c3c7575931ef13e3c569ddbc91344c580a0cb9ba240f9e073ee278293  fix-udev-rules.patch
"
