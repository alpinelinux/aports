_pkgname=usbboot
pkgname=raspberrypi-usbboot
pkgver=20260603
_gittag="$pkgver-182203"
_rpi_eeprom=387e8cc058aae0ea43214a296b64fd11f9e25678/
pkgrel=0
pkgdesc="rpiboot and bin2c from Raspberry Pi"
url="https://github.com/raspberrypi/usbboot"
arch="all"
license="Apache-2.0"
makedepends="libusb-dev"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/raspberrypi/usbboot/archive/refs/tags/$_gittag.tar.gz
	$pkgname-eeprom-$pkgver.tar.gz::https://github.com/raspberrypi/rpi-eeprom/archive/$_rpi_eeprom.tar.gz
	fix-udev-rules.patch
	"
options="!check !strip" # No tests and don't strip .elf files.
builddir="$srcdir/$_pkgname-$_gittag"

prepare() {
	default_prepare

	# install correct rpi-eeprom folder
	rmdir "$builddir"/rpi-eeprom
	mv "$srcdir"/rpi-eeprom-* "$builddir"/rpi-eeprom
}

build() {
	make CFLAGS="$CFLAGS" bin2c rpiboot
}

package() {
	install -Dm755 rpiboot -t "$pkgdir"/usr/bin
	install -Dm755 bin2c -t "$pkgdir"/usr/bin

	install -Dm644 -t "$pkgdir"/usr/lib/udev/rules.d debian/70-rpiboot.rules

	mkdir -p "$pkgdir"/usr/share/rpiboot
	for i in msd recovery mass-storage-gadget64; do
		cp -R $i "$pkgdir"/usr/share/rpiboot
	done

	mkdir -p "$pkgdir"/usr/share/rpiboot/firmware/2712
	mkdir -p "$pkgdir"/usr/share/rpiboot/firmware/2711
	cp firmware/bootfiles.bin "$pkgdir"/usr/share/rpiboot/firmware
	cp firmware/2711/* "$pkgdir"/usr/share/rpiboot/firmware/2711/.
	cp firmware/2712/* "$pkgdir"/usr/share/rpiboot/firmware/2712/.

}

sha512sums="
