# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer:
pkgname=lfe
pkgver=2.2.2
pkgrel=0
pkgdesc="Lisp Flavoured Erlang"
url="https://lfe.io/"
arch="all"
license="Apache-2.0"
depends="erlang"
makedepends="erlang-dev"
subpackages="$pkgname-doc"
source="https://github.com/lfe/lfe/archive/$pkgver/lfe-$pkgver.tar.gz"

build() {
	make compile
}

check() {
	./bin/lfe -e '(help)'
}

package() {
	make PREFIX="$pkgdir/usr" install

	install -Dvm644 doc/*.txt \
		-t "$pkgdir"/usr/share/doc/$pkgname/

	cd "$pkgdir"/usr/bin
	ln -svf ../lib/lfe/bin/* .
}

sha512sums="
afbc71736fbfff31e7b018a272d9fcec2a5e4d3f0670a3ea1afea695a480a192c08025930c7a4530a177e0e0830c2316f82307cb06831c3ac7d5547aa8ab1a67  lfe-2.2.2.tar.gz
"
