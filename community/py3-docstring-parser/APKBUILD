maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-docstring-parser
pkgver=0.18.0
pkgrel=0
pkgdesc="Parse Python docstrings in reST, Google and Numpydoc format"
url="https://github.com/rr-/docstring_parser"
arch="noarch"
license="MIT"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://pypi.python.org/packages/source/d/docstring_parser/docstring_parser-$pkgver.tar.gz"
builddir="$srcdir/docstring_parser-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
2a8406b0ea00ea9a74d5e391eee39511494f1d9e0977704b7bbf651cf6964589897788ca884dcf48e6174c97031ddf8791d62cda0437d39471d9392b074b7d28  py3-docstring-parser-0.18.0.tar.gz
"
