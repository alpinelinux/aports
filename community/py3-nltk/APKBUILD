# Contributor: Iztok Fister, Jr. <iztok@iztok-jr-fister.eu>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
maintainer="Will Sinatra <wpsinatra@gmail.com>"
pkgname=py3-nltk
_pkgorig=nltk
pkgver=3.10.3
pkgrel=0
pkgdesc="Natural Language Toolkit"
url="https://github.com/nltk/nltk"
arch="noarch"
license="Apache-2.0"
depends="python3 py3-defusedxml py3-yaml py3-click py3-regex"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="
	py3-matplotlib
	py3-numpy
	py3-pytest
	py3-pytest-mock
	python3-tkinter
	py3-tqdm
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/nltk/nltk/archive/v$pkgver.tar.gz"
builddir="$srcdir/$_pkgorig-$pkgver"

case "$CARCH" in
# several tests fail on riscv64 | skip for now
riscv64) options="$options !check" ;;
esac

# secfixes:
#   3.9.3-r0:
#     - CVE-2025-14009

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m nltk.downloader all
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	rm -r "$pkgdir"/usr/lib/python3.*/site-packages/nltk/test
}

sha512sums="
a0b4e63e9df7ceb165b5eb5368a342c726d954d38018224b7ce8dbc3afdbc88e955441041d19d0e23dbc4f7c9d6319d67d28b3f58dc6fa02c39d2ed4f210c57e  py3-nltk-3.10.3.tar.gz
"
