f63c35cfeea88314e08b1831b50b876c420c92adcdc6d36eb88475e6a3daa24e9ad2ba312046e9cce7c68ca9b64391d6c2b3bfc065baa1e7d1d2fa61cd8ff6be  10-disable-deprecation-warnings.patch
"
