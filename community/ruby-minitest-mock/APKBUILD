# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-minitest-mock
_gemname=minitest-mock
pkgver=5.27.0
pkgrel=0
pkgdesc="Mocking and stubbing library for minitest (extracted from minitest 6)"
url="https://github.com/minitest/minitest-mock"
arch="noarch"
license="MIT"
depends="ruby"
makedepends="ruby-rdoc"
checkdepends="ruby-minitest"
subpackages="$pkgname-doc"
source="https://github.com/minitest/minitest-mock/archive/v$pkgver/$_gemname-$pkgver.tar.gz
	https://rubygems.org/downloads/$_gemname-$pkgver.gem
	"
builddir="$srcdir/$_gemname-$pkgver"

prepare() {
	default_prepare

	# Generate gemspec (there's no gemspec in the source).
	gem specification -l --ruby "$srcdir"/$_gemname-$pkgver.gem \
		> "$builddir"/$_gemname.gemspec
}

build() {
	gem build $_gemname.gemspec
}

check() {
	ruby -I lib -I test \
		-e "Dir.glob('./test/**/test_*.rb', &method(:require))" -- --verbose
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install \
		--local \
		--build-root "$pkgdir" \
		--document ri \
		--verbose \
		$_gemname

	# Remove unnessecary files
	cd "$gemdir"
	rm -r build_info cache extensions
	rmdir plugins || true

	cd "$geminstdir"
	rm -r History.* Manifest.* README.* Rakefile test/
}

doc() {
	pkgdesc="$pkgdesc (ri docs)"

	amove "$(ruby -e 'puts Gem.default_dir')"/doc
}

