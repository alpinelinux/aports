# Maintainer: Marian Buschsieweke <marian.buschsieweke@posteo.net>
pkgname=noson-app
pkgver=5.7.2
pkgrel=0
pkgdesc="The essential to control music from your SONOS devices on Linux platforms"
url="https://janbar.github.io/noson-app/"
# armhf: Missing Qt stuff
# riscv64: truncated relocation
arch="all !armhf !riscv64"
license="GPL-3.0-only"
subpackages="$pkgname-dbg"
depends="qt6-qtsvg"
makedepends="
	cmake
	flac-dev
	noson-dev
	pulseaudio-dev
	qt6-qt5compat-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtsvg-dev
	samurai
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/janbar/noson-app/archive/$pkgver.tar.gz
	"
options="!check" # No unit tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=1 \
		-DBUILD_DEPENDENCIES=0 \
		-DQT_VERSION_PREFERRED=6
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
