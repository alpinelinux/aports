pkgname=noise-repellent
pkgver=0.4.0
pkgrel=0
_jucever=9.0.1
pkgdesc="Audio plug-in for broadband noise reduction"
url="https://github.com/lucianodato/noise-repellent"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	alsa-lib-dev
	cmake
	fontconfig-dev
	freetype-dev
	gtk+3.0-dev
	libspecbleach-dev
	libx11-dev
	libxcursor-dev
	libxi-dev
	libxext-dev
	libxinerama-dev
	libxrandr-dev
	mesa-dev
	pkgconf
	samurai
	webkit2gtk-4.1-dev
	"
checkdepends="
	lv2
	sord
	"
subpackages="$pkgname-vst3:_vst3"
source="
	noise-repellent-$pkgver.tar.gz::https://github.com/lucianodato/noise-repellent/archive/refs/tags/v$pkgver.tar.gz
	juce-$_jucever.tar.gz::https://github.com/juce-framework/JUCE/archive/refs/tags/$_jucever.tar.gz
	"

build() {
	local png_opts="-DPNG_POWERPC_VSX_OPT=0 -DPNG_LOONGARCH_LSX_OPT=0 -DPNG_MIPS_MSA_OPT=0 -DPNG_MIPS_MMI_OPT=0"

	export CFLAGS="$CFLAGS $png_opts"
	export CXXFLAGS="$CXXFLAGS $png_opts"

	# JUCE has no system option upstream, so the tarball is fetched and
	# checksummed by abuild and handed to FetchContent.
	cmake -B build -G Ninja \
		-DBUILD_TESTING=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DENABLE_PLUGIN_TESTS=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON \
		-DFETCHCONTENT_SOURCE_DIR_JUCE="$srcdir/JUCE-$_jucever" \
		-DUSE_SYSTEM_FREETYPE=ON \
		-DUSE_SYSTEM_SPECBLEACH=ON

	cmake --build build
}

check() {
	lv2_validate "build/NoiseRepellent_artefacts/Release/LV2/Noise Repellent.lv2/"*.ttl
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r "build/NoiseRepellent_artefacts/Release/LV2/Noise Repellent.lv2" \
		"$pkgdir"/usr/lib/lv2/
}

_vst3() {
	pkgdesc="$pkgdesc (VST3 plugin)"
	depends=""

	mkdir -p "$subpkgdir"/usr/lib/vst3
	cp -r "$builddir/build/NoiseRepellent_artefacts/Release/VST3/Noise Repellent.vst3" \
		"$subpkgdir"/usr/lib/vst3/
}

