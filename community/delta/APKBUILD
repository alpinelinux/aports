81425c2fdb0d2d2cc4f996598caf9071e737f2f017f298892eb6fdcc24fe6d951e9f3a1058a4e05207ee9144bea89460d52f0006db63030dd3a33d06800bf4de  rustix-1.1.6.patch
76841bafd587b8ef3455d5c7cb16f79eb03b48ce087f83984e54ed466af43c27f14392c4e99253e03ac1b7cc98999cb96911be86f78d5ba389c9d05f85eeadef  ctrlc-3.5.3.patch
"
