# Maintainer: Lindsay Zhou <i@lin.moe>
maintainer="Lindsay Zhou <i@lin.moe>"
pkgname=mu
pkgver=1.14.3
pkgrel=0
pkgdesc="Utilities for indexing and searching Maildirs"
url="https://www.djcbsoftware.nl/code/mu/"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	emacs-nox
	fmt-dev
	glib-dev
	gmime-dev
	guile-dev
	muon
	readline-dev
	texinfo
	xapian-core-dev
	"
subpackages="
	$pkgname-doc
	mu4e::noarch
	guile-mu:guile
	$pkgname-bash-completion
	$pkgname-zsh-completion"

source="https://github.com/djcb/mu/archive/refs/tags/v$pkgver/mu-$pkgver.tar.gz
	fix-tests.patch
	"

build() {
	abuild-muon \
		-Dguile=enabled \
		-Dreadline=enabled \
		-Dbash-completion=enabled \
		-Dzsh-completion=enabled \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		build

	ninja -C build
}

check() {
	muon -C build test -j "${JOBS:-0}" -R -d dots
}

package() {
	DESTDIR="$pkgdir" muon -C build install
}

mu4e() {
	pkgdesc="Emacs-based e-mail client which uses mu as its back-end"
	depends="$pkgname=$pkgver-r$pkgrel cmd:emacs"

	amove usr/share/emacs
}

guile() {
	pkgdesc="$pkgdesc (Guile bindings)"
	depends="$pkgname=$pkgver-r$pkgrel guile"

	amove usr/share/mu/scripts usr/share/guile usr/lib/guile
}

