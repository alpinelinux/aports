Do not call omp_pause_resource_all() on musl: libgomp reads the pool
thread handle in gomp_thread_start() before musl pthread_create() has
written it, so the pause joins a garbage pthread_t and segfaults at
module shutdown (forwardFourierTransformImage tests, Termsig=11).

--- a/imagick.c
+++ b/imagick.c
@@ -39,6 +39,15 @@
 
 #include "shim_php7_to_php8.h"
 
+/* On musl, libgomp copies the pthread_t of each pool thread before
+ * pthread_create() has stored it, so omp_pause_resource_all() can
+ * pthread_join() a garbage handle and crash at MSHUTDOWN. musl never
+ * unmaps libraries on dlclose(), so the pause is not needed there. */
+#if HAVE_OMP_PAUSE_RESOURCE_ALL && defined(__linux__) && !defined(__GLIBC__)
+#undef HAVE_OMP_PAUSE_RESOURCE_ALL
+#define HAVE_OMP_PAUSE_RESOURCE_ALL 0
+#endif
+
 #if HAVE_OMP_PAUSE_RESOURCE_ALL
 #include <omp.h>
 #endif
