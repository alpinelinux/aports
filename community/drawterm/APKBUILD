# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Maintainer: Sören Tempel <soeren+alpine@soeren-tempel.net>
pkgname=drawterm
_commit=cf6a88fe6a256acc097245810f8d3b8a9f9ab977
pkgver=0_git20261114
pkgrel=0
pkgdesc="Connect to Plan 9 CPU servers from other operating systems"
url="https://git.9front.org/plan9front/drawterm"
arch="all"
license="LPL-1.02"
options="!check" # upstream does not have a test suite
makedepends="
	libdecor-dev
	libx11-dev
	libxkbcommon-dev
	libxt-dev
	linux-headers
	pipewire-dev
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-dbg $pkgname-x11"
source="$pkgname-$pkgver.tar.gz::https://git.9front.org/plan9front/drawterm/$_commit/snap.tar.gz
	respect-env.patch"
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare
	# X11 and Wayland builds share object file names
	cp -a "$builddir" "$srcdir"/$pkgname-x11
}

build() {
	CONF=linux make

	cd "$srcdir"/$pkgname-x11
	CONF=unix make X11=/usr
}

package() {
	install -Dm755 $pkgname \
		"$pkgdir"/usr/bin/$pkgname
	install -Dm755 "$srcdir"/$pkgname-x11/$pkgname \
		"$pkgdir"/usr/bin/$pkgname-x11
	install -Dm644 LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

x11() {
	pkgdesc="$pkgdesc (X11 version)"

	amove usr/bin/$pkgname-x11
}

sha512sums="
e655a2a38a917cecb1990b094925066273b4dfaaf7381ec4e7061fced7c6b3c28633ef8252ed4be4618a2a3e72ff515d456855291ccb4cea63401aba1c051f01  drawterm-0_git20261114.tar.gz
827363f7fad33f6e6155e4e0431ec240aa4ee359a08540ce9488a4af73cb0463f3c079047cae8a154c8bfd9564571c3cb82f57f74b8d44926de0d744044b306a  respect-env.patch
"
