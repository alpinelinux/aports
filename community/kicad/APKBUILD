pkgname=kicad
pkgver=10.0.7
pkgrel=0
pkgdesc="Cross Platform and Open Source Electronics Design Automation Suite"
url="https://www.kicad.org/"
# No support for s390x/riscv64 in libcontext (shipped with kicad)
# 32-bit arm: memory alignment access error in tests
arch="all !armhf !armv7 !riscv64 !s390x"
langdir="/usr/share/kicad/internat"
license="GPL-3.0-or-later"
makedepends="
	boost1.84-dev
	cairo-dev
	chrpath
	cmake
	curl-dev
	glew-dev
	glm-dev
	glu-dev
	libgit2-dev
	libspnav-dev
	mesa-dev
	ngspice-dev
	nng-dev
	opencascade-dev
	poppler-qt6-dev
	protobuf-dev
	py3-wxpython
	python3-dev
	samurai
	swig
	unixodbc-dev
	wxwidgets-dev
	zlib-dev
	"
checkdepends="
	py3-pytest
	"
depends="
	python3
	py3-cairosvg
	py3-wxpython
	"
subpackages="
	$pkgname-demos::noarch
	$pkgname-lang
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"
source="
	https://gitlab.com/kicad/code/kicad/-/archive/$pkgver/kicad-$pkgver.tar.gz
	test_text_fix.patch
	fix-test-version.patch
	"

provides="$pkgname-opencascade=$pkgver-r$pkgrel"
replaces="$pkgname-opencascade"

build() {
	cmake -B build -G Ninja -Wno-dev \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DKICAD_USE_EGL=ON \
		-DKICAD_SCRIPTING_WXPYTHON=ON \
		-DKICAD_BUILD_I18N=ON \
		-DOPENGL_opengl_LIBRARY=/usr/lib/libGL.so

	# build order workaround (still needed as of 10.0.5)
	cmake --build build --target common/pcb_lexer.h

	cmake --build build
}

check() {
	# qa_cli doesn't pass with non-English locales, so C.UTF-8 locale is enforced
	case "$CARCH" in
	x86)
		# MemoryError on x86 in qa_cli
		# std::bad_alloc on x86 in qa_eeschema as of 10.0.5
		ctest --test-dir build -E '(qa_cli|qa_spice|qa_eeschema)'
		;;
	*)
		LC_ALL=C.UTF-8 LANG=C.UTF-8 ctest --test-dir build -E "qa_spice"
		;;
	esac
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	local sitedir=$(python3 -c "import site; print(site.getsitepackages()[0])")
	chrpath -d "$pkgdir/$sitedir"/_pcbnew.so
}

demos() {
	pkgdesc="Demos for KiCad"

	amove usr/share/kicad/demos
}

