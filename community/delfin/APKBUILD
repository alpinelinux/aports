maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=delfin
pkgver=0.4.8
pkgrel=3
pkgdesc="Stream movies and TV shows from Jellyfin"
url="https://delfin.avery.cafe/"
arch="all !x86" # x86: fails to build
license="GPL-3.0-only"
makedepends="
	appstream
	cargo
	cargo-auditable
	clang
	desktop-file-utils
	gtk4.0-dev
	libadwaita-dev
	meson
	mpv-dev
	"
source="delfin-$pkgver-1.tar.gz::https://codeberg.org/avery42/delfin/archive/v$pkgver.tar.gz
	cargo-auditable.patch
	update-rust-libc.patch
	"
builddir="$srcdir/$pkgname"
options="net"

prepare() {
	default_prepare
	cargo fetch --locked
}

build() {
	abuild-meson . output -Dprofile=release
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	cd "$builddir/output"
	meson install --no-rebuild --destdir "$pkgdir"
}

sha512sums="
