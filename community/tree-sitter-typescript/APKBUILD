# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=tree-sitter-typescript
pkgver=0.23.2
pkgrel=2
pkgdesc="TypeScript grammar for tree-sitter"
url="https://github.com/tree-sitter/tree-sitter-typescript"
arch="all"
license="MIT"
makedepends="tree-sitter-dev tree-sitter-javascript"
checkdepends="tree-sitter-cli"
provides="tree-sitter-tsx=$pkgver-r$pkgrel"
install_if="tree-sitter-grammars"
source="https://github.com/tree-sitter/tree-sitter-typescript/archive/v$pkgver/tree-sitter-typescript-$pkgver.tar.gz"

_langs='tsx typescript'

build() {
	local lang; for lang in $_langs; do
		abuild-tree-sitter build -s "$lang/src"
	done
}

check() {
	tree-sitter test
}

package() {
	local querydir="$pkgdir/usr/share/tree-sitter/queries"

	local lang; for lang in $_langs; do
		DESTDIR="$pkgdir" abuild-tree-sitter install -s "$lang/src"
	done

	# tree-sitter.json indicates that these files are the result of a concatenation.
	# Concatenate them manually, since we're not using upstream's build system.
	local jsdir=/usr/share/tree-sitter/queries/javascript

	cat "$jsdir"/highlights.scm \
		queries/highlights.scm \
		>"$querydir"/typescript/highlights.scm
	cat "$jsdir"/highlights.scm "$jsdir"/highlights-jsx.scm queries/highlights.scm \
		>"$querydir"/tsx/highlights.scm

	cat "$jsdir"/locals.scm \
		queries/locals.scm \
		>"$querydir"/typescript/locals.scm
	cp "$jsdir"/locals.scm "$querydir"/tsx/locals.scm

	cp "$jsdir"/injections.scm "$querydir"/typescript/injections.scm
	cp "$jsdir"/injections.scm "$querydir"/tsx/injections.scm

	local lang
	for lang in $_langs; do
		cat "$jsdir"/tags.scm queries/tags.scm >"$querydir"/$lang/tags.scm
	done
}

sha512sums="
f91d49e9af3f714fe3c8c442f6d1abd12a7b8d65b5e13f536e95132127b7a4840e1d7578780e537929be18c9472f87bd2f9ec2e9f7a41cf739231134965aeb02  tree-sitter-typescript-0.23.2.tar.gz
"
