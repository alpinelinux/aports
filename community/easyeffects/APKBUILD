# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=easyeffects
pkgver=8.2.8
pkgrel=0
pkgdesc="audio plugins for PipeWire applications"
url="https://github.com/wwmm/easyeffects"
# armhf: blocked by kirigami
arch="all !armhf"
license="GPL-3.0-or-later"
install="$pkgname.post-install"
depends="lv2 kirigami-addons qt6-qtgraphs"
makedepends="
	appstream-glib-dev
	cmake
	desktop-file-utils
	extra-cmake-modules
	fftw-dev
	fmt-dev
	gsl-dev
	intltool
	kconfigwidgets-dev
	kcolorscheme-dev
	ki18n-dev
	kiconthemes-dev
	kirigami-addons-dev
	kirigami-dev
	ladspa-dev
	libbs2b-dev
	libebur128-dev
	libmysofa-dev
	libsamplerate-dev
	libsigc++3-dev
	libsndfile-dev
	lilv-dev
	lv2-dev
	ninja
	nlohmann-json
	onetbb-dev
	pipewire-dev
	qqc2-desktop-style-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-private-dev
	qt6-qtgraphs-dev
	rnnoise-dev
	soundtouch-dev
	speexdsp-dev
	webrtc-audio-processing-2-dev
	zita-convolver-dev
	"
subpackages="$pkgname-lang"
source="$pkgname-$pkgver.tar.gz::https://github.com/wwmm/easyeffects/archive/refs/tags/v$pkgver.tar.gz"
options="!check" # no testsuite

build() {
	cmake -B build -G Ninja
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

