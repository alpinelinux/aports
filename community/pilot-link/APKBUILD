# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=pilot-link
pkgver=0.15.0
pkgrel=0
pkgdesc="Suite of tools for connecting to PalmOS handheld devices"
url="https://github.com/desrod/pilot-link"
license="GPL-2.0-only"
arch="all"
makedepends="
	libtool
	autoconf
	automake
	bison
	popt-dev
	bluez-dev
	libpng-dev
	libusb-dev
	readline-dev
	linux-headers
	gnu-libiconv-dev
	libxslt
	docbook-xml
	docbook-xsl-nons
	"
source="https://github.com/desrod/pilot-link/releases/download/v$pkgver/pilot-link-$pkgver.tar.gz
	config.guess
	config.sub
	"
subpackages="$pkgname-doc $pkgname-dev $pkgname-libs"

prepare() {
	cp "$srcdir/config.guess" "$builddir/"
	cp "$srcdir/config.sub" "$builddir/"
	default_prepare
	update_config_sub
	update_config_guess
}

build() {
	local _docbook_xsl
	_docbook_xsl=$(find /usr/share/xml/docbook -path '*nons/html/docbook.xsl' \
		2>/dev/null | head -n1)
	_docbook_xsl=${_docbook_xsl%/html/docbook.xsl}
	[ -n "$_docbook_xsl" ] || { error "docbook-xsl-nons stylesheets not found"; return 1; }

	./autogen.sh \
		--prefix=/usr \
		--enable-conduits \
		--enable-libusb \
		--with-libiconv \
		--with-libpng \
		--enable-xsltproc \
		--with-docbook-xsl="${_docbook_xsl%/}"

	make
}

check() {
	make check
}

package() {
	depends="$pkgname-libs"
	make DESTDIR="$pkgdir" install
}

