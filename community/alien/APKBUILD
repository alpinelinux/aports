pkgname=alien
pkgver=8.95.9
pkgrel=0
pkgdesc="Alien is a program that converts between the rpm, dpkg, stampede slp, and slackware tgz file formats"
url="http://joeyh.name/code/alien"
arch="noarch"
license="GPL-2.0-only"
depends="perl"
subpackages="$pkgname-doc"
source="https://deb.debian.org/debian/pool/main/a/alien/alien_$pkgver.orig.tar.gz"
options="!check" # Has no tests

build() {
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL \
		INSTALLDIRS=vendor \
		NO_PACKLIST=1 \
		NO_PERLLOCAL=1
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
