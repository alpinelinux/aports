Use a maven version that exists and fetch it from archive.apache.org,
which keeps old releases, unlike downloads.apache.org.

--- a/build.xml
+++ b/build.xml
@@ -1029,11 +1029,11 @@ ${basedir}/../cl-bench
 	 <https://maven.apache.org/docs/history.html>
     -->
     <property name="maven.version"
-	      value="3.9.12"/>
+	      value="3.9.15"/>
     <property name="maven.dist.name"
               value="apache-maven-${maven.version}-bin.zip"/>
     <property name="maven.dist.uri"
-              value="http://www.apache.org/dist/maven/maven-3/${maven.version}/binaries/${maven.dist.name}"/>
+              value="https://archive.apache.org/dist/maven/maven-3/${maven.version}/binaries/${maven.dist.name}"/>
     <property name="maven.local.path"
               value="${abcl.ext.dir}/${maven.dist.name}"/>
 
