rename to src/logo/ascii/p/nura.txt
diff --git a/src/logo/ascii/p/postmarketos2.txt b/src/logo/ascii/p/nura2.txt
similarity index 100%
rename from src/logo/ascii/p/postmarketos2.txt
rename to src/logo/ascii/p/nura2.txt
diff --git a/src/logo/ascii/p/postmarketos_small.txt b/src/logo/ascii/p/nura_small.txt
