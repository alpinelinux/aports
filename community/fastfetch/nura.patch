From 0a597f2c63ab4a186da8d3d90c10548e340ef2fe Mon Sep 17 00:00:00 2001
From: Achill Gilgenast <achill@achill.org>
Date: Mon, 28 Sep 2026 14:47:34 +0200
Subject: [PATCH] Logo (Builtin): rename postmarketos to nura

We changed our os-release ID in https://gitlab.postmarketos.org/postmarketOS/pmaports/-/merge_requests/9638
---
 src/logo/ascii/n.inc                          | 35 +++++++++++++++++++
 src/logo/ascii/p.inc                          | 35 -------------------
 .../ascii/p/{postmarketos.txt => nura.txt}    |  0
 .../ascii/p/{postmarketos2.txt => nura2.txt}  |  0
 ...{postmarketos_small.txt => nura_small.txt} |  0
 5 files changed, 35 insertions(+), 35 deletions(-)
 rename src/logo/ascii/p/{postmarketos.txt => nura.txt} (100%)
 rename src/logo/ascii/p/{postmarketos2.txt => nura2.txt} (100%)
 rename src/logo/ascii/p/{postmarketos_small.txt => nura_small.txt} (100%)

diff --git a/src/logo/ascii/n.inc b/src/logo/ascii/n.inc
index e45d33ed13..dcd629a67d 100644
--- a/src/logo/ascii/n.inc
+++ b/src/logo/ascii/n.inc
@@ -213,6 +213,41 @@ static const FFlogo N[] = {
         .colorTitle = FF_COLOR_FG_DEFAULT,
     },
     #endif
+    #ifdef FASTFETCH_DATATEXT_LOGO_NURA
+    // Nura
+    {
+        .names = { "Nura" },
+        .lines = FASTFETCH_DATATEXT_LOGO_NURA,
+        .colors = {
+            FF_COLOR_FG_GREEN,
+            FF_COLOR_FG_WHITE,
+        },
+    },
+    #endif
+    #ifdef FASTFETCH_DATATEXT_LOGO_NURA2
+    // Nura2
+    {
+        .names = { "Nura2" },
+        .type = FF_LOGO_LINE_TYPE_ALTER_BIT,
+        .lines = FASTFETCH_DATATEXT_LOGO_NURA2,
+        .colors = {
+            FF_COLOR_FG_GREEN,
+            FF_COLOR_FG_WHITE,
+        },
+    },
+    #endif
+    #ifdef FASTFETCH_DATATEXT_LOGO_NURA_SMALL
+    // NuraSmall
+    {
+        .names = { "Nura_small" },
+        .type = FF_LOGO_LINE_TYPE_SMALL_BIT,
+        .lines = FASTFETCH_DATATEXT_LOGO_NURA_SMALL,
+        .colors = {
+            FF_COLOR_FG_GREEN,
+            FF_COLOR_FG_WHITE,
+        },
+    },
+    #endif
     #ifdef FASTFETCH_DATATEXT_LOGO_NUROS
     // NurOS
     {
diff --git a/src/logo/ascii/p.inc b/src/logo/ascii/p.inc
index 2cdbff886c..90c8f469f8 100644
--- a/src/logo/ascii/p.inc
+++ b/src/logo/ascii/p.inc
@@ -273,41 +273,6 @@ static const FFlogo P[] = {
         },
     },
     #endif
-    #ifdef FASTFETCH_DATATEXT_LOGO_POSTMARKETOS
-    // PostMarketOS
-    {
-        .names = { "PostMarketOS" },
-        .lines = FASTFETCH_DATATEXT_LOGO_POSTMARKETOS,
-        .colors = {
-            FF_COLOR_FG_GREEN,
-            FF_COLOR_FG_WHITE,
-        },
-    },
-    #endif
-    #ifdef FASTFETCH_DATATEXT_LOGO_POSTMARKETOS2
-    // PostMarketOS2
-    {
-        .names = { "PostMarketOS2" },
-        .type = FF_LOGO_LINE_TYPE_ALTER_BIT,
-        .lines = FASTFETCH_DATATEXT_LOGO_POSTMARKETOS2,
-        .colors = {
-            FF_COLOR_FG_GREEN,
-            FF_COLOR_FG_WHITE,
-        },
-    },
-    #endif
-    #ifdef FASTFETCH_DATATEXT_LOGO_POSTMARKETOS_SMALL
-    // PostMarketOSSmall
-    {
-        .names = { "PostMarketOS_small" },
-        .type = FF_LOGO_LINE_TYPE_SMALL_BIT,
-        .lines = FASTFETCH_DATATEXT_LOGO_POSTMARKETOS_SMALL,
-        .colors = {
-            FF_COLOR_FG_GREEN,
-            FF_COLOR_FG_WHITE,
-        },
-    },
-    #endif
     #ifdef FASTFETCH_DATATEXT_LOGO_PROXMOX
     // Proxmox
     {
diff --git a/src/logo/ascii/p/postmarketos.txt b/src/logo/ascii/p/nura.txt
similarity index 100%
rename from src/logo/ascii/p/postmarketos.txt
rename to src/logo/ascii/p/nura.txt
diff --git a/src/logo/ascii/p/postmarketos2.txt b/src/logo/ascii/p/nura2.txt
similarity index 100%
rename from src/logo/ascii/p/postmarketos2.txt
rename to src/logo/ascii/p/nura2.txt
diff --git a/src/logo/ascii/p/postmarketos_small.txt b/src/logo/ascii/p/nura_small.txt
similarity index 100%
rename from src/logo/ascii/p/postmarketos_small.txt
rename to src/logo/ascii/p/nura_small.txt
