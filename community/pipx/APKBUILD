maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=pipx
pkgver=1.18.16
pkgrel=0
pkgdesc="Install and Run Python Applications in Isolated Environments"
url="https://github.com/pypa/pipx"
arch="noarch"
license="MIT"
depends="
	py3-argcomplete
	py3-colorama
	py3-filelock
	py3-packaging
	py3-platformdirs
	py3-userpath
	"
makedepends="
	py3-docutils
	py3-gpep517
	py3-hatchling
	py3-hatch-fancy-pypi-readme
	py3-hatch-vcs
	"
checkdepends="
	py3-pytest
	"
subpackages="$pkgname-doc $pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/pypa/pipx/archive/refs/tags/$pkgver.tar.gz"
options="!check" # need some packages that i'm not sure of

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -p no:warnings
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
032e33f8a62e522e699694ff4aa7f33fde4bfc8b0931f8c60be776633517a31a6951147d4dd9be7165cc8533e78f386b8b50469489b1c4acc9710c31e4cc678c  pipx-1.18.16.tar.gz
"
