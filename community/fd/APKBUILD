fa8d83edda0923fe4a844af567869250646419680d4a495ed8b5526d7fb9e1f5178ad54303ec0aa609bccab7b4fbef5bcdc2951fc93b6acc2352d3346357f3d5  001-default-env-color.patch
9fd32f8550b15181af8ca689ad5ad059a71a0caa80e5833a1b1ed7c885bb324a9d2f6b6811b30829ae6432d89d4a52638bce6d3c8c5c1835b44e8ffe3c063ffe  002-enable-jemalloc.patch
"
