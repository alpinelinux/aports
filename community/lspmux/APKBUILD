maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=lspmux
pkgver=0.3.0
pkgrel=0
pkgdesc="Share one instance of an LSP between multiple clients"
url="https://codeberg.org/p2502/lspmux"
arch="all"
license="EUPL-1.2"
makedepends="cargo-auditable"
subpackages="$pkgname-doc"
source="lspmux-$pkgver-1.tar.gz::https://codeberg.org/p2502/lspmux/archive/v$pkgver.tar.gz"
options="net" # fetch dependencies
builddir="$srcdir/lspmux"
provides="ra-multiplex=$pkgver-r$pkgrel" # old name

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/lspmux -t "$pkgdir/usr/bin/"
	install -Dm755 LICENSE defaults.toml -t "$pkgdir/usr/share/doc/$pkgname/"
}

sha512sums="
ec637b5bf99cdf68e887329b90f5743e1ce58a597c67457e6f50b89397e37190e75b059986fd076dc730aef8fa8e201f95296b42e0702fe6a8c59eb294f9179c  lspmux-0.3.0-1.tar.gz
"
