diff --git a/test/python/claim_exit/wsgi.py b/test/python/claim_exit/wsgi.py
new file mode 100644
index 00000000..538a66df
--- /dev/null
+++ b/test/python/claim_exit/wsgi.py
@@ -0,0 +1,145 @@
+"""A worker that dies after it claims a request and before it acknowledges it.
+
+At import, the worker starts a thread.  The thread waits for the file that
+$CLAIM_EXIT_TRIGGER names and renames it, so only one worker takes it.  Then
+it installs a seccomp filter that kills the
+process at its next sendmsg(2), and it writes "armed", or the reason it could
+not, to the file that $CLAIM_EXIT_STATUS names.
+
+The worker serves no request before that.  For its first request, it claims
+the item in the shared queue (nxt_unit_app_queue_recv() in src/nxt_unit.c),
+and then it asks the main port of the router for the shared memory segment
+and the engine port that the request needs.  Those requests are the first
+sendmsg() after the claim, so the filter kills the worker there: the request
+is claimed and never acknowledged.
+
+The main port of the router has no shared memory queue.  A worker that knows
+the engine port already sends its REQ_HEADERS_ACK to that port, and it puts a
+READ_SOCKET marker in the queue of the port before the sendmsg().  A kill at
+that sendmsg() leaves the marker without its datagram, and the router reads
+that engine port one datagram behind (see nxt_unit_req_send()).  So the
+worker must not serve a request before the kill.
+"""
+
+import ctypes
+import os
+import platform
+import struct
+import threading
+import time
+
+# The syscall numbers and the audit architecture of each supported machine:
+# the audit architecture, the number of sendmsg(2) and the number of seccomp(2).
+# "arm" is the 32-bit ARM ABI (AUDIT_ARCH_ARM), also on a 64-bit ARM kernel.
+ARCHES = {
+    'x86_64': (0xC000003E, 46, 317),
+    'aarch64': (0xC00000B7, 211, 277),
+    'arm': (0x40000028, 296, 383),
+}
+
+PR_SET_NO_NEW_PRIVS = 38
+SECCOMP_SET_MODE_FILTER = 1
+SECCOMP_FILTER_FLAG_TSYNC = 1
+SECCOMP_RET_KILL_PROCESS = 0x80000000
+SECCOMP_RET_ALLOW = 0x7FFF0000
+
+BPF_LD_W_ABS = 0x20
+BPF_JEQ_K = 0x15
+BPF_RET_K = 0x06
+
+
+class SockFprog(ctypes.Structure):
+    _fields_ = [('len', ctypes.c_ushort), ('filter', ctypes.c_void_p)]
+
+
+def machine():
+    # The kernel decides the ABI of a system call by the process, not by the
+    # machine.  A 32-bit Python on a 64-bit ARM kernel reports "aarch64" or
+    # "armv8l" in uname(2), but its system calls use the 32-bit ARM ABI.  So
+    # take the width of a pointer into account.  A filter for the wrong ABI
+    # never fires, and the number of seccomp(2) would be wrong too.
+    name = platform.machine()
+
+    if struct.calcsize('P') == 4:
+        if name in ('aarch64', 'armv8l', 'armv7l', 'armv6l'):
+            return 'arm'
+
+        return f'{name} (32-bit process)'
+
+    return name
+
+
+def install_filter():
+    name = machine()
+    arch = ARCHES.get(name)
+    if arch is None:
+        return f'no syscall table for {name}'
+
+    audit_arch, nr_sendmsg, nr_seccomp = arch
+
+    # Offsets in struct seccomp_data: nr is at 0, arch is at 4.
+    insns = [
+        (BPF_LD_W_ABS, 0, 0, 4),
+        (BPF_JEQ_K, 0, 3, audit_arch),
+        (BPF_LD_W_ABS, 0, 0, 0),
+        (BPF_JEQ_K, 0, 1, nr_sendmsg),
+        (BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS),
+        (BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW),
+    ]
+
+    code = b''.join(struct.pack('=HBBI', *insn) for insn in insns)
+    buf = ctypes.create_string_buffer(code, len(code))
+    prog = SockFprog(len(insns), ctypes.addressof(buf))
+
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.prctl.argtypes = [ctypes.c_int] + [ctypes.c_ulong] * 4
+    libc.syscall.restype = ctypes.c_long
+
+    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
+        return f'prctl: errno {ctypes.get_errno()}'
+
+    ret = libc.syscall(
+        ctypes.c_long(nr_seccomp),
+        ctypes.c_long(SECCOMP_SET_MODE_FILTER),
+        ctypes.c_long(SECCOMP_FILTER_FLAG_TSYNC),
+        ctypes.byref(prog),
+    )
+
+    if ret != 0:
+        return f'seccomp: {ret}, errno {ctypes.get_errno()}'
+
+    return 'armed'
+
+
+def arm(trigger, status):
+    # The rename takes the trigger once.  The worker that replaces the dead
+    # one imports this module too, and it must not arm itself.
+    deadline = time.monotonic() + 120
+
+    while time.monotonic() < deadline:
+        try:
+            os.rename(trigger, f'{trigger}.taken')
+
+        except FileNotFoundError:
+            time.sleep(0.01)
+            continue
+
+        result = install_filter()
+
+        # write(2) is allowed: the filter stops only sendmsg(2).
+        with open(status, 'w') as f:
+            f.write(result)
+
+        return
+
+
+threading.Thread(
+    target=arm,
+    args=(os.environ['CLAIM_EXIT_TRIGGER'], os.environ['CLAIM_EXIT_STATUS']),
+    daemon=True,
+).start()
+
+
+def application(environ, start_response):
+    start_response('200', [('Content-Length', '0')])
+    return []
diff --git a/test/test_app_claim_exit.py b/test/test_app_claim_exit.py
new file mode 100644
index 00000000..13c78870
--- /dev/null
+++ b/test/test_app_claim_exit.py
@@ -0,0 +1,155 @@
+"""A worker that dies after it claims a request and before it acknowledges it.
+
+Issue: https://github.com/freeunitorg/freeunit/issues/665
+
+A worker takes a request from the shared queue of its application with a
+compare-and-swap, and only the REQ_HEADERS_ACK that follows tells the router
+which worker it was.  A worker that died between the two left the request with
+no answer and no deadline, because REMOVE_PID fails only the requests whose
+RPC peer is the dead process, and a request gets its peer at the
+acknowledgement.  The request also kept its application and its connection,
+so a configuration that removed the application did not free it, and the
+listener stayed bound: every later configuration on the same port failed with
+"bind() ... (98: Address already in use)".
+
+The kill is not a race here.  The application (test/python/claim_exit)
+installs a seccomp filter that kills the worker at its next sendmsg(2).  The
+worker has served no request, so the first sendmsg() after its first claim
+asks the router for the shared memory segment of the request.  So the request
+is always claimed and never acknowledged.
+
+The router now gives such a request a deadline of NXT_ROUTER_CLAIM_DEADLINE
+(5 s, src/nxt_router_request.h) after REMOVE_PID, and answers 503 at the
+deadline.  The test checks the answer and its time, and then that the
+application is freed and the port can be bound again.
+"""
+
+import os
+import re
+import subprocess
+import time
+
+import pytest
+
+from unit.applications.lang.python import ApplicationPython
+
+prerequisites = {'modules': {'python': 'any'}}
+
+client = ApplicationPython()
+
+# NXT_ROUTER_CLAIM_DEADLINE in src/nxt_router_request.h, in seconds.
+CLAIM_DEADLINE = 5
+
+# The bound for the 503.  The deadline starts when the router reads
+# REMOVE_PID, which comes after the prototype reaps the worker, so a loaded
+# host adds some time.  Without the fix no answer comes at all.
+ANSWER_BOUND = CLAIM_DEADLINE + 10
+
+
+def app_pids(name, kind=r'\w+'):
+    """Pids of the processes of application "name": "prototype",
+    "application" (a worker), or both."""
+
+    output = subprocess.check_output(['ps', 'ax', '-o', 'pid=,args=']).decode()
+    title = fr'^\s*(\d+)\s+unit: "{name}" {kind}$'
+
+    return [int(m.group(1)) for m in re.finditer(title, output, re.M)]
+
+
+def pid_alive(pid):
+    try:
+        os.kill(pid, 0)
+
+    except ProcessLookupError:
+        return False
+
+    return True
+
+
+def wait_for(predicate, timeout):
+    end = time.monotonic() + timeout
+
+    while time.monotonic() < end:
+        if predicate():
+            return True
+
+        time.sleep(0.1)
+
+    return predicate()
+
+
+def read_file(path):
+    try:
+        with open(path, encoding='utf-8') as f:
+            return f.read()
+
+    except FileNotFoundError:
+        return ''
+
+
+def test_app_claim_exit(temp_dir, skip_alert, wait_for_record):
+    # The worker dies of SIGSYS from its own filter.
+    skip_alert(r'process \d+ exited on signal')
+
+    trigger = f'{temp_dir}/claim_exit.trigger'
+    status = f'{temp_dir}/claim_exit.status'
+
+    client.load(
+        'claim_exit',
+        processes=1,
+        environment={
+            'CLAIM_EXIT_TRIGGER': trigger,
+            'CLAIM_EXIT_STATUS': status,
+        },
+    )
+
+    # The worker must not serve a request before the kill; see the
+    # application.  So it is found by its process title, not by a request.
+    assert (
+        wait_for_record(r'"claim_exit" application started') is not None
+    ), 'worker start'
+
+    workers = app_pids('claim_exit', 'application')
+    assert len(workers) == 1, f'workers: {workers}'
+
+    with open(trigger, 'w', encoding='utf-8'):
+        pass
+
+    assert wait_for(lambda: read_file(status) != '', 30), 'filter status'
+
+    result = read_file(status)
+    if result != 'armed':
+        pytest.skip(f'cannot install the seccomp filter: {result!r}')
+
+    start = time.monotonic()
+    resp = client.get(read_timeout=ANSWER_BOUND)
+    elapsed = time.monotonic() - start
+
+    assert resp.get('status') == 503, (
+        f'no answer for a claimed request after {elapsed:.1f} s'
+    )
+    assert elapsed < ANSWER_BOUND, 'answer time'
+    assert elapsed >= CLAIM_DEADLINE - 1, 'answered before the deadline'
+
+    assert wait_for(lambda: not pid_alive(workers[0]), 10), 'worker exit'
+    assert (
+        wait_for_record(r'stream #\d+ is claimed and not acknowledged')
+        is not None
+    ), 'claim deadline log'
+
+    # The request released the application: removing it from the
+    # configuration frees it, which stops its prototype and workers.
+    pids = app_pids('claim_exit')
+    assert pids, 'application processes'
+
+    assert 'success' in client.conf({"listeners": {}, "applications": {}})
+
+    assert wait_for(lambda: not any(pid_alive(p) for p in pids), 20), (
+        f'application processes left: {[p for p in pids if pid_alive(p)]}'
+    )
+
+    # The request released its connection, so the listener is closed and
+    # the same port can be bound again.
+    client.load('empty')
+
+    assert client.get()['status'] == 200, 'the port is bound again'
