+/*
+ * A worker exited.  Find the requests of this engine that it may have taken
+ * with it.  nxt_router_remove_pid_handler() runs this on every engine after
+ * the main thread has closed the ports of the process.
+ */
+
+static void
+nxt_router_engine_claims_check(nxt_task_t *task)
+{
+    nxt_request_rpc_data_t  *req_rpc_data;
+
+    nxt_queue_each(req_rpc_data, &task->thread->engine->unacked_requests,
+                   nxt_request_rpc_data_t, engine_link)
+    {
+        nxt_router_claim_deadline(task, req_rpc_data);
+
+    } nxt_queue_loop;
+}
+
+
+/*
+ * A worker takes a request from the shared queue in two steps: it dequeues
+ * the item, and then it claims the item with a compare-and-swap on the
+ * tracking word.  The router learns which worker it was only from the
+ * acknowledgement that follows.  If the worker dies after the dequeue and
+ * before the acknowledgement, nothing answers the request.  REMOVE_PID cannot
+ * fail it, because the request has no RPC peer yet.  Without "limits":
+ * {"timeout"} it also has no deadline.  The request then holds the
+ * application for ever, so a configuration that removes the application
+ * never frees it, and the connection of the request keeps its listener bound.
+ *
+ * So, after each exit, look at every request of this engine that is not
+ * acknowledged:
+ *
+ *   - If the item is still in the queue, a worker can still take it.  Leave
+ *     it.
+ *
+ *   - If the item left the queue and the retraction wins, no worker claimed
+ *     it, and the compare-and-swap of any worker now fails.  The worker that
+ *     dequeued it died before its claim.  Answer 503 at once: no worker runs
+ *     the request.
+ *
+ *   - If the retraction loses, a worker claimed the request.  Give it a
+ *     deadline of NXT_ROUTER_CLAIM_DEADLINE.  At the deadline,
+ *     nxt_router_app_timeout() answers 503 and unlinks the request, as at
+ *     the second expiry of a claimed request.
+ *
+ * The unlink releases the application and the connection.
+ *
+ * The claim does not tell which worker made it, so a live worker can hold
+ * such a request too.  A live worker sends the acknowledgement right after
+ * the claim, or after it gets a port or a shared memory segment from the
+ * router.  The deadline is long for those waits, and the acknowledgement
+ * removes it.  A claim after this check gets no deadline, because a dead
+ * worker cannot make it.
+ */
+
+static void
+nxt_router_claim_deadline(nxt_task_t *task,
+    nxt_request_rpc_data_t *req_rpc_data)
+{
+    nxt_app_t           *app;
+    nxt_port_t          *port;
+    nxt_msec_t          timeout;
+    nxt_msg_info_t      *msg_info;
+    nxt_http_request_t  *r;
+
+    app = req_rpc_data->app;
+    port = req_rpc_data->app_port;
+    r = req_rpc_data->request;
+    msg_info = &req_rpc_data->msg_info;
+
+    if (req_rpc_data->claim_deadline
+        || app == NULL || r == NULL || msg_info->buf == NULL
+        || port == NULL || port->id != NXT_SHARED_PORT_ID
+        || port->queue == NULL)
+    {
+        return;
+    }
+
+    if (msg_info->cancel == NXT_MSG_QUEUED) {
+        /* A failed send leaves no item in the queue. */
+        if (!msg_info->buf->is_port_mmap_sent
+            || !nxt_app_queue_taken(port->queue, msg_info->queue_pos))
+        {
+            return;
+        }
+
+        (void) nxt_router_msg_retract(task, req_rpc_data);
+    }
+
+    if (msg_info->cancel == NXT_MSG_RETRACTED) {
+        nxt_log(task, NXT_LOG_WARN, "app \"%V\": a worker exited after it "
+                "took stream #%uD from the queue and before it claimed it, "
+                "answering 503", &app->name, req_rpc_data->stream);
+
+        timeout = 0;
+
+    } else if (msg_info->cancel == NXT_MSG_CLAIMED) {
+
+        if (app->timeout != 0 && app->timeout <= NXT_ROUTER_CLAIM_DEADLINE) {
+            /* The deadline of the application is sooner. */
+            req_rpc_data->claim_deadline = 1;
+            return;
+        }
+
+        nxt_log(task, NXT_LOG_WARN, "app \"%V\": a worker exited, and "
+                "stream #%uD is claimed and not acknowledged; it is answered "
+                "with 503 in %d ms if no acknowledgement comes", &app->name,
+                req_rpc_data->stream, NXT_ROUTER_CLAIM_DEADLINE);
+
+        /* The next expiry answers; see nxt_router_app_timeout(). */
+        req_rpc_data->claimed_expired = 1;
+
+        timeout = NXT_ROUTER_CLAIM_DEADLINE;
+
+    } else {
+        return;
+    }
+
+    req_rpc_data->claim_deadline = 1;
+
+    r->timer.handler = nxt_router_app_timeout;
+    r->timer_data = req_rpc_data;
+
+    nxt_timer_add(task->thread->engine, &r->timer, timeout);
+}
