Patch-Source: https://github.com/freeunitorg/freeunit/pull/888
From 5272d5f4cf65d09bab7a4894f39c591d151e3be7 Mon Sep 17 00:00:00 2001
From: Andy Postnikov <apostnikov@gmail.com>
Date: Wed, 4 Nov 2026 05:33:15 +0100
Subject: [PATCH 1/2] http: compare the Accept-Encoding name a word at a time

This fixes a cost that 0daef33c added after 1.37.1, before it ships in a
release.

Since 0daef33c, every application response of unknown length is
negotiated, and a PHP script that echoes its output sends no
Content-Length.  So nxt_http_comp_accept_encoding() now runs for each
such response, also with no "compression" configured.  It finds the
Accept-Encoding field with nxt_strncasecmp(), which folds one byte at a
time.  For a request with Accept-Encoding, that compare is the largest
part of the check.

The new nxt_http_comp_is_accept_encoding() compares the 15 bytes of the
name in loads of 8, 4, 2 and 1 bytes.  It sets bit 0x20 in each letter
position and compares with "accept-encoding".  A byte then matches only
if it is that letter in upper or lower case, which is the fold of
nxt_lowcase().  The '-' is not folded.  The constant and the mask are
read from byte arrays with the same loads as the name, so the byte order
does not matter.  No byte after the 15th is read.

nxt_strncasecmp() stops at a NUL only when both strings have one there.
"Accept-Encoding" has no NUL, so a name with a NUL never matched, and it
does not match now.  The result is the same for every name.

Behaviour does not change: the 406 for "identity;q=0" stays, with and
without "compression".

Measured with callgrind on the router, 3000 PHP hello requests, no
"compression": nxt_http_comp_check_acceptable() costs 205 instructions
per request instead of 340 with "Accept-Encoding: gzip, compress,
deflate, br", and 140 as before with no Accept-Encoding.

Test: src/test/nxt_tests.c compares the helper with nxt_strncasecmp()
on all 16384 case variants, every byte value at every position of three
spellings, and each length from 0 to 16.  Each name ends at a PROT_NONE
page, so a read past the 15 bytes kills the test.  With the '-' folded
too, the test fails on "Accept\rEncoding": it gave 1, not 0.

Co-Authored-By: Claude Opus 5.5 (claude 2.1.316)
Reviewed-by: Codex
Reviewed-by: DeepSeek V4.1 Flash (dsh 0.2.1-rc.5)
---
 src/nxt_http_compression.c |  71 +++++++++++++++-
 src/nxt_http_compression.h |   2 +
 src/test/nxt_tests.c       | 169 ++++++++++++++++++++++++++++++++++++-
 3 files changed, 237 insertions(+), 5 deletions(-)

diff --git a/src/nxt_http_compression.c b/src/nxt_http_compression.c
index c42bed350..1e81e0a59 100644
--- a/src/nxt_http_compression.c
+++ b/src/nxt_http_compression.c
@@ -751,6 +751,58 @@ nxt_http_comp_compressor_lookup_enabled(const nxt_http_comp_conf_t *conf,
  *
  * 'identity;q=0' seems to basically mean the same thing...
  */
+/*
+ * Tells whether a field name of 15 bytes is "Accept-Encoding" in any case.
+ * The result is that of nxt_strncasecmp() with "Accept-Encoding", but the
+ * compare takes 8, 4, 2 and 1 bytes at a time, and it reads only the 15
+ * bytes of the name.
+ *
+ * The fold mask sets bit 0x20 in each letter of the name.  A byte then
+ * gives the lowercase letter only if it is that letter in upper or lower
+ * case.  That is the fold of nxt_lowcase().  The '-' is not folded, so it
+ * must match exactly.  A NUL in the name does not match, as in
+ * nxt_strncasecmp(): the constant has no NUL to stop at.
+ *
+ * The constant and the mask are loaded from byte arrays in the same way as
+ * the name.  So the result does not depend on the byte order.
+ */
+
+nxt_inline bool
+nxt_http_comp_is_accept_encoding(const u_char *name)
+{
+    uint16_t  n2, l2, m2;
+    uint32_t  n4, l4, m4;
+    uint64_t  n8, l8, m8;
+
+    static const u_char  low[15] = {
+        'a', 'c', 'c', 'e', 'p', 't', '-',
+        'e', 'n', 'c', 'o', 'd', 'i', 'n', 'g',
+    };
+
+    static const u_char  fold[15] = {
+        0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x00,
+        0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20,
+    };
+
+    memcpy(&n8, name, 8);
+    memcpy(&l8, low, 8);
+    memcpy(&m8, fold, 8);
+
+    memcpy(&n4, name + 8, 4);
+    memcpy(&l4, low + 8, 4);
+    memcpy(&m4, fold + 8, 4);
+
+    memcpy(&n2, name + 12, 2);
+    memcpy(&l2, low + 12, 2);
+    memcpy(&m2, fold + 12, 2);
+
+    return (n8 | m8) == l8
+           && (n4 | m4) == l4
+           && (uint16_t) (n2 | m2) == l2
+           && (u_char) (name[14] | fold[14]) == low[14];
+}
+
+
 /*
  * Collects every Accept-Encoding field into one value.
  *
@@ -787,8 +839,7 @@ nxt_http_comp_accept_encoding(nxt_http_request_t *r, nxt_str_t *value)
          f = nxt_http_fields_next(&iter))
     {
         if (f->skip || f->name_length != accept_encoding.length
-            || nxt_strncasecmp(f->name, accept_encoding.start,
-                               accept_encoding.length) != 0)
+            || !nxt_http_comp_is_accept_encoding(f->name))
         {
             continue;
         }
@@ -832,8 +883,7 @@ nxt_http_comp_accept_encoding(nxt_http_request_t *r, nxt_str_t *value)
          f = nxt_http_fields_next(&iter))
     {
         if (f->skip || f->name_length != accept_encoding.length
-            || nxt_strncasecmp(f->name, accept_encoding.start,
-                               accept_encoding.length) != 0)
+            || !nxt_http_comp_is_accept_encoding(f->name))
         {
             continue;
         }
@@ -1985,6 +2035,19 @@ nxt_http_comp_compression_init(nxt_task_t *task, nxt_router_conf_t *rtcf,
 
 #if (NXT_TESTS)
 
+/*
+ * For src/test/nxt_tests.c: the name test of the scan in
+ * nxt_http_comp_accept_encoding().
+ */
+
+bool
+nxt_http_comp_test_accept_encoding_name(const u_char *name, size_t length)
+{
+    return length == nxt_length("Accept-Encoding")
+           && nxt_http_comp_is_accept_encoding(name);
+}
+
+
 /*
  * For src/test/nxt_http_comp_select_test.c.  With "compression" set, every
  * coding of this build is enabled once, with "min_len" for each compressor.
diff --git a/src/nxt_http_compression.h b/src/nxt_http_compression.h
index 8064e4a51..e6e6d2d34 100644
--- a/src/nxt_http_compression.h
+++ b/src/nxt_http_compression.h
@@ -117,6 +117,8 @@ extern nxt_int_t nxt_http_comp_compression_init(nxt_task_t *task,
     nxt_router_conf_t *rtcf, const nxt_conf_value_t *comp_conf);
 
 #if (NXT_TESTS)
+extern bool nxt_http_comp_test_accept_encoding_name(const u_char *name,
+    size_t length);
 extern nxt_int_t nxt_http_comp_test_select(nxt_http_request_t *r,
     const nxt_str_t *value, nxt_bool_t compression, nxt_off_t min_len,
     nxt_bool_t negotiate, bool *identity_refused);
diff --git a/src/test/nxt_tests.c b/src/test/nxt_tests.c
index 8bcbaca5e..aaa719ded 100644
--- a/src/test/nxt_tests.c
+++ b/src/test/nxt_tests.c
@@ -6,6 +6,9 @@
 
 #include <nxt_main.h>
 #include <nxt_application.h>
+#include <nxt_router.h>
+#include <nxt_http.h>
+#include <nxt_http_compression.h>
 #include "nxt_tests.h"
 
 
@@ -71,13 +74,177 @@ nxt_test_in_child(nxt_thread_t *thr, const char *name, int (*fn)(void *),
 }
 
 
+/*
+ * The name test of nxt_http_comp_accept_encoding() compares 8, 4, 2 and 1
+ * bytes at a time.  Its result must be that of nxt_strncasecmp() with
+ * "Accept-Encoding", the compare that it replaced.  The names are every
+ * case variant, every byte at every position of three spellings, and each
+ * length from 0 to 16.  Each name ends where a PROT_NONE page starts, so a
+ * read past the length kills the child.
+ */
+
+typedef struct {
+    nxt_thread_t  *thr;
+    u_char        *end;
+} nxt_http_comp_name_test_ctx_t;
+
+
+static nxt_int_t
+nxt_http_comp_name_test_one(nxt_http_comp_name_test_ctx_t *ctx,
+    const u_char *src, size_t length)
+{
+    bool    got, want;
+    u_char  *name, *p;
+    size_t  i;
+    u_char  hex[2 * 16];
+
+    static const u_char  digits[] = "0123456789abcdef";
+
+    name = ctx->end - length;
+    nxt_memcpy(name, src, length);
+
+    got = nxt_http_comp_test_accept_encoding_name(name, length);
+    want = (length == nxt_length("Accept-Encoding")
+            && nxt_strncasecmp(name, (const u_char *) "Accept-Encoding",
+                               length) == 0);
+
+    if (got != want) {
+        p = hex;
+
+        for (i = 0; i < length; i++) {
+            *p++ = digits[src[i] >> 4];
+            *p++ = digits[src[i] & 0xf];
+        }
+
+        nxt_log_alert(ctx->thr->log, "accept-encoding name test failed: "
+                      "name %*s (hex), length %uz, gave %d, not %d",
+                      (size_t) (p - hex), hex, length, got, want);
+
+        return NXT_ERROR;
+    }
+
+    return NXT_OK;
+}
+
+
+static int
+nxt_http_comp_name_test_child(void *data)
+{
+    u_char                         buf[17];
+    size_t                         len, pos;
+    nxt_uint_t                     v, b, i, k;
+    nxt_http_comp_name_test_ctx_t  *ctx;
+
+    static const char  *bases[] = {
+        "Accept-Encoding", "accept-encoding", "ACCEPT-ENCODING",
+    };
+
+    ctx = data;
+
+    len = nxt_length("Accept-Encoding");
+
+    /* Each of the 2^14 case variants of the 14 letters matches. */
+
+    for (v = 0; v < (1u << 14); v++) {
+        nxt_memcpy(buf, "accept-encoding", len);
+
+        for (i = 0, k = 0; i < len; i++) {
+            if (buf[i] == '-') {
+                continue;
+            }
+
+            if (v & (1u << k)) {
+                buf[i] &= (u_char) ~0x20;
+            }
+
+            k++;
+        }
+
+        if (nxt_http_comp_name_test_one(ctx, buf, len) != NXT_OK) {
+            return 1;
+        }
+    }
+
+    /*
+     * Every byte at every position: NUL, the bytes next to the letters,
+     * '-', '_', and the high bytes that differ from a letter only in the
+     * high bit.
+     */
+
+    for (i = 0; i < nxt_nitems(bases); i++) {
+        for (pos = 0; pos < len; pos++) {
+            for (b = 0; b < 256; b++) {
+                nxt_memcpy(buf, bases[i], len);
+                buf[pos] = (u_char) b;
+
+                if (nxt_http_comp_name_test_one(ctx, buf, len) != NXT_OK) {
+                    return 1;
+                }
+            }
+        }
+    }
+
+    /* Each length from 0 to 16, as a prefix of a longer name. */
+
+    nxt_memcpy(buf, "Accept-Encodings", 16);
+
+    for (pos = 0; pos <= 16; pos++) {
+        if (nxt_http_comp_name_test_one(ctx, buf, pos) != NXT_OK) {
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+
+static nxt_int_t
+nxt_http_comp_name_test(nxt_thread_t *thr)
+{
+    int                            ret;
+    u_char                         *p;
+    nxt_http_comp_name_test_ctx_t  ctx;
+
+    p = mmap(NULL, 2 * nxt_pagesize, PROT_READ | PROT_WRITE,
+             MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (p == MAP_FAILED) {
+        nxt_log_alert(thr->log, "accept-encoding name test: mmap() failed %E",
+                      nxt_errno);
+        return NXT_ERROR;
+    }
+
+    if (mprotect(p + nxt_pagesize, nxt_pagesize, PROT_NONE) != 0) {
+        nxt_log_alert(thr->log,
+                      "accept-encoding name test: mprotect() failed %E",
+                      nxt_errno);
+        (void) munmap(p, 2 * nxt_pagesize);
+        return NXT_ERROR;
+    }
+
+    ctx.thr = thr;
+    ctx.end = p + nxt_pagesize;
+
+    ret = nxt_test_in_child(thr, "accept-encoding name test",
+                            nxt_http_comp_name_test_child, &ctx);
+
+    (void) munmap(p, 2 * nxt_pagesize);
+
+    NXT_TEST_CHECK(thr->log, ret == 0,
+                   "accept-encoding name test failed: the child gave %d", ret);
+
+    nxt_log_error(NXT_LOG_NOTICE, thr->log, "accept-encoding name test passed");
+
+    return NXT_OK;
+}
+
+
 static nxt_int_t (*const nxt_security_tests[])(nxt_thread_t *) = {
     nxt_checked_test, nxt_port_mmap_read_test,
     nxt_router_response_parse_test, nxt_port_frag_test,
     nxt_port_release_test, nxt_process_use_test, nxt_nncq_bound_test,
     nxt_nncq_wrap_test,
     nxt_app_queue_test, nxt_size_bound_test, nxt_mp_cluster_cache_test,
-    nxt_casecmp_test,
+    nxt_casecmp_test, nxt_http_comp_name_test,
 #if (NXT_HAVE_REGEX)
     nxt_regex_test,
 #endif

From a6790416636242abf0136b3d76c867ee88952a98 Mon Sep 17 00:00:00 2001
From: Andy Postnikov <apostnikov@gmail.com>
Date: Wed, 4 Nov 2026 18:25:24 +0100
Subject: [PATCH 2/2] http: skip Accept-Encoding negotiation without
 compression

This removes most of what is left of the cost that 0daef33c added after
1.37.1.

Since 0daef33c, every application response of unknown length goes
through nxt_http_comp_check_acceptable(), also with no "compression"
configured.  It reads the response length, scans the response fields
for Content-Encoding, asks "response_headers" for Content-Encoding,
joins the Accept-Encoding fields, and only then sees that compression
is off.  With compression off, identity is the only coding, and the
answer is always the same: serve the response as it is.  The one
exception is a client that refuses identity.

A refusal needs a weight of 0, and a weight comes after a ';'.  This is
already the test in nxt_http_comp_select_compressor().  The new
nxt_http_comp_accept_encoding_has_weight() makes the same test on the
Accept-Encoding fields themselves, with memchr() and no allocation.
nxt_http_comp_check_acceptable() now returns at once when there is no
"compression", no "response_headers" Content-Encoding, and no ';' in any
Accept-Encoding field.  Every path that it skips returned NXT_OK with
no context for such a request.

The 406 for "identity;q=0" stays.  Without "compression", a field with
a ';' takes the full path as before, so "identity;q=0", "*;q=0" and a
refusal in a second field are still answered 406.  With "compression",
nothing changes.  A ';' that refuses nothing ("identity;q=0.5") also
takes the full path, so the shortcut is never wider than the existing
one.

Measured with callgrind on the router of a release build, streamed
WSGI responses without Content-Length, no "compression".  The numbers
are instructions per request in nxt_http_comp_check_acceptable(), the
difference of runs with 1200 and 200 requests:

  no Accept-Encoding                       152 -> 65
  "gzip, deflate, br, zstd"                223 -> 126
  "identity;q=0" (406)                     910 -> 1005

Responses with Content-Length take the same path.  Their cost falls
from 208 to 65 without Accept-Encoding, and from 279 to 126 with
"gzip, compress, deflate, br".  ASGI gives the same numbers.

The refusal pays for the one extra scan.

Test: src/test/nxt_http_comp_select_test.c puts each generated value
into the request as one field and as two, and checks that the shortcut
is taken exactly when no field holds a ';', and only where the full
parse with compression off selects identity and refuses nothing.  With
memchr() reading half of the value, the test fails on ";".
test_python_compression.py checks the 406 for "identity;q=0",
"IDENTITY;Q=0", "gzip, identity;q=0", "*;q=0" and a refusal in a second
field without "compression", and that other requests are served
uncoded.

Co-Authored-By: Grok Bot (temporal 0.75.5)
---
 src/nxt_http_compression.c           | 105 +++++++++++++++++++++++++++
 src/nxt_http_compression.h           |   3 +
 src/test/nxt_http_comp_select_test.c |  35 +++++++++
 test/test_python_compression.py      |  66 +++++++++++++++++
 4 files changed, 209 insertions(+)

diff --git a/src/nxt_http_compression.c b/src/nxt_http_compression.c
index 1e81e0a59..3976198f5 100644
--- a/src/nxt_http_compression.c
+++ b/src/nxt_http_compression.c
@@ -899,6 +899,42 @@ nxt_http_comp_accept_encoding(nxt_http_request_t *r, nxt_str_t *value)
 }
 
 
+/*
+ * With compression off, identity is the only coding, and the client refuses
+ * it only with a weight of 0.  A weight comes after a ';'.  So when no
+ * Accept-Encoding field holds a ';', negotiation cannot end in 406 and has
+ * nothing to select.  This is the same test as the one in
+ * nxt_http_comp_select_compressor(), made on the fields themselves: the
+ * joined value holds a ';' exactly when one of its fields does.  It reads no
+ * response field and allocates nothing.
+ */
+
+static bool
+nxt_http_comp_accept_encoding_has_weight(nxt_http_request_t *r)
+{
+    nxt_http_field_t        *f;
+    nxt_http_fields_iter_t  iter;
+
+    for (f = nxt_http_fields_first(&iter, r->inline_fields,
+                                   r->num_inline_fields, r->fields);
+         f != NULL;
+         f = nxt_http_fields_next(&iter))
+    {
+        if (f->skip || f->name_length != nxt_length("Accept-Encoding")
+            || !nxt_http_comp_is_accept_encoding(f->name))
+        {
+            continue;
+        }
+
+        if (memchr(f->value, ';', f->value_length) != NULL) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
 /*
  * The length that the compressor decision uses.  Returns -1 when the length
  * of the body is not known yet.
@@ -1548,6 +1584,24 @@ nxt_http_comp_check_acceptable(nxt_task_t *task, nxt_http_request_t *r)
      */
     r->comp_ctx = NULL;
 
+    /*
+     * Compression off, no "response_headers" Content-Encoding, and no
+     * Accept-Encoding weight: every path below returns NXT_OK without a
+     * context, because nothing can refuse identity and nothing can code.
+     * So the response fields, the Content-Encoding scan and the joined
+     * Accept-Encoding value are not looked at.  Since every application
+     * response without Content-Length is negotiated, this is the common
+     * case.  A field with a ';' takes the full path, so "identity;q=0" and
+     * "*;q=0" are answered 406 as before.
+     */
+
+    if (conf == NULL
+        && (r->action == NULL || !r->action->set_headers_encoding)
+        && !nxt_http_comp_accept_encoding_has_weight(r))
+    {
+        return NXT_OK;
+    }
+
     /*
      * An empty body has nothing to code.  An application's
      * "Content-Length: 0" is a field, not content_length_n, so it is read
@@ -2082,4 +2136,55 @@ nxt_http_comp_test_select(nxt_http_request_t *r, const nxt_str_t *value,
     return nxt_http_comp_select_compressor(cp, r, value, identity_refused);
 }
 
+
+/*
+ * For src/test/nxt_http_comp_select_test.c: the compression-off shortcut of
+ * nxt_http_comp_check_acceptable().  The value is put into the request as
+ * one Accept-Encoding field, or as two when "split" falls inside it.  Gives
+ * whether the shortcut is taken, and what the full parse of the joined
+ * value says with compression off.
+ */
+
+nxt_int_t
+nxt_http_comp_test_off_shortcut(nxt_http_request_t *r, const nxt_str_t *value,
+    size_t split, bool *shortcut, bool *identity_refused)
+{
+    nxt_int_t         ret;
+    nxt_str_t         joined;
+    nxt_http_field_t  *f;
+
+    static u_char  name[] = "accept-ENCODING";
+
+    r->num_inline_fields = 0;
+    r->fields = NULL;
+
+    f = &r->inline_fields[r->num_inline_fields++];
+    *f = (nxt_http_field_t) { .name = name,
+                              .name_length = nxt_length("Accept-Encoding"),
+                              .value = value->start,
+                              .value_length = value->length };
+
+    if (split > 0 && split < value->length) {
+        f->value_length = split;
+
+        f = &r->inline_fields[r->num_inline_fields++];
+        *f = (nxt_http_field_t) { .name = name,
+                                  .name_length = nxt_length("Accept-Encoding"),
+                                  .value = value->start + split,
+                                  .value_length = value->length - split };
+    }
+
+    *shortcut = !nxt_http_comp_accept_encoding_has_weight(r);
+
+    ret = nxt_http_comp_accept_encoding(r, &joined);
+
+    if (ret == NXT_OK) {
+        ret = nxt_http_comp_negotiate(NULL, r, &joined, identity_refused);
+    }
+
+    r->num_inline_fields = 0;
+
+    return ret;
+}
+
 #endif
diff --git a/src/nxt_http_compression.h b/src/nxt_http_compression.h
index e6e6d2d34..275389682 100644
--- a/src/nxt_http_compression.h
+++ b/src/nxt_http_compression.h
@@ -119,6 +119,9 @@ extern nxt_int_t nxt_http_comp_compression_init(nxt_task_t *task,
 #if (NXT_TESTS)
 extern bool nxt_http_comp_test_accept_encoding_name(const u_char *name,
     size_t length);
+extern nxt_int_t nxt_http_comp_test_off_shortcut(nxt_http_request_t *r,
+    const nxt_str_t *value, size_t split, bool *shortcut,
+    bool *identity_refused);
 extern nxt_int_t nxt_http_comp_test_select(nxt_http_request_t *r,
     const nxt_str_t *value, nxt_bool_t compression, nxt_off_t min_len,
     nxt_bool_t negotiate, bool *identity_refused);
diff --git a/src/test/nxt_http_comp_select_test.c b/src/test/nxt_http_comp_select_test.c
index 04b17dc42..bc32a4950 100644
--- a/src/test/nxt_http_comp_select_test.c
+++ b/src/test/nxt_http_comp_select_test.c
@@ -107,6 +107,41 @@ nxt_hcs_compare(nxt_hcs_ctx_t *ctx, const u_char *p, size_t len)
                        (int) ref_refused);
     }
 
+    /*
+     * The compression-off shortcut of nxt_http_comp_check_acceptable(): it
+     * may skip negotiation only where the full parse with compression off
+     * selects identity and refuses nothing.  It is checked on the value as
+     * one field and split into two fields.
+     */
+
+    for (mode = 0; mode < 3; mode++) {
+        bool    shortcut;
+        size_t  split;
+
+        split = (mode == 0) ? 0 : (mode == 1) ? len / 2 : 1;
+
+        ctx->r->resp.content_length_n = -1;
