pkgver=1.37.1
pkgrel=0
pkgdesc="FreeUnit is a dynamic web application server"
url="https://freeunit.org/"
arch="all"
license="Apache-2.0"
_phpver3=83
_phpver4=84
_phpver5=85
_clang_ver=23
makedepends="
	brotli-dev
	clang$_clang_ver
	linux-headers
	njs-dev
	openssl-dev>3
	perl-dev
	php$_phpver3-dev
	php$_phpver3-embed
	php$_phpver4-dev
	php$_phpver4-embed
	php$_phpver5-dev
	php$_phpver5-embed
	python3-dev
	ruby-dev
	zlib-dev
	zstd-dev
	rust cargo
	"
checkdepends="procps-ng
	binutils
	py3-pytest py3-openssl py3-brotli py3-zstandard
	php$_phpver3-opcache php$_phpver4-opcache
	"
options="net" # ruby tests require rack
pkgusers="unit"
pkggroups="unit"
install="$pkgname.pre-install"
subpackages="$pkgname-dev $pkgname-openrc $pkgname-tools::noarch $pkgname-doc"
# Patch-Sources (commits merged into freeunitorg/freeunit):
#   njs-null-vm.patch       37b5d4f27  njs: do not destroy a VM that was never compiled
#   portable-tests.patch    f224f1d8  tests: make the WebSocket, shm and Brotli tests portable
#   asgi-close-frame.patch  0032d431  python: keep a queued WebSocket close frame after an exception
#   queue-watchdog.patch    5315333a  Tests: allow 30 seconds for the application queue tests
