build() {
	local _otel=--otel
	case "$CARCH" in
		arm*|ppc64le|x86) _otel='' ;;
	esac

	# --hardening=default adds little on Alpine: clang already sets
	# -fstack-protector-strong, _FORTIFY_SOURCE=2, PIE, relro and now.
	# It adds -fcf-protection on x86_64 (inert: musl's crt objects have
	# no CET note, so the linker drops it) and -mbranch-protection on
	# aarch64 (not built there yet).  Its FORTIFY=3 probe fails on
	# clang's built-in level 2 and falls back to 2; no flag conflicts.
	./configure \
		--prefix="/usr" \
		--localstatedir="/var" \
		--runstatedir="/run" \
		--statedir="/var/lib/unit" \
		--control="unix:/run/control.unit.sock" \
		--pid="/run/unit.pid" \
		--log="/var/log/unit.log" \
		--tmpdir=/tmp \
		--modulesdir="$_modules_dir" \
		--openssl \
		--user=unit \
		--group=unit \
		--cc-opt="$(pkgconf --cflags njs)" \
		--njs \
		--brotli --zlib --zstd \
		--cc=clang-$_clang_ver \
		$_otel \
		--hardening=default \
		--tests
	./configure perl
	./configure php --module=php$_phpver3 --config=php-config$_phpver3
	./configure php --module=php$_phpver4 --config=php-config$_phpver4 --lib-path=/usr/lib/php$_phpver4
	./configure php --module=php$_phpver5 --config=php-config$_phpver5 --lib-path=/usr/lib/php$_phpver5
	./configure python --config=python3-config
	./configure ruby

	make
	# "make tests" does not build the plain libunit.a; the hook gate
	# checks it, and package() installs it
	make build/lib/libunit.a
	make tests
}

check() {
	# fails if an NXT_TESTS hook reached unitd, a library or a module
	sh .github/scripts/check-test-hooks.sh
	./build/tests

	local _ruby="$srcdir/ruby-rack"
	gem install rack -i $_ruby --no-document

	# FIXME: some tests fail in CI or locally in checkroot too
	local _fds=160 # fds leaking in tests
	local _allow_fail=no
	# -vv keeps the full skip reason, and COLUMNS must be wider than the
	# longest test id: when the SKIPPED line already starts past the
	# terminal width (80 on a pipe), pytest's wrap_write() cuts into the
	# reason.  See the SKIPPEDam)) lines from the aarch64 CI log.
	# A teardown that finds leftover unit processes fails once, after
	# UNIT_TEST_PROCESS_TIMEOUT seconds, and the next test gets a new unitd;
	# UNIT_TEST_START_TIMEOUT bounds the wait for unitd to start.
	export UNIT_TEST_PROCESS_TIMEOUT=60 UNIT_TEST_START_TIMEOUT=20
	COLUMNS=200 GEM_PATH=$_ruby pytest test --fds-threshold=$_fds -vv -k "
		not java and not go and not node \
		and not njs \
		and not test_static_mount \
		and not test_php_isolation \
		and not test_php_application_forbidden \
		and not test_php_application_disable_classes \
		and not test_php_application_disable_classes_user \
		and not test_php_application_shared_opcache \
		and not test_python_isolation \
		and not test_python_user_group \
		and not test_ruby_isolation \
		and not test_settings_send_timeout \
	" || [ "$_allow_fail" = yes ]
}

package() {
	make unitd-install manpage-install libunit-install DESTDIR="$pkgdir"

	install -D -m 755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -D -m 644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
	install -D -m 644 "$srcdir"/$pkgname.logrotate "$pkgdir"/etc/logrotate.d/$pkgname

	install -D -m 755 tools/setup-unit "$pkgdir"/usr/bin/setup-unit
	install -D -m 755 tools/unitc "$pkgdir"/usr/bin/unitc
	install -D -m 644 tools/README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

tools() {
	pkgdesc="Configuration scripts for FreeUnit"
	depends="bash curl"
	provides="unit-tools=$pkgver-r$pkgrel"

	amove usr/bin/setup-unit
	amove usr/bin/unitc
	amove usr/share/doc/$pkgname/README.md
}

openrc() {
	default_openrc
	depends="curl"
	provides="unit-openrc=$pkgver-r$pkgrel"
}

dev() {
	default_dev
	provides="unit-dev=$pkgver-r$pkgrel"
}

doc() {
	default_doc
	provides="unit-doc=$pkgver-r$pkgrel"
}

_module() {
	local modname=${subpkgname#"$pkgname"-}
	pkgdesc="$modname module for FreeUnit"
	depends="$pkgname=$pkgver-r$pkgrel"
	provides="unit-$modname=$pkgver-r$pkgrel"

	cd "$builddir"
	make $modname-install DESTDIR="$subpkgdir"
}

