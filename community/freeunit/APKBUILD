pkgname=freeunit
pkgver=1.37.2
pkgrel=0
pkgdesc="FreeUnit is a dynamic web application server"
url="https://freeunit.org/"
arch="all"
license="Apache-2.0"
_phpver3=83
_phpver4=84
_phpver5=85
_clang_ver=23
makedepends="
	brotli-dev
	clang$_clang_ver
	linux-headers
	njs-dev
	openssl-dev>3
	perl-dev
	php$_phpver3-dev
	php$_phpver3-embed
	php$_phpver4-dev
	php$_phpver4-embed
	php$_phpver5-dev
	php$_phpver5-embed
	python3-dev
	ruby-dev
	zlib-dev
	zstd-dev
	rust cargo
	"
checkdepends="procps-ng
	binutils
	py3-pytest py3-openssl py3-brotli py3-zstandard
	php$_phpver3-opcache php$_phpver4-opcache
	"
options="net" # ruby tests require rack
pkgusers="unit"
pkggroups="unit"
install="$pkgname.pre-install"
subpackages="$pkgname-dev $pkgname-openrc $pkgname-tools::noarch $pkgname-doc"
# Local patches, no upstream commit yet:
#   phpver.patch
source="$pkgname-$pkgver.tar.gz::https://github.com/freeunitorg/freeunit/archive/refs/tags/$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	$pkgname.logrotate
	phpver.patch
	"
provides="unit=$pkgver-r$pkgrel"

for _mod in perl php$_phpver3 php$_phpver4 php$_phpver5 python3 ruby; do
	subpackages="$subpackages $pkgname-$_mod:_module"
done

_modules_dir="/usr/lib/unit/modules"

# secfixes:
