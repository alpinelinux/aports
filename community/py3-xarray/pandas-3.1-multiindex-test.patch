pandas 3.1 raises a KeyError instead of an IndexError

Backport of the test part of https://github.com/pydata/xarray/pull/11655

diff --git a/xarray/tests/test_indexes.py b/xarray/tests/test_indexes.py
--- a/xarray/tests/test_indexes.py
+++ b/xarray/tests/test_indexes.py
@@ -522,7 +522,8 @@ def test_sel(self) -> None:
             match=r"multi-index level names \('three',\) not found in indexes",
         ):
             index.sel({"x": {"three": 0}})
-        with pytest.raises(IndexError):
+        # pandas < 3.1 raises an IndexError, later versions a KeyError
+        with pytest.raises((IndexError, KeyError)):
             index.sel({"x": (slice(None), 1, "no_level")})
 
     def test_join(self):
