xarray 2026.9.0 configures setuptools-scm 10 through [tool.vcs-versioning].
setuptools-scm 9 only reads [tool.setuptools_scm], and without it the
package version ends up as 0.0.0.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -111,7 +111,7 @@
 [tool.setuptools.packages.find]
 include = ["xarray*"]
 
-[tool.vcs-versioning]
+[tool.setuptools_scm]
 fallback_version = "9999"
 
 [tool.coverage.run]
