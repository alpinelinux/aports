# Maintainer: Alexey Minnekhanov <alexeymin@minlexx.ru>
pkgname=fbkeyboard
pkgver=0.6
pkgrel=0
pkgdesc="Framebuffer softkeyboard for use on devices with touchscreen input like smartphones"
url="https://github.com/minlexx/fbkeyboard"
arch="all"
license="GPL-3.0-or-later"
depends="font-dejavu"
makedepends="linux-headers freetype-dev"
source="fbkeyboard-$pkgver.tar.gz::https://github.com/minlexx/fbkeyboard/archive/refs/tags/v$pkgver.tar.gz"
options="!check" # No tests
subpackages="$pkgname-doc"

build() {
	make
}

package() {
	install -Dm755 fbkeyboard "$pkgdir"/usr/bin/fbkeyboard
	install -Dm644 fbkeyboard.1 -t "$pkgdir"/usr/share/man/man1/
}

sha512sums="
