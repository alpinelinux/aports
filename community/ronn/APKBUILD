2b1f0198a1179c1c8217f24c3401b1cf2e413abfd28fbd57406bb021757aa48f7fc8c735ef43c8c5cc68cbbd7b5aeb6678c035f294d25f3c0f255e71f5278e79  mustache-template-path.patch
"
