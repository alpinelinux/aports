ba2594acb2386396eb6ce2f3bdff0bc073f8d1387bdea32cc0c210c8c0094c9e1812953a257d4af63694b147c6b8266e6c965f34b12e494f2019d4c1d6f349bb  copypasta-ext-v0.4.4.tar.gz
ea1070281b7ec1723880de75e12d36bc7057e0d59125f56a3d133248dc5265345807e41bb63426fbd919e50e08ff2ab1c00494aec612272e5847beb82db6b301  patch-copypasta-ext.patch
"
