# Contributor: omni <omni+alpine@hack.org>
# Maintainer: omni <omni+alpine@hack.org>
pkgname=kmon
pkgver=1.7.1
pkgrel=1
_cpever=0.4.4
pkgdesc="Linux Kernel Manager and Activity Monitor"
arch="all"
url="https://kmon.cli.rs/"
license="GPL-3.0-or-later"
depends="kmod dmesg" # kmon is not compatible with busybox dmesg
makedepends="cargo python3 libxcb-dev cargo-auditable"
subpackages="$pkgname-doc
	$pkgname-bash-completion $pkgname-fish-completion $pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/orhun/kmon/archive/refs/tags/v$pkgver.tar.gz
	https://gitlab.com/timvisee/copypasta-ext/-/archive/v$_cpever/copypasta-ext-v$_cpever.tar.gz
	patch-copypasta-ext.patch
	"
options="net"

prepare() {
	mv "$srcdir"/copypasta-ext-v"$_cpever" vendored-copypasta-ext
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm0755 target/release/kmon -t "$pkgdir"/usr/bin
	install -Dm0644 target/release/man/kmon.8 "$pkgdir"/usr/share/man/man8/kmon.8
	install -Dm0644 target/release/completions/kmon.bash \
		"$pkgdir"/usr/share/bash-completion/completions/kmon
	install -Dm0644 target/release/completions/kmon.fish \
		-t "$pkgdir"/usr/share/fish/vendor_completions.d
	install -Dm0644 target/release/completions/_kmon \
		-t "$pkgdir"/usr/share/zsh/site-functions
}

sha512sums="
