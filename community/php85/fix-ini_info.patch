From 6521c11d99155ce05d801eed96e6655888f9c26a Mon Sep 17 00:00:00 2001
From: Remi Collet <remi@remirepo.net>
Date: Fri, 6 Nov 2026 12:01:44 +0100
Subject: [PATCH] fix test when tmp-php.ini is used

---
 ext/standard/tests/ini_info/php_ini_loaded_file.phpt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ext/standard/tests/ini_info/php_ini_loaded_file.phpt b/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
index 4e3085ba865..13217f028e0 100644
--- a/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
+++ b/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
@@ -7,8 +7,8 @@
     $args = getenv('TEST_PHP_EXTRA_ARGS');
     $code = '"var_dump(php_ini_loaded_file());"';
 
-    // No ini file
-    passthru("$php $args -n -r $code");
+    // No ini file ($args mays contains some)
+    passthru("$php -n -r $code");
 
     // Specified ini file
     passthru("$php $args -c $inifile -r $code");
