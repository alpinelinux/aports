f437303470fcc77d6c297b6280247c33e9ca7a27374d00ad7d51dc4b5da95829dbc80ccb9e44fc065c6497df168c9e9fe6a4fc10c2268a1bccd8c47185ccbf40  disable-functional-test-portal.patch
7e11ffb1c0a3277447483484bee274bb20e33a280848db9d1502ad6b9839f6baf428165b1084241a904e48694ab9b4dc087774e0d370370a82960d54b6082745  disable-functional-test-notifier.patch.noauto
"
