maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=vidstab
pkgver=1.1.2
pkgrel=0
arch="all"
url="http://public.hronopik.de/vid.stab/"
pkgdesc="Video stabilization library"
license="GPL-2.0-or-later"
makedepends="
	cmake
	samurai
	"
subpackages="$pkgname-dev"
source="https://github.com/georgmartius/vid.stab/archive/v$pkgver/vid.stab-v$pkgver.tar.gz"
options="!check" # No tests
builddir="$srcdir/vid.stab-$pkgver"

build() {
	[ "$CARCH" = "riscv64" ] && _sse2="-DSSE2_FOUND=false"

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		$_sse2
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
62ecd5732dda9571854472dc98b90aa97111c312c5d09204220cfc1b4e0851c540aec1d95ea7c358b9f1372d78c9e8e54755fd66b490bad2ca19dc40efd0e4be  vid.stab-v1.1.2.tar.gz
"
