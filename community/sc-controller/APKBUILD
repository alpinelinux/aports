# Contributor: Joshua Murphy <joshuamurphy@posteo.net>
maintainer="Joshua Murphy <joshuamurphy@posteo.net>"
pkgname=sc-controller
pkgver=1.0.9
pkgrel=0
pkgdesc="User-mode driver and GTK4 based GUI for the Steam Controller"
url="https://github.com/C0rn3j/sc-controller"
arch="all"
license="GPL-2.0-only"
depends="
	gtk4.0
	gtk4-layer-shell
	librsvg
	py3-cairo
	py3-evdev
	py3-gobject3
	py3-hidraw
	py3-ioctl-opt
	py3-libacl
	py3-libusb1
	py3-vdf
	"
makedepends="
	gettext-dev
	linux-headers
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	python3-dev
	zlib-dev
	"
checkdepends="py3-pytest py3-toml"
subpackages="$pkgname-lang $pkgname-pyc $pkgname-udev"
source="$pkgname-$pkgver.tar.gz::https://github.com/C0rn3j/sc-controller/archive/v$pkgver.tar.gz"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
765a4fc5133057f94e99debb08407e53bdbef31132b4af2adb1099ab54192e5a854edc3a08bb5ec4e2a905792894fdd651c97c5915680f4cb13d993565af6b42  sc-controller-1.0.9.tar.gz
"
