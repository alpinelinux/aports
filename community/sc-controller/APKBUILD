7b48f716d7acf2729148d2ee6c5ab0f90f63287e65bc68e204b89bd2c51c9a1bfd0649ec6127ab797a3833d47660c9e0bf9cc82beef6f002c37190d729c3dc67  fix-so-loading.patch
"
