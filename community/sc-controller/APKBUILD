# Contributor: Joshua Murphy <joshuamurphy@posteo.net>
maintainer="Joshua Murphy <joshuamurphy@posteo.net>"
pkgname=sc-controller
pkgver=1.0.8
pkgrel=0
pkgdesc="User-mode driver and GTK4 based GUI for the Steam Controller"
url="https://github.com/C0rn3j/sc-controller"
arch="all"
license="GPL-2.0-only"
depends="
	gtk4.0
	gtk4-layer-shell
	librsvg
	py3-cairo
	py3-evdev
	py3-gobject3
	py3-hidraw
	py3-ioctl-opt
	py3-libacl
	py3-libusb1
	py3-vdf
	"
makedepends="
	gettext-dev
	linux-headers
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	python3-dev
	zlib-dev
	"
checkdepends="py3-pytest py3-toml"
subpackages="$pkgname-lang $pkgname-pyc $pkgname-udev"
source="$pkgname-$pkgver.tar.gz::https://github.com/C0rn3j/sc-controller/archive/v$pkgver.tar.gz"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
1f5b79e1f7c9ab1c95756a5dfd0a59ab1d7e2fb96c0b62b035561251ff4dae81f11a9c77f1ed7075075684d78831956f1902cab2ab7b0ad9cd93ee57fd15310e  sc-controller-1.0.8.tar.gz
"
