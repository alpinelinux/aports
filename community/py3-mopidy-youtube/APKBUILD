4eabe5318508459e901d2582fa95f12015a0519d0cd12b94e52fdde51273da30ed393862428e857f0150b3a1f49ee3fa6f47a38423cb47ee98db8e84021f232e  setuptools.patch
378b6e1a8eaa0c0eae79930b0c3ad63f36d1a15763338014907c8ec46f501edd5e6456faa92a1711af6607b6d6e4cc5383fed6f95d546455773e9cd059c9aaec  fix-tests.patch
"
