# Contributor: Jake Buchholz Göktürk <tomalok@gmail.com>
# Maintainer: Jake Buchholz Göktürk <tomalok@gmail.com>
pkgname=docker-cli-buildx
pkgver=0.38.2
pkgrel=1
_commit=3c4cbd35852fc1a476923627a780a7836c28b654
pkgdesc="A Docker CLI plugin for extended build capabilities"
url="https://docs.docker.com/engine/reference/commandline/buildx_build"
arch="all"
license="Apache-2.0"
makedepends="go"
checkdepends="git"
options="net"
source="buildx-$pkgver.tar.gz::https://github.com/docker/buildx/archive/v$pkgver.tar.gz"

# secfixes:
#   0.38.1-r0:
#     - CVE-2026-111943

_buildx_installdir="/usr/libexec/docker/cli-plugins"

builddir="$srcdir"/buildx-"$pkgver"

build() {
	PKG=github.com/docker/buildx
	local ldflags="-X $PKG/version.Version=v$pkgver -X $PKG/version.Revision=$_commit -X $PKG/version.Package=$PKG"
	go build -v -modcacherw -ldflags "$ldflags" -o docker-buildx ./cmd/buildx
}

check() {
	# git_test.go:TestGetGitAttributesBadGitRepo fails outside of rootbld unless these are unset
	unset GOCACHE GOTMPDIR GOMODCACHE
	# integration tests need a git repository
	git init -q .
	# gitutil tests do not succeed inside abuild environment
	local pkgs="$(go list -modcacherw ./... | grep -Ev 'gitutil')"
	# Invalid UTF-8 hostname is rejected with Go 1.27.
	go test -modcacherw -short \
		-skip '^TestNormalizeHTTPHost$/^https_\x{FFFD}\.EXAMPLE\.COM$' \
		$pkgs
	./docker-buildx version
}

package() {
	install -Dm755 docker-buildx "$pkgdir$_buildx_installdir"/docker-buildx
}

sha512sums="
b8b69755b0ed106a4285e8440ea2b44d9a6cb22157be38bd2dd0f686d3ea5c3fa10b629cf439d8b633eadd8f0c5a5a2d71df9deb40b6f295fce3e2e8e122d00d  buildx-0.38.2.tar.gz
"
