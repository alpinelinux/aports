maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=highway
pkgver=1.4.0
pkgrel=1
pkgdesc="Performance-portable, length-agnostic SIMD with runtime dispatch"
url="https://github.com/google/highway"
arch="all"
license="Apache-2.0"
makedepends="cmake gtest-dev linux-headers samurai clang"
subpackages="
	$pkgname-dev
	libhwy
	libhwy_contrib
	libhwy_test
	"
source="https://github.com/google/highway/archive/$pkgver/highway-$pkgver.tar.gz"

case "$CARCH" in
	# ppc64le: detects PPC9 as baseline on the builder cpu, even though actually PPC8
	# aarch64|loongarch64: ICE
	ppc64le|aarch64|loongarch64) options="!check" ;;
esac

build() {
	export CFLAGS="$CFLAGS -flto=auto"
	export CXXFLAGS="$CXXFLAGS -flto=auto"

	case "$CARCH" in
	# TODO remove clang when using gcc 16
	arm*) export CC=clang CXX=clang++ ;;
	esac

	CFLAGS="$CFLAGS -O2 -DNDEBUG -DHWY_BROKEN_EMU128=0" \
	CXXFLAGS="$CXXFLAGS -O2 -DNDEBUG -DHWY_BROKEN_EMU128=0" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_TESTING="$(want_check && echo ON || echo OFF)" \
		-DHWY_SYSTEM_GTEST=ON \
		-DHWY_CMAKE_RVV=OFF \
		-DHWY_ENABLE_EXAMPLES=OFF
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

libhwy() {
	amove usr/lib/libhwy.so.*
}

libhwy_contrib() {
	amove usr/lib/libhwy_contrib.so.*
}

libhwy_test() {
	amove usr/lib/libhwy_test.so.*
}

sha512sums="
819422857d6a74e3a936c402698e078db5b7b88fb43767e62429ec7bd954fe93b017e75029a4df4a1a97ef3a2486107eef5247da751eb487640dea409f3f2fa2  highway-1.4.0.tar.gz
"
