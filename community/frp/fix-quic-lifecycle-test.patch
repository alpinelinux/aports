Wait for the QUIC UDP port to be released in the lifecycle test.

quic-go closes the UDP socket of a quic.ListenAddr listener from a
background goroutine after Listener.Close returns, so binding the port
immediately after NewService fails is racy.

--- a/server/service_lifecycle_test.go
+++ b/server/service_lifecycle_test.go
@@ -12,6 +12,7 @@
 	"sync"
 	"sync/atomic"
 	"testing"
+	"time"
 
 	"github.com/stretchr/testify/require"
 
@@ -244,10 +245,16 @@
 				require.ErrorContains(t, err, "failed to find any PEM data in certificate input")
 			}
 			assertLifecyclePorts(t, tcpAddresses, true)
+			// quic-go closes its UDP socket asynchronously after Listener.Close.
 			for _, address := range udpAddresses {
-				conn, err := net.ListenPacket("udp", address)
-				require.NoError(t, err, "UDP listener %s was not released", address)
-				require.NoError(t, conn.Close())
+				require.Eventually(t, func() bool {
+					conn, err := net.ListenPacket("udp", address)
+					if err != nil {
+						return false
+					}
+					_ = conn.Close()
+					return true
+				}, 2*time.Second, 10*time.Millisecond, "UDP listener %s was not released", address)
 			}
 		})
 	}
