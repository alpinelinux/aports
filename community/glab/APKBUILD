027b0a66b684ea308b5720a44b2b39b6a1f0df507d23bda246bfeadf498a683d301508d1e870e27b23a24dd53f42088532aeaabac01f391785339068b1c8074b  no-telemetry.patch
940723518ea3bd5fd9ca2ccae1c6108dc1113b7460ccf22c12493d2d4921b981d0fc2934bf22f69cbe8e732d67cd687ac11819299bb9439787dc042f35fc4361  x-sys-ppc64le-pie-fix.patch
"
