# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: team/cosmic <clayton@craftyguy.net>
pkgname=cosmic-viewer
pkgver=1.11.0
_upstreamver="${pkgver/_beta/-beta.}"
_upstreamver="${_upstreamver/_p/.}"
pkgrel=0
pkgdesc="Image viewer for the COSMIC Desktop Environment"
url="https://github.com/pop-os/cosmic-viewer"
# armv7, armhf, x86: DO NOT RE-ENABLE! 32-bit is problematic, often requires carrying patches to fix
# riscv64: too slow to build
# ppc64le, s390x: DO NOT RE-ENABLE: rustix fails often on this arch
arch="aarch64 loongarch64 x86_64"
license="GPL-3.0-only"
depends="
	cosmic-icons
"
makedepends="
	cargo-auditable
	cmake
	glib-dev
	just
	libjpeg-turbo-dev
	libxkbcommon-dev
	nasm
	ninja
"
options="net !check"  # fetch dependencies, no tests
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pop-os/cosmic-viewer/archive/refs/tags/epoch-$_upstreamver.tar.gz
"
builddir="$srcdir/$pkgname-epoch-$_upstreamver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	export TURBOJPEG_DYNAMIC=1
	export TURBOJPEG_SOURCE=pkgconf
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
95c604dbc07f4103cfdd17f2556d428f0f659a3e99a5bba05a15bd8c93055907a6fd468eef94d792bc92be3c0b57dec52f8b6c4529393ac45053dac0d8d1137b  cosmic-viewer-1.11.0.tar.gz
"
