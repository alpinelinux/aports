pkgname=py3-python-ipware
_pyname="python-ipware"
pkgver=4.1.1
pkgrel=0
arch="noarch"
pkgdesc="A python package for server applications to retrieve client's IP address"
url="https://pypi.python.org/project/python-ipware"
license="MIT"
makedepends="
	py3-setuptools
	py3-gpep517
	py3-wheel
	py3-hatchling
	"
checkdepends="py3-pytest"
source="$pkgname-$pkgver.tar.gz::https://github.com/un33k/python-ipware/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir"/$_pyname-$pkgver
subpackages="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m unittest discover
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
f8a01a52abdb26ce8ff8ff5ea7f41f7e22791d34b825c12e9be6f37106f074e5a74b923b2b72528379d4da1c177061e1277a5bd247a97a3fe11c36ea43908988  py3-python-ipware-4.1.1.tar.gz
"
