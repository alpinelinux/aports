pkgname=firefox
pkgver=161.0
_releasedate=2026-11-24
pkgrel=0
pkgdesc="Firefox web browser"
url="https://www.firefox.com/"
# s390x blocked by lld
# armhf: https://bugzilla.mozilla.org/show_bug.cgi?id=1680495
# riscv64: slop machine does not build
# armv7: consistently OOMs on the Rust style library
arch="all !s390x !armhf !riscv64 !armv7"
license="GPL-3.0-only AND LGPL-2.1-only AND LGPL-3.0-only AND MPL-2.0"
depends="
