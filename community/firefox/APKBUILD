pkgname=firefox
pkgver=160.0
_releasedate=2026-11-10
pkgrel=0
pkgdesc="Firefox web browser"
url="https://www.firefox.com/"
# s390x blocked by lld
# armhf: https://bugzilla.mozilla.org/show_bug.cgi?id=1680495
# riscv64: Identified 2 networking function(s) being imported in the rust static library (recv,send)
arch="all !s390x !armhf !riscv64"
license="GPL-3.0-only AND LGPL-2.1-only AND LGPL-3.0-only AND MPL-2.0"
depends="
	ffmpeg-libavcodec
	so:libEGL.so.1
	so:libGL.so.1
	pciutils-libs
	"
_llvmver=22
makedepends="
	alsa-lib-dev
