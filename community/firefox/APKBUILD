	python3
	scudo-malloc
	sed
	wasi-compiler-rt~$_llvmver
	wasi-sdk
	wireless-tools-dev
	xvfb-run
	zip
	"
subpackages="$pkgname-intl::noarch"
case "$CARCH" in
riscv64|x86|arm*) ;;
*) subpackages="$subpackages $pkgname-dbg" ;;
esac
source="$pkgname-$pkgver.tar.xz::https://ftp.mozilla.org/pub/firefox/releases/$pkgver/source/firefox-$pkgver.source.tar.xz
	abseil-cpp.patch
	fix-fortify-system-wrappers.patch
	fix-rust-target.patch
