	libogg-dev
	libtheora-dev
	libtool
	libvorbis-dev
	libvpx-dev
	libwebp-dev
	libxcomposite-dev
	libxt-dev
	lld$_llvmver
	llvm
	llvm$_llvmver-dev
	m4
