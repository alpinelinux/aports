set rust crate lto to thin to not use fatlto for gkrust which fails sometimes
disable lto for riscv64
--- a/python/mozbuild/mozbuild/rust_commands.py
+++ b/python/mozbuild/mozbuild/rust_commands.py
@@ -402,7 +402,10 @@ def applies_library_lto(kind, lto, substs):
     Release builds enable link time optimization unless the library opted out.
     """
     return bool(
-        kind == "library" and _cargo_config(substs).get("RUST_LTO_ELIGIBLE") and lto
+        kind == "library"
+        and _cargo_config(substs).get("RUST_LTO_ELIGIBLE")
+        and lto
+        and "riscv64" not in _cargo_config(substs).get("RUST_TARGET")
     )
 
 
@@ -418,7 +421,7 @@ def _rustc_flags(cmd, substs, invocation):
         flags += substs.get("MOZ_RUST_LIBRARY_RUSTCFLAGS")
 
     if applies_library_lto(cmd.kind, cmd.lto, substs):
-        flags.append("-Clto")
+        flags.append("-Clto=thin")
 
     flags += invocation.cargo_rustcflags
 
