maintainer="Michał Polański <michal@polanski.me>"
pkgname=py3-hcloud
pkgver=2.27.0
pkgrel=0
pkgdesc="Official Hetzner Cloud Python library"
url="https://github.com/hetznercloud/hcloud-python"
license="MIT"
arch="noarch"
depends="py3-dateutil py3-requests"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://github.com/hetznercloud/hcloud-python/archive/v$pkgver/py3-hcloud-$pkgver.tar.gz"
builddir="$srcdir/hcloud-python-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/hcloud-$pkgver-py3-none-any.whl
}

sha512sums="
3486927cbcaa5fa531fcbd0a09c628fbc7a0c51bbf997b082cd4f9947fec04fdb28ec44373680cd9b3b47d4a5da7dc5cf9f6a3de70fa9d11d347da731675d50c  py3-hcloud-2.27.0.tar.gz
"
