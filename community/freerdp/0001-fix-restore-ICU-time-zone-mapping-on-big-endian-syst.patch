From 93348508976c3a456601270987192ad2c06e1930 Mon Sep 17 00:00:00 2001
From: Linsen Zhou <i@lin.moe>
Date: Mon, 23 Nov 2026 22:23:10 +0800
Subject: [PATCH] fix: restore ICU time zone mapping on big-endian systems

Convert byte order only at the ICU boundary so RDP time zone keys
remain UTF-16LE. Check the serialized bytes in the regression test.

Generated with Crush

Assisted-by: Crush:gpt-6.2-sol
---
 winpr/libwinpr/timezone/TimeZoneNameMapUtils.c | 18 +++++++++++++++---
 .../timezone/test/TestTimeZoneNestedName.c     | 14 ++++++++++++++
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/winpr/libwinpr/timezone/TimeZoneNameMapUtils.c b/winpr/libwinpr/timezone/TimeZoneNameMapUtils.c
index b2a9d8042ec1..d6fffec078af 100644
--- a/winpr/libwinpr/timezone/TimeZoneNameMapUtils.c
+++ b/winpr/libwinpr/timezone/TimeZoneNameMapUtils.c
@@ -328,8 +328,15 @@ static char* get_wzid_icu(const UChar* utzid, size_t utzid_len)
 			UErrorCode error2 = U_ZERO_ERROR;
 			int32_t rc2 = ucal_getWindowsTimeZoneID(
 			    utzid, WINPR_ASSERTING_INT_CAST(int32_t, utzid_len), wzid, rc, &error2);
-			if (U_SUCCESS(error2) && (rc2 > 0))
-				res = ConvertWCharNToUtf8Alloc(wzid, (size_t)rc, nullptr);
+			if (U_SUCCESS(error2) && (rc2 > 0) && (rc2 < rc))
+			{
+#if U_IS_BIG_ENDIAN
+				const WCHAR* wzid_le = ByteSwapUnicode(wzid, (size_t)rc2);
+#else
+				const WCHAR* wzid_le = wzid;
+#endif
+				res = ConvertWCharNToUtf8Alloc(wzid_le, (size_t)rc2 + 1, nullptr);
+			}
 			free(wzid);
 		}
 	}
@@ -343,7 +350,12 @@ static char* get(const char* iana)
 	if (!utzid)
 		return nullptr;
 
-	char* wzid = get_wzid_icu(utzid, utzid_len);
+#if U_IS_BIG_ENDIAN
+	const UChar* utzid_native = ByteSwapUnicode(utzid, utzid_len);
+#else
+	const UChar* utzid_native = utzid;
+#endif
+	char* wzid = get_wzid_icu(utzid_native, utzid_len);
 	free(utzid);
 	return wzid;
 }
diff --git a/winpr/libwinpr/timezone/test/TestTimeZoneNestedName.c b/winpr/libwinpr/timezone/test/TestTimeZoneNestedName.c
index 37abb8b1f1ad..36cb910e74c0 100644
--- a/winpr/libwinpr/timezone/test/TestTimeZoneNestedName.c
+++ b/winpr/libwinpr/timezone/test/TestTimeZoneNestedName.c
@@ -28,6 +28,20 @@ static BOOL test_tz(const char* iana, const char* expected)
 		(void)fprintf(stderr, "%s: expected time zone key '%s', got '%s'\n", iana, expected, key);
 		return FALSE;
 	}
+
+	const size_t expectedLength = strlen(expected);
+	if (expectedLength >= ARRAYSIZE(tzif.TimeZoneKeyName))
+		return FALSE;
+
+	const unsigned char* bytes = (const unsigned char*)tzif.TimeZoneKeyName;
+	for (size_t index = 0; index <= expectedLength; index++)
+	{
+		if ((bytes[2 * index] != (unsigned char)expected[index]) || (bytes[2 * index + 1] != 0))
+		{
+			(void)fprintf(stderr, "%s: time zone key is not UTF-16LE\n", iana);
+			return FALSE;
+		}
+	}
 	return TRUE;
 }
 #endif
