diff --git a/cmake/FindTHREAD.cmake b/cmake/FindTHREAD.cmake
index 432c76e..58d0139 100644
--- a/cmake/FindTHREAD.cmake
+++ b/cmake/FindTHREAD.cmake
@@ -2,27 +2,41 @@
 # pthread support
 #
 
+include(CheckLibraryExists)
+
 find_path(THREAD_INCLUDE_DIR
   NAMES
     pthread.h
 )
-find_library(THREAD_LIBRARY
-  NAMES
-    pthread pthread.so.0 libpthread.so.0
-  HINTS
-    /usr/local/lib64
-    /usr/local/lib
-    /opt/local/lib64
-    /opt/local/lib
-    /usr/lib64
-    /usr/lib
-    /lib64
-    /lib
-)
+
+# pthread is part of libc on musl
+check_library_exists(c pthread_create "" THREAD_IN_LIBC)
+
+if(THREAD_IN_LIBC)
+  set(THREAD_LIBRARY "" CACHE STRING "pthread is provided by libc" FORCE)
+else()
+  find_library(THREAD_LIBRARY
+    NAMES
+      pthread pthread.so.0 libpthread.so.0
+    HINTS
+      /usr/local/lib64
+      /usr/local/lib
+      /opt/local/lib64
+      /opt/local/lib
+      /usr/lib64
+      /usr/lib
+      /lib64
+      /lib
+  )
+endif()
 
 include(FindPackageHandleStandardArgs)
-find_package_handle_standard_args(THREAD DEFAULT_MSG
-                                  THREAD_LIBRARY THREAD_INCLUDE_DIR)
+if(THREAD_IN_LIBC)
+  find_package_handle_standard_args(THREAD DEFAULT_MSG THREAD_INCLUDE_DIR)
+else()
+  find_package_handle_standard_args(THREAD DEFAULT_MSG
+                                    THREAD_LIBRARY THREAD_INCLUDE_DIR)
+endif()
 
 if(THREAD_FOUND)
   set(THREAD_LIBRARIES ${THREAD_LIBRARY})
