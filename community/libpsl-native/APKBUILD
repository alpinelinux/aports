7c9dc6f13d96f7071cbfcd77c23973a48b58dd5e89cddec6884ccbafa2cc0d14e269a9582b8554c1a5a98556b7d20cf2375d958131d94d550234a41f94c06955  enable-testing-on-arm.patch
