From: Jakub Jirutka <jakub@jirutka.cz>
Date: Wed, 12 Jul 2023 17:04:03 +0200
Date: Sun, 28 Jul 2024 01:34:54 +0200
Subject: Allow to run on readonly /usr/share

Workaround for https://github.com/keycloak/keycloak/issues/11286.

Keep the Keycloak distribution immutable under /usr/share/keycloak and store
only runtime data and the generated Quarkus server image under
/var/lib/keycloak.

The layout is:

* /usr/share/keycloak
  * immutable Keycloak distribution
  * owned by root and read-only for "keycloak"
* /etc/keycloak
  * configuration files
* /var/lib/keycloak
  * Keycloak home directory (kc.home.dir)
  * owned by "keycloak"
* /var/lib/keycloak/conf
  * symlink to /etc/keycloak
  * created by kc.sh
* /var/lib/keycloak/data
  * persistent Keycloak data
* /var/lib/keycloak/providers
  * symlink to /usr/share/keycloak/providers
  * created by kc.sh
* /var/lib/keycloak/themes
  * symlink to /usr/share/keycloak/themes
  * created by kc.sh
* /var/lib/keycloak/lib/quarkus
  * writable Quarkus server image generated by `kc build` or implicit
    reaugmentation
* /usr/share/keycloak/lib/quarkus
  * symlink to /var/lib/keycloak/lib/quarkus
* /usr/share/keycloak/lib/quarkus.dist
  * pristine copy of the Quarkus server image shipped in the distribution
  * used to initialize lib/quarkus after an upgrade or when the generated
    image is incomplete
* /var/lib/keycloak/version.txt
  * copy of /usr/share/keycloak/version.txt written after a successful
    explicit build or implicit reaugmentation
  * used to determine whether the generated server image belongs to the
    currently installed Keycloak version

Quarkus derives its application root from the location of quarkus-run.jar,
independently of kc.home.dir. Therefore kc.sh runs
/usr/share/keycloak/lib/quarkus-run.jar directly and keeps the immutable
application files under /usr/share/keycloak.

Keycloak itself uses kc.home.dir for some generated files, including
lib/quarkus/generated-bytecode.jar. Both Quarkus and Keycloak therefore need
to see the same writable lib/quarkus directory; this is achieved by symlinking
/usr/share/keycloak/lib/quarkus to /var/lib/keycloak/lib/quarkus.

The generated Quarkus image is restored from quarkus.dist after a package
upgrade or when required image files are missing. Starting with --optimized
is rejected until the image has been successfully built for the installed
Keycloak version, because --optimized skips build-time configuration checks.

This keeps all packaged application files read-only under /usr/share while
allowing Quarkus reaugmentation without copying the whole Keycloak
installation into a writable directory.

diff --git a/quarkus/dist/src/main/content/bin/kc.sh b/quarkus/dist/src/main/content/bin/kc.sh
index 65d67bd..a81c568 100644
--- a/quarkus/dist/src/main/content/bin/kc.sh
+++ b/quarkus/dist/src/main/content/bin/kc.sh
@@ -34,12 +34,17 @@ abs_path () {
   fi
 }
 
-SERVER_OPTS="-Dkc.home.dir='$(abs_path '..')'"
-SERVER_OPTS="$SERVER_OPTS -Djboss.server.config.dir='$(abs_path '../conf')'"
+# XXX: Alpine-specific variables.
+KCSH_DIST_DIR="$(realpath "$(abs_path '..')")"
+: ${KCSH_HOME_DIR:="/var/lib/keycloak"}
+: ${KCSH_CONFIG_DIR:="/etc/keycloak"}
+
+SERVER_OPTS="-Dkc.home.dir='$KCSH_HOME_DIR'"
+SERVER_OPTS="$SERVER_OPTS -Djboss.server.config.dir='$KCSH_CONFIG_DIR'"
 SERVER_OPTS="$SERVER_OPTS -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
 SERVER_OPTS="$SERVER_OPTS -Dpicocli.disable.closures=true"
 SERVER_OPTS="$SERVER_OPTS -Dquarkus-log-max-startup-records=10000"
-CLASSPATH_OPTS="'$(abs_path "../lib/quarkus-run.jar")'"
+CLASSPATH_OPTS="'$KCSH_DIST_DIR/lib/quarkus-run.jar'"
 
 DEBUG_MODE="${KC_DEBUG:-${DEBUG:-false}}"
 DEBUG_ADDRESS="${KC_DEBUG_PORT:-${DEBUG_PORT:-8787}}"
@@ -49,6 +54,9 @@ esceval() {
     printf '%s\n' "$1" | sed "s/'/'\\\\''/g; 1 s/^/'/; $ s/$/'/"
 }
 
+BUILD=false
+OPTIMIZED=false
+
 while [ "$#" -gt 0 ]
 do
     case "$1" in
@@ -67,7 +75,12 @@ do
           OPT=$(esceval "$1")
           case "$1" in
             -D*) SERVER_OPTS="$SERVER_OPTS ${OPT}";;
-            *) CONFIG_ARGS="$CONFIG_ARGS ${OPT}"
+            *)
+                case "$1" in
+                    build) BUILD=true;;
+                    --optimized) OPTIMIZED=true;;
+                esac
+                CONFIG_ARGS="$CONFIG_ARGS ${OPT}"
                ;;
           esac
           ;;
@@ -75,6 +88,65 @@ do
     shift
 done
 
+# XXX: Alpine-specific setup to allow running Keycloak with read-only /usr/share.
+#
+# The packaged /usr/share/keycloak/lib/quarkus is a symlink to this directory.
+# Quarkus therefore uses the immutable distribution in /usr/share, while its
+# generated server image is kept in the writable Keycloak home.
+#
+QUARKUS_DIR="$KCSH_HOME_DIR/lib/quarkus"
+DIST_QUARKUS_DIR="$KCSH_DIST_DIR/lib/quarkus.dist"
+
+mkdir -p "$QUARKUS_DIR" || exit $?
+
+if ! [ "$KCSH_DIST_DIR/lib/quarkus" -ef "$QUARKUS_DIR" ]; then
+    echo "ERROR: $KCSH_DIST_DIR/lib/quarkus does not point to $QUARKUS_DIR" >&2
+    exit 1
+fi
+
+for path in providers themes; do
+    if ! [ -e "$KCSH_HOME_DIR/$path" ] && ! [ -L "$KCSH_HOME_DIR/$path" ]; then
+        ln -s "$KCSH_DIST_DIR/$path" "$KCSH_HOME_DIR/$path" || exit $?
+    fi
+done
+
+if ! [ "$KCSH_CONFIG_DIR" -ef "$KCSH_HOME_DIR/conf" ]; then
+    if [ -e "$KCSH_HOME_DIR/conf" ] && ! [ -L "$KCSH_HOME_DIR/conf" ]; then
+        echo "ERROR: $KCSH_HOME_DIR/conf exists and is not a symlink to $KCSH_CONFIG_DIR" >&2
+        exit 1
+    fi
+    ln -sfn "$KCSH_CONFIG_DIR" "$KCSH_HOME_DIR/conf"
+fi
+
+# Start from the pristine server image shipped by the package after an upgrade
+# or if the generated image is incomplete.
+NEED_SEED=false
+if ! cmp -s "$KCSH_HOME_DIR/version.txt" "$KCSH_DIST_DIR/version.txt" \
+    || ! [ -f "$QUARKUS_DIR/build-system.properties" ] \
+    || ! [ -f "$QUARKUS_DIR/quarkus-application.dat" ] \
+    || ! [ -f "$QUARKUS_DIR/generated-bytecode.jar" ]
+then
+    NEED_SEED=true
+fi
+
+# --optimized skips the rebuild check, so don't allow it with an image that
+# has not been successfully built for the installed Keycloak version.
+if [ "$OPTIMIZED" = true ] && [ "$BUILD" != true ] && [ "$NEED_SEED" = true ]; then
+    echo "ERROR: The Keycloak server image is missing or outdated." >&2
+    echo "Run 'kc build' before starting with --optimized." >&2
+    exit 1
+fi
+
+if [ "$NEED_SEED" = true ]; then
+    if ! [ -d "$DIST_QUARKUS_DIR" ]; then
+        echo "ERROR: $DIST_QUARKUS_DIR does not exist" >&2
+        exit 1
+    fi
+    rm -rf "${QUARKUS_DIR:?}" || exit $?
+    cp -R "$DIST_QUARKUS_DIR" "$QUARKUS_DIR" || exit $?
+fi
+# End of Alpine-specific setup.
+
 if [ -z "$JAVA" ]; then
     if [ -n "$JAVA_HOME" ]; then
         JAVA="$JAVA_HOME/bin/java"
@@ -170,6 +242,13 @@ eval "{ '$JAVA' $JAVA_RUN_OPTS <&3 3<&- & } 3<&0"
 PID=$!; wait $PID; status=$?
 # remove the trap as signals can be directly handled
 trap - TERM INT
+
+# XXX: Alpine-specific - mark the generated server image as current after a
+#  successful explicit build or implicit reaugmentation (exit status 10).
+if { [ "$BUILD" = true ] && [ "$status" -eq 0 ]; } || [ "$status" -eq 10 ]; then
+    cp "$KCSH_DIST_DIR/version.txt" "$KCSH_HOME_DIR/version.txt" || exit $?
+fi
+
 # only exit code 10 means that implicit reaugmentation occurred and a relaunch is needed 
 if [ $status = 10 ]; then
   JAVA_RUN_OPTS="-Dkc.config.built=true $JAVA_RUN_OPTS"
