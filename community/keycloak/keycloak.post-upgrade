#!/bin/sh

ver_old="$2"

datadir="/var/lib/keycloak"
distdir="/usr/share/keycloak"

if [ "$(apk version -t "$ver_old" '24.0.5-r1')" = '<' ]; then
	if [ -f "$datadir"/build/quarkus/build-system.properties ]; then
		echo "Removing obsolete directory $datadir/build" >&2
		rm -rf "$datadir"/build
	fi
fi

if [ "$(apk version -t "$ver_old" '26.7.3-r0')" = '<' ]; then
	for path in lib/app lib/lib lib/quarkus-run.jar; do
		if [ -L "$datadir/$path" ] && [ "$datadir/$path" -ef "$distdir/$path" ]; then
			echo "Removing obsolete symlink $datadir/$path" >&2
			rm "$datadir/$path"
		fi
	done
fi
