maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=virt-lightning
pkgver=2.5.0
pkgrel=0
pkgdesc="A tool to start libvirt VMs in a couple of seconds"
url="https://github.com/virt-lightning/virt-lightning"
arch="noarch"
license="Apache-2.0"
depends="python3 py3-libvirt py3-yaml"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/virt-lightning/virt-lightning/archive/refs/tags/$pkgver.tar.gz"

build() {
	SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver \
		gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/virt_lightning*.whl
}

sha512sums="
e17841380736858452abd5643f3ba41be332c40a73b59e7a7a1d2d4de3cd6eb19e8dfdb9aefecf946c0cc6624edb4cb0fbb9ae013518c73a49e17202c9e5276b  virt-lightning-2.5.0.tar.gz
"
