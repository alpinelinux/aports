# Contributor: Keith Maxwell <keith.maxwell@gmail.com>
# Maintainer: Keith Maxwell <keith.maxwell@gmail.com>
pkgname=py3-entrypoints
pkgver=0.4.1
pkgrel=0
pkgdesc="Discover and load entry points from installed packages."
url="https://github.com/takluyver/entrypoints"
arch="noarch"
license="MIT"
depends="python3"
makedepends="py3-gpep517 py3-installer py3-wheel py3-flit-core"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
# 0.4.1: PyPI archive does not contain tests
# source="https://files.pythonhosted.org/packages/source/e/entrypoints/entrypoints-$pkgver.tar.gz"
source="https://github.com/takluyver/entrypoints/archive/$pkgver/entrypoints-$pkgver.tar.gz"
builddir="$srcdir/entrypoints-$pkgver"

replaces="py-entrypoints" # Backwards compatibility
provides="py-entrypoints=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/entrypoints-$pkgver-*.whl
}

sha512sums="
5513bf57e5270afe576a7f8e6bab04c6516a61ad54dfcfe778bd1e3d08d4fe09b889fc6caf665edd6437284361e534e4da20d78fa24460a32aa17b83ba9985b0  entrypoints-0.4.1.tar.gz
"
