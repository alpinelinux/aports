 lib/cpp/Makefile.am                          |  1 +
 lib/cpp/libthrift.vcxproj                    |  1 +
 lib/cpp/libthrift.vcxproj.filters            |  1 +
 lib/cpp/src/thrift/TConfiguration.cpp        | 33 ++++++++++++++++++++
 lib/cpp/test/TTransportFactoryConfigTest.cpp | 14 +++++++++
 6 files changed, 51 insertions(+)
 create mode 100644 lib/cpp/src/thrift/TConfiguration.cpp

