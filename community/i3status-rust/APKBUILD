# Contributor: Galen Abell <galen@galenabell.com>
# Contributor: Maxim Karasev <begs@disroot.org>
# Maintainer: Adam Thiede <me@adamthiede.com>
pkgname=i3status-rust
pkgver=0.40.1
pkgrel=0
pkgdesc="i3status replacement in Rust"
url="https://github.com/greshake/i3status-rust"
arch="all"
license="GPL-3.0-only"
makedepends="
	cargo
	cargo-auditable
	clang-libclang
	lm-sensors-dev
	notmuch-dev
	openssl-dev>3
	pango-dev
	pipewire-dev
	pulseaudio-dev
"
checkdepends="
	fontconfig
	font-dejavu
"
options="net"
provides="i3status-rs=$pkgver-r$pkgrel"
subpackages="$pkgname-doc"

# cargo-update.patch updates nix and rustix to fix compile on s390x, ppc64le, and loongarch64
source="
	https://github.com/greshake/i3status-rust/archive/refs/tags/v$pkgver/i3status-rust-v$pkgver.tar.gz
	i3status-rs-$pkgver.1::https://github.com/greshake/i3status-rust/releases/download/v$pkgver/i3status-rs.1
	cargo-update.patch
"

_common_features="pulseaudio,pipewire,notmuch,maildir,icu_calendar"
_cargo_opts="--no-default-features --features $_common_features"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen $_cargo_opts
}

check() {
	cargo test $_cargo_opts
}

package() {
	install -Dm755 target/release/i3status-rs -t "$pkgdir"/usr/bin/

	install -Dm755 examples/config.toml \
		"$pkgdir"/usr/share/i3status-rust/example-config.toml

	install -Dm644 "$srcdir"/i3status-rs-$pkgver.1 \
		"$pkgdir"/usr/share/man/man1/i3status-rs.1

	install -Dm644 files/themes/* -t "$pkgdir"/usr/share/i3status-rust/themes/
	install -Dm644 files/icons/* -t "$pkgdir"/usr/share/i3status-rust/icons/
}

sha512sums="
