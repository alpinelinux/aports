# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Maintainer: Robert Mongold <rtmongold@gmail.com>
pkgname=bear
pkgver=4.2.4
pkgrel=0
pkgdesc="Tool that generates a compilation database for clang tooling"
url="https://github.com/rizsotto/Bear"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	cargo
	cargo-auditable
	lld
	"
subpackages="$pkgname-doc"
source="https://github.com/rizsotto/Bear/archive/$pkgver/bear-$pkgver.tar.gz
	"
builddir="$srcdir/Bear-$pkgver"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo build --frozen

	# signal teardown budgets (<2s) are flaky under abuild / on slow arches
	cargo test --frozen -p integration-tests --test integration -- \
		--skip cases::exit_codes::signal_tears_down_build_process_tree \
		--skip cases::exit_codes::signal_lets_a_trapping_build_run_its_trap \
		--skip cases::exit_codes::forwards_the_exact_signal_received \
		--skip cases::exit_codes::signal_escalates_when_build_ignores_it \
		--skip cases::exit_codes::signal_tears_down_nested_wrapper_supervision
}

package() {
	DESTDIR="$pkgdir" PREFIX=/usr SRCDIR="$builddir/target/release" \
		"$builddir/scripts/install.sh"
	rm "$pkgdir/usr/share/doc/bear/COPYING"

	install -Dm644 "$builddir/COPYING" -t "$pkgdir/usr/share/licenses/$pkgname/"
}

sha512sums="
aa87195b33fefdf5d885bfad2207d4a2150e69fd0e81b650fdd9cddb9c9f2bbc9bef838ff03de1d7a5f0630eec9b013115bc638dfaba80ff1b7661ae0a4a9998  bear-4.2.4.tar.gz
"
