412470bb2676e2675e56066384b0501300321c0a524cd10548ef21b5229df7205eee12a5e9d0b5567c20926652a79f5963ac2e65137747b89f2b92fa73133ad5  strip-regex-features.patch
eccf06782dee2498e442337b917084486bf3e3eb2a78d76b47f06516c1d3b8f1a6212a0f0a021a547ad821c3f5c73349b5394836447ff2be424f1ba16e902d69  Cargo.lock
"
