# Contributor: Sean McAvoy <seanmcavoy@gmail.com>
# Maintainer: Sean McAvoy <seanmcavoy@gmail.com>
pkgname=partclone
pkgver=0.3.49
pkgrel=0
pkgdesc="utilities to save and restore used blocks on a partition"
url="https://partclone.org"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	automake
	bash
	btrfs-progs-dev
	diffutils
	docbook-xml
	docbook-xsl
	e2fsprogs-dev
	f2fs-tools-dev
	gettext-dev
	hfsprogs
	intltool
	libtool
	libxslt
	libxslt-dev
	ncurses-dev
	ntfs-3g-dev
	openssl-dev
	userspace-rcu-dev
	xxhash-dev
	xmlto
	zstd-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-lang
	$pkgname-bash-completion
	"
source="https://github.com/Thomas-Tsai/partclone/archive/$pkgver/partclone-$pkgver.tar.gz
	"

prepare() {
	default_prepare
	autoreconf -fvi
}

build() {
	# xfs seems broken right now :(
	LIBS="-lintl" ./configure \
		--prefix=/usr \
		--disable-rpath \
		--enable-ncursesw \
		--enable-fat \
		--enable-extfs \
		--enable-exfat \
		--enable-ntfs \
		--enable-btrfs \
		--enable-minix \
		--enable-f2fs \
		--enable-hfsp \
		--enable-xfs \
		bashcompletiondir=/usr/share/bash-completion/completions
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
1653b585f0f90cf9633c582c3ae518ea179d9d926b138f43c3f519b91e0933be6f1a218881080d8ba6669ef644f07ed5dad20eb21eaa142af53b2cb01c394056  partclone-0.3.49.tar.gz
"
