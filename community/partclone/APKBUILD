# Contributor: Sean McAvoy <seanmcavoy@gmail.com>
# Maintainer: Sean McAvoy <seanmcavoy@gmail.com>
pkgname=partclone
pkgver=0.3.52
pkgrel=0
pkgdesc="utilities to save and restore used blocks on a partition"
url="https://partclone.org"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	automake
	bash
	btrfs-progs-dev
	diffutils
	docbook-xml
	docbook-xsl
	e2fsprogs-dev
	f2fs-tools-dev
	gettext-dev
	hfsprogs
	intltool
	libtool
	libxslt
	libxslt-dev
	ncurses-dev
	ntfs-3g-dev
	openssl-dev
	userspace-rcu-dev
	xxhash-dev
	xmlto
	zstd-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-lang
	$pkgname-bash-completion
	"
source="https://github.com/Thomas-Tsai/partclone/archive/$pkgver/partclone-$pkgver.tar.gz
	"

prepare() {
	default_prepare
	autoreconf -fvi
}

build() {
	# xfs seems broken right now :(
	LIBS="-lintl" ./configure \
		--prefix=/usr \
		--disable-rpath \
		--enable-ncursesw \
		--enable-fat \
		--enable-extfs \
		--enable-exfat \
		--enable-ntfs \
		--enable-btrfs \
		--enable-minix \
		--enable-f2fs \
		--enable-hfsp \
		--enable-xfs \
		bashcompletiondir=/usr/share/bash-completion/completions
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
7437d7bca9a3b019ae619ceb1036cfdae5f0e1d1be001a72149487b26fb07c324fc0398457f5ce9b6dfd663968cd6ef620c8d85d89ba19d946cecc4738133349  partclone-0.3.52.tar.gz
"
