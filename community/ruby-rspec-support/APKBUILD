# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-rspec-support
_gemname=${pkgname#ruby-}
pkgver=3.13.8
pkgrel=0
pkgdesc="Support utilities for RSpec gems"
url="http://rspec.info/"
arch="noarch"
license="MIT"
depends="ruby"
options="!check"  # rspec's tests are written in rspec
source="$pkgname-$pkgver.tar.gz::https://github.com/rspec/rspec/archive/$_gemname-v$pkgver.tar.gz
	gemspec.patch"
builddir="$srcdir/rspec-$_gemname-v$pkgver/$_gemname"

build() {
	gem build $_gemname.gemspec
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Clean-up...
	rm -r "$gemdir"/cache \
		"$gemdir"/build_info \
		"$gemdir"/doc \
		"$gemdir"/extensions
	rmdir "$gemdir"/plugins || true
}

