2bcfd9ab2a4c489b3e9c4b9da5cc57f81d3564ac85e1c91dc15478e5812cddecb6d4f88ea0fcb752f46f09e9bab9b65de2fd0b00eb2cd820e7c0ada05893e1f9  x-sys-ppc64le-pie-fix.patch
"
