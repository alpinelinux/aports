# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer:
pkgname=py3-genshi
pkgver=0.7.12
pkgrel=0
pkgdesc="Python toolkit for stream-based generation of output for the web"
url="https://genshi.edgewall.org/"
arch="all"
license="MIT"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="
	py3-pytest
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/edgewall/genshi/archive/$pkgver.tar.gz"
builddir="$srcdir/genshi-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest --ignore=examples
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
00388ad71e437ed04fbab3147a4ffa598aa042c2836cefd0b484f91601494048e1cd27211dfdcb6383f7973c5db4fc3a9e203a26af7ab68ff8ebad2a676951a3  py3-genshi-0.7.12.tar.gz
"
