# Maintainer: Keith Maxwell <keith.maxwell@gmail.com>
pkgname=ruby-unf_ext
_gemname=unf_ext
pkgver=0.0.9.1
pkgrel=2
pkgdesc="Unicode Normalization Form support library for CRuby"
url="https://github.com/knu/ruby-unf_ext/"
arch="all"
license="MIT"
makedepends="ruby-dev"
checkdepends="ruby-test-unit"
source="https://github.com/knu/ruby-unf_ext/archive/v$pkgver/ruby-unf_ext-$pkgver.tar.gz
	gemspec.patch
	test-helper.patch
	"

build() {
	local gemdir="dist$(ruby -e 'puts Gem.default_dir')"

	gem build $_gemname.gemspec

	gem install \
		--local \
		--build-root dist \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary and duplicated files.
	cd "$gemdir"
	rm -r build_info cache doc
	rmdir plugins || true
	rm -f extensions/*/*/$_gemname-*/mkmf.log

	cd gems/$_gemname-$pkgver
	rm -r ext/ lib/*.so README.*
}

check() {
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir')" \
	ruby -Ilib:test:. test/test_unf_ext.rb
}

package() {
	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/
}

