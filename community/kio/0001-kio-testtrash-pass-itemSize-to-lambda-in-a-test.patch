Subject: [PATCH] testtrash: pass itemSize to lambda in a test

To fix alpine/musl build
---
 src/kioworkers/trash/tests/testtrash.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/kioworkers/trash/tests/testtrash.cpp b/src/kioworkers/trash/tests/testtrash.cpp
index 0862971b82..2e26db9610 100644
--- a/src/kioworkers/trash/tests/testtrash.cpp
+++ b/src/kioworkers/trash/tests/testtrash.cpp
@@ -1571,7 +1571,7 @@ void TestTrash::sizeLimitDeletesOldestDirectory()
         config.sync();
     });
 
-    auto writeFile = [](const QString &path) {
+    auto writeFile = [itemSize](const QString &path) {
         QFile file(path);
         QVERIFY(file.open(QIODevice::WriteOnly));
         QCOMPARE(file.write(QByteArray(itemSize, 'x')), itemSize);
