# Maintainer:
pkgname=emacs-gnosis
pkgver=0.13.0
pkgrel=0
_pkgreal=gnosis
pkgdesc="Spaced Repetition System for GNU Emacs"
url="https://thanosapollo.org/projects/gnosis/"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	cmd:emacs
	cmd:git
	emacs-compat
	emacs-keymap-popup
	"
makedepends="emacs-nox"
source="$pkgname-$pkgver.tar::https://elpa.gnu.org/packages/gnosis-$pkgver.tar"
options="!check" # no tests provided
builddir="$srcdir"/$_pkgreal-$pkgver

build() {
	emacs -batch -q -no-site-file -L . \
		-f batch-byte-compile \
		./*.el
}

package() {
	install -Dvm644 ./*.el ./*.elc \
		-t "$pkgdir"/usr/share/emacs/site-lisp/$_pkgreal/

	# Temporarily preload jka-compr due to recursive load error
	# https://debbugs.gnu.org/cgi/bugreport.cgi?bug=81819
	cd "$pkgdir"/usr/share/emacs/site-lisp/$_pkgreal
	emacs -batch -q -no-site-file \
		-eval "(require 'jka-compr)" \
		-eval "(loaddefs-generate \".\" \"$_pkgreal-loaddefs.el\")"
}

sha512sums="
ca92607a54463a87cf8d6063fb00eb0090eb9e77696cee1c670d60894fe5eaaaa1cfb359e7ab11dcb825cb2f7fdea6d274a1553fa487d22e8b41d1d2d6e3bfa0  emacs-gnosis-0.13.0.tar
"
