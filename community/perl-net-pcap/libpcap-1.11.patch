Fix tests with libpcap 1.11

libpcap 1.11 changed some datalink descriptions. It also now provides
pcap_createsrcstr() and pcap_parsesrcstr() even when built without remote
capture, returning "not supported", so skip t/23-srcstr.t in that case.
The test also called the short function names, which are not exported by
default.

--- a/t/14-datalink.t
+++ b/t/14-datalink.t
@@ -29,10 +29,10 @@
 %val2descr = (
     0                => 'BSD loopback', 
     DLT_NULL()       => 'BSD loopback', 
-    DLT_LTALK()      => 'Localtalk', 
-    DLT_RAW()        => 'Raw IP', 
-    DLT_PPP_SERIAL() => 'PPP over serial', 
-    DLT_SLIP()       => 'SLIP', 
+    DLT_LTALK()      => 'LocalTalk', 
+    DLT_RAW()        => 'Raw IPv4/IPv6', 
+    DLT_PPP_SERIAL() => 'Point-to-Point Protocol over serial', 
+    DLT_SLIP()       => 'Serial Line IP', 
     DLT_IEEE802_11() => '802.11', 
 );
 
--- a/t/23-srcstr.t
+++ b/t/23-srcstr.t
@@ -6,6 +6,12 @@
 use Utils;
 
 plan skip_all => "pcap_createsrcstr() is not available" unless is_available('pcap_createsrcstr');
+{
+    my ($s, $e) = ('', '');
+    pcap_createsrcstr(\$s, 'rpcap', 'localhost', '2002', 'eth0', \$e);
+    plan skip_all => "pcap_createsrcstr() is not supported by libpcap"
+        if $e =~ /not supported/;
+}
 plan tests => 18;
 
 my $has_test_exception = eval "use Test::Exception; 1";
@@ -66,13 +72,13 @@
 
 }
 
-$r = eval { createsrcstr(\$src, $type, $host, $port, $name, \$err) };
+$r = eval { pcap_createsrcstr(\$src, $type, $host, $port, $name, \$err) };
 is( $@, '', "createsrcstr() " );
 is( $r, 0, " - should return zero: $r" );
 is( $src, "$type\://$host\:$port/$name", " - checking created source string" );
 
 my($parsed_type,$parsed_host,$parsed_port,$parsed_name) = ('','','','');
-$r = eval { parsesrcstr($src, \$parsed_type, \$parsed_host, \$parsed_port, \$parsed_name, \$err) };
+$r = eval { pcap_parsesrcstr($src, \$parsed_type, \$parsed_host, \$parsed_port, \$parsed_name, \$err) };
 is( $@, '', "parsesrcstr() " );
 is( $r, 0, " - should return zero: $r" );
 is( $parsed_type, $type, " - checking parsed type" );
