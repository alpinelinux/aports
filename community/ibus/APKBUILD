# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=ibus
pkgver=1.5.35_beta2
pkgrel=0
pkgdesc="Next Generation Input Bus for Linux"
url="https://github.com/ibus/ibus/wiki"
arch="all"
license="LGPL-2.1-or-later"
depends="
	dbus
	dconf
	hicolor-icon-theme
	iso-codes
	py3-gobject3
	"
makedepends="
	bash
	cldr-emoji-annotation
	dbus-x11
	dconf-dev
	gobject-introspection-dev
	gtk+3.0-dev
	gtk4.0-dev
	iso-codes-dev
	libdbusmenu-glib-dev
	libdbusmenu-gtk3-dev
	libnotify-dev
	unicode-character-database
	vala
	wayland-dev
	wayland-protocols
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-pyc
	$pkgname-emoji
	$pkgname-gtk3
	$pkgname-gtk4
	$pkgname-bash-completion
	"
# if $pkgver tarball not found, switch to $pkgver-rc$n
# https://github.com/ibus/ibus/issues/2584
case "$pkgver" in
*_beta*)
	source="https://github.com/ibus/ibus/releases/download/${pkgver/_/-}/ibus-${pkgver/_/-}.tar.gz"
	builddir="$srcdir"/ibus-${pkgver/_/-} ;;
*)
	source="https://github.com/ibus/ibus/releases/download/$pkgver/ibus-$pkgver.tar.gz" ;;
esac
install="$pkgname.post-install"

prepare() {
	default_prepare

	# disable-gtk-doc doesn't prevent install of what exists
	rm -r docs/reference/ibus/html/
}

build() {
	local sitedir=$(python3 -c "import site; print(site.getsitepackages()[0])")

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/ibus \
		--sysconfdir=/etc \
		--with-python-overrides-dir="$sitedir"/gi/overrides \
		--with-ucd-dir=/usr/share/unicode/ \
		--disable-gtk-doc \
		--disable-gtk2 \
		--disable-memconf \
		--disable-python2 \
		--disable-systemd-services \
		--enable-emoji-dict \
		--enable-dconf \
		--enable-gtk4 \
		--enable-introspection \
		--enable-surrounding-text \
		--enable-ui \
		--enable-wayland
	make
}

check() {
	./bus/ibus-daemon --version
}

package() {
	make DESTDIR="$pkgdir" install

	# Install pygobject overrides
	local sitedir=$(python3 -c "import site; print(site.getsitepackages()[0])")
	install -Dm644 "$builddir"/bindings/pygobject/gi/overrides/IBus.py \
		-t "$pkgdir"/"$sitedir"/gi/overrides/
}

emoji() {
	pkgdesc="$pkgdesc (emojis)"
	depends="$pkgname unicode-character-database cldr-emoji-annotation"

	mkdir -p "$subpkgdir"/usr/share/ibus
	mv "$pkgdir"/usr/share/ibus/dicts "$subpkgdir"/usr/share/ibus
}

gtk3() {
	install_if="$pkgname=$pkgver-r$pkgrel gtk+3.0"

	amove usr/lib/gtk-3.0/3.0.0
}

gtk4() {
	install_if="$pkgname=$pkgver-r$pkgrel gtk4.0"

	amove usr/lib/gtk-4.0/4.0.0
}

pyc() {
	default_pyc
	amove usr/share/ibus/setup/__pycache__
}

sha512sums="
b216fb2cb7cd07aaa2cad57ab10296f27e1fcfaa772777590b8e9682c942e15a6832b96b5a353c4bb933a1f094dc5587160f65a795006b76abae1dc0cc5a35f1  ibus-1.5.35-beta2.tar.gz
"
