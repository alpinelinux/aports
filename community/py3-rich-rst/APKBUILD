maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-rich-rst
pkgver=2.1.0
pkgrel=0
pkgdesc="A beautiful reStructuredText renderer for rich"
url="https://wasi-master.github.io/rich-rst"
arch="noarch"
license="MIT"
depends="
	py3-pygments
	py3-rich
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://pypi.python.org/packages/source/r/rich_rst/rich_rst-$pkgver.tar.gz"
#source="$pkgname-pkgver.tar.gz::https://github.com/BrianPugh/cyclopts/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/rich_rst-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
633b45f586454c83f9e5323415ae78aaea537c937c2b6182b66a37d0880337fa4db766bade04a11386e1505b7fc44bf7e9eadf525eb4437c1bf24a16b0da30b6  py3-rich-rst-2.1.0.tar.gz
"
