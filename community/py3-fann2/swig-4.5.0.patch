From 2116d98a13df3c967b9b3676cee58d16c254a9fd Mon Sep 17 00:00:00 2001
From: mio <miyopan@e.email>
Date: Thu, 15 Oct 2026 01:54:13 +0000
Subject: [PATCH] Fix build with SWIG 4.5.0

Python 2 API macros were removed from SWIG 4.5.0. Update the bindings to
use the Python 3 API. Fixes errors such as:

```
fann2/fann2_wrap.cxx: In function 'PyObject*
_wrap_neural_net_create_standard_array(PyObject*, PyObject*)':
fann2/fann2_wrap.cxx:10062:41: error: 'PyInt_AsLong' was not declared in
this scope; did you mean 'PyLong_AsLong'?
10062 |         arg2->array[i] = (unsigned int) PyInt_AsLong(o);
      |                                         ^~~~~~~~~~~~
      |                                         PyLong_AsLong
```
---
 fann2/fann2.i | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/fann2/fann2.i b/fann2/fann2.i
index 08125dd..7b28a77 100644
--- a/fann2/fann2.i
+++ b/fann2/fann2.i
@@ -173,7 +173,7 @@
 %import "../include/fann_error.h"
 %import "../include/fann_activation.h"
 
-HELPER_ARRAY_TEMPLATE( FANN::helper_array, unsigned int, PyInt_AsLong    , PyInt_FromLong    , long   );
+HELPER_ARRAY_TEMPLATE( FANN::helper_array, unsigned int, PyLong_AsLong    , PyLong_FromLong    , long   );
 HELPER_ARRAY_TEMPLATE( FANN::helper_array, fann_type   , PyFloat_AsDouble, PyFloat_FromDouble, double );
 
 HELPER_ARRAY_ARRAY_TEMPLATE( FANN::helper_array_array, fann_type   , PyFloat_AsDouble, PyFloat_FromDouble, double );
@@ -205,10 +205,10 @@ HELPER_ARRAY_ARRAY_TEMPLATE( FANN::helper_array_array, fann_type   , PyFloat_AsD
         PyObject *from_neuron = PySequence_GetItem(o,0);
         PyObject *to_neuron = PySequence_GetItem(o,1);
         PyObject *weight = PySequence_GetItem(o,2);
-        if (PyInt_Check(from_neuron) && PyInt_Check(to_neuron) &&
+        if (PyLong_Check(from_neuron) && PyLong_Check(to_neuron) &&
                 PyNumber_Check(weight)) {
-            $1->array[i].from_neuron = (unsigned int) PyInt_AsLong(from_neuron);
-            $1->array[i].to_neuron = (unsigned int) PyInt_AsLong(to_neuron);
+            $1->array[i].from_neuron = (unsigned int) PyLong_AsLong(from_neuron);
+            $1->array[i].to_neuron = (unsigned int) PyLong_AsLong(to_neuron);
             $1->array[i].weight = (fann_type) PyFloat_AsDouble(weight);
         } else {
             PyErr_SetString(PyExc_ValueError,"Connection elements must be (int, int, float)");
@@ -239,8 +239,8 @@ HELPER_ARRAY_ARRAY_TEMPLATE( FANN::helper_array_array, fann_type   , PyFloat_AsD
     for (unsigned int i = 0; i < $1->array_len; i++)
     {
         PyObject *o = PyTuple_Pack (3,
-                PyInt_FromLong( (long) ($1->array[i].from_neuron)),
-                PyInt_FromLong( (long) ($1->array[i].to_neuron)),
+                PyLong_FromLong( (long) ($1->array[i].from_neuron)),
+                PyLong_FromLong( (long) ($1->array[i].to_neuron)),
                 PyFloat_FromDouble( (double) ($1->array[i].weight)));
         PyList_SetItem($result,i,o);
     }
-- 
