From: lazerg <lazerg2@gmail.com>
Date: Mon, 26 Oct 2026 22:41:57 +0500
Subject: [PATCH] Fix GH-24752: php_ini_loaded_file.phpt fails under make test

---
 ext/standard/tests/ini_info/php_ini_loaded_file.phpt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ext/standard/tests/ini_info/php_ini_loaded_file.phpt b/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
index 4e3085ba8653..638133ba18b5 100644
--- a/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
+++ b/ext/standard/tests/ini_info/php_ini_loaded_file.phpt
@@ -8,7 +8,7 @@ php_ini_loaded_file() function
     $code = '"var_dump(php_ini_loaded_file());"';
 
     // No ini file
-    passthru("$php $args -n -r $code");
+    passthru("$php -n -r $code");
 
     // Specified ini file
     passthru("$php $args -c $inifile -r $code");
