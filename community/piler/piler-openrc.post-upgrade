#!/bin/sh

ver_old="$2"

if [ "$(apk version -t "$ver_old" "1.4.9-r3")" = '<' ]; then
	cat >&2 <<-EOF
	*
	* Service searchd was renamed to piler-searchd.
	* Fixing runlevels for you...
	*
	EOF

	for path in $(find /etc/runlevels -type l -name searchd); do
		rm "$path"
		ln -s /etc/init.d/piler-searchd "${path%/*}/piler-searchd"
	done

	# We've already copied it to piler-searchd in pre-upgrade script.
	rm -f /etc/conf.d/searchd
fi

exit 0
