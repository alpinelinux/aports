#!/bin/sh

ver_old="$2"

if [ "$(apk version -t "$ver_old" "1.4.9-r3")" = '<' ]; then
	# Copy /etc/conf.d/searchd to piler-searchd *if* it was modified by user.
	if apk audit -q /etc/conf.d | grep -q 'conf.d/searchd$' && ! [ -f /etc/conf.d/piler-searchd ]; then
		cp -a /etc/conf.d/searchd /etc/conf.d/piler-searchd
	fi
fi

exit 0
