maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=bazaar
pkgver=0.9.8
pkgrel=1
pkgdesc="New App Store for GNOME"
url="https://usebazaar.org/"
arch="all !armhf !armv7 !x86" # fails to build
license="GPL-3.0-or-later"
makedepends="
	blueprint-compiler
	desktop-file-utils
	flatpak-dev
	gobject-introspection
	gtk4.0-dev
	gtksourceview5-dev
	libadwaita-dev
	libdex-dev
	libglycin-dev
	libglycin-gtk4-dev
	libproxy-dev
	libsecret-dev
	libsoup3-dev
	libxmlb-dev
	malcontent-dev
	md4c-dev
	meson
	py3-babel
	sed
	vala
	webkit2gtk-6.0-dev
	yaml-dev
	"
subpackages="
	$pkgname-dev
	$pkgname-lang
	$pkgname-libs
	"
source="$pkgname-$pkgver.tar.gz::https://gitlab.gnome.org/World/bazaar/-/archive/v$pkgver/bazaar-v$pkgver.tar.gz
	strcasestr.patch
	webkit-2.48.patch
	systemd.patch
	"
builddir="$srcdir/$pkgname-v$pkgver"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

