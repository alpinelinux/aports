# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-ffi
_gemname=ffi
pkgver=1.17.4
pkgrel=0
pkgdesc="Ruby FFI library"
url="https://github.com/ffi/ffi"
arch="all"
license="BSD-3-Clause"
makedepends="
	libffi-dev
	ruby
	ruby-dev
	"
checkdepends="
	ruby-bigdecimal
	ruby-fiddle
	ruby-rspec
	"
install="$pkgname.post-install"
source="$pkgname-$pkgver.tar.gz::https://github.com/ffi/$_gemname/archive/v$pkgver.tar.gz
	musl-compat.patch
	gemspec.patch
	"
builddir="$srcdir/$_gemname-$pkgver"

build() {
	gem build $_gemname.gemspec
	gem install --local \
		--build-root dist \
		--no-document \
		--verbose \
		$_gemname-$pkgver.gem
}

check() {
	local exclude=''
	# FIXME fails with: expected -0.477986771... to be within 0.01 of 0.3
	case "$CARCH" in
		x86)  exclude='spec/ffi/long_double_spec.rb' ;;
	esac

	# LD_LIBRARY_PATH is a workaround to fix test
	# `Library ffi_lib interprets INPUT() in loader scripts` in library_spec.
	GEM_PATH="dist$(ruby -e 'puts Gem.default_dir'):.gem" \
	LD_LIBRARY_PATH="$builddir/spec/ffi/fixtures" \
		rspec --exclude-pattern "$exclude"
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"

	local carch
	case "$CARCH" in
		x86) carch="i386";;
		arm*) carch="arm";;
		ppc64le) carch="powerpc64";;
		*) carch="$CARCH";;
	esac

	mkdir -p "$pkgdir"
	cp -r dist/* "$pkgdir"/

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r build_info cache doc
	rmdir plugins || true
	find extensions/ -name mkmf.log -delete

	cd gems/$_gemname-$pkgver
	rm -r ext/ lib/*.so
	find lib/ffi/platform/* -prune ! -name "$carch-linux" -exec rm -rf {} +
}

