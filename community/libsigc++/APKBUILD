# Contributor: Leo <thinkabit.ukim@gmail.com>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=libsigc++
pkgver=2.12.2
pkgrel=0
pkgdesc="type-safe Signal Framework for C++"
url="https://github.com/libsigcplusplus/libsigcplusplus"
arch="all"
license="LGPL-3.0-or-later"
makedepends="meson docbook-xsl-nons perl doxygen graphviz libxslt"
subpackages="$pkgname-dev $pkgname-devhelp $pkgname-doc"
source="https://github.com/libsigcplusplus/libsigcplusplus/releases/download/$pkgver/libsigc++-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dbuild-documentation=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
a277a60dcf3bf6972656e565b233490e4b3dd2ce2c8cd0e2a340b9600f608310dfa4596a5a5f0f840dc1da717c035bc535d466d155d9b27225577d598a45bd89  libsigc++-2.12.2.tar.xz
"
