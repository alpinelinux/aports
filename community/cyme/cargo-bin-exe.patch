--
From e3c7c3a6949af5a46b80d04405ebc7a12a91379b Mon Sep 17 00:00:00 2001
From: John Whittington <git@jbrengineering.co.uk>
Date: Wed, 18 Nov 2026 08:54:46 +0100
Subject: [PATCH] test: locate the cyme binary with CARGO_BIN_EXE_cyme

find_cyme_exe() assumed integration test binaries live in
target/debug/deps, one level below the cyme binary. Newer Cargo puts
test binaries in a separate build directory, so the lookup pointed at a
path with no cyme binary and every integration test failed.

Cargo sets CARGO_BIN_EXE_<name> for integration tests, which gives the
path directly whatever the layout.
---
 tests/common/mod.rs | 17 ++++-------------
 1 file changed, 4 insertions(+), 13 deletions(-)

diff --git a/tests/common/mod.rs b/tests/common/mod.rs
index 23e1dd44..10f8cef6 100644
--- a/tests/common/mod.rs
+++ b/tests/common/mod.rs
@@ -1,7 +1,6 @@
 //! Runs tests using actual binary, adapted from 'fd' method: https://github.com/sharkdp/fd/blob/master/tests/testenv/mod.rs
 #![allow(dead_code)]
 use serde_json::json;
-use std::env;
 use std::fs::File;
 use std::io::{BufReader, Read};
 use std::path::PathBuf;
@@ -70,19 +69,11 @@ pub struct TestEnv {
 }
 
 /// Find the *cyme* executable.
+///
+/// Cargo sets `CARGO_BIN_EXE_cyme` for integration tests, so this does not
+/// depend on where the test binary itself is placed.
 fn find_cyme_exe() -> PathBuf {
-    // Tests exe is in target/debug/deps, the *cyme* exe is in target/debug
-    let root = env::current_exe()
-        .expect("tests executable")
-        .parent()
-        .expect("tests executable directory")
-        .parent()
-        .expect("cyme executable directory")
-        .to_path_buf();
-
-    let exe_name = if cfg!(windows) { "cyme.exe" } else { "cyme" };
-
-    root.join(exe_name)
+    PathBuf::from(env!("CARGO_BIN_EXE_cyme"))
 }
 
 /// Format an error message for when *cyme* did not exit successfully.
