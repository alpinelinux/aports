fd4fd0b9059b4fb6443d5011cf89f0717d3e61ba23d6b09591ebcab7998a9f1e5fe3f656d68834df03a315ab6a397b8a14558f135e00b8877c079bb9ea80aa5b  rustix-1.1.6.patch
"
