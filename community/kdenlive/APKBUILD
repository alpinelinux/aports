# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-applications
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kdenlive
pkgver=26.08.2
pkgrel=2
arch="all !armhf !s390x !riscv64"
url="https://kdenlive.org"
pkgdesc="An intuitive and powerful multi-track video editor, including most recent video technologies"
license="GPL-2.0-or-later"
depends="
	ffmpeg
	frei0r-plugins
	mlt-qt6
	qqc2-desktop-style
	"
makedepends="
	extra-cmake-modules
	kddockwidgets-dev
	kdeclarative-dev
	kdoctools-dev
	kfilemetadata-dev
	knewstuff-dev
	knotifyconfig-dev
	kxmlgui-dev
	mlt-dev
	opentimelineio-dev
	purpose-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtmultimedia-dev
	qt6-qtnetworkauth-dev
	qt6-qtsvg-dev
	rttr-dev
	samurai
	"
checkdepends="xwayland-run"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-lang"
_repo_url="https://invent.kde.org/multimedia/kdenlive.git"
source="https://download.kde.org/stable/release-service/$pkgver/src/kdenlive-$pkgver.tar.xz"
options="!check" # Segfaulting

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING="$(want_check && echo ON || echo OFF)" \
		-DIMATH_INSTALL=OFF \
		-DIMATH_INSTALL_PKG_CONFIG=OFF
	cmake --build build
}

check() {
	wlheadless-run -- ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
e49c9af0495a61bb8b2eff178f47b6874b6adee16ca436a6a5b9ef538c89c1dc9d0df23510124612b943ad78dc041e8b374614c6fc1696e0a214f70f35a35c14  kdenlive-26.08.2.tar.xz
"
