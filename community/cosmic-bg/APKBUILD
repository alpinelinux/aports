# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=cosmic-bg
pkgver=1.5.0
_upstreamver="${pkgver/_beta/-beta.}"
_upstreamver="${_upstreamver/_p/.}"
pkgrel=0
pkgdesc="COSMIC session service which applies backgrounds to displays"
url="https://github.com/pop-os/cosmic-bg"
# armv7, armhf, x86: DO NOT RE-ENABLE! 32-bit is problematic, often requires carrying patches to fix
# riscv64: too slow to build
arch="all !armv7 !armhf !riscv64 !x86"
license="MPL-2.0"
depends="
	cosmic-icons
"
makedepends="
	cargo-auditable
	dav1d-dev
	just
	libxkbcommon-dev
"
options="net !check"  # fetch dependencies, no tests
source="$pkgname-$pkgver.tar.gz::https://github.com/pop-os/cosmic-bg/archive/refs/tags/epoch-$_upstreamver.tar.gz"
builddir="$srcdir/$pkgname-epoch-$_upstreamver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	just rootdir="$pkgdir" install
}

sha512sums="
cbdcbde22e4e16a460be870d976a27d47a7a3856dbd2e8ddb7a6c5ca82330467523fe62d733298fa4c90e4da9ab4398b59815a03894d7324bc096620963ad671  cosmic-bg-1.5.0.tar.gz
"
