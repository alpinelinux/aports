Patch-Source: https://github.com/itchyny/gojq/commit/3e0421ce4cfb8033bfdf14c8d493e024d1c86bad
---
From 3e0421ce4cfb8033bfdf14c8d493e024d1c86bad Mon Sep 17 00:00:00 2001
From: itchyny <itchyny@cybozu.co.jp>
Date: Wed, 23 Sep 2026 13:08:50 +0900
Subject: [PATCH] fix stream option error message on Go 1.27 (fix #301, close
 #302)

---
 cli/stream.go | 19 ++++++++++---------
 cli/test.yaml | 17 ++++++++++++++++-
 2 files changed, 26 insertions(+), 10 deletions(-)

diff --git a/cli/stream.go b/cli/stream.go
index 353fe35e..77505171 100644
--- a/cli/stream.go
+++ b/cli/stream.go
@@ -36,14 +36,6 @@ func (s *jsonStream) next() (any, error) {
 	case jsonStateArrayEmptyEnd, jsonStateObjectEmptyEnd:
 		s.states = s.states[:len(s.states)-1]
 	}
-	if s.dec.More() {
-		switch s.states[len(s.states)-1] {
-		case jsonStateArrayValue:
-			s.path[len(s.path)-1] = s.path[len(s.path)-1].(int) + 1
-		case jsonStateObjectValue:
-			s.path = s.path[:len(s.path)-1]
-		}
-	}
 	for {
 		token, err := s.dec.Token()
 		if err != nil {
@@ -52,7 +44,16 @@ func (s *jsonStream) next() (any, error) {
 			}
 			return nil, err
 		}
-		if d, ok := token.(json.Delim); ok {
+		d, ok := token.(json.Delim)
+		if !ok || d != ']' && d != '}' {
+			switch s.states[len(s.states)-1] {
+			case jsonStateArrayValue:
+				s.path[len(s.path)-1] = s.path[len(s.path)-1].(int) + 1
+			case jsonStateObjectValue:
+				s.path = s.path[:len(s.path)-1]
+			}
+		}
+		if ok {
 			switch d {
 			case '[', '{':
 				switch s.states[len(s.states)-1] {
diff --git a/cli/test.yaml b/cli/test.yaml
index 5f74c9eb..b1aeee4a 100644
--- a/cli/test.yaml
+++ b/cli/test.yaml
@@ -7746,7 +7746,7 @@
     [["c"],3]
     [["c"]]
 
-- name: stream option with unterminated input
+- name: stream option with unterminated input after a comma
   args:
     - -c
     - --stream
@@ -7759,6 +7759,21 @@
         {"a":1,
                ^  unexpected EOF
 
+- name: stream option with unterminated input after a value
+  args:
+    - -c
+    - --stream
+    - '.'
+  input: '[1,[2,3'
+  expected: |
+    [[0],1]
+    [[1,0],2]
+    [[1,1],3]
+  error: |
+    invalid json: <stdin>
+        [1,[2,3
+               ^  unexpected EOF
+
 - name: yaml input option
   args:
     - --yaml-input
