# Maintainer: Willow Barraco <contact@willowbarraco.fr>
pkgname=tuba
pkgver=0.11.0
pkgrel=0
pkgdesc="Browse the Fediverse"
url="https://tuba.geopjr.dev/"
arch="all"
license="GPL-3.0-or-later"
depends="glycin-image-rs gst-plugins-good"
makedepends="
	desktop-file-utils
	glib-dev
	gstreamer-dev
	gtk4.0-dev
	gtksourceview5-dev
	gspell-dev
	json-glib-dev
	libadwaita-dev
	libgee-dev
	libsecret-dev
	libsoup3-dev
	libxml2-dev
	libspelling-dev
	meson
	vala
	"
subpackages="$pkgname-lang $pkgname-doc"
options="!check"
source="tuba-$pkgver.tar.gz::https://codeberg.org/GeopJr/Tuba/archive/v$pkgver.tar.gz"
builddir="$srcdir/tuba"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgstreamer=enabled \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	ln -s dev.geopjr.Tuba "$pkgdir"/usr/bin/tuba
}

sha512sums="
50bf5f34bcb94eb74c7383a0d194f85d4364c82f8391bcab93783f81aceb81c7893c1d2444fde76fdd8009ec94172c4d2800138011d7d85738d28e3930e1bc1c  tuba-0.11.0.tar.gz
"
