# Maintainer: Willow Barraco <contact@willowbarraco.fr>
pkgname=tuba
pkgver=0.11.1
pkgrel=0
pkgdesc="Browse the Fediverse"
url="https://tuba.geopjr.dev/"
arch="all"
license="GPL-3.0-or-later"
depends="glycin-image-rs gst-plugins-good"
makedepends="
	desktop-file-utils
	glib-dev
	gstreamer-dev
	gtk4.0-dev
	gtksourceview5-dev
	gspell-dev
	json-glib-dev
	libadwaita-dev
	libgee-dev
	libsecret-dev
	libsoup3-dev
	libxml2-dev
	libspelling-dev
	meson
	vala
	"
subpackages="$pkgname-lang $pkgname-doc"
options="!check"
source="tuba-$pkgver.tar.gz::https://codeberg.org/GeopJr/Tuba/archive/v$pkgver.tar.gz"
builddir="$srcdir/tuba"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dgstreamer=enabled \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	ln -s dev.geopjr.Tuba "$pkgdir"/usr/bin/tuba
}

sha512sums="
a9f2b2ce5ba72e27c104df2dd04dacfc3963eb3516d934af20ad0f37dc2cdbba3e1c0267abf3ac52f55d22fed82e2b27499ef4bbcfdd8bf3948e53b9ec510dc8  tuba-0.11.1.tar.gz
"
