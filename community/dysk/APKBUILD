maintainer="Michał Polański <michal@polanski.me>"
pkgname=dysk
pkgver=3.8.2
pkgrel=0
pkgdesc="Get information on your mounted disks"
url="https://github.com/Canop/dysk"
license="MIT"
arch="all"
makedepends="cargo cargo-auditable"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/Canop/dysk/archive/v$pkgver/dysk-$pkgver.tar.gz"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --locked
}

check() {
	cargo test --locked
}

package() {
	cd target/release

	install -Dm755 $pkgname -t "$pkgdir"/usr/bin/

	install -Dm644 build/dysk/*/out/$pkgname.1 "$pkgdir"/usr/share/man/man1/$pkgname.1

	install -Dm644 build/dysk/*/out/$pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 build/dysk/*/out/$pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 build/dysk/*/out/_$pkgname "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

sha512sums="
bbfa8ea79dccfd06507165cb3fabf0dfe07e522606b3b55df482675a125c9bda2db33d2e2877135e49506668e0f89bc57ca610b1ce88e90632a25dc1822bab67  dysk-3.8.2.tar.gz
"
