# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=greenbone-feed-sync
# follow the same version of gvm-tools
pkgver=25.4.2
pkgrel=0
pkgdesc="New script for syncing the Greenbone Community Feed"
url="https://github.com/greenbone/greenbone-feed-sync"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	py3-rich
	python3
	rsync
	"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-installer
	py3-poetry-core
	py3-lxml
	"
checkdepends="
	py3-pontos
	py3-pytest
	py3-shtab
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/greenbone/greenbone-feed-sync/archive/refs/tags/v$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest --deselect=tests/test_parser.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
c07af536dfda46cd482c92659cdbed0eff83ed0b454cf3791b63c28361edbabd500d2ed18f2ed534a47ff1edfb66161c9a2f9b87142f3583f596f74d5b639a97  greenbone-feed-sync-25.4.2.tar.gz
"
