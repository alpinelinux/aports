maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-jedi
pkgver=0.20.1
pkgrel=0
pkgdesc="Awesome autocompletion and static analysis library for Python"
url="https://jedi.readthedocs.io"
arch="noarch"
license="MIT"
depends="py3-parso"
makedepends="
	py3-build
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://pypi.python.org/packages/source/j/jedi/jedi-$pkgver.tar.gz"
builddir="$srcdir/jedi-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -k 'not pep0695_type_parameter_syntax'
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
761f46e092f4f238562824e825d5a940af0d77ec0d4fec60103484743025e71fc3752d7f6d561895735f2e27f5c9bb477e9e80a79fb86de84a28650eb8693a52  jedi-0.20.1.tar.gz
"
