maintainer="Michał Polański <michal@polanski.me>"
pkgname=py3-anyio
pkgver=4.16.0
pkgrel=0
pkgdesc="High level compatibility layer for multiple asynchronous event loop implementations"
url="https://github.com/agronholm/anyio"
license="MIT"
arch="noarch"
depends="py3-idna py3-sniffio py3-typing-extensions"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-pytest-xdist"
checkdepends="
	py3-hypothesis
	py3-psutil
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-mock
	py3-pytest-rerunfailures
	py3-pytest-timeout
	py3-pytest-xdist
	py3-trio
	py3-trustme
	py3-uvloop
	"
subpackages="$pkgname-pyc"
# patches are post release fixes for tests/streams/test_tls.py related errors
source="https://github.com/agronholm/anyio/archive/$pkgver/py3-anyio-$pkgver.tar.gz
	test_pytest_plugin-increase_timeout.patch
	"
builddir="$srcdir/anyio-$pkgver"

build() {
	SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver" \
		gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	# test_sockets.py: disable tests that requires network
	# tests/test_to_process.py::test_nonexistent_main_module: AttributeError: 'module' object at __main__ has no attribute '__file__'
	# tests/test_to_process.py::test_entrypoint_main_module: AttributeError: 'module' object at __main__ has no attribute '__file__'
	# tests/test_pytest_plugin.py::test_keyboardinterrupt_during_test: 3 second timeout expired on slower archs
	# tests/test_lazyimport.py::test_sourceless_install: disable tests that requires network
	.testenv/bin/python3 -m pytest -v -n 1 --reruns=3 \
		--ignore tests/test_sockets.py \
		--deselect tests/test_to_process.py::test_nonexistent_main_module \
		--deselect tests/test_to_process.py::test_entrypoint_main_module \
		--deselect tests/test_pytest_plugin.py::test_keyboard_interrupt_does_not_resume_test \
		--deselect tests/test_lazyimport.py::test_sourceless_install
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

