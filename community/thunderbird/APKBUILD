pkgname=thunderbird
pkgver=161.0
pkgrel=0
pkgdesc="Thunderbird email client"
url="https://www.thunderbird.net/"
# armhf: blocked by openmp and broken rust neon code
# s390x: --with-wasi-sysroot is not available in this configuration
# x86: keeps getting signal: 11, SIGSEGV: invalid memory reference on builder
# riscv64: Identified 2 networking function(s) being imported in the rust static library
# armv7: consistently OOMs on the Rust style library
arch="all !armhf !s390x !x86 !riscv64 !armv7"
license="GPL-3.0-or-later AND LGPL-2.1-or-later AND MPL-2.0"
depends="libotr librnp"
_llvmver=23
makedepends="
