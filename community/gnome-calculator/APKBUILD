# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/gnome <achill@achill.org>"
pkgname=gnome-calculator
pkgver=51.1
pkgrel=0
pkgdesc="Calculator for solving mathematical equations"
url="https://apps.gnome.org/Calculator"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	blueprint-compiler
	glib-dev
	gtksourceview5-dev
	gtk4.0-dev
	itstool
	libadwaita-dev
	libgee-dev
	libsoup3-dev
	libxml2-dev
	meson
	mpc1-dev
	mpfr-dev
	vala
	"
subpackages="$pkgname-devhelp $pkgname-doc $pkgname-lang $pkgname-dev"
source="https://download.gnome.org/sources/gnome-calculator/${pkgver%%.*}/gnome-calculator-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

check() {
	# loongarch64, armhf, ppc64le and riscv64 timeouted number test with standard timeout
	meson test -t 10 --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
74b91b34c53a45d22087571607aee2356ad8b65cb1c5ed7294d29f5df7c18ff9d8cff9f68c85c75bb9cb575abaf5fd4d483bf4617247972a41aaf39b9a4972fd  gnome-calculator-51.1.tar.xz
"
