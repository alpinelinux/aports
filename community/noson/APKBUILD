8084ef4f6bb45d4eb449127cf84325a57a199544ffb7aa73431c210d8c501c3e1680682f0d4479467d94cad7d45cf0d51f81e4ac0d376db6f4fee9e7aca3ec5e  0001-jsonparser-missing-cstdint.patch
"
