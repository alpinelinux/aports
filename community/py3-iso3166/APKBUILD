maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-iso3166
_pkgname=${pkgname#py3-}
pkgver=2.1.1
pkgrel=0
pkgdesc="Standalone ISO 3166-1 country definitions"
url="https://github.com/deactivated/python-iso3166"
arch="noarch"
license="MIT"
makedepends="py3-gpep517 py3-setuptools"
checkdepends="py3-pytest"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
subpackages="$pkgname-pyc"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist  --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
b427c58ab44abd21a985b0d2b0ea48576cd0fd0d4383d7c53492961d3649c7829acebff66984ce74a02b4f3315c3cfc57dc29fd033f6d6dd7606aca43bfb6401  iso3166-2.1.1.tar.gz
"
