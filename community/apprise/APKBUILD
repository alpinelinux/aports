# Contributor: Guy Godfroy <guy.godfroy@gugod.fr>
# Maintainer: Guy Godfroy <guy.godfroy@gugod.fr>
pkgname=apprise
pkgver=1.12.0
pkgrel=0
pkgdesc="Push Notifications that work with just about every platform"
url="https://github.com/caronc/apprise"
arch="noarch"
license="BSD-2-Clause"
depends="py3-certifi py3-requests py3-requests-oauthlib py3-click py3-markdown py3-yaml py3-tzdata glib"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest py3-pytest-mock"
subpackages="$pkgname-doc $pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://codeload.github.com/caronc/apprise/tar.gz/refs/tags/v$pkgver
	fix-test-plugin-paths-tmpdir.patch
	fix-conftest-session-mocker-leak.patch
	"
options="net"

case "$CARCH" in
loongarch64|s390x|x86)
	options="$options !check" # some tests fail on package builders
	;;
esac

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# these two are too slow to meet their own timing assertions on the emulator
	if [ "$CARCH" = riscv64 ]; then
		sh bin/test.sh "not test_plugin_fluxer_429 and not test_conversion_html_to_markdown_hardening"
	else
		sh bin/test.sh
	fi
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
	install -Dm644 packaging/man/apprise.1 -t "$pkgdir"/usr/share/man/man1
}

sha512sums="
