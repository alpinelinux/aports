# Contributor: Michał Polański <michal@polanski.me>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=lagrange
pkgver=2.0.1
pkgrel=0
pkgdesc="Beautiful Gemini client"
url="https://gmi.skyjake.fi/lagrange"
license="BSD-2-Clause"
arch="all !s390x" # s390x: fails to load resources
makedepends="
	cmake
	fribidi-dev
	harfbuzz-dev
	libunistring-dev
	libwebp-dev
	mpg123-dev
	ncurses-static
	openssl-dev
	opusfile-dev
	pcre2-dev
	samurai
	sdl3-dev
	zip
	zlib-dev
	"
subpackages="$pkgname-dbg $pkgname-doc"
source="https://git.skyjake.fi/gemini/lagrange/releases/download/v$pkgver/lagrange-$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_POPUP_MENUS=OFF \
		-DENABLE_RESIZE_DRAW=OFF \
		-DENABLE_TUI=ON \
		-DENABLE_X11_XLIB=OFF \
		-DTFDN_ENABLE_SSE41=OFF
	cmake --build build
}

check() {
	# Looks for resources.lgr at /usr/share/lagrange or ../share/lagrange
	cd ./build/app && mkdir -p share/lagrange
	ln -s resources.lgr share/lagrange/resources.lgr
	./clagrange --version
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
a859627399907c7739763f262d077db5616843d2f43cde3ef894cf631242f185c833bcf7c35f1f8a0b6da8329680882183de70f7c92c3d57b2e2684e4ca9090b  lagrange-2.0.1.tar.gz
"
