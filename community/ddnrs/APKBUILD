# Contributor: Matthias Ahouansou <matthias@ahouansou.cz>
# Maintainer: Matthias Ahouansou <matthias@ahouansou.cz>
pkgname=ddnrs
pkgver=0.3.0
pkgrel=0
pkgdesc="A simple tool to update dns records to match your current IP"
url="https://codeberg.org/Kladky/ddnrs"
arch="all"
license="AGPL-3.0-only"
makedepends="
	make
	cargo
	cargo-auditable
	openssl-dev
	"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver-1.tar.gz::https://codeberg.org/Kladky/ddnrs/archive/$pkgver.tar.gz"
options="!check" # no tests
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	CARGO="cargo auditable" make build-frozen
}

package() {
	DESTDIR="$pkgdir" make install
	DESTDIR="$pkgdir" make install-openrc
}

sha512sums="
0cb50a679941a6e09f0fe3a529f6a17705d0ef57bc13a20536fea160992e05e00d785fb23bff6c5b36aacd89e057b97d743df87a0b7a623aebaede220ad7894f  ddnrs-0.3.0-1.tar.gz
"
