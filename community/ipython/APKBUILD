# Contributor: Kevin Daudt <kdaudt@alpinelinux.org>
# Maintainer: Kevin Daudt <kdaudt@alpinelinux.org>
pkgname=ipython
pkgver=9.16.0
pkgrel=0
pkgdesc="A rich toolkit to help you make the most of using Python interactively"
url="https://ipython.org/"
arch="noarch"
license="BSD-3-Clause"
depends="
	py3-backcall
	py3-decorator
	py3-jedi
	py3-matplotlib-inline
	py3-pexpect
	py3-pickleshare
	py3-prompt_toolkit<3.1.0
	py3-psutil
	py3-pygments
	py3-stack_data
	py3-traitlets
	"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="
	bash
	py3-matplotlib
	py3-pytest<8.0.0
	py3-testpath
	"
options="!check" # requires pytest<8.0.0
subpackages="$pkgname-doc $pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/ipython/ipython/archive/$pkgver.tar.gz"

# secfixes:
#   7.31.1-r0:
#     - CVE-2022-21699

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer  .dist/*.whl
	.testenv/bin/python3 -m pytest \
		--deselect=IPython/terminal/tests/test_help.py::test_trust_help \
		--deselect=IPython/core/tests/test_display.py::test_set_matplotlib_formats_kwargs
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
edbf0ea2fea66f4f0e077d00a6a08763dcad03b394cd55b8b86161b2783ab95f21c28482409fa41bd2ef575d6c24c162de967c02e3d9fd3c32edf51891e94b9f  ipython-9.16.0.tar.gz
"
