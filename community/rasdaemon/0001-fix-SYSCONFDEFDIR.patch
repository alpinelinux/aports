From 02ff04875a6583f1bcf03e081f886b7234eab238 Mon Sep 17 00:00:00 2001
From: Henrik Riomar <henrik.riomar@gmail.com>
Date: Sun, 25 Oct 2026 20:13:01 +0100
Subject: [PATCH] fix SYSCONFDEFDIR

---
 meson.build | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 87b38a9..1199b67 100644
--- a/meson.build
+++ b/meson.build
@@ -50,7 +50,7 @@ prefix  = get_option('prefix')
 libdir  = get_option('libdir')
 datadir = get_option('datadir')
 
-rasdaemon_env = prefix / get_option('sysconfdir') / 'sysconfig' / 'rasdaemon'
+rasdaemon_env = prefix / get_option('sysconfdir') / 'ras' / 'rasdaemon'
 
 py = import('python').find_installation('python3')
 
@@ -495,7 +495,7 @@ conf_data = {
     'sysconfdir' : prefix / get_option('sysconfdir'),
     'localstatedir' : prefix / get_option('localstatedir'),
     'sbindir' : prefix / get_option('sbindir'),
-    'SYSCONFDEFDIR' : prefix / get_option('sysconfdir') / 'sysconfig',
+    'SYSCONFDEFDIR' : prefix / get_option('sysconfdir') / 'ras',
 
     'META_DATE' : run_command('date', '+%d %B %Y', check: true).stdout().strip(),
     'META_ALIAS' : meson.project_name(),
-- 
2.56.0

