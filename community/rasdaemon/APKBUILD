b538a2b069df56f9384afcb20416d6939842fe1b16d2b4df167c38c6a36b17abc434e8e391361592c8e6df6986f96e26be362f226cdd39683319b1f9f6055482  rasdaemon.initd
a79cf91ad34874827bf88e9f66b1a831f890973faa07f04841d4c47f4e4642da2427a730744aa4e04117e973e87eb6088c418686bc63fdb14b2a32a4b3f4a4f0  0001-fix-SYSCONFDEFDIR.patch
"
