# Contributor: Henrik Riomar <henrik.riomar@gmail.com>
# Maintainer: Henrik Riomar <henrik.riomar@gmail.com>
pkgname=rasdaemon
pkgver=1.0.0
pkgrel=0
pkgdesc="utility to receive RAS error tracings"
url="https://github.com/mchehab/rasdaemon"
arch="x86_64"
license="GPL-2.0-or-later"
depends="
	dmidecode
	perl
	perl-dbd-sqlite
	"
makedepends="
	argp-standalone
	bsd-compat-headers
	libtraceevent-dev
	linux-headers
	meson
	pciutils-dev
	samurai
	sqlite-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-openrc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"

# no more -dev subpackage
replaces="$pkgname-dev"
provides="$pkgname-dev=$pkgver-r$pkgrel"

source="$pkgname-$pkgver.tar.gz::https://github.com/mchehab/rasdaemon/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	0001-fix-SYSCONFDEFDIR.patch
	"

build() {
	abuild-meson \
		-Dc_std=gnu11 \
		-Dc_args="-Dusleep=usleep -include unistd.h -include time.h" \
		-Dc_link_args="-largp" \
		-Dabrt-report=enabled \
		-Daer=enabled \
		-Damp-ns-decode=disabled \
		-Dampere-oem-sel=disabled \
		-Darm=disabled \
		-Ddevlink=enabled \
		-Ddiskerror=enabled \
		-Dextlog=enabled \
		-Dhisi-ns-decode=disabled \
		-Djaguar-ns-decode=disabled \
		-Dmce=enabled \
		-Dmemory-failure=enabled \
		-Dmysql=disabled \
		-Dnvidia-ns-decode=disabled \
		-Dopenbmc-unified-sel=disabled \
		-Dpostgresql=disabled \
		-Dreri=disabled \
		-Dsqlite3=enabled \
		-Dyitian-ns-decode=disabled \
		output

	ninja -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -m644 -D "$srcdir"/$pkgname-$pkgver/misc/rasdaemon.env \
		"$pkgdir"/etc/ras/rasdaemon

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname

	# Wipe Python bytecode caching directory
	find "$pkgdir" -name "__pycache__" -type d -exec rm -rf {} +

	rm -rf "$pkgdir"/etc/sysconfig
	rm -rf "$pkgdir"/usr/lib/systemd
}

