d82efceb6a0047a9683446ce96ab4f2bc0b61d2fd9d58d1973c2d2e876ff0bae05fc89737a1bcdbd1894d6c11eeab4fd07fe6aa445454a64aefcb8d58b5919c4  gemspec.patch
"
