# Maintainer: kpcyrd <git@rxv.cc>
pkgname=wasm-bindgen
pkgver=0.2.126
pkgrel=0
pkgdesc="Interoperating JS and Rust code"
url="https://github.com/rustwasm/wasm-bindgen"
arch="all"
license="Apache-2.0"
depends="cargo nodejs rust-wasm"
makedepends="
	cargo-auditable
	"
source="https://github.com/wasm-bindgen/wasm-bindgen/archive/refs/tags/$pkgver/wasm-bindgen-$pkgver.tar.gz
	Cargo.lock
	tests.patch
	"
options="net"

prepare() {
	# https://github.com/rustwasm/wasm-bindgen/issues/1819
	cp "$srcdir/Cargo.lock" .

	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cd crates/cli
	cargo auditable build --release --frozen
}

check() {
	cd crates/cli

	case "$CARCH" in
	arm*|s390x|x86)
		RUSTFLAGS= \
		cargo test --frozen \
			--no-fail-fast \
			|| true # FIXME most tests fail
		;;
	*)
		RUSTFLAGS= \
		cargo test --frozen -- \
			--skip no_duplicate_wasm_export_in_node_esm_atomics_debug \
			--skip runtest_panic_unwind \
			--skip termination_abort_handler \
			--skip termination_reinit \
			--skip wasi_target_has_no_placeholder_imports_panic_unwind \
			--skip test_05_async_number_rs \
			--skip test_06_async_void_rs \
			--skip test_08_closures_rs \
			--skip test_21_function_attrs_rs \
			--skip test_49_wasm_export_colon_rs
		# the above tests make use of the -Z flag, only available in rust nightly
		# tests named test_??_*_rs are broken upstream due to rust 1.97.0 changing mangling schemes
	esac
}

package() {
	install -Dm755 -t "$pkgdir"/usr/bin \
		target/release/wasm-bindgen \
		target/release/wasm-bindgen-test-runner \
		target/release/wasm2es6js
}

