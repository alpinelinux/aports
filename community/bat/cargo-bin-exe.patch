Locate the bat binary with CARGO_BIN_EXE_bat

Cargo 1.100 places test binaries in a separate build directory, so
the binary is no longer next to the parent of the test executable.

--- a/tests/tester/mod.rs
+++ b/tests/tester/mod.rs
@@ -1,4 +1,3 @@
-use std::env;
 use std::fs::{self, File};
 use std::io::Read;
 use std::path::{Path, PathBuf};
@@ -53,16 +52,7 @@
     fn default() -> Self {
         let temp_dir = create_sample_directory().expect("sample directory");
 
-        let root = env::current_exe()
-            .expect("tests executable")
-            .parent()
-            .expect("tests executable directory")
-            .parent()
-            .expect("bat executable directory")
-            .to_path_buf();
-
-        let exe_name = if cfg!(windows) { "bat.exe" } else { "bat" };
-        let exe = root.join(exe_name);
+        let exe = PathBuf::from(env!("CARGO_BIN_EXE_bat"));
 
         BatTester { temp_dir, exe }
     }
