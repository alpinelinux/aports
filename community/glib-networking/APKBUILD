# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/gnome <kboykinov@teamcentrixx.com>"
pkgname=glib-networking
pkgver=2.90.0
pkgrel=0
# NOTE: Upgrade only to even-numbered versions (e.g. 1.18.x, 1.20.x)!
pkgdesc="Networking support for GLib"
url="https://gitlab.gnome.org/GNOME/glib-networking"
arch="all"
license="LGPL-2.0-or-later"
depends="ca-certificates gsettings-desktop-schemas"
makedepends="
	bash
	glib-dev
	gnutls-dev
	gsettings-desktop-schemas-dev
	libgcrypt-dev
	libproxy-dev
	meson
	p11-kit-dev
	"
subpackages="$pkgname-dbg $pkgname-lang $pkgname-systemd"
source="https://download.gnome.org/sources/glib-networking/${pkgver%.*}/glib-networking-$pkgver.tar.xz"
options="!check" # new p11-kit makes a few of these fail, run them next release

# secfixes:
#   2.64.3-r0:
#     - CVE-2020-13645

build() {
	abuild-meson \
		-Db_lto=true \
		-Dopenssl=disabled \
		-Dgnutls=enabled \
		. build
	meson compile -C build
}

check() {
	meson test --print-errorlogs -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
a94c5d0e9775cf7d6bf1cfd6132ff2bb90ec53915bf169d59548fe6a914007837a9a139d2aee8c562006c53e78ddf74b0279c542c10c95cd9ae8929c4af4e46e  glib-networking-2.90.0.tar.xz
"
