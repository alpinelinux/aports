252915ca3244e98ab071ad734dec76b36b31269204dc34ad8bb9c8ce7d6e5b00b890f7c3d5b2e0d5b3560bc380d956c92d3f925bf2eee270fd37a11cb121ebcd  0001-contrib-lx-jgmenu-lx.c-adjust-rtrim-per-src-util.-ch.patch
"
