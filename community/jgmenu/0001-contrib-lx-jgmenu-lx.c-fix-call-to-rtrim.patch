From 4bbf3a2ce181a9d01a7c1442bf55f8d44fcb1c53 Mon Sep 17 00:00:00 2001
From: Johan Malm <jgm323@gmail.com>
Date: Fri, 18 Sep 2026 20:00:14 +0100
Subject: [PATCH] contrib/lx/jgmenu-lx.c: fix call to rtrim()

...following recent refactoring.

Fixes: #273
---
 contrib/lx/jgmenu-lx.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/contrib/lx/jgmenu-lx.c b/contrib/lx/jgmenu-lx.c
index 5d00d90..f6e8c65 100644
--- a/contrib/lx/jgmenu-lx.c
+++ b/contrib/lx/jgmenu-lx.c
@@ -96,13 +96,13 @@ static void add_metadata(const char * const *categories)
 	}
 }
 
-static void strip_exec_field_codes(char **exec)
+static void strip_exec_field_codes(char *exec)
 {
 	char *p;
 
-	if (!**exec || !*exec)
+	if (!*exec || !exec)
 		return;
-	for (p = *exec; *p; p++) {
+	for (p = exec; *p; p++) {
 		if (*p == '%') {
 			*p = ' ';
 			++p;
@@ -154,7 +154,7 @@ static void process_app(MenuCacheApp *app)
 	if (strchr(exec.buf, ','))
 		sbuf_addstr(&cur->buf, "\"\"\"");
 	ugly_hack(&exec);
-	strip_exec_field_codes(&exec.buf);
+	strip_exec_field_codes(exec.buf);
 	sbuf_addstr(&cur->buf, exec.buf);
 	if (strchr(exec.buf, ','))
 		sbuf_addstr(&cur->buf, " \"\"\"");
-- 
