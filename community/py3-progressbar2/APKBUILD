# Contributor: Marian Buschsieweke <marian.buschsieweke@posteo.net>
maintainer="Marian Buschsieweke <marian.buschsieweke@posteo.net>"
pkgname=py3-progressbar2
_pkgname=progressbar2
pkgver=4.6.0
pkgrel=0
pkgdesc="Text progress bar library for Python"
url="https://github.com/WoLpH/python-progressbar"
arch="noarch"
license="BSD-3-Clause"
depends="python3 py3-utils py3-freezegun"
makedepends="
	py3-gpep517
	py3-setuptools
	"
checkdepends="
	py3-dill
	py3-pytest
	py3-pytest-cov
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

replaces="py-progressbar" # for backwards compatibility
provides="py-progressbar=$pkgver-r$pkgrel" # for backwards compatibility


build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	local testflags
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# disable overhead test that is flaky on simulated hardware or when system
	# is under load:
	testflags="--deselect tests/test_fastpath.py::test_iterator_overhead_is_low"

	case $CARCH in
		s390x)
			testflags="$testflags --deselect tests/test_readme_demos.py::test_every_demo_animates_across_at_least_two_frames"
			;;
	esac

	# shellcheck disable=SC2086 # intionally splitting $testflags
	.testenv/bin/python3 -m pytest \
		--cov-fail-under 0 \
		$testflags
}

package() {
	gpep517 install-wheel --destdir "$pkgdir" \
		.dist/*.whl
}

sha512sums="
c5c60867fa46a2d1828d6cacef06b1d6b41563aa5e3e188b312b74a7dd745b89ad4c11b7147dd02d9a8ab8a80d2c366ca7348dcb9a677e2efe91dd4fa2dbd3bf  progressbar2-4.6.0.tar.gz
"
