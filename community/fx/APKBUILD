# Contributor: tetsumaki <yd-alpine@tetsumaki.net>
# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=fx
pkgver=40.0.1
pkgrel=1
pkgdesc="Command-line tool and terminal JSON viewer"
url="https://github.com/antonmedv/fx"
arch="all"
license="MIT"
makedepends="go"
subpackages="$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
options="net" # go
source="$pkgname-$pkgver.tar.gz::https://github.com/antonmedv/fx/archive/refs/tags/$pkgver.tar.gz"

build() {
	go build -v .

	for shellcomp in bash fish zsh; do
		./"$pkgname" --comp  "$shellcomp" > "$pkgname"."$shellcomp"
	done
}

check() {
	go test ./...
}

package() {
	install -Dvm0755 fx -t "$pkgdir"/usr/bin/

	install -Dvm0644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/

	install -Dm0644 "$pkgname".bash \
		"$pkgdir"/usr/share/bash-completion/completions/"$pkgname"
	install -Dm0644 "$pkgname".fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/"$pkgname".fish
	install -Dm0644 "$pkgname".zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_"$pkgname"
}

sha512sums="
c4daacd98c6a26aebc51bf547107887c65bda3ebb6772c512af6b372e1e6932f49f1bef447e6e17ad614a6d7b8395efb31deb350c607a63e288a5c8f828846e2  fx-40.0.1.tar.gz
"
