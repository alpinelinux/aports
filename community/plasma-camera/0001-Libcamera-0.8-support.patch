From 8c2170153b7c9ed1bbf5e9fe81b3491887e29790 Mon Sep 17 00:00:00 2001
From: Robert Mader <robert.mader@collabora.com>
Date: Sun, 1 Nov 2026 16:42:11 +0100
Subject: [PATCH] Libcamera 0.8 support

Some enums changed their names - support both the new and the old ones.

(cherry picked from commit 7faa4d51fb38b6734111297adaf25232f471bdd8)
---
 src/plasmacamera.cpp      | 4 ++++
 src/plasmacameramanager.h | 1 +
 2 files changed, 5 insertions(+)

diff --git a/src/plasmacamera.cpp b/src/plasmacamera.cpp
index c67502c9b60c..f19d1728f863 100644
--- a/src/plasmacamera.cpp
+++ b/src/plasmacamera.cpp
@@ -627,7 +627,11 @@ bool PlasmaCamera::acquire()
 
     // Find whether the camera output needs to be mirrored (ex. selife cam)
     std::optional<int> location = m_camera->properties().get(libcamera::properties::Location);
+#if LIBCAMERA_VERSION_MAJOR > 0 || (LIBCAMERA_VERSION_MAJOR == 0 && LIBCAMERA_VERSION_MINOR >= 8)
+    m_mirrorOutput = location.value_or(libcamera::properties::LocationExternal) == libcamera::properties::LocationFront;
+#else
     m_mirrorOutput = location.value_or(libcamera::properties::CameraLocationExternal) == libcamera::properties::CameraLocationFront;
+#endif
 
     return true;
 }
diff --git a/src/plasmacameramanager.h b/src/plasmacameramanager.h
index c890c172054b..e9775f28fdc1 100644
--- a/src/plasmacameramanager.h
+++ b/src/plasmacameramanager.h
@@ -11,6 +11,7 @@
 
 #include <libcamera/libcamera.h>
 #include <libcamera/camera_manager.h>
+#include <libcamera/version.h>
 
 #include "plasmacamera.h"
 
-- 
