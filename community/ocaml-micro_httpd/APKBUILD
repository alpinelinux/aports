# Maintainer: Kate <kit-ty-kate@exn.st>
pkgname=ocaml-micro_httpd
_pkgname=micro_httpd
pkgver=0.20.1
pkgrel=0
pkgdesc="A no dependency HTTP file server in OCaml"
url="https://codeberg.org/kit-ty-kate/micro_httpd"
arch="all"
license="MIT"
makedepends="dune ocaml"
subpackages="$pkgname-doc"
source="https://codeberg.org/kit-ty-kate/micro_httpd/releases/download/$pkgver/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

case "$CARCH" in
	riscv64|loongarch64)
		makedepends="${makedepends//ocaml/ocaml5}"
		;;
esac

build() {
	dune build --release --verbose
}

check() {
	dune runtest --verbose
}

package() {
	dune install --sections=bin --destdir="$pkgdir/usr"
	install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}

sha512sums="
c807361408610f5a29c31965f71ae2e5837001f5edd2b01feb60598a603c1d0b21de5d656b2bd33eba8c5900aa89784c4d964aee2032503b16dbac1e360e35ef  micro_httpd-0.20.1.tar.gz
"
