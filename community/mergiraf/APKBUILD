80ba290a5aefb3a42ded35459f5ddbca94710dcb71f31d372db54a1c80ed0f20b77aec95f39f731a6800c23920be6cca0abbd1ddd93289f1507bf438995ff6d8  helpers-README
d6681e99e8de3cb92beefe09ddb8b423f5157bbbb690b52f4aff341f68ab7c3c831c44c8a1e8bd19b7ce5003107b219a932901d87c803f23b5225a7159252690  update-rustix-crate.patch
"
