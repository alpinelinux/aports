maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=py3-pynitrokey
pkgver=0.14.0
pkgrel=0
pkgdesc="Python Library for Nitrokey devices"
url="https://github.com/Nitrokey/pynitrokey"
arch="all"
license="Apache-2.0 AND MIT"
depends="
	nitrokey-udev-rules
	py3-click
	py3-click-aliases
	py3-cryptography
	py3-fido2
	py3-intelhex
	py3-libusb1
	py3-nethsm
	py3-nitrokey
	py3-nkdfu
	py3-pyserial
	py3-requests
	py3-semver
	py3-tlv8
	py3-tqdm
	py3-typing-extensions
	"
makedepends="
	poetry
	py3-gpep517
	py3-installer
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://pypi.python.org/packages/source/p/pynitrokey/pynitrokey-$pkgver.tar.gz"
options="!check" # Are integration tests only
builddir="$srcdir/pynitrokey-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
a2a4c9f03db072304c49fecb77a8a9a8c912515a9a10f6eb1898e9c5c71027378f95df6ca0d5386accc716c9dea5e736e91bd78dd6fecef90817cfff85e02e91  pynitrokey-0.14.0.tar.gz
"
