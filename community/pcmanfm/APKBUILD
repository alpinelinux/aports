# Contributor: Bartłomiej Piotrowski <bpiotrowski@alpinelinux.org>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=pcmanfm
pkgver=1.4.0
pkgrel=0
pkgdesc="Extremely fast and lightweight file manager"
arch="all"
url="https://github.com/lxde/pcmanfm"
license="GPL-2.0-or-later"
makedepends="automake autoconf gtk+3.0-dev libfm-dev libfm-extra-dev intltool"
subpackages="$pkgname-doc $pkgname-lang"
source="pcmanfm-$pkgver.tar.gz::https://github.com/lxde/pcmanfm/archive/refs/tags/$pkgver.tar.gz"

# secfixes:
#   1.2.5-r1:
#     - CVE-2017-8934

build() {
	autoreconf -fvi
	./configure \
		--sysconfdir=/etc \
		--prefix=/usr \
		--with-gtk=3
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install

	sed -i 's|x-directory/normal|inode/directory|' \
		"$pkgdir"/usr/share/applications/pcmanfm.desktop
}

sha512sums="
87192134e18a7d6e9755b65f7d72910854f6c2ddbc1e391449c992f0596dc4ddbf37925070b6e502afea49b95361939d4272156ef55be1731411593e91d4c5a5  pcmanfm-1.4.0.tar.gz
"
