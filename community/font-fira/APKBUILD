# Contributor: Dmitry Zakharchenko <dmitz@disroot.org>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=font-fira
pkgver=4.301
pkgrel=1
_monover=3.206
_monouver=${_monover//.2*/_2}
pkgdesc="Independent typeface originally drawn for Firefox OS"
url="https://carrois.com/fira/"
arch="noarch"
license="OFL-1.1"
options="!check" # no test suite
depends="$pkgname-otf $pkgname-mono-otf"
subpackages="
	$pkgname-otf
	$pkgname-ttf
	$pkgname-mono-otf:mono_otf
	$pkgname-mono-ttf:mono_ttf
	"
source="$pkgname-$pkgver.zip::https://carrois.com/downloads/Fira/Download_Folder_FiraSans_${pkgver/./}.zip
	$pkgname-mono-$_monover.zip::https://carrois.com/downloads/Fira/Fira_Mono_$_monouver.zip
	"
builddir="$srcdir"/Download_Folder_FiraSans_${pkgver/./}/Fonts
_monodir="$srcdir"/Fira_Mono_$_monouver/Fonts

package() {
	mkdir -p "$pkgdir"
}

otf() {
	pkgdesc="$pkgdesc (OTF version)"
	depends="fontconfig"

	mkdir -p "$subpkgdir"
	find "$builddir" -name "*.otf" -exec sh -c 'f="$1"; install -Dm644 "$f" \
		"$subpkgdir"/usr/share/fonts/OTF/$(basename "$f")' shell {} \;
}

ttf() {
	pkgdesc="$pkgdesc (TTF version)"
	depends="fontconfig"

	mkdir -p "$subpkgdir"
	find "$builddir" -name "*.ttf" -exec sh -c 'f="$1"; install -Dm644 "$f" \
		"$subpkgdir"/usr/share/fonts/TTF/$(basename "$f")' shell {} \;
}

mono_otf() {
	pkgdesc="$pkgdesc (Fira Mono, OTF version)"
	depends="fontconfig"

	mkdir -p "$subpkgdir"
	cd "$_monodir"
	find "$_monodir" -name "*.otf" -exec sh -c 'f="$1"; install -Dm644 "$f" \
		"$subpkgdir"/usr/share/fonts/OTF/$(basename "$f")' shell {} \;
}

mono_ttf() {
	pkgdesc="$pkgdesc (Fira Mono, TTF version)"
	depends="fontconfig"

	mkdir -p "$subpkgdir"
	cd "$_monodir"
	find "$_monodir" -name "*.ttf" -exec sh -c 'f="$1"; install -Dm644 "$f" \
		"$subpkgdir"/usr/share/fonts/TTF/$(basename "$f")' shell {} \;
}

sha512sums="
