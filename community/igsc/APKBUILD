1d508ca1765b4e0d3a0e2639516784d1cc5cd7a71bd436deb3750024365c0acf48fc267678da9d894d3e4ff99611870a7b8327b10aecd91e7edcaf83965bc0ec  cmocka2-fix.patch
"
