# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=libblockdev
pkgver=3.5.0
pkgrel=0
pkgdesc="Library for manipulating block devices"
url="https://github.com/storaged-project/libblockdev"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	bash
	coreutils
	cryptsetup-dev
	e2fsprogs-dev
	eudev-dev
	glib-dev
	gobject-introspection-dev
	json-glib-dev
	keyutils-dev
	kmod-dev
	libatasmart-dev
	libbytesize-dev
	libnvme-dev
	lvm2-dev
	ndctl-dev
	nss-dev
	parted-dev
	python3
	yaml-dev
	"
subpackages="$pkgname-dev py3-$pkgname:_py3:noarch"
source="https://github.com/storaged-project/libblockdev/releases/download/$pkgver/libblockdev-$pkgver.tar.gz
	fix-glibc-glob-onlydir.patch
	"

build() {
	CFLAGS="$CFLAGS -flto=auto -Wno-error" \
		./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--without-escrow
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

_py3() {
	pkgdesc="$pkgdesc - python3-bindings"

	amove usr/lib/python*
}

