8590ceaf0e0b45aa2e77fd4fed7ef84dc4f3bcffb7f1c58fdef944a481cea160ad932cf4ce862d34b69dc15c8e6344d80244b878cec1ac1d80c1ac4c5a5861e7  glib-2.0.patch
"
