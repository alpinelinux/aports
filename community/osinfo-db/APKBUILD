# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=osinfo-db
pkgver=20260812
pkgrel=0
pkgdesc="osinfo database files"
url="https://libosinfo.org/"
arch="noarch"
license="LGPL-2.0-or-later"
makedepends="osinfo-db-tools"
source="https://gitlab.com/libosinfo/osinfo-db/-/releases/v$pkgver/downloads/osinfo-db-$pkgver.tar.xz"

check() {
	osinfo-db-validate --dir "$builddir"
}

package() {
	osinfo-db-import --root "$pkgdir" \
		--dir /usr/share/osinfo "$srcdir"/osinfo-db-$pkgver.tar.xz
}

sha512sums="
