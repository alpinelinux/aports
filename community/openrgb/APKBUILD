maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=openrgb
pkgver=1.1
pkgrel=0
pkgdesc="Open source RGB lighting control that doesn't depend on manufacturer software"
url="https://gitlab.com/CalcProgrammer1/OpenRGB"
arch="all"
license="GPL-2.0-only"
makedepends="
	bash
	hidapi-dev
	libusb-dev
	mbedtls3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	"
subpackages="
	$pkgname-udev
	$pkgname-systemd
	"
source="https://gitlab.com/CalcProgrammer1/OpenRGB/-/archive/release_$pkgver/OpenRGB-release_$pkgver.tar.gz
	modules-load.conf
	openrgb.service
	openrgb.tmpfiles
	"
install="$pkgname.post-install"
builddir="$srcdir/OpenRGB-release_$pkgver"

build() {
	qmake6 PREFIX=/usr
	make
}

check() {
	make check
}

package() {
	INSTALL_ROOT="$pkgdir" make install

	mkdir -p "$pkgdir"/usr/lib/udev/rules.d
	./openrgb --generate-udev-rules "$pkgdir"/usr/lib/udev/rules.d/60-openrgb.rules

	install -Dm644 "$srcdir"/modules-load.conf "$pkgdir"/usr/lib/modules-load.d/openrgb.conf
	install -Dm644 "$srcdir"/openrgb.service "$pkgdir"/usr/lib/systemd/system/openrgb.service
	install -Dm644 "$srcdir"/openrgb.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/openrgb.conf
}

