# Maintainer: Wen Heping <wenhepingalpine@sohu.com>
pkgname=py3-beniget
pkgver=0.5.0
pkgrel=0
pkgdesc="Extract semantic information about static Python code"
url="https://github.com/serge-sans-paille/beniget"
arch="noarch"
license="BSD-3-Clause"
depends="py3-gast"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/serge-sans-paille/beniget/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/beniget-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
4c41faeb8d52637701297907d05e44784235d141c676b6a6165e22f244fb45a940da1b9a175b36d21a589be458ed562453bfbb2fe9f85475109ab9be9dc68b85  py3-beniget-0.5.0.tar.gz
"
