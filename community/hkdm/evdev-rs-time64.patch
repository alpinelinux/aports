@@ -254,7 +254,13 @@
         let ev_type = event.type_ as u32;
         let event_code = int_to_event_code(ev_type, event.code as u32);
         InputEvent {
+            #[cfg(not(all(target_env = "musl", target_pointer_width = "32")))]
