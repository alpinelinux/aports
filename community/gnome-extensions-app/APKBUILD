maintainer="team/gnome <achill@achill.org>"
pkgname=gnome-extensions-app
pkgver=51_alpha
_pkgver=${pkgver/_/.}
pkgrel=0
pkgdesc="Manage GNOME Shell extensions"
url="https://gitlab.gnome.org/GNOME/gnome-extensions-app"
arch="all !armhf" # gnome-shell
license="GPL-2.0-or-later"
depends="gnome-shell"
makedepends="
	gobject-introspection-dev
	gtk4.0-dev
	libadwaita-dev
	meson
	"
subpackages="$pkgname-lang"
source="https://download.gnome.org/sources/gnome-extensions-app/${_pkgver%.*}/gnome-extensions-app-$_pkgver.tar.xz"
builddir="$srcdir/$pkgname-$_pkgver"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
