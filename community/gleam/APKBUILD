# Contributor: rubicon <rubicon@mailo.com>
# Maintainer: Jingyun Hua <huajingyun@loongson.cn>
maintainer="Jingyun Hua <huajingyun@loongson.cn>"
pkgname=gleam
pkgver=1.19.2
pkgrel=0
pkgdesc="Statically-typed language that compiles to Erlang and JS"
url="https://gleam.run/"
# s390x: tests stack overflow
arch="all !s390x"
license="Apache-2.0"
depends="erlang-dev"
makedepends="
	cargo
	cargo-auditable
	"
checkdepends="
	elixir
	git
	nodejs
	rebar3
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/gleam-lang/gleam/archive/refs/tags/v$pkgver.tar.gz
	skip-bun-and-deno-case.patch
	update-rustix-ppc64le.patch
	"
options="net" # cargo fetch

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	local test_args="-- --skip type_::tests::no_stack_overflow_for_nested_use" # fails on builders, works locally
	case "$CARCH" in
	arm*|x86)
		test_args="$test_args
			--skip dependency::tests::resolution_with_optional_deps_explicitly_provided
			--skip dependency::tests::resolution_with_optional_deps_incompatible
			--skip dependency::tests::resolution_with_optional_deps_required_by_nested_deps
			"
		;;
	riscv64)
		# thread 'tests::echo::echo_dict' (29363) panicked at
		# test-output/src/tests/echo.rs:64:6: run setup: Http("error sending request
		# for url (https://hex.pm/api/packages/gleam_stdlib/releases/0.69.0)")
		test_args="$test_args
			--skip tests::echo::echo_dict
			"
		;;
	esac

	cargo test --frozen $test_args
}

package() {
	install -Dvm755 target/release/gleam -t "$pkgdir"/usr/bin/
}

