Fix build with sbcl 2.6.10, which warns about destructive functions
called on constant data. Use remove-duplicates as upstream does.

--- a/source/prompt-buffer.lisp
+++ b/source/prompt-buffer.lisp
@@ -709,7 +709,7 @@
        (error 'prompt-buffer-canceled)))))
 
 (sera:eval-always
-  (defvar %prompt-args (delete-duplicates
+  (defvar %prompt-args (remove-duplicates
                         (append
                          (public-initargs 'prompt-buffer)
                          (public-initargs 'prompter:prompter)
