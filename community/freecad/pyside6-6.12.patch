diff -Naur a/src/Gui/PythonWrapper.cpp b/src/Gui/PythonWrapper.cpp
--- a/src/Gui/PythonWrapper.cpp	2026-11-05 18:06:50.606797823 -0500
+++ b/src/Gui/PythonWrapper.cpp	2026-11-05 18:08:59.009320289 -0500
@@ -121,6 +121,9 @@
 
 #ifdef HAVE_PYSIDE
 # include <signalmanager.h>
+# if __has_include(<pyobjectwrapper.h>)
