From 745e750812e20b522a49ef47322b69b76d4a0968 Mon Sep 17 00:00:00 2001
From: Robert Mader <robert.mader@collabora.com>
Date: Sun, 1 Nov 2026 16:20:15 +0100
Subject: [PATCH] meson.build: Bump cpp_std to c++20 for libcamera 0.8 support

---
 meson.build | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/meson.build b/meson.build
index 7b0bbde2653a..cd2067b4dbed 100644
--- a/meson.build
+++ b/meson.build
@@ -1,6 +1,6 @@
 project('millipixels', 'c', 'cpp', 'rust',
     version: '0.24.0',
-    default_options: ['cpp_std=c++17']) # C++ doesn't seem to take effect
+    default_options: ['cpp_std=c++20'])
 bsd = dependency('libbsd')
 camera = dependency('libcamera')
 gnome = import('gnome')
@@ -69,7 +69,6 @@ executable('millipixels',
 	   include_directories: dbus_inc,
            install : true,
            link_with: [rust_lib],
-           override_options : ['cpp_std=c++17'],
 )
 
 executable('movie_audio_rec',
@@ -146,8 +145,7 @@ executable('millipixels-camera-test',
     'camera.c',
     'device.c',
     'src/libcam.cpp',
-    dependencies: [camera, gtkdep], install: true,
-    override_options : ['cpp_std=c++17'],)
+    dependencies: [camera, gtkdep], install: true)
 
 test_quickpreview = executable('test_quickpreview',
     'tests/test_quickpreview.c',
@@ -155,6 +153,5 @@ test_quickpreview = executable('test_quickpreview',
     'camera.c',
     'matrix.c',
     'src/libcam.cpp',
-    dependencies: [camera, gtkdep],
-    override_options : ['cpp_std=c++17'],)
+    dependencies: [camera, gtkdep])
 #test('quickpreview', test_quickpreview)
-- 
2.56.0

