From 60c8d971a80407841f23727d4ae3471251cb462a Mon Sep 17 00:00:00 2001
From: John Vogel <jvogel@stygian.me>
Date: Wed, 9 Sep 2026 01:42:54 -0400
Subject: [PATCH] Revert "Read up to 32K when reading a terminfo entry from a
 file"

This reverts commit 1436391cc8192c35ba90910948921c6a1a02cf56.
---
 doc/unibi_from_fd.pod | 2 +-
 doc/unibi_from_fp.pod | 2 +-
 uniutil.c             | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/doc/unibi_from_fd.pod b/doc/unibi_from_fd.pod
index 4a9394a..8221a78 100644
--- a/doc/unibi_from_fd.pod
+++ b/doc/unibi_from_fd.pod
@@ -12,7 +12,7 @@ unibi_from_fd - read a terminfo entry from a file descriptor
 
 =head1 DESCRIPTION
 
-This function reads up to 32768 bytes from I<fd>, then calls C<unibi_from_mem>.
+This function reads up to 4096 bytes from I<fd>, then calls C<unibi_from_mem>.
 
 =head1 RETURN VALUE
 
diff --git a/doc/unibi_from_fp.pod b/doc/unibi_from_fp.pod
index 0baab30..83a1940 100644
--- a/doc/unibi_from_fp.pod
+++ b/doc/unibi_from_fp.pod
@@ -12,7 +12,7 @@ unibi_from_fp - read a terminfo entry from a FILE *
 
 =head1 DESCRIPTION
 
-This function reads up to 32768 bytes from I<fp>, then calls C<unibi_from_mem>.
+This function reads up to 4096 bytes from I<fp>, then calls C<unibi_from_mem>.
 
 =head1 RETURN VALUE
 
diff --git a/uniutil.c b/uniutil.c
index 3a48886..e362318 100644
--- a/uniutil.c
+++ b/uniutil.c
@@ -43,7 +43,7 @@ along with unibilium.  If not, see <http://www.gnu.org/licenses/>.
 #error "internal error: TERMINFO_DIRS is not defined"
 #endif
 
-enum {MAX_BUF = 32768};
+enum {MAX_BUF = 4096};
 
 const char *const unibi_terminfo_dirs = TERMINFO_DIRS;
 const char *const unibi_terminfo = TERMINFO;
-- 
2.55.0

