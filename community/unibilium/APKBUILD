# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: John Vogel <jvogel@stygian.me>
maintainer="John Vogel <jvogel@stygian.me>"
pkgname=unibilium
pkgver=2.1.4
pkgrel=0
pkgdesc="Terminfo parsing library"
url="https://github.com/neovim/unibilium"
arch="all"
license="LGPL-3.0-or-later"
makedepends="
	autoconf
	automake
	libtool
	perl
	"
checkdepends="perl-utils"
subpackages="
	$pkgname-dev
	$pkgname-doc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/neovim/unibilium/archive/v$pkgver.tar.gz"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--mandir=/usr/share/man

	make PREFIX=/usr
}

check() {
	make test
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
}

sha512sums="
e1d351b7f4c13825c415f3b8078abd538863614a8aa443e3c5e5b85110372084ff4385c4b17eb7a546807188265285ca4b6493b6db9670d490f7743b89f11c4f  unibilium-2.1.4.tar.gz
"
