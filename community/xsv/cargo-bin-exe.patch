Locate the xsv binary with CARGO_BIN_EXE_xsv

Cargo 1.100 places test binaries in a separate build directory, so
the binary is no longer next to the parent of the test executable.

--- a/tests/workdir.rs
+++ b/tests/workdir.rs
@@ -143,7 +143,7 @@
     }
 
     pub fn xsv_bin(&self) -> PathBuf {
-        self.root.join("xsv")
+        PathBuf::from(env!("CARGO_BIN_EXE_xsv"))
     }
 }
 
