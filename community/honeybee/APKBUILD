# Contributor: Anjandev Momi <anjan@momi.ca>
# Maintainer: Anjandev Momi <anjan@momi.ca>
pkgname=honeybee
pkgver=0.3.1_git20260529
_commit=bce98f40326c2f4a4f7e41f3a821ef2d8b837c6e
pkgrel=0
pkgdesc="make calls on linux using borogove sdk"
url="https://sr.ht/~anjan/honeybee"
arch="aarch64 x86_64" # Limited by zig aport
license="AGPL-3.0-only"
makedepends="zig scdoc borogove-sdk libstrophe libdatachannel pulseaudio-dev"
subpackages="$pkgname-doc"
source="
	$pkgname-$_commit.tar.gz::https://git.sr.ht/~anjan/honeybee/archive/$_commit.tar.gz
	0001-Zig-0.17-Update-build.zig.patch
	0002-Zig-0.17-Migrate-from-cImport-to-translate-c.patch
	"
options="!tracedeps !check !strip" # no checks, dont strip so upstream has stack traces to debug
builddir="$srcdir/honeybee-$_commit"

# We may want other than "baseline" for other targets, when enabled by zig
case "$CARCH" in
	aarch64|x86_64) _cputarget=baseline ;;
esac

build() {
	# This installs it to $builddir/out
	DESTDIR="$builddir/out" zig build \
		-Doptimize=ReleaseSafe \
		--prefix /usr install \
		${cputarget:+-Dcpu="$cputarget"}
}

package() {
	mkdir -p "$pkgdir"
	cp -r out/* "$pkgdir"
}

