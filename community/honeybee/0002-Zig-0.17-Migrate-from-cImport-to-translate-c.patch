From 5a0bca4154b0693e29bced464b89eba1d4d94a6c Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Mon, 5 Oct 2026 02:37:35 +0200
Subject: [PATCH] Zig 0.17: Migrate from @cImport to translate-c

---
 .gitignore                    |  1 +
 build.zig                     | 23 ++++++++++++++++++++++-
 build.zig.zon                 |  7 ++++++-
 src/honeybee/snikket_call.zig |  4 ++--
 src/honeybee/state.zig        |  2 +-
 5 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/.gitignore b/.gitignore
index a465b75..035d4fc 100644
--- a/.gitignore
+++ b/.gitignore
@@ -11,6 +11,7 @@
 
 .zig-cache/
 zig-out/
+zig-pkg/
 /release/
 /debug/
 /build/
diff --git a/build.zig b/build.zig
index adfcc8d..4159dbe 100644
--- a/build.zig
+++ b/build.zig
@@ -1,4 +1,5 @@
 const std = @import("std");
+const Translator = @import("translate_c").Translator;
 
 pub fn build(b: *std.Build) !void {
     const target = b.standardTargetOptions(.{});
@@ -21,9 +22,27 @@ pub fn build(b: *std.Build) !void {
         }
     }
 
+    const audio_be = Translator.init(b.dependency("translate_c", .{}), .{
+        .c_source_file = b.path("src/honeybee/pulse_c/audio_be.h"),
+        .target = target,
+        .optimize = optimize,
+    });
+
+    const borogove = Translator.init(b.dependency("translate_c", .{}), .{
+        .c_source_file = b.addWriteFiles().add("trans_borogove.h",
+            \\#include <borogove.h>
+        ),
+        .target = target,
+        .optimize = optimize,
+    });
+
     // module build
     const mod = b.addModule("libhoneybee", .{
-        .root_source_file = b.path("src/lib/root.zig")
+        .root_source_file = b.path("src/lib/root.zig"),
+        .imports = &.{
+            .{ .name = "audio_be", .module = audio_be.mod },
+            .{ .name = "borogove", .module = borogove.mod },
+        },
     });
 
     // daemon build
@@ -33,6 +52,8 @@ pub fn build(b: *std.Build) !void {
             .root_source_file = b.path("src/honeybee/main.zig"),
             .imports = &.{
                 .{ .name = "libhoneybee", .module = mod},
+                .{ .name = "audio_be", .module = audio_be.mod },
+                .{ .name = "borogove", .module = borogove.mod },
             },
             .target = target,
             .optimize = optimize,
diff --git a/build.zig.zon b/build.zig.zon
index a1049aa..fc400db 100644
--- a/build.zig.zon
+++ b/build.zig.zon
@@ -4,7 +4,12 @@
     .fingerprint = 0xc83411c466f9c1,
     .minimum_zig_version = "0.16.0",
 
-    .dependencies = .{},
+    .dependencies = .{
+        .translate_c = .{
+            .url = "git+https://codeberg.org/ziglang/translate-c.git?ref=2.0.0#0da7a16c3235b935b82421646076e0657cda21f6",
+            .hash = "translate_c-2.0.0-Q_BUWltOBwA0229IE8wwSxxGzOxyRso3hvcb1nN8oJX_",
+        },
+    },
 
     .paths = .{
         "README.md",
diff --git a/src/honeybee/snikket_call.zig b/src/honeybee/snikket_call.zig
index 2e5d71c..505a0d1 100644
--- a/src/honeybee/snikket_call.zig
+++ b/src/honeybee/snikket_call.zig
@@ -1,8 +1,8 @@
 const std = @import("std");
 const CallStatus = @import("libhoneybee").state.CallStatus;
 
-const s_api = @cImport(@cInclude("borogove.h"));
-const a_be_c = @cImport(@cInclude("audio_be.h"));
+const s_api = @import("borogove");
+const a_be_c = @import("audio_be");
 
 const StateChange = @import("state.zig").StateChange;
 const CallbackFifo = @import("state.zig").CallbackFifo;
diff --git a/src/honeybee/state.zig b/src/honeybee/state.zig
index 450874f..1b3aa44 100644
--- a/src/honeybee/state.zig
+++ b/src/honeybee/state.zig
@@ -1,5 +1,5 @@
 const std = @import("std");
-const s_api = @cImport(@cInclude("borogove.h"));
+const s_api = @import("borogove");
 const SocketService = @import("socket_service.zig");
 const s_call = @import("snikket_call.zig");
 const state_common = @import("libhoneybee").state;
