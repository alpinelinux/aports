# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kquickimageeditor
pkgver=0.7.0.1
pkgrel=1
pkgdesc="Simple image editor for QtQuick applications"
url="https://invent.kde.org/libraries/kquickimageeditor"
# armhf blocked by qt6-qtdeclarative
# s390x blocked by opencv
arch="all !armhf !s390x"
license="BSD-2-Clause AND LGPL-2.1-or-later"
depends_dev="
	highway-dev
	kconfig-dev
	opencv-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	"
makedepends="$depends_dev
	clang
	extra-cmake-modules
	qt6-qtdeclarative-private-dev
	samurai
	"
subpackages="$pkgname-dev"
source="https://download.kde.org/stable/kquickimageeditor/kquickimageeditor-$pkgver.tar.xz"
options="!check" # No tests

build() {
	# TODO remove clang when using gcc 16
	CC=clang CXX=clang++ \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
9ff467c2cb46c4559d4aeed815bbbaa2407d89493d01679a23cfb9683e196fd9b2842241c306423ed272042e45c945b133197d51abdba158000ed5afd1b3d4e3  kquickimageeditor-0.7.0.1.tar.xz
"
