33bf3d22f61cf35faa71313d3fe1bc177eadd0fc911e740bb52f6b962071edf14182c5eaf7d401cc76d304ee7ecea0277f7d43200b30f7e6f505606bd3ceaa30  disable-updatecheck.patch
"
