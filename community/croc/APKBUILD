1d5f07a61651cd02a241b6f79100ddd28e27d9d0d2e74a2c70114dc0262eb1db89e0659980578bb1d6233b9bd0f5e8e7bf1de308f9ea96f2718c458c07f04bd8  disable-updatecheck.patch
"
