# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=rustup
pkgver=1.29.1
pkgrel=0
pkgdesc="Rust toolchain installer"
url="https://rustup.rs/"
arch="all"
license="Apache-2.0"
makedepends="
	cargo
	cargo-auditable
	curl-dev
	openssl-dev>3
	perl
	zlib-dev
	zstd-dev
	"
options="net !check" # FIXME tests fail on CI
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/rust-lang/rustup.rs/archive/$pkgver.tar.gz
	dont-copy-rustup-bin.patch
	system.patch
	test-triple.patch
	nix-upgrade.patch
	update-rustix-crate.patch
	"

# It doesn't like our custom triplet
case "$CHOST" in
armv6-*) export RUSTUP_OVERRIDE_BUILD_TUPLE="${CHOST/v6-alpine-/-unknown-}" ;;
riscv64-*) export RUSTUP_OVERRIDE_BUILD_TUPLE="${CHOST/-alpine-/gc-unknown-}" ;;
*) export RUSTUP_OVERRIDE_BUILD_TUPLE="${CHOST/-alpine-/-unknown-}" ;;
esac

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	# removes reqwest-rustls-tls feature and adds no-self-update
	cargo auditable build --release --frozen \
		--no-default-features \
		--features no-self-update,curl-backend,reqwest-native-tls \
		--bin rustup-init

	ln -s target/release/rustup-init rustup
	./rustup completions zsh > rustup.zsh
	./rustup completions bash > rustup.bash
	./rustup completions fish > rustup.fish
}

check() {
	cargo test --frozen --features test
}

package() {
	install -Dm755 target/release/rustup-init -t "$pkgdir"/usr/bin/

	install -Dm644 rustup.bash \
		"$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm644 rustup.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
	install -Dm644 rustup.zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_$pkgname
}

