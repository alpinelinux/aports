# Contributor: Jake Buchholz Göktürk <tomalok@gmail.com>
# Maintainer: Jake Buchholz Göktürk <tomalok@gmail.com>
pkgname=libpathrs
pkgver=0.2.6
pkgrel=0
pkgdesc="C-friendly API for safe path resolution on Linux"
url="https://github.com/cyphar/libpathrs"
arch="all"
license="MPL-2.0 OR LGPL-3.0-or-later"
makedepends="bash cargo cargo-auditable clang lld pkgconf zstd"
subpackages="$pkgname-dev"
source="
	libpathrs-$pkgver.tar.xz::https://github.com/cyphar/libpathrs/releases/download/v$pkgver/libpathrs-$pkgver.tar.xz
	libpathrs-$pkgver.vendor.tar.zst::https://github.com/cyphar/libpathrs/releases/download/v$pkgver/libpathrs.vendor.tar.zst
	s390x-statfs.patch
	rustix-statx-imports.patch
"

prepare() {
	# The separate, signed upstream release archive contains Cargo.lock's
	# complete vendor tree. unpack() extracts it into $srcdir.
	# Move it before default_prepare so rustix-statx-imports.patch can apply.
	# When dropping that patch, restore default_prepare before this move.
	mv "$srcdir/vendor" .
	default_prepare

	# rustix-statx-imports.patch changes a Cargo-verified vendor file.
	# Remove this checksum update block when dropping that patch.
	local _rustix="vendor/rustix-1.1.4"
	local _hash=$(sha256sum "$_rustix/src/backend/libc/c.rs")
	_hash=${_hash%% *}
	sed -i "s|\"src/backend/libc/c.rs\":\"[a-f0-9]*\"|\"src/backend/libc/c.rs\":\"$_hash\"|" \
		"$_rustix/.cargo-checksum.json"

	# Alpine's BusyBox install(1) supports -D but not GNU install's -T. The
	# destination is a file path, so -T is not needed.
	sed -i 's/install -DT -m 0755/install -Dm 0755/' install.sh

	mkdir -p .cargo
	printf '%s\n' \
		'[source.crates-io]' \
		'replace-with = "vendored-sources"' \
		'' \
		'[source.vendored-sources]' \
		'directory = "vendor"' > .cargo/config.toml
}

build() {
	# Cargo has supported --crate-type since Rust 1.64. This avoids the
	# upstream Makefile's Cargo.toml-rewriting compatibility workaround, which
	# can reuse an rlib build instead of producing the requested cdylib.
	for _crate_type in cdylib staticlib; do
		LIBPATHRS_CAPI_BUILDMODE="$_crate_type" \
		RUSTFLAGS="$RUSTFLAGS -C panic=abort -C linker=clang -C link-arg=-fuse-ld=lld" \
			cargo auditable rustc \
				--features=capi \
				--locked \
				--offline \
				--release \
				--crate-type="$_crate_type"
	done
}

check() {
	# The runtime linker must use the stable ABI name, not libpathrs.so.
	scanelf -S target/release/libpathrs.so |
		grep -q 'libpathrs.so.0'

	# Exercise the installed C ABI with upstream's lightweight smoke test.
	local _checkroot="$srcdir/check"
	DESTDIR="$_checkroot" ./install.sh --prefix=/usr --libdir=/usr/lib
	PKG_CONFIG_PATH="$_checkroot/usr/lib/pkgconfig" \
	PKG_CONFIG_SYSROOT_DIR="$_checkroot" \
	LD_LIBRARY_PATH="$_checkroot/usr/lib" \
		make -C examples/c smoke-test
}

package() {
	DESTDIR="$pkgdir" ./install.sh \
		--prefix=/usr \
		--libdir=/usr/lib
}

