From: Jake Buchholz Göktürk <tomalok@gmail.com>
Subject: [PATCH] Normalize statfs filesystem magic types for comparisons

On s390x, rustix exposes statfs.f_type as u32 while the filesystem magic
constants have a different type. Cast to the type inferred from the other
side of each comparison so this also works on architectures where the types
are signed.

diff --git a/src/procfs.rs b/src/procfs.rs
--- a/src/procfs.rs
+++ b/src/procfs.rs
@@ -958,6 +958,6 @@ pub(crate) fn verify_is_procfs(fd: impl AsFd) -> Result<(), Error> {
         })?
         .f_type;
-    if fs_type != rustix_fs::PROC_SUPER_MAGIC {
+    if fs_type != rustix_fs::PROC_SUPER_MAGIC as _ {
         Err(ErrorImpl::OsError {
             operation: "verify fd is from procfs".into(),
             source: IOError::from_raw_os_error(libc::EXDEV),
diff --git a/src/utils/fd.rs b/src/utils/fd.rs
--- a/src/utils/fd.rs
+++ b/src/utils/fd.rs
@@ -308,7 +308,7 @@ impl Handle {
             operation: "check fstype of fd".into(),
             source: err,
         })?;
-        Ok(DANGEROUS_FILESYSTEMS.contains(&stat.f_type))
+        Ok(DANGEROUS_FILESYSTEMS.contains(&(stat.f_type as _)))
     }
 
     fn get_fdinfo_field<T: FromStr>(
