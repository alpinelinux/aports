42a9fe5858fa7f540f3efee6e38bb5875293a556c7976c93c6f0ccfb9649705f269dbef666fda454ef8e11fa4b01e4dffcefdfb45c7f9e055fe4c553a224a7cf  x-sys-ppc64le-pie-fix.patch
"
