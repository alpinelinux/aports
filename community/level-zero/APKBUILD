# Maintainer: Simon Zeni <simon@bl4ckb0ne.ca>
pkgname=level-zero
pkgver=1.32.0
pkgrel=0
pkgdesc="oneAPI Level Zero Specification Headers and Loader "
url="https://github.com/oneapi-src/level-zero"
arch="all"
license="MIT"
options="net" # Fetch gtest
makedepends="cmake samurai python3"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/oneapi-src/level-zero/archive/refs/tags/v$pkgver.tar.gz
	xla-missing-include.patch
	strerror_r-musl.patch"

build() {
	# tests_event_deadlock and tests_event_deadlock_reset are crashing without this
	# https://github.com/oneapi-src/level-zero/issues/247
	CXXFLAGS="$CXXFLAGS -U_GLIBCXX_ASSERTIONS"

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_L0_LOADER_TESTS=ON \
		. -Wno-dev
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

