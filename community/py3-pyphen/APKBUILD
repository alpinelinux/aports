# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: Wen Heping <wenhepingalpine@sohu.com>
pkgname=py3-pyphen
pkgver=0.18.1
pkgrel=0
_pkgname=Pyphen
pkgdesc="Python-based dictionary hyphenator library"
url="https://pyphen.org/"
arch="noarch"
license="GPL-2.0-or-later AND LGPL-2.1-or-later AND MPL-1.1"
makedepends="py3-flit-core py3-gpep517"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$_pkgname-$pkgver.tar.gz::https://github.com/Kozea/Pyphen/archive/$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

replaces="py-pyphen" # Backwards compatibility
provides="py-pyphen=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
27d7e1d1a838344b46a90a8fb140c736360a817e74df9e6953b78c18bbcfb47e68ec07a63019b27b3e94a44429e777e059e5139142bbc8c76d107967705446c1  Pyphen-0.18.1.tar.gz
"
