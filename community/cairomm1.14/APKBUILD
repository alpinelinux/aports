# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=cairomm1.14
pkgver=1.14.6
pkgrel=0
pkgdesc="C++ bindings to Cairo vector graphics library"
url="https://www.cairographics.org"
arch="all"
license="LGPL-2.0-or-later AND MPL-1.1"
makedepends="meson libsigc++-dev cairo-dev perl"
checkdepends="boost-dev font-cantarell"
subpackages="$pkgname-dev"
source="https://www.cairographics.org/releases/cairomm-$pkgver.tar.xz"
builddir="$srcdir/cairomm-$pkgver"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dboost-shared=true \
		-Dbuild-tests="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
5d7c988613b6e6694ed8e1396ac9967df375f545d0060cd6c584e397ba7c03ed0f55261b00bb4c3773d1d8d4401862f2658d3698061a20757c11ea525802e4d1  cairomm-1.14.6.tar.xz
"
