# Contributor: Grigory Kirillov <txgk@bk.ru>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=newsraft
pkgver=0.38
pkgrel=0
pkgdesc="Feed reader with text-based user interface"
url="https://codeberg.org/newsraft/newsraft"
arch="all"
license="ISC"
makedepends_host="
	curl-dev
	expat-dev
	gumbo-parser-dev
	sqlite-dev
	"
subpackages="$pkgname-doc"
source="https://codeberg.org/newsraft/newsraft/archive/newsraft-$pkgver.tar.gz"
builddir="$srcdir/newsraft"

build() {
	make -e all
}

check() {
	./newsraft -v
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install install-desktop
	install -Dm644 doc/license.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="
