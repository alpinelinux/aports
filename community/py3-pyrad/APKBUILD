# Maintainer: Antoine Martin (ayakael) <dev@ayakael.net>
pkgname=py3-pyrad
#_pkgreal is used by apkbuild-pypi to find modules at PyPI
_pkgreal=pyrad
pkgver=2.6.0
pkgrel=0
pkgdesc="Python RADIUS Implementation"
url="https://pypi.python.org/project/pyrad"
arch="noarch"
license="BSD-3-Clause"
depends="py3-netaddr"
makedepends="py3-gpep517 py3-wheel py3-setuptools"
checkdepends="py3-pytest py3-pytest-cov py3-mock"
source="$pkgname-$pkgver.tar.gz::https://github.com/pyradius/pyrad/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/$_pkgreal-$pkgver"
subpackages="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m coverage run -m unittest discover -v
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	# remove unwanted files
	rm -r "$pkgdir"/usr/lib/python*/site-packages/docs \
		"$pkgdir"/usr/lib/python*/site-packages/example \
		"$pkgdir"/usr/lib/python*/site-packages/pyrad/tests
}

sha512sums="
5449a12972e73ff122b97ea43d287d85bae20d926e3b4110bd47773ec4cc640eb14e62a88a74e6e4df75e978d3cd22e597ad739eb7caa4ecd3fe383d4cd925f6  py3-pyrad-2.6.0.tar.gz
"
