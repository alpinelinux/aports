# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: mio <miyopan@e.email>
maintainer="mio <miyopan@e.email>"
pkgname=gedit
pkgver=51.0
pkgrel=0
pkgdesc="Easy-to-use and general-purpose text editor"
url="https://gedit-text-editor.org"
arch="all"
license="GPL-2.0-only"
depends="
	adwaita-icon-theme
	gsettings-desktop-schemas
	"
depends_dev="gedit=$pkgver-r$pkgrel"
makedepends="
	appstream-dev
	glib-dev
	gobject-introspection-dev
	gspell-dev
	gtk+3.0-dev
	gtk-doc
	gtk-update-icon-cache
	itstool
	libgedit-gtksourceview-dev
	libgedit-tepl-dev
	libpeas-dev
	libx11-dev
	libxml2-dev
	meson
	"
checkdepends="
	appstream-glib
	desktop-file-utils
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-plugins
	"

source="https://gitlab.gnome.org/World/gedit/gedit/-/archive/$pkgver/gedit-$pkgver.tar.gz"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

plugins() {
	pkgdesc="Plugins for the gedit text editor"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove /usr/lib/$pkgname/plugins
}

sha512sums="
11334e70f0347140ab83cc4e761fe7ce602bb2cdbf32b9531c590bc0c27efe8c0ac648020448678075495ca4d3af85d6adc07303598b3a93d4e36bd2cc29d34b  gedit-51.0.tar.gz
"
