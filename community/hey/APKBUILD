pkgname=hey
pkgver=0.1.5
pkgrel=0
pkgdesc="HTTP load generator"
url="https://github.com/rakyll/hey"
arch="all"
license="Apache-2.0"
makedepends="go"
options="net" # go
source="$pkgname-$pkgver.tar.gz::https://github.com/rakyll/hey/archive/v$pkgver.tar.gz"

build() {
	go build -v
}

check() {
	go test ./...
}

package() {
	install -Dm755 "$builddir"/$pkgname "$pkgdir"/usr/bin/$pkgname
}

