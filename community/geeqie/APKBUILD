# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=geeqie
pkgver=3.1
pkgrel=0
pkgdesc="Gtk+ based image viewer and organiser"
url="http://www.geeqie.org/"
arch="all"
license="GPL-2.0-only"
makedepends="
	doxygen
	exiv2-dev
	graphviz-dev
	gtk4.0-dev
	lcms2-dev
	libarchive-dev
	lua5.3-dev
	meson
	xxd
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-doc
	$pkgname-lang
	"
source="https://github.com/BestImageViewer/geeqie/releases/download/v$pkgver/geeqie-$pkgver.tar.xz"
options="!check" # no tests

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
b0d70bf49446eebc5b4a741099cf81cc7010c72633d38eac5154f5683c653724ee8934a3b20413b1b963b109c3592fdbf437f5c660491421a0ce97f9f19f64a8  geeqie-3.1.tar.xz
"
