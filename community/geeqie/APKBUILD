# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=geeqie
pkgver=3.2
pkgrel=0
pkgdesc="Gtk+ based image viewer and organiser"
url="http://www.geeqie.org/"
arch="all"
license="GPL-2.0-only"
makedepends="
	doxygen
	exiv2-dev
	graphviz-dev
	gtk4.0-dev
	lcms2-dev
	libarchive-dev
	lua5.3-dev
	meson
	xxd
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-doc
	$pkgname-lang
	"
source="https://github.com/BestImageViewer/geeqie/releases/download/v$pkgver/geeqie-$pkgver.tar.xz"
options="!check" # no tests

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
a37707ea542951dec7e74e300caaff9b99139abdc352f3b5dac6fa50596e6ce7ed91b87f96608c530c6c2a9a20b95057e2a0e64989c302ce7371e72943621954  geeqie-3.2.tar.xz
"
