# Contributor: ScrumpyJack <scrumpyjack@st.ilet.to>
# Maintainer: ScrumpyJack <scrumpyjack@st.ilet.to>
pkgname=geeqie
pkgver=3.4
pkgrel=0
pkgdesc="Gtk+ based image viewer and organiser"
url="http://www.geeqie.org/"
arch="all"
license="GPL-2.0-only"
makedepends="
	doxygen
	exiv2-dev
	graphviz-dev
	gtk4.0-dev
	lcms2-dev
	libarchive-dev
	lua5.3-dev
	meson
	xxd
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-doc
	$pkgname-lang
	"
source="https://github.com/BestImageViewer/geeqie/releases/download/v$pkgver/geeqie-$pkgver.tar.xz"
options="!check" # no tests

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
680f410434d427c3e1bc31ff2c876677480ea10cca41a3fc4195d3baafd03d2b8882a195152412ac25c590a14c3ad9bcf2f08b02c979fd3c2a1a5e52f7194349  geeqie-3.4.tar.xz
"
