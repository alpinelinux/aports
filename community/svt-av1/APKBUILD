# Contributor: Oleg Titov <oleg.titov@gmail.com>
# Maintainer: Oleg Titov <oleg.titov@gmail.com>
pkgname=svt-av1
pkgver=4.3.0
pkgrel=0
pkgdesc="Scalable Vector Technology for AV1 encoder (SVT-AV1 Encoder)"
url="https://github.com/AOMediaCodec/SVT-AV1"
# 32-bit is not supported upstream
# https://github.com/AOMediaCodec/SVT-AV1/blob/master/CMakeLists.txt#L31
arch="all !x86 !armhf !armv7"
license="BSD-3-Clause-Clear"
options="!check" # No test suite from upstream
makedepends="cmake samurai nasm"
subpackages="
	$pkgname-dev
	libSvtAv1Enc:enclib
	"
source="https://github.com/AOMediaCodec/SVT-AV1/archive/v$pkgver/SVT-AV1-$pkgver.tar.gz"
builddir="$srcdir/SVT-AV1-$pkgver"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		CMAKE_CROSSOPTS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	export LDFLAGS="$LDFLAGS -Wl,-z,stack-size=1048576"
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=Release \
		$CMAKE_CROSSOPTS .
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

enclib() {
	amove usr/lib/libSvtAv1Enc.so.*
}

sha512sums="
769618fe59435e1a64738065ec613bf5324f35494bf1f841163bb7f3746080c74dff42cef5c83dc2174fdce17ae49c5aaa5091a16bf2f6b5ecba250a36fa168f  SVT-AV1-4.3.0.tar.gz
"
