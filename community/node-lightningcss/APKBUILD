maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=node-lightningcss
pkgver=1.30.1
pkgrel=0
_detectlibc=2.1.2
pkgdesc="CSS parser, transformer and minifier"
url="https://lightningcss.dev/"
arch="all"
license="MPL-2.0 AND Apache-2.0"
depends="nodejs"
makedepends="cargo"
# Use .npmtgz to avoid unpack(); all these would unpack overlapping files.
source="lightningcss-$pkgver.tar.gz::https://github.com/parcel-bundler/lightningcss/archive/refs/tags/v$pkgver.tar.gz
	lightningcss-npm-$pkgver.npmtgz::https://registry.npmjs.org/lightningcss/-/lightningcss-$pkgver.tgz
	detect-libc-$_detectlibc.npmtgz::https://registry.npmjs.org/detect-libc/-/detect-libc-$_detectlibc.tgz
	"
options="net" # cargo fetch
builddir="$srcdir/lightningcss-$pkgver"

case "$CARCH" in
aarch64) _target=linux-arm64-musl ;;
armhf | armv7) _target=linux-arm-musl ;;
loongarch64) _target=linux-loong64-musl ;;
ppc64le) _target=linux-ppc64-musl ;;
riscv64) _target=linux-riscv64-musl ;;
s390x) _target=linux-s390x-musl ;;
x86) _target=linux-ia32-musl ;;
x86_64) _target=linux-x64-musl ;;
esac

prepare() {
	default_prepare

	cargo fetch --locked --target="$CTARGET"
}

build() {
	cargo build --release --frozen --package lightningcss_node
}

check() {
	local stage="$srcdir/check"
	mkdir -p "$stage/node_modules/detect-libc"
	tar -xzf "$SRCDEST/detect-libc-$_detectlibc.npmtgz" -C "$stage/node_modules/detect-libc" --strip-components=1
	mkdir -p "$stage/node_modules/lightningcss"
	tar -xzf "$SRCDEST/lightningcss-npm-$pkgver.npmtgz" -C "$stage/node_modules/lightningcss" --strip-components=1
	install -Dm755 target/release/liblightningcss_node.so "$stage/node_modules/lightningcss/lightningcss.$_target.node"

	cd "$stage"
	node -e '
		const lc = require("lightningcss");
		const res = lc.transform({
			filename: "test.css",
			code: Buffer.from(".foo { .bar { color: red } display: flex; user-select: none }"),
			minify: true,
			targets: { chrome: 95 << 16 },
			drafts: { nesting: true }
		});
		const out = res.code.toString();
		if (!out.includes("display:flex")) throw new Error("unexpected output: " + out);
		console.log("transform OK:", out);
	'
}

package() {
	local dest="$pkgdir/usr/share/node_modules/lightningcss"
	install -dm755 "$dest" "$dest/node_modules/detect-libc"

	tar -xzf "$SRCDEST/lightningcss-npm-$pkgver.npmtgz" -C "$dest" --strip-components=1
	tar -xzf "$SRCDEST/detect-libc-$_detectlibc.npmtgz" -C "$dest/node_modules/detect-libc" --strip-components=1
	install -Dm755 target/release/liblightningcss_node.so "$dest/lightningcss.$_target.node"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

