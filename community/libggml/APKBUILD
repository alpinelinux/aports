# Contributor: Marian Buschsieweke <marian.buschsieweke@posteo.net>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=libggml
pkgver=0.23.0
pkgrel=0
pkgdesc="Tensor library for machine learning"
# armhf, armv7, x86: build fails
arch="all !armv7 !armhf !x86 "
url="https://github.com/ggml-org/ggml"
license="MIT"
makedepends="
	cmake
	glslang-dev
	linux-headers
	samurai
	shaderc
	openblas-dev
	spirv-headers
	vulkan-loader-dev
	"
subpackages="$pkgname-vulkan $pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/ggml-org/ggml/archive/refs/tags/v$pkgver.tar.gz
	0001-Fix-builds-on-s390x.patch
	"
builddir="$srcdir/ggml-$pkgver"
options="!check" # check: tests not compiled when using -DGGML_BACKEND_DL=ON

case "$CARCH" in
loongarch64)
	_ggml_cpu_all_variants=OFF
	;;
*)
	_ggml_cpu_all_variants=ON
	subpackages="$pkgname-cpu $subpackages"
	;;
esac

# LTO on riscv64 broken in GCC 15.2.0.
# See: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=110812
case "$CARCH" in
riscv64) _lto=OFF ;;
*) _lto=ON ;;
esac


build() {
	cmake -B build -G Ninja -Wno-dev \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DGGML_ALL_WARNINGS=OFF \
		-DGGML_ALL_WARNINGS_3RD_PARTY=OFF \
		-DGGML_BACKEND_DIR=/usr/lib \
		-DGGML_BACKEND_DL=ON \
		-DGGML_BLAS=ON \
		-DGGML_BLAS_VENDOR=OpenBLAS \
		-DGGML_BUILD_EXAMPLES=OFF \
		-DGGML_CPU_ALL_VARIANTS=$_ggml_cpu_all_variants \
		-DGGML_CUDA_FA_ALL_QUANTS=ON \
		-DGGML_LTO=$_lto \
		-DGGML_MAX_NAME=128 \
		-DGGML_NATIVE=OFF \
		-DGGML_RPC=ON \
		-DGGML_VULKAN=ON
	cmake --build build
}

check() {
	# test-backend-ops: segfaults
	ctest --test-dir build -E test-backend-ops
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

cpu() {
	install_if="$pkgname=$pkgver-r$pkgrel"
	amove usr/lib/libggml-cpu-*.so
}

vulkan() {
	install_if="$pkgname=$pkgver-r$pkgrel vulkan-loader"
	amove usr/lib/libggml-vulkan.so
}

sha512sums="
5bab13fbe931e4a78759449e91eadad979d1efaf427439c674ebb22639fde32d1468791488b28ae3dda4952dd8c0514b2c4fee9ecc46033f7aff16de442dffc2  libggml-0.23.0.tar.gz
f269ed563e7c23cbdb3167aa6cd943fcf4046f5652d97a6f2bab704fc43e64db9b843b6dda044dd0c72ae04d4a9cba6e5a97491f226f8db64987d1b14e85a0b0  0001-Fix-builds-on-s390x.patch
"
