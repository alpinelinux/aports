1a7394c92cf643ebaeeb22bf86dbda00ca695fa25c8402c105ea184ed3eaa011f4eaff4af27c0b38f0c95a664d065c02a5cfcc82384f36f91a1ebeeefd0ca2aa  nix-crate-loongarch64_patch
"
