From 44696c2a2b473c7cb4a9bd3dfa3e16eb9d18f14f Mon Sep 17 00:00:00 2001
From: Achill Gilgenast <achill@achill.org>
Date: Thu, 29 Oct 2026 08:37:36 +0100
Subject: [PATCH] meson/thumbnailer: fix building when using external libglycin

When not building libglycin because external libglycin should be used,
libglycin_dep is not set.

Fixes: 8dae8600d8e5 ("meson/thumbnailer: Depend on fresh libglycin build")
---
 glycin-thumbnailer/meson.build | 1 +
 1 file changed, 1 insertion(+)

diff --git a/glycin-thumbnailer/meson.build b/glycin-thumbnailer/meson.build
index c7b5a743..d9afaf79 100644
--- a/glycin-thumbnailer/meson.build
+++ b/glycin-thumbnailer/meson.build
@@ -5,6 +5,7 @@ endif
 if not get_option('libglycin')
     # Use external libglycin if not configured to build it
     dependency('glycin-2')
+    libglycin_dep = []
 endif
 
 cargo_build = custom_target(
