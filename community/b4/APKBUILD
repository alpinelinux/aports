maintainer="Artur Weber <alpine@uart.sh>"
pkgname=b4
pkgver=0.16.0
pkgrel=0
pkgdesc="Tool to help with email-based patch workflows"
url="https://b4.docs.kernel.org/"
arch="noarch"
license="GPL-2.0-or-later"
depends="
	git
	git-email
	git-filter-repo
	py3-dkimpy
	py3-ezgb
	py3-liblore
	py3-patatt
	py3-pygit2
	py3-requests
	py3-textual
	"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest py3-pytest-asyncio"
subpackages="$pkgname-pyc $pkgname-doc"
source="https://git.kernel.org/pub/scm/utils/b4/b4.git/snapshot/b4-$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# test_tui_tracking.py: flaky under CI (intermittent failures)
	.testenv/bin/python3 -m pytest src/tests \
		--deselect=src/tests/test_tui_tracking.py
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	install -Dvm644 src/b4/man/b4.1 \
		-t "$pkgdir"/usr/share/man/man5/
}

sha512sums="
2d0171c0cee9a8630bf331ee7485e2f2938ef519c3482d806da05f336a72a10570770dc4ee4c58283e00799fa1dacd05767dfa7c05f17f50aeb817acf9b1c395  b4-0.16.0.tar.gz
"
