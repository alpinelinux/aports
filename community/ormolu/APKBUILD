54a29a4828ac9dcf2a8cdebf8e620af28938ae46a8c8abd48fdf30c499e78ea0d1c8f3855dfaf8a9b74ee1e64468c66cd9b93e30a2d7a72725c56ae30c2532fb  cabal.project.freeze
"
