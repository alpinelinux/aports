# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=ruby-mustache
_gemname=mustache
pkgver=1.1.3
pkgrel=0
# Upstream did not tag 1.1.3.
_commit=b015f866942a6eb45ce4d34009f2ba6ff16ce4c1
pkgdesc="Logic-less Ruby templates"
url="https://mustache.github.io/"
arch="noarch"
license="MIT"
depends="ruby"
checkdepends="
	ruby-minitest
	ruby-ostruct
	ruby-rake
	ruby-rdoc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/mustache/mustache/archive/$_commit.tar.gz
	skip-simplecov.patch
	"
builddir="$srcdir/$_gemname-$_commit"

# secfixes:
#   1.1.3-r0:
#     - CVE-2026-130001

build() {
	gem build $_gemname.gemspec
}

check() {
	rake test
}

package() {
	local gemdir="$pkgdir/$(ruby -e 'puts Gem.default_dir')"
	local geminstdir="$gemdir/gems/$_gemname-$pkgver"

	gem install --local \
		--build-root "$pkgdir" \
		--no-document \
		--verbose \
		$_gemname

	# Remove unnecessary files and rubbish...
	cd "$gemdir"
	rm -r cache build_info doc extensions
	rmdir plugins || true
	cd "$geminstdir"
	rm -r test man Rakefile ./*.md
}

