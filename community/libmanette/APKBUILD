# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=libmanette
pkgver=0.2.13
pkgrel=0
pkgdesc="Simple GObject game controller library"
url="https://gnome.pages.gitlab.gnome.org/libmanette/"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	glib-dev
	gobject-introspection-dev
	hidapi-dev
	libevdev-dev
	libgudev-dev
	meson
	vala
	"
subpackages="$pkgname-dev"
source="https://download.gnome.org/sources/libmanette/${pkgver%.*}/libmanette-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Dvapi=true \
		-Dintrospection=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
ba7b3a7b15d26b720f4f55241f0a5d9b1c37ab9c7205428da74264ba3f6b7b6f4a8d1c087a61b6e4f8469fa1437d2475bca87ca987bc73d64da144a27652ff6e  libmanette-0.2.13.tar.xz
"
