# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=guacamole-dotool
pkgver=0.2.2
pkgrel=1
pkgdesc="Guacamole CLI client for scripting"
url="https://github.com/jirutka/guacamole-dotool"
# x86: textrels
arch="all !x86"
# NOTE: This includes licenses of bundled npm packages.
license="MIT AND Apache-2.0 AND ISC AND BSD-3-Clause AND BSD-2-Clause"
depends="nodejs"
makedepends="
	giflib-dev
	nodejs-dev
	npm
	pango-dev
	pixman-dev
	python3
	rollup
	"
subpackages="$pkgname-dbg"
source="https://github.com/jirutka/guacamole-dotool/archive/v$pkgver/guacamole-dotool-$pkgver.tar.gz"
options="net"

# Use Alpine node headers; avoid node-gyp fetching from nodejs.org (fails on builders).
export npm_config_nodedir=/usr
export npm_config_build_from_source=true

build() {
	printf 'allow-scripts=canvas\n' > .npmrc
	npm clean-install
	rm -rf node_modules/rollup node_modules/@rollup/rollup-* node_modules/@rollup/wasm-node
	ln -s /usr/share/node_modules/rollup node_modules/rollup
	rollup -c
}

check() {
	rm -rf node_modules package.json
	./dist/$pkgname.mjs --help
}

package() {
	mkdir -p "$pkgdir"/usr/lib/$pkgname
	cp -r dist/* "$pkgdir"/usr/lib/$pkgname/

	cd "$pkgdir"

	strip usr/lib/$pkgname/libs/*.node

	mkdir -p usr/bin
	ln -s ../lib/$pkgname/$pkgname.mjs usr/bin/$pkgname
}

dbg() {
	depends="$pkgname=$pkgver-r$pkgrel"
	default_dbg

	amove usr/lib/$pkgname/*.map
}


sha512sums="
001ec7a022b2e023d7c707edcc80f542815eac6c1e8502626181624f8da12ca44c03774c8cd98a23ad40ac081985db139abfcd127909db6b9f266739086fccda  guacamole-dotool-0.2.2.tar.gz
"
