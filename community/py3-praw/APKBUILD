# Contributor: Fabian Affolter <fabian@affolter-engineering.ch>
# Maintainer: Fabian Affolter <fabian@affolter-engineering.ch>
pkgname=py3-praw
_pkgname=praw
pkgver=8.0.3
pkgrel=0
pkgdesc="Python module to access to reddit's API"
url="https://github.com/praw-dev/praw"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	py3-defusedxml
	py3-prawcore
	py3-update-checker
	py3-websocket-client
	"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-requests
	py3-vcrpy
	"
subpackages="$pkgname-pyc"
source="$_pkgname-$pkgver.tar.gz::https://github.com/praw-dev/praw/archive/v$pkgver.tar.gz"
builddir="$srcdir"/$_pkgname-$pkgver

replaces="py-praw" # Backwards compatibility
provides="py-praw=$pkgver-r$pkgrel" # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
6a0f0c78e7f74e6256609cc8c53ae8aaef0d0c0e75d44ea20170171679a1f496b84533c3472bfa64ec869c331ffefb61426e6c3c73539070bb2187c303bdbba8  praw-8.0.3.tar.gz
"
