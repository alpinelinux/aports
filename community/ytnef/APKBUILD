# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=ytnef
pkgver=2.1.5
pkgrel=0
pkgdesc="TNEF Stream Reader - for winmail.dat files"
url="https://github.com/Yeraze/ytnef"
arch="all"
license="GPL-2.0-or-later"
makedepends="autoconf automake libtool file"
checkdepends="bash"
subpackages="$pkgname-dev $pkgname-doc $pkgname-libs"
source="$pkgname-$pkgver.tar.gz::https://github.com/Yeraze/ytnef/archive/v$pkgver.tar.gz
	ytnef-pkgconfig.patch
	"

# secfixes:
#   2.1.4-r0:
#     - CVE-2026-111145
#     - CVE-2026-111146
#   1.9.3-r1:
#     - CVE-2021-3403
#     - CVE-2021-3404

prepare() {
	default_prepare
	autoreconf -vif
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir" includedir=/usr/include/libytnef
}

