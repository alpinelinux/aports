pkgname=prox-init
pkgver=1.0.0_rc1
pkgrel=0
pkgdesc="Lightweight replacement for cloud-init for VMs running on Proxmox VE"
url="https://github.com/jirutka/prox-init"
arch="noarch"
license="MIT"
depends="yx"
subpackages="$pkgname-openrc"
source="https://github.com/jirutka/prox-init/archive/v$pkgver/$pkgname-$pkgver.tar.gz"
options="!check"  # no tests provided

package() {
	make install \
		DESTDIR="$pkgdir" \
		prefix=/usr \
		INIT_SYSTEM=openrc
}

