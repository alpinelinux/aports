# Maintainer: Ariadne Conill <ariadne@dereferenced.org>
pkgname=tuxedo-yt6801
pkgver=1.0.32
_pkgver=$pkgver.orig
_modname=yt6801
pkgrel=0
pkgdesc="third-party driver for YT6801 gigabit ethernet NICs"
url="https://gitlab.com/tuxedocomputers/development/packages/tuxedo-yt6801"
arch="all"
license="GPL-2.0-or-later"
depends="akms"
makedepends="rsync"
install="$pkgname.post-deinstall"
source="https://deb.tuxedocomputers.com/ubuntu/pool/main/t/tuxedo-yt6801/tuxedo-yt6801_$pkgver.tar.xz"
options="!check" # No tests available

package() {
	mkdir -p "$pkgdir"/usr/src/$_modname-$pkgver
	rsync --recursive --exclude=*.cmd --exclude=*.rules --exclude=*.d --exclude=*.ko --exclude=*.mod --exclude=*.mod.c --exclude=*.o --exclude=modules.order "$srcdir"/sources/files/usr/src/tuxedo-yt6801-$pkgver/ "$pkgdir"/usr/src/$_modname-$pkgver

	cat > "$pkgdir"/usr/src/$_modname-$pkgver/AKMBUILD <<-EOF
	modname=$_modname
	modver=$pkgver-r$pkgrel
	built_modules="yt6801.ko"
	EOF
}

sha512sums="
663a40b9da243894719a2323cdeaf973f70bccd039b67e2166caf5f8a4b3afa9fdec3aa89210cdf44c52cdbddaa0cacb46b18af0190b893f8e6668cf7d2bb042  tuxedo-yt6801_1.0.32.tar.xz
"
