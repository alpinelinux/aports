c798d137fdb8aa3d9e413b4dbd9604da04ee218bedb2d80756d39492c34f0a41c28864630be11dd5c24eb07a7b34c6ed7deba3e6639035f2de96117e88bfb64c  0001-src-loop.c-add-missing-include.patch
