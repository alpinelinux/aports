# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=py3-rencode
_pkgname=rencode
pkgver=1.0.9
pkgrel=0
pkgdesc="The rencode module is similar to bencode from the BitTorrent project."
url="https://pypi.org/project/rencode"
arch="all"
license="GPL-3.0-or-later"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-poetry-core python3-dev cython"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/aresch/rencode/archive/v$pkgver.tar.gz"
builddir="$srcdir"/$_pkgname-$pkgver

# secfixes:
#   1.0.6-r7:
#     - CVE-2021-40839

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
        python3 -m venv --clear --without-pip --system-site-packages .testenv
        .testenv/bin/python3 -m installer .dist/*.whl
        cd "$builddir"/.. 
        "$builddir"/.testenv/bin/python3 -m pytest "$builddir"/tests
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
1ebafe2997814a4d6c28d09a22c5319f6a29c38a80aa09a0f7aeb82d78856eb94a34bde437cb9805c13106b722a8cd75aac21cd7b3d6f73e7bc10ef676dc8184  py3-rencode-1.0.9.tar.gz
"
