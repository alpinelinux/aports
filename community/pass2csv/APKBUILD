# Maintainer: Michał Polański <michal@polanski.me>
pkgname=pass2csv
pkgver=1.2.0
pkgrel=1
pkgdesc="Export pass(1), \"the standard unix password manager\", to CSV"
url="https://codeberg.org/svartstare/pass2csv"
license="MIT"
arch="noarch"
depends="py3-gnupg"
makedepends="py3-gpep517 py3-installer py3-setuptools py3-wheel"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/svartstare/pass2csv/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname"
options="!check" # no test suite

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/pass2csv-$pkgver-py3-none-any.whl
}

sha512sums="
ac1e5b800b3f46f6c56d27b5610a3f000d446f18983905c67d01a8d7b3caba25c0b5cda43b24079955dc227756adefcc1624d24f8b827449840095673b5efc58  pass2csv-1.2.0.tar.gz
"
