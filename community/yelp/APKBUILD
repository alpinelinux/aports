# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/gnome <achill@achill.org>"
pkgname=yelp
pkgver=49.2
pkgrel=0
pkgdesc="Help browser for GNOME desktop"
url="https://apps.gnome.org/Yelp"
arch="all"
license="GPL-2.0-or-later"
depends="dconf desktop-file-utils hicolor-icon-theme yelp-xsl"
makedepends="
	bash
	bzip2-dev
	glib-dev
	gtk4.0-dev
	itstool
	libadwaita-dev
	libgcrypt-dev
	libxml2-dev
	libxslt-dev
	meson
	sqlite-dev
	webkit2gtk-6.0-dev
	xz-dev
	"
subpackages="$pkgname-dev $pkgname-lang"
source="https://download.gnome.org/sources/yelp/${pkgver%.*}/yelp-$pkgver.tar.xz"

# secfixes:
#   42.2-r5:
#     - CVE-2025-3155

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
