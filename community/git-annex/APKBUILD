# Maintainer: Antoine Martin (ayakael) <dev@ayakael.net>
pkgname=git-annex
pkgver=10.20261026
pkgrel=0
pkgdesc="Manage files with git, without checking their contents into git"
url="http://git-annex.branchable.com"
arch="x86_64 aarch64" # limited by ghc
license="AGPL-3.0-or-later"
options="net"
depends="
	curl
	git
	rsync
	"
makedepends="
	alex
	botan3-dev
	cabal
	dbus-dev
	file-dev
	ghc
	gmp-dev
	gnutls-dev
	happy
	libffi-dev
	libgsasl-dev
	libxml2-dev
	ncurses-dev
	zlib-dev
	"
checkdepends="gpg"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/con/git-annex/archive/refs/tags/$pkgver.tar.gz
	https://ayakael.net/api/packages/mirrors/generic/git-annex/$pkgver/git-annex-$pkgver-edge.cabal
	fix-makefile.patch
	ghc-9.14.patch
	git-annex.desktop
	git-annex-autostart.desktop
	rollback-mans-utility-process-dependency.patch
	"
subpackages="$pkgname-doc $pkgname-bash-completion $pkgname-fish-completion $pkgname-zsh-completion"

# secfixes:
#   10.20261026-r0:
#     - CVE-2026-112818

_feature_flags="+assistant +webapp +pairing +production +torrentparser +magicmime +benchmark -debuglocks +dbus +networkbsd +gitlfs +httpclientrestricted +botan +xxh3"

# Cabal seems to be built without sandbox, moving the cabal-dir into src
export CABAL_DIR="$srcdir/.cabal"

cabal_update() {
	cd "$builddir"

	cabal update
	(
		cabal v2-freeze \
			--strong-flags \
			--shadow-installed-packages \
			--flags="$_feature_flags"

		mv cabal.project.freeze "$startdir/git-annex-$pkgver.config"
	)
}

prepare() {
	cp -L "$srcdir"/git-annex-*.cabal "$builddir"/cabal.project.freeze

	# use crypton version that does not depend on ram
	# TODO: remove when https://github.com/yesodweb/yesod/issues/1917 fixed
	sed 's|crypton,|crypton (<=1.0.6),|' -i git-annex.cabal

	# ensure that botan-bindings is newest
	# TODO: remove when botan-low always uses latest botan-bindings
	sed 's|botan-low (< 0.3)|botan-low (< 0.3),\n      botan-bindings (>= 0.3)|' -i git-annex.cabal

	# botan-bindings requires pkg-config to find botan headers
	sed 's|botan-bindings -pkg-config|botan-bindings +pkg-config|' -i cabal.project.freeze

	default_prepare
}

build() {
	cabal v2-update
	cabal v2-build git-annex:exes \
		--jobs=${JOBS:-1} \
		--prefix=/usr \
		--docdir=/usr/share/doc/$pkgname \
		--sysconfdir=/etc \
		--flags="$_feature_flags"

	# Avoid invoking ghc(1) in install() function.
 	make mans

	# Prepare executable for the tests and make install.
	local executable="$(cabal list-bin git-annex:exes)"
	cp "$executable" .
	ln -s git-annex git-annex-shell
	ln -s git-annex git-remote-annex
}

check() {
	"$builddir"/git-annex test
}

package() {
	make DESTDIR="$pkgdir" install

	install -Dm644 "$srcdir"/git-annex.desktop "$pkgdir"/usr/share/applications/git-annex.desktop
	install -Dm644 "$srcdir"/git-annex-autostart.desktop "$pkgdir"/etc/xdg/autostart/git-annex.desktop
	install -Dm644 "$builddir"/doc/logo.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/git-annex.svg
	install -Dm644 "$builddir"/doc/logo_16x16.png  "$pkgdir"/usr/share/icons/hicolor/16x16/apps/git-annex.png
}

