# Contributor: Celeste <cielesti@protonmail.com>
# Maintainer: Wen Heping <wenhepingalpine@sohu.com>
pkgname=trealla
pkgver=3.14.71
pkgrel=0
pkgdesc="Compact and efficient Prolog interpreter"
url="https://github.com/trealla-prolog/trealla"
arch="all"
license="MIT"
makedepends="
	libedit-dev
	libffi-dev
	openssl-dev
	readline-dev
	xxd
	"
checkdepends="
	bash
	diffutils
	"
subpackages="$pkgname-doc"
source="https://github.com/trealla-prolog/trealla/archive/v$pkgver/trealla-$pkgver.tar.gz"
builddir="$srcdir"/trealla-prolog-$pkgver

build() {
	make GIT_VERSION="\"v$pkgver\""
}

check() {
	make test
}

package() {
	install -Dvm755 tpl -t "$pkgdir"/usr/bin/

	# Remove sample executables from docs
	for bin in allocator embed oom; do
		rm -f samples/$bin
	done
	mkdir -p "$pkgdir"/usr/share/doc/$pkgname
	cp -R samples "$pkgdir"/usr/share/doc/$pkgname/
	install -Dvm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
1d64cd9b743509d2bc143349f5f399a6f6791adbf5b56e4b20af96bdd23171e949d49882f8740e89d172ecec2d533f828f56f0e3065111c79a6d3195895eaf24  trealla-3.14.71.tar.gz
"
