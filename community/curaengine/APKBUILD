# Contributor: Aiden Grossman <agrossman154@yahoo.com>
# Maintainer:
pkgname=curaengine
# If you plan to upgrade curaengine, libarcus probably needs to be upgraded too
pkgver=5.13.0
pkgrel=0
_wagyu_ver=0.5.0
_geometry_ver=2.0.3
_scripta_commit=b96045cd9b531d97f42dec8c9a0ef52f773f6b90
pkgdesc="3D slicer engine"
url="https://github.com/Ultimaker/CuraEngine"
license="AGPL-3.0-or-later"
arch="all"
makedepends="
	boost-dev
	clipper-dev
	cmake
	libarcus-dev
	libpng-dev
	onetbb-dev
	protobuf-dev
	range-v3-dev
	rapidjson-dev
	samurai
	spdlog-dev
	stb
	"
source="
	https://github.com/Ultimaker/CuraEngine/archive/$pkgver/CuraEngine-$pkgver.tar.gz
	https://github.com/Ultimaker/Scripta_public/archive/$_scripta_commit/Scripta_public-$_scripta_commit.tar.gz
	https://github.com/mapbox/geometry.hpp/archive/refs/tags/v$_geometry_ver/geometry.hpp-$_geometry_ver.tar.gz
	https://github.com/mapbox/wagyu/archive/refs/tags/$_wagyu_ver/wagyu-$_wagyu_ver.tar.gz
	cmake.patch
	cmake-helpers.patch
	32bit-arm.patch
	mapbox-wagyuConfig.cmake
	scriptaConfig.cmake
	"
options="!check"
builddir="$srcdir/CuraEngine-$pkgver"

prepare() {
	default_prepare

	mkdir -p "$builddir"/bundled/include
	mkdir -p "$builddir"/bundled/lib/cmake/mapbox-wagyu
	mkdir -p "$builddir"/bundled/lib/cmake/scripta
	cp -r "$srcdir"/wagyu-$_wagyu_ver/include/mapbox "$builddir"/bundled/include/
	cp -r "$srcdir"/geometry.hpp-$_geometry_ver/include/mapbox/geometry "$builddir"/bundled/include/mapbox/
	cp -r "$srcdir"/Scripta_public-$_scripta_commit/include/scripta "$builddir"/bundled/include/
	cp "$srcdir"/mapbox-wagyuConfig.cmake "$builddir"/bundled/lib/cmake/mapbox-wagyu/
	cp "$srcdir"/scriptaConfig.cmake "$builddir"/bundled/lib/cmake/scripta/
}

build() {
	# Plugins require https://github.com/Tradias/asio-grpc
	cmake -G Ninja -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_PREFIX_PATH="$builddir/bundled" \
		-DENABLE_PLUGINS=OFF \
		-DENABLE_REMOTE_PLUGINS=OFF \
		-DENABLE_SENTRY=OFF
	cmake --build build
}

check() {
	cmake --build build --target test
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

