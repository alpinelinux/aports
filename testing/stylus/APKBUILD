# Contributor: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=stylus
pkgver=2.4.17
pkgrel=0
pkgdesc="User styles manager for Firefox"
url="https://github.com/openstyles/stylus"
# riscv64: Segmentation fault (core dumped)
arch="noarch !riscv64"
license="GPL-3.0-only"
makedepends="git jq nodejs pnpm"
source="stylus-$pkgver.tar.gz::https://github.com/openstyles/stylus/archive/refs/tags/v$pkgver.tar.gz"
options="net" # pnpm dependencies

prepare() {
	default_prepare

	# Force usage of system pnpm (pinned version is fetched by default).
	jq 'del(.packageManager)' package.json >tmp.json
	mv tmp.json package.json

	pnpm install --frozen-lockfile --ignore-scripts
	node tools/build-cm-css-data.js
}

build() {
	node tools/build.js build firefox mv2
}

check() {
	pnpm test
}

package() {
	_target="$pkgdir/usr/lib/firefox/browser/extensions/{7a7a4a92-a2a0-41d1-9fd7-1e92480d612d}"
	mkdir -p "$_target"
	cp -a dist-firefox-mv2/. "$_target"
}

sha512sums="
acd180b8fc61ff20af0b8f6aaa4a8910e79696bea9f1700f11c00d1beb44a74e7dd4057b1ec7b85bab175ad6559bde9338c5a8e5969e31ecb0d969d0cb556976  stylus-2.4.17.tar.gz
"
