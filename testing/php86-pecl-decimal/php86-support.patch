Patch-Source: https://github.com/php-decimal/ext-decimal (no 8.6 release yet)
PHP 8.6 removed the zval_dtor() alias and the INI_INT() macro.
Use zval_ptr_dtor_nogc() and zend_ini_long() respectively.
--- a/php_decimal.c	2026-07-01 07:05:23.863066511 +0200
+++ b/php_decimal.c	2026-07-01 07:05:23.879066614 +0200
@@ -1942,7 +1942,7 @@
     }
 
     if (op1 == &op1_copy) {
-        zval_dtor(op1);
+        zval_ptr_dtor_nogc(op1);
     }
 
     return SUCCESS;
@@ -2912,7 +2912,7 @@
  */
 static void php_decimal_disable_opcache_pass2()
 {
-    zend_long level = INI_INT("opcache.optimization_level");
+    zend_long level = zend_ini_long("opcache.optimization_level", strlen("opcache.optimization_level"), 0);
 
