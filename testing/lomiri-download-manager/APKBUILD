# Contributor: Bart Ribbers <bribbers@disroot.org>
# Contributor: Antoni Aloy <aaloytorrens@gmail.com>
# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=lomiri-download-manager
pkgver=0.3.2
pkgrel=1
pkgdesc="Provides a service for downloading files while an application is suspended"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://gitlab.com/ubports/development/core/lomiri-download-manager"
license="LGPL-3.0-only"
depends_dev="
	boost-dev
	glog-dev
	gtest-dev
	lomiri-api-dev
	qt6-qtdeclarative-dev
	qt6-qtscxml-dev
	qt6-qttools-dev
	"
depends_dev_qt5="
	boost-dev
	glog-dev
	gtest-dev
	lomiri-api-dev
	qt5-qtdeclarative-dev
	qt5-qttools-dev
	"
makedepends="
	$depends_dev
	$depends_dev_qt5
	cmake
	cmake-extras
	doxygen
	gmock
	graphviz
	libapparmor-dev
	samurai
	"
checkdepends="
	dbus-test-runner
	xvfb-run
	"
subpackages="
	$pkgname-qt5
	$pkgname-qt5-dev:qt5_dev
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	"
source="https://gitlab.com/ubports/development/core/lomiri-download-manager/-/archive/$pkgver/lomiri-download-manager-$pkgver.tar.gz
	0001-Find-qdoc-correctly-on-distros-without-qtchooser.patch
	0002-Revert-tests-common-workaround-CMake-dependency-bug.patch
	"

build() {
	cmake -B build-qt6 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DUSE_SYSTEMD=OFF \
		-DENABLE_WERROR=OFF \
		-DENABLE_QT6=ON
	cmake --build build-qt6

	cmake -B build-qt5 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DUSE_SYSTEMD=OFF \
		-DENABLE_WERROR=OFF \
		-DENABLE_QT6=OFF
	cmake --build build-qt5

}

check() {
	ctest --test-dir build-qt6
}

package() {
	DESTDIR="$pkgdir" cmake --install build-qt6
	DESTDIR="$pkgdir" cmake --install build-qt5
}

qt5() {
	amove usr/lib/qt5
	amove usr/lib/libldm-common.so.*
	amove usr/lib/libldm-priv-common.so.*
	amove usr/lib/liblomiri-download-manager-client.so.*
	amove usr/lib/liblomiri-download-manager-common.so.*
	amove usr/lib/liblomiri-upload-manager-common.so.*
}

qt5_dev() {
	depends="
		$pkgname-qt5
		$depends_dev_qt5
		"

	amove usr/include/qt5
	amove usr/lib/libldm-common.so
	amove usr/lib/libldm-priv-common.so
	amove usr/lib/liblomiri-download-manager-client.so
	amove usr/lib/liblomiri-download-manager-common.so
	amove usr/lib/liblomiri-upload-manager-common.so
	amove usr/lib/pkgconfig/ldm-common.pc
	amove usr/lib/pkgconfig/lomiri-download-manager-client.pc
	amove usr/lib/pkgconfig/lomiri-download-manager-common.pc
	amove usr/lib/pkgconfig/lomiri-upload-manager-common.pc
}
