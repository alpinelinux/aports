From cb03754f4a64877ec942d4172fb066ddc60947b6 Mon Sep 17 00:00:00 2001
From: Sasha Mitchell <sash.t.mitchell@gmail.com>
Date: Mon, 12 Oct 2026 00:43:24 +0700
Subject: [PATCH] fix: register encoding/json/v2 interface wrappers

Go 1.27 aliases json.Marshaler to encoding/json/v2. The wrapper was only registered under encoding/json, so a send to chan json.Marshaler panics.
---
 stdlib/go1_27_encoding_json.go | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)
 create mode 100644 stdlib/go1_27_encoding_json.go

diff --git a/stdlib/go1_27_encoding_json.go b/stdlib/go1_27_encoding_json.go
new file mode 100644
index 000000000..7f76ec35f
--- /dev/null
+++ b/stdlib/go1_27_encoding_json.go
@@ -0,0 +1,20 @@
+//go:build go1.27
+
+package stdlib
+
+import (
+	"encoding/json"
+	"reflect"
+)
+
+func init() {
+	// Go 1.27 defines Marshaler and Unmarshaler in encoding/json/v2 and
+	// aliases them from encoding/json. reflect reports the v2 package path,
+	// so the interface wrappers have to be registered there too.
+	Symbols["encoding/json/v2/v2"] = map[string]reflect.Value{
+		"Marshaler":    reflect.ValueOf((*json.Marshaler)(nil)),
+		"Unmarshaler":  reflect.ValueOf((*json.Unmarshaler)(nil)),
+		"_Marshaler":   reflect.ValueOf((*_encoding_json_Marshaler)(nil)),
+		"_Unmarshaler": reflect.ValueOf((*_encoding_json_Unmarshaler)(nil)),
+	}
+}
