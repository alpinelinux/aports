# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=fastrpc
pkgver=1.0.7
pkgrel=0
pkgdesc="Qualcomm FastRPC and library"
url="https://github.com/qualcomm/fastrpc"
arch="all !armhf" # armhf: doesn't compile
license="BSD-3-Clause"
depends="acl"
makedepends="
	autoconf
	automake
	libbsd-dev
	libtool
	yaml-dev
	"
subpackages="$pkgname-dev $pkgname-doc $pkgname-libs $pkgname-systemd $pkgname-udev"
source="https://github.com/qualcomm/fastrpc/archive/v$pkgver/fastrpc-$pkgver.tar.gz"
options="!strip !check" # tries to strip hexagon architecture binaries and fails

prepare() {
	default_prepare
	sh ./autogen.sh
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--with-systemdsystemunitdir=/usr/lib/systemd/system \
		--with-udevrulesdir=/usr/lib/udev/rules.d
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
e986da9aea20045e1fe16d7791e83a448bbc4fa7d8690f7f1f2f7ed67271bc4baa1850a99106b7ad32bfaf91008191bc65721e6f39d872b8fa42844d3aca7fea  fastrpc-1.0.7.tar.gz
"
