# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=tzompantli
pkgver=1.2.0
pkgrel=0
# blocking: rust-skia uses binary prebuilts in compilation
pkgdesc="Wayland mobile app launcher (for Catacomb)"
url="https://catacombing.org/"
# riscv64: compiles too slowly
# ppc64le s390x: blocked by aports#18444
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-only"
options="net" # need to download some cargo deps
makedepends="
	cargo-auditable
	fontconfig-dev
	libxkbcommon-dev
"
source="tzompantli-v$pkgver.tar.gz::https://github.com/catacombing/tzompantli/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/tzompantli -t "$pkgdir"/usr/bin/
}
sha512sums="
ec0702746b503429744f6f47117c78aa87c02982dfea6a17af6b1726bb2c0826b8054e6abee08561fa650a2aec1b9b41b5430143e91ae20b4b52044c3743f81a  tzompantli-v1.2.0.tar.gz
"
