# Maintainer: Michael Auer <mick@yoxcu.de>
pkgname=unfettered-keyboard
pkgver=4.2.1
pkgrel=1
pkgdesc="On-screen keyboard that works on Linux Mobile (Wayland)"
url="https://gitlab.com/flamingradian/unfettered-keyboard"
arch="x86_64 aarch64 riscv64"
license="GPL-3.0-only"
makedepends="cargo cargo-auditable expat-dev clang-libclang fontconfig-dev wayland-dev"
subpackages="$pkgname-phosh $pkgname-phosh-systemd $pkgname-kde $pkgname-sxmo"
options="!check net" # There is no test suite / unit tests / version one could check; net for cargo fetch
_unexpected_tag="1.29.1"
source="
$pkgname-v$pkgver.tar.gz::https://gitlab.com/flamingradian/unfettered-keyboard/-/archive/v$pkgver/unfettered-keyboard-v$pkgver.tar.gz
unexpected-keyboard-$_unexpected_tag.zip::https://github.com/Julow/Unexpected-Keyboard/archive/refs/tags/$_unexpected_tag.zip
"

builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

package() {
	install -Dm755 "$builddir"/target/release/ufkbd-wl "$pkgdir/usr/bin/ufkbd-wl"
	install -Dm755 "$builddir"/target/release/ufkbd-evfb "$pkgdir/usr/bin/ufkbd-evfb"
	install -Dm755 "$builddir"/target/release/ufkbd-evfbo "$pkgdir/usr/bin/ufkbd-evfbo"

	_uk="$srcdir/Unexpected-Keyboard-$_unexpected_tag"
	install -Dm644 "$_uk"/srcs/layouts/*.xml "$_uk"/res/xml/*.xml \
		-t "$pkgdir"/usr/share/unfettered-keyboard/layouts/

	install -Dm644 "$builddir/resources/unfettered-keyboard-phosh.service" \
		"$pkgdir/usr/lib/systemd/user/mobi.phosh.OSK.service"
}

phosh() {
	pkgdesc="Unfettered Keyboard for Phosh"
	provides="phosh-keyboard=0"
	provider_priority=0
	install_if="$pkgname=$pkgver-r$pkgrel phosh"

	install -Dm755 "$builddir"/target/release/ufkbd-gnome "$subpkgdir/usr/bin/ufkbd-gnome"
}

kde() {
	pkgdesc="Unfettered Keyboard for KDE/Plasma"
	install_if="$pkgname=$pkgver-r$pkgrel plasma-mobile"

	install -Dm755 "$builddir"/target/release/ufkbd-kde "$subpkgdir/usr/bin/ufkbd-kde"
	install -Dm644 "$builddir/resources/unfettered-keyboard-kde.desktop" \
		"$subpkgdir/usr/share/applications/unfettered-keyboard.desktop"
	install -Dm644 "$builddir/resources/unfettered-keyboard.svg" \
		"$subpkgdir/usr/share/icons/hicolor/scalable/apps/unfettered-keyboard.svg"
}

sxmo() {
	pkgdesc="Unfettered Keyboard for SXMO"
	install_if="$pkgname=$pkgver-r$pkgrel sxmo-utils"

	install -Dm755 "$builddir"/target/release/ufkbd-sxmo "$subpkgdir/usr/bin/ufkbd-sxmo"
	install -Dm644 "$builddir/resources/unfettered-keyboard-sxmo.sh" \
		"$subpkgdir/etc/profile.d/unfettered-keyboard.sh"
}

sha512sums="
fd644beb0a97e9352d8010fb09ab44eee68fc2cb7da7ab3d31a7fc1ab39ac9ea79a4cfbe27e28ee7f96c659babf3fffb290abc5ddf0527579ec89f0685efd580  unfettered-keyboard-v4.2.1.tar.gz
c302ce7cd57cd41417815b247fac05904746654f3a4cf1ffd32e134348408bffed77224f0345ad4d6daf807451677b790ea929270e633c39b8fa666cc4f5fe72  unexpected-keyboard-1.29.1.zip
"
