From e44712c5aaebe2350fa27b719f8276463e57fe64 Mon Sep 17 00:00:00 2001
From: Lauri Tirkkonen <lauri@hacktheplanet.fi>
Date: Sun, 16 Aug 2026 05:40:48 +0000
Subject: [PATCH] riscv: dts: spacemit: k3: add reserved-memory

copied from the vendor kernel sources https://github.com/spacemit-com/linux-6.18/commits/k3-br-v1.0.y/
---
 arch/riscv/boot/dts/spacemit/k3-pico-itx.dts |  11 ++
 arch/riscv/boot/dts/spacemit/k3.dtsi         | 125 +++++++++++++++++++
 2 files changed, 136 insertions(+)

diff --git a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
index 1eb5abbc61f9..4d746406d401 100644
--- a/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
+++ b/arch/riscv/boot/dts/spacemit/k3-pico-itx.dts
@@ -272,3 +272,14 @@ &usb3d_u2phy {
 &usb3d {
 	status = "okay";
 };
+
+&resmem {
+	/* global autoconfigured region for contiguous allocations */
+	cmamem: linux,cma {
+		compatible = "shared-dma-pool";
+		reusable;
+		size = <0 0x20000000>;
+		alloc-ranges = <1 0x40000000 0 0x20000000>;
+		linux,cma-default;
+	};
+};
diff --git a/arch/riscv/boot/dts/spacemit/k3.dtsi b/arch/riscv/boot/dts/spacemit/k3.dtsi
index 53cfb2ad48cf..084492858957 100644
--- a/arch/riscv/boot/dts/spacemit/k3.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3.dtsi
@@ -431,6 +431,131 @@ osc_32k: clock-32k {
 		};
 	};
 
+	resmem: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* used for rcpu0 code & data & bss space */
+		rcpu0_pwr: rcpu0_pwr@100200000 {
+			reg = <0x1 0x200000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* rcpu0's heap */
+		rcpu0_heap: rcpu0_heap@100400000 {
+			reg = <0x1 0x400000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* vring0 */
+		rcpu0_vdev0vring0: vdev0vring0@c0876000 {
+			reg = <0x0 0xc0876000 0x0 0x3000>;
+			no-map;
+		};
+
+		/* vring1 */
+		rcpu0_vdev0vring1: vdev0vring1@c0879000 {
+			reg = <0x0 0xc0879000 0x0 0x3000>;
+			no-map;
+		};
+
+		/* rcpu0 misc-used */
+		rcpu0_misc_used: rcpu0_misc-used@c087c000 {
+			reg = <0x0 0xc087c000 0x0 0x4000>;
+			no-map;
+		};
+
+		/* the rcpu0's share memory buffer */
+		rcpu0_vdev0buffer: vdev0buffer@100600000 {
+			compatible = "shared-dma-pool";
+			reg = <0x1 0x600000 0x0 0xfc000>;
+			no-map;
+		};
+
+		/* the rcpu0's resource table */
+		rcpu0_rsc_table: rcpu0_rsc_table@1006fc000 {
+			reg = <0x1 0x6fc000 0x0 0x4000>;
+			no-map;
+		};
+
+		/*****************rcpu1**********************/
+		/* used for rcp1 code & data & bss space */
+		rcpu1_runtime: rcpu1_runtime@100800000 {
+			reg = <0x1 0x800000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* rcpu1's heap */
+		rcpu1_heap: rcpu1_heap@100a00000 {
+			reg = <0x1 0xa00000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* vring0 */
+		rcpu1_vdev0vring0: vdev0vring0@c086c000 {
+			reg = <0x0 0xc086c000 0x0 0x3000>;
+			no-map;
+		};
+
+		/* vring1 */
+		rcpu1_vdev0vring1: vdev0vring1@c086f000 {
+			reg = <0x0 0xc086f000 0x0 0x3000>;
+			no-map;
+		};
+
+		/* rcpu1 misc-used */
+		rcpu1_misc_used: rcpu1_misc-used@c0872000 {
+			reg = <0x0 0xc0872000 0x0 0x4000>;
+			no-map;
+		};
+
+		sram_for_tcm: sram_for_tcm@c0868000 {
+			reg = <0x0 0xc0868000 0x0 0x4000>;
+			no-map;
+		};
+
+		/* the rcpu1's share memory buffer */
+		rcpu1_vdev0buffer: vdev0buffer@100c00000 {
+			compatible = "shared-dma-pool";
+			reg = <0x1 0xc00000 0x0 0xfc000>;
+			no-map;
+		};
+
+		/* the rcpu1's resource table */
+		rcpu1_rsc_table: rcpu1_rsc_table@100cfc000 {
+			reg = <0x1 0xcfc000 0x0 0x4000>;
+			no-map;
+		};
+
+		/* rpmi */
+		rpmi0: rpmi0@100e00000 {
+			reg = <0x1 0xe00000 0x0 0x4000>;
+			no-map;
+		};
+
+		/* reseved rpmi for feture use */
+
+		/* reserve 1M for rcpu's dtb space */
+		rcpu_dtb_table: rcpu_dtb_table@100d00000 {
+			reg = <0x1 0xd00000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* reserved 5M for dpu, including mmu table and cmdlist */
+		dpu_resv0: dpu_reserved@101b00000 {
+			compatible = "shared-dma-pool";
+			reg = <0x1 0x01b00000 0x0 0x00280000>;
+			no-map;
+		};
+
+		dpu_resv1: dpu_reserved1@101d80000 {
+			compatible = "shared-dma-pool";
+			reg = <0x1 0x01d80000 0x0 0x00280000>;
+			no-map;
+		};
+	};
+
 	soc: soc {
 		compatible = "simple-bus";
 		interrupt-parent = <&saplic>;
-- 
2.55.0

