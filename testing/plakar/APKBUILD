# Contributor: Guy Godfroy <guy.godfroy@gugod.fr>
# Maintainer: Guy Godfroy <guy.godfroy@gugod.fr>
pkgname=plakar
pkgver=1.1.8
pkgrel=0
pkgdesc="backup solution powered by Kloset and ptar"
url="https://plakar.io/"
arch="all"
license="ISC"
makedepends="go"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/PlakarKorp/plakar/archive/refs/tags/v$pkgver.tar.gz
	fix-api-tests.patch
	"
options="net" #go deps

build() {
	go build -v .
}

check() {
	# TestRebuildStateVersionMismatch: deadlocks until the test timeout (leaked conn)
	# TestBackupMultipleIgnoreFileFlags: upstream shipped the test without the fix
	# TestPrune_*_PerMinuteCap: flaky when their two snapshots straddle a minute
	go test -skip 'TestRebuildStateVersionMismatch|TestBackupMultipleIgnoreFileFlags|TestPrune_.*_PerMinuteCap' ./...
}

package() {
	install -m755 -D plakar "$pkgdir"/usr/bin/plakar
	find plakar -iname "*.1" -exec install -m644 -D {} -t "$pkgdir"/usr/share/man/man1/ \;
	find plakar -iname "*.7" -exec install -m644 -D {} -t "$pkgdir"/usr/share/man/man7/ \;
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
86ae8f0cb9945776d2ff5c3ccffb3343696f08832abdb208e52e4f36bb879de4885f171d8da65f76ec34e1ead0a65f615d6b12e0b5edfbaabdf9edaa0026b2ba  plakar-1.1.8.tar.gz
629d31f2bde6b6eba581828c1d1de97ecd3da8e6cf4ac64a9aec7240784f4f1b248b1898618b163a540f1194ce2c25d75f985a9e526aca65775e3180f0136b9d  fix-api-tests.patch
"
