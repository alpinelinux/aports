e8dd5dee704d82cd3cbc3487a1bfd9f3906639cc6334b32f9ee504cfa701f523ae258a0f5bea5fe663ec2f8e894a6885c76e792c1c62d1ad7b2ac8616e8c9d82  disable-test.patch
