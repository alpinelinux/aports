# Maintainer: Vaishnav Sabari Girish <vaishnav.sabari.girish@gmail.com>
pkgname=miru
pkgver=0.15.0
pkgrel=0
pkgdesc="Wayland-native screen magnifier and cursor spotlight for wlroots compositors"
url="https://codeberg.org/Vaishnav-Sabari-Girish/miru"
arch="all"
license="MIT"
makedepends="
	cmake
	libnotify-dev
	libpng-dev
	mesa-dev
	samurai
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname"
options="!check" # no test suite

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
300d34738c4946541bcd743cf0c05655e0132fbd6289f07048335fb6db1574d28eda0e12a1363018d39f9758605a0c7d6d931223729a4bf0588c0e9dd9fea50b  miru-0.15.0.tar.gz
"
