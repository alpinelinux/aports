# Maintainer: Vaishnav Sabari Girish <vaishnav.sabari.girish@gmail.com>
pkgname=miru
pkgver=0.16.0
pkgrel=0
pkgdesc="Wayland-native screen magnifier and cursor spotlight for wlroots compositors"
url="https://codeberg.org/Vaishnav-Sabari-Girish/miru"
arch="all"
license="MIT"
makedepends="
	cmake
	libnotify-dev
	libpng-dev
	mesa-dev
	samurai
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname"
options="!check" # no test suite

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
157daa039fabb6b0537d659c83fa60dcca95d3b27fd2805bd22c9cba17f79e6997b3fd82458870fb3f7562163798f808fb70affe54b0fa399601f93f8c0499f8  miru-0.16.0.tar.gz
"
