maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-py-build-cmake
_pkgname=py-build-cmake
pkgver=0.5.1
pkgrel=0
pkgdesc="PEP 517 compliant build backend for CMake projects"
url="https://github.com/tttapa/py-build-cmake"
arch="noarch"
license="MIT"
depends="
	cmake
	py3-click
	py3-distlib
	py3-lark
	py3-packaging
	py3-pyproject-metadata
	"
makedepends="
	py3-distlib
	py3-gpep517
	py3-lark
	py3-packaging
	py3-pyproject-metadata
	py3-setuptools
	py3-wheel
	"
options="!check"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/py_build_cmake-$pkgver.tar.gz"
builddir="$srcdir/py_build_cmake-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
