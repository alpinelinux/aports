# Contributor: lauren n. liberda <lauren@selfisekai.rocks>
maintainer="lauren n. liberda <lauren@selfisekai.rocks>"
pkgname=ghostty
pkgver=1.3.1_git20260810
pkgrel=1
_commit=7e463bc65d430e8a8f0aa786abf83601cf2b9598
_libver=0.1.0-alpha
pkgdesc="Fast, feature-rich, and cross-platform terminal emulator"
url="https://ghostty.org/"
arch="aarch64 x86_64"
license="MIT"
makedepends="
	blueprint-compiler
	fontconfig-dev
	freetype-dev
	glslang-dev
	gtk4.0-dev
	gtk4-layer-shell-dev
	harfbuzz-dev
	highway-dev
	libadwaita-dev
	libpng-dev
	ncurses
	oniguruma-dev
	simdutf-dev
	zig
	zlib-dev
	"
# !check: manual test suite
# net: zig dependencies
options="!check net"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	$pkgname-dev
	$pkgname-libs-static
	$pkgname-libs
	"
#	https://release.files.ghostty.org/$pkgver/ghostty-$pkgver.tar.gz
source="
	https://github.com/ghostty-org/ghostty/archive/$_commit/ghostty-$_commit.tar.gz
	"
builddir="$srcdir/ghostty-$_commit"

build() {
	DESTDIR=zig-out zig build \
		--release=small \
		-Dcpu=baseline \
		-Dlib-version-string="$_libver" \
		-fsys=fontconfig \
		-fsys=freetype \
		-fsys=glslang \
		-fsys=gtk4-layer-shell \
		-fsys=harfbuzz \
		-fsys=highway \
		-fsys=libpng \
		-fsys=oniguruma \
		-fsys=simdutf \
		-fsys=zlib
}

package() {
	mkdir -p "$pkgdir"
	cp -r zig-out/usr "$pkgdir"/usr
	# conflicts with ncurses-terminfo
	rm -r "$pkgdir"/usr/share/terminfo/g/
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
408b2f5eb37bc8445a2a468ee074817233eb75c976a314bb89fa5c38be87782b62fedbea7b7840278d37c36483ef62273d82d18248443812336544785b4959a3  ghostty-7e463bc65d430e8a8f0aa786abf83601cf2b9598.tar.gz
"
