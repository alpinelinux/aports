# Contributor: lauren n. liberda <lauren@selfisekai.rocks>
maintainer="lauren n. liberda <lauren@selfisekai.rocks>"
pkgname=ghostty
pkgver=1.3.1_git20260908
pkgrel=0
_commit=b0c421fcd2e290629d4285c181b52fe2f2095f06
_libver=0.1.0-alpha
pkgdesc="Fast, feature-rich, and cross-platform terminal emulator"
url="https://ghostty.org/"
arch="aarch64 x86_64"
license="MIT"
makedepends="
	blueprint-compiler
	fontconfig-dev
	freetype-dev
	glslang-dev
	gtk4.0-dev
	gtk4-layer-shell-dev
	harfbuzz-dev
	highway-dev
	libadwaita-dev
	libpng-dev
	ncurses
	oniguruma-dev
	simdutf-dev
	zig
	zlib-dev
	"
# !check: manual test suite
# net: zig dependencies
options="!check net"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	$pkgname-dev
	$pkgname-libs-static
	$pkgname-libs
	"
#	https://release.files.ghostty.org/$pkgver/ghostty-$pkgver.tar.gz
source="
	https://github.com/ghostty-org/ghostty/archive/$_commit/ghostty-$_commit.tar.gz
	"
builddir="$srcdir/ghostty-$_commit"

build() {
	DESTDIR=zig-out zig build \
		--release=small \
		-Dcpu=baseline \
		-Dlib-version-string="$_libver" \
		-fsys=fontconfig \
		-fsys=freetype \
		-fsys=glslang \
		-fsys=gtk4-layer-shell \
		-fsys=harfbuzz \
		-fsys=highway \
		-fsys=libpng \
		-fsys=oniguruma \
		-fsys=simdutf \
		-fsys=zlib
}

package() {
	mkdir -p "$pkgdir"
	cp -r zig-out/usr "$pkgdir"/usr
	# conflicts with ncurses-terminfo
	rm -r "$pkgdir"/usr/share/terminfo/g/
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
50aefee3758d5601ea78a35c3cba99ee7fa5e92c071f80d359e11894a80587ba25ba5bf0ff73558ed0de2b312945f4f5df169cdd668bc1c0c0a13a1ba8c95a84  ghostty-b0c421fcd2e290629d4285c181b52fe2f2095f06.tar.gz
"
