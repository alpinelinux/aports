# Contributor: lauren n. liberda <lauren@selfisekai.rocks>
maintainer="lauren n. liberda <lauren@selfisekai.rocks>"
pkgname=ghostty
pkgver=1.4.0_git20261104
pkgrel=0
_commit=3de71293034969aaa09ad6f19ee53a9d23087403
_libver=0.1.0-alpha
pkgdesc="Fast, feature-rich, and cross-platform terminal emulator"
url="https://ghostty.org/"
arch="aarch64 x86_64"
license="MIT"
makedepends="
	blueprint-compiler
	fontconfig-dev
	freetype-dev
	glslang-dev
	gtk4.0-dev
	gtk4-layer-shell-dev
	harfbuzz-dev
	highway-dev
	libadwaita-dev
	libpng-dev
	ncurses
	oniguruma-dev
	simdutf-dev
	zig
	zlib-dev
	"
# !check: manual test suite
# net: zig dependencies
options="!check net"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	$pkgname-dev
	$pkgname-libs
	"
#	https://release.files.ghostty.org/$pkgver/ghostty-$pkgver.tar.gz
source="
	https://github.com/ghostty-org/ghostty/archive/$_commit/ghostty-$_commit.tar.gz
	"
builddir="$srcdir/ghostty-$_commit"

build() {
	for _artefact in lib-vt exe; do
		msg "Building $_artefact"
		DESTDIR=zig-out zig build \
			--release=small \
			-Dcpu=baseline \
			-Dlib-version-string="$_libver" \
			-Demit-$_artefact \
			-fsys=fontconfig \
			-fsys=freetype \
			-fsys=glslang \
			-fsys=gtk4-layer-shell \
			-fsys=harfbuzz \
			-fsys=highway \
			-fsys=libpng \
			-fsys=oniguruma \
			-fsys=simdutf \
			-fsys=zlib
	done
}

package() {
	mkdir -p "$pkgdir"
	cp -r zig-out/usr "$pkgdir"/usr
	# conflicts with ncurses-terminfo
	rm -r "$pkgdir"/usr/share/terminfo/g/
	# nonsense: static library requires our dynamic libs
	rm "$pkgdir"/usr/lib/libghostty-vt.a
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
ae7b5c706d8d5e7d71e48c8396de584a3d0d46d8a2f1575741a086183d1fdf5ed97e8d6748fd8eccbdd43ba5dcd8d8cb9b53f3790dde7f9f1d57f805af89c829  ghostty-3de71293034969aaa09ad6f19ee53a9d23087403.tar.gz
"
