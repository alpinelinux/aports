From c6cce4a6e047928ff21a074c9f5419fad7288f3e Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Thu, 22 Oct 2026 08:56:43 -0400
Subject: [PATCH] SpacemiT: Add reserved-memory node to k1 and k3 dtsi

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/riscv/boot/dts/spacemit/k1.dtsi | 50 ++++++++++++++++++++++++++++
 arch/riscv/boot/dts/spacemit/k3.dtsi | 50 ++++++++++++++++++++++++++++
 2 files changed, 100 insertions(+)

diff --git a/arch/riscv/boot/dts/spacemit/k1.dtsi b/arch/riscv/boot/dts/spacemit/k1.dtsi
index 3fabfd34114b..73fe8f50b57c 100644
--- a/arch/riscv/boot/dts/spacemit/k1.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k1.dtsi
@@ -349,6 +349,56 @@ osc_32k: clock-32k {
 		};
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		rcpu_mem_0: mem@c0800000 {
+			reg = <0x0 0xc0800000 0x0 0x40000>;
+			no-map;
+		};
+
+		rcpu_mem_1: mem@30000000 {
+			reg = <0x0 0x30000000 0x0 0x200000>;
+			no-map;
+		};
+
+		vdev0vring0: vdev0vring0@30200000 {
+			reg = <0x0 0x30200000 0x0 0x3000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@30203000 {
+			reg = <0x0 0x30203000 0x0 0x3000>;
+			no-map;
+		};
+
+		vdev0buffer: vdev0buffer@30206000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x30206000 0x0 0xf6000>;
+			no-map;
+		};
+
+		rsc_table: rsc_table@302fc000 {
+			reg = <0x0 0x302fc000 0x0 0x4000>;
+			no-map;
+		};
+
+		rcpu_mem_snapshots: rcpu_mem_snapshots@30300000 {
+			reg = <0x0 0x30300000 0x0 0x40000>;
+			no-map;
+		};
+
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			linux,cma-default;
+			size = <0x0 0x18000000>; /* 384 MiB */
+			alloc-ranges = <0x0 0x50000000 0x0 0xefffffff>;
+		};
+	};
+
 	thermal-zones {
 		soc-thermal {
 			polling-delay-passive = <0>;
diff --git a/arch/riscv/boot/dts/spacemit/k3.dtsi b/arch/riscv/boot/dts/spacemit/k3.dtsi
index c3f2dce0969c..4dfd0388eff2 100644
--- a/arch/riscv/boot/dts/spacemit/k3.dtsi
+++ b/arch/riscv/boot/dts/spacemit/k3.dtsi
@@ -433,6 +433,56 @@ osc_32k: clock-32k {
 		};
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		rcpu_mem_0: mem@c0800000 {
+			reg = <0x0 0xc0800000 0x0 0x40000>;
+			no-map;
+		};
+
+		rcpu_mem_1: mem@30000000 {
+			reg = <0x0 0x30000000 0x0 0x200000>;
+			no-map;
+		};
+
+		vdev0vring0: vdev0vring0@30200000 {
+			reg = <0x0 0x30200000 0x0 0x3000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@30203000 {
+			reg = <0x0 0x30203000 0x0 0x3000>;
+			no-map;
+		};
+
+		vdev0buffer: vdev0buffer@30206000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x30206000 0x0 0xf6000>;
+			no-map;
+		};
+
+		rsc_table: rsc_table@302fc000 {
+			reg = <0x0 0x302fc000 0x0 0x4000>;
+			no-map;
+		};
+
+		rcpu_mem_snapshots: rcpu_mem_snapshots@30300000 {
+			reg = <0x0 0x30300000 0x0 0x40000>;
+			no-map;
+		};
+
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			linux,cma-default;
+			size = <0x0 0x18000000>; /* 384 MiB */
+			alloc-ranges = <0x0 0x50000000 0x0 0xefffffff>;
+		};
+	};
+
 	soc: soc {
 		compatible = "simple-bus";
 		interrupt-parent = <&saplic>;
-- 
2.53.0

