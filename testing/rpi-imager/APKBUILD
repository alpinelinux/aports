b1a027733dc280613f48fd46352c944f0f4a214e063757597f03509a032d6b56f5a7b8312c15034d90bb6c8fb92881c510dbacb19ebe4660f61a812cf4ad1649  devendor.patch
f9f883bb0703eeecb9dc508315ac30a0c551c9418e3ebd9a71d64508856858a418c1e2f22425c1e047ee46d56abdb6c819505da3bf8cdeba2d9cd71c906b8c22  alpine.patch
