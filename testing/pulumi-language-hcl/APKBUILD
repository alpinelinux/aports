maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=pulumi-language-hcl
pkgver=0.18.0
pkgrel=0
pkgdesc="Infrastructure as Code SDK (HCL language provider)"
url="https://pulumi.com/"
# blocked by pulumi
arch="x86_64 aarch64"
license="Apache-2.0"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/pulumi/pulumi-hcl/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/pulumi-hcl-$pkgver"
options="net" # download Go modules

build() {
	mkdir -p out
	go build -v \
		-ldflags "-X github.com/pulumi/pulumi-hcl/pkg/version.version=v$pkgver" \
		-o out/ \
		./cmd/...
}

check() {
	# TestSmoke is broken.
	# TestEncodingFunctions is temporarily broken with a mismatched base64 assert.
	local skip_tests="TestSmoke|TestEncodingFunctions"

	# TestLanguage subtests fail on the aarch64 builder
	# failed to listen on TCP port ':0': listen tcp 127.0.0.1:0:
	# socket: too many open files
	case "$CARCH" in
		aarch64) skip_tests="$skip_tests|TestLanguage" ;;
	esac

	# putest and mlctest panic.
	# tfcompat tests require pulumi, opentofu, pulumi-language-yaml and remote providers (some still fail even when all of those are installed).
	# shellcheck disable=2046
	go test -skip "$skip_tests" $(go list ./... | grep -v -E '/tests/(tfcompat|putest|mlctest)$')
}

package() {
	install -Dm755 out/pulumi-language-hcl out/pulumi-converter-hcl out/pulumi-resource-hcl \
		-t "$pkgdir"/usr/bin/
}

sha512sums="
3d657c95da3c86cb6b923aaf6e4ed2a27421290acf1f88c6151a114607bd6bb27842b061c9bb37ddb315d99cf8477b46e6ba460af604cdd2df580413027a42f6  pulumi-language-hcl-0.18.0.tar.gz
"
