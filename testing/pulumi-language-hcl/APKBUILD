maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=pulumi-language-hcl
pkgver=0.12.0
pkgrel=0
pkgdesc="Infrastructure as Code SDK (HCL language provider)"
url="https://pulumi.com/"
# blocked by pulumi
arch="x86_64 aarch64"
license="Apache-2.0"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/pulumi/pulumi-hcl/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/pulumi-hcl-$pkgver"
options="net" # download Go modules

build() {
	mkdir -p out
	go build -v \
		-ldflags "-X github.com/pulumi/pulumi-hcl/pkg/version.version=v$pkgver" \
		-o out/ \
		./cmd/...
}

check() {
	# Avoid error "socket: too many open files"
	ulimit -n 4096

	# tfcompat tests require pulumi, opentofu, pulumi-language-yaml and remote providers (some still fail even when all of those are installed).
	# TestSmoke is broken.
	# shellcheck disable=2046
	go test -skip "TestSmoke" $(go list ./... | grep -v '/tests/tfcompat$')
}

package() {
	install -Dm755 out/pulumi-language-hcl out/pulumi-converter-hcl out/pulumi-resource-hcl \
		-t "$pkgdir"/usr/bin/
}

sha512sums="
f3b5e860b72316b61683e4886f164987e51d7b0ea86f16c96277a59fc32ca60a282197f1057cb715f023d2ebb5aae71a578de165cb0441c62022488bc961c8c9  pulumi-language-hcl-0.12.0.tar.gz
"
