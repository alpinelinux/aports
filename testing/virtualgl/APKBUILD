acd348b3005840869baf3f51b0e66bcfbbc93bab2630460a6801a972a13cf428bfe6bee1fac409fe927f0a9d9f6a498ab08c36c4b892b073511503ab81557089  install.patch
cae0311103ec25dc209b834baa83f8bd21477b77dbdd7cdd76dc5031dd84945b89305d3352de65e253f6ea99d8b631ee113a33a00f9c4290904cd6953b22e5af  non-glvnd-mesa.patch
"
