# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=gsettings-qt
pkgver=1.1.1
pkgrel=1
pkgdesc="Library to access GSettings from Qt"
url="https://gitlab.com/ubports/development/core/gsettings-qt"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
license="LGPL-3.0-only"
depends_dev="qt6-qtdeclarative-dev"
depends_dev_qt5="qt5-qtdeclarative-dev"
makedepends="
	$depends_dev
	$depends_dev_qt5
	cmake
	cmake-extras
	glib-dev
	qt5-qtbase-dev
	qt6-qtbase-dev
	samurai
	"
checkdepends="xvfb-run"
subpackages="
	$pkgname-qt5
	$pkgname-qt5-dev:qt5_dev
	$pkgname-dev
	"
source="https://gitlab.com/ubports/development/core/gsettings-qt/-/archive/v$pkgver/gsettings-qt-v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-v$pkgver"

build() {
	cmake -B build-qt6 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DBUILD_TESTING=ON \
		-DENABLE_QT6=ON
	cmake --build build-qt6

	cmake -B build-qt5 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DBUILD_TESTING=ON \
		-DENABLE_QT6=OFF
	cmake --build build-qt5

}

check() {
	ctest --test-dir build-qt6
}

package() {
	DESTDIR="$pkgdir" cmake --install build-qt6
	DESTDIR="$pkgdir" cmake --install build-qt5
}

qt5() {
	amove usr/lib/libgsettings-qt.so*
	amove usr/lib/qt5
}

qt5_dev() {
	depends="
		$pkgname-qt5
		$depends_dev_qt5
		"

	amove usr/include/qt5
	amove usr/lib/pkgconfig/gsettings-qt.pc
}

sha512sums="
65836619d5d6213535d0573944bcba312078744e9cb403e414cda9985dcb5f016f3aab86c9599c4d1a6837f1f7cf128b49024cf6e5be0e76a0d17c02da83ba16  gsettings-qt-v1.1.1.tar.gz
"
