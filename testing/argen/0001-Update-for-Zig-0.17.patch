diff --git a/build.zig b/build.zig
index 6c00eea..5fd39ce 100644
--- a/build.zig
+++ b/build.zig
@@ -6,6 +6,7 @@ const Build = std.Build;
 const manifest = @import("build.zig.zon");
 const version = manifest.version;
 
+const Translator = @import("translate_c").Translator;
 const Scanner = @import("wayland").Scanner;
 
 pub fn build(b: *Build) !void {
@@ -16,19 +17,14 @@ pub fn build(b: *Build) !void {
         bool,
         "man-pages",
         "Set to true to build man pages. Requires scdoc. Defaults to true if scdoc is found.",
-    ) orelse scdoc_found: {
-        _ = b.findProgram(&.{"scdoc"}, &.{}) catch |err| switch (err) {
-            error.FileNotFound => break :scdoc_found false,
-        };
-        break :scdoc_found true;
-    };
+    ) orelse (b.findProgram(.{ .names = &.{"scdoc"} }) != null);
 
     const full_version = blk: {
         if (mem.endsWith(u8, version, "-dev")) {
             var ret: u8 = undefined;
 
             const git_describe_long = b.runAllowFail(
-                &.{ "git", "-C", b.build_root.path orelse ".", "describe", "--long" },
+                &.{ "git", "-C", b.fmt("{f}", .{b.root}), "describe", "--long" },
                 &ret,
                 .inherit,
             ) catch break :blk version;
@@ -75,6 +71,17 @@ pub fn build(b: *Build) !void {
     const pixman = b.dependency("pixman", .{}).module("pixman");
     const fcft = b.dependency("fcft", .{}).module("fcft");
 
+    const translate_c = b.dependency("translate_c", .{});
+
+    const trans: Translator = .init(translate_c, .{
+        .c_source_file = b.path("src/argen/c.h"),
+        .target = target,
+        .optimize = optimize,
+        .link_system_libs = &.{
+            .{ .name = "libevdev" },
+        },
+    });
+
     const socket_config = b.createModule(.{
         .root_source_file = b.path("src/common/SocketConfig.zig"),
         .target = target,
@@ -93,6 +100,9 @@ pub fn build(b: *Build) !void {
             .root_source_file = b.path("src/argen/main.zig"),
             .target = target,
             .optimize = optimize,
+            .imports = &.{
+                .{ .name = "c", .module = trans.mod },
+            },
         }),
     });
 
