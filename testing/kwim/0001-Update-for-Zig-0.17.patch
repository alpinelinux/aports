                 .rules = if (xkb_keymap_rules) |rules| rules.ptr else null,
diff --git a/src/main.zig b/src/main.zig
index 3cedf9d..23aa95d 100644
--- a/src/main.zig
+++ b/src/main.zig
@@ -24,7 +24,10 @@ const Globals = struct {
 
 
