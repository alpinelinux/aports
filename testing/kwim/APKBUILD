f0003a16cc5007f5afe4fe137f15c5e12831642f6c084a7231c7d81539dc1ad8012797b1254d7905685de157ad6e6d1cfd4e6792276f2428b501f71c9c4569f4  0001-Update-for-Zig-0.17.patch
"
