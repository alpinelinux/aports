maintainer="Michał Polański <michal@polanski.me>"
pkgname=warp-s3
pkgver=1.8.2
pkgrel=0
pkgdesc="Benchmarking tool for S3"
url="https://github.com/minio/warp"
license="AGPL-3.0"
arch="all"
makedepends="go"
options="net"
source="$pkgname-$pkgver-1.tar.gz::https://github.com/minio/warp/archive/v$pkgver/warp-s3-$pkgver.tar.gz"
builddir="$srcdir/warp-$pkgver"

build() {
	go build \
		-ldflags "-X github.com/minio/warp/pkg.Version=$pkgver" \
		-o warp-s3
}

check() {
	go test ./...
}

package() {
	install -Dm755 $pkgname -t "$pkgdir"/usr/bin/
}

sha512sums="
