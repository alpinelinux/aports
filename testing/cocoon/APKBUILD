1dcde51567ddcb658012d189ad4e70f6df45322f4bba878e9b75bdf553579c517e76dcce311a4fa344a56ba37507e5425f6bb08f329d1edefc2834d4891aa2db  cocoon.initd
41b874eebb1e67096bfa56deb427b085c02bb45a0f445dda18215f31338d895c7f42288a9210ab6682baa4c4e2334b0fbafb3c53749847090296992133b0b8ad  cocoon.confd
"
