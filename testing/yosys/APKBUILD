# Contributor: Dominika Liberda <ja@sdomi.pl>
# Maintainer: Dominika Liberda <ja@sdomi.pl>
pkgname=yosys
pkgver=0.68
pkgrel=0
pkgdesc="Yosys Open SYnthesis Suite"
url="https://yosyshq.net"
# s390x: https://github.com/YosysHQ/yosys/issues/2645
arch="all !s390x"
license="ISC"
depends="
	abc
	"
makedepends="
	bash
	bison
	boost1.89-dev
	cmake
	flex-dev
	gawk
	graphviz-dev
	libffi-dev
	lld
	py3-cxxheaderparser
	py3-pybind11-dev
	python3
	readline-dev
	samurai
	tcl-dev
	zlib-dev
	"
checkdepends="
	gtest-dev
	gtkwave
	iverilog
	"
subpackages="
	$pkgname-dev
	py3-$pkgname:py3:noarch
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/YosysHQ/yosys/releases/download/v$pkgver/yosys.tar.gz"
builddir="$srcdir"

build() {
	# slang unconditionally uses unsigned __int128 causing build failures on 32-bit archs
	case "$CARCH" in
		x86|arm*) _without_slang=ON ;;
		*) _without_slang=OFF ;;
	esac

	# Not using LTO, GCC's LTO codegen fails to inline fortify-headers always_inline vsnprintf wrapper, erroring with
	# "function body can be overwritten at link time". Tests also segfault with LTO enabled. Not unique to Alpine:
	# https://gitlab.archlinux.org/archlinux/packaging/packages/yosys/-/blob/main/PKGBUILD?ref_type=heads#L20
	CC=gcc CXX=g++ cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DYOSYS_ABC_EXECUTABLE=/usr/bin/abc \
		-DYOSYS_INSTALL_LIBRARY=ON \
		-DYOSYS_INSTALL_PYTHON=ON \
		-DYOSYS_WITH_PYTHON=ON \
		-DYOSYS_WITHOUT_SLANG=$_without_slang
	cmake --build build
}

check() {
	cmake --build build --target test
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	# link python to the global yosys
	ln -sfv /usr/lib/yosys/libyosys.so "$pkgdir"/usr/lib/python3*/site-packages/pyosys/libyosys.so
}

py3() {
	pkgdesc="$pkgdesc (python module)"
	depends="python3 $pkgname=$pkgver-r$pkgrel"

	amove usr/lib/python3*
}

sha512sums="
