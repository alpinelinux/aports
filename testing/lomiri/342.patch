From 4ee44683f2d50451638004682cf96592233a5dd3 Mon Sep 17 00:00:00 2001
From: Henrik Schnor <hschnor@mailbox.org>
Date: Tue, 29 Sep 2026 22:30:36 +0200
Subject: [PATCH] Disable Mir's internal decorations

Mir currently doesn't support not drawing its own decorations while
negotiating server-side decorations with clients. Until an official API
for that is implemented, a Debian patch makes it possible to disable
Mir's internal decorations:
https://gitlab.com/ubports/development/core/packaging/mir2/-/merge_requests/4

This commit sets the environment variable to make use of that.
---
 src/main.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/main.cpp b/src/main.cpp
index d8dabfb00..6a8a05562 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -43,6 +43,10 @@ int main(int argc, const char *argv[])
         setenv("MIR_SERVER_CURSOR", "null", 1);
     }
 
+    // Workaround to disable internal Mir decorations until an API for that is implemented.
+    // See: https://gitlab.com/ubports/development/core/packaging/mir2/-/merge_requests/4
+    setenv("MIR_DISABLE_SSD_DRAWING", "1", 1);
+
     if (enableQmlDebugger(argc, argv)) {
         QQmlDebuggingEnabler qQmlEnableDebuggingHelper(true);
     }
-- 
GitLab

