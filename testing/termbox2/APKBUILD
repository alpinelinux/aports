# Maintainer: Amelia Clarke <selene@perilune.dev>
pkgname=termbox2
pkgver=2.7.0_git20260830
pkgrel=0
_commit=5d60ed6853fff52717559fa380e57d7876157aa6
pkgdesc="Slim terminal I/O library"
url="https://github.com/termbox/termbox2"
arch="all"
license="MIT"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/termbox/termbox2/archive/$_commit.tar.gz
	termbox2.pc
	"
builddir="$srcdir/$pkgname-$_commit"
options="!check" # tests require docker, xvfb

prepare() {
	default_prepare
	sed -i "s/@VERSION@/$pkgver/g" "$srcdir"/termbox2.pc
}

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" prefix=/usr install_lib
	install -Dm644 -t "$pkgdir"/usr/lib/pkgconfig "$srcdir"/termbox2.pc
	install -Dm644 -t "$pkgdir"/usr/share/licenses/"$pkgname" LICENSE
}

sha512sums="
