# Maintainer: Graham King <grking.email@gmail.com>
maintainer="Graham King <grking.email@gmail.com>"
pkgname=framework-tool-tui
pkgver=0.7.6
pkgrel=0
pkgdesc="A TUI for controlling and monitoring Framework Computers hardware"
url="https://github.com/grouzen/framework-tool-tui"
arch="x86_64" # framework hardware is x86_64 only
license="MIT"
options="net" # cargo fetch
depends="eudev-libs"
makedepends="cargo cargo-auditable eudev-dev linux-headers"
subpackages="$pkgname-doc"
source="https://github.com/grouzen/framework-tool-tui/archive/v$pkgver/framework-tool-tui-$pkgver.tar.gz"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 ./target/release/framework-tool-tui "$pkgdir/usr/bin/$pkgname"
	install -Dm644 ./LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}


sha512sums="
3d1cf2d7a8d81774cb47e3677b722412d641f2992547e9aed40a965bac944747b63517a80791461f8f861cc145847ae60cbe582e406381a8f25d0fff90eab8d7  framework-tool-tui-0.7.6.tar.gz
"
