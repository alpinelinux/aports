maintainer="leso-kn <info@lesosoftware.com>"
pkgname=sfizz
pkgver=1.2.3
pkgrel=4
_auwrapper_commit=4ad0429a38b8aad3d823ca398ec7e72874a2f236
_drlibs_commit=e4a7765e598e9e54dc0f520b7e4416359bee80cc
_libaiff_commit=78864a4a2e769e426be8cfd78ae7f5f72e236c33
_pluginterfaces_commit=37de655a51b28a558645621b39d48a00292be5e2
_sfizz_commit=4e70dc0bef53b41f2853ed46e26f5911114c92d0
_simde_commit=2bf459d4ed6d7ed6b9f31bd9e07c91bace5009e0
_vstbase_commit=efd9bf7877097bf23950bff48af5f3a4eef345a1
_vstgui_commit=18d9ec4646cf075745dc90b452ace35262cd17c4
_vstsdk_commit=e099a33fe9d78295f58f919ec3bb58968dd5752c
pkgdesc="SFZ parser and synth c++ library, providing a JACK standalone client"
url="https://sfztools.github.io/sfizz/"
# loongarch64, ppc64le, riscv64 and s390 are unsupported by atomic_queue
arch="all !loongarch64 !ppc64le !riscv64 !s390x"
license="BSD-2-Clause"
makedepends="
	abseil-cpp-dev
	cmake
	cxxopts-dev
	ghc-filesystem
	jack-dev
	libsamplerate-dev
	lv2-dev
	pango-dev
	pugixml-dev
	samurai
	simde-dev
	libxkbcommon-dev
	xcb-util-cursor-dev
	xcb-util-keysyms-dev
	wavpack-dev
	"
case "$CARCH" in
	# optional openmp-dev is unavailable on armhf
	armhf) ;;
	*) makedepends="$makedepends openmp-dev" ;;
esac
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-lv2
	$pkgname-vst3
	"
source="
	sfizz-ui-$pkgver.tar.gz::https://github.com/sfztools/sfizz-ui/archive/refs/tags/$pkgver.tar.gz
	auwrapper-$_auwrapper_commit.tar.gz::https://github.com/sfztools/sfzt_auwrapper/archive/$_auwrapper_commit.tar.gz
	dr_libs-$_drlibs_commit.tar.gz::https://github.com/mackron/dr_libs/archive/$_drlibs_commit.tar.gz
	libaiff-$_libaiff_commit.tar.gz::https://github.com/sfztools/libaiff/archive/$_libaiff_commit.tar.gz
	pluginterfaces-$_pluginterfaces_commit.tar.gz::https://github.com/steinbergmedia/vst3_pluginterfaces/archive/$_pluginterfaces_commit.tar.gz
	sfizz-$_sfizz_commit.tar.gz::https://github.com/sfztools/sfizz/archive/$_sfizz_commit.tar.gz
	simde-$_simde_commit.tar.gz::https://github.com/simd-everywhere/simde/archive/$_simde_commit.tar.gz
	vstbase-$_vstbase_commit.tar.gz::https://github.com/steinbergmedia/vst3_base/archive/$_vstbase_commit.tar.gz
	vstgui-$_vstgui_commit.tar.gz::https://github.com/sfztools/vstgui/archive/$_vstgui_commit.tar.gz
	vstsdk-$_vstsdk_commit.tar.gz::https://github.com/steinbergmedia/vst3_public_sdk/archive/$_vstsdk_commit.tar.gz
	system.patch.noauto
	sfizz-1314_fix-crash-in-fillinterpolated.patch.noauto
	"

builddir="$srcdir"/sfizz-ui-$pkgver

unpack() {
	default_unpack

	# auwrapper
	rmdir "$builddir"/plugins/vst/external/sfzt_auwrapper 2>/dev/null || true
	ln -sf "$srcdir"/sfzt_auwrapper-$_auwrapper_commit "$builddir"/plugins/vst/external/sfzt_auwrapper

	# pluginterfaces
	rmdir "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/pluginterfaces 2>/dev/null || true
	ln -sf "$srcdir"/vst3_pluginterfaces-$_pluginterfaces_commit "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/pluginterfaces

	# sfizz
	rmdir "$builddir"/library 2>/dev/null || true
	ln -sf "$srcdir"/sfizz-$_sfizz_commit "$builddir"/library

	# vstbase
	rmdir "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/base 2>/dev/null || true
	ln -sf "$srcdir"/vst3_base-$_vstbase_commit "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/base

	# vstgui
	rmdir "$builddir"/plugins/editor/external/vstgui4 2>/dev/null || true
	ln -sf "$srcdir"/vstgui-$_vstgui_commit "$builddir"/plugins/editor/external/vstgui4

	# vstsdk
	rmdir "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/public.sdk 2>/dev/null || true
	ln -sf "$srcdir"/vst3_public_sdk-$_vstsdk_commit "$builddir"/plugins/vst/external/VST_SDK/VST3_SDK/public.sdk

	# drlibs
	rmdir "$builddir"/library/external/st_audiofile/thirdparty/dr_libs 2>/dev/null || true
	ln -vs "$srcdir"/dr_libs-$_drlibs_commit "$builddir"/library/external/st_audiofile/thirdparty/dr_libs

	# libaiff
	rmdir "$builddir"/library/external/st_audiofile/thirdparty/libaiff 2>/dev/null || true
	ln -vs "$srcdir"/libaiff-$_libaiff_commit "$builddir"/library/external/st_audiofile/thirdparty/libaiff

	# simde
	rmdir "$builddir"/library/external/simde 2>/dev/null || true
	ln -vs "$srcdir"/simde-$_simde_commit "$builddir"/library/external/simde

}

prepare() {
	default_prepare

	cd "$srcdir"
	for patch in *.patch.noauto; do
		patch -p1 < "$patch"
	done
}

build() {
	CFLAGS="$CFLAGS -O2 -flto=auto" \
	CXXFLAGS="$CXXFLAGS -O2 -flto=auto -Wno-sign-compare -Wno-template-body -U_FORTIFY_SOURCE" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DSFIZZ_USE_SYSTEM_ABSEIL=ON \
		-DSFIZZ_USE_SYSTEM_CXXOPTS=ON \
		-DSFIZZ_USE_SYSTEM_GHC_FS=ON \
		-DSFIZZ_USE_SYSTEM_LV2=ON \
		-DSFIZZ_USE_SYSTEM_PUGIXML=ON \
		-DSFIZZ_USE_SYSTEM_SIMDE=ON \
		-DSFIZZ_TESTS=ON
	cmake --build build
}

check() {
	cd library && "$builddir"/build/library/bin/sfizz_tests
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

lv2() {
	pkgdesc="SFZ based sampler (LV2 plugin)"
	amove /usr/lib/lv2
}

vst3() {
	pkgdesc="SFZ based sampler (VST3 plugin)"
	amove /usr/lib/vst3
}

