diff --git a/sfizz-4e70dc0bef53b41f2853ed46e26f5911114c92d0/cmake/GitSubmoduleCheck.cmake b/sfizz-4e70dc0bef53b41f2853ed46e26f5911114c92d0/cmake/GitSubmoduleCheck.cmake
