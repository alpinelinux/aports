f05cb172f704f4c5d03f98825a9788c0afb43d20d9adf39ce2ceaaa6cf60c4e29242b701f9296bc77035ee82cbbe109cebd5894f52528b550d3d7b7afbfc1431  fix-exiv2.patch
"
