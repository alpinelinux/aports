# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=afew
pkgver=4.0.0
pkgrel=0
pkgdesc="initial tagging script for notmuch"
url="https://github.com/afewmail/afew"
# s390x: failing test
arch="all !s390x"
license="ISC"
depends="
	py3-chardet
	py3-dkimpy
	py3-notmuch
	notmuch
"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-sphinx
	py3-wheel
"
checkdepends="
	py3-pytest
	py3-pytest-freezegun
"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/afewmail/afew/archive/refs/tags/$pkgver.tar.gz"

build() {
	# https://github.com/afewmail/afew/issues/283
	echo "version = \"$pkgver\"" > "$builddir/afew/version.py"

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	PYTHONPATH="$builddir" sphinx-build -b man docs/ build/
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
	install -Dm644 build/"$pkgname".1 \
		-t "$pkgdir"/usr/share/man/man1
}

sha512sums="
1ef9dcf5811f3f94b60f1d1db3b5d6bac6f69bb78b9646f648ee923558417a858d2895d715d38f84bb1aa363460498e44badd198278c0f801814e448803d5c0d  afew-4.0.0.tar.gz
"
