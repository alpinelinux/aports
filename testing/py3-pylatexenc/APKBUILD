# Maintainer: Struan Robertson <contact@struanrobertson.co.uk>
pkgname=py3-pylatexenc
_pkgname=pylatexenc
pkgver=2.11
pkgrel=0
pkgdesc="Simple LaTeX parser providing latex-to-unicode and unicode-to-latex conversion"
url="https://github.com/phfaist/pylatexenc/"
arch="noarch"
license="MIT"
depends="python3"
makedepends="
	py3-setuptools_scm
	py3-gpep517
	py3-wheel
"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://github.com/phfaist/pylatexenc/archive/v$pkgver/pylatexenc-v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --system-site-packages .testenv
	.testenv/bin/python -m installer .dist/*.whl
	.testenv/bin/python -m pytest
}

package() {
	python3 -m installer \
		-d "$pkgdir" \
		.dist/*.whl
}


sha512sums="
35c84ddb8624d911be1046e1276b225dbcf242a8b711f2532fb7dd80858966f6ef88b97434b7bf4193382788733e216070927513faa4c88cfed6a57150fa40f6  pylatexenc-v2.11.tar.gz
"
