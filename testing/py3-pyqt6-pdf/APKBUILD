# Maintainer: John Vogel <jvogel@stygian.me>
maintainer="John Vogel <jvogel@stygian.me>"
pkgname=py3-pyqt6-pdf
pkgver=6.140.1
pkgrel=0
pkgdesc="Python Bindings for the Qt PDF Library"
url="https://www.riverbankcomputing.com/software/pyqtpdf/"
# armhf: blocked by qt6-qtdeclarative
# others blocked by qt6-qtwebengine
arch="all !riscv64 !s390x !armhf !armv7 !x86"
license="GPL-3.0-only"
options="!check" # No test suite
depends="py3-qt6"
makedepends="
	py3-gpep517
	py3-pyqt-builder
	py3-sip
	python3-dev
	qt6-qtbase-dev
	qt6-qtwebengine-dev
	"
source="https://pypi.python.org/packages/source/p/pyqt6_pdf/pyqt6_pdf-$pkgver.tar.gz"
builddir="$srcdir/pyqt6_pdf-$pkgver"

build() {
	export CFLAGS="$CFLAGS -O2 -flto=auto"
	export CXXFLAGS="$CXXFLAGS -O2 -flto=auto"
	sip-build \
		--qmake=/usr/bin/qmake6 \
		--api-dir=/usr/share/qt6/qsci/api/python \
		--pep484-pyi \
		--no-make
	make -C build
}

package() {
	make DESTDIR="$pkgdir" INSTALL_ROOT="$pkgdir" -C build install
	python3 -m compileall -j 0 "$pkgdir"/usr/lib/python3*
}

sha512sums="
5d23753d4acf320ec43d6a86e8857e6754d376ae8e34278ddf7bedbd4215f1ad2a954a993514ceee94c7adf2768ce474336cd0c8d986575b5985c709d3a1a6b0  pyqt6_pdf-6.140.1.tar.gz
"
