ef81ea9d51247ee798228956aed279bec0ab89ce73de126a46aacad0c5435d37a6393db41c2ab9e38a56fbcdf644672e668248368f33d9a9ed0e0b339b9e331b  10-set-GOFLAGS.patch
"
