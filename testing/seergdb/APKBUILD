# Contributor: August Klein <amatcoder@protonmail.com>
# Maintainer: August Klein <amatcoder@protonmail.com>
pkgname=seergdb
pkgver=2.7
pkgrel=0
pkgdesc="Gui frontend to gdb"
url="https://github.com/epasveer/seer"
arch="all !armhf" # armhf blocked by qt6-qtcharts
license="GPL-3.0-or-later"
depends="gdb"
makedepends="cmake qt6-qtcharts-dev samurai"
source="$pkgname-$pkgver.tar.gz::https://github.com/epasveer/seer/archive/refs/tags/v$pkgver.tar.gz"
options="!check" # no testsuite
builddir="$srcdir/seer-$pkgver/src"

prepare() {
	default_prepare

	# https://github.com/epasveer/seer/pull/457
	sed -i '/hicolor/d' ./resource.qrc
}

build() {
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DQTVERSION=QT6
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 resources/seergdb.desktop -t "$pkgdir/usr/share/applications"
}

sha512sums="
2712ff8043114d747b6cdd6688b97be88d88a801d3a0b25def6f1793591db8b1c7bf7bfdcfba93e32ce3e0cbaf9978c1009dcdb1bac7aa814bc9bd66fe477cea  seergdb-2.7.tar.gz
"
