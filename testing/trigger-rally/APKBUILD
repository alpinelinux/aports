7d3e713c7437c5a1323c4731f711679b7d51ca329f5657cefd8bdf5ac6075883f7160afb4923c2593bccfd1fbfe1dfd1474acfdd59a268d0e8de47d0a09f11ff  0001-fix-sdl2-detection.patch
