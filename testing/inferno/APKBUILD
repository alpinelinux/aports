# Maintainer: qaqland <qaq@qaq.land>
pkgname=inferno
pkgver=0.12.8
pkgrel=0
pkgdesc="A Rust port of FlameGraph"
url="https://github.com/jonhoo/inferno"
arch="all"
license="CDDL-1.0"
makedepends="cargo cargo-auditable"
subpackages="$pkgname-doc"
_flamegraph_commit=57207afbe114e3d50c6c7aef93d3206ef76cf6e2
source="https://github.com/jonhoo/inferno/archive/v$pkgver/inferno-$pkgver.tar.gz
	https://github.com/jonhoo/FlameGraph/archive/$_flamegraph_commit.tar.gz
	"
options="net" # cargo fetch

prepare() {
	default_prepare

	rmdir flamegraph
	mv $srcdir/FlameGraph-$_flamegraph_commit flamegraph
	touch flamegraph/.git # tests want this path exists

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	local bins="
		inferno-collapse-dtrace
		inferno-collapse-ghcprof
		inferno-collapse-guess
		inferno-collapse-perf
		inferno-collapse-recursive
		inferno-collapse-sample
		inferno-collapse-vsprof
		inferno-collapse-vtune
		inferno-collapse-xctrace
		inferno-diff-folded
		inferno-flamegraph
		"

	for bin in $bins; do
		install -Dm755 target/release/"$bin" -t "$pkgdir"/usr/bin/
	done

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="
5684ea46fcb2927c63e917f3b3443297e77332dacadf89bf30a3228845d4dcefd84fd7f3e0d9680b1497c6aa8240a2fdb9bbb72d85f76a5d5250e4636972602e  inferno-0.12.8.tar.gz
c574db49a63d83103760e1201db39b096186b929a8077cdff42a6470fe1d9e555dc5e4217ef5b314e982b686f53b5dc9efa34c111489fe9692819d4726636d66  57207afbe114e3d50c6c7aef93d3206ef76cf6e2.tar.gz
"
