# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=durden
pkgver=0.6.3
pkgrel=0
pkgdesc="Refernce Desktop Environment for Arcan"
arch="all"
url="http://durden.arcan-fe.com/"
license="BSD-3-Clause"
depends="arcan arcan-afsrv-net arcan-afsrv-terminal"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/letoram/durden/archive/$pkgver.tar.gz"
builddir="$srcdir/$pkgname"
options="!check" # no test suite

package() {
	install -dm755 "$pkgdir"/usr/share/"$pkgname"/
	cp -r "$pkgname" "$pkgdir"/usr/share/"$pkgname"/
	install -Dm755 distr/"$pkgname" -t "$pkgdir"/usr/bin/

	install -Dm644 CHANGELOG.md HACKING.md README.md \
		-t "$pkgdir"/usr/share/doc/"$pkgname"/
}

sha512sums="
f964dd83f3b9d58c42ba715d0170d7eea3a54ca2d232893b48d4cef8bb8d2b8ca3c85b42a0f594f19d87ae21b3a02cdb53c0e11449464ec12d54500f3732329a  durden-0.6.3.tar.gz
"
