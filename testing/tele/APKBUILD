# Maintainer: Tony Evl <anton@evlakh.ru>
pkgname=tele
pkgver=2.1.4
pkgrel=0
pkgdesc="Keyboard-first Telegram client for the terminal (TUI, daemon and CLI)"
url="https://github.com/sorokin-vladimir/tele"
arch="all"
license="GPL-3.0-only"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/sorokin-vladimir/tele/archive/refs/tags/v$pkgver.tar.gz"
options="net" # fetch Go modules

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"
export GOFLAGS="$GOFLAGS -modcacherw -trimpath"

build() {
	go build \
		-ldflags "
		-X github.com/sorokin-vladimir/tele/internal/version.Version=$pkgver
		-X main.appName=tele
		" \
		-o bin/tele ./cmd/tele
}

check() {
	# TestSettings_SectionsFollowTheFile is a TUI rendering test that
	# depends on a real terminal and fails in the headless CI
	# environment; skip it.
	go test -skip 'TestSettings_SectionsFollowTheFile' ./...
}

package() {
	install -Dm755 bin/tele -t "$pkgdir"/usr/bin/
}

sha512sums="
4c7b4304d34e0cdde1301b0b6fbfc8b146c503ceab09855a419572b4da7340df21dab0c7d9e60ad7b363f63885489b4ff53555c6fb1cf4bf77f84c6be6d3075b  tele-2.1.4.tar.gz
"
