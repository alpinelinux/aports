From 9080cd3d6a77409fcc4e6ceb2dbdc8522b5aa87a Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Sun, 26 Jul 2026 05:53:49 +0200
Subject: [PATCH] Fix unverified devices being untrustable

The FormValues is cast to `bool`, so the comparison `== "true"` always
returns False, and devices remain untrusted no matter what choice is
made.
---
 matridge/command.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/matridge/command.py b/matridge/command.py
index 7786413..2918882 100644
--- a/matridge/command.py
+++ b/matridge/command.py
@@ -695,9 +695,9 @@ class TrustUnverified(MUCCommand[MUC]):
 
     @staticmethod
     async def toggle(muc: MUC, form_values: FormValues) -> str:
-        new_value = form_values["ignore_unverified"] == "true"
-        muc.ignore_unverified_devices = new_value
-        if new_value:
+        assert isinstance(form_values["ignore_unverified"], bool)
+        muc.ignore_unverified_devices = form_values["ignore_unverified"]
+        if muc.ignore_unverified_devices:
             return (
                 f"Room '{muc.name or muc.legacy_id}': Unverified devices are now TRUSTED.\n"
                 "Your messages will be sent to all devices, even if unverified.\n"
-- 
