# Contributor: Robin Candau <robincandau@mailbox.org>
# Maintainer: Robin Candau <robincandau@mailbox.org>
pkgname=chipass
pkgver=2026.09.0
pkgrel=0
pkgdesc="A cross-platform password manager for people with extremely high demands on secure personal data management"
url="https://chipass.org"
# riscv64 fails to build in CI, I suspect a resource related issue
# Forcing -j1 and disabling LTO unfortunately didn't help
arch="all !riscv64"
license="GPL-2.0-only OR GPL-3.0-only"
depends="hicolor-icon-theme qt6-qttranslations"
makedepends="
	appstream
	argon2-dev
	asciidoctor
	botan3-dev
	cmake
	libqrencode-dev
	libusb-dev
	libxi-dev
	libxtst-dev
	libx11-dev
	minizip-dev
	ninja
	pcsc-lite-dev
	qt6-qtbase-dev
	qt6-qtsvg-dev
	qt6-qttools-dev
	qt6-qt5compat-dev
	readline-dev
	zlib-dev
	"
checkdepends="dbus xclip xvfb-run"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/ChiPass/ChiPass/archive/v$pkgver.tar.gz
	tests.patch
	"
builddir="$srcdir/$pkgname"

build() {
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCHIPASS_BUILD_TYPE=Release \
		-DCMAKE_VERBOSE_MAKEFILE=ON \
		-DCHIPASS_WITH_GUI_TESTS=ON \
		-DCHIPASS_WITH_AUTOTYPE=ON \
		-DCHIPASS_WITH_YUBIKEY=ON \
		-DCHIPASS_WITH_NETWORKING=ON \
		-DCHIPASS_WITH_BROWSER=ON \
		-DCHIPASS_WITH_BROWSER_PASSKEYS=ON \
		-DCHIPASS_WITH_SSHAGENT=ON \
		-DCHIPASS_WITH_KEESHARE=ON \
		-DCHIPASS_WITH_FDOSECRETS=ON \
		-DCHIPASS_WITH_UPDATE_CHECK=OFF
	cmake --build build
}

check() {
	case "$CARCH" in
	s390x)
		QT_QPA_PLATFORM=xcb xvfb-run -a ctest --test-dir build -j1 \
			-E "gui|guifdosecrets"
		;;
	*)
		QT_QPA_PLATFORM=xcb xvfb-run -a ctest --test-dir build -j1
		;;
	esac
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm 644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm 644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"

	# Move man pages to the correct directory
	mv "$pkgdir/usr/share/ChiPass/man" "$pkgdir/usr/share/"

	rm -rf "$pkgdir/usr/share/ChiPass/docs"
}

sha512sums="
618dc6a8ca4fc4e1ea3f6863213050182661355911776eb5e37bc336023b33a646943632c708cb2c696ced051dd527c8c52026bde9ec37b51d2829acadb8e07a  chipass-2026.09.0.tar.gz
645d33e687a92e60b0d020b1ab0ac0ca3c9c5afddd3c345ea36ee6d55449a1007ce36ff737eb5a38d18c4814f3773eb05b05e663b6da72d93127261681863a73  tests.patch
"
