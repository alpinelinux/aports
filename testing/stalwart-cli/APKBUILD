# Maintainer: Romain Isnel <alpine@frmg.eu>
pkgname=stalwart-cli
pkgver=1.0.14
pkgrel=0
pkgdesc="Stalwart Command Line Interface"
url="https://github.com/stalwartlabs/cli"
arch="all"
license="AGPL-3.0-or-later"
makedepends="
	cargo
	cargo-auditable
	clang22-dev
	linux-headers
	protoc
"
builddir="$srcdir/cli-$pkgver"
source="
	https://github.com/stalwartlabs/cli/archive/v$pkgver/cli-$pkgver.tar.gz
"
options="net" # cargo crates

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release --no-default-features -p stalwart-cli
}

check() {
	cargo test --frozen -p stalwart-cli
}


package() {
	install -Dm 755 "$builddir"/target/release/stalwart-cli \
		"$pkgdir"/usr/bin/stalwart-cli
}

sha512sums="
89c036f3341bd918e482ec4ec58bc1ab60fc907d2a4106a65887927b125a2cf1a564bc924c134401b932af7e00e42c988ae5d35fbe4b9a5706323e89c933fdbd  cli-1.0.14.tar.gz
"
