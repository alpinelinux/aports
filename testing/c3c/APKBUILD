# Contributor: Manuel Linares <mbarriolinares@gmail.com>
# Maintainer: Manuel Linares <mbarriolinares@gmail.com>
pkgname=c3c
pkgver=0.8.2
pkgrel=0
pkgdesc="Compiler for the C3 language"
url="https://github.com/c3lang/c3c"
arch="all"
license="LGPL-3.0-or-later AND MIT"
makedepends="
	cmake
	samurai
	curl-dev
	llvm22-dev
	llvm22-static
	llvm22-gtest
	lld22-dev
	lld22-libs
"
source="$pkgname-$pkgver.tar.gz::https://github.com/c3lang/c3c/archive/refs/tags/v$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DLLVM_ENABLE_LIBXML2=OFF \
		-DC3_LINK_DYNAMIC=ON \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DCMAKE_INSTALL_RPATH="/usr/lib/llvm22/lib"
	cmake --build build
}

check() {
	build/c3c --version
}

package() {
	# c3c expects its stdlib to live next to the binary; /usr/lib/$pkgname is
	# the conventional location so the symlink in /usr/bin finds it correctly.
	install -Dm755 build/c3c "$pkgdir"/usr/lib/$pkgname/c3c
	cp -r build/lib "$pkgdir"/usr/lib/$pkgname/lib
	install -d "$pkgdir"/usr/bin
	ln -s ../lib/$pkgname/c3c "$pkgdir"/usr/bin/c3c
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
	install -Dm644 LICENSE_SRC -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="c1d5a31865cc4fe35a7e53a9580a2cbe1709dfc6a7a4d3e5236c665406271e8346a4bbcc88e091be84e6fe0aad8874b19b572a9d3baca29f929180ed279c4135  c3c-0.8.2.tar.gz"
