# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=libqcnpuperf
pkgver=1.0.1
pkgrel=0
pkgdesc="A Simple Lightweight NPU Metrics collection Library"
url="https://github.com/qualcomm/libqcnpuperf"
arch="all !armhf" # blocked by fastrpc-dev
license="BSD-3-Clause"
depends_dev="fastrpc-dev"
makedepends="
	cmake
	fastrpc-dev
	linux-headers
	ncurses-dev
	samurai
	"
subpackages="$pkgname-dev"
source="https://github.com/qualcomm/libqcnpuperf/archive/v$pkgver/libqcnpuperf-$pkgver.tar.gz"
options="!check" # no tests

build() {
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
969b11c175a6cc8ecd4ed641e4cccf9dd50ddb4dcd863127b58387cf23ddf15b2aa58c0e2a7c37c58f1a340a1dc197f189d836c0852a5591fc0ec97d5ab6cfb2  libqcnpuperf-1.0.1.tar.gz
"
