# Contributor: Saijin-Naib <Saijin-Naib_package-maintenance@outlook.com>
# Maintainer: James Smith <james@floppy.org.uk>
pkgname=f3d
pkgver=4.0.0
pkgrel=0
pkgdesc="Fast and minimalist 3D viewer"
url="https://f3d.app"
arch="x86_64 aarch64" # we need vtk to be built with openvdb support, and that only happens at present on these architectures
license="BSD-3-Clause"
makedepends="alembic-dev assimp-dev cmake draco-dev draco-static freeimage-dev git git-lfs openexr-dev samurai vtk-dev opencascade-dev ffmpeg-dev"
subpackages="$pkgname-bash-completion $pkgname-dev $pkgname-doc $pkgname-fish-completion $pkgname-zsh-completion"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/f3d-app/f3d/archive/refs/tags/v$pkgver.tar.gz
	video_frame.patch
	video_packet.patch
"
options="!check" # No tests currently configured for package

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DF3D_MODULE_EXR=ON \
		-DF3D_PLUGIN_BUILD_ALEMBIC=ON \
		-DF3D_PLUGIN_BUILD_ASSIMP=ON \
		-DF3D_PLUGIN_BUILD_DRACO=ON \
		-DF3D_PLUGIN_BUILD_OCCT=ON \
		-DF3D_PLUGIN_BUILD_VDB=ON \
		-DF3D_MODULE_FFMPEG=ON \
		$crossopts
	cmake --build build
	#-DF3D_MODULE_RAYTRACING=OFF \ # OSPRay is not packaged on Alpine
	#-DF3D_PLUGIN_BUILD_USD=OFF \ # OpenUSD is not packaged on Alpine
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

