3d821a199286b3852c080b41571dbe34bdbce21ba5d2fce62bea0d3942235f90d2ab8f982b1e63c112dd59ecf3e4cc8e308681abcdb5e65a1b2965d25687b4fe  frozen-auditable.patch
"
