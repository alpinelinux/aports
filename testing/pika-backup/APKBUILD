# Contributor: Aemilia Scarlett <aemilia@ferret.town>
maintainer="Alex Ungur <alexaandru@gmail.com>"
pkgname=pika-backup
pkgver=0.8.4
pkgrel=0
pkgdesc="Doing backups the easy way. Plugin your USB drive and let the Pika do the rest for you."
url="https://gitlab.gnome.org/World/pika-backup"
arch="all !s390x !riscv64" # riscv64 needs >1h on CI
license="GPL-3.0-or-later"
depends="borgbackup py3-pyfuse3"
makedepends="cargo cargo-auditable git gtk4.0-dev openssl-dev libadwaita-dev glib-dev gettext itstool meson"
subpackages="$pkgname-doc $pkgname-lang"
source="$pkgname-$pkgver.tar.gz::https://gitlab.gnome.org/World/pika-backup/-/archive/$pkgver/pika-backup-$pkgver.tar.gz
	frozen-auditable.patch
	"
# We skip tests for now, as the test suite for pika-backup wants to test
# things like gtk window creation which we can't achieve on a headless setup.
options="!check"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	abuild-meson build
	meson compile -C build
}

check() {
	cargo test --frozen
}

package() {
	DESTDIR="$pkgdir" meson install -C build
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"
}

sha512sums="
