Patch-Source: https://github.com/php/pecl-file_formats-yaml/pull/109
PHP 8.6 removed the zval_dtor() alias and dropped the path from stream
open error messages. The yaml.c hunk is the matching change from
https://github.com/php/pecl-file_formats-yaml/commit/0b61dfbd (#103),
which is also not in the 2.3.0 release.

diff --git a/parse.c b/parse.c
index 1b08134..b0f836a 100644
--- a/parse.c
+++ b/parse.c
@@ -929,7 +929,7 @@ eval_timestamp(zval **zpp, const char *ts, size_t ts_len)
 		}
 
 	} else {
-		zval_dtor(*zpp);
+		zval_ptr_dtor_nogc(*zpp);
 		ZVAL_STRINGL(*zpp, ts, ts_len);
 		return SUCCESS;
 	}
diff --git a/tests/yaml_parse_file_002.phpt b/tests/yaml_parse_file_002.phpt
index 2e8d795..94c6c5e 100644
--- a/tests/yaml_parse_file_002.phpt
+++ b/tests/yaml_parse_file_002.phpt
@@ -36,6 +36,6 @@ Warning: yaml_parse_file(): %r(Filename|Path)%r %r(cannot|must not)%r be empty i
 
 Warning: yaml_parse_file(): %r(Filename|Path)%r %r(cannot|must not)%r be empty in %s on line %d
 
-Warning: yaml_parse_file(invalid): %r[Ff]%railed to open stream: No such file or directory in %s on line %d
+Warning: yaml_parse_file(%r(?:invalid)?%r): %r[Ff]%railed to open stream: No such file or directory in %s on line %d
 
 Warning: yaml_parse_file() expects at least 1 %r(argument|parameter)%r, 0 given in %s on line %d
diff --git a/yaml.c b/yaml.c
index a91d4f1..7fb0a02 100644
--- a/yaml.c
+++ b/yaml.c
@@ -528,7 +528,7 @@ PHP_FUNCTION(yaml_parse_url)
 
 	if (zndocs != NULL) {
 		/* copy document count to var user sent in */
-		zval_dtor(zndocs);
+		zval_ptr_dtor(zndocs);
 		ZVAL_LONG(zndocs, ndocs);
 	}
 
