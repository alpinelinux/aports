# Contributor: Aster Boese <asterboese@mailbox.org>
# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=qqc2-suru-style
pkgver=0.20261113
pkgrel=0
pkgdesc="Suru Style for QtQuick Controls 2"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://gitlab.com/ubports/development/core/qqc2-suru-style"
license="GPL-2.0-or-later"
makedepends="
	cmake
	qt5-qtbase-dev
	qt5-qtdeclarative-dev
	qt5-qtquickcontrols2-dev
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	samurai
	"
subpackages="$pkgname-qt5"
source="https://gitlab.com/ubports/development/core/qqc2-suru-style/-/archive/$pkgver/qqc2-suru-style-$pkgver.tar.gz"
options="!check" # No tests

build() {
	cmake -B build-qt6 -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build-qt6

	mkdir build-qt5 && cd build-qt5
	qmake-qt5 ..
	make
}

package() {
	DESTDIR="$pkgdir" cmake --install build-qt6

	cd build-qt5
	INSTALL_ROOT="$pkgdir" make install
}

qt5() {
	amove usr/lib/qt5
}

sha512sums="
ac6d6b172f6cc4ba7c464e6a1eb86902394a30ebdad1e64f744b4fdbd7d65e180c0a3c5a8c4cd08ac7e3d71d2a4fbacef080a8df0cba04b9fa5f2daac41a69ea  qqc2-suru-style-0.20261113.tar.gz
"
