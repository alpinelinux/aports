Patch-Source: https://github.com/couchbase/couchbase-php-client (no 8.6 release yet)
PHP 8.6 removed zend_parse_parameters_none_throw(); the plain
zend_parse_parameters_none() now always throws, so alias it on 8.6+.
--- a/src/php_couchbase.cxx
+++ b/src/php_couchbase.cxx
@@ -27,6 +27,12 @@
 
 #include <php.h>
 
+#if PHP_VERSION_ID >= 80600
+// PHP 8.6 removed zend_parse_parameters_none_throw(); the plain variant
+// now always throws, matching the old _throw behaviour.
+#define zend_parse_parameters_none_throw() zend_parse_parameters_none()
+#endif
+
 #include <Zend/zend_exceptions.h>
 #include <ext/standard/info.h>
 
