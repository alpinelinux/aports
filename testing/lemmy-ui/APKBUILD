# Contributor: Celeste <cielesti@protonmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=lemmy-ui
pkgver=0.19.20
# this needs to be synced with lemmy
_translations_commit=95f0bd4339c761164743f9e269dbaff6cdb7e009
pkgrel=0
pkgdesc="Link aggregator and forum for the Fediverse - Official webapp"
url="https://join-lemmy.org/"
# armhf: Zone Allocation failed - process out of memory
arch="all !armhf"
license="AGPL-3.0-only"
depends="nodejs node-sharp"
makedepends="npm pnpm"
install="$pkgname.pre-install"
pkgusers="lemmy-ui"
pkggroups="lemmy-ui"
subpackages="$pkgname-openrc"
source="https://github.com/LemmyNet/lemmy-ui/archive/$pkgver/lemmy-ui-$pkgver.tar.gz
	https://github.com/LemmyNet/lemmy-translations/archive/$_translations_commit/lemmy-translations-$pkgver.tar.gz
	fix-zh-check.patch
	lemmy-ui.confd
	lemmy-ui.initd
	"
options="net" # tests access localhost

prepare() {
	default_prepare

	rmdir -v lemmy-translations
	ln -sv "$srcdir/lemmy-translations-$_translations_commit" \
		lemmy-translations

	sed -i "s/unknown version/$pkgver/" src/shared/version.ts

	pnpm install --frozen-lockfile
}

build() {
	export GIT_DIR="$builddir"
	NODE_ENV=production pnpm build:prod
	unset GIT_DIR

	find node_modules -name "*sharp*" -prune -exec rm -rf '{}' \+
	ln -s /usr/lib/node_modules/sharp node_modules/sharp
}

check() {
	timeout 10 node dist/js/server.js | grep "Lemmy-ui v$pkgver started listening"
}

package() {
	mkdir -p "$pkgdir"/usr/share/webapps/$pkgname
	cp -r dist node_modules "$pkgdir"/usr/share/webapps/$pkgname/

	# cleanup unused files
	find "$pkgdir" -type f -a \( \
		-name "*.ts" \
		-o -name "webpack*" \
		-o -name "tsconfig*" \
		-o -name "babel.config*" \
		-o -name "README*" \
		-o -name "readme*" \
		-o -name "CHANGELOG*" \
		-o -name "*.map" \
		-o -name "LICENSE*" \
		-o -name "License" \
		-o -name "license" \
		-o -name "*.md" \
		\) \
		-delete
	find "$pkgdir" -type d -a \( \
		-name "example" \
		-o -name "examples" \
		-o -name "test" \
		-o -name "tests" \
		-o -name ".github" \
		\) \
		-exec rm -rf '{}' \+

	install -Dm644 "$srcdir"/lemmy-ui.confd "$pkgdir"/etc/conf.d/lemmy-ui
	install -Dm755 "$srcdir"/lemmy-ui.initd "$pkgdir"/etc/init.d/lemmy-ui
}

