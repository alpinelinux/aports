maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=keulim
pkgver=0_git20261114
_commit=bebc6cf25c2babbadd178cf00e6a41f1fd2991c3
pkgrel=0
pkgdesc="Simple image C library"
url="https://gitlab.freedesktop.org/emersion/keulim"
arch="all"
license="LGPL-3.0-only"
makedepends="
	cargo
	clang-dev
	ffmpeg-dev
	giflib-dev
	libjxl-dev
	libpng-dev
	librsvg-dev
	libwebp-dev
	meson
	resvg-dev
	"
subpackages="$pkgname-dev"
source="https://gitlab.freedesktop.org/emersion/keulim/-/archive/$_commit/keulim-$_commit.tar.gz"
builddir="$srcdir/keulim-$_commit"
options="net" # rust

prepare() {
	default_prepare

	cd rust && cargo fetch --target="$CTARGET" --locked
}

build() {
	abuild-meson \
		-Dffmpeg=enabled \
		-Dgiflib=enabled \
		-Dlibjpeg=enabled \
		-Dlibjxl=enabled \
		-Dlibwebp=enabled \
		-Dlibpng=enabled \
		-Dlibrsvg=enabled \
		-Dresvg=enabled \
		-Drust=enabled \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
e21bf9aa4b242b598b762adc44191acc68015109393ab4f6dae5ffa1e695edc8a4a4abc854a2034ca8ebd73a7c12059b073c6fafd3a7163f0994281e7053b1a2  keulim-bebc6cf25c2babbadd178cf00e6a41f1fd2991c3.tar.gz
"
