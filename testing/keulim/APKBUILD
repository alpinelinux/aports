maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=keulim
pkgver=0_git20260917
_commit=65206a3064e8fb5b8697fcf6501a22435e46f810
pkgrel=1
pkgdesc="Simple image C library"
url="https://gitlab.freedesktop.org/emersion/keulim"
arch="all"
license="LGPL-3.0-only"
makedepends="
	cargo
	clang-dev
	ffmpeg-dev
	giflib-dev
	libjxl-dev
	libpng-dev
	librsvg-dev
	libwebp-dev
	meson
	resvg-dev
	"
subpackages="$pkgname-dev"
source="https://gitlab.freedesktop.org/emersion/keulim/-/archive/$_commit/keulim-$_commit.tar.gz"
builddir="$srcdir/keulim-$_commit"
options="net" # rust

prepare() {
	default_prepare

	cd rust && cargo fetch --target="$CTARGET" --locked
}

build() {
	abuild-meson \
		-Dffmpeg=enabled \
		-Dgiflib=enabled \
		-Dlibjpeg=enabled \
		-Dlibjxl=enabled \
		-Dlibwebp=enabled \
		-Dlibpng=enabled \
		-Dlibrsvg=enabled \
		-Dresvg=enabled \
		-Drust=enabled \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
e166ef97d7bdb9124f0d8b9ff78b43a543904f8e32ac740b3bb1e72347c1dcf881bb5eb414aa70b05d6d977d821696e40923adf85637ba0988cbdc1066a3869a  keulim-65206a3064e8fb5b8697fcf6501a22435e46f810.tar.gz
"
