maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=keulim
pkgver=0_git20261123
_commit=ddf71ab3880c719dbcaa8dd9cc374963fb8f2dda
pkgrel=0
pkgdesc="Simple image C library"
url="https://gitlab.freedesktop.org/emersion/keulim"
arch="all !s390x !armhf !armv7 !ppc64le !x86" # tests
license="LGPL-3.0-only"
makedepends="
	cargo
	clang-dev
	ffmpeg-dev
	giflib-dev
	libjxl-dev
	libpng-dev
	librsvg-dev
	libwebp-dev
	meson
	resvg-dev
	"
subpackages="$pkgname-dev"
source="https://gitlab.freedesktop.org/emersion/keulim/-/archive/$_commit/keulim-$_commit.tar.gz"
builddir="$srcdir/keulim-$_commit"
options="net" # rust

prepare() {
	default_prepare

	cd rust && cargo fetch --target="$CTARGET" --locked
}

build() {
	abuild-meson \
		-Dffmpeg=enabled \
		-Dgiflib=enabled \
		-Dlibjpeg=enabled \
		-Dlibjxl=enabled \
		-Dlibwebp=enabled \
		-Dlibpng=enabled \
		-Dlibrsvg=enabled \
		-Dresvg=enabled \
		-Drust=enabled \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
6b581343333829129ed4b2d16d76fbc5e2e52523d8cb9b6b3bae42e782367bd945d1098fa9f92e6d792b87d8e79dcc14047f50bab15757843761bbf97269d730  keulim-ddf71ab3880c719dbcaa8dd9cc374963fb8f2dda.tar.gz
"
