pkgname=blktrace
pkgver=1.3.0
pkgrel=0
pkgdesc="Block IO Tracing"
url="https://git.kernel.org/pub/scm/linux/kernel/git/axboe/blktrace.git"
arch="all"
license="GPL-2.0-only"
options="!check" # No test suite
makedepends="linux-headers libaio-dev"
subpackages="$pkgname-doc"
source="https://git.kernel.org/pub/scm/linux/kernel/git/axboe/blktrace.git/snapshot/blktrace-$pkgver.tar.gz"

build() {
	make prefix=/usr
}


package() {
	make DESTDIR="$pkgdir" prefix=/usr mandir=/usr/share/man install
}

