# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=crow-translate
pkgver=4.1.0
pkgrel=0
# armhf, x86 and ppc64le blocked by tesseract-ocr
# s390x blocked by onnxruntime
arch="all !armhf !x86 !ppc64le !s390x"
url="https://apps.kde.org/crowtranslate/"
pkgdesc="Allows you to translate and speak text using Mozhi"
license="GPL-3.0-or-later"
depends="espeak-ng"
makedepends="$depends_dev
	extra-cmake-modules
	kiconthemes-dev
	kwayland-dev
	onnxruntime-dev
	qt6-qtbase-dev
	qt6-qtscxml-dev
	qt6-qtspeech-dev
	qt6-qttools-dev
	samurai
	tesseract-ocr-dev
	"
subpackages="$pkgname-lang"
_repo_url="https://invent.kde.org/office/crow-translate.git"
source="https://download.kde.org/stable/crow-translate/$pkgver/crow-translate-$pkgver.tar.gz"
options="!check" # No tests
builddir="$srcdir/$pkgname"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
8e139aa69a055294dc334de5489dbaae1b64e73e72194be3be9daac43280011fa1814dee479ca855b4dcd4ab391a5a0228d17e72441e894830ebfded6e8a8149  crow-translate-4.1.0.tar.gz
"
