# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=rustnet
pkgver=1.6.0
pkgrel=0
pkgdesc="process network monitoring for your terminal with deep packet inspection"
# armhf, armv7, x86: blocked by nix https://github.com/nix-rust/nix/pull/1900
arch="all !armhf !armv7 !x86"
url="https://github.com/domcyrus/rustnet"
license="Apache-2.0"
makedepends="cargo cargo-auditable
	clang
	elfutils-dev
	libcap-utils
	libpcap-dev
	linux-headers
	linux-lts-dev
	zlib-dev
	"
subpackages="$pkgname-doc
	$pkgname-bash-completion $pkgname-fish-completion $pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/domcyrus/rustnet/archive/refs/tags/v$pkgver.tar.gz
	update-rustix-crate.patch
	"
options="net setcap" # fetch crates and set capabilities

export RUSTNET_ASSET_DIR="$srcdir"/"$pkgver"/assets/

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked

	# make sure it is there
	mkdir -p "$RUSTNET_ASSET_DIR"

	# use our vmlinux.h, provided by linux-lts-dev, as "bundled" vmlinux.h
	case "$CARCH" in
	aarch64)
		install -Dm0644 /usr/src/linux-headers-*-lts/vmlinux.h \
			crates/rustnet-host/resources/ebpf/vmlinux/aarch64/vmlinux.h
		;;
	arm*)
		install -Dm0644 /usr/src/linux-headers-*-lts/vmlinux.h \
			crates/rustnet-host/resources/ebpf/vmlinux/arm/vmlinux.h
		;;
	x86*)
		install -Dm0644 /usr/src/linux-headers-*-lts/vmlinux.h \
			crates/rustnet-host/resources/ebpf/vmlinux/x86/vmlinux.h
		;;
	esac
	# upstream copies this from https://github.com/libbpf/vmlinux.h
	# and defaults to "x86", other architectures than the above don't seem to
	# work with our architecture specific vmlinux.h so let's use the upstream
	# x86 one (and please report any issue you run into)
	# TODO: report to upstream and make something better of this
}

build() {
	cargo auditable build --release --frozen
}

check() {
	case "$CARCH" in
	riscv64)
		cargo test --frozen -- \
			--skip ui::snapshot_tests::details_tab_arp_application_card \
			--skip ui::snapshot_tests::details_tab_dns_response_application_card \
			--skip ui::snapshot_tests::details_tab_http_application_card \
			--skip ui::snapshot_tests::details_tab_https_without_tls_info \
			--skip ui::snapshot_tests::details_tab_icmp_echo_application_card \
			--skip ui::snapshot_tests::details_tab_icmpv6_ndp_application_card \
			--skip ui::snapshot_tests::details_tab_igmp_application_card \
			--skip ui::snapshot_tests::details_tab_ntp_application_card \
			--skip ui::snapshot_tests::details_tab_ssh_application_card
		# the above are failing on build-edge-riscv64 but not in CI
		;;
	*)
		cargo test --frozen
		;;
	esac
}

package() {
	install -Dm0755 -t "$pkgdir"/usr/bin/ target/release/"$pkgname"
	setcap 'cap_net_raw,cap_bpf,cap_perfmon+eip' "$pkgdir"/usr/bin/"$pkgname"

	install -Dm0644 -t "$pkgdir"/usr/share/man/man1/ \
		"$RUSTNET_ASSET_DIR"/"$pkgname".1
	install -Dm0644 -t "$pkgdir"/usr/share/doc/"$pkgname"/ \
		ARCHITECTURE.md USAGE.md SECURITY.md

	install -Dm0644 "$RUSTNET_ASSET_DIR"/"$pkgname".bash \
		"$pkgdir"/usr/share/bash-completion/completions/"$pkgname"
	install -Dm0644 "$RUSTNET_ASSET_DIR"/"$pkgname".fish \
		-t "$pkgdir"/usr/share/fish/vendor_completions.d/
	install -Dm0644 "$RUSTNET_ASSET_DIR"/_"$pkgname" \
		-t "$pkgdir"/usr/share/zsh/site-functions/
}

