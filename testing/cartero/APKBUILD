maintainer="Díaz Urbaneja Diego <sodomon2@gmail.com>"
pkgname=cartero
pkgver=26.0
pkgrel=0
pkgdesc="HTTP client that you can use to test your APIs."
url="https://cartero.danirod.es/"
arch="all"
license="GPL-3.0-only"
makedepends="
	blueprint-compiler
	cargo
	cmake
	curl-dev
	desktop-file-utils
	gsettings-desktop-schemas-dev
	gtksourceview5-dev
	gtk4.0-dev
	libadwaita-dev
	meson
	openssl-dev
	rust
	samurai
	"
subpackages="$pkgname-lang"
source="$pkgname-$pkgver.tar.gz::https://github.com/danirod/cartero/archive/refs/tags/v$pkgver.tar.gz
	cargo-bump-rustix.patch
	"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install -C output
}

