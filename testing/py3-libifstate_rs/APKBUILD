# Maintainer: Thomas Liske <thomas@fiasko-nw.net>
pkgname=py3-libifstate_rs
pkgver=0.4.2
pkgrel=0
pkgdesc="Python library for accelerating netlink access with Rust-based filtering"
url="https://codeberg.org/routerkit/libifstate-rs"
arch="all"
license="GPL-3.0-or-later"
makedepends="cargo maturin py3-gpep517 py3-maturin"
options="net !check" # cargo fetch; no tests available
source="https://files.pythonhosted.org/packages/source/l/libifstate-rs/libifstate_rs-$pkgver.tar.gz"
subpackages="$pkgname-pyc"
builddir="$srcdir/libifstate_rs-$pkgver"

prepare() {
	default_prepare

	cargo fetch --locked
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--config-json '{"build-args": "--frozen", "build-option": "--release"}' \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
67312f5224b3166c7afc07b9c40ea0d6f0c5f6004cf063f92c6b1639d9704f6569f4ad8fa4c9dbf7691682794501483f97eb8b013777054c9f2f44ae819c6ad8  libifstate_rs-0.4.2.tar.gz
"
