# Configuration for /etc/init.d/openvpn-auth-oauth2

# Path to the openvpn-auth-oauth2 configuration file.
#cfgfile="/etc/openvpn-auth-oauth2/config.yaml"

# Create /etc/openvpn-auth-oauth2/http-secret.txt with a random secret on the
# first start.
#generate_http_secret="yes"

# User (and group) to run the daemon as.
#command_user="openvpn-auth:openvpn-auth"

# Additional arguments to pass to openvpn-auth-oauth2.
#command_args=

# Comment out to disable process supervisor.
supervisor=supervise-daemon
