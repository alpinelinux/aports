--
From 9868a890ae49f7697f1065985f2fd65297ee368c Mon Sep 17 00:00:00 2001
From: Jakub Jirutka <jakub@jirutka.cz>
Date: Tue, 10 Nov 2026 22:31:48 +0100
Subject: [PATCH] fix: avoid duplicating daemon initialization errors

When daemon.New fails, the error is logged both as the message and as
an "err" attribute. This duplicates the full error text in console and
JSON output.

Use a contextual message while preserving the original error in the
structured "err" attribute.

Signed-off-by: Jakub Jirutka <jakub@jirutka.cz>
---
 cmd/openvpn-auth-oauth2/root.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmd/openvpn-auth-oauth2/root.go b/cmd/openvpn-auth-oauth2/root.go
index 3d43b6f..43e113b 100644
--- a/cmd/openvpn-auth-oauth2/root.go
+++ b/cmd/openvpn-auth-oauth2/root.go
@@ -129,7 +129,7 @@ func run(
 	appRuntime, err := daemon.New(ctx, logger, conf, tokenStorage, sessions, reload)
 	if err != nil {
 		logger.LogAttrs(
-			ctx, slog.LevelError, err.Error(),
+			ctx, slog.LevelError, "daemon initialization failed",
 			slog.Any("err", err),
 		)

