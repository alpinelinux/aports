# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=openvpn-auth-oauth2
pkgver=2.3.3
pkgrel=0
pkgdesc="OIDC authentication service for OpenVPN (management interface)"
url="https://github.com/jkroepke/openvpn-auth-oauth2"
# ppc64le: segfaults during build
arch="all !ppc64le"
license="MIT"
makedepends="go"
pkggroups="openvpn-auth"
install="$pkgname.pre-install"
subpackages="
	$pkgname-doc
	$pkgname-openrc
	"
source="https://github.com/jkroepke/openvpn-auth-oauth2/archive/v$pkgver/openvpn-auth-oauth2-$pkgver.tar.gz
	avoid-duplicating-daemon-logs.patch
	syslog-logging.patch
	$pkgname.initd
	$pkgname.confd
	config.yaml
	"

export GOFLAGS="$GOFLAGS -tags=no_otel"

build() {
	# Build the standalone executable only; Go c-shared is unsuitable for musl
	# dlopen. See https://github.com/golang/go/issues/54805.
	go build \
		-ldflags "-X github.com/jkroepke/openvpn-auth-oauth2/v2/internal/version.Version=$pkgver" \
		-o openvpn-auth-oauth2 \
		./cmd/openvpn-auth-oauth2
}

check() {
	GOEXPERIMENT=cgocheck2 go test ./...
}

package() {
	install -D -m755 openvpn-auth-oauth2 -t "$pkgdir"/usr/bin/

	install -d "$pkgdir"/etc
	install -d -m750 -g "$pkggroups" "$pkgdir"/etc/$pkgname
	install -D -m640 -g "$pkggroups" "$srcdir"/config.yaml -t "$pkgdir"/etc/$pkgname/

	install -D -m644 packaging/etc/openvpn-auth-oauth2/config.yaml \
		"$pkgdir"/usr/share/doc/$pkgname/config.yaml.example
	install -D -m644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.txt

	install -D -m755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -D -m644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

