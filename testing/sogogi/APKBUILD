# Maintainer: Prabu Anand Kalivaradhan <kprabuanand@gmail.com>
pkgname=sogogi
pkgver=0_git20260411
_commit="9188623fe7e6bb8cd5f5491a97c8ff047aceb852"
pkgrel=0
pkgdesc="A simple WebDAV server"
url="https://codeberg.org/emersion/sogogi"
license="AGPL-3.0-only"
arch="all"
makedepends="go scdoc"
subpackages="
	$pkgname-doc
	"
source="$pkgname-$_commit.tar.gz::https://codeberg.org/emersion/sogogi/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname"
options="net !check"


build() {
	go build
	scdoc < doc/$pkgname.1.scd > $pkgname.1
}

package() {
	install -Dm755 $pkgname "$pkgdir"/usr/bin/$pkgname
	install -Dm644 $pkgname.1 "$pkgdir"/usr/share/man/man1/$pkgname.1
}

sha512sums="
