# Maintainer: IP2Location <support@ip2location.com>
pkgname=ip2location
pkgver=8.7.0
pkgrel=0
pkgdesc="Lookup country, region and city information by IP addresses"
url="https://www.ip2location.com/development-libraries/ip2location/c"
arch="all"
license="MIT"
subpackages="$pkgname-dev $pkgname-doc"
checkdepends="perl"
makedepends="automake autoconf libtool zlib-dev"
source="$pkgname-$pkgver.zip::https://github.com/ip2location/IP2Location-C-Library/archive/refs/tags/$pkgver.zip"
builddir="$srcdir"/IP2Location-C-Library-$pkgver

prepare() {
	default_prepare
	autoreconf -i -v --force
}

build() {
	./configure --prefix=/usr
	make
}

package() {
	make install DESTDIR="$pkgdir"
}

check() {
	cd "$builddir"/data
	./ip-country.pl
	make check
}


sha512sums="
e927c80f1504c15fc94657df631ae8fbe69c362fca856ca819803ac6d1fd266a8a102e15805d672a3035f1c64dcefd65a517a50d80ef826c1751872c45c2e00e  ip2location-8.7.0.zip
"
