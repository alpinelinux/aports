From cadcc164bc86188ace5bb35416f017f01dec8f89 Mon Sep 17 00:00:00 2001
From: psykose <alice@ayaya.dev>
Date: Sat, 8 Jul 2023 01:42:32 +0000
Subject: [PATCH] lfs64.patch

force stat() instead of stat64() on 32-bit
---
 mozglue/baseprofiler/core/shared-libraries-linux.cc | 2 +-
 security/sandbox/linux/broker/SandboxBrokerUtils.h  | 2 +-
 xpcom/io/nsLocalFileUnix.h                          | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/mozglue/baseprofiler/core/shared-libraries-linux.cc b/mozglue/baseprofiler/core/shared-libraries-linux.cc
index cc5153719a58e..06fed4913c47f 100644
--- a/mozglue/baseprofiler/core/shared-libraries-linux.cc
+++ b/mozglue/baseprofiler/core/shared-libraries-linux.cc
@@ -186,7 +186,7 @@ class MemoryMappedFile {
       return false;
     }
 
-#if defined(__x86_64__) || defined(__aarch64__) ||  \
+#if 1 || defined(__x86_64__) || defined(__aarch64__) ||  \
     (defined(__mips__) && _MIPS_SIM == _ABI64) ||   \
     (defined(__loongarch__) && __loongarch_lp64) || \
     (defined(__riscv) && (__riscv_xlen == 64)) ||   \
diff --git a/security/sandbox/linux/broker/SandboxBrokerUtils.h b/security/sandbox/linux/broker/SandboxBrokerUtils.h
index 01d272441d7b5..4803f8d062d5d 100644
--- a/security/sandbox/linux/broker/SandboxBrokerUtils.h
+++ b/security/sandbox/linux/broker/SandboxBrokerUtils.h
@@ -14,7 +14,7 @@
 // calls. We'll intercept those and handle them in the stat functions
 // but must be sure to use the right structure layout.
 
-#if defined(__NR_stat64) || defined(__NR_fstatat64)
+#if 0 && (defined(__NR_stat64) || defined(__NR_fstatat64) )
 typedef struct stat64 statstruct;
 #  define statsyscall stat64
 #  define lstatsyscall lstat64
diff --git a/xpcom/io/nsLocalFileUnix.h b/xpcom/io/nsLocalFileUnix.h
index bbd68e69a02a0..2713a61f244c5 100644
--- a/xpcom/io/nsLocalFileUnix.h
+++ b/xpcom/io/nsLocalFileUnix.h
@@ -22,7 +22,7 @@
 
 // stat64 and lstat64 are deprecated on OS X. Normal stat and lstat are
 // 64-bit by default on OS X 10.6+.
-#if defined(HAVE_STAT64) && defined(HAVE_LSTAT64) && !defined(XP_DARWIN)
+#if 0 && defined(HAVE_STAT64) && defined(HAVE_LSTAT64) && !defined(XP_DARWIN)
 #  define STAT stat64
 #  define LSTAT lstat64
 #  define HAVE_STATS64 1
-- 
2.56.0

