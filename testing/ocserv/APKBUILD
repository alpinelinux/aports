# Maintainer: Tony Evl <anton@evlakh.ru>
pkgname=ocserv
pkgver=1.5.0
pkgrel=0
pkgdesc="OpenConnect VPN server"
url="https://ocserv.openconnect-vpn.net/"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	meson
	gperf
	protobuf-c-dev
	gnutls-dev
	libev-dev
	readline-dev
	libtasn1-dev
	talloc-dev
	libnl3-dev
	libmaxminddb-dev
	lz4-dev
	libseccomp-dev
	llhttp-dev
	krb5-dev
	linux-pam-dev
	oath-toolkit-dev
	radcli-dev
	"
source="https://www.infradead.org/ocserv/download/ocserv-$pkgver.tar.xz
	ocserv.initd
	"
install="$pkgname.pre-install"
# Tests need root (netns, TUN) and fail under fakeroot; disabled.
options="!check"
subpackages="$pkgname-openrc $pkgname-doc"

build() {
	abuild-meson build
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	install -D -m755 "$srcdir"/ocserv.initd "$pkgdir"/etc/init.d/ocserv
}

