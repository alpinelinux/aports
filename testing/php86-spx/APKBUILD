f2a8c9ee0c536d63c62735b8f4bb4183db1346d69c252d5b987cc56fcaba491bbc5e29f5be0d0eb1db32667b10ae46cb14af94c2793e6bc0dfcfb8efa386aee6  allow-php86.patch
258ecac7df3cec1a0c60371d6db6f129faad9785f4e8948f5963c68a1ea585dd7b16c5ec424865d6da2e5066b8fd0c0965daca3a8c037e10d81642ac25e06a18  isolate-parallel-test-data-dirs.patch
"
