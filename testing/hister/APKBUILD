# Maintainer: Florian Mirkes <fmirkes@mailbox.org>
pkgname=hister
pkgver=0.19.0
pkgrel=0
pkgdesc="Your own search engine"
url="https://hister.org"
arch="aarch64 x86_64" # other archs are unsupported by upstream
license="AGPL-3.0-or-later"
makedepends="go npm tzdata"
pkgusers="$pkgname"
pkggroups="$pkgname"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
options="net"
source="$pkgname-$pkgver.tar.gz::https://github.com/asciimoo/hister/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	$pkgname.yml
	"

build() {
	go generate
	go build
}

check() {
	go test ./...
}

package() {
	install -Dm755 "$builddir/$pkgname" "$pkgdir/usr/bin/$pkgname"

	install -Dm755 "$srcdir/$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
	install -Dm644 "$srcdir/$pkgname.confd" "$pkgdir/etc/conf.d/$pkgname"

	install -Dm640 -o $pkgusers -g $pkggroups "$srcdir/$pkgname.yml" "$pkgdir/etc/$pkgname.yml"
	install -dm750 -o $pkgusers -g $pkggroups "$pkgdir/var/lib/$pkgname"
}

