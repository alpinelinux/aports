# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=avd-fw
pkgver=0.2
pkgrel=0
pkgdesc="firmware for apple silicon video decoder"
url="https://github.com/AsahiLinux/avd-fw"
arch="aarch64" # works only on  apple silicon
license="MIT"
makedepends="meson clang llvm"
source="$pkgname-$pkgver.tar.xz::https://github.com/AsahiLinux/avd-fw/releases/download/v$pkgver/avd-fw-v$pkgver.tar.xz"

builddir="$srcdir"/avd-fw-v$pkgver
build() {
	abuild-meson --cross-file=./llvm.ini --prefix / --libdir=/lib \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	chmod 0644 "$pkgdir"/lib/firmware/apple/*
}

sha512sums="
dd7640d76ab2642900fa9805a1077bb11c907075f6b89b5843be3a8ebfbfcebfaa985fac6e6bd26afc8dde24968e1cb4344f39c4819aa583c24c5295d527c6f9  avd-fw-0.2.tar.xz
"
