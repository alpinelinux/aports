# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=avd-fw
pkgver=0.1
pkgrel=0
pkgdesc="firmware for apple silicon video decoder"
url="https://github.com/AsahiLinux/avd-fw"
arch="aarch64" # works only on  apple silicon
license="MIT"
makedepends="meson clang llvm"
source="$pkgname-$pkgver.tar.gz::https://github.com/AsahiLinux/avd-fw/archive/refs/tags/v$pkgver.tar.gz"

build() {
	abuild-meson --cross-file=./llvm.ini --libdir=/lib \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
7d2058620e616639d884037841fb63647d6bd73e9071d3a9b2fd860c2f9f1b30f9e920ba0fa3c02283db99af97832080ace97acce0492e38e563ea0e0581d9b4  avd-fw-0.1.tar.gz
"
