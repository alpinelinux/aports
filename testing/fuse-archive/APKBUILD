pkgname=fuse-archive
pkgver=1.24
pkgrel=0
pkgdesc="FUSE file system for archives and compressed files"
url="https://github.com/google/fuse-archive"
arch="all"
license="Apache-2.0"
makedepends="boost-dev fuse3-dev gtest-dev libarchive-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/google/fuse-archive/archive/v$pkgver/fuse-archive-$pkgver.tar.gz"

build() {
	make
}

check() {
	# Other tests mount file-systems and require /dev/fuse.
	make unit_tests
}

package() {
	make DESTDIR="$pkgdir" install
}

