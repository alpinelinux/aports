# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=md4qt
pkgver=5.1.4
pkgrel=0
pkgdesc="C++ library for parsing Markdown"
# armv7 fails to build due to running out of memory
arch="all !armv7"
url="https://invent.kde.org/libraries/md4qt"
license="BSD-2-Clause AND MIT"
makedepends="
	extra-cmake-modules
	qt6-qtbase-dev
	samurai
	"
_repo_url="https://invent.kde.org/libraries/md4qt.git"
source="https://download.kde.org/stable/md4qt/$pkgver/md4qt-$pkgver.tar.xz"
subpackages="$pkgname-dev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
faaa20071aeaecc522c17d2ae907a9705805be383122fb720587e38300fdf4c4706cfc18a1d5b02b11f55926af3f1a0d27361b20a8f4d341aebb97421f7310e9  md4qt-5.1.4.tar.xz
"
