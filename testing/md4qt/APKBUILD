# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=md4qt
pkgver=5.3.0
pkgrel=0
pkgdesc="C++ library for parsing Markdown"
# armv7 fails to build due to running out of memory
arch="all !armv7"
url="https://invent.kde.org/libraries/md4qt"
license="BSD-2-Clause AND MIT"
makedepends="
	extra-cmake-modules
	qt6-qtbase-dev
	samurai
	"
_repo_url="https://invent.kde.org/libraries/md4qt.git"
source="https://download.kde.org/stable/md4qt/$pkgver/md4qt-$pkgver.tar.xz"
subpackages="$pkgname-dev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
4e65375a83f6d404bfa69acd65bdc4d4091d41b98e065b6ae73594e0af69c7c32e80aa4477a3ed28055ba3d70e760233a84018cb3e766fcfcac38797213dc2d1  md4qt-5.3.0.tar.xz
"
