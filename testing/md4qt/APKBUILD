# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=md4qt
pkgver=5.2.0
pkgrel=0
pkgdesc="C++ library for parsing Markdown"
# armv7 fails to build due to running out of memory
arch="all !armv7"
url="https://invent.kde.org/libraries/md4qt"
license="BSD-2-Clause AND MIT"
makedepends="
	extra-cmake-modules
	qt6-qtbase-dev
	samurai
	"
_repo_url="https://invent.kde.org/libraries/md4qt.git"
source="https://download.kde.org/stable/md4qt/$pkgver/md4qt-$pkgver.tar.xz"
subpackages="$pkgname-dev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
7dc5e38d340b0390ff22cdf2036500f631fb0baee1920b77c2b646e99e1e112e81494ed1c88592f8d1f3c3fd88884edb008155109e7c6d2f157918babbf80342  md4qt-5.2.0.tar.xz
"
