# Contributor: Arch3y <arch3y@riseup.net>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=httrack
pkgver=3.49.21
pkgrel=0
pkgdesc="Website Copier - Free Software Offline Browser"
url="http://www.httrack.com/"
arch="all"
license="GPL-3.0"
makedepends="zlib-dev openssl-dev>3 libtool"
source="https://github.com/xroche/httrack/releases/download/$pkgver/httrack-$pkgver.tar.gz"
subpackages="$pkgname-doc"
builddir="$srcdir/$pkgname-$pkgver"
options="!check"

build() {
	cd "$builddir"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--datadir=/usr/share \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-static \
		--disable-dependency-tracking \
		--localstatedir=/var/lib \
		--docdir=/usr/share/doc/httrack
	make
}

package() {
	cd "$builddir"
	make DESTDIR="$pkgdir" install
}

sha512sums="
fad5ddf7b8938c55ec16bbad9808852208df7f606031e9ce149d9d80b754e9aa92e1cda0a7bfb6ce7457943f6249c6675fbf4e9185d155e231787d8321b295bb  httrack-3.49.21.tar.gz
"
