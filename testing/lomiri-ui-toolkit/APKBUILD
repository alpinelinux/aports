# Contributor: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=lomiri-ui-toolkit
pkgver=1.3.5907
pkgrel=2
pkgdesc="Qt Components for Lomiri"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://gitlab.com/ubports/development/core/lomiri-ui-toolkit"
license="LGPL-3.0-only"
depends="
	qt6-qt5compat
	"
depends_dev="
	bluez-dev
	libnih-dev
	lttng-ust-dev
	mir-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	"
depends_dev_qt5="
	eudev-dev
	libevdev-dev
	libxi-dev
	qt5-qtgraphicaleffects
	qt5-qtpim-dev
	qt5-qtsvg-dev
	qt5-qtsystems-dev
	"
makedepends="
	$depends_dev
	$depends_dev_qt5
	extra-cmake-modules
	samurai
	qt5-qtbase-dev
	qt5-qtdeclarative-dev
	qt5-qtpim-dev
	qt5-qtsvg-dev
	qt5-qtsystems-dev
	qt5-qtfeedback
	qt5-qtsvg-dev
	qt5-qttools-dev
	qt6-qt5compat-dev
	qt6-qtsvg-dev
	qt6-qttools-dev
	"
checkdepends="
	bash
	dbus-test-runner
	diffutils
	grep
	"
subpackages="
	$pkgname-lang
	$pkgname-qt5
	$pkgname-qt5-dev:qt5_dev
	$pkgname-dev
	"
source="https://gitlab.com/ubports/development/core/lomiri-ui-toolkit/-/archive/$pkgver/lomiri-ui-toolkit-$pkgver.tar.gz
	0001-Remove-debian-isms-from-test-runner.patch
	"
options="!check" # Several tests fail

build() {
	cmake -B build-qt6 -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build-qt6

	msg "Building Qt5 variant"
	mkdir build-qt5 && cd build-qt5
	qmake-qt5 CONFIG+="no_docs no_lttng" ..
	make
}

check() {
	ctest --test-dir build-qt6
}

package() {
	DESTDIR="$pkgdir" cmake --install build-qt6

	cd build-qt5
	make INSTALL_ROOT="$pkgdir" install
}

qt5() {
	depends="
		qt5-qtfeedback
		qt5-qtgraphicaleffects
		"

	amove usr/lib/*.so.5*
	amove usr/lib/qt5/qml
	amove usr/bin/lomiri-ui-toolkit-launcher
	amove usr/lib/lomiri-ui-toolkit
}

qt5_dev() {
	depends="
		$pkgname-qt5
		$depends_dev_qt5
		"

	amove usr/include/qt5
	amove usr/lib/qt5/mkspecs
	amove usr/lib/libLomiriGestures.prl
	amove usr/lib/libLomiriGestures.so
	amove usr/lib/libLomiriMetrics.prl
	amove usr/lib/libLomiriMetrics.so
	amove usr/lib/libLomiriToolkit.prl
	amove usr/lib/libLomiriToolkit.so
	amove usr/lib/pkgconfig/LomiriGestures.pc
	amove usr/lib/pkgconfig/LomiriMetrics.pc
	amove usr/lib/pkgconfig/LomiriToolkit.pc
}

