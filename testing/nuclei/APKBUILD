647868d3e1634b7fb415a113b14ad5bc335b65371f96d92f6f6e228cb20bc13f081b4ff0c572db825311d23cd13b4cc379970caf6832ac5c657896131d161ca2  10-set-GOFLAGS.patch
1441dede184fa06f7efedae33cabe972c8ff34b077d7ed5e4208f6e7fbc56166c969fb52f513c108157fc53146a1a2221c1b90e2265759f0ce05b105f6306a92  20-request-test.patch
"
