# Contributor: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=lomiri-api
pkgver=0.4.0
pkgrel=0
pkgdesc="API for Lomiri shell integration"
url="https://gitlab.com/ubports/development/core/lomiri-api"
arch="all !armhf" # blocked by qt6-qtdeclarative-dev
license="LGPL-3.0-only"
depends_dev="
	gtest-dev
	qt6-qtdeclarative-dev
	"
makedepends="
	$depends_dev
	cmake
	cmake-extras
	gmock
	libqtdbustest
	samurai
	"
checkdepends="dbus"
source="https://gitlab.com/ubports/development/core/lomiri-api/-/archive/$pkgver/lomiri-api-$pkgver.tar.gz"
subpackages="$pkgname-dev"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
4d6f3678d5f0f214f9ab7d80bd1364c1455a61191481c1cbe3d61015cae2658d1740386f0e2ae2befd259a230ebb89f6beb188a903dec8007d9d3303069a4ca9  lomiri-api-0.4.0.tar.gz
"
