pkgname=py3-paho-mqtt2
pkgver=2.1.0
pkgrel=0
pkgdesc="Python3 MQTT version 3.1/3.1.1/5.0 client class"
url="https://www.eclipse.org/paho/"
arch="noarch"
license="EPL-1.0"
depends="python3"
makedepends="py3-build py3-installer py3-pip py3-gpep517"
checkdepends=""
subpackages="$pkgname-pyc"
source="paho-mqtt-$pkgver.tar.gz::https://github.com/eclipse/paho.mqtt.python/archive/v$pkgver.tar.gz"
builddir="$srcdir"/paho.mqtt.python-$pkgver
options="!check" # Tests are disabled because they require an MQTT broker and a network connection

build() {
	python3 -m build
}

package() {
	cd "$builddir"/dist
	python3 -m pip install --root="$pkgdir" "paho_mqtt-$pkgver-py3-none-any.whl"
}

sha512sums="
