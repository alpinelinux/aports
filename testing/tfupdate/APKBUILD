	go-1.27.0.patch
	"
options="net"

build() {
	go build -o tfupdate-bin .
}

check() {
	go test ./...
}

package() {
	install -Dm755 tfupdate-bin "$pkgdir/usr/bin/$pkgname"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

