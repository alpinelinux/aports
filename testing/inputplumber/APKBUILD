# Contributor: Victoria Brekenfeld <pkg@drakulix.de>
# Contributor: Casey Connolly <kcxt@postmarketos.org>
maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=inputplumber
pkgver=0.83.1
pkgrel=0
pkgdesc="Open source input router and remapper daemon for Linux"
url="https://github.com/ShadowBlip/InputPlumber"
# ppc64le, s390x: error[E0659]: `STATX_TYPE` is ambiguous
# loongarch64: error[E0432]: unresolved import `self::consts`
arch="all !ppc64le !s390x !loongarch64"
license="GPL-3.0-or-later"
makedepends="
	cargo
	cargo-auditable
	clang21-dev
	eudev-dev
	linux-headers
	rust
	sccache
"
checkdepends="rust-clippy"
source="$pkgname-$pkgver.tar.gz::https://github.com/ShadowBlip/InputPlumber/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/InputPlumber-$pkgver"
subpackages="
	$pkgname-udev
	$pkgname-systemd
	$pkgname-polkit
	$pkgname-dbus
"

build() {
	cargo auditable build --release --target "$CHOST" --locked
}

check() {
	make test
}

package() {
	make install PREFIX="$pkgdir"/usr
}

polkit() {
	pkgdesc="$pkgname (polkit policies)"
	install_if="$pkgname=$pkgver-r$pkgrel polkit"
	amove usr/share/polkit-1
}

dbus() {
	pkgdesc="$pkgname (dbus files)"
	install_if="$pkgname=$pkgver-r$pkgrel dbus"
	amove usr/share/dbus-1
}

sha512sums="
519e487e5e3cc9e2543040c8e25bc969958a1859dd304ea233501cc1b6dde111cb24fd40790e4b3473760ec318550782a1ac9ff7bea17f79b99c9f65cd44c450  inputplumber-0.83.1.tar.gz
"
