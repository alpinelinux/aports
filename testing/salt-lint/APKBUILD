# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=salt-lint
pkgver=0.9.2
pkgrel=0
pkgdesc="Command-line utility that checks for best practices in SaltStack"
url="https://github.com/warpnet/salt-lint"
arch="noarch"
license="MIT"
depends="
	python3
	py3-pathspec
	py3-yaml
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-pytest-cov
	"
subpackages="$pkgname-pyc $pkgname-doc"
source="https://github.com/warpnet/salt-lint/archive/v$pkgver/salt-lint-$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 docs/man/salt-lint.1 -t "$pkgdir"/usr/share/man/man1/
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/doc/$pkgname/
}

sha512sums="
3a4adde0107e1423b1bdc71de182249d47ff4fe1e83f393895ebb4cb13d0cd5233dc5213c7c784a46722a870f37b9f5ee2116ca01fd973e35c28bb8e9f4eb6e9  salt-lint-0.9.2.tar.gz
"
