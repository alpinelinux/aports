# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=tabula
pkgver=1.0.2
pkgrel=0
pkgdesc="Wayland wallpaper tool for mobile (for Catacomb)"
url="https://catacombing.org/"
# riscv64: compiles too slowly
# ppc64le s390x: blocked by aports#18444
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-only"
options="net" # need to download some cargo deps
makedepends="cargo-auditable libxkbcommon-dev"
source="$pkgname-v$pkgver.tar.gz::https://git.sr.ht/~undeadleech/tabula/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/tabula -t "$pkgdir"/usr/bin/
}
sha512sums="
05fccb2a3f79c9017eab5afbc6af98add2c449528c0aaf80d956c658c4f2878b70cf67a7bad92b73d271c2dfac66b75dc2c711be7c1cc8c9995bc0804bf30b43  tabula-v1.0.2.tar.gz
"
