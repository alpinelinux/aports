maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-valkey
_pyname=valkey
pkgver=6.2.0
pkgrel=0
pkgdesc="Python client for Valkey"
url="https://github.com/valkey-io/valkey-py"
arch="noarch"
license="MIT"
depends="python3"
makedepends="
	py3-gpep517
	py3-hatchling
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-cachetools
	py3-pytest
	py3-pytest-asyncio
	py3-pytest-timeout
	valkey
	valkey-lua
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pyname:0:1}/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	# start local valkey server for tests
	valkey-server --bind 127.0.0.1 --port 6379 --save '' --appendonly no \
		--loadmodule /usr/lib/valkey/modules/lua.so \
		--enable-debug-command yes --dir "$srcdir" >"$srcdir"/valkey.log 2>&1 &
	local _pid=$!
	trap 'kill $_pid' EXIT   # stop the server also if pytest fails

	# wait until it answers
	for _ in $(seq 20); do
		valkey-cli -h 127.0.0.1 ping 2>/dev/null | grep -q PONG && break
		sleep 0.5
	done

	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl

	# Skipped tests:
	# - test_module, test_module_loadex, test_psync, test_quit,
	#   test_slowlog_get, test_network_connection_failure:
	#     need modules, a replica on 6380 or an IPv6 loopback
	# - test_bgsave: polls 10 s for a background save, too slow on some builders
	# - test_xgroup_create_entries_read: fixed upstream with 668cd5f
	# - test_pubsub_deadlock: fixed upstream in 71133092
	.testenv/bin/python3 -m pytest -o addopts='' \
		--ignore=tests/test_ssl.py \
		--ignore=tests/test_asyncio/test_cluster.py \
		--deselect tests/test_commands.py::TestValkeyCommands::test_module \
		--deselect tests/test_commands.py::TestValkeyCommands::test_module_loadex \
		--deselect tests/test_commands.py::TestValkeyCommands::test_psync \
		--deselect tests/test_commands.py::TestValkeyCommands::test_quit \
		--deselect tests/test_commands.py::TestValkeyCommands::test_slowlog_get \
		--deselect tests/test_connection.py::test_network_connection_failure \
		--deselect tests/test_commands.py::TestValkeyCommands::test_bgsave \
		--deselect tests/test_commands.py::TestValkeyCommands::test_xgroup_create_entries_read \
		--deselect tests/test_pubsub.py::TestPubSubDeadlock::test_pubsub_deadlock \
		-k 'not sentinel and not Sentinel' \
		-m 'not ssl and not onlycluster' -q
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
