# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=epitaph
pkgver=1.4.0
pkgrel=0
pkgdesc="Wayland Mobile panel (for Catacomb)"
url="https://catacombing.org/"
# riscv64: compiles too slowly
# ppc64le s390x: blocked by aports#18444
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-only"
options="net" # need to download some cargo deps
makedepends="
	cargo-auditable
	fontconfig-dev
	libpulse
	libxkbcommon-dev
	udev-dev
"
source="$pkgname-v$pkgver.tar.gz::https://git.sr.ht/~undeadleech/epitaph/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/epitaph -t "$pkgdir"/usr/bin/
}
sha512sums="
143a22ac9e3aa845606ae827748035fa366e1bdf7e89ecde6bdfb7322a67d3ec34d28ac95e1b5dd142c8548ef82a3615bf510d74fc398ce90d934f46f017bd4c  epitaph-v1.4.0.tar.gz
"
