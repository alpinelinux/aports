# Contributor: nicole mikołajczyk <git@mkljczk.pl>
# Maintainer: nicole mikołajczyk <git@mkljczk.pl>
pkgname=cutecosmic
pkgver=0.2.0
pkgrel=0
pkgdesc="Qt platform theme for the COSMIC™ Desktop environment"
url="https://github.com/IgKh/cutecosmic"
arch="all !armhf" # armhf blocked by qt6-qtdeclarative
license="GPL-3.0-or-later"
makedepends="
	corrosion
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	samurai
	"
subpackages="$pkgname-doc"
source="https://github.com/IgKh/cutecosmic/archive/refs/tags/v$pkgver/cutecosmic-$pkgver.tar.gz"
options="!check net" # cargo crates

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dvm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
}

sha512sums="
e42011b26e058d75007db2abfc6c95d8fee3ea0a469655e80d8b5a0a7707041ad2aab746e4f33bd1f4188c6712c33d9c12832f246d4e357569262009873f58b5  cutecosmic-0.2.0.tar.gz
"
