# Contributor: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Romain Isnel <ri@frmg.eu>
pkgname=alps
pkgver=1.1.2
pkgrel=0
pkgdesc="Simple and extensible webmail"
url="https://github.com/migadu/alps"
arch="all"
license="MIT"
makedepends="go"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/migadu/alps/archive/refs/tags/v$pkgver.tar.gz
	alps.confd
	alps.initd
	"
options="!check net" # no tests in upstream

build() {
	make build
}

package() {
	install -Dm755 build/alps "$pkgdir"/usr/bin/alps
	install -Dm755 config.example.toml "$pkgdir"/etc/alps/config.toml

	install -dm755 "$pkgdir"/usr/lib/alps

	install -Dm755 "$srcdir"/alps.initd "$pkgdir"/etc/init.d/alps
	install -Dm644 "$srcdir"/alps.confd "$pkgdir"/etc/conf.d/alps
}

sha512sums="
