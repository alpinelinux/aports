# Maintainer: Andy Postnikov <apostnikov@gmail.com>
pkgname=php86-pecl-memcache
_extname=memcache
pkgver=8.2
pkgrel=0
pkgdesc="PHP 8.6 memcache extension, provides handy OO and procedural interfaces, can be used as session handler - PECL"
url="https://pecl.php.net/package/memcache"
arch="all"
license="PHP-3.0"
_phpv=86
_php=php$_phpv
depends="$_php-session"
makedepends="$_php-dev"
source="php-pecl-$_extname-$pkgver.tgz::https://pecl.php.net/get/$_extname-$pkgver.tgz
	fix-smartstr.patch
	php86-support.patch
	php86-session-handlers.patch"
builddir="$srcdir/$_extname-$pkgver"

install_if="php-$_extname php$_phpv"

build() {
	phpize$_phpv
	./configure --prefix=/usr --with-php-config=php-config$_phpv
	make
}

check() {
	# Tests require 3 memcached servers, basic check, see tests/memcache.sh
	$_php -dextension=modules/$_extname.so --ri $_extname
}

package() {
	make INSTALL_ROOT="$pkgdir" install
	local _confdir="$pkgdir"/etc/$_php/conf.d
	install -d $_confdir
	echo "extension=$_extname" > $_confdir/$_extname.ini
}

