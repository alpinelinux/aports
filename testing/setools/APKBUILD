maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=setools
pkgver=4.7.1
pkgrel=0
pkgdesc="SELinux Policy Analysis Tools"
url="https://github.com/SELinuxProject/setools"
arch="all"
license="LGPL-2.1-only"
makedepends="
	cython
	libselinux-dev
	libsepol-dev
	linux-headers
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
checkdepends="py3-pytest py3-pytest-qt"
subpackages="$pkgname-doc $pkgname-pyc"
source="https://github.com/SELinuxProject/setools/releases/download/$pkgver/setools-$pkgver.tar.bz2"
options="!check" # needs PYTHONPATH handleing

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
c2b1cb880e4205dd995697c0421495992c7262927bfee2546c9b5c20e9c277504a799d40c3324e2e7601aeb0911b19f826fab5bd6f7362eef9b1d936be547135  setools-4.7.1.tar.bz2
"
