# Maintainer omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=xarcan
pkgver=0.7.1
pkgrel=0
pkgdesc="Patched Xserver that bridges connections to Arcan"
url="https://codeberg.org/letoram/xarcan"
arch="all"
license="MIT"
depends="
	font-cursor-misc
	font-misc-misc
	xkbcomp
	xkeyboard-config
	"
depends_dev="
	libepoxy-dev
	libxfont2-dev
	mesa-dev
	"
makedepends="
	$depends_dev
	arcan-dev
	eudev-dev
	libdrm-dev
	libx11-dev
	libxau-dev
	libxcb-dev
	libxcvt-dev
	libxdmcp-dev
	libxext-dev
	libxkbfile-dev
	libxshmfence-dev
	meson
	nettle-dev
	pixman-dev
	xcb-util-dev
	xcb-util-image-dev
	xcb-util-keysyms-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkbcomp-dev
	xorgproto
	"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/letoram/xarcan/archive/$pkgver.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	_fontroot="/usr/share/fonts"

	abuild-meson \
		-Dxarcan=true \
		-Dglamor=true \
		-Dipv6=true \
		-Dint10=false \
		-Dsystemd_logind=false \
		-Ddefault_font_path=$_fontroot/misc,$_fontroot/100dpi:unscaled,$_fontroot/75dpi:unscaled,$_fontroot/TTF,$_fontroot/Type1 \
		. output
	meson compile -C output
}

check() {
	# a stupid test
	./output/hw/kdrive/arcan/Xarcan -help
}

package() {
	install -Dm755 output/hw/kdrive/arcan/Xarcan -t "$pkgdir"/usr/bin/
}

sha512sums="
21092e9ec7e4934acafaab918be30243dff0f94c693c6707ea02a0013887af52e3a25e3e5a1598f6c7ea39cfc35f4e94e92d4357cfe9bd6d8761572498d8d5ff  xarcan-0.7.1.tar.gz
"
