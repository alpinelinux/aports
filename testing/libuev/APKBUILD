# Maintainer: Tuwum <tuwum@wairu.space>
pkgname=libuev
pkgver=2.4.1
pkgrel=0
pkgdesc="Simple event loop for Linux"
url="https://github.com/troglobit/libuev"
arch="all"
license="MIT"
makedepends="libtool"
subpackages="$pkgname-doc $pkgname-dev"
source="https://github.com/troglobit/libuev/releases/download/v$pkgver/libuev-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	"$builddir"/configure --prefix=/usr
	make -C "$builddir"
}

check() {
	make -C "$builddir" check
}

package() {
	DESTDIR="$pkgdir" make -C "$builddir" install-strip
}

sha512sums="
