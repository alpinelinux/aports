# Contributor: macmpi <spam@ipik.org>
# Maintainer: macmpi <spam@ipik.org>
maintainer="macmpi <spam@ipik.org>"
pkgname=raspberrypi-eeprom
# Follow apt-version tags (without -<debian_revision>)
pkgver=28.33
pkgrel=0
_aptvers=$pkgver-1
pkgdesc="Raspberry Pi 4/5 boot EEPROM updater"
url="https://github.com/raspberrypi/rpi-eeprom"
arch="noarch"
license="BSD-3-Clause"
source="$pkgname-$pkgver.tar.gz::https://github.com/raspberrypi/rpi-eeprom/archive/refs/tags/apt/$_aptvers.tar.gz
	use-vi-as-default-editor.patch
	"
# does not have any tests
options="!check"
subpackages="
	$pkgname-pi4:bundle_2711:noarch
	$pkgname-pi5:bundle_2712:noarch
	$pkgname-sign-tools:tools:noarch
	$pkgname-doc
	"
builddir="$srcdir/rpi-eeprom-apt-$_aptvers"
# relocate default directory containing the EEPROM images
_path=/usr/share/raspberrypi/bootloader

package() {
	depends="python3"

	install -Dm755 -t "$pkgdir"/usr/bin/ \
		"$builddir"/rpi-eeprom-config \
		"$builddir"/rpi-eeprom-digest

	install -Dm 644 "$builddir"/LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	
	if [ "$CARCH" = "aarch64" ]; then
		# lspci only used on Pi4, but depend is always enforced in rpi-eeprom-update
		depends="$depends
			flashrom>=1.8.0
			pciutils
			"

		install -Dm755 -t "$pkgdir"/usr/bin/ \
			"$builddir"/rpi-eeprom-update \
			"$builddir"/rpi-bootloader-version

		sed -i "s|^FIRMWARE_ROOT=.*|FIRMWARE_ROOT=$_path|"  "$builddir"/rpi-eeprom-update-default
		install -Dm644 "$builddir"/rpi-eeprom-update-default "$pkgdir"/etc/default/rpi-eeprom-update
	fi
}

add_bundle_files() {
	install -dm755 "$subpkgdir$_path-$1"
	for i in default latest; do
		cp -a "$builddir"/firmware-"$1"/$i "$subpkgdir$_path-$1"
	done
}

bundle_2711() {
	pkgdesc="EEPROM bootloader files bundle for Pi4 series."
	license="custom"
	depends="$pkgname=$pkgver-r$pkgrel"
	if [ "$CARCH" = "aarch64" ]; then
		# Pi4 bootloaders older than 2022-01-25 default release may not
		# populate /chosen/bootloader/ device tree nodes and need vcgencmd fallback
		depends="$depends
			raspberrypi-utils-vcgencmd
			"
	fi

	add_bundle_files 2711
}

bundle_2712() {
	pkgdesc="EEPROM bootloader files bundle for Pi5 series."
	license="custom"
	depends="$pkgname=$pkgver-r$pkgrel"
	if [ "$CARCH" = "aarch64" ]; then
		depends="$depends
			raspberrypi-utils-rpieepromab
			"
	fi

	add_bundle_files 2712
}

tools() {
	pkgdesc="Signing tools for Pi 4/5 EEPROMs."
	license="BSD-3-Clause"
	depends="python3 py3-pycryptodome"
	
	install -Dm755 -t "$subpkgdir"/usr/bin/ \
		"$builddir"/tools/rpi-sign-bootcode \
		"$builddir"/tools/rpi-bootloader-key-convert
		# omit deprecated tools rpi-otp-private-key & vl805
}

