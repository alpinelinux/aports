maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-pytest-mock-resources
pkgver=2.13.0
pkgrel=0
pkgdesc="Pytest fixtures for testing against external resources"
url="https://github.com/schireson/pytest-mock-resources"
license="MIT"
arch="noarch"
depends="py3-pytest"
makedepends="py3-gpep517 py3-uv-build py3-pytest-asyncio"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.zip::https://github.com/schireson/pytest-mock-resources/archive/refs/tags/v$pkgver.zip"
builddir="$srcdir/pytest-mock-resources-$pkgver"
options="!check" # tests run docker containers

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -Pm pytest tests
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
4eef291f23e4dd611a4e21b3644494a70f18edd47503bff249078c760e6c008e15735ff34c645d89fec9b23fb980620aa081d58006b1206cb8fb50537d72af87  py3-pytest-mock-resources-2.13.0.zip
"
