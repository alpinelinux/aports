# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=cat9
pkgver=0_git20261008
_cat9rev=4e5330ee4a6fc29a75d0899ffd6e930bb5c23c57
pkgrel=1
pkgdesc="User shell for LASH"
arch="all"
url="https://codeberg.org/letoram/cat9"
license="Unlicense"
depends="arcan-afsrv-terminal"
subpackages="$pkgname-doc"
source="$pkgname-$_cat9rev.tar.gz::https://codeberg.org/letoram/cat9/archive/$_cat9rev.tar.gz"
builddir="$srcdir/$pkgname"
options="!check" # no test suite

package() {
	install -Dm644 cat9.lua -t "$pkgdir"/usr/share/arcan/"$pkgname"/
	cp -r "$pkgname" "$pkgdir"/usr/share/arcan/"$pkgname"/

	install -Dm644 CHANGELOG.md HACKING.md README.md \
		-t "$pkgdir"/usr/share/doc/"$pkgname"/
}

sha512sums="
