maintainer=""
pkgname=kiota
pkgver=1.32.5
pkgrel=0
pkgdesc="OpenAPI based HTTP client code generator"
url="https://github.com/microsoft/kiota"
arch="aarch64 armv7 x86_64"  # others are blocked by dotnet10-runtime
license="MIT"
depends="dotnet10-runtime"
makedepends="dotnet10-sdk"
source="$pkgname-$pkgver.tar.gz::https://github.com/microsoft/kiota/archive/refs/tags/v$pkgver.tar.gz
	update-github-pkg.patch
	"
options="net"

export DOTNET_CLI_HOME="$srcdir"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1

build() {
	dotnet publish src/kiota/kiota.csproj \
		--framework "net10.0" \
		--no-self-contained \
		--use-current-runtime \
		--configuration Release \
		-p:DebugSymbols=false \
		-p:DebugType=None \
		--output publish
}

check() {
	./publish/kiota --version
}

package() {
	mkdir -p "$pkgdir"/usr/lib
	cp -af publish "$pkgdir"/usr/lib/$pkgname

	mkdir -p "$pkgdir"/usr/bin
	ln -s ../lib/$pkgname/kiota "$pkgdir"/usr/bin/$pkgname
}

sha512sums="
5da8853b9fb5cec2826a2a00ede202a863ceb6c6dceee24d2ccff13c59b521ed8316f8cf270b647d5468b2f3e7091941cfe798124b547daec04348e6f2ced01e  kiota-1.32.5.tar.gz
637af7d6bdd399b9107307df093ba739b587b450b7ef56c58353453ed560b520204ee2fba3fa619605cecc5c1d899a358dcaf12148a18199d7c732642e55e3bf  update-github-pkg.patch
"
