# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=lomiri-action-api
pkgver=1.2.2
pkgrel=1
pkgdesc="Lomiri Action Qt API"
url="https://gitlab.com/ubports/development/core/lomiri-action-api"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
license="LGPL-3.0-only"
depends_dev="qt6-qtdeclarative-dev"
makedepends="
	$depends_dev
	cmake
	samurai
	"
checkdepends="dbus-test-runner"
subpackages="$pkgname-dev"
source="https://gitlab.com/ubports/development/core/lomiri-action-api/-/archive/$pkgver/lomiri-action-api-$pkgver.tar.gz"
options="!check" # tests hang

build() {
	export PATH="$PATH:/usr/lib/qt6/bin"
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-Duse_libhud2=OFF \
		-DENABLE_QT6=ON
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
21fa7001ca66c83d0ddac9ae0d9104124d5cc3d561ac2ebb9c2f4af084b0a1de83713f89d0c7767fa2f12fb771455f690a7649fa86f3c92f66c56c95ee2c3018  lomiri-action-api-1.2.2.tar.gz
"
