# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=mangobar
pkgver=0.2.1
pkgrel=0
pkgdesc="simple bar for mango"
arch="all"
url="https://github.com/mangowm/mangobar"
license="GPL-3.0-or-later"
makedepends="muon
	alsa-lib-dev
	cjson-dev
	elogind-dev
	eudev-dev
	fcft-dev
	gdk-pixbuf-dev
	pango-dev
	pulseaudio-dev
	wayland-dev
	wayland-protocols
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/mangowm/mangobar/archive/refs/tags/$pkgver.tar.gz"
options="!check" # no test suite

build() {
	abuild-muon output .
	ninja -C output
}

package() {
	DESTDIR="$pkgdir" muon -C output install
}

sha512sums="
