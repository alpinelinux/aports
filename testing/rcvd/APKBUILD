# Contributor: Christopher Mosetick <office@cpm.is>
# Maintainer: Christopher Mosetick <office@cpm.is>
maintainer="Christopher Mosetick <office@cpm.is>"
pkgname=rcvd
pkgver=0.1.1
pkgrel=0
pkgdesc="Privacy-first encrypted DNS engine (DoQ/DoT/DoH, no cleartext fallback)"
url="https://rcvd.net"
arch="all"
license="MIT"
depends="ca-certificates"
makedepends="go"
install="$pkgname.pre-install"
pkgusers=rcvd
pkggroups=rcvd
subpackages="$pkgname-doc $pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/rcvd-dns/rcvd/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	$pkgname.sysctl.conf
	"
options="net" # go modules

build() {
	# Stamp version/date/source (matches rcvd's release recipe). Derive the
	# build date from SOURCE_DATE_EPOCH so the build stays reproducible; the
	# git commit stays "unknown" (no .git in the release tarball, by design).
	local _date
	_date="$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%dT%H:%M:%SZ)"
	go build -v -o output/rcvd \
		-ldflags "-s -w \
			-X main.version=$pkgver \
			-X main.buildDate=$_date \
			-X main.buildSource=alpine" \
		./cmd/rcvd
}

check() {
	./output/rcvd -version
}

package() {
	install -dvm0755 -o "$pkgusers" -g "$pkggroups" \
		"$pkgdir"/etc/$pkgname \
		"$pkgdir"/var/log/$pkgname

	install -Dvm0755 output/rcvd -t "$pkgdir"/usr/bin/

	# ship the encrypted-forwarder profile as the default config
	install -Dvm0644 etc/mode1-forwarder-3providers.toml \
		"$pkgdir"/etc/$pkgname/rcvd.toml

	install -Dvm0755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dvm0644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
	install -Dvm0644 "$srcdir"/$pkgname.sysctl.conf \
		"$pkgdir"/etc/sysctl.d/$pkgname.conf

	# additional example profiles as documentation
	install -Dvm0644 etc/*.toml -t "$pkgdir"/usr/share/doc/$pkgname/examples/
	install -Dvm0644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

