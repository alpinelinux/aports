# Contributor: Daniil Nemtsev <nmsv@pm.me>
# Maintainer: Daniil Nemtsev <nmsv@pm.me>
pkgname=pakstak
pkgver=0.2.0
pkgrel=0
pkgdesc="Unprivileged container manager"
url="https://github.com/pakstak/pakstak"
arch="all"
license="MIT OR Apache-2.0"
makedepends="
	cargo
	cargo-auditable
	"
depends="cmd:bwrap"
source="$pkgname-$pkgver.tar.gz::https://github.com/pakstak/pakstak/archive/refs/tags/v$pkgver.tar.gz
	"
prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --bin pakstak --frozen
}

package() {
	install -Dm755 target/release/pakstak \
		-t "$pkgdir"/usr/bin/
}

sha512sums="
af8b0f6895f60bfdb893666f6c627d90c21768a0b2b4edd3a20e1414e9b7538b13440f94f2f531c1b79f9ebae9213f598eb0763b92f1250384bd84a877d92e02  pakstak-0.2.0.tar.gz
"
