#!/sbin/openrc-run

description="zrepl ZFS replication daemon"

cfgfile="${cfgfile:-/etc/zrepl/zrepl.yml}"

command="/usr/bin/zrepl"
command_args="--config $cfgfile daemon"
command_user="root:root"
supervisor="supervise-daemon"
respawn_delay=5
output_logger="logger -t zrepl -p daemon.info"
error_logger="logger -t zrepl -p daemon.err"

depend() {
	need localmount
	use net
	after zfs-import zfs-mount firewall
}

start_pre() {
	checkpath --directory --mode 0700 --owner root:root /run/zrepl
	$command configcheck --config "$cfgfile" >/dev/null
}
