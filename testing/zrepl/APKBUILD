# Contributor: Shawn Rose <shawnandrewrose@gmail.com>
# Maintainer: Berk D. Demir <bdd@mindcast.org>
pkgname=zrepl
pkgver=0.7.0
pkgrel=0
pkgdesc="one-stop, integrated solution for ZFS replication"
url="https://zrepl.github.io/"
arch="all"
license="MIT"
options="net" # go
makedepends="go bash"
checkdepends="tzdata"
subpackages="
	$pkgname-openrc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/zrepl/zrepl/archive/v$pkgver.tar.gz
	zrepl.yml
	zrepl.initd
	"

build() {
	go build \
		-ldflags "-X github.com/zrepl/zrepl/internal/version.zreplVersion=v$pkgver" \
		-o "artifacts/zrepl"
	./artifacts/zrepl gencompletion bash ./artifacts/bash-completion
	./artifacts/zrepl gencompletion zsh ./artifacts/zsh-completion
}

check() {
	# Upstream uses CIRCLECI[^1] env var to skip 6 tests that require low
	# scheduler latency[^2].
	# Skip these flaky tests in CI.
	#
	# ^1: https://raw.githubusercontent.com/zrepl/zrepl/master/internal/util/zreplcircleci/zreplcircleci.go
	# ^2: https://github.com/search?q=repo%3Azrepl%2Fzrepl+SkipOnCircleCI&type=code
	CIRCLECI=1 go test ./...
}

package() {
	install -Dm0755 artifacts/zrepl "$pkgdir"/usr/bin/zrepl
	install -Dm755 "$srcdir"/zrepl.initd \
		"$pkgdir"/etc/init.d/zrepl
	install -Dm644 "$srcdir"/zrepl.yml \
		"$pkgdir"/etc/zrepl/zrepl.yml
	install -Dm0644 artifacts/bash-completion \
		"$pkgdir"/usr/share/bash-completion/completions/$pkgname
	install -Dm0644 artifacts/zsh-completion \
		"$pkgdir"/usr/share/zsh/site-functions/_$pkgname
	cd "$builddir/internal/config/samples"
	find ./* -type f -exec install -m 644 -D "{}" "$pkgdir/usr/share/$pkgname/examples/{}" \;
}

sha512sums="
