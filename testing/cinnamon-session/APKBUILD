maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=cinnamon-session
pkgver=6.8.0
pkgrel=0
pkgdesc="Cinnamon session manager (fork of gnome-session)"
url="https://github.com/linuxmint/cinnamon-session"
arch="all !armhf !armv7" # cinnamon -> cjs -> mozjs
license="GPL-2.0-or-later"
depends="
	cinnamon
	cinnamon-screensaver
	cinnamon-settings-daemon
	nemo
	"
makedepends="
	cinnamon-desktop-dev
	glib-dev
	gtk+3.0-dev
	libcanberra-dev
	libsm-dev
	meson
	xapp-dev
	"
subpackages="$pkgname-doc"
source="https://github.com/linuxmint/cinnamon-session/archive/$pkgver/cinnamon-session-$pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
8879111b955a24b981189eb48b99c3a6cd838a12fc1ecaa93df9fec6ad2d24afb13d26785f157e77230441a57149762fd25d6051e6f48bae2451d70e0c8fbafb  cinnamon-session-6.8.0.tar.gz
"
