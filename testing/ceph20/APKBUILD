osd() {
	pkgdesc="Object storage daemon virtual package for the Ceph distributed file system."
	depends="$pkgname-osd-daemon=$pkgver-r$pkgrel
		$pkgname-osd-tools=$pkgver-r$pkgrel
		$pkgname-volume=$pkgver-r$pkgrel"
	_default_replace_majorversion

	mkdir -p "$subpkgdir"
}

common_daemon() {
	pkgdesc="Common files for object storage daemon for the Ceph distributed file system."
	depends="$_osd_daemon_deps $pkgname-user=$pkgver-r$pkgrel"
	_default_replace_majorversion

	amove usr/libexec/ceph/ceph-osd-prestart.sh \
		etc/sudoers.d/ceph-smartctl \
		etc/sysctl.d/90-ceph-osd.conf
	install -m 750 -o $_ceph_uid -g $_ceph_gid -d \
		"$subpkgdir"/var/lib/ceph/osd
}

crimson_daemon() {
	pkgdesc="Crimson object storage daemon for the Ceph distributed file system."
	depends="!$pkgname-osd-classic-daemon $pkgname-common-daemon=$pkgver-r$pkgrel"
	_default_replace_majorversion
	provides="$provides $pkgname-osd-daemon=$pkgver-r$pkgrel"
	provider_priority=50

	install -Dm755 "$pkgdir"/usr/bin/crimson-osd "$subpkgdir"/usr/bin/ceph-osd
	rm "$pkgdir"/usr/bin/crimson-osd
}

osd_daemon() {
	pkgdesc="Object storage daemon for the Ceph distributed file system."
	depends="!$pkgname-osd-crimson-daemon $pkgname-common-daemon=$pkgver-r$pkgrel"
	_default_replace_majorversion
	provides="$provides $pkgname-osd-daemon=$pkgver-r$pkgrel"
	provider_priority=100

	amove usr/bin/ceph-osd
}

osd_tools() {
	pkgdesc="Object storage daemon tools for the Ceph distributed file system."
	depends="$pkgname-base=$pkgver-r$pkgrel $_osd_tools_deps"
	_default_replace_majorversion


	if [ "$_crimson" = ON ]; then
		amove usr/bin/crimson-store-nbd
	fi

	amove usr/bin/ceph-clsinfo usr/bin/ceph-*-tool
	install -m 750 -o $_ceph_uid -g $_ceph_gid -d \
		"$subpkgdir"/var/lib/ceph/osd
}

