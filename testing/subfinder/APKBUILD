pkgname=subfinder
pkgver=2.16.0
pkgrel=0
pkgdesc="Fast passive subdomain enumeration tool"
url="https://docs.projectdiscovery.io/tools/subfinder"
arch="all"
license="MIT"
makedepends="go"
subpackages="$pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/projectdiscovery/subfinder/archive/refs/tags/v$pkgver.tar.gz
	10-disable-failing-tests.patch
	20-set-GOFLAGS.patch
	"
options="net"

build() {
	make build
}

check() {
	make test
}

package() {
	install -Dm755 "$builddir/subfinder" -t "$pkgdir/usr/bin/"
	install -Dm644 LICENSE.md "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

