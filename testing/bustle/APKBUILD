# Contributor: Alex Ungur <alexaandru@gmail.com>
maintainer="Alex Ungur <alexaandru@gmail.com>"
pkgname=bustle
pkgver=0.14.0
pkgrel=0
pkgdesc="Draw sequence diagrams of D-Bus traffic"
url="https://gitlab.gnome.org/World/bustle"
license="LGPL-2.1-or-later"
arch="all"
makedepends="
	cargo
	cargo-auditable
	cmake
	desktop-file-utils
	gdk-pixbuf-dev
	gtk4.0-dev
	libadwaita-dev
	meson
"
subpackages="$pkgname-lang $pkgname-doc"
source="https://gitlab.gnome.org/World/bustle/-/archive/$pkgver/bustle-$pkgver.tar.gz
	frozen-auditable.patch
	"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	abuild-meson build
	meson compile -C build
}

check() {
	cargo test --frozen
}

package() {
	DESTDIR="$pkgdir" meson install -C build
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

