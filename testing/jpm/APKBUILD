maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=jpm
pkgver=1.2.0
pkgrel=0
pkgdesc="Janet project manager"
url="https://janet-lang.org/"
license="MIT"
arch="noarch"
depends="janet"
checkdepends="janet-dev janet-static"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/janet-lang/jpm/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare

	sed -i 's/:auto-shebang true/:auto-shebang false/' jpm/make-config.janet
}

check() {
	PREFIX=/usr \
		janet test/installtest.janet
}

package() {
	DESTDIR="$pkgdir" PREFIX=/usr \
		janet bootstrap.janet

	# Remove the blank directory
	rmdir "$pkgdir"/usr/include

	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

sha512sums="
a32aada9dd4c02ad6d9764b4ba027a529bb17bcba4e2d03aa0efdb639d205275ae0a1f1c82de984f1d040ef7876ad0ee1ff810d5f3c80080a9278786ec4eb922  jpm-1.2.0.tar.gz
"
