# Contributor: Victoria Brekenfeld <pkg@drakulix.de>
# Contributor: Casey Connolly <kcxt@postmarketos.org>
maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=gamescope-session-plus
pkgver=0_git20261002
_commit="08e65a62ed3d7acc6ae17db637091d402a55ae2a"
pkgrel=0
pkgdesc="Gamescope session plus based on Valve's gamescope"
url="https://github.com/OpenGamingCollective/gamescope-session"
# riscv64: blocked by gamescope
arch="noarch !riscv64"
license="MIT"
depends="bash gamescope"
options="!check" # no tests
subpackages="$pkgname-systemd"
source="gamescope-session-$_commit.tar.gz::https://github.com/OpenGamingCollective/gamescope-session/archive/$_commit.tar.gz"
builddir="$srcdir/gamescope-session-$_commit"

package() {
	install -Dm755 "$builddir"/usr/bin/gamescope-session-plus \
		-t "$pkgdir"/usr/bin
	install -Dm755 "$builddir"/usr/bin/export-gpu \
		-t "$pkgdir"/usr/bin
	install -Dm644 "$builddir"/usr/lib/systemd/user/gamescope-session-plus@.service \
		-t "$pkgdir"/usr/lib/systemd/user
	install -Dm644 "$builddir"/usr/share/gamescope-session-plus/device-quirks \
		-t "$pkgdir"/usr/share/gamescope-session-plus
	install -Dm755 "$builddir"/usr/share/gamescope-session-plus/gamescope-session-plus \
		-t "$pkgdir"/usr/share/gamescope-session-plus
	install -Dm644 "$builddir"/usr/share/gamescope/scripts/50-custom/50-disable-explicit-sync.lua \
		-t "$pkgdir"/usr/share/gamescope/scripts/50-custom
}

sha512sums="
0d2c85d0ad9e7aa269b00cf8498118586184959ed6ade85f8857e73c3227071c67d38ab24a4ad5a168e4ad6ab239b006f5c922686fc8d5bbd3e3c4cb9d8a0001  gamescope-session-08e65a62ed3d7acc6ae17db637091d402a55ae2a.tar.gz
"
