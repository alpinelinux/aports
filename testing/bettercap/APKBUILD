3ffe96755d1314ff127f01a7dd27998b5ce7abf64d74b05e2ad376c4757ca9754fc2e19a6a5d0dea66ad72f08baae3505c8db0354707b670ddd2ef4ea304d3b1  10-fix-x86-getsockopt.patch
"
