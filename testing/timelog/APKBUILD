# Maintainer: Willow Barraco <contact@willowbarraco.fr>
pkgname=timelog
pkgver=0.0.1
_commit=9d598acd831ab749845d713163427d9148f9262f
pkgrel=0
pkgdesc="CLI timelog application"
url="https://sr.ht/~esensar/timelog/"
arch="x86_64 aarch64 riscv64" # hare
license="GPL-3.0-only"
depends="tzdata"
options="!check" # tests require /etc/localtime
makedepends="hare scdoc"
subpackages="$pkgname-extras:extras:noarch $pkgname-dev:dev:noarch $pkgname-doc"
source="$pkgname-$_commit.tar.gz::https://git.sr.ht/~esensar/timelog/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

build() {
	make -j1 PREFIX="/usr" VERSION="$pkgver"
}

package() {
	make DESTDIR="$pkgdir" PREFIX="/usr" install install-extras install-lib
}

extras() {
	pkgdesc="$pkgdesc (extra libexec scripts)"
	amove usr/libexec/timelog/timelog-edit
	amove usr/libexec/timelog/timelog-switch
	amove usr/libexec/timelog/timelog-today
}

dev() {
	pkgdesc="$pkgdesc (Hare third-party library)"
	amove usr/src/hare/third-party
}

sha512sums="
7b0edf357792a22ba2bb49eb38ec29670cb2af67b0b26144da730ed74a520eac88318ec47ed15d4a93576d168b9a2e3356aa70c4340652442b632d0717e8e478  timelog-9d598acd831ab749845d713163427d9148f9262f.tar.gz
"
