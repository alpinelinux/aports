	colord-dev
	colord-gtk-dev
	gcr-dev
	glib-dev
	gnome-desktop-dev
	gnome-settings-daemon-dev
	gsettings-desktop-schemas-dev
	gsound-dev
	gtk+3.0-dev
	ibus-dev
	krb5-dev
	libepoxy-dev
	libgtop-dev
	libgudev-dev
	libhandy1-dev
	libnma-dev
	libpwquality-dev
	libsecret-dev
	libwacom-dev
	libx11-dev
	libxi-dev
	libxml2-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-dev
	pulseaudio-dev
	samba-dev
	tecla-dev
	udisks2-dev
	upower-dev
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-lang
	"
options="!check" # No tests
source="https://github.com/BuddiesOfBudgie/budgie-control-center/releases/download/v$pkgver/budgie-control-center-$pkgver.tar.xz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

