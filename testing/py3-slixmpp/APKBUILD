# Contributor: Sam Whited <sam@samwhited.com>
# Contributor: Celeste <cielesti@protonmail.com>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-slixmpp
_pkgname=slixmpp
pkgver=1.17.0
pkgrel=0
pkgdesc="Fork of the SleekXMPP XMPP library for async IO and Python 3.7+"
url="https://slixmpp.readthedocs.io/en/latest/"
arch="all"
license="MIT"
depends="
	py3-aiodns
	py3-aiohttp
	py3-asn1
	py3-asn1-modules
	py3-cryptography
	py3-defusedxml
	py3-emoji
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools-rust
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	cmd:gpg
	"
subpackages="
	$pkgname-doc
	$pkgname-pyc
	"
source="https://files.pythonhosted.org/packages/source/s/slixmpp/slixmpp-$pkgver.tar.gz
	4b6d2b8c6da0e77c153804b6b3beeb54254a2a72.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
options="net" # cargo fetch

# secfixes:
#   1.8.3-r0:
#     - CVE-2022-45197

prepare() {
	default_prepare
	cargo fetch --locked
}

build() {
	export CARGO_NET_OFFLINE=true
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 run_tests.py

	# ensure the rust extensions is present (failures are silently ignored)
	ls build/lib.linux-*-cpython-314/slixmpp/jid.cpython-*.so
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
	install -Dm644 README.rst -t "$pkgdir"/usr/share/doc/$pkgname/
}

