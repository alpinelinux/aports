pkgname=tuxvdmtool
pkgver=0_git20260605
pkgrel=0
_commit="4f3fed6a8c7b6fc6f656efd8df7620b1dbcb30ee"
pkgdesc="VDM utility for connecting Apple silicon devices"
url="https://github.com/AsahiLinux/tuxvdmtool"
# Apple silicon is aarch64-only
arch="aarch64"
license="Apache-2.0"
makedepends="cargo cargo-auditable"
source="https://github.com/AsahiLinux/tuxvdmtool/archive/$_commit/tuxvdmtool-$_commit.tar.gz"
options="net"
builddir="$srcdir/tuxvdmtool-$_commit"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/tuxvdmtool -t "$pkgdir"/usr/bin
}

