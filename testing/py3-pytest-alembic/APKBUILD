maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-pytest-alembic
pkgver=0.13.2
pkgrel=0
pkgdesc="Pytest plugin for verifying alembic migrations"
url="https://github.com/schireson/pytest-alembic"
license="MIT"
arch="noarch"
depends="py3-pytest py3-alembic"
makedepends="py3-gpep517 py3-uv-build py3-wheel py3-pytest-mock-resources"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.zip::https://github.com/schireson/pytest-alembic/archive/refs/tags/v$pkgver.zip"
builddir="$srcdir/pytest-alembic-$pkgver"
options="!check" # some tests run docker

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -Pm pytest tests
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
dbd5265766b917b33bcf0331311a41d57ab36169930afcebb28af72ef5dce5474520e5687a69047816b40d05f7393030630a117e3b7724ebdf66f7beb83f8a00  py3-pytest-alembic-0.13.2.zip
"
