# Maintainer: qaqland <qaq@qaq.land>
pkgname=py3-py-radix
_pkgname=py-radix
pkgver=1.1.0
pkgrel=0
pkgdesc="An implementation of a radix tree for Python"
url="https://github.com/mjschultz/py-radix"
arch="all"
license="BSD-4-Clause AND ISC"
depends="python3"
makedepends="py3-gpep517 py3-setuptools py3-wheel python3-dev"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$_pkgname-$pkgver.tar.gz::https://github.com/mjschultz/py-radix/archive/v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"

replaces=py-radix # Backwards compatibility
provides=py-radix=$pkgver-r$pkgrel # Backwards compatibility

build() {
	# setup.py sets version as v1.1.0+dev-v1.1.0 unless VERSION matches
	export VERSION=v$pkgver
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
ae198b6bf3fb2f05f2c28836e4577667a7b85ce05d9a620ea3c0131df464b3f69fa6f2c5ee4dcb5e426d6675a57bca1442b47578dd4db0d051123036b49f1ecd  py-radix-1.1.0.tar.gz
"
