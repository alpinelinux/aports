# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kodaskanna
pkgver=0.2.3
pkgrel=0
# armhf blocked by qt6-qtdeclarative -> plasma-activities
arch="all !armhf"
url="https://apps.kde.org/kodaskanna"
pkgdesc="A multi-format 1D/2D code scanner"
license="BSD-3-Clause AND LGPL-2.1-or-later AND LGPL-3.0-or-later"
depends_dev="
	kconfigwidgets-dev
	kcoreaddons-dev
	kcrash-dev
	ki18n-dev
	kio-dev
	kwidgetsaddons-dev
	kxmlgui-dev
	purpose-dev
	qt6-qtbase-dev
	zxing-cpp-dev
	"
makedepends="$depends_dev
	extra-cmake-modules
	samurai
	"
subpackages="$pkgname-lang"
_repo_url="https://invent.kde.org/graphics/kodaskanna.git"
source="https://download.kde.org/unstable/kodaskanna/$pkgver/src/kodaskanna-$pkgver.tar.xz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
5601f6ae52aa59178b264cbe549739669c5e23a2ecd330e91f2f44dcd19dbae63f19ac2fa1fa9c53137ec3fc2ef5a4c1d5afcafbb0771d4abf66219faf96aa2b  kodaskanna-0.2.3.tar.xz
"
