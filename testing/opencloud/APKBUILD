# Maintainer: Tony Evl <anton@evlakh.ru>
pkgname=opencloud
pkgver=9.0.0
pkgrel=0
_webver=8.2.1
pkgdesc="Modern file-sync and share platform - server with embedded web UI"
url="https://opencloud.eu/"
# riscv64: pnpm install segfaults
arch="all !riscv64"
license="Apache-2.0"
depends="ca-certificates mailcap attr"
makedepends="go nodejs pnpm rollup make bash"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-openrc"
pkgusers="opencloud"
pkggroups="opencloud"
source="opencloud-$pkgver.tar.gz::https://github.com/opencloud-eu/opencloud/archive/refs/tags/v$pkgver.tar.gz
	opencloud-web-$_webver.tar.gz::https://github.com/opencloud-eu/web/releases/download/v$_webver/web.tar.gz
	system-rollup.patch
	opencloud.initd
	opencloud.confd
	"
# net   : pnpm fetches the idp frontend's npm dependencies during build().
# !check: upstream has no self-contained unit-test target suitable for the
#         packaging sandbox; the acceptance suite needs a running stack.
options="net !check"

build() {
	export GOFLAGS="$GOFLAGS -mod=vendor -trimpath"
	export GOPROXY=off

	mkdir -p services/web/assets/core
	tar -C services/web/assets/core -xzf "$srcdir/$pkgname-web-$_webver.tar.gz"

	make -C services/idp node-generate-prod

	local _pkg="github.com/opencloud-eu/opencloud"
	local _ldflags="-s -w
		-X google.golang.org/protobuf/reflect/protoregistry.conflictPolicy=warn
		-X $_pkg/pkg/version.Tag=v$pkgver
		-X $_pkg/pkg/version.String=$pkgver
		-X $_pkg/pkg/version.Edition=stable
		-X $_pkg/pkg/config/defaults.BaseConfigPathType=path
		-X $_pkg/pkg/config/defaults.BaseConfigPathValue=/etc/opencloud
		-X $_pkg/pkg/config/defaults.BaseDataPathType=path
		-X $_pkg/pkg/config/defaults.BaseDataPathValue=/var/lib/opencloud"

	cd "$builddir"/opencloud
	go build -tags disable_crypt -ldflags "$_ldflags" \
		-o bin/opencloud ./cmd/opencloud
}

package() {
	install -Dm755 "$builddir"/opencloud/bin/opencloud \
		"$pkgdir"/usr/bin/opencloud

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname

	install -dm700 "$pkgdir"/etc/opencloud
	install -dm700 "$pkgdir"/var/lib/opencloud
	install -dm755 "$pkgdir"/var/log/opencloud
}

