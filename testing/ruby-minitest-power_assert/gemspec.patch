Don't use git to list files in the gemspec, the source tarball is not
a git repository (and git is not available at build time).

--- a/minitest-power_assert.gemspec
+++ b/minitest-power_assert.gemspec
@@ -13,7 +13,7 @@
   spec.homepage      = "https://github.com/hsbt/minitest-power_assert"
   spec.license       = "2-clause BSDL"
 
-  spec.files         = `git ls-files -z`.split("\x0")
+  spec.files         = Dir["lib/**/*"]
   spec.executables   = spec.files.grep(%r{^bin/}) { |f| File.basename(f) }
   spec.test_files    = spec.files.grep(%r{^(test|spec|features)/})
   spec.require_paths = ["lib"]
