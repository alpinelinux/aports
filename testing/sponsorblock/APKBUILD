# Contributor: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=sponsorblock
pkgver=6.1.7
pkgrel=0
pkgdesc="Skip sponsor segments in YouTube videos"
url="https://sponsor.ajay.app/"
arch="noarch"
license="GPL-3.0-or-later"
makedepends="nodejs npm"
_maze_utils=5e594994506ebfef5e474ef0622017961d5316a8
_translations=166548e90223a11c57713439080c1903b8853bd6
source="sponsorblock-$pkgver.tar.gz::https://github.com/ajayyy/SponsorBlock/archive/refs/tags/$pkgver.tar.gz
	maze-utils-$_maze_utils.tar.gz::https://github.com/ajayyy/maze-utils/archive/$_maze_utils.tar.gz
	ExtensionTranslations-$_translations.tar.gz::https://github.com/ajayyy/ExtensionTranslations/archive/$_translations.tar.gz
"
_bump() {
	msg "Updating submodule pins in $APKBUILD..."

	local _tree="$(curl -sfL \
		"https://api.github.com/repos/ajayyy/SponsorBlock/git/trees/$pkgver?recursive=1")"

	local _maze_utils=$(echo "$_tree" | jq -r '.tree[] | select(.path == "maze-utils") | .sha')
	local _translations=$(echo "$_tree" | jq -r '.tree[] | select(.path == "public/_locales") | .sha')

	msg "  maze-utils=$_maze_utils"
	msg "  translations=$_translations"

	sed -i \
		-e "s|^_maze_utils=.*|_maze_utils=$_maze_utils|" \
		-e "s|^_translations=.*|_translations=$_translations|" \
		"$APKBUILD"
}

builddir="$srcdir/SponsorBlock-$pkgver"
options="!check net" # browser tests and dependencies require network

prepare() {
	default_prepare

	rmdir maze-utils public/_locales
	mv ../maze-utils-$_maze_utils maze-utils
	mv ../ExtensionTranslations-$_translations public/_locales
	cp config.json.example config.json

	npm ci --ignore-scripts
}

build() {
	npm run build:firefox
}

check() {
	npm run test-without-building
}

package() {
	_target="$pkgdir/usr/lib/firefox/browser/extensions/sponsorBlocker@ajay.app"
	mkdir -p "$_target"
	cp -a dist/. "$_target"
}

