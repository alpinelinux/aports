# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=cameractrl
pkgver=0_git20260501
pkgrel=0
_commit="4c8ac34295df52c5f887a9e51ec64f54ef26c636"
pkgdesc="Camera manual focus control overlay"
url="https://gitlab.com/NekoCWD/cameractrl"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	blueprint-compiler
	gtk4-layer-shell-dev
	gtk4.0-dev
	libadwaita-dev
	libgudev-dev
	linux-headers
	meson
	vala
	"
source="https://gitlab.com/NekoCWD/cameractrl/-/archive/$_commit/cameractrl-$_commit.tar.gz"
builddir="$srcdir/cameractrl-$_commit"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
