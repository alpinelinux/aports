# Contributor: Jonas <spameier+alpine@proton.me>
# Maintainer: Jonas <spameier+alpine@proton.me>
pkgname=py3-asyauth
_pyname=asyauth
pkgver=0.0.26
pkgrel=0
pkgdesc="Unified authentication library"
url="https://github.com/skelsec/asyauth"
arch="noarch"
license="MIT"
depends="
	py3-asn1crypto
	py3-asysocks
	py3-minikerberos
	py3-unicrypto
	"
makedepends="
	py3-gpep517
	py3-wheel
	py3-setuptools
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/skelsec/asyauth/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"
options="!check" # no tests provided

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
87903206d30749f5a759b0d3c5f4d6dc212162f48e3aee93bdbfc7c7f6c9538eafa86ffc6e34e7d410ff6d784e8ea33aee7a058e09acb89baa43bbe6d91e74d0  py3-asyauth-0.0.26.tar.gz
"
