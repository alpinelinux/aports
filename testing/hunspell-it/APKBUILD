pkgname=hunspell-it
pkgver=5.1.1
pkgrel=0
pkgdesc="Italian hunspell dictionaries"
_commit=43a746e2dcbdea7b89172024a14e6c6f1738c95c
url="https://github.com/LibreOffice/dictionaries/blob/master/it_IT/README_it_IT.txt"
arch="noarch"
license="GPL-3.0-only"
options="!check" # no tests available
subpackages="$pkgname-doc"
source="$pkgname-$_commit.tar.gz::https://github.com/LibreOffice/dictionaries/archive/$_commit.tar.gz"
builddir="$srcdir/dictionaries-$_commit"

package() {
	install -dm755 "$pkgdir"/usr/share/hunspell
	install -m644 it_IT/it_IT.aff "$pkgdir"/usr/share/hunspell/it_IT.aff
	install -m644 it_IT/it_IT.dic "$pkgdir"/usr/share/hunspell/it_IT.dic

	install -Dm644 it_IT/README_it_IT.txt -t "$pkgdir"/usr/share/doc/$pkgname/
}

sha512sums="
7d18d72e1f05cc5c1bf55c55af913c2de1ec6bd40c2b7e6b5b369bbb4b27bd8aa79f86d918b64e9bd8c1d0933f32fd3b330b266b4766780e439e06d30e7ea384  hunspell-it-43a746e2dcbdea7b89172024a14e6c6f1738c95c.tar.gz
"
