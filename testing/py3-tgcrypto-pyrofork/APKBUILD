maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-tgcrypto-pyrofork
_pkgname=TgCrypto-pyrofork
pkgver=1.2.8
pkgrel=0
pkgdesc="Cryptography extension library for Pyrofork"
url="https://github.com/Mayuri-Chan/tgcrypto"
arch="all"
license="LGPL-3.0-or-later"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
options="!check"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/tgcrypto_pyrofork-$pkgver.tar.gz
	0001-Don-t-install-tests.patch
	"
builddir="$srcdir/tgcrypto_pyrofork-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

