# Contributor: Дмитрий <wakoo1337@yandex.ru>
maintainer="Дмитрий <wakoo1337@yandex.ru>"
pkgname=ly
pkgver=1.4.1
pkgrel=1
pkgdesc="Lightweight TUI (ncurses-like) display manager"
url="https://codeberg.org/fairyglade/ly"
arch="aarch64 x86_64"
# Only these architectures are supported by zig
license="WTFPL"
makedepends="
	libxcb-dev
	linux-headers
	linux-pam-dev
	zig
"
subpackages="
	$pkgname-doc
	$pkgname-lang
	$pkgname-openrc
"
source="
	$pkgname-$pkgver.tar.gz::https://codeberg.org/fairyglade/ly/archive/v$pkgver.tar.gz
	poweroff.patch
"
builddir="$srcdir/ly"
langdir="/etc/ly/lang"
# net: zig modules
# check: no tests suite provided
options="!check net"

build() {
	zig build \
		--cache-dir "$srcdir/zig-cache" \
		--global-cache-dir "$srcdir/zig-global-cache" \
		-Doptimize=ReleaseSafe
}

package() {
	zig build installexe \
		--cache-dir "$srcdir/zig-cache" \
		--global-cache-dir "$srcdir/zig-global-cache" \
		-Doptimize=ReleaseSafe \
		-Dinit_system=openrc \
		-Ddest_directory="$pkgdir"

	install -d "$pkgdir/usr/share/licenses/ly"
	install "$builddir/license.md" "$pkgdir/usr/share/licenses/ly"
}
sha512sums="
