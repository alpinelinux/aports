maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=lima
pkgver=2.2.0
pkgrel=0
pkgdesc="Linux virtual machine launcher focusing on running containers"
url="https://lima-vm.io/"
# The only supported binary builds.
# (see `archKeywords` variable in pkg/limatmpl/locator.go for the list of supported guess architectures)
arch="x86_64 aarch64"
license="Apache-2.0"
makedepends="go"
checkdepends="openssh-keygen"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	$pkgname-guestagent:_guestagent
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/lima-vm/lima/archive/refs/tags/v$pkgver.tar.gz
	vendor-$pkgver.tar.gz::https://github.com/lima-vm/lima/releases/download/v$pkgver/lima-$pkgver-go-mod-vendor.tar.gz
	"

prepare() {
	default_prepare

	cp -r "$srcdir"/vendor "$builddir"/
}

build() {
	go build -o "$builddir" -v \
		-ldflags "-X github.com/lima-vm/lima/v${pkgver%%.*}/pkg/version.Version=v$pkgver" \
		./cmd/limactl/ ./cmd/lima-guestagent/

	for shell in bash fish zsh; do
		./limactl completion $shell > limactl.$shell
	done

	mkdir -p "$builddir"/man
	./limactl generate-doc man
}

check() {
	go test ./...
}

package() {
	install -Dm755 \
		-t "$pkgdir"/usr/bin/ \
		limactl \
		cmd/apptainer.lima \
		cmd/docker.lima \
		cmd/kubectl.lima \
		cmd/lima \
		cmd/nerdctl.lima \
		cmd/podman.lima

	# The binary doesn't need to be executable, as it'll be copied to the guest properly by
	# limactl when launching a new VM instance.
	# Ref: https://github.com/lima-vm/lima/blob/a85206649db4ce1f21c206f1e5426042c8bedbc7/cmd/limactl/guest-install.go#L57
	install -Dm644 lima-guestagent \
		"$pkgdir"/usr/share/lima/lima-guestagent.Linux-$CARCH

	install -Dm644 man/*.1 -t "$pkgdir"/usr/share/man/man1/

	install -d "$pkgdir"/usr/share/doc/lima
	cp -r templates/ "$pkgdir"/usr/share/doc/lima/

	install -Dm644 limactl.bash \
		"$pkgdir"/usr/share/bash-completion/completions/limactl
	install -Dm644 limactl.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/limactl.fish
	install -Dm644 limactl.zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_limactl
}

_guestagent() {
	pkgdesc="Lima guest agent"
	amove usr/share/lima
}

sha512sums="
2dcc2e51e1b1140b6d7eaa86847ad9e077e8aeef6f79a26b8a1448d129dba912620877651795abbb7ab59f394f5744f7d630e14b68bb25b20c0d4c5aafbc50c7  lima-2.2.0.tar.gz
5e4992d5f9f7bd8bc2184e823bbdd870bfa30ba4f5ecc02a2713267f6b6eeb990ec58095fd09abe5780b66adfa628a8771f0825c54e61446b6bd3b456dfa0d57  vendor-2.2.0.tar.gz
"
