# Contributor: Thomas Kienlen <kommander@laposte.net>
# Maintainer: Thomas Kienlen <kommander@laposte.net>
pkgname=git-bug
pkgver=0.11.0
pkgrel=0
pkgdesc="Distributed, offline-first bug tracker embedded in git, with bridges"
url="https://github.com/git-bug/git-bug"
arch="all"
license="GPL-3.0-or-later"
makedepends="go"
case "$CARCH" in
x86_64|aarch64)
	# the web UI needs native rolldown, tailwindcss and lightningcss
	# node modules, which are only available for these on musl
	_webui=1
	makedepends="$makedepends pnpm"
	;;
esac
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="
	git-bug-$pkgver.tar.gz::https://github.com/git-bug/git-bug/archive/v$pkgver.tar.gz
	skip-test-testnewgogitrepo.patch
	"
options="net"

export GOFLAGS="$GOFLAGS -modcacherw"

prepare() {
	default_prepare

	if [ -n "$_webui" ]; then
		pnpm install -C webui --frozen-lockfile
	fi
}

build() {
	local tags=
	if [ -n "$_webui" ]; then
		pnpm -C webui run build
		tags=webui
	fi

	go generate
	go build -tags "$tags" -ldflags "-X main.version=v$pkgver" .
}

check() {
	make test
}

package() {
	install -Dm755 git-bug "$pkgdir"/usr/bin/git-bug

	install -Dm 644 misc/completion/bash/git-bug "$pkgdir"/usr/share/bash-completion/completions/git-bug
	install -Dm 644 misc/completion/fish/git-bug "$pkgdir"/usr/share/fish/vendor_completions.d/git-bug.fish
	install -Dm 644 misc/completion/zsh/git-bug "$pkgdir"/usr/share/zsh/site-functions/_git-bug

	install -Dm 644 doc/man/*.1 -t "$pkgdir"/usr/share/man/man1
}

sha512sums="
c07782c1be65c298789370268eefc55e1e279d2bb3a07a2a9cc8d54e7f91b9f305a5886d1f539cc2f69d0b8e9ce9286953d05d7be1fb6142284ae56fdfad6009  git-bug-0.11.0.tar.gz
b9a0da6bbda955523acbbddeee63cbe78b6177e47e1663e61f42f77009a38660f08297aa043c64d7c6241d94ad009c71f645e2e9723efa9f407f957f95e99262  skip-test-testnewgogitrepo.patch
"
