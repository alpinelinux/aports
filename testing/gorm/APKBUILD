# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=gorm
pkgver=1.2.1
pkgrel=0
pkgdesc="Wayland mobile GUI for Wi-Fi settings"
url="https://catacombing.org/"
# riscv64: compiles too slowly
# ppc64le s390x: blocked by aports#18444
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-only"
options="net" # cargo deps download
makedepends="
	cargo-auditable
	fontconfig-dev
	glib-dev
	libxkbcommon-dev
	pango-dev
"
source="$pkgname-v$pkgver.tar.gz::https://git.sr.ht/~undeadleech/gorm/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/gorm -t "$pkgdir"/usr/bin/
	install -Dm644 logo.svg "$pkgdir"/usr/share/pixmaps/Gorm.svg
	install -Dm644 gorm.desktop "$pkgdir"/usr/share/applications/gorm.desktop
}
sha512sums="
863dfde3199b6c906dc0f941864e76c4aa8bd578294466839b640e0823e7cf9beb5c12ab77db8353d371a85ca65830e49c2318f55877e3df05e1f80ae677232c  gorm-v1.2.1.tar.gz
"
