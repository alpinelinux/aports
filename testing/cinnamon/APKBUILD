maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=cinnamon
pkgver=6.8.4
pkgrel=0
pkgdesc="Desktop environment featuring a traditional layout (fork of gnome-session)"
url="https://github.com/linuxmint/cinnamon"
arch="all !armhf !armv7"
# armhf: cjs -> mozjs
# armv7: fails
license="GPL-2.0-only"
depends="
	gtk+3.0
	keybinder3
	py3-gobject3
	py3-psutil
	py3-setproctitle
	"
makedepends="
	cinnamon-menus-dev
	cjs-dev
	dbus-dev
	gcr-dev
	gobject-introspection-dev
	gstreamer-dev
	gtk4.0-dev
	gtk4-layer-shell-dev
	libsecret-dev
	linux-pam-dev
	meson
	muffin-dev
	networkmanager-dev
	perl
	polkit-dev
	sassc
	xapp-dev
	xdotool-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-pyc
	"
source="https://github.com/linuxmint/cinnamon/archive/$pkgver/cinnamon-$pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
c6c262852cde91f02227c8c559601e1575e9b5785dab9eb215f894bb1e969fe60b08c9e56b713c1a14275a40fda056fd18d0c23a7eed80ae6da0e8bce551c989  cinnamon-6.8.4.tar.gz
"
