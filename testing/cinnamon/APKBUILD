maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=cinnamon
pkgver=6.8.0
pkgrel=0
pkgdesc="Desktop environment featuring a traditional layout (fork of gnome-session)"
url="https://github.com/linuxmint/cinnamon"
arch="all !armhf !armv7"
# armhf: cjs -> mozjs
# armv7: fails
license="GPL-2.0-only"
depends="
	gtk+3.0
	keybinder3
	py3-gobject3
	py3-psutil
	py3-setproctitle
	"
makedepends="
	cinnamon-menus-dev
	cjs-dev
	dbus-dev
	gcr-dev
	gobject-introspection-dev
	gstreamer-dev
	gtk4.0-dev
	gtk4-layer-shell-dev
	libsecret-dev
	linux-pam-dev
	meson
	muffin-dev
	networkmanager-dev
	perl
	polkit-dev
	sassc
	xapp-dev
	xdotool-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-pyc
	"
source="https://github.com/linuxmint/cinnamon/archive/$pkgver/cinnamon-$pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
865d022171cb80c59433d3e8fe2bcc2a163c67bfd81d1cd7a7aa0dd2810c5e9fafbd22b4ce5d7096650101e6b879556e1e9176d6461d20af5ee82475280267c9  cinnamon-6.8.0.tar.gz
"
