maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=rolldown
pkgver=1.3.2
pkgrel=0
pkgdesc="Fast JavaScript/TypeScript bundler in Rust with Rollup-compatible API"
url="https://rolldown.rs/"
# riscv64: Segmentation fault (core dumped)
arch="all !riscv64"
license="MIT"
depends="nodejs"
makedepends="cargo nodejs pnpm jq"
source="https://github.com/rolldown/rolldown/archive/refs/tags/v$pkgver/rolldown-$pkgver.tar.gz
	0001-feat-add-Linux-ia32-binding-loader-branch.patch
	0002-feat-load-musl-bindings-on-ppc64-and-s390x.patch
	0003-Use-system-allocator.patch
	0004-Bump-Rustix-to-1.1.6.patch
	0005-fix-avoid-WebAssembly-for-the-JS-glue-build.patch

	rustix-statx-musl.patch.noauto
	"
options="net" # cargo fetch and pnpm install

case "$CARCH" in
aarch64) _target=linux-arm64-musl ;;
armhf | armv7) _target=linux-arm-musleabihf ;;
loongarch64) _target=linux-loong64-musl ;;
ppc64le) _target=linux-ppc64-musl ;;
riscv64) _target=linux-riscv64-musl ;;
s390x) _target=linux-s390x-musl ;;
x86) _target=linux-ia32-musl ;;
x86_64) _target=linux-x64-musl ;;
esac

prepare() {
	default_prepare

	cargo fetch --locked --target="$CTARGET"

	local _rustix=$(echo "$CARGO_HOME"/registry/src/*/rustix-1.1.6)
	patch -p1 -d "$_rustix" -i "$srcdir"/rustix-statx-musl.patch.noauto

	# pnpm fetches pinned version — force usage of system one.
	jq 'del(.packageManager)' package.json >tmp.json
	mv tmp.json package.json

	pnpm install --frozen-lockfile --filter rolldown --ignore-scripts
}

build() {
	cargo build --release --frozen --package rolldown_binding

	install -Dm755 target/release/librolldown_binding.so \
		"packages/rolldown/src/rolldown-binding.$_target.node"

	pnpm --filter rolldown run build-node
}

check() {
	printf 'export const answer = 42\n' >check.js
	node --input-type=module -e '
		import { rolldown } from "./packages/rolldown/dist/index.mjs";
		const bundle = await rolldown({ input: "./check.js" });
		const { output } = await bundle.generate({ format: "esm" });
		if (!output[0].code.includes("answer")) {
			throw new Error("unexpected output: " + output[0].code);
		}
	'
}

package() {
	local dest="$pkgdir"/usr/share/node_modules/$pkgname

	install -Dm644 LICENSE THIRD-PARTY-LICENSE \
		-t "$pkgdir"/usr/share/licenses/$pkgname
	install -Dm644 packages/rolldown/package.json -t "$dest"
	cp -r packages/rolldown/bin packages/rolldown/dist "$dest"/

	mkdir -p "$dest"/node_modules/@rolldown "$dest"/node_modules/@oxc-project
	cp -rL packages/rolldown/node_modules/@rolldown/pluginutils \
		"$dest"/node_modules/@rolldown/
	cp -rL packages/rolldown/node_modules/@oxc-project/types \
		"$dest"/node_modules/@oxc-project/

	mkdir -p "$pkgdir"/usr/bin
	ln -s ../share/node_modules/$pkgname/bin/cli.mjs "$pkgdir"/usr/bin/$pkgname
}

