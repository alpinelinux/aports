From 5144df64b7c36c20dd77a1b57aef936ffdd746aa Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Thu, 12 Nov 2026 03:16:43 +0100
Subject: [PATCH 5/5] fix: avoid WebAssembly for the JS glue build

@oxc-node/core has no native binding for armhf/armv7 musl. The WASI
fallback and yuku (via rolldown-plugin-dts) require WebAssembly SIMD,
which is unavailable on loongarch64. Run build-node with tsx and pin
rolldown-plugin-dts to the last Babel-based release.
---
 packages/rolldown/package.json |   5 +-
 pnpm-lock.yaml                 | 165 +++++++++++++++------------------
 2 files changed, 77 insertions(+), 93 deletions(-)

diff --git a/packages/rolldown/package.json b/packages/rolldown/package.json
index 263adb90b..1aa7b1c07 100644
--- a/packages/rolldown/package.json
+++ b/packages/rolldown/package.json
@@ -116,7 +116,7 @@
     "build-binding:wasi": "pnpm build-binding --target wasm32-wasip1-threads",
     "build-binding:wasi:release": "pnpm build-binding --profile release-wasi --target wasm32-wasip1-threads",
     "# Scrips for node #": "_",
-    "build-node": "node --enable-source-maps --import @oxc-node/core/register -C dev ./build.ts",
+    "build-node": "node --enable-source-maps --import tsx -C dev ./build.ts",
     "build-types-check": "tsc -p ./tsconfig.check.json",
     "build-js-glue": "pnpm run --sequential '/^build-(node|types-check)$/'",
     "build-native:debug": "pnpm run --sequential '/^build-(binding|js-glue)$/'",
@@ -152,10 +152,11 @@
