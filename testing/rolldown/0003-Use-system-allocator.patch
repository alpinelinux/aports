From 604d9a2dcd693a417e05aa4a5b07406c1e8a66e2 Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Wed, 11 Nov 2026 21:38:19 -0300
Subject: [PATCH 3/5] Use system allocator

---
 Cargo.lock                         | 1 -
 crates/rolldown_binding/Cargo.toml | 8 --------
 crates/rolldown_binding/src/lib.rs | 9 ---------
 3 files changed, 18 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 7b897ce77..4c3be0804 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2665,7 +2665,6 @@ dependencies = [
  "futures",
  "indexmap",
  "itertools",
- "mimalloc-safe",
  "napi",
  "napi-build",
  "napi-derive",
diff --git a/crates/rolldown_binding/Cargo.toml b/crates/rolldown_binding/Cargo.toml
index 4ff8e7b19..cf71981d3 100644
--- a/crates/rolldown_binding/Cargo.toml
+++ b/crates/rolldown_binding/Cargo.toml
@@ -76,20 +76,12 @@ tracing = { workspace = true }
 url = { workspace = true }
 
 [target.'cfg(all(not(target_os = "linux"), not(target_os = "freebsd"), not(target_family = "wasm")))'.dependencies]
-mimalloc-safe = { workspace = true, features = ["skip_collect_on_exit", "v3"] }
 rolldown_tracking_allocator = { workspace = true, optional = true }
 
 [target.'cfg(all(any(target_os = "linux", target_os = "freebsd"), not(target_arch = "aarch64"), not(target_env = "ohos")))'.dependencies]
-mimalloc-safe = { workspace = true, features = ["skip_collect_on_exit", "local_dynamic_tls", "v3"] }
 rolldown_tracking_allocator = { workspace = true, optional = true }
 
 [target.'cfg(all(target_arch = "aarch64", any(target_os = "linux", target_os = "android", target_os = "freebsd")))'.dependencies]
-mimalloc-safe = { workspace = true, features = [
-  "skip_collect_on_exit",
-  "no_opt_arch",
-  "local_dynamic_tls",
-  "v3",
-] }
 rolldown_tracking_allocator = { workspace = true, optional = true }
 
 [build-dependencies]
diff --git a/crates/rolldown_binding/src/lib.rs b/crates/rolldown_binding/src/lib.rs
index ee0e619d8..227801a64 100644
--- a/crates/rolldown_binding/src/lib.rs
+++ b/crates/rolldown_binding/src/lib.rs
@@ -26,15 +26,6 @@ use std::sync::{
 
 use napi_derive::napi;
 
-#[cfg(all(
-  not(target_family = "wasm"),
-  not(feature = "default_global_allocator"),
-  not(target_env = "ohos"),
-  not(feature = "tracking_allocator")
-))]
-#[global_allocator]
-static ALLOC: mimalloc_safe::MiMalloc = mimalloc_safe::MiMalloc;
-
 // Same mimalloc, wrapped with allocation counters. The counters are read
 // through `getNativeMemoryStats()` in `native_memory.rs`; the cfg there must
 // stay in sync with this one.
-- 
2.56.1

