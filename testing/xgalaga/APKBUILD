# Maintainer: Antoni Aloy <aaloytorrens@gmail.com>
pkgname=xgalaga
pkgver=2.1.1.0_git20220103
pkgrel=2
# No tagged release
_commit=76a415f617df756e70074f2b4273bfbb6d0d482a
pkgdesc="Clone of the classic game Galaga (SDL port)"
url="https://github.com/frank-zago/xgalaga-sdl"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	automake
	sdl2-compat-dev
	sdl2_gfx-dev
	sdl2_image-dev
	sdl2_mixer-dev
	sdl2_ttf-dev
	"
subpackages="$pkgname-doc"
options="!check" # No testsuite
source="$pkgname-$_commit.tar.gz::https://github.com/frank-zago/xgalaga-sdl/archive/$_commit.tar.gz
	xgalaga.desktop
	xgalaga-icon.xpm
	"
builddir="$srcdir/xgalaga-sdl-$_commit"

prepare() {
	default_prepare
	autoreconf -fi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--datadir=/usr/share/xgalaga \
		--enable-sdl2
	make
}

package() {
	make DESTDIR="$pkgdir" install

	mv "$pkgdir"/usr/bin/xgalaga-sdl "$pkgdir"/usr/bin/xgalaga

	mv "$pkgdir"/usr/share/man/man6/xgalaga-sdl.6x \
		"$pkgdir"/usr/share/man/man6/xgalaga.6x

	install -Dm644 "$srcdir"/xgalaga.desktop \
		"$pkgdir"/usr/share/applications/xgalaga.desktop
	install -Dm644 "$srcdir"/xgalaga-icon.xpm \
		"$pkgdir"/usr/share/pixmaps/xgalaga-icon.xpm
}

sha512sums="
