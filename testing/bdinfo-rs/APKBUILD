maintainer="Fabricio Silva <hi@fabricio.dev>"
pkgname=bdinfo-rs
pkgver=4.0.0
pkgrel=0
pkgdesc="A Blu-ray disc analyzer - a drop-in BDInfo report tool for BDMV folders and .iso"
url="https://github.com/agentjp/bdinfo-rs"
arch="all"
license="LGPL-2.1-or-later"
options="!check net" # no tests / net for cargo
makedepends="
	cargo
	cargo-auditable
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/agentjp/bdinfo-rs/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

package() {
	install -Dm755 target/release/bdinfo-rs -t "$pkgdir"/usr/bin
}

sha512sums="
465bd8af715bf0c24be605b285d3757e4da5ded587d5da510165e502211f4ad4399526ba7092e1cdfe422db7e10f83df17c8ab2e3994763167b87f94b4a25d85  bdinfo-rs-4.0.0.tar.gz
"
