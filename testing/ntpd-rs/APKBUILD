maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=ntpd-rs
pkgver=1.9.0
pkgrel=3
pkgdesc="Full-featured implementation of the Network Time Protocol, including NTS support"
url="https://docs.ntpd-rs.pendulum-project.org/"
arch="all"
license="Apache-2.0 OR MIT"
makedepends="
	cargo-auditable
	clang-libclang
	cmake
	samurai
	"
pkgusers="$pkgname"
pkggroups="$pkgname"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd"
source="$pkgname-$pkgver.tar.gz::https://github.com/pendulum-project/ntpd-rs/archive/refs/tags/v$pkgver.tar.gz
	90-ntpd-rs.list
	ntpd-rs.initd
	ntpd-rs-metrics-exporter.initd
	bump-clock-steering-time64.patch
	strict-systemd-services.patch
	"
options="net" # downloading rust crates

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	# test failures reported here:
	# https://github.com/pendulum-project/ntpd-rs/issues/2286
	cargo test --frozen --release -- \
		--skip daemon::spawn::nts::tests::allow_srv_direct_name_resolution \
		--skip daemon::ntp_source::tests::test_timeroundtrip \
		--skip daemon::server::tests::test_server_serves \
		--skip daemon::ntp_source::tests::test_deny_stops_poll
}

package() {
	for i in ntp-daemon ntp-ctl ntp-metrics-exporter; do
		install -Dm755 target/release/$i \
			-t "$pkgdir"/usr/bin/
	done

	# default config
	install -dm555 -o "$pkgusers" -g "$pkggroups" \
		"$pkgdir"/etc/ntpd-rs
	install -Dm644 -o "$pkgusers" -g "$pkggroups" \
		docs/examples/conf/ntp.toml.default \
		"$pkgdir"/etc/ntpd-rs/ntp.toml

	# openrc
	install -Dm755 "$srcdir"/ntpd-rs.initd \
		"$pkgdir"/etc/init.d/ntpd-rs
	install -Dm755 "$srcdir"/ntpd-rs-metrics-exporter.initd \
		"$pkgdir"/etc/init.d/ntpd-rs-metrics-exporter

	# systemd
	install -Dm644 docs/examples/conf/ntpd-rs.strict.service \
		"$pkgdir"/usr/lib/systemd/system/ntpd-rs.service
	install -Dm644 "$srcdir"/90-ntpd-rs.list \
		-t "$pkgdir"/usr/lib/systemd/ntp-units.d

	# man pages
	for i in ntp-daemon.8 ntp-ctl.8 ntp-metrics-exporter.8; do
		install -Dm644 docs/precompiled/man/$i \
			-t "$pkgdir"/usr/share/man/man8
	done

	install -Dm644 docs/precompiled/man/ntp.toml.5 \
		-t "$pkgdir"/usr/share/man/man5

	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 CHANGELOG.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 SECURITY.md -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 LICENSE-MIT -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 LICENSE-APACHE -t "$pkgdir"/usr/share/doc/$pkgname/
}

