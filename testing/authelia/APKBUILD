# Contributor: Guy Godfroy <guy.godfroy@gugod.fr>
maintainer="Guy Godfroy <guy.godfroy@gugod.fr>"
pkgname=authelia
pkgver=4.39.28
pkgrel=2
pkgdesc="Single Sign-On Multi-Factor portal for web apps"
url="https://www.authelia.com/"
# armhf, armv7: tests assume 64-bit (don't compile, can't be skipped).
# riscv64: rolldown is !riscv64
# s390x: needs github.com/molecule-man/go-brrr >= v1.3.0
# x86: no @typescript/typescript-linux-ia32 in npm (fetched by vite).
arch="all !armhf !armv7 !riscv64 !s390x !x86"
license="Apache-2.0"
makedepends="
	go
	nodejs
	pnpm
	rolldown
	node-lightningcss
	node-tailwindcss-oxide
	"
checkdepends="bash"
install="$pkgname.pre-install"
pkgusers="authelia"
pkggroups="authelia"
subpackages="$pkgname-openrc $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/authelia/authelia/archive/refs/tags/v$pkgver.tar.gz
	authelia.initd
	authelia.confd
	relax-pnpm-engine-pin.patch
	"
options="net"

build() {
	(
		cd web
		pnpm install --frozen-lockfile --ignore-scripts
		_rolldown="$(echo node_modules/.pnpm/rolldown@*/node_modules/rolldown)"
		rm -rf "$_rolldown"
		ln -s /usr/share/node_modules/rolldown "$_rolldown"
		for _lightningcss in node_modules/.pnpm/lightningcss@*/node_modules/lightningcss; do
			[ -d "$_lightningcss" ] || continue
			rm -rf "$_lightningcss"
			ln -s /usr/share/node_modules/lightningcss "$_lightningcss"
		done
		for _oxide in node_modules/.pnpm/@tailwindcss+oxide@*/node_modules/@tailwindcss/oxide; do
			[ -d "$_oxide" ] || continue
			rm -rf "$_oxide"
			ln -s /usr/share/node_modules/@tailwindcss/oxide "$_oxide"
		done
		pnpm build
	)

	# vite wipes public_html; restore the embedded API docs assets
	cp -r api internal/server/public_html/

	local ldflags="
		-linkmode=external -s -w
		-X 'github.com/authelia/authelia/v4/internal/utils.BuildTag=v$pkgver'
		-X 'github.com/authelia/authelia/v4/internal/utils.BuildState=tagged clean'
		-X 'github.com/authelia/authelia/v4/internal/utils.BuildExtra=Alpine'
		-X 'github.com/authelia/authelia/v4/internal/utils.BuildNumber=$pkgrel'
		"
	go build -buildmode=pie -trimpath -ldflags "$ldflags" -o authelia ./cmd/authelia
}

check() {
	local skip="TestNewOAuth2DeviceCodeSessionFromRequest"                                          # depends on local timezone
	skip="$skip|^TestWebAuthnCredential$"                                                           # depends on local timezone
	skip="$skip|TestShouldExecCommandOnAutheliaRootPath"                                            # depends on build path basename
	skip="$skip|TestShouldServeOverTLS"                                                             # needs DNS
	skip="$skip|TestShouldRaiseErrorWhenClientDoesNotSkipVerify"                                    # needs DNS
	skip="$skip|TestShouldRaiseWhenMutualTLSIsConfiguredAndClientIsNotAuthenticated"                # needs DNS
	skip="$skip|TestShouldServeProperlyWhenMutualTLSIsConfiguredAndClientIsAuthenticated"           # needs DNS
	skip="$skip|TestAddress_UnixDomainSocket"                                                       # fails on x86_64 builder
	skip="$skip|TestRunAllShouldRunTheDefaultProvisioners"                                          # fails on x86_64 builder
	skip="$skip|TestSQLProviderConcurrentTransactions/ShouldRotateConcurrentlyWithThirtyTwoWorkers" # busy timeout on slow disks
	skip="$skip|TestSQLProviderConcurrentTransactions/ShouldRotateConcurrentlyWithSixteenWorkers"   # busy timeout on slow disks
	skip="$skip|TestRunBuildInfo"                                                                   # hardcoded architecture
	skip="$skip|TestFileUserDatabaseShouldNotDeadlockOnSave"                                        # 30s timeout is too short on slow disks
	skip="$skip|TestFileUserProviderShouldNotDeadlockOnUpdatePassword"                              # 30s timeout is too short on slow disks

	# shellcheck disable=SC2046
	go test -skip "$skip" $(go list ./... | grep -v suites)
}

package() {
	install -Dm755 authelia "$pkgdir"/usr/bin/authelia

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname

	install -Dm644 config.template.yml \
		"$pkgdir"/usr/share/doc/$pkgname/config.template.yml

	install -dm750 -o authelia -g authelia \
		"$pkgdir"/etc/authelia
}

