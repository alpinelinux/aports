maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=setroubleshoot
pkgver=3.3.37
pkgrel=0
pkgdesc="Helps troubleshoot SELinux problems"
url="https://gitlab.com/setroubleshoot/setroubleshoot"
arch="all"
license="GPL-2.0-or-later"
depends="
	gtk+3.0
	py3-dasbus
	py3-dbus
	py3-gobject3
	py3-libselinux
	py3-libxml2
	xdg-utils
	"
makedepends="
	autoconf
	audit-dev
	dbus-dev
	glib-dev
	gtk+3.0-dev
	intltool
	libnotify-dev
	libselinux-dev
	py3-pip
	py3-setuptools
	automake
	"
subpackages="
	$pkgname-doc
	$pkgname-lang
	$pkgname-pyc
	$pkgname-systemd
	"
source="https://gitlab.com/-/project/24478376/uploads/cbdfc2a87b350583c32b168fd9aad9fd/setroubleshoot-$pkgver.tar.gz
	no-pip-net.patch
	"

prepare() {
	default_prepare

	# for no-pip-net.patch
	autoreconf -vfi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

