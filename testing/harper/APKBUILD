# Contributor: Alex McGrath <amk@amk.ie>
# Maintainer: Alex McGrath <amk@amk.ie>
pkgname=harper
pkgver=3.0.0
pkgrel=0
pkgdesc="English grammar checker"
url="https://github.com/Automattic/harper"
arch="all !s390x" # tests fail on s390x
license="GPL-3.0-or-later"
makedepends="cargo cargo-auditable"
source="harper-$pkgver.tar.gz::https://github.com/Automattic/harper/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build -p harper-cli -p harper-ls --release --frozen
}

check() {
	cargo test --workspace --exclude harper-desktop --exclude harper-wasm --frozen
}

package() {
	install -Dm 755 target/release/harper-cli -t "$pkgdir/usr/bin"
	install -Dm 755 target/release/harper-ls -t "$pkgdir/usr/bin"
}

sha512sums="
83caf79af1ff687a7eff7aa16ef9ef3b5031d363c9f29002e006dffee75deac1eff4e7987b42740d989ef6ffe90eb69e086084da27d0f720e7f6184b5b60f5cd  harper-3.0.0.tar.gz
"
