# Maintainer: Valts Liepiņš <cipharius@tase.lv>
pkgname=arcan
pkgver=0.7.1_git20260924
pkgrel=2
_arcanrev="a3e787cbe0ed17e64a107b9b98df96eb68fabc1b"
_openalrev="731bdaefeb9cfcc52267bb8fc884248e4420e9ec"
pkgdesc="Development framework and engine for embedded user interfaces and custom desktop environments"
url="https://arcan-fe.com/"
arch="all"
license="BSD-3-Clause GPL-2.0+ LGPL-2.0+"
makedepends="
	ca-certificates
	cmake
	espeak-ng-dev
	ffmpeg-dev
	file-dev
	freetype-dev
	fuse3-dev
	libseccomp-dev
	libusb-dev
	libxkbcommon-dev
	mesa-dev
	openal-soft-dev
	ruby
	samurai
	sqlite-dev
	"
subpackages="
	acfgfs:acfgfs
	aclip:aclip
	aloadimage:aloadimage
	$pkgname-dev
	$pkgname-doc
	$pkgname-net
	$pkgname-console
	$pkgname-afsrv-decode:afsrv_decode
	$pkgname-afsrv-encode:afsrv_encode
	$pkgname-afsrv-terminal:afsrv_terminal
	$pkgname-afsrv-remoting:afsrv_remoting
	$pkgname-afsrv-net:afsrv_net
	$pkgname-afsrv-game:afsrv_game
	$pkgname-afsrv-avfeed:afsrv_avfeed
	"
source="
	$pkgname-$_arcanrev.tar.gz::https://codeberg.org/letoram/arcan/archive/$_arcanrev.tar.gz
	openal-$_openalrev.zip::https://github.com/letoram/openal/archive/$_openalrev.zip
	CMakeLists.txt.patch
	"
builddir="$srcdir/arcan"
# arcan automatic test suite is currently broken (2026-09-20)
options="!check"

case "$CARCH" in
riscv64)
	makedepends="$makedepends lua5.1-dev"
	_disablejit=On
	;;
armhf|armv7|x86)
	makedepends="$makedepends luajit-dev"
	_disablejit=Off
	;;
*)
	makedepends="$makedepends
		luajit-dev
		vlc-dev
		"
	_disablejit=Off
	;;
esac

prepare() {
	default_prepare
	mv "$srcdir/openal-$_openalrev" "$builddir/external/git/openal"
}

build() {
	cd doc
	ruby docgen.rb mangen

	cd "$builddir"
	cmake -B build -G Ninja \
		-DDISTR_TAG=alpine \
		-DENGINE_BUILDTAG="arcan-git-${_arcanrev:0:8}-${pkgver/_*/}" \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_LWA=On \
		-DHYBRID_SDL=Off \
		-DHYBRID_HEADLESS=On \
		-DDISABLE_WAYLAND=On \
		-DDISABLE_SUID=On \
		-DDISABLE_JIT="$_disablejit" \
		./src
	cmake --build build

	for atool in acfgfs aclip aloadimage; do
		msg2 "Building ${atool}..."
		install -dm755 "$builddir"/src/tools/"$atool"/build
		cd "$builddir"/src/tools/"$atool"/build
		cmake \
			-DCMAKE_BUILD_TYPE=MinSizeRel \
			-DCMAKE_INSTALL_PREFIX=/usr \
			-DARCAN_SHMIF_LIBRARY="$builddir"/build/shmif/libarcan_shmif.so \
			-DARCAN_SHMIF_INCLUDE_DIR="$builddir"/src/shmif \
			-DARCAN_TUI_INCLUDE_DIR="$builddir"/build \
			../
		ninja -C .
	done
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"

	for atool in acfgfs aclip aloadimage; do
		cd "$builddir"/src/tools/"$atool"
		DESTDIR="$pkgdir" cmake --install build
	done
}

net() {
	pkgdesc="Arcan A12 network server and client"
	amove usr/bin/arcan-net
	amove usr/bin/arcan-net-session
}

console() {
	pkgdesc="Arcan appl for a basic full-screen console"
	depends="$pkgname-afsrv-terminal=$pkgver-r$pkgrel"
	amove usr/share/arcan/appl/console
}

afsrv_decode() {
	pkgdesc="Arcan frameserver with multi-media decode capabilities"
	amove usr/bin/afsrv_decode
}

afsrv_encode() {
	pkgdesc="Arcan frameserver with multi-media encode capabilities"
	amove usr/bin/afsrv_encode
}

afsrv_terminal() {
	pkgdesc="Arcan frameserver with terminal emulator and Lua based TUI shell capabilities"
	amove usr/bin/afsrv_terminal
}

afsrv_remoting() {
	pkgdesc="Arcan frameserver with remoting capabilities"
	amove usr/bin/afsrv_remoting
}

afsrv_net() {
	pkgdesc="Arcan frameserver with A12 client remoting capabilities"
	amove usr/bin/afsrv_net
}

afsrv_game() {
	pkgdesc="Arcan frameserver with built-in libretro emulator"
	amove usr/bin/afsrv_game
}

afsrv_avfeed() {
	pkgdesc="Arcan frameserver for client testing purposes"
	amove usr/bin/afsrv_avfeed
}

acfgfs() {
	pkgdesc="Arcan FUSE file system driver for window manager automation"
	amove usr/bin/arcan_cfgfs
}

aclip() {
	pkgdesc="Arcan command-line clipboard integration"
	amove usr/bin/aclip
}

aloadimage() {
	pkgdesc="Arcan command-line imageviewer, xloadimage replacement"
	amove usr/bin/aloadimage
}

