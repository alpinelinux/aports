# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=libva-v4l2_request
pkgver=1.3
pkgrel=0
pkgdesc="VA-API (libva) backend driver for V4L2 stateless video decoders"
url="https://github.com/sofus13/libva-v4l2_request/"
arch="aarch64" # only works on aarch64
license="GPL-3.0-or-later"
makedepends="meson cmake libva-dev"
options="!check" # no tests
source="$pkgname-$pkgver.tar.gz::https://github.com/sofus13/$pkgname/archive/refs/tags/$pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
