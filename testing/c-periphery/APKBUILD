# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=c-periphery
pkgver=2.5.2
pkgrel=0
pkgdesc="C library for linux peripheral I/O (GPIO, LED, PWM, SPI, I2C, MMIO, serial)"
url="https://github.com/vsergeev/c-periphery"
arch="all"
license="MIT"
makedepends="linux-headers"
options="!check" # tests doesn't work on build systems
subpackages="$pkgname-dev $pkgname-doc $pkgname-static"
source="$pkgname-$pkgver.tar.gz::https://github.com/vsergeev/c-periphery/archive/refs/tags/v$pkgver.tar.gz"

build() {
	make
	make shared
}

package() {
	mkdir -p ${pkgdir}/usr/lib
	mkdir -p ${pkgdir}/usr/include/periphery
	mkdir -p ${pkgdir}/usr/share/doc/c-periphery
	cp -P ./*so* ${pkgdir}/usr/lib
	cp -P periphery.a ${pkgdir}/usr/lib/libperiphery.a
	cp -P src/*.h ${pkgdir}/usr/include/periphery
	cp -P docs/* ${pkgdir}/usr/share/doc/c-periphery
}

sha512sums="
4342f0ef0c9ba9641eddc759415572355057786e436bc367870d0bec8866c0844c9d14437d3dc9eb77bc06304fe7bf2dcbcd7d02ed9108cb2e40a008b08cabdc  c-periphery-2.5.2.tar.gz
"
