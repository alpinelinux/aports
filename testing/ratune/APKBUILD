# Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
pkgname=ratune
pkgver=0.16.0
pkgrel=0
pkgdesc="Modern highly-customizable Subsonic TUI client"
url="https://github.com/acmagn/ratune"
# 32-bit: alsa crate fails to build (`timespec`)
# ppc64le, s390x: rustix
# also: i might revisit this later and fix
arch="aarch64 loongarch64 x86_64"
license="MIT"
makedepends="
	alsa-lib-dev
	cargo
	cargo-auditable
	dbus-dev
	openssl-dev
	"
subpackages="$pkgname-doc"
source="https://github.com/acmagn/ratune/archive/v$pkgver/ratune-$pkgver.tar.gz"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/ratune -t "$pkgdir"/usr/bin/
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

sha512sums="
fb4dc613ca4bfe5bea8352df4d277a42cf4fbe8e7ccbd1c56204ce162e4dd3da749c7ffdf82f8f82cf99502678571371ce7c1504d2b13ece5714bfe38d8f1197  ratune-0.16.0.tar.gz
"
