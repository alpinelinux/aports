# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=cxx-rust-cssparser
pkgver=1.1.0
pkgrel=0
pkgdesc="Library for parsing CSS using the Rust cssparser crate"
url="https://invent.kde.org/libraries/cxx-rust-cssparser"
arch="all"
license="LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL"
makedepends="
	corrosion
	extra-cmake-modules
	qt6-qtbase-dev
	samurai
	"
case "$pkgver" in
	*.90*) _rel=unstable;;
	*) _rel=stable;;
esac
_repo_url="https://invent.kde.org/libraries/cxx-rust-cssparser.git"
source="https://download.kde.org/stable/cxx-rust-cssparser/cxx-rust-cssparser-$pkgver.tar.xz"

# spdx: LicenseRef licenses are not SPDX compliant
options="
	!check
	!spdx
	net
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}


sha512sums="
13575fe98644dda543c6f1c114e750a5a25502c75b89477282eac9d956f87834a2126d6c2cc357f6fcff99c7eb304d290e9f928800747cf7e4d405b22febb793  cxx-rust-cssparser-1.1.0.tar.xz
"
