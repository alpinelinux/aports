maintainer="team/kde <bribbers@disroot.org>"
pkgname=bbpPairings
pkgver=6.0.0
pkgrel=0
arch="all"
url="https://github.com/BieremaBoyzProgramming/bbpPairings"
pkgdesc="A Swiss-system chess tournament pairing engine"
license="Apache-2.0"
source="$pkgname-$pkgver.tar.gz::https://github.com/BieremaBoyzProgramming/bbpPairings/archive/refs/tags/v$pkgver.tar.gz"

build() {
	make
	make build
}

check() {
	make test
}

package() {
	mkdir -p "$pkgdir"/usr/bin
	install -Dm755 bbpPairings.exe "$pkgdir"/usr/bin/bbpPairings
}

