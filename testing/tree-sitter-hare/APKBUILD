pkgname=tree-sitter-hare
pkgver=0_git20240730
_commit="fb6ea01461441ec7c312e64e326649f5e9011a64"
pkgrel=0
pkgdesc="Hare grammar for tree-sitter"
url="https://git.sr.ht/~ecs/tree-sitter-hare"
arch="all"
license="GPL-3.0-only"
makedepends="tree-sitter-dev"
checkdepends="tree-sitter-cli"
install_if="tree-sitter-grammars"
source="$pkgname-$_commit.tar.gz::https://git.sr.ht/~ecs/tree-sitter-hare/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

build() {
	abuild-tree-sitter build
}

check() {
	tree-sitter test
}

package() {
	DESTDIR="$pkgdir" abuild-tree-sitter install
}

