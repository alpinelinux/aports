Patch-Source: https://github.com/kjdev/php-ext-zstd/pull/110
Report success from the compress.zstd:// stream close handlers.

Both close handlers returned EOF unconditionally. Since PHP 8.6.0RC1
(php/php-src@c07cc8502c0, bug #60110) fclose(), file_put_contents() and
copy() propagate a non-zero close result as false, so every write through
the wrapper was reported as a failure.

diff --git a/tests/streams_10.phpt b/tests/streams_10.phpt
new file mode 100644
index 0000000..05d32c1
--- /dev/null
+++ b/tests/streams_10.phpt
@@ -0,0 +1,48 @@
+--TEST--
+compress.zstd streams report a successful close
+--FILE--
+<?php
+$file = dirname(__FILE__) . '/streams_10.out';
+$plain = dirname(__FILE__) . '/streams_10.txt';
+
+// As of PHP 8.6, fclose(), file_put_contents() and copy() return false when
+// closing the stream fails, so the close handler has to report success.
+$data = str_repeat('abcd', 1024);
+
+echo "Compress\n";
+
+$fp = fopen('compress.zstd://' . $file, 'w');
+var_dump($fp !== false);
+var_dump(fwrite($fp, $data) === strlen($data));
+var_dump(fclose($fp));
+
+echo "Decompress\n";
+
+$fp = fopen('compress.zstd://' . $file, 'r');
+var_dump($fp !== false);
+var_dump(stream_get_contents($fp) === $data);
+var_dump(fclose($fp));
+
+echo "Copy\n";
+
+file_put_contents($plain, $data);
+var_dump(copy($plain, 'compress.zstd://' . $file));
+var_dump(file_get_contents('compress.zstd://' . $file) === $data);
+
+@unlink($file);
+@unlink($plain);
+?>
+===DONE===
+--EXPECT--
+Compress
+bool(true)
+bool(true)
+bool(true)
+Decompress
+bool(true)
+bool(true)
+bool(true)
+Copy
+bool(true)
+bool(true)
+===DONE===
