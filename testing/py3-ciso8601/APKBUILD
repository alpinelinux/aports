maintainer="Michał Polański <michal@polanski.me>"
pkgname=py3-ciso8601
pkgver=2.4.1
pkgrel=0
pkgdesc="Fast ISO8601 date time parser for Python written in C"
url="https://github.com/closeio/ciso8601"
license="MIT"
arch="all"
makedepends="python3-dev py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest py3-tz"
source="https://github.com/closeio/ciso8601/archive/v$pkgver/py3-ciso8601-$pkgver.tar.gz"
builddir="$srcdir/ciso8601-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
48a0b2ea2e2f8122b55b9ae4c582d3881061a58d785606401db1bd549ace222bced91abe9a03c5c30f7845b3e1f5ef854584c388947be084718d6d3c90f23abc  py3-ciso8601-2.4.1.tar.gz
"
