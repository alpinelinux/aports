maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=unrar-free
pkgver=0.5.0
pkgrel=0
pkgdesc="Extract files from RAR archives"
url="https://gitlab.com/bgermann/unrar-free"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	autoconf
	automake
	libtool
	libarchive-dev
	argp-standalone
	"
subpackages="
	$pkgname-doc
	$pkgname-dev
	$pkgname-static
	$pkgname-libs
"
provides="unrar"
source="https://gitlab.com/bgermann/unrar-free/-/archive/$pkgver/unrar-free-$pkgver.tar.gz"

build() {
	autoreconf -fvi
	./configure --prefix=/usr
	make LIBS="-largp"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 README "$pkgdir/usr/share/doc/$pkgname/README"
	ln -s unrar-free "$pkgdir/usr/bin/unrar"
}

sha512sums="
da01a98bae28181d86feef645b4888b1cdf479c186a9ec8171fb854a8ff0b232631409192eb334125edbb213f9a2c065727beb80812a8378e10df1aabe930e19  unrar-free-0.5.0.tar.gz
"
