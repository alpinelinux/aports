maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=unrar-free
pkgver=0.3.4
pkgrel=0
pkgdesc="Extract files from RAR archives"
url="https://gitlab.com/bgermann/unrar-free"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	autoconf
	automake
	libtool
	libarchive-dev
	argp-standalone
	"
subpackages="$pkgname-doc"
provides="unrar"
source="https://gitlab.com/bgermann/unrar-free/-/archive/$pkgver/unrar-free-$pkgver.tar.gz"

build() {
	autoreconf -fvi
	./configure --prefix=/usr
	make LIBS="-largp"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 README "$pkgdir/usr/share/doc/$pkgname/README"
	ln -s unrar-free "$pkgdir/usr/bin/unrar"
}

sha512sums="
2ab2175677b29defe76a665dc74bb00c5cbe14978c48a17e317d806b79fd1a67dfaec0761d8cea4d0dffc9a45ab3f0e6a4ae661aefac49736029672855f0578a  unrar-free-0.3.4.tar.gz
"
