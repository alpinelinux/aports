# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=tremor
pkgver=1.1.0
pkgrel=0
pkgdesc="Force-feedback device control utility (for Catacomb)"
url="https://catacombing.org/"
arch="all !riscv64" # riscv64: compiles too slowly
license="GPL-3.0-only"
options="net" # need to download cargo deps
makedepends="cargo-auditable"
source="$pkgname-v$pkgver.tar.gz::https://git.sr.ht/~undeadleech/tremor/archive/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/tremor -t "$pkgdir"/usr/bin/
}
sha512sums="
98a240ac0ff293ee3d0633d979466bf674949f66ad395c772ac1ac203e09da43306ec7b6041191ddd5ba220a3eb38e08787ba8afc6f154dc936e991b3a79942b  tremor-v1.1.0.tar.gz
"
