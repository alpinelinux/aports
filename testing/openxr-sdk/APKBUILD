maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=openxr-sdk
pkgver=1.1.65
pkgrel=0
pkgdesc="OpenXR loader and headers"
url="https://github.com/KhronosGroup/OpenXR-SDK"
arch="all"
license="Apache-2.0"
makedepends="
	cmake
	jsoncpp-dev
	jsoncpp-static
	libx11-dev
	libxcb-dev
	samurai
	wayland-dev
	"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/KhronosGroup/OpenXR-SDK/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/OpenXR-SDK-release-$pkgver"
options="!check" # no tests


build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_RPATH=True \
		-DBUILD_WITH_SYSTEM_JSONCPP=ON \
		-DDYNAMIC_LOADER=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
