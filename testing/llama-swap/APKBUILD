# Contributor: andar1an <stephen@theandar1an.com>
# Maintainer: andar1an <stephen@theandar1an.com>
pkgname=llama-swap
pkgver=251
pkgrel=0
pkgdesc="Reliable model swapping for any local OpenAI/Anthropic compatible server - llama.cpp, vllm, etc"
url="https://github.com/mostlygeek/llama-swap"
arch="aarch64 x86_64"
license="MIT"
makedepends="
	go
	npm
	"
pkgusers="llama-swap"
pkggroups="llama-swap"
install="$pkgname.pre-install"
subpackages="
	$pkgname-openrc
	$pkgname-headless
	"
source="
	$pkgname-v$pkgver.tar.gz::https://github.com/mostlygeek/llama-swap/archive/refs/tags/v$pkgver.tar.gz
	llama-swap.initd
"
options="net"

prepare() {
	default_prepare
}

build() {
	_builddate=$(date -u +"$SOURCE_DATE_EPOCH")

	npm install --prefix ui
	npm run build --prefix ui

	go build -tags embed_ui -ldflags="-X main.commit=alpine -X main.version=$pkgver -X main.date=$_builddate" -o $pkgname
	go build -ldflags="-X main.commit=alpine -X main.version=$pkgver -X main.date=$_builddate" -o $pkgname-headless
}

check() {
	go build -o simple-responder cmd/simple-responder/simple-responder.go
	# skipped test will succeed outside of rootbld or ci - not sure why fails within, may have to do with SIGs
	go test -short -count=1 -skip TestProcessCommand_StopHonorsGracefulTimeout $builddir/internal/...

	npm ci --prefix ui && npm run check --prefix ui && npm test --prefix ui
}

headless() {
	pkgdesc="$pkgdesc (without Web UI)"
	install -Dm755 "$builddir/$pkgname-headless" -t "$subpkgdir/usr/bin/$pkgname"
}

package() {
	install -Dm755 "$pkgname" -t "$pkgdir/usr/bin/"
	install -Dm644 -o llama-swap -g llama-swap "$builddir/config.example.yaml" "$pkgdir"/etc/llama-swap/config.yaml
	chown llama-swap:llama-swap "$pkgdir"/etc/llama-swap
	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
 	install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
7d1a7ff65b434f22d28befa759283b9776c0609a6a51bd34798e382797087891c2c4138a4b0fefdfa2c04162d62f6d4e589cf4087942778f4fb97623aaadcd09  llama-swap-v251.tar.gz
76d016b1609e8329e8e5975a5861813f1858ac1ce71b3f60966aabc72af5e226aa5f8dd94f35402b1b459dccc80e64b75705404da0781e458c32b3af299a08f6  llama-swap.initd
"
