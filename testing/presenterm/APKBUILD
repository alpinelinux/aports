# Maintainer: qaqland <qaq@qaq.land>
maintainer="qaqland <qaq@qaq.land>"
pkgname=presenterm
pkgver=0.16.1
pkgrel=0
pkgdesc="Markdown terminal slideshow tool"
url="https://mfontanini.github.io/presenterm/"
arch="all !s390x" # fails to build nix crate
license="BSD-2-Clause"
makedepends="cargo cargo-auditable"
checkdepends="bash"
subpackages="$pkgname-doc"
source="https://github.com/mfontanini/presenterm/archive/v$pkgver/presenterm-$pkgver.tar.gz"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/presenterm "$pkgdir"/usr/bin/presenterm
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
8de6abefc4a905c248efc8334b2f576b13b47dcc3ebee471111a9f34f282eb7307cd2b7c67ddd2023e519b81debd075053185e7088a7af603ac498f21f33eca3  presenterm-0.16.1.tar.gz
"
