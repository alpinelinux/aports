0c59be8bc82569dcc50ac56f44b41615b0dcdeb2a0fbfa2e78040bfb2e0e911f195cef9ab1a5ce5e1e1635da596f7773f5a2ad24049825f5186d670162e59e75  php86-stream-close-result.patch
"
