# Contributor: knuxify <knuxify@gmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=projectm
pkgver=4.1.7
pkgrel=0
_frontend_commit=86885bef2e2d7b7b0a6f13180309cf893b5bb5b0
_imgui_commit=45acd5e0e82f4c954432533ae9985ff0e1aad6d5
pkgdesc="Music visualizer which uses 3D accelerated iterative image based rendering"
url="https://github.com/projectM-visualizer/projectm"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	cmake
	freetype-dev
	glm-dev
	gtest-dev
	mesa-dev
	poco-dev
	samurai
	sdl2-dev
	"
subpackages="$pkgname-dev $pkgname-playlist $pkgname-sdl"
source="https://github.com/projectM-visualizer/projectm/releases/download/v$pkgver/libprojectM-$pkgver.tar.gz
	frontend-sdl-cpp-$_frontend_commit.tar.gz::https://github.com/projectM-visualizer/frontend-sdl-cpp/archive/$_frontend_commit.tar.gz
	imgui-$_imgui_commit.tar.gz::https://github.com/ocornut/imgui/archive/$_imgui_commit.tar.gz
	"
builddir="$srcdir/libprojectM-$pkgver"

prepare() {
	default_prepare

	rm -rf "$srcdir/frontend-sdl-cpp-$_frontend_commit/vendor/imgui"
	mv "$srcdir/imgui-$_imgui_commit" \
		"$srcdir/frontend-sdl-cpp-$_frontend_commit/vendor/imgui"
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_SYSTEM_GLM=ON \
		-DENABLE_SYSTEM_PROJECTM_EVAL=OFF \
		-DBUILD_TESTING=ON
	cmake --build build

	# Install libprojectM into a staging dir so the frontend can find it
	DESTDIR="$srcdir/staging" cmake --install build

	cmake -S "$srcdir/frontend-sdl-cpp-$_frontend_commit" \
		-B frontend-build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_PREFIX_PATH="$srcdir/staging/usr"
	cmake --build frontend-build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	DESTDIR="$pkgdir" cmake --install frontend-build
}

playlist() {
	pkgdesc="$pkgdesc (playlist library)"
	amove usr/lib/libprojectM-4-playlist.so.*
}

sdl() {
	pkgdesc="$pkgdesc (SDL frontend)"
	amove usr/bin/projectMSDL
	amove usr/share/projectMSDL
	amove usr/share/applications/projectMSDL.desktop
	amove usr/share/icons/hicolor
}

sha512sums="
