From ad8c306ab919dec3993c3fa57ab9e134f99a5126 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Thu, 22 Oct 2026 14:52:54 +0200
Subject: [PATCH] Use system cert store

---
 Cargo.lock | 63 ++++++++++++++++++++++++++++++++++++++++++++----------
 Cargo.toml |  2 +-
 2 files changed, 53 insertions(+), 12 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 6014f204..8d9fc58d 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2872,10 +2872,10 @@ dependencies = [
  "hyper",
  "hyper-util",
  "rustls",
+ "rustls-native-certs",
  "tokio",
  "tokio-rustls",
  "tower-service",
- "webpki-roots",
 ]
 
 [[package]]
@@ -4395,6 +4395,12 @@ dependencies = [
  "pathdiff",
 ]
 
+[[package]]
+name = "openssl-probe"
+version = "0.2.1"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "7c87def4c32ab89d880effc9e097653c8da5d6ef28e6b539d313baaacfbafcbe"
+
 [[package]]
 name = "option-ext"
 version = "0.2.0"
@@ -5455,6 +5461,7 @@ dependencies = [
  "pin-project-lite",
