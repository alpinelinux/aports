# Contributor: lauren n. liberda <lauren@selfisekai.rocks>
maintainer="lauren n. liberda <lauren@selfisekai.rocks>"
pkgname=tinymist
pkgver=0.15.10
pkgrel=0
pkgdesc="Language service for Typst"
url="https://github.com/Myriad-Dreamin/tinymist"
# armhf, armv7: failing tests
# loongarch64: fails to link
# riscv64: failing test - triggers panic in rust libcore
# s390x: failing tests - looks like endianness
# x86: failing asserts in reflexo crate
arch="all !armhf !armv7 !loongarch64 !riscv64 !s390x !x86"
license="Apache-2.0"
makedepends="
	cargo
	cargo-auditable
	lld23
	openssl-dev
	"
checkdepends="cage-run"
subpackages="typlite:_typlite"
source="
	https://github.com/Myriad-Dreamin/tinymist/archive/v$pkgver/tinymist-$pkgver.tar.gz
	system-ca-store.patch
	rustix.patch
	"

export OPENSSL_NO_VENDOR=1
export PKG_CONFIG_ALL_DYNAMIC=1
export RUSTFLAGS="$RUSTFLAGS -Clink-arg=-fuse-ld=lld"

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release -p tinymist-cli
	cargo auditable build --frozen --release -p typlite -F cli --bin typlite
}

check() {
	# tests package is e2e tests. they don't simply work.
	cage-run cargo test --frozen --workspace --exclude tests
}

package() {
	install -Dm755 target/release/tinymist target/release/typlite -t "$pkgdir"/usr/bin/
}

_typlite() {
	pkgdesc="CLI tool to convert a subset of Typst to Markdown"
	amove usr/bin/typlite
}

sha512sums="
b747f3977b345fc14df0647acb5c356ec6d284f04f8e9898197618c7c14f9f5b5be487f5d3443da8b4668552a82921cdd34243a34e597cdc39791471549843bd  tinymist-0.15.10.tar.gz
6ceb2cc0918de6fb0bc3c864411f6453fe74b4337e8222076bddb12190e332d40525b6f9692e45205184361af0de54d0cf458e220f3b76b4b959c8def6c04b0b  system-ca-store.patch
7cc0941134d0bba639748117dc76864e90080604f38aef86852eccef8361a40adbf7b3514213495a90bfcff3d3a0370a9e733b3fbf20d0c2bdaaa33f13ee2878  rustix.patch
"
