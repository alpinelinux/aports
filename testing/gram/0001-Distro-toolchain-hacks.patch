From 942022f9de947a9636b153e412a02dad3023e906 Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Mon, 23 Mar 2026 00:03:58 +0100
Subject: [PATCH] Distro toolchain hacks

---
 crates/extension/src/extension_builder.rs | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/crates/extension/src/extension_builder.rs b/crates/extension/src/extension_builder.rs
index c2f6dd20a2..c266ce0113 100644
--- a/crates/extension/src/extension_builder.rs
+++ b/crates/extension/src/extension_builder.rs
@@ -201,11 +201,8 @@ async fn compile_rust_extension(
     }
 
     fn find_wasi_sysroot(&self) -> Result<PathBuf> {
-        let wasi_sdk_sysroot = self.cache_dir.join("wasi-sdk").join("share").join("wasi-sysroot");
-        let wasi_sysroot = self.cache_dir.join("wasi-sysroot");
-        if wasi_sdk_sysroot.is_dir() {
-            return Ok(wasi_sdk_sysroot);
-        } else if wasi_sysroot.is_dir() {
+        let wasi_sysroot = PathBuf::from("/usr/share/wasi-sysroot");
+        if wasi_sysroot.is_dir() {
             return Ok(wasi_sysroot);
         } else {
             anyhow::bail!("No WASI sysroot found");
@@ -382,6 +379,7 @@ async fn install_rust_wasm_target_if_needed(&self) -> Result<()> {
         if sysroot.join("lib/rustlib").join(RUST_TARGET).exists() {
             return Ok(());
         }
+        bail!("install rust-wasm");
 
         let output = util::command::new_smol_command("rustup")
             .args(["target", "add", RUST_TARGET])
@@ -419,6 +417,7 @@ async fn install_wasi_sdk_if_needed(&self) -> Result<PathBuf> {
                 }
             }
         }
+        bail!("install clang and rust-wasm");
 
         let url = if let Some(asset_name) = WASI_SDK_ASSET_NAME {
             format!("{WASI_SDK_URL}{asset_name}")
@@ -489,6 +488,7 @@ async fn install_wasi_sdk_if_needed(&self) -> Result<PathBuf> {
     }
 
     async fn install_wasi_sysroot_if_needed(&self) -> Result<()> {
+        return Ok(());
         let url = format!("{WASI_SDK_URL}{WASI_SDK_SYSROOT_NAME}");
         let wasi_sysroot_dir = self.cache_dir.join("wasi-sysroot");
         let mut response = self.http.get(&url, AsyncBody::default(), true).await?;
