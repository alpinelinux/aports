# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kemoji
pkgver=0.1.0
pkgrel=0
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/libraries/kemoji"
pkgdesc="Framework providing an emoji dictionary, model, search and basic components for use in applications"
license="GPL-2.0-only AND LGPL-2.1-or-later AND Unicode-DFS-2016"
makedepends="
	extra-cmake-modules
	kconfig-dev
	kcoreaddons-dev
	kcrash-dev
	ki18n-dev
	kirigami-dev
	kwindowsystem-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	samurai
	"
checkdepends="xwayland-run"
subpackages="$pkgname-dev"
_repo_url="https://invent.kde.org/libraries/kemoji.git"
source="https://download.kde.org/unstable/kemoji/kemoji-$pkgver.tar.xz"
case "$CARCH" in
	armv7)
		options="!check" # Mesa issue when running wlheadless-run
		;;
esac

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	# emojitest contains the failing glyphAvailableTest test which has been removed since 0.1.0
	wlheadless-run -- ctest --test-dir build -E "emojitest"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
ad10050ef7e4f25d0c2571dba9acea96e4f70a5deb3c9870db78eadfac8ef458dc0fe32787f4e452631aa38853907e88acc9ed9fbee433b20116295e92052a05  kemoji-0.1.0.tar.xz
"
