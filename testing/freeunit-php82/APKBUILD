pkgname=freeunit-php82
pkgver=1.37.2
pkgrel=0
pkgdesc="PHP 8.2 module for FreeUnit"
url="https://freeunit.org/"
arch="all"
license="Apache-2.0"
_phpver=82
depends="freeunit"
_clang_ver=23
makedepends="
	brotli-dev
	clang$_clang_ver
	linux-headers
	openssl-dev>3
	php$_phpver-dev
	php$_phpver-embed
	rust cargo
	zlib-dev
	zstd-dev
	"
checkdepends="procps-ng
	py3-brotli
	py3-openssl
	py3-pytest
	py3-zstandard
	php$_phpver-opcache
	"
source="freeunit-$pkgver.tar.gz::https://github.com/freeunitorg/freeunit/archive/refs/tags/$pkgver.tar.gz
	phpver.patch
	"
builddir="$srcdir/freeunit-$pkgver"

