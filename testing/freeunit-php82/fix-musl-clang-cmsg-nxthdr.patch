From d2f16f794b75365bfbb16dd36182b6226101cc72 Mon Sep 17 00:00:00 2001
From: Andy Postnikov <apostnikov@gmail.com>
Date: Sat, 29 Aug 2026 07:55:02 +0200
Subject: [PATCH] test(port): iterate control messages through NXT_CMSG_NXTHDR

musl's CMSG_NXTHDR expands to a comparison between a size_t and the
ptrdiff_t of a pointer subtraction, so clang rejects it under -Werror
with -Wsign-compare. nxt_socket_msg.h already carries NXT_CMSG_NXTHDR
for exactly this, and both production call sites use it; this test
reached for the raw macro and so failed to build on musl with clang.

Alpine's aports CI found it, building 1.36.1 with clang22:

    src/test/nxt_unit_port_recv_test.c:107:17: error: comparison of
    integers of different signs: '__size_t' and '__ptrdiff_t'

The repository's own alpine-edge clang leg covers this configuration,
but build-distros.yml is workflow_dispatch-only and has never run.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/test/nxt_unit_port_recv_test.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/test/nxt_unit_port_recv_test.c b/src/test/nxt_unit_port_recv_test.c
index d93eb12c..c798177d 100644
--- a/src/test/nxt_unit_port_recv_test.c
+++ b/src/test/nxt_unit_port_recv_test.c
@@ -31,6 +31,7 @@
  */
 
 #include "nxt_main.h"
+#include "nxt_socket_msg.h"
 #include "nxt_port.h"
 #include "nxt_port_queue.h"
 #include "nxt_app_queue.h"
@@ -104,7 +105,7 @@ nxt_port_recv_test_send(nxt_unit_ctx_t *ctx, nxt_unit_port_t *port,
 
     for (cmsg = CMSG_FIRSTHDR(&msg);
          cmsg != NULL;
-         cmsg = CMSG_NXTHDR(&msg, cmsg))
+         cmsg = NXT_CMSG_NXTHDR(&msg, cmsg))
     {
         size = cmsg->cmsg_len - CMSG_LEN(0);
 
