Patch-Source: https://github.com/arnaud-lb/php-rdkafka (no 8.6 release yet)
PHP 8.6 removed XtOffsetOf(), zval_dtor() and EMPTY_SWITCH_DEFAULT_CASE();
provide compat replacements in the shared php_rdkafka.h header.
--- a/php_rdkafka.h	2026-07-01 07:31:19.019838919 +0200
+++ b/php_rdkafka.h	2026-07-01 07:31:19.059382124 +0200
@@ -21,6 +21,16 @@
 #ifndef PHP_RDKAFKA_H
 #define PHP_RDKAFKA_H
 
+/* PHP 8.6 removed several long-standing compatibility macros. */
+#if PHP_VERSION_ID >= 80600
+# include <stddef.h>
+# define XtOffsetOf(type, member) offsetof(type, member)
+# define zval_dtor(zv) zval_ptr_dtor_nogc(zv)
+# ifndef EMPTY_SWITCH_DEFAULT_CASE
+#  define EMPTY_SWITCH_DEFAULT_CASE() default: ZEND_UNREACHABLE(); break;
+# endif
+#endif
+
 #include "librdkafka/rdkafka.h"
 #include "conf.h"
 
