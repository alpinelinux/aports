# Contributor: Marco Martinelli <marco+t2sz@13byte.com>
# Maintainer: Marco Martinelli <marco+t2sz@13byte.com>
pkgname=t2sz
pkgver=1.3.0
pkgrel=0
pkgdesc="Compress a file into a seekable zstd with special handling for tar archives"
url="https://github.com/martinellimarco/t2sz"
arch="all"
license="GPL-3.0-or-later"
makedepends="cmake samurai zstd-dev"
checkdepends="bash grep tar zstd"
source="$pkgname-$pkgver.tar.gz::https://github.com/martinellimarco/t2sz/archive/refs/tags/v$pkgver.tar.gz
	tests-grep-q-pipefail.patch
	"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi

	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DBUILD_TESTS="$(want_check && echo ON || echo OFF)" \
		$crossopts .

	cmake --build build
}

check() {
	local skip=
	# the tests on inputs of several GiB time out on riscv64
	case "$CARCH" in
	riscv64) skip='input_over_2gib|ustar_size_over_4gib|pax_size|base256_size|huge_' ;;
	esac
	ctest --test-dir build --output-on-failure ${skip:+-E "$skip"}
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

