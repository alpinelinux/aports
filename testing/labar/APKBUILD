# Maintainer: Jacques Boscq <jacques@boscq.fr>
pkgname=labar
pkgver=1.6.0
pkgrel=0
pkgdesc="Launch bar for Wayland"
url="https://github.com/Amodio/labar"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	meson
	scdoc
	wayland-dev
	wayland-protocols
	librsvg-dev
	cairo-dev
	alsa-lib-dev
	gtk4.0-dev
	"
subpackages="$pkgname-dbg $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
options="!check"  # no tests available

build() {
	abuild-meson . build -Db_sanitize=none
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
05f748f1b9b79fba0baeedf973f9981bd09853ae7a65229ada36bbecf94c2fc2ab4499f2f5c6776c892f3bc3365ae278d2c59c4794c5af03190aee88c684f6ce  labar-1.6.0.tar.gz
"
