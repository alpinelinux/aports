pkgname=wlock
pkgver=1.0_git20250929
pkgrel=0
_commit=c1d159a83391b11efbd85e76c30e8d39ae66e2dd
pkgdesc="wlock is a itsy-bitsy sessionlocker for Wayland compositors that support the ext-session-lock-v1 protocol"
url="https://codeberg.org/sewn/wlock"
arch="all"
license="GPL-3.0-or-later"
makedepends="wayland-dev wayland-protocols libxkbcommon-dev"
options="suid !check" # No testsuite
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	make
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

