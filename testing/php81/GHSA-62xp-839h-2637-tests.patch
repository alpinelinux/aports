From 0dab7744fae56e70af6400ffe30037d8559dc91a Mon Sep 17 00:00:00 2001
From: Andy Postnikov <apostnikov@gmail.com>
Date: Fri, 25 Sep 2026 13:05:55 +0200
Subject: [PATCH] FPM tests: allow %s and %d in expected log messages

The GHSA-62xp-839h-2637 tests expect "child %d said into stderr", which
relies on LogTool expanding %s/%d as run-tests.php does. PHP 8.2 gained
this with the access log filtering feature; carry just that hunk so the
tests can run on PHP 8.1.

Backported from 327bb219867 (sapi/fpm/tests/logtool.inc hunk only).
---
 sapi/fpm/tests/logtool.inc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/sapi/fpm/tests/logtool.inc b/sapi/fpm/tests/logtool.inc
index 64a58ec7600..fc2043b84ef 100644
--- a/sapi/fpm/tests/logtool.inc
+++ b/sapi/fpm/tests/logtool.inc
@@ -513,7 +513,11 @@ class LogTool
         }
         $this->trace("Matching EXPECTED: $expectedMessage");
 
-        $pattern = sprintf('/^(?:%s )?%s: %s(%s)$/', self::P_TIME, $type, self::P_DEBUG, $expectedMessage);
+        // Allow expected message to contain %s and %s for any string or number as in run-tests.php
+        $expectRe = str_replace('%s', '[^\r\n]+', $expectedMessage);
+        $expectRe = str_replace('%d', '\d+', $expectRe);
+
+        $pattern = sprintf('/^(?:%s )?%s: %s(%s)$/', self::P_TIME, $type, self::P_DEBUG, $expectRe);
         $this->trace("PATTERN: $pattern");
 
         return function ($line) use ($expectedMessage, $pattern, $type, $ignoreErrorFor) {
