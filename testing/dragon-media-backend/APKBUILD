# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=dragon-media-backend
pkgver=0.90.0
pkgrel=0
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/libraries/dragon-media-backend"
pkgdesc="Qt C++ library intended for desktop music players"
license="BSD-3-Clause AND LGPL-2.1-only AND LGPL-3.0-only AND MIT"
makedepends="
	extra-cmake-modules
	flac-dev
	kcoreaddons-dev
	ki18n-dev
	kio-dev
	kissfft-dev
	qcoro-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	samurai
	sdl3-dev
	"
subpackages="$pkgname-dev"
_repo_url="https://invent.kde.org/libraries/dragon-media-backend.git"
#source="https://download.kde.org/stable/dragon-media-backend/dragon-media-backend-$pkgver.tar.xz"
source="$pkgname-$pkgver.tar.gz::https://invent.kde.org/libraries/dragon-media-backend/-/archive/v$pkgver/dragon-media-backend-v$pkgver.tar.gz"
options="!check" # Requires access to audio devices
builddir="$srcdir/$pkgname-v$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_PLUGIN_SSHMANAGER=ON
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
f0509bffcf12d2709c3bb07706893bc5aa22bd1ffbd5eb716141432c035eab16de0f208aac833855f8ba402b99cd167fa34556ee9fa70567b4adbd5e70fc9989  dragon-media-backend-0.90.0.tar.gz
"
