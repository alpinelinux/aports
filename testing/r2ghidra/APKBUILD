c64d8e481625140a8ab158affe23a9ce68631200ac05017e093d7695a6d2220012cb4baf5be6d6214c537089ed77e3c8ed7c74190493c022233f7fd43b92fd3b  ghidra-native-0.7.2.tar.gz
fb2e8c5c4d075f92f325dae39016713d4290b3f3d7824749fc247a7bc876ee55e3d90edf583db96e554840dc4bfb2d44c8b8113aaece64534da06ce172138fa6  use-system-zlib.patch
"
