--
From 1b7c32d3231914b3dd26dd9b32a91f2f50eacdb1 Mon Sep 17 00:00:00 2001
From: Leon White <l.white@interstellarlab.earth>
Date: Wed, 30 Sep 2026 11:23:51 +0200
Subject: [PATCH] fix: awk: bad regex '.*{': Invalid contents of {}

---
 tests/bufr_delayed_replication.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/bufr_delayed_replication.sh b/tests/bufr_delayed_replication.sh
index f2180780dc..c7dc80aebb 100755
--- a/tests/bufr_delayed_replication.sh
+++ b/tests/bufr_delayed_replication.sh
@@ -62,8 +62,8 @@ extract_array()
             if (index($0, "}") > 0) inb = 0
         }
         END {
-            sub(/.*{/, "", buf)
-            sub(/}.*/, "", buf)
+            sub(/.*[{]/, "", buf)
+            sub(/[}].*/, "", buf)
             gsub(/[ \t]/, "", buf)
             print buf
         }
