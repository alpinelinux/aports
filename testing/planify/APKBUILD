# Contributor: WrenIX <dev.alpine@wrenix.eu>
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=planify
pkgver=4.20.0
pkgrel=0
pkgdesc="Task manager with Todoist, Nextcloud & CalDAV support designed for GNOME"
url="https://useplanify.com/"
# riscv64: too slow to build
arch="all !riscv64"
license="GPL-3.0-or-later"
makedepends="
	desktop-file-utils
	evolution-data-server-dev
	gnome-online-accounts-dev
	gtk4.0-dev
	gtksourceview5-dev
	gxml-dev
	json-glib-dev
	libadwaita-dev
	libgee-dev
	libical-dev
	libportal-dev
	libsecret-dev
	libsoup3-dev
	libspelling-dev
	meson
	sqlite-dev
	vala
	webkit2gtk-6.0-dev
	"
subpackages="$pkgname-dev $pkgname-lang"
_chrono_ver="1.0.0"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/alainm23/planify/archive/refs/tags/v$pkgver.tar.gz
	chrono.tar.gz::https://github.com/alainm23/chrono/archive/refs/tags/$_chrono_ver.tar.gz
	"
options="!check" # fail

prepare() {
	default_prepare

	rm -fR "$builddir"/subprojects/chrono
	mv "$srcdir"/chrono-$_chrono_ver "$builddir"/subprojects/chrono
}

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
dae0b2dd6b700c8d5a343370213b022c6b8b4c4d0be395b9ca9226bd4855198ab3368314c976e2401af2ff7f0c239c7a6d659d2553b21f643a4d0e6941684b54  planify-4.20.0.tar.gz
a1f41d47bee2c1f24a6709aa2f26a0ee5a71e4845033ac232aef7d0b33932ee2905c1ff83cd6f9fb1afae995053edfd7adbbd4d11ed26c54ae85c2e7b6ba6892  chrono.tar.gz
"
