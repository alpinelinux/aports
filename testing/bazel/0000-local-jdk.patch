diff --git a/abuild/BUILD.bazel b/abuild/BUILD.bazel
new file mode 100644
index 0000000000..0d8acc2e2c
--- /dev/null
+++ b/abuild/BUILD.bazel
@@ -0,0 +1,22 @@
+load(
+    "@rules_java//toolchains:default_java_toolchain.bzl",
+    "NONPREBUILT_TOOLCHAIN_CONFIGURATION",
+    "default_java_toolchain",
+)
+
+# musl libc (Alpine) can't run the glibc-linked prebuilt ijar/singlejar
+# binaries in @remote_java_tools_linux, so build them from source instead,
+# and use local_jdk (system openjdk) rather than an incompatible remotejdk.
+# ijar/singlejar/oneversion are pointed at this tree's own copies (already
+# patched for musl by 0001-off64t-fix.patch) rather than remote_java_tools'
+# vendored, unpatched copies of the same sources.
+default_java_toolchain(
+    name = "non_prebuilt_java_21_toolchain",
+    configuration = NONPREBUILT_TOOLCHAIN_CONFIGURATION,
+    ijar = "//third_party/ijar:ijar",
+    java_runtime = "@local_jdk//:jdk",
+    oneversion = "//src/tools/one_version:one_version_main",
+    singlejar = "//src/tools/singlejar:singlejar",
+    source_version = "21",
+    target_version = "21",
+)
