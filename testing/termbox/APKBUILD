# Contributor: Adam Saponara <as@php.net>
# Maintainer: Adam Saponara <as@php.net>
pkgname=termbox
pkgver=1.1.4
pkgrel=0
pkgdesc="Legacy-free alternative to ncurses"
url="https://github.com/termbox/termbox"
arch="all"
license="MIT"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
options="!check" # test suite not included in tagged releases
source="
	$pkgname-$pkgver.tar.gz::https://github.com/termbox/termbox/archive/v$pkgver.tar.gz
	termbox.pc
	"

prepare() {
	default_prepare
	sed -i "s/@VERSION@/$pkgver/g" "$srcdir"/termbox.pc
}

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" prefix=/usr install
	install -Dm644 -t "$pkgdir"/usr/lib/pkgconfig "$srcdir"/termbox.pc
	install -Dm644 -t "$pkgdir"/usr/share/licenses/"$pkgname" COPYING
}

sha512sums="
