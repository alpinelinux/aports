# Maintainer: ovf <ovf@mm.st>
pkgname=vcmi
pkgver=1.7.5
pkgrel=0
pkgdesc="Open-source engine for Heroes of Might and Magic III"
url="https://vcmi.eu"
# game engine
arch="aarch64 loongarch64 ppc64le riscv64 x86_64"
license="GPL-2.0-or-later"
options="!check" # "test coverage is close to 0" and needs googletest
makedepends="
	boost-dev
	clang
	cmake
	ffmpeg-dev
	fuzzylite-dev
	libsquish-dev
	minizip-dev
	onetbb-dev
	onnxruntime-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	qt6-qtsvg-dev
	samurai
	sdl2-dev
	sdl2_image-dev
	sdl2_mixer-dev
	sdl2_ttf-dev
	zlib-dev
	"
source="https://github.com/vcmi/vcmi/archive/refs/tags/$pkgver/vcmi-$pkgver.tar.gz"

build() {
	# TODO: switch back to gcc
	# This avoids running into a compiler bug in gcc.
	export CC=clang
	export CXX=clang++

	cmake -B build -G Ninja -Wno-dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DFORCE_BUNDLED_FL=OFF \
		-DENABLE_INNOEXTRACT=OFF \
		-DENABLE_DISCORD=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
13a08e5d121cab77aae01cba6382c68624a4a321b5bfbd54f2798b9de02cd3a8e2da5b97ad8e827ba05c3a11069dec4e0cde3d302d22558b96901f28fc27c17d  vcmi-1.7.5.tar.gz
"
