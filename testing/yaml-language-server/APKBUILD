# Maintainer: Lauri Tirkkonen <lauri@hacktheplanet.fi>
pkgname=yaml-language-server
pkgver=2.0.0
pkgrel=0
pkgdesc="Language Server for YAML Files"
url="https://github.com/redhat-developer/yaml-language-server"
arch="noarch"
license="MIT"
depends="nodejs"
makedepends="npm esbuild"
source="yaml-language-server-$pkgver.tar.gz::https://github.com/redhat-developer/yaml-language-server/archive/$pkgver.tar.gz
yaml-language-server
"
subpackages="$pkgname-doc"

build() {
	npm ci

	# jsonc-parser can't be bundled: https://github.com/microsoft/node-jsonc-parser/pull/78
	# work around by making it external
	local extpkgs="jsonc-parser"
	local extarg=
	for p in $extpkgs; do
		extarg="$extarg --external:$p"
	done

	npm run compile
	# l10n json bundles are loaded by server.js from "../../l10n" relative
	# to import.meta.dirname, so we need to tell esbuild where server.js
	# will be installed
	esbuild out/src/server.js $extarg --platform=node --target=node22 --bundle --outdir=dist/ --define:import.meta.dirname='"/usr/lib/node_modules/yaml-language-server/out/src"'
}

check() {
	npm test
}

package() {
	local moddir="$pkgdir"/usr/lib/node_modules/$pkgname
	local extpkgs="jsonc-parser"

	install -d "$moddir"/node_modules
	install -Dm 0644 dist/server.js "$moddir"/out/src/server.js
	cp -r l10n "$moddir"/
	for p in $extpkgs; do
		cp -r node_modules/$p "$moddir"/node_modules/
	done

	install -Dm0755 "$srcdir"/$pkgname "$pkgdir"/usr/bin/$pkgname
	install -Dm0644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
