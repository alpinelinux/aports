# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="team/kde <bribbers@disroot.org>"
pkgname=bigscreen-ui
pkgver=0.1.0
pkgrel=1
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/libraries/bigscreen-ui"
pkgdesc="Reusable QtQuick components designed for applications targeting Bigscreen platforms"
license="LGPL-2.0-or-later AND LGPL-2.1-only AND LGPL-3.0-only"
depends="kirigami"
makedepends="
	extra-cmake-modules
	kcolorscheme-dev
	kcoreaddons-dev
	ki18n-dev
	kirigami-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	samurai
	"
_repo_url="https://invent.kde.org/libraries/bigscreen-ui"
source="https://download.kde.org/unstable/bigscreen-ui/bigscreen-ui-$pkgver.tar.xz"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
038e6d3a9be4d1a9265c092159f4c1e680997f16aae20b450afe34b367aaff865dc86be0a608f1cfc7ae01f005aed961f964c0ffccf4ccdd0653961b76d209fb  bigscreen-ui-0.1.0.tar.xz
"
