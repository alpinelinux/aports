59e1d5e7446044899e33fdd6cbaf30dedacd503eeecb62e2858e299a1b7d536a975dbea054de1e98bf3bbcb252119e4e1d8fa16d2c43b8f7ba8d55d1ca787df3  cmake-system-libs.patch
ec99fee05392bb2ea235ab1b265a69d6cf4fe08f76a525315dc1fe7cf6c8ed29a72f1768441a70183ce493dde35cc78a5c2be932b80b4cefd0cb2e953cedefe4  libpiper-system-libs.patch
"
