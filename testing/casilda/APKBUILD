maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=casilda
pkgver=1.6.0
pkgrel=0
pkgdesc="Wayland compositor widget for Gtk 4"
url="https://gitlab.gnome.org/jpu/casilda"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	gobject-introspection-dev
	gtk4.0-dev
	libepoxy-dev
	meson
	wlroots0.20-dev
	"
subpackages="$pkgname-dev"
source="https://gitlab.gnome.org/jpu/casilda/-/archive/$pkgver/casilda-$pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
