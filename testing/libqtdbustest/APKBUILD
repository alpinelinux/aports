# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=libqtdbustest
pkgver=0.4.1
pkgrel=1
pkgdesc='Library for testing DBus interactions using Qt'
url="https://gitlab.com/ubports/development/core/libqtdbustest"
arch="all"
license="LGPL-3.0-only"
depends="
	$pkgname-common
	"
makedepends="
	cmake
	cmake-extras
	gmock
	gtest-dev
	qt5-qtbase-dev
	qt6-qtbase-dev
	samurai
	"
checkdepends="
	dbus-x11
	procps
	py3-dbusmock
	"
subpackages="$pkgname-common $pkgname-qt5"
source="https://gitlab.com/ubports/development/core/libqtdbustest/-/archive/$pkgver/libqtdbustest-$pkgver.tar.gz"

build() {
	cmake -B build-qt5 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DENABLE_QT6=OFF
	cmake --build build-qt5

	cmake -B build-qt6 -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DENABLE_QT6=ON
	cmake --build build-qt6
}

check() {
	ctest --test-dir build-qt6
}

package() {
	DESTDIR="$pkgdir" cmake --install build-qt5
	DESTDIR="$pkgdir" cmake --install build-qt6
}

common() {
	amove usr/libexec/libqtdbustest/watchdog
	amove usr/bin/qdbus-simple-test-runner
	amove usr/share/libqtdbustest/
}

qt5() {
	depends="$pkgname-common"

	amove usr/lib/libqtdbustest.so*
	amove usr/include/libqtdbustest-1
	amove usr/lib/pkgconfig/libqtdbustest-1.pc
}

sha512sums="
bc40de0eec594780b8d73b790cca8abacff1d6b861f8a32f048a00f39071e10b677b336a168dda5ba48a2f589b7bfe172fefdd8dbd54b900d8ea96da2eb1d505  libqtdbustest-0.4.1.tar.gz
"
