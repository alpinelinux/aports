# Contributor: Robin Candau <robincandau@protonmail.com>
# Maintainer: Robin Candau <robincandau@protonmail.com>
pkgname=py3-pylxd
pkgver=2.4.2
pkgrel=0
pkgdesc="Library for interacting with the LXD REST API"
url="https://pylxd.readthedocs.io/en/latest"
arch="noarch"
license="Apache-2.0"
depends="py3-cryptography py3-dateutil py3-requests-toolbelt py3-ws4py"
makedepends="py3-gpep517 py3-build py3-installer py3-wheel py3-setuptools"
checkdepends="py3-pytest py3-pytest-cov py3-ddt py3-requests-mock"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/canonical/pylxd/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/pylxd-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	pytest --doctest-modules pylxd
}

package() {
	gpep517 install-wheel --destdir "$pkgdir" .dist/*.whl
}

sha512sums="
