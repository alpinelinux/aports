# Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
pkgname=catacomb
pkgver=1.5.0
pkgrel=0
pkgdesc="Wayland Mobile Compositor optimized to run on low-end hardware with limited battery life"
url="https://catacombing.org/"
# riscv64: compiles too slowly to finish in time
# ppc64le s390x: blocked by aports#18444
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-only"
options="net"
makedepends="
	cargo-auditable
	libinput-dev
	libseat-dev
	libxkbcommon-dev
	mesa-dev
	wayland-dev
"
source="$pkgname-v$pkgver.tar.gz::https://git.sr.ht/~undeadleech/catacomb/archive/v$pkgver.tar.gz
	dont-depend-on-systemd.patch
	"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --workspace --release --frozen
}

package() {
	install -Dm755 target/release/catacomb -t "$pkgdir"/usr/bin/
	install -Dm755 initrc "$pkgdir"/etc/catacomb/initrc
	install -Dm644 session/catacomb.desktop -t "$pkgdir"/usr/share/wayland-sessions/
}

sha512sums="
87e6fff98ea11e63c49cf4ff1d057068bbcc67f930a9775e3c19fc279f11b6bf6ba41871bf580ca3252ea235c59ea96a31d992d3031bfa6885fe12b0e8bf2b4b  catacomb-v1.5.0.tar.gz
b8310af774599e3965ec40ea02d2ae3af35892f6e898022a649427f0b16a00ad79163d52053d53a3ad01f60160b7558ccfe2d40c99c47c7b11c9c9d38ca887e1  dont-depend-on-systemd.patch
"
