# Contributor: Leon White <badfunkstripe@gmail.com>
maintainer="Leon White <badfunkstripe@gmail.com>"
pkgname=deskflow
pkgver=1.26.0
pkgrel=0
pkgdesc="Control other computers on your local network with a single mouse and keyboard"
url="https://github.com/deskflow/deskflow"
arch="all"
license="GPL-2.0-only"
depends="hicolor-icon-theme"
makedepends="
	cmake
	doxygen
	gtest-dev
	help2man
	libei-dev
	libportal-dev
	libxkbfile-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	samurai
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/deskflow/deskflow/archive/v$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DSKIP_BUILD_TESTS=ON
	cmake --build build
}

check() {
	QT_QPA_PLATFORM=minimal \
	ctest --test-dir build/src/unittests
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
