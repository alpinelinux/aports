maintainer="Hannes Braun <hannes@hannesbraun.net>"
pkgname=rubyripper
pkgver=0.8.0_rc4
_pkgver=${pkgver/_/}
pkgrel=0
pkgdesc="Secure audio disc ripper"
url="https://github.com/bleskodev/rubyripper"
arch="noarch"
license="GPL-3.0-only"
depends="cdparanoia ruby ruby-base64 ruby-rexml"
checkdepends="ruby-rspec"
source="https://github.com/bleskodev/rubyripper/archive/v$_pkgver/rubyripper-$_pkgver.tar.gz"
builddir="$srcdir/rubyripper-$_pkgver"

build() {
	./configure \
		--prefix=/usr \
		--enable-cli
}

check() {
	rspec
}

package() {
	make DESTDIR="$pkgdir" install
}

