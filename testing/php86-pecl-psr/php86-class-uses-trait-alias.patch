Patch-Source: https://github.com/php/php-src (PHP 8.6 behavior change)
On PHP >= 8.6 class_uses() reports the aliased trait name that a class
actually uses (Psr\...) instead of the underlying PsrExt\... trait.
The extension aliases PsrExt\* into Psr\*; the alias resolves correctly
(logger identity assertion still passes), only these test expectations
need to reflect the 8.6 name. No upstream 8.6 release yet (latest v1.2.0).
--- a/tests/PsrLogLoggerAwareTrait.phpt	2026-07-01 06:57:51.005269812 +0200
+++ b/tests/PsrLogLoggerAwareTrait.phpt	2026-07-01 06:57:59.304318219 +0200
@@ -21,6 +21,6 @@
 --EXPECT--
 bool(true)
 array(1) {
-  ["PsrExt\Log\LoggerAwareTrait"]=>
-  string(27) "PsrExt\Log\LoggerAwareTrait"
+  ["Psr\Log\LoggerAwareTrait"]=>
+  string(24) "Psr\Log\LoggerAwareTrait"
 }
--- a/tests/PsrLogLoggerTrait.phpt	2026-07-01 06:57:51.140270598 +0200
+++ b/tests/PsrLogLoggerTrait.phpt	2026-07-01 06:57:59.308318243 +0200
@@ -84,6 +84,6 @@
 array(0) {
 }
 array(1) {
-  ["PsrExt\Log\LoggerTrait"]=>
-  string(22) "PsrExt\Log\LoggerTrait"
+  ["Psr\Log\LoggerTrait"]=>
+  string(19) "Psr\Log\LoggerTrait"
 }
