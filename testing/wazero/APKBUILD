# Maintainer: Jason Staten <code.alpine@jxs.me>
pkgname=wazero
pkgver=1.12.0
pkgrel=0
pkgdesc="WebAssembly Core Specification 1.0 and 2.0 compliant runtime"
url="https://wazero.io"
# Tests fail on 32-bit and ppc64le architectures
arch="x86_64 aarch64"
license="Apache-2.0"
makedepends="go"
checkdepends="xz"
options="net" # go modules
source="$pkgname-$pkgver.tar.gz::https://github.com/tetratelabs/wazero/archive/refs/tags/v$pkgver.tar.gz
	go-1.27.0.patch
	"

build() {
	go build \
		-ldflags "-X github.com/tetratelabs/wazero/internal/version.version=$pkgver" \
		./cmd/wazero
}

check() {
	# gojs/goos -buildmode=pie not supported on js/wasm
	export GOFLAGS="${GOFLAGS/-buildmode=pie}"
	# integration_test/vs/compiler requires real paths for relative read
	export GOFLAGS="${GOFLAGS/-trimpath}"

	go test -short ./...
}

package() {
	install -Dm755 wazero -t "$pkgdir"/usr/bin
}

sha512sums="
ba16cc98d8f5cb8e7cde7f625076ab01ca5483105c174ae087f2f5bd125c673220b1b12b2ec1ab3c97369e69824834cea9547d3ae096c63f62fabcaa309c65be  wazero-1.12.0.tar.gz
58fe59fd362713f380c5ffa8c2e3f76b911e7aba13013370dfce010a3d0be4ade38c9b0c5fb3f248815586a894c2e8ad51a090e4b326fb41fdc397db4583520d  go-1.27.0.patch
"
