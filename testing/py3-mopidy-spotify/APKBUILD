# Contributor: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Bart Ribbers <bribbers@disroot.org>
pkgname=py3-mopidy-spotify
pkgver=5.0.1
pkgrel=0
pkgdesc="Mopidy extension for playing music from Spotify"
url="https://mopidy.com/ext/spotify/"
arch="noarch"
license="Apache-2.0"
depends="
	gst-plugins-rs-spotify
	mopidy
	py3-cyclopts
	py3-pykka
	py3-requests
	py3-responses
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/mopidy/mopidy-spotify/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/mopidy-spotify-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
c1c686b04a108857f8265496f4a99d2daac0dead899bd603439e21cf62cca48158ef04046ae9fed6a7916632234c58375473e8041dbc5e149cb41fdcd38be9dc  py3-mopidy-spotify-5.0.1.tar.gz
"
