# Contributor: Aster Boese <asterboese@mailbox.org>
# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=morph-browser
pkgver=1.99.4
pkgrel=0
pkgdesc="Lightweight web browser tailored for Ubuntu Touch"
url="https://gitlab.com/ubports/development/core/morph-browser"
# armhf blocked by lomiri-ui-toolkit
# riscv64, s390x, x86, armhf and armv7 blocked by qt6-qtwebengine
arch="all !armhf !riscv64 !s390x !x86 !armhf !armv7"
license="GPL-3.0-only"
depends="
	font-liberation
	lomiri-action-api
	lomiri-content-hub
	lomiri-ui-extras
	lomiri-ui-toolkit
	qt6-qtbase-sqlite
	"
makedepends="
	click-dev
	cmake
	cmake-extras
	gnome-desktop-dev
	libapparmor-dev
	libpsl-dev
	lomiri-trust-store-dev
	qt6-qt5compat-dev
	qt6-qtdeclarative-dev
	qt6-qtsvg-dev
	qt6-qtwebengine-dev
	samurai
	xvfb-run
	"
checkdepends="
	py3-dbusmock
	py3-xdg
	"
subpackages="
	$pkgname-doc
	$pkgname-lang
	"
source="https://gitlab.com/ubports/development/core/morph-browser/-/archive/$pkgver/morph-browser-$pkgver.tar.gz"
options="!check" # 4 tests fail and test 27 hangs

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DCLICK_MODE=off \
		-DENABLE_QT6=ON
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
96348d394be5f7907a9cd0c941773a0698849bd6ddcdfbbafb4b317fc00181d18806fee91dde590b5195227bb8cc3170705c86a43ef24c992aa5e9b085b41b50  morph-browser-1.99.4.tar.gz
"
