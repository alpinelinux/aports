maintainer="lauren n. liberda <lauren@selfisekai.rocks>"
pkgname=typescript-go
pkgver=7.0.2
pkgrel=0
pkgdesc="JavaScript with syntax for types"
url="https://www.typescriptlang.org/"
arch="all"
license="Apache-2.0"
makedepends="go"
# net: go modules
# !check: needs some setup to succeed
options="net !check"
source="
	https://github.com/microsoft/TypeScript/archive/v$pkgver/TypeScript-$pkgver.tar.gz
	"
builddir="$srcdir/TypeScript-$pkgver/tsc"

prepare() {
	default_prepare

	go mod download
}

build() {
	go build -ldflags="-s -w -X github.com/microsoft/TypeScript/tsc/internal/core.version=$pkgver" -tags=noembed -o built/local/tsc ./cmd/tsgo
}

check() {
	go test ./...
}

# node -p 'process.arch'
case "$CARCH" in
	aarch64) _node_platform="arm64" ;;
	armhf|armv7) _node_platform="arm" ;;
	loongarch64) _node_platform="loong64" ;;
	ppc64le) _node_platform="ppc64le" ;;
	riscv64) _node_platform="riscv64" ;;
	s390x) _node_platform="s390x" ;;
	x86) _node_platform="ia32" ;;
	x86_64) _node_platform="x64" ;;
esac

package() {
	# On npm, the "typescript" package contains JS API, and registers a binary "tsc",
	# which re-exposes a platform-specific package with a binary and std library definitions,
	# named something like "@typescript/typescript-linux-loong64".
	#
	# No, the library definitions are not platform-dependent. ¯\_(ツ)_/¯

	# Yes, it is in lib. Not my idea.
	install -Dm755 built/local/tsc -t "$pkgdir"/usr/lib/"$pkgname"/platform/lib/
	ln -s ./tsc "$pkgdir"/usr/lib/"$pkgname"/platform/lib/tsgo
	cp -r internal/bundled/libs/* "$pkgdir"/usr/lib/"$pkgname"/platform/lib/
	mkdir -p "$pkgdir"/usr/lib/"$pkgname"/node_modules/@typescript/
	ln -s ../../platform "$pkgdir"/usr/lib/"$pkgname"/node_modules/@typescript/typescript-linux-"$_node_platform"

	mkdir -p "$pkgdir"/usr/bin/
	# Not as "tsc" to not conflict with typescript
	ln -s ../lib/"$pkgname"/platform/lib/tsc "$pkgdir"/usr/bin/tsgo
}

sha512sums="
ab381b5d7bf16463f75a19b9b517d8ed94699f14fd49746e72df3f23381df6a1debb057b1d9c939a3d393952ad684dc9200cb964195ba6d62efb6a1536bc835a  TypeScript-7.0.2.tar.gz
"
