Patch-Source: https://github.com/phpredis/phpredis/commit/78c1c690 (Fix PHP 8.6 builds)
Patch-Source: https://github.com/phpredis/phpredis/pull/2888 (Fix PHP 8.6 bin2hex build)
PHP 8.6 removed XtOffsetOf, zval_dtor, zval_is_true, INI_STR/INI_INT/
INI_BOOL, WRONG_PARAM_COUNT/ZEND_WRONG_PARAM_COUNT and
EMPTY_SWITCH_DEFAULT_CASE (provided as compat macros in common.h), and
changed the session module save_path/session_name arguments to
zend_string* (handled in redis_session.c).

PHP 8.6 also dropped php_hash_bin2hex() from ext/hash in favour of
zend_bin2hex() in the Zend engine (upstream PR #2888), but the packaged
8.6.0alpha1 predates that php-src change: it still ships the old
function and lacks the new one, so no PHP_VERSION_ID guard can pick the
right API. Instead a local redis_bin2hex() helper is added to common.h
and the two call sites (redis.c, library.c) are switched to it, which
works with any PHP version.
--- a/common.h
+++ b/common.h
@@ -4,6 +4,39 @@
 #ifndef REDIS_COMMON_H
 #define REDIS_COMMON_H
 
+/* PHP 8.6 removed a number of long-standing compatibility macros. Provide
+ * replacements so this release keeps building. See upstream commit 78c1c690
+ * "Fix PHP 8.6 builds" and PR #2888 "Fix PHP 8.6 bin2hex build". */
+#if PHP_VERSION_ID >= 80600
+# include <stddef.h>
+# define XtOffsetOf(type, member)     offsetof(type, member)
+# define zval_dtor(zv)                zval_ptr_dtor_nogc(zv)
+# define zval_is_true(zv)             zend_is_true(zv)
+# define INI_STR(name)                ((char *) zend_ini_string((name), strlen(name), 0))
+# define INI_INT(name)                zend_ini_long((name), strlen(name), 0)
+# define INI_BOOL(name)               ((bool) zend_ini_long((name), strlen(name), 0))
+# define ZEND_WRONG_PARAM_COUNT()     do { zend_wrong_param_count(); RETURN_THROWS(); } while (0)
+# define WRONG_PARAM_COUNT            ZEND_WRONG_PARAM_COUNT()
+# define EMPTY_SWITCH_DEFAULT_CASE()  default: ZEND_UNREACHABLE(); break;
+#endif
+
+/* PHP 8.6 dropped php_hash_bin2hex() from ext/hash in favour of
+ * zend_bin2hex() in the Zend engine, but 8.6.0alpha1 predates the
+ * replacement (it still ships the old function and lacks the new one),
+ * so no PHP_VERSION_ID guard can pick the right API. Use a local
+ * implementation instead; call sites are patched to use it. */
+static zend_always_inline void
+redis_bin2hex(char *out, const unsigned char *in, size_t in_len)
+{
+    static const char hexits[] = "0123456789abcdef";
+    size_t i;
+
+    for (i = 0; i < in_len; i++) {
+        out[i * 2]     = hexits[in[i] >> 4];
+        out[i * 2 + 1] = hexits[in[i] & 0x0F];
+    }
+}
+
 #define PHPREDIS_CTX_PTR ((char *)0xDEADC0DE)
 #define PHPREDIS_NOTUSED(v) ((void)v)
 
--- a/redis.c
+++ b/redis.c
@@ -330,7 +330,7 @@
 
     /* First try to have PHP generate the bytes */
     if (php_random_bytes_silent(ZSTR_VAL(s), bytes) == SUCCESS) {
-        php_hash_bin2hex(dst, (unsigned char *)ZSTR_VAL(s), bytes);
+        redis_bin2hex(dst, (unsigned char *)ZSTR_VAL(s), bytes);
         zend_string_release(s);
         return;
     }
--- a/library.c
+++ b/library.c
@@ -876,7 +876,7 @@
     efree(ctx);
 
     hex = zend_string_safe_alloc(ops->digest_size, 2, 0, 0);
-    php_hash_bin2hex(ZSTR_VAL(hex), digest, ops->digest_size);
+    redis_bin2hex(ZSTR_VAL(hex), digest, ops->digest_size);
     ZSTR_VAL(hex)[2 * ops->digest_size] = 0;
 
     efree(digest);
