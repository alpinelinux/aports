From ed6cface55570f0cb027b09ed36a0290152c3aa6 Mon Sep 17 00:00:00 2001
From: Hugo Osvaldo Barrera <hugo@whynothugo.nl>
Date: Tue, 11 Aug 2026 11:22:08 +0200
Subject: [PATCH] Use system Vulkan headers

The custom vendored headers are broken for non-64bit platforms.
---
 .cargo/config.toml | 5 +++++
 1 file changed, 5 insertions(+)
 create mode 100644 .cargo/config.toml

diff --git a/.cargo/config.toml b/.cargo/config.toml
new file mode 100644
index 0000000..c5ad104
--- /dev/null
+++ b/.cargo/config.toml
@@ -0,0 +1,5 @@
+# Use the real system Vulkan headers instead of the crate's bundled shim. The
+# shim's _Static_assert hardcodes the 64-bit size for VkPhysicalDeviceFeatures2
+# which fails on 32-bit targets, where the struct is 228 bytes.
+[env]
+BINDGEN_EXTRA_CLANG_ARGS = "-include /usr/include/vulkan/vulkan.h"
-- 
2.55.0

