1f2d2eb9736ef99e16ed8e36d176dc02bc8ede9d9fb7bb5bac2242f7c31b9f810b82ffd5d676d5ef8e7fc2469e91f68498382485c780373cff330b2d793572d4  0001-Use-system-Vulkan-headers.patch
"
