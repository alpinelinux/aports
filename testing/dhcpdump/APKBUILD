pkgname=dhcpdump
pkgver=2.00
pkgrel=0
pkgdesc="Parse DHCP packets from a network interface"
url="https://github.com/dhcpdump-org/dhcpdump"
arch="all"
license="BSD-2-Clause"
makedepends="libpcap-dev yascreen-dev cmd:pod2man"
options="!check" # no test
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.xz::https://github.com/dhcpdump-org/dhcpdump/releases/download/v$pkgver/dhcpdump-$pkgver.tar.xz"

build() {
	make PREFIX=/usr
}

package() {
	install -Dm0755 dhcpdump "$pkgdir"/usr/sbin/dhcpdump
	install -Dm0644 dhcpdump.8 "$pkgdir"/usr/share/man/man8/dhcpdump.8
}

sha512sums="
da6da9648b55320b5ece737ec798252d8bfe5578d5c4fd7c9d5604a3b316127e4071bcb5c5919052689871df699c14eef394505243a81709c65087a805318b4f  dhcpdump-2.00.tar.xz
"
