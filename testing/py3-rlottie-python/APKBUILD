maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-rlottie-python
_pkgname=rlottie-python
pkgver=1.3.8
pkgrel=0
pkgdesc="ctypes API for rlottie"
url="https://github.com/laggykiller/rlottie-python"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	py3-gpep517
	py3-py-build-cmake
	samurai
	"
options="!check"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/rlottie_python-$pkgver.tar.gz"
builddir="$srcdir/rlottie_python-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

