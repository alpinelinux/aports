# Contributor: Kevin Corrales <y62257136@gmail.com>
# Maintainer: Kevin Corrales <y62257136@gmail.com>
pkgname=tdf
pkgver=0.5.0
pkgrel=0
pkgdesc="A tui-based PDF viewer"
url="https://github.com/itsjunetime/tdf"
arch="all"
license="AGPL-3.0-only"
makedepends="
	fontconfig-dev
	clang
	clang-libclang
	clang-dev
	cargo-auditable
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/itsjunetime/tdf/archive/refs/tags/v$pkgver.tar.gz
	10-cargo-mupdf-fix.patch
	"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/tdf "$pkgdir"/usr/bin/tdf
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
