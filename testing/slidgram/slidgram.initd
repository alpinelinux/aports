#!/sbin/openrc-run

description="Telegram/XMPP gateway"
command=/usr/bin/slidgram
: ${command_user:=slidgram:slidgram}
: ${command_args:="-c /etc/slidgram/slidgram.conf"}

output_logger="logger -t slidgram -p daemon.info"
error_logger="logger -t slidgram -p daemon.info"

supervisor="supervise-daemon"

depend() {
	need net
	use dns logger
	after firewall
}
