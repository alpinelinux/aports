maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=slidgram
pkgver=0.5.0
pkgrel=0
pkgdesc="XMPP gateway for Telegram"
url="https://codeberg.org/slidge/slidgram"
arch="noarch"
license="AGPL-3.0-or-later"
pkgusers="slidgram"
pkggroups="slidgram"
install="$pkgname.pre-install"
depends="
	py3-pyrofork
	py3-rlottie-python
	py3-slidge
	py3-slidge-style-parser
	py3-tgcrypto-pyrofork
	py3-uvloop
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-setuptools_scm
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-pytest-asyncio
	"
subpackages="$pkgname-pyc $pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/slidge/slidgram/archive/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	$pkgname.conf
	"
builddir="$srcdir/$pkgname"

build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	install -Dm 755 "$srcdir/$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
	install -Dm 644 "$srcdir/$pkgname.confd" "$pkgdir/etc/conf.d/$pkgname"
	install -Dm 640 -g slidgram "$srcdir/slidgram.conf" "$pkgdir/etc/slidgram/slidgram.conf"
	install -d -m 755 -o slidgram -g slidgram "$pkgdir/var/lib/slidgram"
}

