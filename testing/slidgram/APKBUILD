2883d5ec8b2b864af171b5f211ea38f112021a62ffc26bd7bccd2e821db932649965763877a15a9328e22d7fb0adc28057ea5c83765b73593713bf74a4e0b56e  slidgram.initd
e23537275f8dd8b43d1ab6a0e25368b515c565ebfbc5ed4cd77cbfe01efa60a4e7178dbbce52ab0683e404506ea5a61e5bf1d395f935a7725fd6b72367016119  slidgram.confd
32dbe7fcc92a894214d82f0c96816ba4526b21bcd8aa9f4b0214355dbf2e5fbe8ec391c76d66eeca98ead8fddd19be15d4550f5bf684f18b1d45a8c199792e01  slidgram.conf
