# Maintainer: Macmod <zz.mcmd@gmail.com>
maintainer="Macmod <zz.mcmd@gmail.com>"
pkgname=ldapx
pkgver=1.3.3
pkgrel=0
pkgdesc="Flexible LDAP proxy for inspecting and transforming LDAP traffic"
url="https://github.com/Macmod/ldapx"
license="MIT"
arch="all !x86 !armhf !armv7"
makedepends="go"
subpackages="$pkgname-doc"
options="net"
source="$pkgname-$pkgver.tar.gz::https://github.com/Macmod/ldapx/archive/refs/tags/v$pkgver.tar.gz"

build() {
	go build \
		-ldflags="-linkmode=external -extldflags \"$LDFLAGS\" -X github.com/Macmod/ldapx/internal/app.version=v$pkgver" \
		-v .
}

check() {
	./ldapx --version
}

package() {
	install -Dm0755 "$pkgname" -t "$pkgdir"/usr/bin

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE
	install -Dm644 README.md "$pkgdir"/usr/share/doc/"$pkgname"/README.md
}

sha512sums="
07b034a00647cb5ae9a61189909de3a0aa6390e9dae98b212ca66f76ab942a301b99db1381890b957b5c18bcf6f271ffc9d274bed59d15d7fcf6f97162c37ffa  ldapx-1.3.3.tar.gz
"
