From ecc2ee9cde7d089443278fca6cc4f291f96d06fd Mon Sep 17 00:00:00 2001
From: tranzystorekk <tranzystorek.io@protonmail.com>
Date: Wed, 14 Oct 2026 19:05:22 +0200
Subject: [PATCH] chore!: adjust for Zig 0.17

---
 .github/workflows/cd.yml    |  5 ++++-
 .github/workflows/ci.yml    |  9 ++++++---
 .github/workflows/pages.yml |  4 +++-
 Dockerfile                  |  2 +-
 README.md                   |  2 +-
 build.zig                   | 18 +++++++++---------
 build.zig.zon               |  6 +++---
 7 files changed, 27 insertions(+), 19 deletions(-)

diff --git a/build.zig b/build.zig
index 42c98eb..baf2d9b 100644
--- a/build.zig
+++ b/build.zig
@@ -66,9 +66,7 @@ pub fn build(b: *std.Build) void {
     // Create the run step and add arguments.
     const run_cmd = b.addRunArtifact(exe);
     run_cmd.step.dependOn(b.getInstallStep());
-    if (b.args) |args| {
-        run_cmd.addArgs(args);
-    }
+    run_cmd.addPassthruArgs();
 
     // Define the run step.
     const run_step = b.step("run", "Run the app");
@@ -85,19 +83,21 @@ pub fn build(b: *std.Build) void {
             .optimize = optimize,
         });
         try addPackages(b, test_module);
-        var exe_tests = b.addTest(.{
+        const exe_tests = b.addTest(.{
             .name = test_name,
             .root_module = test_module,
         });
+        test_module.addOptions("build_options", exe_options);
         if (coverage) {
-            exe_tests.setExecCmd(&[_]?[]const u8{
+            const kcov = b.addSystemCommand(&.{
                 "kcov",
                 "kcov-output",
-                null,
             });
+            kcov.addArtifactArg(exe_tests);
+            test_step.dependOn(&kcov.step);
+        } else {
+            const run_unit_tests = b.addRunArtifact(exe_tests);
+            test_step.dependOn(&run_unit_tests.step);
         }
-        test_module.addOptions("build_options", exe_options);
-        const run_unit_tests = b.addRunArtifact(exe_tests);
-        test_step.dependOn(&run_unit_tests.step);
     }
 }
diff --git a/build.zig.zon b/build.zig.zon
index 6ee4504..7c519d4 100644
--- a/build.zig.zon
+++ b/build.zig.zon
@@ -2,7 +2,7 @@
     .name = .linuxwave,
     .version = "0.1.5",
     .fingerprint = 0x217eafdf4732b5f9,
-    .minimum_zig_version = "0.16.0",
+    .minimum_zig_version = "0.17.0",
     .paths = .{
         "build.zig",
         "build.zig.zon",
@@ -12,8 +12,8 @@
     },
     .dependencies = .{
         .clap = .{
-            .url = "https://github.com/Hejsil/zig-clap/archive/refs/tags/0.12.0.tar.gz",
-            .hash = "clap-0.12.0-oBajB7foAQDqlSwaSG5g0yq7xGbQARUsBk5T64gAOqP5",
+            .url = "https://github.com/Hejsil/zig-clap/archive/05faf3905e8548f5cc269a8836e154065e70128d.tar.gz",
+            .hash = "clap-0.12.0-oBajB4XpAQCF1WRKnD5KOKPsnwwT_NNdAJ7Ww3irYJac",
         },
     },
 }
