The tests check the paths of the files in the temporary installation, but
Alpine's pg_config reports paths of the final (non-relocatable) installation.
Use the temporary installation when it exists.

unix_socket_directories.patch uncomments unix_socket_directories in
postgresql.conf.sample, so allow GUCs without the leading "#" there.

--- a/src/test/modules/test_misc/t/003_check_guc.pl
+++ b/src/test/modules/test_misc/t/003_check_guc.pl
@@ -39,6 +39,10 @@
 
 # use the sample file from the temp install
 my $share_dir = $node->config_data('--sharedir');
+# XXX-Patched: --sharedir returns /usr/share/...
+if (-d "../../../../tmp_install") {
+	$share_dir = "../../../../tmp_install" . $share_dir
+}
 my $sample_file = "$share_dir/postgresql.conf.sample";
 
 # List of all the GUCs found in the sample file.
@@ -64,7 +68,7 @@
 	# file.
 	# - Valid configuration options are followed immediately by " = ",
 	# with one space before and after the equal sign.
-	if ($line =~ m/^#([_[:alnum:]]+) = .*/)
+	if ($line =~ m/^#?([_[:alnum:]]+) = .*/)  # XXX-Patched: allow uncommented unix_socket_directories
 	{
 		# Lower-case conversion matters for some of the GUCs.
 		my $param_name = lc($1);
