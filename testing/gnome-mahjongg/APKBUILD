maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=gnome-mahjongg
pkgver=51.1
pkgrel=0
pkgdesc="Match tiles and clear the board"
url="https://apps.gnome.org/Mahjongg/"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	desktop-file-utils
	gtk4.0-dev
	libadwaita-dev
	librsvg-dev
	meson
	vala
	"
subpackages="$pkgname-doc $pkgname-lang"
source="https://download.gnome.org/sources/gnome-mahjongg/${pkgver%%.*}/gnome-mahjongg-$pkgver.tar.xz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
