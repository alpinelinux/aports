# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=tlottie
pkgver=0.0_git20260908
pkgrel=0
_commit=8ca87fc25a6ae5cbea4237feb5bae37940f37ae4
pkgdesc="rust library for drawing lottie animations"
url="https://github.com/dkaraush/tlottie"
arch="all"
license="MIT"
options="!check" # one test fail
makedepends="cargo cargo-auditable"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/dkaraush/tlottie/archive/$_commit.tar.gz"
builddir="$srcdir/"$pkgname-$_commit

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -vDm755 -t "$pkgdir/usr/lib" target/release/libtlottie.so
	install -vDm644 -t "$pkgdir/usr/include" include/tlottie.h
}

sha512sums="
9fd0c418c83ffa064bb391450a32529aa5b7ee0154d817ae16bd76fbaa16dd055d8d6969bda4d0f21d355a30dfaf093e9054d3a46c181b8b1a5a4755c4cc106e  tlottie-0.0_git20260908.tar.gz
"
