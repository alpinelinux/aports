Patch-Source: https://github.com/php/pecl-mail-imap (no 8.6 release yet)
PHP 8.6 removed XtOffsetOf() and INI_STR()/INI_BOOL(); provide compat
replacements (zend_ini_string() now returns const char*).
--- a/php_imap.c	2026-07-01 07:26:38.782942473 +0200
+++ b/php_imap.c	2026-07-01 07:26:38.834499533 +0200
@@ -47,6 +47,15 @@
 #endif
 #include "php_imap.h"
 
+/* PHP 8.6 removed the XtOffsetOf() alias and the INI_STR()/INI_BOOL()
+ * accessor macros, and zend_ini_string() now returns const char*. */
+#if PHP_VERSION_ID >= 80600
+# include <stddef.h>
+# define XtOffsetOf(type, member) offsetof(type, member)
+# define INI_STR(name)  ((char *) zend_ini_string((name), strlen(name), 0))
+# define INI_BOOL(name) ((bool) zend_ini_long((name), strlen(name), 0))
+#endif
+
 #include <time.h>
 #include <stdio.h>
 #include <ctype.h>
