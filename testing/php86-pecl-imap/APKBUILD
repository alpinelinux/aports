# Maintainer: Andy Postnikov <apostnikov@gmail.com>
maintainer="Andy Postnikov <apostnikov@gmail.com>"
pkgname=php86-pecl-imap
_extname=imap
pkgver=1.0.3
pkgrel=0
pkgdesc="PHP 8.6 extension to operate with the IMAP protocol, as well as the NNTP, POP3, and local mailbox access methods - PECL"
url="https://pecl.php.net/package/imap"
arch="all"
license="PHP-3.01"
_phpv=86
_php=php$_phpv
depends="$_php-common"
makedepends="$_php-dev krb5-dev imap-dev openssl-dev"
source="php-pecl-$_extname-$pkgver.tar.gz::https://pecl.php.net/get/$_extname-$pkgver.tgz
	php86-support.patch"
builddir="$srcdir"/$_extname-$pkgver
provides="$_php-imap=$pkgver-r$pkgrel" # for backward compatibility
replaces="$_php-imap" # for backward compatibility

build() {
	phpize$_phpv
	./configure --prefix=/usr --with-php-config=/usr/bin/php-config$_phpv \
		--with-kerberos --with-imap-ssl
	make
}

check() {
	make NO_INTERACTION=1 REPORT_EXIT_STATUS=1 test TESTS=--show-diff
}

package() {
	make INSTALL_ROOT="$pkgdir" install
	local _confdir="$pkgdir"/etc/$_php/conf.d
	install -d $_confdir
	echo "extension=$_extname" > $_confdir/$_extname.ini
}

sha512sums="
